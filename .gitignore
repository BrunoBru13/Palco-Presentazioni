sym('sun', 'Sole', (() => { let d = circP(50, 50, 20); for (let i = 0; i < 8; i++) { const a = i * Math.PI / 4, c = Math.cos(a), s = Math.sin(a), r1 = 30, r2 = 46, w = 4.5, px = -s, py = c; d += polP([[50 + c * r1 + px * w, 50 + s * r1 + py * w], [50 + c * r2 + px * w * .6, 50 + s * r2 + py * w * .6], [50 + c * r2 - px * w * .6, 50 + s * r2 - py * w * .6], [50 + c * r1 - px * w, 50 + s * r1 - py * w]]); } return d; })(), 'luce energia solare estate');
sym('moon', 'Luna', 'M66 6A44 44 0 1 0 94 66A36 36 0 0 1 66 6Z', 'notte sonno');
sym('mountain', 'Montagna', 'M2 88L34 28L50 56L64 36L98 88Z', 'outdoor viaggio trekking');
sym('wave', 'Onde', (() => { let d = ''; [24, 48, 72].forEach(y => { const top = [], bot = []; for (let i = 0; i <= 20; i++) { const x = 4 + i * 4.8, yy = y + Math.sin(i / 20 * Math.PI * 4) * 7; top.push([x, yy]); bot.push([x, yy + 9]); } d += polP(top.concat(bot.reverse())); }); return d; })(), 'mare acqua nuoto');
sym('pine', 'Pino', 'M50 4L72 34H62L82 62H66L90 90H10L34 62H18L38 34H28ZM44 92H56V98H44Z', 'bosco natura albero');
sym('flower', 'Fiore', (() => { const pts = []; for (let i = 0; i < 140; i++) { const t = i / 140 * Math.PI * 2, r = 46 * (.55 + .45 * Math.abs(Math.cos(2.5 * t))); pts.push([50 + Math.cos(t) * r, 50 + Math.sin(t) * r]); } return polP(pts) + circP(50, 50, 9); })(), 'fiorista giardino bellezza');
sym('paw', 'Zampa', circP(22, 42, 10) + circP(40, 24, 11) + circP(62, 24, 11) + circP(80, 42, 10) + 'M50 46C66 46 80 62 80 76C80 88 70 92 50 92C30 92 20 88 20 76C20 62 34 46 50 46Z', 'animali veterinario pet');
sym('gear', 'Ingranaggio', (() => { const pts = [], n = 8, st = Math.PI * 2 / n; for (let i = 0; i < n; i++) { const a = i * st; [[-.3, 32], [-.16, 46], [.16, 46], [.3, 32]].forEach(([o, r]) => pts.push([50 + Math.cos(a + o * st * 1.6) * r, 50 + Math.sin(a + o * st * 1.6) * r])); } return polP(pts) + circP(50, 50, 13); })(), 'tecnica officina ingegneria');
sym('shield', 'Scudo', 'M50 4L88 18V48C88 72 72 88 50 96C28 88 12 72 12 48V18ZM34 48L46 60L68 36L74 42L46 72L28 54Z', 'sicurezza protezione assicurazione');
