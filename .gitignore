  else if (m.t === 'cmt-del') { D.comments = L.filter(c => c.id !== m.id); }
  if (!D.collabGuest) { clearTimeout(CLB._st); CLB._st = setTimeout(() => ST.saveDeck(D), 800); }
  CLB.cmtChanged && CLB.cmtChanged();
};

/* ---------- aggancio all'editor e al salvataggio ---------- */
const clbSave0 = ST.saveDeck.bind(ST);
ST.saveDeck = (deck, now) => { if (deck && deck.collabGuest) return; clbSave0(deck, now); if (CLB.on && deck === CLB.deck) CLB.schedule(); };
const clbCommit0 = ED.commit;
ED.commit = (now) => { clbCommit0(now); if (CLB.on && ED.deck === CLB.deck) CLB.schedule(); };
const clbGoto0 = ED.goto; ED.goto = (i) => { clbGoto0(i); CLB.pres(); };
const clbSel0 = ED.select; ED.select = (ids, o) => { clbSel0(ids, o); CLB.pres(); };
const clbClose0 = ED.close;
ED.close = () => { const guest = CLB.guest && ED.deck === CLB.deck; clbClose0(); if (guest) { CLB.leave(); history.replaceState(null, '', location.pathname); } };
window.addEventListener('beforeunload', () => { if (CLB.host) CLB.broadcast({ t: 'bye' }); });

/* ============ Collaborazione: finestra del link con ruolo, ingresso, modalità di sola lettura, commenti e presenza ============ */
ICONS.user = '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>';
ICONS.chat = '<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/>';
CLB.add = (p, ...n) => p.append(...n.filter(x => x != null && x !== false));
CLB.initials = (n) => (String(n || '?').trim().split(/\s+/).map(w => w[0]).join('').slice(0, 2) || '?').toUpperCase();
CLB.avatar = (p, size) => h('i.cav', { title: `${p.name} · ${CLB.roleName(p.role)}`, style: { background: p.color, width: (size || 28) + 'px', height: (size || 28) + 'px', fontSize: Math.round((size || 28) * .4) + 'px' } }, CLB.initials(p.name));
CLB.copy = async (txt) => { try { await navigator.clipboard.writeText(txt); toast('Link copiato', { icon: 'check', ms: 1600 }); } catch (e) { toast('Seleziona il link e premi Ctrl+C', { ms: 2600 }); } };
CLB.saveCopy = () => { const D = CLB.deck; if (!D) return; const c = clone(D); c.id = uid('d_'); delete c.collabGuest; delete c.collab; c.name = D.name + ' (copia)'; c.created = Date.now(); c.trashed = 0; ST.saveDeck(c, true); toast('Copia salvata nei tuoi progetti', { icon: 'check', ms: 3000 }); };

/* ---------- sezione nella finestra Condividi ---------- */
CLB.shareSection = (deck) => {
  const box = h('div.shsec.clbsec'), S = { role: 'editor' };
  const draw = () => {
    box.innerHTML = ''; CLB.add(box, h('h3', 'Collabora in tempo reale'));
    if (!CLB.available()) { CLB.add(box, h('p.hint2', 'Dentro Claude i ruoli Editor, Commentatore e Visualizzatore si assegnano dal menu Condividi di Claude, invitando ogni persona con il ruolo giusto. Per far collaborare anche chi non ha Claude, pubblica Palco sul tuo sito (Netlify): lì questa finestra crea il link con il ruolo.')); return; }
    if (CLB.guest) { CLB.add(box, h('p.hint2', `Sei collegato come ${CLB.roleName(CLB.role)}. Il proprietario vede le tue modifiche subito.`), CLB.peopleList(false), h('div.row', h('button.btn.sm', { onclick: () => CLB.saveCopy() }, icn('copy', 16), 'Salva una copia mia'))); return; }
    CLB.add(box, h('p.hint2', 'Invia un link: chi lo apre entra nella presentazione con il ruolo che scegli, vede le modifiche in diretta e può commentare. Il collegamento passa direttamente dal tuo computer, quindi la sessione resta attiva finché Palco è aperto qui.'));
    CLB.add(box, h('div.rolesel', CLB.ROLES.map(([k, n, d]) => h('button.rolebtn' + (S.role === k ? '.on' : ''), { onclick: () => { S.role = k; draw(); } }, h('b', n), h('small', d)))));
    const active = CLB.on && CLB.deck === deck;
    const nameInp = h('input.inp.sm', { value: (active && CLB.me && CLB.me.name) || CLB.name(), placeholder: 'Il tuo nome', 'aria-label': 'Il tuo nome nella sessione', maxlength: 30, onchange: e => { CLB.setName(e.target.value.trim()); if (active && CLB.me) { CLB.me.name = CLB.name() || 'Proprietario'; CLB.broadcastPeers(); CLB.notify(); } } });
    CLB.add(box, h('div.row', { style: { alignItems: 'center', gap: '8px' } }, h('label.flab', 'Il tuo nome'), nameInp));
    if (!active) {
      const st = h('p.hint2');
      CLB.add(box, h('button.btn.primary', { onclick: async e => { const b = e.currentTarget; b.disabled = true; st.textContent = 'Preparo il collegamento…'; try { CLB.setName(nameInp.value.trim()); await CLB.startHost(deck); toast('Collaborazione avviata: copia il link e invialo', { icon: 'check', ms: 3500 }); } catch (er) { console.warn(er); st.textContent = 'Non sono riuscito ad avviare la collaborazione (' + (er && er.type || 'rete') + '). Serve internet.'; b.disabled = false; return; } draw(); } }, icn('share', 16), 'Avvia e crea il link'), st);
      return;
    }
    const url = CLB.link(S.role);
    CLB.add(box, h('div.row', { style: { flexWrap: 'nowrap' } }, h('input.inp', { value: url, readonly: true, 'aria-label': 'Link di collaborazione', onfocus: e => e.target.select() }), h('button.btn.primary', { onclick: () => CLB.copy(url) }, icn('link', 16), 'Copia')),
      navigator.share ? h('button.btn.sm', { onclick: () => navigator.share({ title: deck.name, url }).catch(() => { }) }, icn('share', 16), 'Invia con…') : null,
      h('p.hint2', `Chi apre questo link entra come ${CLB.roleName(S.role)}. Se due persone modificano la stessa pagina nello stesso istante, vince l’ultima modifica.`),
      CLB.peopleList(true),
      h('div.row', h('button.btn.sm', { onclick: () => UI.confirm('Rigenerare i link?', 'I link già inviati smettono di funzionare e tutti i collaboratori vengono scollegati. Poi puoi mandare i nuovi.', 'Rigenera', () => CLB.rotate(), true) }, icn('restore', 16), 'Rigenera i link'),
        h('button.btn.sm', { onclick: () => UI.confirm('Terminare la collaborazione?', 'Tutti vengono scollegati. Il link resta lo stesso e torna a funzionare quando la riavvii.', 'Termina', () => CLB.stop(), true) }, icn('x', 16), 'Termina la collaborazione')));
  };
  const off = CLB.onUi(() => { if (box.isConnected) draw(); else off(); });
  draw(); return box;
};
CLB.peopleList = (manage) => {
  const list = CLB.everyone(), wrap = h('div.cpeople');
  list.forEach(p => {
    const me = p.id === (CLB.me && CLB.me.id), canManage = manage && CLB.host && p.id !== 'host';
    CLB.add(wrap, h('div.cprow', CLB.avatar(p, 30), h('div.cpn', h('b', p.name + (me ? ' (tu)' : '')), h('small', CLB.roleName(p.role))),
      canManage ? h('select.inp.sm', { 'aria-label': 'Ruolo', onchange: e => CLB.setRole(p.id, e.target.value) }, CLB.ROLES.map(([k, n]) => h('option', { value: k, selected: p.role === k }, n))) : null,
      canManage ? h('button.ibtn.sm', { title: 'Rimuovi dalla sessione', 'aria-label': 'Rimuovi', onclick: () => CLB.kick(p.id) }, icn('x', 16)) : null));
  });
  if (!list.length) CLB.add(wrap, h('p.hint2', 'Nessuno è ancora entrato.'));
