};
/* trascinamento: la riga segue il puntatore, le altre si spostano per fare posto */
ED.layerDrag = (ev, list, e) => {
  if (ev.button || ev.target.closest('button')) return;
  if (ev.pointerType === 'touch' && !ev.target.closest('.lgrip')) return;
  const li = ev.currentTarget, y0 = ev.clientY, scroller = list.closest('.pbd') || list.parentNode, n = list.children.length;
  let on = false, ghost = null, dy = 0, raf = 0, lastY = y0;
  const rows = () => [...list.children].filter(x => x.matches('li.lr'));
  const flip = (fn) => { const before = new Map(rows().map(r => [r, r.getBoundingClientRect().top])); fn(); rows().forEach(r => { const d = before.get(r) - r.getBoundingClientRect().top; if (d && r !== li) r.animate([{ transform: `translateY(${d}px)` }, { transform: 'none' }], { duration: 170, easing: 'cubic-bezier(.2,.8,.2,1)' }); }); };
  const place = (y) => {
    const others = rows().filter(r => r !== li); let before = null;
    for (const r of others) { const b = r.getBoundingClientRect(); if (y < b.top + b.height / 2) { before = r; break; } }
    if ((before && li.nextElementSibling === before) || (!before && li === rows().pop())) return;
    flip(() => { before ? list.insertBefore(li, before) : list.appendChild(li); });
  };
  const frame = () => { if (!on) return; const b = scroller.getBoundingClientRect(); let sc = 0; if (lastY < b.top + 36) sc = -Math.min(14, (b.top + 36 - lastY) / 2 + 3); else if (lastY > b.bottom - 36) sc = Math.min(14, (lastY - (b.bottom - 36)) / 2 + 3); if (sc) { scroller.scrollTop += sc; place(lastY); } raf = requestAnimationFrame(frame); };
  const move = (e2) => {
    lastY = e2.clientY;
    if (!on) {
      if (Math.abs(e2.clientY - y0) < 4) return; on = true; const r = li.getBoundingClientRect(); dy = y0 - r.top;
      ghost = li.cloneNode(true); ghost.classList.add('lrghost'); Object.assign(ghost.style, { width: r.width + 'px', left: r.left + 'px', top: r.top + 'px', height: r.height + 'px' }); document.body.appendChild(ghost);
      li.classList.add('ph'); document.body.classList.add('lrdrag'); list._dragged = true; raf = requestAnimationFrame(frame);
    }
    ghost.style.top = (e2.clientY - dy) + 'px'; place(e2.clientY);
  };
  const end = (cancel) => {
    window.removeEventListener('pointermove', move); window.removeEventListener('pointerup', up); window.removeEventListener('keydown', key, true); cancelAnimationFrame(raf);
    if (!on) return; ghost && ghost.remove(); li.classList.remove('ph'); document.body.classList.remove('lrdrag'); setTimeout(() => { list._dragged = false; }, 60);
    const q = rows().indexOf(li); if (cancel) { ED.renderPanel(); return; }
    const newIdx = n - 1 - q, cur = ED.slide().els.findIndex(x => x.id === e.id); if (newIdx !== cur) ED.moveLayer(e.id, newIdx); else ED.renderPanel();
  };
  const up = () => end(false), key = (k) => { if (k.key === 'Escape') { k.stopPropagation(); end(true); } };
