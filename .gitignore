/* ============ Contenuti di esempio per i modelli ============ */
(function () {
  const T = TP.topics;
  const mk = (name, o) => ({ name, ...o });
  const quarters = ['T1', 'T2', 'T3', 'T4'];

  T.startup = mk('Pitch per investitori', {
    cover: { title: 'Il futuro della spesa locale', sub: 'Round seed · Presentazione agli investitori', tag: 'PITCH DECK · 2027' },
    agenda: { title: 'Cosa vedremo', items: ['Il problema', 'La nostra soluzione', 'Mercato e crescita', 'Modello di business', 'Il team', 'La richiesta'] },
    section: { n: '01', title: 'Il problema', sub: 'Perché oggi comprare locale è ancora troppo difficile' },
    bullets: { title: 'Una soluzione semplice', items: ['Un’unica app per tutti i negozi di quartiere', 'Consegna in giornata con corrieri ciclabili', 'Pagamenti e fidelity già integrati', 'Dati in tempo reale per i commercianti'] },
    twocol: { title: 'Prima e dopo Spesa Vicina', cols: [{ h: 'Prima', items: ['Ordini per telefono', 'Nessuna visibilità online', 'Consegne imprevedibili'] }, { h: 'Dopo', items: ['Catalogo sempre aggiornato', 'Vendite online in 48 ore', 'Tracciamento in tempo reale'] }] },
    imgtext: { title: 'Come funziona', text: 'Il cliente sceglie, il negozio prepara, il corriere consegna. Tutto in meno di tre ore.', items: ['Scegli i prodotti', 'Paga in un tocco', 'Ricevi a casa'] },
    stats: { title: 'I numeri finora', stats: [{ v: '12k', l: 'Utenti attivi al mese' }, { v: '320', l: 'Negozi partner' }, { v: '4,8', l: 'Valutazione media' }] },
    chart: { title: 'Ricavi in crescita', labels: quarters, series: [{ n: 'Ricavi (k€)', v: [42, 58, 71, 95] }], big: '+126%', note: 'Crescita dei ricavi in quattro trimestri.' },
    quote: { quote: 'Da quando siamo online il banco non è mai stato così pieno di clienti nuovi.', author: 'Marta Ferri', role: 'Salumeria Ferri, Bologna' },
    timeline: { title: 'La nostra roadmap', steps: [{ t: 'Q1', d: 'Lancio a Bologna' }, { t: 'Q2', d: 'Apertura di Milano e Torino' }, { t: 'Q3', d: 'App per i commercianti' }, { t: 'Q4', d: 'Espansione nazionale' }] },
    team: { title: 'Il team', people: [{ n: 'Giulia Rossi', r: 'CEO' }, { n: 'Luca Bianchi', r: 'CTO' }, { n: 'Sara Conti', r: 'Operations' }] },
    thanks: { title: 'Grazie.', sub: 'ciao@spesavicina.it' }
  });
  T.report = mk('Relazione trimestrale', {
    cover: { title: 'Relazione trimestrale', sub: 'Risultati e priorità · Terzo trimestre', tag: '01 — Report' },
    agenda: { title: 'Sommario', items: ['Sintesi dei risultati', 'Vendite per area', 'Costi e margini', 'Priorità del prossimo trimestre'] },
    section: { n: '01', title: 'Sintesi dei risultati', sub: 'Dove siamo rispetto agli obiettivi' },
    bullets: { title: 'Cosa è andato bene', items: ['Ricavi sopra il piano del 6%', 'Costo di acquisizione in calo', 'Nuovi clienti nel Nord-Est', 'Tempi di consegna ridotti a 36 ore'] },
    twocol: { title: 'Luci e ombre', cols: [{ h: 'Punti di forza', items: ['Fidelizzazione al 71%', 'Team commerciale completo'] }, { h: 'Da migliorare', items: ['Margine sui nuovi prodotti', 'Tempi di risposta al supporto'] }] },
    imgtext: { title: 'Un trimestre in sintesi', text: 'Risultati solidi e margini in miglioramento. La priorità resta la qualità del servizio ai clienti esistenti.', items: null },
    stats: { title: 'Indicatori chiave', stats: [{ v: '2,4M', l: 'Ricavi del trimestre' }, { v: '18%', l: 'Margine operativo' }, { v: '71%', l: 'Clienti fedeli' }] },
