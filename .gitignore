    const y = i * rh, c = DG.col(Q, i), v = Math.max(0, Math.min(100, p.v == null ? 50 : p.v));
    els.push(DG.tx(Q, p.t, 0, y, W * .7, rh * .42, { a: 'left', f: Q.fd, wt: 700, max: 36, c: Q.fg }), DG.tx(Q, Math.round(v) + '%', W * .7, y, W * .3, rh * .42, { a: 'right', f: Q.fd, wt: 800, max: 36, c }));
    els.push(DG.sh('pill', 0, y + rh * .5, W, bh, Q.line), DG.sh('pill', 0, y + rh * .5, Math.max(bh, W * v / 100), bh, c));
  });
  return els;
});
dt('stairs', 'Scala di crescita', 'trend', 1500, 800, 'Base: Le fondamenta\nCrescita: Più clienti\nScala: Nuove sedi\nLeadership: Primi del settore', 'Dal gradino più basso: “Titolo: descrizione”', (it, W, H, Q) => {
