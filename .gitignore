LAY.cta = (c, d) => {
  const th = c.th; c.card(.07, .16, .86, .68); const t = c.title(d.title || 'Parliamone', .12, .24, .76, 92, { lh: 1.05 }); R.fitInto(t, c.Y(.26), 50);
  let y = (t.y + t.h) / c.H + .03; if (d.text) { const b = c.txt(d.text, .12, y, .6, 34, { o: .85, c: th.cardFg || th.fg }); y = (b.y + b.h) / c.H + .04; }
  const pill = c.txt(' ' + (d.button || 'Scrivici') + ' ', .12, y, .3, 32, { bg: th.ac, c: c.ink(th.ac), wt: 800, pad: 20, rad: 60, up: false, w: c.X(.24), a: 'center' }); y = (pill.y + pill.h) / c.H + .05;
  (d.contacts || []).slice(0, 3).forEach((ct, k) => { const ic = /@/.test(ct) ? 'mail' : /^[+\d\s()-]{6,}$/.test(ct) ? 'phone' : 'globe'; c.icon(ic, c.X(.12), c.Y(y + k * .075), c.S(46), th.ac2); const e = c.txt(ct, .17, 0, .5, 30, { c: th.cardFg || th.fg }); c.vcenter(e, c.Y(y + k * .075) + c.S(23)); });
};
LAY.table = (c, d) => {
  const th = c.th; head(c, d.title); const rows = (d.rows || []).slice(0, 8).map(r => r.map(String)), nr = rows.length, rh = c.S(Math.min(86, 560 / nr));
  const e = M.table({ rows, x: c.X(.07), y: c.Y(.3), w: c.X(.86), rh, fs: c.S(26), f: th.fb, hf: th.ac, hc: c.ink(th.ac), cf: th.card, cf2: Col.mix(colOf(th.card), colOf(th.fg), .06), tc: th.cardFg || th.fg, bc: Col.mix(colOf(th.card), colOf(th.fg), .2) }); c.add(e);
};
LAY.definition = (c, d) => {
  const th = c.th; c.box('rect', 0, 0, .42, 1, th.card); if (d.label) c.txt(d.label, .06, .16, .32, 22, { c: th.ac, ls: .22, up: true, wt: 700 });
  const t = c.title(d.term || d.title, .06, .26, .32, 96, { c: th.ac, lh: 1.02 }); R.fitInto(t, c.Y(.5), 40);
  const b = c.txt(d.text, .5, .22, .43, 40, {}); R.fitInto(b, c.Y(.36), 22);
  if (d.example) { const y = Math.max(.62, (b.y + b.h) / c.H + .05); c.card(.5, y, .43, .26, { f: th.card }); c.txt('Esempio', .525, y + .03, .3, 22, { c: th.ac, ls: .18, up: true, wt: 700 }); const e = c.txt(d.example, .525, y + .09, .38, 28, { c: th.cardFg || th.fg }); R.fitInto(e, c.Y(.16), 16); }
};
TP.VARIANTS.checklist = []; TP.VARIANTS.table = []; TP.VARIANTS.definition = []; TP.VARIANTS.cta = [];
TP.KIND_NAMES.statement = 'Frase chiave'; TP.KIND_NAMES.checklist = 'Checklist'; TP.KIND_NAMES.gallery = 'Galleria'; TP.KIND_NAMES.cta = 'Invito all’azione'; TP.KIND_NAMES.table = 'Tabella'; TP.KIND_NAMES.definition = 'Definizione';

/* ====================== COPERTINE ALTERNATIVE (temi dell'IA) ====================== */
TP.coverVariants = {
  center: (c, d) => {
    const th = c.th; c.img(c.art(2), 0, .62, 1, .38, {}); c.box('rect', 0, .62, 1, .38, th.bg, { o: .15 });
    if (d.tag) c.txt(' ' + d.tag + ' ', .38, .14, .24, 22, { bg: th.ac, c: c.ink(th.ac), wt: 700, ls: .16, up: true, pad: 12, rad: 40, a: 'center', w: c.X(.24) });
    const t = c.title(d.title, .1, .26, .8, 112, { a: 'center', lh: 1.04 }); R.fitInto(t, c.Y(.3), 58); c.txt(d.sub, .2, (t.y + t.h) / c.H + .03, .6, 34, { a: 'center', c: th.mute });
  },
  split: (c, d) => {
    const th = c.th; c.img(c.art(3), .55, 0, .45, 1, {}); c.box('rect', .55, 0, .006, 1, th.ac);
    if (d.tag) c.txt(d.tag, .07, .14, .4, 22, { c: th.ac, ls: .22, up: true, wt: 700 }); const t = c.title(d.title, .07, .26, .44, 98, { lh: 1.04 }); R.fitInto(t, c.Y(.4), 54); c.txt(d.sub, .07, (t.y + t.h) / c.H + .03, .4, 32, { c: th.mute }); c.box('rect', .07, .84, .08, .008, th.ac);
  },
  bigtype: (c, d) => {
    const th = c.th; c.circ(.92, .08, .36, th.ac, { o: .9 }); c.circ(.1, 1.04, .22, th.ac2, { o: .7 });
    const t = c.title(d.title, .07, .3, .86, 150, { lh: .98, ls: -.03 }); R.fitInto(t, c.Y(.5), 70); t.y = Math.round(c.Y(.86) - t.h); if (d.tag) c.txt(d.tag, .07, .08, .5, 22, { c: th.ac, ls: .22, up: true, wt: 700 }); c.txt(d.sub, .07, .88, .7, 28, { c: th.mute });
  },
  frame: (c, d) => {
    const th = c.th; c.box('rect', .035, .06, .93, .88, null, { st: { c: th.ac, w: c.S(5), d: 0 } }); c.circ(.035, .06, .02, th.ac); c.circ(.965, .94, .02, th.ac);
    if (d.tag) c.txt(d.tag, .2, .2, .6, 22, { a: 'center', c: th.ac, ls: .24, up: true, wt: 700 }); const t = c.title(d.title, .14, .3, .72, 96, { a: 'center', lh: 1.05 }); R.fitInto(t, c.Y(.34), 54); c.txt(d.sub, .2, (t.y + t.h) / c.H + .03, .6, 30, { a: 'center', c: th.mute });
  }
};
const cover0 = LAY.cover, thanks0 = LAY.thanks;
LAY.cover = (c, d, i) => { const v = c.th.coverVariant; if (c.th.custom && v && TP.coverVariants[v]) return TP.coverVariants[v](c, d); return cover0(c, d, i); };
LAY.thanks = (c, d, i) => { const v = c.th.coverVariant; const dd = { title: d.title || 'Grazie.', sub: d.sub || '', tag: d.tag || '' }; if (c.th.custom && v && TP.coverVariants[v]) return TP.coverVariants[v](c, dd); return thanks0(c, d, i); };
TP.COVERS = ['theme', 'center', 'split', 'bigtype', 'frame'];

/* temi dell'IA: tipo di copertina scelto */
const custom0 = TP.custom;
TP.custom = (def, id) => { const th = custom0(def, id); th.coverVariant = TP.COVERS.includes(def && def.coverVariant) ? def.coverVariant : 'theme'; th.def.coverVariant = th.coverVariant; return th; };

/* ====================== SCELTA DELLE VARIANTI ====================== */
TP.pickLayout = (kind, wanted, st) => {
  const list = TP.VARIANTS[kind]; if (!list || !list.length) return null;
  if (wanted && list.includes(wanted) && st.last[kind] !== wanted && st.prev !== wanted) { st.last[kind] = st.prev = wanted; return wanted; }
  const pool = list.filter(v => v !== st.last[kind] && v !== st.prev), pick = (pool.length ? pool : list)[Math.floor(Math.random() * (pool.length ? pool.length : list.length))];
  st.last[kind] = st.prev = pick; return pick;
};
/* outlineSlides con varianti e nuovi tipi */
TP.outlineSlides = (th, body, W, H, start = 0) => {
  const own = !TP.runSeed; if (own) TP.runSeed = 1 + Math.floor(Math.random() * 500);
  const slides = [], st = { last: {}, prev: null };
  const push = (k, d, want) => { d.layout = TP.pickLayout(k, want, st) || undefined; slides.push(TP.slide(th, k, d, W, H, start + slides.length)); };
  let sec = 0;
  body.forEach(s => {
    const items = (s.bullets || s.items || []).map(String).filter(Boolean), kind = s.kind, want = s.layout;
    if (kind === 'section') push('section', { n: String(++sec).padStart(2, '0'), title: s.title, sub: s.text || '' }, want);
    else if (kind === 'stats' && s.stats && s.stats.length) push('stats', { title: s.title, stats: s.stats.map(x => ({ v: String(x.value || x.v || ''), l: String(x.label || x.l || '') })) }, want);
    else if (kind === 'quote') push('quote', { quote: s.quote || s.title, author: s.author || '', role: s.role || '' }, want);
    else if (kind === 'timeline' && s.steps && s.steps.length) push('timeline', { title: s.title, steps: s.steps.map(x => ({ t: String(x.title || x.t || ''), d: String(x.text || x.d || '') })) }, want);
    else if (kind === 'twocol' && s.left && s.right) push('twocol', { title: s.title, cols: [s.left, s.right].map(x => ({ h: String(x.title || x.h || ''), items: (x.bullets || x.items || []).map(String) })) }, want);
    else if (kind === 'chart' && s.labels && s.series) push('chart', { title: s.title, kind: s.chart || 'bar', labels: s.labels.map(String), series: s.series.map(x => ({ n: String(x.name || x.n || ''), v: (x.values || x.v || []).map(Number) })), big: s.big, note: s.note }, want);
    else if (kind === 'statement') push('statement', { title: s.title, text: s.text || s.title, label: s.label || (s.text ? s.title : '') }, want);
    else if (kind === 'checklist' && items.length) push('checklist', { title: s.title, items }, want);
    else if (kind === 'gallery') push('gallery', { title: s.title, items }, want);
    else if (kind === 'cta') push('cta', { title: s.title, text: s.text || '', button: s.button || '', contacts: (s.contacts || s.contact || []).map ? [].concat(s.contacts || s.contact || []).map(String) : [] }, want);
    else if (kind === 'table' && s.rows && s.rows.length) push('table', { title: s.title, rows: s.rows }, want);
    else if (kind === 'definition') push('definition', { title: s.title, term: s.term || s.title, text: s.text || items.join(' '), example: s.example || '', label: s.label || 'Definizione' }, want);
    else if (kind === 'imgtext' || (s.text && items.length < 2)) push('imgtext', { title: s.title, text: s.text || items.join(' '), items: s.text ? items : null }, want);
    else push('bullets', { title: s.title, items: items.length ? items : [s.text || '…'], icons: s.icons }, want);
    if (s.notes) slides[slides.length - 1].notes = String(s.notes);
  });
  if (own) TP.runSeed = 0;
  return slides;
};

/* presentazione completa: copertina, agenda (a volte a schede), pagine, chiusura */
TP.fromOutline = (themeId, ol, o = {}) => {
  const th = TP.get(themeId), W = o.w || 1920, H = o.h || 1080, slides = [], T = TP.topicData(th);
  TP.runSeed = 1 + Math.floor(Math.random() * 500); TP.wantImages = !!ol.wantImages;
  try {
    slides.push(TP.slide(th, 'cover', { title: ol.title || 'Nuova presentazione', sub: ol.subtitle || '', tag: ol.tag || T.cover.tag }, W, H, 0));
    const body = (ol.slides || []).filter(s => s && s.title);
    if (body.length >= 5 && ol.agenda !== false) slides.push(TP.slide(th, 'agenda', { title: 'Di cosa parliamo', items: body.filter(s => s.kind !== 'section').slice(0, 6).map(s => s.title), layout: Math.random() < .5 ? 'cards' : 'list' }, W, H, 1));
    slides.push(...TP.outlineSlides(th, body, W, H, slides.length));
    slides.push(TP.slide(th, 'thanks', { title: ol.closing || 'Grazie.', sub: ol.contact || '' }, W, H, slides.length));
  } finally { TP.runSeed = 0; TP.wantImages = false; }
  const deck = M.newDeck({ name: ol.title || 'Nuova presentazione', w: W, h: H, theme: th.id, slides });
  if (th.custom) deck.themeDef = th.def;
  return deck;
};
/* ====================== RIQUADRI PER IMMAGINI GENERATE ====================== */
/* ogni immagine astratta messa da un layout è un "riquadro" che l'IA può riempire con un'illustrazione vettoriale */
const ctxImg0 = TP.ctx;
TP.ctx = (th, W, H) => {
  const c = ctxImg0(th, W, H), img0 = c.img; c.slotN = 0;
  c.img = (src, x, y, w, hh, o = {}) => { const e = img0(src, x, y, w, hh, o); if (/^g:/.test(src) && !o.noSlot) e.slot = c.slotN++; return e; };
  return c;
};
TP.IMG_VARIANTS = { bullets: ['side-art', 'art-left'], imgtext: ['alt', 'overlay', 'top', 'circle'], gallery: ['row', 'mosaic'], quote: ['photo'], section: ['photo'], statement: ['art'], agenda: ['list'] };
TP.VARIANTS.bullets.push('art-left'); TP.VARIANTS.quote.push('photo'); TP.VARIANTS.section.push('photo'); TP.VARIANTS.statement.push('art');
LAYV.bullets['art-left'] = (c, d) => {
  const th = c.th; c.img(c.art(), .06, .27, .3, .62, { rad: c.S(th.rad) }); const t = c.title(d.title, .43, .09, .5, 62); R.fitInto(t, c.Y(.18), 36);
  c.box('rect', .43, .06, .06, .009, th.ac); const e = c.txt(bulletParas(d.items), .43, .3, .5, 40, { ps: .55, bc: th.ac }); R.fitInto(e, c.Y(.58), 24);
};
LAYV.quote.photo = (c, d) => {
  const th = c.th; c.img(c.art(1), 0, 0, .4, 1, {}); c.txt('“', .44, .08, .12, 220, { f: th.fd, wt: th.wd, c: th.ac, lh: 1, up: false });
  const q = c.txt(d.quote, .46, .3, .46, 50, { f: th.qf || th.fd, wt: th.qw || 500, up: false, lh: 1.22, i: !!th.qi }); R.fitInto(q, c.Y(.42), 30);
  const y = (q.y + q.h) / c.H + .04; c.box('rect', .46, y, .05, .006, th.ac); c.txt(d.author, .46, y + .03, .46, 30, { wt: 700 }); if (d.role) c.txt(d.role, .46, y + .09, .46, 24, { c: th.mute });
};
LAYV.section.photo = (c, d) => {
  const th = c.th, fg = th.secFg || Col.readable(c.bg); c.img(c.art(2), .5, 0, .5, 1, {});
  c.txt(d.n || '01', .06, .08, .3, 120, { f: th.fd, wt: th.wd, c: fg, o: .4, lh: 1, up: false }); const t = c.title(d.title, .06, .4, .4, 84, { c: fg }); R.fitInto(t, c.Y(.34), 48); t.y = c.Y(.8) - t.h;
  if (d.sub) c.txt(d.sub, .06, (t.y + t.h) / c.H + .03, .38, 30, { c: fg, o: .85 });
};
LAYV.statement.art = (c, d) => {
  const th = c.th, left = c.seed % 2 === 0, tx = left ? .07 : .5; c.img(c.art(3), left ? .56 : .06, .12, .38, .76, { rad: c.S(th.rad) }); c.box('rect', tx, .22, .007, .5, th.ac);
  if (d.label) c.txt(d.label, tx + .025, .17, .35, 22, { c: th.ac, ls: .22, up: true, wt: 700 }); const e = c.title(d.text || d.title, tx + .025, .27, .38, 64, { lh: 1.1 }); R.fitInto(e, c.Y(.5), 30);
};

/* le pagine con immagine: se l'utente le vuole, si sceglie una composizione che abbia il riquadro */
TP._pick0 = TP.pickLayout;
TP.pickLayout = (kind, wanted, st) => {
  if (TP.wantImages && TP.IMG_VARIANTS[kind] && st.hasImg) {
    const ok = TP.IMG_VARIANTS[kind];
    if (wanted && ok.includes(wanted) && st.last[kind] !== wanted && st.prev !== wanted) { st.last[kind] = st.prev = wanted; return wanted; }
    const pool = ok.filter(v => v !== st.last[kind] && v !== st.prev), pick = (pool.length ? pool : ok)[Math.floor(Math.random() * (pool.length || ok.length))];
    st.last[kind] = st.prev = pick; return pick;
  }
  return TP._pick0(kind, wanted, st);
};
const outline1 = TP.outlineSlides;
TP.outlineSlides = (th, body, W, H, start = 0) => {
  // segnala alla scelta del layout quali pagine hanno una descrizione d'immagine
  const marks = body.map(s => !!(s && (s.image || (s.images && s.images.length))));
  let k = -1; const orig = TP.pickLayout;
  TP.pickLayout = (kind, wanted, st) => { st.hasImg = false; k++; st.hasImg = !!marks[Math.min(k, marks.length - 1)]; return orig(kind, wanted, st); };
  let slides; try { slides = outline1(th, body, W, H, start); } finally { TP.pickLayout = orig; }
  slides.forEach((s, i) => { const b = body[i]; if (b) { const ds = [].concat(b.images || (b.image ? [b.image] : [])).map(String).filter(Boolean); if (ds.length) s.imgd = ds; } });
  return slides;
};

/* ============ Temi grafici (modelli) ============ */
const runs = (...lines) => lines.map(l => ({ r: (Array.isArray(l) ? l : [l]).map(x => typeof x === 'string' ? { t: x } : { t: x[0], c: x[1] }) }));
const subY = (c, t, gap = .035) => (t.y + t.h) / c.H + gap;

