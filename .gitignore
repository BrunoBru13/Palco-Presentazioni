};
ED.panels.layers = () => {
  const els = ED.slide().els.slice().reverse(), n = els.length;
  if (!els.length) return h('p.pempty', 'Questa pagina è vuota. Aggiungi testo, forme o immagini.');
  const list = h('ul.layers');
  els.forEach((e, idx) => list.appendChild(h('li.lr' + (ED.sel.includes(e.id) ? '.sel' : '') + (e.hd ? '.hid' : ''), {
    data: { id: e.id },
    onclick: ev => { if (list._dragged) return; ED.select(ev.shiftKey ? (ED.sel.includes(e.id) ? ED.sel.filter(i => i !== e.id) : [...ED.sel, e.id]) : [e.id]); },
    onpointerdown: ev => ED.layerDrag(ev, list, e),
