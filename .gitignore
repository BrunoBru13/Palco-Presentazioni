<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Palco</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Poppins:wght@400;500;600;700;800&family=Montserrat:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&family=Sora:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&family=Nunito:wght@400;600;700;800;900&family=Rubik:wght@400;500;600;700;800&family=Raleway:wght@400;500;600;700;800&family=Work+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=DM+Serif+Display:ital@0;1&family=Fraunces:ital,wght@0,400;0,600;0,700;0,900;1,400;1,700&family=Lora:ital,wght@0,400;0,600;0,700;1,400;1,700&family=Merriweather:ital,wght@0,400;0,700;1,400;1,700&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,700&family=Roboto+Slab:wght@400;500;600;700;800&family=Abril+Fatface&family=Archivo+Black&family=Bebas+Neue&family=Anton&family=Oswald:wght@400;500;600;700&family=Pacifico&family=Caveat:wght@400;600;700&family=Lobster&family=Permanent+Marker&family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&family=JetBrains+Mono:wght@400;500;700;800&display=swap">
<style>
/* Palco: due stili "liquid glass", entrambi gialli, con luce direzionale (angoli in alto a sinistra e in basso a destra più luminosi). Chiaro = vetro chiaro su fondo giallo. Scuro (predefinito) = vetro grafite. Pulsanti e riquadro di selezione hanno lo stesso giallo (--acc / --sel) in tutti e due. Gli stili del vetro stanno in 09-glass.css */
:root {
  --bg: #FFEFB0; --surface: #FFFBE9; --surface2: rgba(255, 255, 255, .5); --line: rgba(120, 85, 0, .16); --ink: #2A2310; --ink2: #5E5330; --ink3: #85774A;
  --acc: #FFD25A; --acc-ink: #2A2310; --acc-soft: rgba(255, 205, 70, .36); --acc-text: #8A5A00; --acc-edge: rgba(190, 135, 0, .55); --sel: #FFD25A; --sel-edge: rgba(42, 35, 16, .72); --ok: #12906A; --err: #D92D4A; --focus: #1E6BFF;
  --bar: #FFE48E; --bar-ink: #2A2310; --canvas: #F1E3A8; --shadow: 0 8px 28px rgba(110, 78, 0, .16); --shadow2: 0 18px 54px rgba(60, 45, 5, .28);
  --bar-hover: rgba(60, 45, 5, .1); --bar-chip: rgba(255, 255, 255, .55); --bar-chip-h: rgba(255, 255, 255, .85); --bar-line: rgba(60, 45, 5, .25); --sbar: #FFE79A;
  /* vetro */
  --glass: rgba(255, 255, 255, .46); --glass-bar: rgba(255, 255, 255, .38); --glass-pop: rgba(255, 252, 238, .78); --glass-modal: rgba(255, 252, 238, .8);
  --glass2: rgba(255, 255, 255, .42); --glass2-h: rgba(255, 255, 255, .72); --glass-brd: rgba(255, 255, 255, .85); --glass-line: rgba(120, 85, 0, .14); --glass-edge: rgba(120, 85, 0, .14); --rim: linear-gradient(to bottom right, rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, .5) 11%, rgba(255, 255, 255, 0) 32%, rgba(255, 255, 255, 0) 68%, rgba(255, 255, 255, .45) 89%, rgba(255, 255, 255, .95) 100%);
  --glass-hi: inset 1px 1px 0 rgba(255, 255, 255, .95), inset -1px -1px 0 rgba(255, 255, 255, .45);
  --glass-shadow: 0 16px 44px rgba(120, 85, 0, .2), 0 2px 8px rgba(120, 85, 0, .1);
  --glass-blur: blur(28px) saturate(1.8); --scrim: rgba(70, 50, 0, .3); --canvas-glass: rgba(255, 214, 90, .28);
  --blobs: radial-gradient(900px 620px at 4% -8%, rgba(255, 255, 255, .95), transparent 62%), radial-gradient(760px 700px at 100% 8%, rgba(255, 196, 30, .5), transparent 64%), radial-gradient(900px 700px at 62% 112%, rgba(255, 226, 110, .85), transparent 62%), radial-gradient(520px 420px at 0% 100%, rgba(120, 200, 255, .28), transparent 66%);
  --ui: "Plus Jakarta Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
  color-scheme: light;
}
:root[data-theme="dark"] {
  --bg: #0B0D13; --surface: #1B1E2A; --surface2: rgba(255, 255, 255, .08); --line: rgba(255, 255, 255, .12); --ink: #F3F0E4; --ink2: #C2BEAE; --ink3: #908D7D;
  --acc: #FFD25A; --acc-ink: #2A2310; --acc-soft: rgba(255, 210, 90, .18); --acc-text: #FFD25A; --acc-edge: rgba(255, 236, 170, .6); --sel: #FFD25A; --sel-edge: rgba(0, 0, 0, .6); --ok: #3DD6A0; --err: #FF6B84; --focus: #6EA8FF;
  --bar: #0D0F15; --bar-ink: #F3F0E4; --canvas: #0B0D13; --shadow: 0 8px 28px rgba(0, 0, 0, .45); --shadow2: 0 18px 54px rgba(0, 0, 0, .65);
  --bar-hover: rgba(255, 255, 255, .1); --bar-chip: rgba(255, 255, 255, .08); --bar-chip-h: rgba(255, 255, 255, .16); --bar-line: rgba(255, 255, 255, .2); --sbar: #3B3318;
  --glass: rgba(30, 33, 43, .56); --glass-bar: rgba(22, 25, 34, .5); --glass-pop: rgba(30, 33, 43, .8); --glass-modal: rgba(24, 26, 34, .8);
  --glass2: rgba(255, 255, 255, .07); --glass2-h: rgba(255, 255, 255, .15); --glass-brd: rgba(255, 255, 255, .14); --glass-line: rgba(255, 255, 255, .09); --glass-edge: rgba(255, 255, 255, .07); --rim: linear-gradient(to bottom right, rgba(255, 255, 255, .85) 0%, rgba(255, 255, 255, .38) 11%, rgba(255, 255, 255, 0) 32%, rgba(255, 255, 255, 0) 68%, rgba(255, 255, 255, .32) 89%, rgba(255, 255, 255, .75) 100%);
  --glass-hi: inset 1px 1px 0 rgba(255, 255, 255, .2), inset -1px -1px 0 rgba(255, 255, 255, .05);
  --glass-shadow: 0 20px 56px rgba(0, 0, 0, .5), 0 2px 10px rgba(0, 0, 0, .3);
  --glass-blur: blur(28px) saturate(1.7); --scrim: rgba(4, 6, 12, .58); --canvas-glass: rgba(0, 0, 0, .3);
  --blobs: radial-gradient(900px 640px at 6% -10%, rgba(255, 206, 80, .34), transparent 62%), radial-gradient(820px 720px at 100% 8%, rgba(92, 98, 255, .3), transparent 64%), radial-gradient(1000px 760px at 68% 112%, rgba(20, 196, 174, .26), transparent 62%), radial-gradient(560px 460px at 0% 100%, rgba(255, 80, 160, .16), transparent 66%), radial-gradient(700px 420px at 50% 46%, rgba(255, 210, 90, .06), transparent 70%);
  color-scheme: dark;
}
/* senza backdrop-filter il vetro diventa quasi opaco */
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  :root { --glass: rgba(255, 251, 233, .94); --glass-bar: rgba(255, 251, 233, .96); --glass-pop: #FFFBE9; --glass-modal: #FFFBE9; }
  :root[data-theme="dark"] { --glass: rgba(30, 33, 43, .96); --glass-bar: rgba(22, 25, 34, .96); --glass-pop: #1E212B; --glass-modal: #181A22; }
}

*, *::before, *::after { box-sizing: border-box; }
html, body { min-height: 100%; }
body { background: var(--bg); color: var(--ink); font-family: var(--ui); font-size: 14px; line-height: 1.45; -webkit-font-smoothing: antialiased; overflow-x: hidden; }
#app { min-height: 100%; }
* { scrollbar-width: none; }
*::-webkit-scrollbar { display: none; width: 0; height: 0; }
button { font: inherit; color: inherit; cursor: pointer; border: 0; background: none; padding: 0; }
button:disabled { opacity: .45; cursor: default; }
input, textarea, select { font: inherit; color: inherit; }
h1, h2, h3, p { margin: 0; }
ul { list-style: none; margin: 0; padding: 0; }
:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
.grow { flex: 1; }
.row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
.ic { display: block; flex: none; }
.icw { display: inline-flex; flex: none; }
.sl, .sl * { box-sizing: border-box; }
kbd { font: 600 11px var(--ui); background: var(--surface2); border: 1px solid var(--line); border-radius: 5px; padding: 1px 6px; color: var(--ink2); }

/* pulsanti */
.btn { display: inline-flex; align-items: center; gap: 8px; height: 40px; padding: 0 16px; border-radius: 10px; font-weight: 700; background: var(--surface); border: 1px solid var(--line); white-space: nowrap; transition: background .12s, transform .06s; }
.btn:hover { background: var(--surface2); }
.btn:active { transform: translateY(1px); }
.btn.primary { background: var(--acc); border-color: var(--acc-edge); color: var(--acc-ink); }
.btn.primary:hover { filter: brightness(1.06); background: var(--acc); }
.btn.dark { background: #2A2310; border-color: #2A2310; color: #FFF6D6; }
.btn.ghost { background: transparent; border-color: transparent; }
.btn.ghost:hover { background: var(--surface2); }
.btn.danger { background: var(--err); border-color: var(--err); color: #fff; }
.ibtn { display: inline-grid; place-items: center; width: 36px; height: 36px; border-radius: 9px; color: var(--ink2); }
.ibtn:hover, .ibtn.open { background: var(--surface2); color: var(--ink); }
.link { color: var(--acc-text); font-weight: 700; }
.link:hover { text-decoration: underline; }
.inp { height: 40px; width: 100%; border: 1px solid var(--line); background: var(--surface); border-radius: 10px; padding: 0 12px; }
.inp.sm { height: 34px; border-radius: 8px; }
.inp.area { height: auto; padding: 12px; resize: vertical; line-height: 1.5; }
.seg { display: inline-flex; background: var(--surface2); border-radius: 10px; padding: 3px; gap: 2px; }
.seg button { height: 30px; padding: 0 12px; border-radius: 8px; font-weight: 700; color: var(--ink2); display: inline-flex; align-items: center; gap: 6px; }
.seg button.on { background: var(--surface); color: var(--ink); box-shadow: 0 1px 3px rgba(0, 0, 0, .12); }

/* menu e popover */
.pop { position: fixed; z-index: 3000; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; box-shadow: var(--shadow2); opacity: 0; transform: translateY(-4px); transition: opacity .12s, transform .12s; max-width: calc(100vw - 16px); color: var(--ink); }
.pop.in { opacity: 1; transform: none; }
.menu-pop { padding: 6px; min-width: 210px; }
.menu { display: flex; flex-direction: column; }
.mi { display: flex; align-items: center; gap: 10px; height: 38px; padding: 0 10px; border-radius: 8px; text-align: left; font-weight: 600; width: 100%; }
.mi:hover:not(:disabled) { background: var(--surface2); }
.mi.danger { color: var(--err); }
.mi .ml { flex: 1; }
.mi.on { color: var(--acc-text); }
.msep { height: 1px; background: var(--line); margin: 5px 4px; }
.mhead { font: 700 11px var(--ui); letter-spacing: .08em; text-transform: uppercase; color: var(--ink3); padding: 8px 10px 4px; }
.modal { position: fixed; inset: 0; z-index: 900; background: rgba(8, 11, 24, .55); display: grid; place-items: center; padding: 16px; opacity: 0; transition: opacity .15s; backdrop-filter: blur(3px); }
.modal.in { opacity: 1; }
.mbox { background: var(--surface); border-radius: 18px; box-shadow: var(--shadow2); width: min(560px, 100%); max-height: calc(100vh - 32px); display: flex; flex-direction: column; overflow: hidden; }
.mbox.wide { width: min(900px, 100%); }
.mbox.small { width: min(440px, 100%); }
.mhd { display: flex; align-items: center; justify-content: space-between; padding: 14px 14px 6px 22px; }
.mhd h2 { font-size: 19px; font-weight: 800; }
.mbd { padding: 8px 22px 18px; overflow: auto; min-height: 0; }
.mft { display: flex; gap: 10px; align-items: center; padding: 14px 22px; border-top: 1px solid var(--line); flex-wrap: wrap; }
.mtext { color: var(--ink2); margin-bottom: 12px; }
.fnote { color: var(--ink3); font-size: 13px; }
.form { display: flex; flex-direction: column; gap: 12px; }
.flab { font-weight: 700; font-size: 13px; color: var(--ink2); }
.aistatus { min-height: 20px; color: var(--ink2); font-size: 13px; }
.kbtab { width: 100%; border-collapse: collapse; }
.kbtab td { padding: 7px 0; border-bottom: 1px solid var(--line); } .kbtab td:last-child { text-align: right; }

/* selettori */
.cpop { width: 272px; padding: 12px; max-height: 80vh; overflow: auto; }
.cph { font: 700 11px var(--ui); letter-spacing: .07em; text-transform: uppercase; color: var(--ink3); margin: 10px 0 6px; }
.cph:first-child { margin-top: 0; }
.swgrid { display: grid; grid-template-columns: repeat(8, 1fr); gap: 5px; }
.swgrid.g6 { grid-template-columns: repeat(4, 1fr); }
.sw { aspect-ratio: 1; border-radius: 7px; border: 1px solid rgba(0, 0, 0, .14); }
.sw.big { aspect-ratio: 2/1; }
.sw:hover { transform: scale(1.12); }
.sw.sel { outline: 2px solid var(--focus); outline-offset: 1px; }
.swnone { display: flex; align-items: center; gap: 8px; width: 100%; height: 34px; padding: 0 10px; border-radius: 8px; border: 1px dashed var(--line); margin-bottom: 4px; font-weight: 600; }
.crow { display: flex; gap: 8px; align-items: center; margin-top: 12px; }
.crow input[type=color] { width: 40px; height: 34px; border: 1px solid var(--line); border-radius: 8px; background: none; padding: 2px; }
.cpick .seg { width: 100%; margin-bottom: 10px; } .cpick .seg button { flex: 1; justify-content: center; }
.fpop { width: 280px; padding: 10px; }
.flist { max-height: 340px; overflow: auto; margin-top: 8px; }
.fi { display: block; width: 100%; text-align: left; height: 38px; padding: 0 10px; border-radius: 8px; font-size: 18px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.fi:hover { background: var(--surface2); } .fi.sel { background: var(--acc-soft); }
.rng { display: flex; align-items: center; gap: 10px; margin-top: 10px; font-weight: 600; font-size: 13px; }
.rng .rl { width: 92px; flex: none; color: var(--ink2); }
.rng input[type=range] { flex: 1; accent-color: var(--acc); min-width: 0; }
.rng .rv { width: 40px; text-align: right; color: var(--ink2); font-variant-numeric: tabular-nums; }

/* avvisi */
#toasts { position: fixed; left: 50%; bottom: 28px; transform: translateX(-50%); z-index: 2000; display: flex; flex-direction: column; gap: 8px; align-items: center; pointer-events: none; }
.toast { background: #2A2310; color: #FFF6D6; padding: 11px 18px; border-radius: 12px; box-shadow: var(--shadow2); display: flex; gap: 8px; align-items: center; font-weight: 600; opacity: 0; transform: translateY(10px); transition: all .25s; }
.toast.in { opacity: 1; transform: none; } .toast.err { background: var(--err); }
#measure { position: fixed; left: -99999px; top: 0; visibility: hidden; pointer-events: none; width: 4000px; }

/* pagina renderizzata */
.sl { position: relative; overflow: hidden; transform-origin: 0 0; background-clip: padding-box; }
.sl .el { position: absolute; transform-origin: 50% 50%; user-select: none; -webkit-user-select: none; }
.sl .el-line { height: 0; }
.sl .shp { display: block; }
.sl .gin { position: absolute; left: 0; top: 0; pointer-events: none; }
.sl .el img { width: 100%; height: 100%; object-fit: cover; display: block; pointer-events: none; }
.sl .tx { white-space: pre-wrap; overflow-wrap: break-word; word-break: normal; outline: none; box-sizing: border-box; width: 100%; font-kerning: normal; }
.sl .tx .p { min-height: 1em; margin-bottom: var(--ps, 0); }
.sl .tx .p:last-child { margin-bottom: 0; }
.sl .tx .p[data-l] { position: relative; padding-left: 1.15em; }
.sl .tx .p[data-l="b"]::before { content: "•"; position: absolute; left: 0; color: var(--bc, currentColor); font-weight: 700; }
.sl .tx { counter-reset: nn; }
.sl .tx .p[data-l="n"] { counter-increment: nn; padding-left: 1.5em; }
.sl .tx .p[data-l="n"]::before { content: counter(nn) "."; position: absolute; left: 0; color: var(--bc, currentColor); font-weight: 700; }
.sl .tx .p:not([data-l="n"]) { counter-reset: nn; }
.sl .tbl .tc { padding: 0 20px; display: flex; align-items: center; overflow: hidden; line-height: 1.2; }
.thumb { position: relative; overflow: hidden; width: 100%; pointer-events: none; background: #fff; container-type: normal; }
.thumb > .sl { position: absolute; left: 0; top: 0; transform: scale(var(--k, .1)); }

/* ===== Nella piattaforma niente testo evidenziato: si selezionano solo i contenuti (testi della presentazione, campi di scrittura, link) ===== */
html, body { -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; }
input, textarea, select, [contenteditable=""], [contenteditable="true"], [contenteditable="plaintext-only"],
.selectable, .shlink input, .sl .el.editing .tx, .sl .tc[contenteditable], .cmt1, .cmrep p { -webkit-user-select: text; user-select: text; }
::selection { background: color-mix(in srgb, var(--acc) 40%, transparent); color: inherit; }

/* ---------- Home ---------- */
#app.home { display: grid; grid-template-columns: 236px minmax(0, 1fr); min-height: 100vh; min-height: 100dvh; }
.side { background: var(--surface); border-right: 1px solid var(--line); padding: 18px 14px; display: flex; flex-direction: column; gap: 18px; overflow: auto; position: sticky; top: 0; height: 100vh; height: 100dvh; align-self: start; }
.logo { display: flex; align-items: center; gap: 10px; padding: 2px 6px; }
.lname { font: 800 24px var(--ui); letter-spacing: -.02em; }
.crea { justify-content: center; height: 46px; font-size: 15px; border-radius: 12px; }
.side ul { display: flex; flex-direction: column; gap: 2px; }
.nv { display: flex; align-items: center; gap: 12px; width: 100%; height: 44px; padding: 0 12px; border-radius: 10px; font-weight: 700; color: var(--ink2); }
.nv:hover { background: var(--surface2); color: var(--ink); }
.nv.on { background: var(--acc-soft); color: var(--acc-text); }
.cnt { margin-left: auto; font-style: normal; font-size: 12px; background: var(--surface2); border-radius: 20px; padding: 1px 8px; color: var(--ink2); }
.col { display: flex; flex-direction: column; min-width: 0; min-height: 100vh; min-height: 100dvh; }
.top { display: flex; align-items: center; gap: 10px; padding: 12px 28px; background: var(--bg); position: sticky; top: 0; z-index: 20; }
.topsearch { display: flex; align-items: center; gap: 10px; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; height: 44px; padding: 0 14px; width: min(520px, 100%); color: var(--ink3); }
.topsearch input { border: 0; background: none; outline: none; flex: 1; min-width: 0; height: 100%; color: var(--ink); }
.sync { display: inline-flex; gap: 6px; align-items: center; font-size: 12px; font-weight: 600; color: var(--ink3); white-space: nowrap; }
.main { flex: 1; padding: 0 28px 48px; }
.page { max-width: 1240px; margin: 0 auto; display: flex; flex-direction: column; gap: 30px; padding-top: 6px; }
.page > .lead { color: var(--ink2); margin-top: -18px; }
.hero { position: relative; background: var(--acc); color: var(--acc-ink); border-radius: 24px; padding: 44px 48px; overflow: hidden; min-height: 230px; display: flex; align-items: center; }
.hero-art { position: absolute; right: -10px; bottom: -4px; height: 112%; aspect-ratio: 520/300; pointer-events: none; }
.hero-art svg { width: 100%; height: 100%; }
.hero-in { position: relative; max-width: 620px; display: flex; flex-direction: column; gap: 10px; }
.hero h1 { font-size: clamp(26px, 4vw, 40px); font-weight: 800; letter-spacing: -.025em; line-height: 1.1; text-wrap: balance; }
.hero p { opacity: .92; font-size: 15px; margin-bottom: 8px; }
.herobox { display: flex; align-items: center; gap: 10px; background: #fff; color: var(--ink); border-radius: 14px; padding: 6px 6px 6px 14px; box-shadow: 0 8px 28px rgba(0, 0, 0, .18); }
.herobox .icw { color: var(--ink3); }
.herosearch { flex: 1; min-width: 0; border: 0; outline: none; background: none; height: 40px; color: #141A2E; font-size: 15px; }
.qas { display: flex; gap: 8px; flex-wrap: wrap; justify-content: space-between; }
.qa { display: flex; flex-direction: column; align-items: center; gap: 8px; width: 112px; font-weight: 700; font-size: 13px; text-align: center; color: var(--ink2); padding: 4px; border-radius: 14px; }
.qa:hover { color: var(--ink); } .qa:hover .qi { transform: translateY(-3px); }
.qi { width: 64px; height: 64px; border-radius: 20px; display: grid; place-items: center; color: #fff; transition: transform .15s; box-shadow: 0 6px 16px rgba(0, 0, 0, .14); }
.sechd { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; flex-wrap: wrap; }
.sechd h2 { font-size: 20px; font-weight: 800; letter-spacing: -.01em; }
.sechd.big { margin-bottom: 0; } .sechd.big h1 { font-size: 30px; font-weight: 800; letter-spacing: -.02em; }
.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(236px, 1fr)); gap: 22px 20px; }
.dcard { display: flex; flex-direction: column; gap: 10px; border-radius: 14px; cursor: pointer; min-width: 0; }
.thwrap { border-radius: 12px; overflow: hidden; border: 1px solid var(--line); background: var(--surface2); transition: box-shadow .15s, transform .15s; aspect-ratio: 16/9; position: relative; }
.thwrap.loading::after { content: ""; position: absolute; inset: 0; background: linear-gradient(100deg, transparent 20%, rgba(255, 255, 255, .5), transparent 80%); animation: shim 1.3s infinite; }
@keyframes shim { from { transform: translateX(-100%); } to { transform: translateX(100%); } }
.dcard:hover .thwrap { box-shadow: var(--shadow); transform: translateY(-2px); }
.dmeta { display: flex; align-items: flex-start; gap: 4px; justify-content: space-between; }
.dt { display: flex; flex-direction: column; min-width: 0; } .dt b { font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } .ds { color: var(--ink3); font-size: 12.5px; }
.chips { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 18px; }
.chip { height: 34px; padding: 0 16px; border-radius: 20px; background: var(--surface); border: 1px solid var(--line); font-weight: 700; color: var(--ink2); }
.chip:hover { background: var(--surface2); } .chip.on { background: var(--ink); color: var(--bg); border-color: var(--ink); }
.empty { display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center; padding: 44px 16px; border: 1.5px dashed var(--line); border-radius: 16px; color: var(--ink3); }
.empty h3 { color: var(--ink); font-size: 17px; } .empty p { max-width: 380px; margin-bottom: 8px; }
.pv { display: flex; flex-direction: column; gap: 14px; }
.pvstage { border-radius: 12px; overflow: hidden; border: 1px solid var(--line); aspect-ratio: 16/9; }
.pvstrip { display: flex; gap: 8px; overflow-x: auto; padding: 2px 2px 8px; }
.pvt { flex: none; width: 118px; border-radius: 8px; overflow: hidden; border: 2px solid transparent; outline: 1px solid var(--line); pointer-events: auto; }
.pvt.on { border-color: var(--acc); } .pvt .thumb { pointer-events: none; }
.bgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; }
.panelc { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 20px; display: flex; flex-direction: column; gap: 14px; }
.panelc h3 { font-size: 16px; }
.bcolors { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
.bsw { height: 74px; border-radius: 12px; border: 1px solid rgba(0, 0, 0, .12); display: flex; align-items: flex-end; padding: 6px 8px; font: 700 11px var(--ui); }
.bsw span { background: rgba(255, 255, 255, .85); color: #111; border-radius: 5px; padding: 1px 5px; }
.fontbtn { text-align: left; border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; display: flex; flex-direction: column; } .fontbtn b { font-size: 24px; font-weight: 400; } .fontbtn small { color: var(--ink3); font: 600 12px var(--ui); }
.logobox { height: 120px; border: 1.5px dashed var(--line); border-radius: 12px; display: grid; place-items: center; color: var(--ink3); overflow: hidden; }
.logobox img { max-height: 100px; max-width: 80%; object-fit: contain; }
.tpick { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 8px; }
.tp { display: flex; align-items: center; gap: 8px; padding: 6px 8px; border-radius: 10px; border: 1.5px solid var(--line); font-weight: 600; font-size: 13px; text-align: left; }
.tp.on { border-color: var(--acc); background: var(--acc-soft); }
.tpc { width: 30px; height: 22px; border-radius: 6px; border: 2px solid; display: flex; gap: 2px; align-items: flex-end; padding: 2px; flex: none; } .tpc i { flex: 1; height: 45%; border-radius: 2px; }

@media (max-width: 860px) {
  #app.home { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto minmax(0, 1fr); }
  .col { min-height: 0; } .top { position: static; }
  .side { height: auto; align-self: stretch; z-index: 30; flex: none; min-height: 58px; flex-direction: row; align-items: center; padding: 8px 12px; border-right: 0; border-bottom: 1px solid var(--line); gap: 8px; overflow-x: auto; }
  .side .lname { display: none; } .crea { height: 40px; padding: 0 12px; }
  .side ul { flex-direction: row; } .nv { width: auto; padding: 0 10px; height: 40px; } .nv span { display: none; } .nv.on span { display: inline; }
  .top { padding: 10px 16px; } .main { padding: 0 16px 40px; } .sync { display: none; }
  .hero { padding: 28px 22px; } .hero-art { opacity: .35; }
  .qas { justify-content: flex-start; } .qa { width: 88px; } .grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 16px 12px; }
}

.pbar { height: 8px; background: var(--surface2); border-radius: 8px; overflow: hidden; } .pbar i { display: block; height: 100%; width: 0; background: var(--acc); transition: width .2s; }

/* ---------- Editor ---------- */
#app.editor { display: grid; grid-template-rows: 56px minmax(0, 1fr); height: 100vh; height: 100dvh; overflow: hidden; }
.etop { display: flex; align-items: center; gap: 8px; padding: 0 14px; background: var(--bar); color: var(--bar-ink); min-width: 0; }
.etop { border-bottom: 1px solid var(--line); }
.etop .ibtn.dk { color: var(--bar-ink); } .etop .ibtn.dk:hover { background: var(--bar-hover); }
.etop .ibtn.dk:disabled { opacity: .35; }
.ename { background: transparent; border: 1px solid transparent; border-radius: 8px; height: 36px; padding: 0 10px; color: var(--bar-ink); font-weight: 700; width: min(300px, 32vw); min-width: 80px; }
.ename:hover { border-color: var(--bar-line); } .ename:focus { background: var(--bar-chip); outline: 2px solid var(--focus); }
.savest { font-size: 12px; opacity: .7; white-space: nowrap; } .savest.warn { color: #B45309; opacity: 1; font-weight: 700; }
.btn.dkbtn { background: var(--bar-chip); border-color: var(--bar-line); color: var(--bar-ink); } .btn.dkbtn:hover { background: var(--bar-chip-h); }
.ebody { display: grid; grid-template-columns: 62px 264px minmax(0, 1fr); min-height: 0; }
.ebody.nopanel { grid-template-columns: 62px 0 minmax(0, 1fr); }
.rail { background: var(--surface); border-right: 1px solid var(--line); display: flex; flex-direction: column; padding: 6px 4px; gap: 2px; overflow-y: auto; }
.rb { display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 8px 0; border-radius: 10px; font: 700 10px var(--ui); color: var(--ink2); }
.rb:hover { background: var(--surface2); color: var(--ink); } .rb.on { background: var(--acc-soft); color: var(--acc-text); }
.panel { background: var(--surface); border-right: 1px solid var(--line); display: flex; flex-direction: column; min-height: 0; overflow: hidden; }
.nopanel .panel { visibility: hidden; border: 0; }
.phd { display: flex; align-items: center; justify-content: space-between; padding: 8px 8px 2px 14px; } .phd h2 { font-size: 15px; font-weight: 800; }
.pbd { overflow-y: auto; padding: 6px 12px 20px; display: flex; flex-direction: column; gap: 14px; min-height: 0; }
.ps h3 { font-size: 13px; color: var(--ink2); margin-bottom: 10px; font-weight: 800; }
.full { width: 100%; justify-content: center; }
.btn.sm { height: 32px; padding: 0 12px; font-size: 13px; border-radius: 8px; }
.pempty { color: var(--ink3); text-align: center; padding: 30px 0; }
.psearch { padding-bottom: 2px; }
.laygrid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.lay { display: flex; flex-direction: column; gap: 5px; text-align: left; font-size: 12px; font-weight: 700; color: var(--ink2); }
.lay .thumb { border-radius: 8px; border: 1px solid var(--line); } .lay:hover .thumb { outline: 2px solid var(--acc); }
.shimmer { color: var(--ink3); grid-column: 1/-1; padding: 12px 0; }
.stylegrid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.sty { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 4px 8px; padding: 8px; border: 1.5px solid var(--line); border-radius: 12px; text-align: left; }
.sty.on { border-color: var(--acc); background: var(--acc-soft); } .sty:hover { border-color: var(--ink3); }
.stc { grid-column: 1/-1; height: 38px; border-radius: 8px; display: flex; gap: 4px; align-items: flex-end; padding: 5px; border: 1px solid rgba(0, 0, 0, .1); } .stc i { flex: 1; border-radius: 3px; height: 100%; }
.sty b { font-size: 20px; font-weight: 700; order: 2; } .sty small { font-weight: 700; color: var(--ink2); }
.egrid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
.egrid.l3 { grid-template-columns: repeat(3, 1fr); } .egrid.l2 { grid-template-columns: repeat(2, 1fr); } .egrid.emo { grid-template-columns: repeat(6, 1fr); }
.eb { aspect-ratio: 1; display: grid; place-items: center; border-radius: 10px; background: var(--surface2); color: var(--ink); font-size: 26px; }
.eb:hover { background: var(--acc-soft); color: var(--acc-text); }
.eb.wide { aspect-ratio: auto; height: 44px; } .eb.card { aspect-ratio: auto; height: 78px; font-size: 12px; font-weight: 700; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 6px; }
.tmini { display: grid; gap: 2px; width: 46px; } .tmini i { height: 6px; background: currentColor; opacity: .35; border-radius: 1px; } .tmini i.hd { opacity: 1; }
.tplist { display: flex; flex-direction: column; gap: 8px; }
.tpb { text-align: left; padding: 12px 14px; border-radius: 10px; background: var(--surface2); color: var(--ink); } .tpb:hover { background: var(--acc-soft); }
.tpb.tp1 { font-size: 26px; } .tpb.tp2 { font-size: 20px; } .tpb.tp3 { font-size: 15px; }
.combos { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.combo { display: flex; flex-direction: column; gap: 4px; padding: 14px 10px; border-radius: 12px; background: var(--surface2); text-align: left; overflow: hidden; min-width: 0; }
.combo:hover { background: var(--acc-soft); } .cb1 { font-size: 22px; line-height: 1.1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } .cb2 { font-size: 12px; color: var(--ink2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.drop { display: flex; flex-direction: column; align-items: center; gap: 4px; width: 100%; padding: 22px; border: 1.5px dashed var(--line); border-radius: 14px; color: var(--ink2); } .drop:hover { border-color: var(--acc); color: var(--acc-text); } .drop small { color: var(--ink3); }
.imggrid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 8px; }
.imgb { aspect-ratio: 16/10; border-radius: 8px; overflow: hidden; background: var(--surface2); border: 1px solid var(--line); } .imgb:hover { outline: 2px solid var(--acc); } .imgb img { width: 100%; height: 100%; object-fit: cover; display: block; }
.imgb.logo { width: 100%; aspect-ratio: 3/1; background: #fff; } .imgb.logo img { object-fit: contain; }
.chk { display: flex; align-items: center; gap: 8px; font-weight: 600; font-size: 13px; } .chk input { accent-color: var(--acc); width: 16px; height: 16px; }
.dot { width: 18px; height: 18px; border-radius: 50%; border: 1px solid rgba(0, 0, 0, .2); display: inline-block; flex: none; }
.layers { display: flex; flex-direction: column; gap: 4px; }
.lr { display: flex; align-items: center; gap: 8px; padding: 6px 4px 6px 10px; border-radius: 9px; cursor: pointer; border: 1px solid transparent; color: var(--ink2); } .lr:hover { background: var(--surface2); }
.lr.sel { background: var(--acc-soft); border-color: var(--acc); color: var(--ink); } .lr.hid { opacity: .5; }
.ln { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: 600; }
.ibtn.sm { width: 28px; height: 28px; }

/* barra contestuale */
.emain { display: flex; flex-direction: column; min-width: 0; min-height: 0; background: var(--canvas); }
.ctx { display: flex; align-items: center; gap: 2px; padding: 3px 8px; background: var(--surface); border-bottom: 1px solid var(--line); min-height: 42px; overflow-x: auto; flex: none; scrollbar-width: thin; }
.ctx > * { flex: none; } .ctx > .grow { flex: 1 0 8px; }
.tbb { display: inline-flex; align-items: center; justify-content: center; gap: 5px; height: 32px; min-width: 32px; padding: 0 7px; border-radius: 8px; font-weight: 700; font-size: 12.5px; color: var(--ink); white-space: nowrap; }
.tbb:hover, .tbb.open { background: var(--surface2); } .tbb.on { background: var(--acc-soft); color: var(--acc-text); }
.tbsep { width: 1px; height: 20px; background: var(--line); margin: 0 4px; }
.tbg { display: inline-flex; align-items: center; gap: 1px; border: 1px solid var(--line); border-radius: 8px; padding: 0 1px; height: 32px; }
.tbg .tbb { height: 28px; min-width: 28px; padding: 0 4px; }
.tsize { width: 40px; height: 26px; border: 0; background: none; text-align: center; font-weight: 700; color: var(--ink); -moz-appearance: textfield; } .tsize::-webkit-inner-spin-button { display: none; }
.fontb { border: 1px solid var(--line); min-width: 120px; max-width: 150px; justify-content: space-between; font-size: 14px; } .fontb span { overflow: hidden; text-overflow: ellipsis; font-weight: 400; }
.sw2 { padding: 0; width: 32px; } .sw2c { width: 20px; height: 20px; border-radius: 6px; border: 1px solid rgba(0, 0, 0, .25); display: block; }
.sl2 { font: 800 17px var(--ui); border-bottom: 4px solid; line-height: 1.1; padding: 0 3px; }
.tbinfo { color: var(--ink3); font-size: 12.5px; padding: 0 8px; white-space: nowrap; }
.tinl { display: flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 700; color: var(--ink2); } .tinl input { width: 90px; accent-color: var(--acc); }
.ppop { width: 300px; padding: 14px; max-height: 78vh; overflow: auto; } .pp { display: flex; flex-direction: column; gap: 8px; }
.btnrow { display: flex; gap: 6px; flex-wrap: wrap; } .btnrow > .btn { flex: 1; justify-content: center; } .btnrow.g3 { display: grid; grid-template-columns: repeat(3, 1fr); }
.nfs { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; } .nf { display: flex; flex-direction: column; gap: 3px; font-size: 12px; font-weight: 700; color: var(--ink2); }
.hint { padding: 8px 10px; font-size: 12px; color: var(--ink3); max-width: 230px; }
.crow2 { display: flex; align-items: center; gap: 8px; font-weight: 600; }
.cedit { display: flex; flex-direction: column; gap: 12px; } .cgrid { display: grid; gap: 6px; } .chd { font-weight: 700; font-size: 12px; color: var(--ink2); align-self: center; }
.apopw { width: 340px; } .apop { display: flex; flex-direction: column; gap: 10px; } .apop .seg { width: 100%; } .apop .seg button { flex: 1; justify-content: center; }
.agrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
.acard { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 8px 4px 7px; border-radius: 10px; border: 1.5px solid var(--line); background: var(--surface); font-size: 12px; font-weight: 700; color: var(--ink2); }
.acard:hover { border-color: var(--ink3); } .acard.on { border-color: var(--acc); background: var(--acc-soft); color: var(--ink); }
.apv { height: 36px; width: 100%; display: grid; place-items: center; overflow: hidden; border-radius: 6px; background: var(--surface2); }
.apv i { display: block; width: 28px; height: 18px; border-radius: 5px; background: var(--acc); }
.apt-in.apv-fade { animation: an-fade 1.8s infinite; } .apt-in.apv-rise { animation: an-rise 1.8s infinite; } .apt-in.apv-drop { animation: an-drop 1.8s infinite; }
.apt-in.apv-left { animation: an-left 1.8s infinite; } .apt-in.apv-right { animation: an-right 1.8s infinite; } .apt-in.apv-zoom { animation: an-zoom 1.8s infinite; }
.apt-in.apv-pop { animation: an-pop 1.8s infinite; } .apt-in.apv-blur { animation: an-blur 1.8s infinite; } .apt-in.apv-write { animation: an-write 1.8s infinite; }
.apt-in.apv-flip { animation: an-flip 1.8s infinite; } .apt-in.apv-tada { animation: an-tada 1.8s infinite; }
.apt-out.apv-fade { animation: ao-fade 1.8s infinite; } .apt-out.apv-sink { animation: ao-sink 1.8s infinite; } .apt-out.apv-up { animation: ao-up 1.8s infinite; }
.apt-out.apv-left { animation: ao-left 1.8s infinite; } .apt-out.apv-right { animation: ao-right 1.8s infinite; } .apt-out.apv-shrink { animation: ao-shrink 1.8s infinite; }
.apt-loop.apv-pulse { animation: al-pulse 1.4s ease-in-out infinite; } .apt-loop.apv-float { animation: al-float 1.4s ease-in-out infinite; } .apt-loop.apv-wiggle { animation: al-wiggle 1s ease-in-out infinite; }
.apt-loop.apv-spin { animation: al-spin 2.4s linear infinite; } .apt-loop.apv-blink { animation: al-blink 1.2s ease-in-out infinite; }
@media (prefers-reduced-motion: reduce) { .apv i { animation: none !important; } }
.rb.ai { color: var(--acc-text); } .rb.ai.on { background: var(--acc); color: var(--acc-ink); }
.aibox { display: flex; flex-direction: column; gap: 10px; } .aibox .seg { width: 100%; } .aibox .seg button { flex: 1; justify-content: center; padding: 0 4px; font-size: 12px; }
.aimsg { background: var(--acc-soft); border-radius: 10px; padding: 10px 12px; font-weight: 600; font-size: 13px; }
.hint2 { color: var(--ink3); font-size: 12px; line-height: 1.4; }
.aichips { display: flex; flex-wrap: wrap; gap: 6px; } .aichips .chip { height: 30px; padding: 0 12px; font-size: 12.5px; }
.imgcols { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.icol { display: flex; align-items: center; gap: 8px; padding: 6px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); text-align: left; } .icol:hover { border-color: var(--ink3); }
.icolsw { width: 30px; height: 30px; border-radius: 8px; border: 1px solid rgba(0, 0, 0, .2); flex: none; } .icolhex { font: 700 12px var(--ui); color: var(--ink2); }
.fxgrid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
.fxcard { display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 6px 2px; border: 1.5px solid var(--line); border-radius: 9px; background: var(--surface); } .fxcard.on { border-color: var(--acc); background: var(--acc-soft); } .fxcard small { font-size: 10.5px; color: var(--ink2); font-weight: 700; }
.fxprev { font-size: 22px; line-height: 1.3; }
.framegrid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; } .frm { aspect-ratio: 1; display: grid; place-items: center; border-radius: 8px; background: var(--surface2); color: var(--ink2); } .frm:hover { background: var(--acc-soft); } .frm.on { background: var(--acc); color: var(--acc-ink); }
.emain { position: relative; }
.drawbar { position: absolute; top: 52px; left: 50%; transform: translateX(-50%); display: flex; align-items: center; gap: 10px; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 6px 10px; box-shadow: var(--shadow2); z-index: 20; flex-wrap: wrap; justify-content: center; max-width: calc(100% - 20px); }
.cwrap.drawing, .cwrap.drawing .sl .el { cursor: crosshair; } .drawpv { position: absolute; left: 0; top: 0; pointer-events: none; overflow: visible; }
.gridov { position: absolute; left: 0; top: 0; pointer-events: none; background-image: linear-gradient(to right, rgba(60, 60, 140, .18) 1px, transparent 1px), linear-gradient(to bottom, rgba(60, 60, 140, .18) 1px, transparent 1px); }
.margov { position: absolute; pointer-events: none; border: calc(1.5px*var(--iz)) dashed rgba(230, 70, 120, .7); }
.gridview { position: absolute; left: 0; right: 0; top: 42px; bottom: 34px; background: var(--canvas); z-index: 15; overflow: auto; }
.gridhd { display: flex; align-items: center; gap: 14px; padding: 14px 22px 0; flex-wrap: wrap; } .gridhd h3 { font-size: 17px; }
.gridlist { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 22px 18px; padding: 18px 22px 30px; align-items: start; }
.gridlist .pg { width: auto; } .gridlist .pgadd { width: auto; }
.posgrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; } .pos { height: 34px; border-radius: 8px; background: var(--surface2); position: relative; } .pos.on { background: var(--acc-soft); outline: 2px solid var(--acc); }
.pos i { position: absolute; width: 14px; height: 6px; border-radius: 3px; background: var(--ink2); } .pos.on i { background: var(--acc); }
.pd-tl { left: 6px; top: 6px; } .pd-tc { left: calc(50% - 7px); top: 6px; } .pd-tr { right: 6px; top: 6px; } .pd-bl { left: 6px; bottom: 6px; } .pd-bc { left: calc(50% - 7px); bottom: 6px; } .pd-br { right: 6px; bottom: 6px; }
.fmtgrid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; } .fmt { display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 12px 8px; border: 1.5px solid var(--line); border-radius: 12px; background: var(--surface); } .fmt.on { border-color: var(--acc); background: var(--acc-soft); }
.fmtb { height: 58px; display: grid; place-items: center; } .fmtb i { display: block; background: var(--ink2); border-radius: 3px; opacity: .5; } .fmt.on .fmtb i { background: var(--acc); opacity: 1; } .fmt small { color: var(--ink3); text-align: center; }
.cwrap.painting, .cwrap.painting .sl .el { cursor: copy; }
.cmdbox .mbd { padding: 4px 14px 14px; } .cmdin { margin-bottom: 8px; } .cmdlist { display: flex; flex-direction: column; max-height: 52vh; overflow: auto; }
.cmd { display: flex; align-items: center; gap: 12px; padding: 0 10px; height: 40px; border-radius: 9px; text-align: left; font-weight: 600; flex: none; } .cmd.on { background: var(--acc-soft); } .cmd small { color: var(--ink3); font-weight: 600; }
.mbox.wide2 { width: min(640px, 100%); }

/* tela */
.cwrap { flex: 1; min-height: 0; overflow: auto; display: flex; padding: 12px; position: relative; scrollbar-width: thin; }
.swrap { margin: auto; flex: none; position: relative; }
.stage { position: absolute; left: 0; top: 0; transform-origin: 0 0; box-shadow: 0 6px 30px rgba(10, 14, 30, .28); }
.stage > .sl { position: absolute; left: 0; top: 0; }
.stage > .ov { position: absolute; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; overflow: visible; }
.sl .el.editing { cursor: text; } .sl .el.editing .tx { cursor: text; user-select: text; -webkit-user-select: text; }
.sl .el { cursor: move; } .sl .el.lk { cursor: default; }
.stage .sl .tc[contenteditable] { background: #fff !important; color: #111 !important; outline: calc(2px*var(--iz)) solid #1E6BFF; user-select: text; }
.sf { position: absolute; outline: calc(2px*var(--iz)) solid var(--sel); outline-offset: 0; pointer-events: none; box-sizing: border-box; box-shadow: 0 0 0 calc(3.5px*var(--iz)) var(--sel-edge), inset 0 0 0 calc(1.5px*var(--iz)) var(--sel-edge); }
.sf.thin { outline-width: calc(1.5px*var(--iz)); outline-color: var(--sel); opacity: .9; box-shadow: none; filter: drop-shadow(0 0 calc(1px*var(--iz)) var(--sel-edge)); } .sf.grp { outline: calc(2px*var(--iz)) dashed var(--sel); opacity: 1; box-shadow: none; filter: drop-shadow(0 0 calc(1px*var(--iz)) var(--sel-edge)); }
.sf.locked { outline-style: dashed; outline-color: #888; box-shadow: none; } .sf.ln { outline: 0; box-shadow: none; border-top: calc(3px*var(--iz)) solid var(--sel); filter: drop-shadow(0 0 calc(1px*var(--iz)) var(--sel-edge)); }
.hd { position: absolute; width: calc(15px*var(--iz)); height: calc(15px*var(--iz)); background: var(--sel); border: calc(2px*var(--iz)) solid var(--sel-edge); border-radius: 50%; transform: translate(-50%, -50%); pointer-events: auto; box-shadow: 0 1px 4px rgba(0, 0, 0, .35); }
.hd[data-h="nw"] { left: 0; top: 0; cursor: nwse-resize; } .hd[data-h="n"] { left: 50%; top: 0; cursor: ns-resize; border-radius: calc(4px*var(--iz)); width: calc(26px*var(--iz)); height: calc(10px*var(--iz)); }
.hd[data-h="ne"] { left: 100%; top: 0; cursor: nesw-resize; } .hd[data-h="e"] { left: 100%; top: 50%; cursor: ew-resize; border-radius: calc(4px*var(--iz)); width: calc(10px*var(--iz)); height: calc(26px*var(--iz)); }
.hd[data-h="se"] { left: 100%; top: 100%; cursor: nwse-resize; } .hd[data-h="s"] { left: 50%; top: 100%; cursor: ns-resize; border-radius: calc(4px*var(--iz)); width: calc(26px*var(--iz)); height: calc(10px*var(--iz)); }
.hd[data-h="sw"] { left: 0; top: 100%; cursor: nesw-resize; } .hd[data-h="w"] { left: 0; top: 50%; cursor: ew-resize; border-radius: calc(4px*var(--iz)); width: calc(10px*var(--iz)); height: calc(26px*var(--iz)); }
.sf.ln .hd[data-h="e"], .sf.ln .hd[data-h="w"] { width: calc(15px*var(--iz)); height: calc(15px*var(--iz)); border-radius: 50%; }
.hd.rot { left: 50%; top: calc(-40px*var(--iz)); width: calc(28px*var(--iz)); height: calc(28px*var(--iz)); cursor: grab; display: grid; place-items: center; color: #444; }
.hd.rot svg { width: calc(14px*var(--iz)); height: calc(14px*var(--iz)); }
.guide { position: absolute; background: #FF2D87; pointer-events: none; } .guide.v { top: 0; bottom: 0; width: calc(1.5px*var(--iz)); margin-left: calc(-.75px*var(--iz)); } .guide.h { left: 0; right: 0; height: calc(1.5px*var(--iz)); margin-top: calc(-.75px*var(--iz)); }
.mq { position: absolute; background: rgba(255, 210, 90, .16); border: calc(1.5px*var(--iz)) solid var(--sel); box-shadow: 0 0 0 calc(1px*var(--iz)) var(--sel-edge); }

/* note, pagine, stato */
.notes { background: var(--surface); border-top: 1px solid var(--line); flex: none; } .notes textarea { display: block; width: 100%; height: 110px; border: 0; outline: 0; resize: none; padding: 12px 18px; background: transparent; }
.strip { display: flex; gap: 10px; padding: 8px 12px 4px; background: var(--surface); border-top: 1px solid var(--line); overflow-x: auto; flex: none; align-items: flex-start; scrollbar-width: thin; }
.pg { position: relative; flex: none; width: 112px; cursor: pointer; border-radius: 8px; }
.pgt { border-radius: 6px; overflow: hidden; outline: 1px solid var(--line); display: block; } .pg.on .pgt { outline: 3px solid var(--acc); } .pg:hover:not(.on) .pgt { outline: 2px solid var(--ink3); }
.pg.over .pgt { outline: 3px dashed var(--acc); }
.pgt { position: relative; } .pg.sel .pgt { outline: 3px solid var(--acc); } .pg.sel .pgt::after { content: ""; position: absolute; inset: 0; background: rgba(255, 210, 90, .26); pointer-events: none; }
.pgck { position: absolute; left: 6px; top: 6px; z-index: 2; width: 22px; height: 22px; border-radius: 50%; background: var(--acc); color: var(--acc-ink); border: 1.5px solid var(--acc-edge); display: grid; place-items: center; }
.sbar { display: flex; align-items: center; gap: 8px; padding: 6px 14px; background: var(--sbar); border-top: 1px solid var(--line); flex: none; flex-wrap: wrap; color: var(--ink); } .sbar b { color: var(--ink); } .sbar[hidden] { display: none; }
.pgn { display: block; text-align: center; font-size: 10.5px; line-height: 1.2; font-weight: 700; color: var(--ink3); margin-top: 3px; } .pg.on .pgn { color: var(--acc-text); }
.pgm { position: absolute; right: 4px; top: 4px; width: 24px; height: 24px; border-radius: 6px; background: rgba(20, 26, 46, .72); color: #fff; display: none; place-items: center; } .pg:hover .pgm { display: grid; }
.pgadd { flex: none; width: 112px; aspect-ratio: 16/9; border: 1.5px dashed var(--line); border-radius: 8px; display: grid; place-items: center; color: var(--ink3); } .pgadd:hover { border-color: var(--acc); color: var(--acc-text); }
.estat { display: flex; align-items: center; gap: 10px; padding: 2px 10px; background: var(--surface); border-top: 1px solid var(--line); height: 34px; flex: none; }
.sbtn { height: 30px; padding: 0 10px; border-radius: 8px; display: inline-flex; gap: 6px; align-items: center; font-weight: 700; font-size: 13px; color: var(--ink2); } .sbtn:hover { background: var(--surface2); } .sbtn.on { background: var(--acc-soft); color: var(--acc-text); }
.pgno, .zlab { font-size: 12.5px; color: var(--ink2); font-weight: 600; } .zlab { width: 42px; text-align: right; }
#zoom { width: 130px; accent-color: var(--acc); }
.small-msg { display: none; }
@media (max-width: 800px) {
  #app.editor { grid-template-rows: 56px 1fr; } .ebody { display: none; } .hide-s { display: none; }
  .small-msg { display: flex; flex-direction: column; gap: 12px; padding: 32px 22px; align-items: flex-start; } .small-msg p { color: var(--ink2); }
  .ename { width: 38vw; }
}
@media (max-width: 1100px) { .ebody { grid-template-columns: 56px 232px minmax(0, 1fr); } .ebody.nopanel { grid-template-columns: 56px 0 minmax(0, 1fr); } }

/* barra compatta come in Canva: etichette solo su schermi larghi */
.ctx .tbb span { display: none; } @media (min-width: 1500px) { .ctx .tbb span { display: inline; } }
.ctx .fontb span { display: inline; } .ctx .tbb:has(+ .tbb) { }
.etop { min-height: 48px; } #app.editor { grid-template-rows: 48px minmax(0, 1fr); }
.etop .btn { height: 34px; }
.estat .sbtn { height: 26px; }
.ctx .tbb:not(:has(svg)) span { display: inline; }
.ctx .tbb > .icw { display: inline-flex; } .ctx .tbb > .sl2, .ctx .tbb > .sw2c { display: block; } .ctx .tbb > .dot { display: inline-block; } .ctx .fontb > span { display: inline; }

/* categorie degli elementi */
.catgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.cat { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; padding: 12px 10px; border: 1.5px solid var(--line); border-radius: 12px; background: var(--surface); text-align: left; } .cat:hover { border-color: var(--acc); background: var(--acc-soft); }
.cat b { font-size: 13.5px; } .cat small { color: var(--ink3); font-size: 11.5px; } .cati { width: 40px; height: 40px; border-radius: 11px; display: grid; place-items: center; background: var(--surface2); color: var(--acc-text); margin-bottom: 6px; }
.subback { display: flex; align-items: center; gap: 4px; margin: 0 0 10px -4px; padding: 4px 8px 4px 2px; border-radius: 8px; font-size: 15px; } .subback:hover { background: var(--surface2); }
.qzstyles { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 8px; } .qzs { padding: 2px; border-radius: 10px; border: 2px solid transparent; } .qzs.on { border-color: var(--acc); }
.qzs span { display: flex; gap: 3px; align-items: flex-end; width: 44px; height: 30px; padding: 4px; border-radius: 7px; border: 1px solid rgba(0, 0, 0, .15); } .qzs i { flex: 1; height: 55%; border-radius: 2px; }
.qzcard { display: flex; flex-direction: column; gap: 3px; width: 100%; text-align: left; padding: 10px; border: 1.5px solid var(--line); border-radius: 12px; background: var(--surface); margin-top: 8px; } .qzcard:hover { border-color: var(--acc); }
.qzcard small { color: var(--ink3); } .qzprev { display: flex; flex-direction: column; gap: 4px; padding: 8px; border-radius: 8px; border: 2px solid transparent; margin-bottom: 4px; } .qzprev i { display: block; height: 7px; border-radius: 3px; } .qzprev .qq { width: 70%; height: 9px; }
.qzopts { display: flex; flex-direction: column; gap: 6px; } .qzrow { display: flex; align-items: center; gap: 8px; } .qzl { width: 18px; font-weight: 800; color: var(--ink3); }
.qzck { width: 26px; height: 26px; border-radius: 50%; border: 2px solid var(--line); display: grid; place-items: center; flex: none; color: #fff; } .qzck.on { background: var(--ok); border-color: var(--ok); }
/* modulo */
.qz { display: block; overflow: hidden; box-sizing: border-box; font-weight: 600; }
.qq { font-weight: 700; line-height: 1.25; overflow: hidden; }
.qb { display: flex; align-items: center; gap: .6em; width: 100%; padding: 0 .8em; text-align: left; font: inherit; font-weight: 600; cursor: inherit; position: relative; box-sizing: border-box; transition: transform .12s, filter .12s; }
.qz.live .qb { cursor: pointer; } .qz.live .qb:hover { filter: brightness(.95); transform: translateX(5px); }
.ql { width: 1.6em; height: 1.6em; border-radius: .45em; display: grid; place-items: center; font-weight: 800; font-size: .85em; flex: none; } .qt { flex: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.qm { width: 1.3em; flex: none; font-style: normal; font-weight: 900; text-align: center; }
.qb.mark .qm::after { content: "✓"; color: var(--ok); }
.qb.sel { outline: 3px solid currentColor; outline-offset: -3px; }
.qb.right { background: var(--ok) !important; color: var(--okt) !important; } .qb.right .qm::after { content: "✓"; }
.qb.wrong { background: var(--ko) !important; color: var(--kot) !important; } .qb.wrong .qm::after { content: "✕"; }
.qb.dim { opacity: .5; }
.qf { display: flex; align-items: center; gap: .8em; } .qmsg { flex: 1; font-weight: 700; font-size: .9em; }
.qchk, .qre { border-radius: .6em; padding: .3em 1em; font: inherit; font-weight: 800; cursor: pointer; } .qre { background: transparent; border: 2px solid currentColor; color: inherit; }
.qchk[hidden], .qre[hidden] { display: none; }
.el-frame.dropt, .sl .el-image.dropt { outline: 6px dashed var(--sel); outline-offset: 4px; }
.cwrap.cropping { cursor: grab; } .cwrap.cropping .sl .el { cursor: grab; }
/* feedback della pressione prolungata sulle pagine */
@keyframes lpop { 0% { transform: scale(1); } 35% { transform: scale(.9); } 100% { transform: scale(1); } } .pg.lpop { animation: lpop .28s ease-out; }

/* ===== Livelli: riga con anteprima, trascinamento come in Canva ===== */
.layers { position: relative; display: flex; flex-direction: column; gap: 4px; }
.lr { height: 50px; box-sizing: border-box; user-select: none; -webkit-user-select: none; touch-action: pan-y; }
.lgrip { display: inline-flex; color: var(--ink3); cursor: grab; margin-left: -4px; flex: 0 0 auto; touch-action: none; padding: 6px 0; } .lr:active .lgrip { cursor: grabbing; }
.lthumb { width: 36px; height: 36px; border-radius: 8px; flex: 0 0 auto; display: grid; place-items: center; overflow: hidden; border: 1px solid var(--line); background: repeating-conic-gradient(var(--line) 0 25%, transparent 0 50%) 50% / 10px 10px; color: var(--ink3); }
.lthumb img { width: 100%; height: 100%; object-fit: contain; } .lthumb svg { width: 78%; height: 78%; } .lthumb b { font-size: 16px; line-height: 1; }
.lmv { display: inline-flex; flex: 0 0 auto; }
.lr.ph { border: 2px dashed var(--acc); background: var(--acc-soft); } .lr.ph > * { visibility: hidden; }
.lrghost { position: fixed; z-index: 6000; pointer-events: none; display: flex; align-items: center; gap: 8px; padding: 6px 4px 6px 10px; border-radius: 10px; background: var(--surface); border: 2px solid var(--acc); box-shadow: 0 16px 36px rgba(0, 0, 0, .5); transform: scale(1.03) rotate(-.6deg); color: var(--ink); }
body.lrdrag, body.lrdrag * { cursor: grabbing !important; }
.sl .el.lhover { outline: 4px solid var(--acc); outline-offset: 3px; }

/* ===== Coach ===== */
.ctime { display: flex; flex-direction: column; margin-bottom: 6px; } .ctime b { font: 800 22px var(--ui); } .ctime small { color: var(--ink3); font-size: 12px; }
.cbars { display: flex; align-items: flex-end; gap: 3px; height: 54px; margin: 6px 0 8px; } .cbars i { flex: 1; min-width: 4px; background: var(--acc); border-radius: 3px 3px 0 0; cursor: pointer; } .cbars i:hover { filter: brightness(1.2); }
.coachbtns { display: flex; flex-direction: column; gap: 6px; }
.mbox.coachbox .mbd { max-height: 68vh; } .cscore { display: flex; gap: 14px; align-items: center; padding: 12px; border-radius: 14px; background: var(--acc-soft); } .cscore b { font: 800 42px var(--ui); color: var(--acc-text); } .cscore span { line-height: 1.4; }
.cch { padding: 10px 12px; border-radius: 12px; background: var(--surface2); } .cch h4 { font: 800 12px var(--ui); letter-spacing: .08em; text-transform: uppercase; color: var(--ink3); margin-bottom: 4px; } .cch ul { margin: 0; padding-left: 18px; display: flex; flex-direction: column; gap: 4px; } .cch p { line-height: 1.5; white-space: pre-wrap; margin-bottom: 6px; }
.cq { padding: 10px 12px; border-radius: 12px; background: var(--surface2); margin-bottom: 6px; } .cq summary { cursor: pointer; font-weight: 700; } .cq p { margin-top: 8px; color: var(--ink2); line-height: 1.5; }

/* ===== Codice e formule ===== */
.codedlg { display: grid; grid-template-columns: 340px 1fr; gap: 16px; } .codel { display: flex; flex-direction: column; gap: 6px; min-width: 0; } .codel textarea { min-height: 200px; }
.coder { min-width: 0; display: flex; align-items: center; } .codeprev { width: 100%; border-radius: 12px; overflow: hidden; border: 1px solid var(--line); background: #1B1E2A; }
.mathprev { min-height: 120px; display: grid; place-items: center; padding: 18px; border-radius: 12px; background: #fff; border: 1px solid var(--line); }
@media (max-width: 800px) { .codedlg { grid-template-columns: 1fr; } }

/* ===== Voce ===== */
.micb { width: 32px; height: 32px; border-radius: 50%; display: inline-grid; place-items: center; background: var(--surface2); color: var(--ink2); border: 1px solid var(--line); flex: 0 0 auto; } .micb:hover { color: var(--ink); border-color: var(--acc); }
.micb.rec { background: #E5304A; color: #fff; border-color: #E5304A; animation: micpulse 1.1s infinite; } .micb.tbm { width: 34px; height: 34px; }
@keyframes micpulse { 0% { box-shadow: 0 0 0 0 rgba(229, 48, 74, .55); } 70% { box-shadow: 0 0 0 10px rgba(229, 48, 74, 0); } 100% { box-shadow: 0 0 0 0 rgba(229, 48, 74, 0); } }
.micwrap { position: relative; display: block; } .micwrap > textarea { padding-right: 44px; } .micb.in { position: absolute; right: 8px; bottom: 8px; width: 30px; height: 30px; }
.micbar { position: absolute; right: 12px; top: 8px; display: flex; gap: 6px; z-index: 2; }
.prc-labrow { display: flex; align-items: center; justify-content: space-between; } .prc-labrow .micb { width: 28px; height: 28px; }

/* ===== Home: preferiti, cartelle, selezione ===== */
.favb { position: absolute; right: 8px; top: 8px; width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; background: rgba(0, 0, 0, .55); color: #fff; opacity: 0; transition: opacity .12s; z-index: 3; }
.dcard:hover .favb, .favb.on, .dcard:focus-within .favb { opacity: 1; } .favb.on { background: var(--acc); color: var(--acc-ink); } .favb.on .ic { fill: currentColor; }
.pickb { position: absolute; left: 8px; top: 8px; width: 28px; height: 28px; border-radius: 8px; background: rgba(0, 0, 0, .55); border: 2px solid #fff; color: transparent; display: grid; place-items: center; z-index: 3; } .pickb.on { background: var(--acc); color: var(--acc-ink); border-color: var(--acc); }
.dcard.picked { outline: 3px solid var(--acc); outline-offset: 2px; border-radius: 14px; }
.fchips { margin-bottom: 8px; } .fchips .chip { display: inline-flex; align-items: center; gap: 6px; } .fchips .chip.over { outline: 2px dashed var(--acc); background: var(--acc-soft); } .fchips .chip.add { border-style: dashed; color: var(--ink2); }
.cnt2 { font-style: normal; font-size: 11px; opacity: .65; font-weight: 700; }
.btn.ghost.on { background: var(--acc-soft); color: var(--acc-text); }
.bulk { position: fixed; left: 50%; bottom: 22px; transform: translateX(-50%); display: flex; align-items: center; gap: 8px; padding: 10px 14px; border-radius: 16px; background: var(--bar); color: var(--bar-ink); box-shadow: var(--shadow2); z-index: 50; flex-wrap: wrap; justify-content: center; } .bulk .btn { background: var(--bar-chip); color: var(--bar-ink); border-color: transparent; } .bulk .btn.danger { color: var(--err); }
.fmove { display: flex; flex-direction: column; gap: 2px; }

/* ===== Cronologia versioni ===== */
.verlist { display: flex; flex-direction: column; gap: 8px; max-height: 50vh; overflow: auto; scrollbar-width: none; } .verlist::-webkit-scrollbar { display: none; }
.verrow { display: grid; grid-template-columns: 88px 1fr auto; gap: 12px; align-items: center; padding: 8px; border-radius: 12px; background: var(--surface2); }
.verth { border-radius: 6px; overflow: hidden; border: 1px solid var(--line); } .vermeta { display: flex; flex-direction: column; gap: 2px; min-width: 0; } .vermeta small { color: var(--ink3); font-size: 12px; }
.verbtn { display: flex; gap: 6px; align-items: center; }

/* ===== Diagrammi ===== */
.dggrid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin-top: 8px; }
.dgc { display: flex; flex-direction: column; gap: 4px; padding: 5px; border-radius: 10px; border: 1px solid var(--line); background: var(--surface); text-align: left; } .dgc:hover { background: var(--surface2); border-color: var(--acc); }
.dgc small { font-size: 11.5px; font-weight: 700; color: var(--ink2); padding: 0 2px; }
.dgth { border-radius: 6px; overflow: hidden; aspect-ratio: 16 / 9; background: var(--surface2); } .dgth.loading { animation: shim 1.2s infinite alternate; }
.mbox.dgbox { width: min(1080px, 100%); }
.dgdlg { display: grid; grid-template-columns: 330px 1fr; gap: 18px; } .dgl { display: flex; flex-direction: column; gap: 6px; min-width: 0; } .dgl .area { font-family: var(--ui); line-height: 1.4; }
.dgr { min-width: 0; display: flex; align-items: center; } .dgprev { width: 100%; border-radius: 12px; overflow: hidden; border: 1px solid var(--line); background: var(--surface2); min-height: 200px; }
@media (max-width: 800px) { .dgdlg { grid-template-columns: 1fr; } }

/* ===== Sezione Grafica (Home) ===== */
.gfxhero { display: grid; grid-template-columns: 1.1fr 1.4fr; gap: 26px; align-items: center; padding: 26px; border-radius: 22px; background: linear-gradient(120deg, var(--acc-soft), var(--surface)); border: 1px solid var(--line); margin-bottom: 18px; }
.gfxhero h1 { font: 800 30px/1.1 var(--ui); margin: 8px 0; } .gfxhero p { color: var(--ink2); line-height: 1.5; max-width: 46ch; }
.gtag { display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border-radius: 20px; background: var(--acc); color: var(--acc-ink); font-weight: 800; font-size: 12.5px; }
.gcards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
.gbig { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; text-align: left; padding: 16px; border-radius: 16px; background: var(--surface); border: 1px solid var(--line); transition: transform .12s, box-shadow .12s; min-height: 132px; }
.gbig:hover { transform: translateY(-3px); box-shadow: var(--shadow); } .gbig b { font-size: 16px; } .gbig small { color: var(--ink3); font-size: 12.5px; line-height: 1.35; }
.gbig .icw { width: 46px; height: 46px; border-radius: 14px; display: grid; place-items: center; color: #fff; } .gbig.logo .icw { background: #E040A0; } .gbig.photo .icw { background: #0E9F8E; } .gbig.up .icw { background: #8B5CF6; }
.kbadge { position: absolute; left: 8px; top: 8px; padding: 2px 9px; border-radius: 10px; background: var(--acc); color: var(--acc-ink); font: 800 11px var(--ui); } .thwrap { position: relative; }
.ggrid { grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); align-items: start; } .gcard .thwrap { min-height: 120px; }
@media (max-width: 860px) { .gfxhero { grid-template-columns: 1fr; } .gcards { grid-template-columns: 1fr; } .gbig { min-height: 0; } }

/* ===== Editor: modelli, materiali, ritocco ===== */
.gdgrid { grid-template-columns: repeat(2, 1fr); gap: 8px; } .gdl .thwrap { border-radius: 6px; overflow: hidden; background: var(--surface2); min-height: 60px; }
.fgrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 7px; } .fl { display: flex; flex-direction: column; gap: 3px; align-items: center; padding: 3px; border-radius: 9px; border: 2px solid transparent; } .fl.on { border-color: var(--acc); }
.fl small { font-size: 10.5px; color: var(--ink2); text-align: center; } .fimg { display: block; width: 100%; aspect-ratio: 1; border-radius: 6px; overflow: hidden; background: var(--surface2); } .fimg img { width: 100%; height: 100%; object-fit: cover; display: block; }
.prow { display: flex; flex-direction: column; gap: 3px; font-size: 12.5px; font-weight: 600; margin-bottom: 8px; } .prow span { display: flex; justify-content: space-between; } .prow b { color: var(--ink3); font-weight: 700; font-variant-numeric: tabular-nums; }
.prow input[type=range] { width: 100%; accent-color: var(--acc); }

/* ===== Creatore di loghi ===== */
.mbox.logomaker { width: min(1020px, 100%); max-height: 92vh; }
.logodlg { display: grid; grid-template-columns: 290px 1fr; gap: 18px; } .lctl { display: flex; flex-direction: column; gap: 6px; } .lctl .btn { align-self: flex-start; margin-top: 6px; }
.laibox { display: flex; flex-direction: column; gap: 6px; padding: 10px; border-radius: 12px; background: var(--acc-soft); } .lctl .flab { margin-top: 6px; }
.lright { min-width: 0; display: flex; flex-direction: column; gap: 8px; } .lgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 10px; max-height: 62vh; overflow: auto; scrollbar-width: none; padding: 2px; } .lgrid::-webkit-scrollbar { display: none; }
.lcard { border-radius: 14px; overflow: hidden; border: 2px solid var(--line); background: #fff; transition: transform .12s, border-color .12s; } .lcard:hover { transform: translateY(-3px); border-color: var(--acc); } .lcard.ghost { opacity: .6; }
.lpals { display: flex; flex-wrap: wrap; gap: 6px; } .lpal { display: flex; height: 26px; border-radius: 8px; overflow: hidden; border: 2px solid var(--line); min-width: 54px; align-items: center; justify-content: center; font-size: 11px; font-weight: 700; } .lpal i { flex: 1; height: 100%; } .lpal.on { border-color: var(--acc); box-shadow: 0 0 0 2px var(--acc-soft); }
@media (max-width: 760px) { .logodlg { grid-template-columns: 1fr; } .lgrid { max-height: 44vh; } }
.gq { display: flex; flex-wrap: wrap; gap: 8px 18px; } .gq .qa { width: 108px; }
.lgrid { align-content: start; grid-auto-rows: max-content; }
.fgrid { grid-template-columns: repeat(3, minmax(0, 1fr)); }

/* ===== Controllo qualità ===== */
.qgauge { display: flex; align-items: center; gap: 12px; position: relative; } .qgauge > b { position: absolute; left: 0; width: 96px; text-align: center; font: 800 28px var(--ui); }
.qsum { display: flex; flex-direction: column; gap: 2px; margin-left: 2px; } .qsum small { color: var(--ink3); font-size: 12px; }
.qgrp { margin-top: 12px; } .qgrp h4 { font: 800 11.5px var(--ui); letter-spacing: .08em; text-transform: uppercase; color: var(--ink3); margin-bottom: 4px; }
.qrow { display: flex; gap: 8px; padding: 8px; border-radius: 10px; cursor: pointer; background: var(--surface2); margin-bottom: 5px; font-size: 12.5px; line-height: 1.35; } .qrow:hover { outline: 1px solid var(--line); }
.qic { flex: 0 0 auto; margin-top: 1px; } .qtx { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.qbt { display: flex; gap: 12px; } .qbt .link { font-size: 12.5px; }
.qalt { display: flex; gap: 6px; } .qalt .inp { flex: 1; min-width: 0; }

/* ===== Anima la presentazione ===== */
.anmgrid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
.anmc { text-align: left; display: flex; flex-direction: column; gap: 3px; padding: 8px; border-radius: 12px; border: 2px solid var(--line); background: var(--surface); } .anmc:hover { background: var(--surface2); }
.anmc.on { border-color: var(--acc); background: var(--acc-soft); } .anmc small { color: var(--ink3); font-size: 12px; line-height: 1.3; }
.anmpv { border-radius: 8px; overflow: hidden; margin-bottom: 4px; }
.mbox.anmbox { width: min(760px, 100%); }
.segs { display: inline-flex; background: var(--surface2); border-radius: 10px; padding: 3px; gap: 2px; flex-wrap: wrap; }
.segs .sg { height: 30px; padding: 0 12px; border-radius: 8px; font-weight: 700; color: var(--ink2); font-size: 13px; } .segs .sg.on { background: var(--surface); color: var(--ink); box-shadow: 0 1px 3px rgba(0, 0, 0, .15); }
.bopt { display: flex; flex-direction: column; gap: 6px; align-items: flex-start; } .bopt > span { font-weight: 700; font-size: 13px; }

/* ===== Marchio ===== */
.bnote { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-radius: 12px; background: var(--acc-soft); font-size: 13px; flex-wrap: wrap; } .bnote span { flex: 1; min-width: 180px; }
.bkit { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 14px; padding: 12px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface2); } .bkit small { display: block; color: var(--ink3); font-size: 11.5px; font-weight: 700; margin-bottom: 6px; text-transform: uppercase; letter-spacing: .06em; }
.bsw { display: flex; gap: 5px; flex-wrap: wrap; } .bsw i { width: 28px; height: 28px; border-radius: 8px; border: 1px solid rgba(0, 0, 0, .15); }
.bfonts { display: flex; flex-direction: column; gap: 2px; } .bfonts b, .bfonts span { font-size: 20px; } .bfonts small { display: inline; font: 600 12px var(--ui); text-transform: none; letter-spacing: 0; }
.blogo { max-width: 100%; max-height: 52px; object-fit: contain; } .blogo.none { color: var(--ink3); font-size: 12px; }
@media (max-width: 600px) { .bkit { grid-template-columns: 1fr; } .anmgrid { grid-template-columns: 1fr; } }

/* ===== Video ===== */
.vprog { height: 10px; background: var(--surface2); border-radius: 6px; overflow: hidden; } .vprog i { display: block; height: 100%; width: 0; background: var(--acc); border-radius: 6px; transition: width .2s; }
.vplayer { width: 100%; max-height: 52vh; border-radius: 12px; background: #000; } .vplayer[hidden] { display: none; }

/* ===== Rapporto delle prove ===== */
.rtot { display: flex; gap: 12px; } .rtot > div { flex: 1; padding: 12px; border-radius: 12px; background: var(--surface2); text-align: center; } .rtot small { display: block; color: var(--ink3); font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; } .rtot b { font: 800 26px var(--ui); font-variant-numeric: tabular-nums; }
.rtips { display: flex; flex-direction: column; gap: 6px; } .rtip { display: flex; gap: 8px; align-items: flex-start; font-size: 13.5px; line-height: 1.4; } .rtip .icw { flex: 0 0 auto; color: var(--acc-text); margin-top: 1px; }
.rlist { display: flex; flex-direction: column; gap: 6px; max-height: 34vh; overflow: auto; scrollbar-width: none; } .rlist::-webkit-scrollbar { display: none; }
.rrow { display: grid; grid-template-columns: 72px 1fr 52px; gap: 10px; align-items: center; } .rrow b { font-variant-numeric: tabular-nums; font-size: 13px; text-align: right; }
.rth { border-radius: 6px; overflow: hidden; border: 1px solid var(--line); } .rbar { height: 12px; background: var(--surface2); border-radius: 6px; overflow: hidden; } .rbar i { display: block; height: 100%; background: var(--ink3); border-radius: 6px; } .rrow.best .rbar i { background: var(--acc); }

/* ---------- Presentazione ---------- */
.present { position: fixed; inset: 0; z-index: 1500; background: #05070F; overflow: hidden; cursor: default; outline: none; }
.present.idle { cursor: none; } .present.laser { cursor: none; }
.pr-layer { position: absolute; inset: 0; }
.pr-slide { position: absolute; transform-origin: 0 0; box-shadow: 0 0 60px rgba(0, 0, 0, .5); }
.pr-slide .el { cursor: inherit; }
.pr-laser { position: absolute; left: -12px; top: -12px; width: 24px; height: 24px; border-radius: 50%; background: radial-gradient(circle, #ff3030 0 35%, rgba(255, 40, 40, .45) 36% 60%, transparent 70%); pointer-events: none; display: none; filter: drop-shadow(0 0 8px #f00); z-index: 5; }
.present.laser .pr-laser { display: block; }
.pr-bar { position: absolute; left: 50%; bottom: 22px; transform: translateX(-50%); display: flex; align-items: center; gap: 4px; background: rgba(12, 16, 32, .82); backdrop-filter: blur(8px); border-radius: 40px; padding: 6px 10px; color: #fff; z-index: 6; transition: opacity .3s; }
.present.idle .pr-bar { opacity: 0; pointer-events: none; }
.pbtn { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; color: #fff; } .pbtn:hover { background: rgba(255, 255, 255, .16); } .pbtn.on { background: var(--acc); color: var(--acc-ink); }
.pr-count { font-weight: 700; font-size: 13px; min-width: 62px; text-align: center; font-variant-numeric: tabular-nums; } .pbsep { width: 1px; height: 22px; background: rgba(255, 255, 255, .25); margin: 0 6px; }
.pr-notes { position: absolute; left: 50%; bottom: 84px; transform: translateX(-50%); width: min(820px, 92vw); max-height: 30vh; overflow: auto; background: rgba(12, 16, 32, .9); color: #fff; padding: 16px 20px; border-radius: 16px; font-size: 18px; line-height: 1.5; z-index: 6; }
.pr-notes[hidden] { display: none; }
.pr-qb { font-weight: 800; font-size: 12.5px; background: rgba(255, 255, 255, .16); border-radius: 20px; padding: 3px 10px; margin-left: 6px; white-space: nowrap; }
.pr-result { position: absolute; inset: 0; z-index: 10; background: rgba(8, 11, 24, .86); display: flex; flex-direction: column; gap: 14px; align-items: center; justify-content: center; color: #fff; text-align: center; padding: 20px; backdrop-filter: blur(6px); }
.pr-result h2 { font-size: 28px; } .pr-result .big { font: 800 96px var(--ui); color: var(--acc-text); line-height: 1; }
.pr-fx { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 4; }
.pr-ink { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 5; pointer-events: none; } .present.penning .pr-ink { pointer-events: auto; cursor: crosshair; }
.present.penning { cursor: crosshair; } .present.blurred .pr-layer { filter: blur(22px); transition: filter .3s; } .present.blacked .pr-layer { opacity: 0; } .pr-layer { transition: filter .3s, opacity .25s; }
.pr-msg { position: absolute; left: 50%; top: 9%; transform: translateX(-50%); background: rgba(12, 16, 32, .85); color: #fff; padding: 12px 22px; border-radius: 30px; font-weight: 700; z-index: 7; opacity: 0; pointer-events: none; } .pr-msg.show { animation: prmsg 1.8s both; }
@keyframes prmsg { 0% { opacity: 0; transform: translate(-50%, -10px); } 12%, 75% { opacity: 1; transform: translate(-50%, 0); } 100% { opacity: 0; } }
.pr-timer { position: absolute; right: 22px; top: 18px; background: rgba(12, 16, 32, .8); color: #fff; font: 800 28px var(--ui); padding: 8px 18px; border-radius: 14px; z-index: 7; font-variant-numeric: tabular-nums; } .pr-timer.over { background: #D92D4A; animation: prshake .5s 4; }
@keyframes prshake { 25% { transform: translateX(-6px); } 75% { transform: translateX(6px); } }
.pr-pens { position: absolute; left: 50%; bottom: 84px; transform: translateX(-50%); display: flex; gap: 8px; background: rgba(12, 16, 32, .85); padding: 8px 12px; border-radius: 30px; z-index: 7; align-items: center; }
.pr-pen { width: 30px; height: 30px; border-radius: 50%; border: 3px solid transparent; display: grid; place-items: center; color: #fff; } .pr-pen.on { border-color: #fff; } .pr-pen.clr { background: rgba(255, 255, 255, .15); }
.pr-side { position: absolute; right: 0; top: 0; width: 36%; height: 100%; background: #0E1222; color: #fff; padding: 22px; display: flex; flex-direction: column; gap: 10px; z-index: 6; overflow: auto; }
.sd-top { display: flex; justify-content: space-between; gap: 10px; } .sd-top small { display: block; color: #9AA3C4; font-size: 12px; } .sd-top b { font: 800 26px var(--ui); font-variant-numeric: tabular-nums; }
.sd-lab { font: 700 12px var(--ui); letter-spacing: .08em; text-transform: uppercase; color: #9AA3C4; margin-top: 8px; }
.sd-next { border-radius: 10px; overflow: hidden; border: 1px solid #2B3254; } .sd-next.end { padding: 30px; text-align: center; color: #9AA3C4; }
.sd-notes { font-size: 20px; line-height: 1.5; white-space: pre-wrap; }
.present.speaker .pr-timer { right: auto; left: 20px; } .present.speaker .pr-bar { left: 32%; } .present.speaker .pr-notes { display: none; }
.pr-help { position: absolute; inset: 0; background: rgba(8, 11, 24, .88); z-index: 9; display: grid; place-content: center; gap: 18px; color: #fff; padding: 20px; text-align: center; }
.pr-help h3 { font-size: 24px; } .hgrid { display: grid; grid-template-columns: repeat(2, minmax(0, 260px)); gap: 10px 30px; text-align: left; } .hr { display: flex; gap: 12px; align-items: center; } .hr kbd { min-width: 38px; text-align: center; background: #1F2540; color: #fff; border-color: #3A4268; }
@media (max-width: 700px) { .hgrid { grid-template-columns: 1fr; } .pr-side { width: 100%; } }
/* transizioni */
.tr-fade-in { animation: trfade .55s both; } .tr-fade-r-in { animation: trfade .55s both; } .tr-fade-out, .tr-fade-r-out { animation: trfadeo .55s both; }
.tr-slide-in { animation: trsin .55s cubic-bezier(.2, .8, .2, 1) both; } .tr-slide-out { animation: trsout .55s cubic-bezier(.2, .8, .2, 1) both; }
.tr-slide-r-in { animation: trsin-r .55s cubic-bezier(.2, .8, .2, 1) both; } .tr-slide-r-out { animation: trsout-r .55s cubic-bezier(.2, .8, .2, 1) both; }
.tr-zoom-in, .tr-zoom-r-in { animation: trzin .6s cubic-bezier(.2, .8, .2, 1) both; } .tr-zoom-out, .tr-zoom-r-out { animation: trfadeo .4s both; }
.tr-none-out, .tr-none-r-out { display: none; }
@keyframes trfade { from { opacity: 0; } to { opacity: 1; } } @keyframes trfadeo { from { opacity: 1; } to { opacity: 0; } }
.pr-slide.tr-slide-in { clip-path: none; }
@keyframes trzin { from { opacity: 0; filter: blur(6px); } to { opacity: 1; filter: none; } }
/* le animazioni di scorrimento usano translate (non toccano transform di scala) */
@keyframes trsin { from { translate: 100% 0; } to { translate: 0 0; } } @keyframes trsout { from { translate: 0 0; } to { translate: -100% 0; } }
@keyframes trsin-r { from { translate: -100% 0; } to { translate: 0 0; } } @keyframes trsout-r { from { translate: 0 0; } to { translate: 100% 0; } }
/* animazioni degli elementi */
@keyframes an-fade { from { opacity: 0; } to { opacity: 1; } }
@keyframes an-rise { from { opacity: 0; transform: translateY(70px); } to { opacity: 1; transform: none; } }
@keyframes an-left { from { opacity: 0; transform: translateX(-160px); } to { opacity: 1; transform: none; } }
@keyframes an-right { from { opacity: 0; transform: translateX(160px); } to { opacity: 1; transform: none; } }
@keyframes an-zoom { from { opacity: 0; transform: scale(.6); } to { opacity: 1; transform: none; } }
@keyframes an-drop { from { opacity: 0; transform: translateY(-80px); } to { opacity: 1; transform: none; } }
@keyframes an-blur { from { opacity: 0; filter: blur(26px); transform: scale(1.06); } to { opacity: 1; filter: none; transform: none; } }
@keyframes an-write { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
@keyframes an-flip { from { opacity: 0; transform: perspective(900px) rotateX(-90deg); } to { opacity: 1; transform: none; } }
@keyframes an-tada { 0% { opacity: 0; transform: scale(.8); } 30% { opacity: 1; transform: scale(1.08) rotate(-4deg); } 50% { transform: scale(1.08) rotate(4deg); } 70% { transform: scale(1.04) rotate(-2deg); } 100% { transform: none; } }
@keyframes ao-fade { to { opacity: 0; } } @keyframes ao-sink { to { opacity: 0; transform: translateY(80px); } } @keyframes ao-up { to { opacity: 0; transform: translateY(-80px); } }
@keyframes ao-left { to { opacity: 0; transform: translateX(-200px); } } @keyframes ao-right { to { opacity: 0; transform: translateX(200px); } } @keyframes ao-shrink { to { opacity: 0; transform: scale(.4); } }
@keyframes al-pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.07); } }
@keyframes al-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-22px); } }
@keyframes al-wiggle { 0%, 100% { transform: rotate(-3deg); } 50% { transform: rotate(3deg); } }
@keyframes al-spin { to { transform: rotate(360deg); } }
@keyframes al-blink { 0%, 100% { opacity: 1; } 50% { opacity: .25; } }
@keyframes an-pop { 0% { opacity: 0; transform: scale(.3); } 60% { opacity: 1; transform: scale(1.12); } 100% { transform: none; } }
@media (prefers-reduced-motion: reduce) { .pr-slide, .pr-slide * { animation-duration: .01s !important; animation-delay: 0s !important; } }

/* ===== Collaborazione ===== */
.clbsec { padding-bottom: 6px; border-bottom: 1px solid var(--line); margin-bottom: 12px; }
.rolesel { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin: 8px 0; } .rolebtn { display: flex; flex-direction: column; gap: 2px; text-align: left; padding: 9px 10px; border-radius: 12px; border: 2px solid var(--line); background: var(--surface); } .rolebtn small { color: var(--ink3); font-size: 11.5px; line-height: 1.3; } .rolebtn.on { border-color: var(--acc); background: var(--acc-soft); } .rolebtn:hover { background: var(--surface2); }
.cpeople { display: flex; flex-direction: column; gap: 6px; margin: 10px 0; } .cprow { display: flex; align-items: center; gap: 10px; padding: 6px 8px; border-radius: 12px; background: var(--surface2); } .cpn { flex: 1; min-width: 0; display: flex; flex-direction: column; } .cpn small { color: var(--ink3); font-size: 12px; }
.cav { display: inline-grid; place-items: center; border-radius: 50%; color: #fff; font-style: normal; font-weight: 800; flex: 0 0 auto; border: 2px solid var(--surface); }
.cpeers { display: inline-flex; align-items: center; margin: 0 4px; } .cpeers .cav { margin-left: -8px; } .cpeers .cav:first-child { margin-left: 0; } .cpeers b { margin-left: 4px; font-size: 12px; }
.clbchip { gap: 8px; } .clbchip .dot { width: 9px; height: 9px; border-radius: 50%; background: #3DD6A0; box-shadow: 0 0 0 0 rgba(61, 214, 160, .6); animation: micpulse 1.6s infinite; }
.clbbar { position: fixed; top: 10px; left: 50%; transform: translateX(-50%); z-index: 4000; display: flex; align-items: center; gap: 10px; padding: 8px 14px; border-radius: 14px; background: #B45309; color: #fff; box-shadow: var(--shadow2); max-width: calc(100vw - 20px); } .clbbar .btn { background: rgba(255, 255, 255, .2); color: #fff; border-color: transparent; }
.joinscr { position: fixed; inset: 0; z-index: 5000; display: grid; place-items: center; background: var(--bg); padding: 16px; }
.joinbox { width: min(440px, 100%); display: flex; flex-direction: column; gap: 12px; padding: 28px; border-radius: 22px; background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow2); text-align: center; align-items: stretch; } .joinbox .lmark { align-self: center; } .joinbox h1 { font: 800 24px/1.2 var(--ui); } .joinbox p { color: var(--ink2); line-height: 1.5; } .joinbox .hint2.err { color: var(--err); font-weight: 700; }
.collabview { display: flex; flex-direction: column; height: 100vh; background: var(--bg); color: var(--ink); }
.cvtop { display: flex; align-items: center; gap: 10px; padding: 10px 18px; background: var(--bar); color: var(--bar-ink); flex-wrap: wrap; } .cvtitle { display: flex; flex-direction: column; min-width: 0; } .cvtitle b { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } .cvtitle small { opacity: .7; } .cvtop .btn { background: var(--bar-chip); color: var(--bar-ink); border-color: transparent; height: 36px; } .cvtop .cav { border-color: var(--bar); }
.cvmain { flex: 1; overflow: auto; padding: 16px 20px 60px; scrollbar-width: none; } .cvmain::-webkit-scrollbar { display: none; } .cvhint { margin-bottom: 12px; }
.cvgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; } .cvcard { display: flex; flex-direction: column; gap: 6px; text-align: left; padding: 8px; border-radius: 14px; background: var(--surface); border: 1px solid var(--line); transition: transform .12s, border-color .12s; } .cvcard:hover { transform: translateY(-3px); border-color: var(--acc); }
.cvcard .thwrap { position: relative; border-radius: 8px; overflow: hidden; } .cvmeta { display: flex; align-items: center; gap: 8px; padding: 0 4px; } .cvcm { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 10px; background: var(--acc-soft); color: var(--acc-text); font-weight: 800; font-size: 12px; }
.cvpin { position: absolute; width: 18px; height: 18px; margin: -9px 0 0 -9px; border-radius: 50% 50% 50% 0; transform: rotate(-45deg); display: grid; place-items: center; color: #fff; font: 800 10px var(--ui); font-style: normal; box-shadow: 0 2px 6px rgba(0, 0, 0, .4); } .cvpin.big { width: 30px; height: 30px; margin: -15px 0 0 -15px; font-size: 13px; z-index: 3; } .cvpin.new { outline: 3px solid #fff; }
.mbox.cvbox { width: min(1100px, 100%); } .cvdlg { display: grid; grid-template-columns: 1.7fr 1fr; gap: 14px; } .cvstage { position: relative; border-radius: 10px; overflow: hidden; border: 1px solid var(--line); align-self: start; } .cvov { position: absolute; inset: 0; } .cvside { display: flex; flex-direction: column; gap: 8px; min-width: 0; max-height: 62vh; overflow: auto; scrollbar-width: none; } .cvside::-webkit-scrollbar { display: none; } .cvnav { display: flex; align-items: center; justify-content: space-between; }
.cmts { display: flex; flex-direction: column; gap: 8px; } .cmnew { display: flex; flex-direction: column; gap: 6px; } .cmslide { font: 800 11.5px var(--ui); letter-spacing: .08em; text-transform: uppercase; color: var(--ink3); margin-top: 6px; }
.cmt { padding: 10px 12px; border-radius: 12px; background: var(--surface2); display: flex; flex-direction: column; gap: 6px; transition: box-shadow .3s; } .cmt.flash { box-shadow: 0 0 0 3px var(--acc); } .cmt.res { opacity: .6; } .cmh { display: flex; align-items: center; gap: 8px; } .cmh small { color: var(--ink3); } .cmpin { color: var(--acc-text); display: inline-flex; margin-left: auto; }
.cmt1 { line-height: 1.45; white-space: pre-wrap; word-break: break-word; } .cmrep { display: flex; gap: 8px; padding-left: 10px; border-left: 3px solid var(--line); } .cmrep p { line-height: 1.4; } .cmrep small { color: var(--ink3); }
.cmact { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; } .cmact .inp { flex: 1 1 140px; } .cmact .link { font-size: 12.5px; } .link.danger { color: var(--err); } .cmdone summary { cursor: pointer; color: var(--ink3); font-size: 12.5px; padding: 4px 2px; }
.cpin { position: absolute; width: 34px; height: 34px; margin: -34px 0 0 -17px; border-radius: 50% 50% 50% 0; transform: rotate(-45deg) scale(var(--iz, 1)); transform-origin: 17px 34px; display: grid; place-items: center; color: #fff; font: 800 14px var(--ui); box-shadow: 0 3px 10px rgba(0, 0, 0, .45); pointer-events: auto; cursor: pointer; border: 2px solid #fff; z-index: 40; } .cpin span, .cvpin span { transform: rotate(45deg); display: block; line-height: 1; }
.rsel { position: absolute; border: 3px solid; border-radius: 4px; pointer-events: none; z-index: 38; } .rsel span { position: absolute; left: -3px; top: -26px; padding: 2px 8px; border-radius: 6px 6px 6px 0; color: #fff; font: 700 12px var(--ui); white-space: nowrap; transform-origin: left bottom; transform: scale(var(--iz, 1)); }
.cwrap.placing { cursor: crosshair; } .pdots { position: absolute; left: 4px; top: 4px; display: flex; gap: 3px; z-index: 4; } .pdots i { width: 10px; height: 10px; border-radius: 50%; border: 2px solid #fff; }
@media (max-width: 800px) { .rolesel { grid-template-columns: 1fr; } .cvdlg { grid-template-columns: 1fr; } }

/* ===== Sfondi animati, vetro, daltonismo ===== */
.livebg { position: absolute; inset: 0; overflow: hidden; pointer-events: none; z-index: 0; }
.livebg i, .livebg i::before { animation-play-state: paused; }
.present .livebg i, .lv-run .livebg i, .viewer .livebg i { animation-play-state: running; }
.lb-aurora i { position: absolute; border-radius: 50%; filter: blur(110px); opacity: .8; animation: lba1 17s ease-in-out infinite alternate; }
.lb-aurora i:nth-child(1) { left: -12%; top: -22%; width: 62%; height: 78%; background: var(--c1); }
.lb-aurora i:nth-child(2) { right: -14%; top: -10%; width: 58%; height: 74%; background: var(--c2); animation: lba2 21s ease-in-out infinite alternate; }
.lb-aurora i:nth-child(3) { left: 22%; bottom: -34%; width: 64%; height: 72%; background: var(--c3); animation: lba3 19s ease-in-out infinite alternate; }
.lb-aurora i:nth-child(4) { left: -8%; bottom: -14%; width: 40%; height: 52%; background: var(--c4); opacity: .6; animation: lba2 25s ease-in-out infinite alternate-reverse; }
@keyframes lba1 { to { transform: translate(24%, 18%) scale(1.15); } } @keyframes lba2 { to { transform: translate(-20%, 22%) scale(.9); } } @keyframes lba3 { to { transform: translate(-16%, -24%) scale(1.2); } }
.lb-onde i { position: absolute; left: -25%; width: 150%; height: 150%; border-radius: 42%; opacity: .34; animation: lbw 22s linear infinite; }
.lb-onde i:nth-child(1) { top: 58%; background: var(--c1); } .lb-onde i:nth-child(2) { top: 64%; background: var(--c2); animation-duration: 30s; animation-direction: reverse; } .lb-onde i:nth-child(3) { top: 72%; background: var(--c3); animation-duration: 38s; }
@keyframes lbw { to { transform: rotate(360deg); } }
.lb-stelle i { position: absolute; left: 0; top: 0; width: 2px; height: 2px; border-radius: 50%; background: transparent; animation: lbt 4s ease-in-out infinite alternate; } .lb-stelle i.b { animation-duration: 6.5s; animation-delay: -2s; } .lb-stelle i.c { animation-duration: 9s; animation-delay: -4s; }
@keyframes lbt { from { opacity: .35; } to { opacity: 1; } }
.lb-griglia i:nth-child(1) { position: absolute; left: 50%; top: 38%; width: 34%; aspect-ratio: 1; margin-left: -17%; border-radius: 50%; background: radial-gradient(circle, var(--c2), transparent 68%); opacity: .75; }
.lb-griglia i:nth-child(2) { position: absolute; left: -60%; width: 220%; bottom: -2%; height: 50%; transform-origin: 50% 100%; transform: perspective(520px) rotateX(64deg); background-image: linear-gradient(var(--c1) 3px, transparent 3px), linear-gradient(90deg, var(--c1) 3px, transparent 3px); background-size: 130px 130px; animation: lbg 2.4s linear infinite; opacity: .8; }
@keyframes lbg { to { background-position: 0 130px; } }
.lb-gradiente i { position: absolute; left: -50%; top: -50%; width: 200%; height: 200%; background: conic-gradient(var(--c1), var(--c2), var(--c3), var(--c4), var(--c1)); filter: blur(90px); opacity: .55; animation: lbr 36s linear infinite; }
@keyframes lbr { to { transform: rotate(360deg); } }
.sl .livebg + .el { position: absolute; }
.lvgrid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin-bottom: 8px; } .lvc { display: flex; flex-direction: column; gap: 3px; padding: 4px; border-radius: 10px; border: 1px solid var(--line); background: var(--surface); } .lvc:hover { border-color: var(--acc); } .lvc small { font-size: 11.5px; font-weight: 700; color: var(--ink2); } .lvth { border-radius: 6px; overflow: hidden; }
[data-vision="prot"] .editor .sl, [data-vision="prot"] .editor .thumb { filter: url(#vf-prot); }
[data-vision="deut"] .editor .sl, [data-vision="deut"] .editor .thumb { filter: url(#vf-deut); }
[data-vision="trit"] .editor .sl, [data-vision="trit"] .editor .thumb { filter: url(#vf-trit); }
[data-vision="achr"] .editor .sl, [data-vision="achr"] .editor .thumb { filter: url(#vf-achr); }
[data-vision="low"] .editor .sl, [data-vision="low"] .editor .thumb { filter: blur(5px) contrast(.8); }
.sbtn.on { background: var(--acc-soft); color: var(--acc-text); }

/* ===== Voce dal vivo ===== */
.pr-cc { position: absolute; left: 50%; bottom: 7%; transform: translate(-50%, 14px); width: min(86%, 1500px); text-align: center; z-index: 25; opacity: 0; transition: opacity .3s, transform .3s; pointer-events: none; }
.pr-cc.show { opacity: 1; transform: translate(-50%, 0); }
.pr-cc .cc1, .pr-cc .cc2 { display: inline-block; padding: .18em .6em; border-radius: .4em; background: rgba(8, 10, 18, .78); color: #fff; font: 700 clamp(20px, 3vw, 46px)/1.3 var(--ui); max-width: 100%; box-decoration-break: clone; }
.pr-cc .cc2 { margin-top: 8px; background: rgba(255, 210, 90, .94); color: #2A2310; font-size: clamp(22px, 3.3vw, 52px); }
.pr-cc.only .cc1 { font-size: clamp(14px, 1.9vw, 28px); font-weight: 600; opacity: .85; } .pr-cc .cc1:empty, .pr-cc .cc2[hidden] { display: none; }
.prc-cc { min-height: 28px; padding: 5px 10px; border-radius: 10px; background: var(--surface2); color: var(--ink2); font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } .prc-cc:empty { opacity: .4; } .prc-cc:empty::before { content: 'Sottotitoli: premi il microfono in alto'; } .prc-cc.fin { color: var(--ink); }
.prc-ib.rec, .pbtn.rec { background: #E5304A; color: #fff; animation: micpulse 1.1s infinite; }
.prc-notes .lw { transition: color .2s, opacity .2s; } .prc-notes .lw.done { opacity: .35; } .prc-notes .lw.now { background: var(--acc-soft); color: var(--ink); border-radius: 5px; box-shadow: 0 0 0 3px var(--acc-soft); }

/* ===== Volo e inquadrature ===== */
.pr-world { position: absolute; left: 0; top: 0; width: 0; height: 0; transform-origin: 0 0; will-change: transform; }
.fl-s { position: absolute; transform-origin: 50% 50%; box-shadow: 0 30px 90px rgba(0, 0, 0, .55); border-radius: 6px; overflow: hidden; background: #000; }
.pr-world.ov .fl-s { cursor: pointer; outline: 6px solid rgba(255, 255, 255, .0); } .pr-world.ov .fl-s:hover { outline-color: var(--acc); }
.cam-spot { position: absolute; z-index: 60; pointer-events: none; box-shadow: 0 0 0 6000px rgba(5, 7, 15, .66); border-radius: 18px; transition: left .9s, top .9s, width .9s, height .9s, opacity .5s; opacity: 0; }
.prc-camrect { position: absolute; border: 3px solid var(--acc); border-radius: 4px; background: rgba(255, 210, 90, .14); pointer-events: none; }
.flymap { display: grid; place-items: center; padding: 10px; border-radius: 14px; background: var(--surface2); min-height: 200px; overflow: hidden; }
.fmbox { position: relative; } .fmline { position: absolute; left: 0; top: 0; pointer-events: none; z-index: 2; }
.fmcard { position: absolute; border-radius: 3px; overflow: hidden; box-shadow: 0 3px 10px rgba(0, 0, 0, .35); background: #fff; } .fmcard b { position: absolute; left: 3px; top: 2px; font: 800 11px var(--ui); background: var(--acc); color: var(--acc-ink); border-radius: 5px; padding: 0 5px; z-index: 3; }
.camdlg { display: grid; grid-template-columns: 1.6fr 1fr; gap: 16px; } .camL, .camR { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
.camstage { position: relative; border-radius: 10px; overflow: hidden; border: 1px solid var(--line); } .camov { position: absolute; inset: 0; cursor: crosshair; touch-action: none; }
.camr { position: absolute; border: 3px solid var(--acc); background: rgba(255, 210, 90, .16); border-radius: 4px; pointer-events: none; } .camr b { position: absolute; left: 0; top: 0; background: var(--acc); color: var(--acc-ink); font: 800 13px var(--ui); padding: 1px 7px; border-bottom-right-radius: 6px; } .camr.new { border-style: dashed; }
.camlist { display: flex; flex-direction: column; gap: 5px; } .camrow { display: flex; align-items: center; gap: 4px; padding: 6px 8px; border-radius: 10px; background: var(--surface2); } .camrow b { flex: 1; font-size: 13px; }
@media (max-width: 800px) { .camdlg { grid-template-columns: 1fr; } }

/* ===== Console del relatore (solo sul computer) e finestra del pubblico ===== */
.prc { position: fixed; inset: 0; z-index: 1400; background: var(--bg); color: var(--ink); display: grid; grid-template-rows: auto 1fr auto; outline: none; font-family: var(--ui); }
.prc-top { display: flex; align-items: center; gap: 22px; padding: 12px 20px; background: var(--bar); color: var(--bar-ink); flex-wrap: wrap; }
.prc-title { display: flex; flex-direction: column; min-width: 0; flex: 1 1 200px; } .prc-title b { font-size: 17px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.prc-st { display: flex; align-items: center; gap: 8px; font-size: 12.5px; opacity: .85; flex-wrap: wrap; } .prc-st .warn { color: var(--err); font-weight: 700; } .prc-st small { opacity: .75; text-transform: none; letter-spacing: 0; font-size: 12px; }
.prc-st .link { color: var(--acc-text); font-size: 12.5px; }
.prc-top small { display: block; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; opacity: .7; }
.prc-top b { font-variant-numeric: tabular-nums; }
.prc-prog { display: flex; align-items: center; gap: 12px; min-width: 150px; }
.prc-pn b { font-size: 24px; font-weight: 800; white-space: nowrap; } .prc-pn small { margin-top: -2px; }
.prc-bar { flex: 1; height: 6px; border-radius: 4px; background: var(--bar-line); overflow: hidden; min-width: 60px; } .prc-bar i { display: block; height: 100%; background: var(--acc); border-radius: 4px; width: 0; transition: width .25s; }
.prc-tim, .prc-clk { display: flex; align-items: center; gap: 10px; } .prc-tim > div:not(.x) b, .prc-clk b { font-size: 24px; font-weight: 800; display: block; }
.prc-tim b.over, #prc-rem.over { color: var(--err); } #prc-rem.warn { color: #FFB020; }
.prc-ib { width: 34px; height: 34px; border-radius: 9px; display: grid; place-items: center; color: inherit; } .prc-ib:hover { background: var(--bar-hover); }
.prc-end { height: 36px; background: transparent; border-color: var(--bar-line); color: inherit; } .prc-end:hover { background: var(--bar-hover); }
.prc-main { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(280px, 1fr); gap: 18px; padding: 16px 20px; min-height: 0; }
.prc-lcol, .prc-rcol { display: flex; flex-direction: column; gap: 10px; min-height: 0; min-width: 0; }
.prc-lab { font: 700 11.5px var(--ui); letter-spacing: .09em; text-transform: uppercase; color: var(--ink3); }
.prc-cur { position: relative; width: min(100%, calc((100dvh - 330px) * var(--ar, 1.7778))); min-width: 240px; border-radius: 12px; overflow: hidden; box-shadow: var(--shadow2); border: 2px solid var(--acc); align-self: flex-start; }
.prc-dot { position: absolute; width: 18px; height: 18px; margin: -9px 0 0 -9px; border-radius: 50%; background: #FF2D2D; box-shadow: 0 0 0 5px rgba(255, 45, 45, .3), 0 0 14px 4px rgba(255, 45, 45, .6); pointer-events: none; } .prc-dot[hidden] { display: none; }
.prc-cur.lz { cursor: none; }
.prc-ctl { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; } .prc-ctl .grow { flex: 1; }
.prc-b { display: inline-flex; align-items: center; gap: 7px; height: 42px; padding: 0 14px; border-radius: 11px; background: var(--surface); border: 1px solid var(--line); font-weight: 700; color: var(--ink); }
.prc-b:hover { background: var(--surface2); } .prc-b.on { background: var(--acc); border-color: var(--acc); color: var(--acc-ink); }
.prc-b.main { background: var(--acc); border-color: var(--acc); color: var(--acc-ink); padding: 0 22px; height: 46px; font-size: 16px; }
.prc-rcol { overflow: auto; scrollbar-width: none; } .prc-rcol::-webkit-scrollbar { display: none; }
.prc-next { border-radius: 10px; overflow: hidden; border: 1px solid var(--line); box-shadow: var(--shadow); } .prc-next.end { padding: 34px 10px; text-align: center; color: var(--ink3); font-weight: 700; background: var(--surface); }
.prc-notes { flex: 1; min-height: 120px; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 14px 16px; font-size: 21px; line-height: 1.5; white-space: pre-wrap; overflow: auto; scrollbar-width: none; }
.prc-notes::-webkit-scrollbar { display: none; } .prc-notes.empty { color: var(--ink3); font-size: 16px; }
.prc-strip { display: flex; gap: 10px; padding: 10px 20px 14px; overflow-x: auto; scrollbar-width: none; background: var(--surface); border-top: 1px solid var(--line); }
.prc-strip::-webkit-scrollbar { display: none; }
.prc-t { position: relative; flex: 0 0 auto; width: 132px; border-radius: 8px; overflow: hidden; border: 2px solid transparent; opacity: .72; } .prc-t:hover { opacity: 1; } .prc-t.on { border-color: var(--acc); opacity: 1; }
.prc-t span { position: absolute; left: 4px; bottom: 4px; min-width: 20px; height: 20px; padding: 0 5px; border-radius: 6px; background: rgba(0, 0, 0, .6); color: #fff; font: 700 11.5px/20px var(--ui); text-align: center; }
@media (max-width: 900px) { .prc-main { grid-template-columns: 1fr; overflow: auto; } .prc-cur { width: 100%; } .prc-top { gap: 12px; } .prc-prog { min-width: 120px; } .prc-t { width: 96px; } .prc-notes { min-height: 90px; font-size: 18px; } }

/* finestra del pubblico: solo la presentazione */
body.aud { background: #05070F; overflow: hidden; }
.audience .aud-wait { position: fixed; inset: 0; display: grid; place-content: center; gap: 8px; text-align: center; color: #9AA3C4; font: 600 18px var(--ui); background: #05070F; } .audience .aud-wait b { font-size: 34px; color: #fff; }
.present.aud .pr-bar, .present.aud .pr-count, .present.aud .pr-notes, .present.aud .pr-side { display: none !important; }
.aud-fs { position: absolute; right: 18px; bottom: 18px; z-index: 30; display: inline-flex; align-items: center; gap: 8px; height: 44px; padding: 0 18px; border-radius: 22px; background: rgba(255, 255, 255, .92); color: #14182B; font: 700 15px var(--ui); box-shadow: 0 6px 22px rgba(0, 0, 0, .5); }
.aud-fs[hidden] { display: none; }
.present.aud.idle .aud-fs { opacity: 0; pointer-events: none; transition: opacity .3s; }

/* pulsante Presenta diviso in due */
.splitbtn { display: inline-flex; } .splitbtn > .btn:first-child { border-top-right-radius: 0; border-bottom-right-radius: 0; }
.splitbtn > .sp-dd { padding: 0 8px; border-top-left-radius: 0; border-bottom-left-radius: 0; border-left: 1px solid rgba(0, 0, 0, .22); }

/* ---------- Condivisione e modalità lettura ---------- */
.shsec { display: flex; flex-direction: column; gap: 8px; padding: 12px 0; border-top: 1px solid var(--line); } .shsec:first-child { border-top: 0; padding-top: 0; }
.shsec h3 { font-size: 14px; } .shlink { display: flex; flex-direction: column; gap: 8px; }
#app.viewer { min-height: 100vh; min-height: 100dvh; display: grid; place-items: center; padding: 24px 16px; }
.vwrap { display: flex; flex-direction: column; align-items: center; gap: 22px; width: min(560px, 100%); text-align: center; }
.vlogo { display: flex; align-items: center; gap: 10px; font: 800 24px var(--ui); letter-spacing: -.02em; }
.vcard { width: 100%; background: var(--surface); border: 1px solid var(--line); border-radius: 22px; padding: 18px; display: flex; flex-direction: column; gap: 12px; box-shadow: var(--shadow); }
.vcard h1 { font-size: 24px; font-weight: 800; letter-spacing: -.02em; text-wrap: balance; }

/* ===== Liquid glass su tutta la piattaforma, con LUCE DIREZIONALE: la luce arriva dall'alto a sinistra, quindi il bordo si illumina negli angoli in alto a sinistra e in basso a destra e si spegne verso gli altri due (variabile --rim, disegnata dal ::before). Il passaggio del mouse (hover) resta un semplice velo chiaro piatto, senza vetro. Va per ultimo e riscrive i file precedenti ===== */
body { background: var(--blobs), var(--bg); background-attachment: fixed; }
:root { --in-hi: rgba(255, 255, 255, .65); --in-lo: rgba(255, 255, 255, .3); }
:root[data-theme="dark"] { --in-hi: rgba(255, 255, 255, .13); --in-lo: rgba(255, 255, 255, .04); }

/* ---------- bordo con luce direzionale ---------- */
:where(.mbox, .pop, .toast, .mclose, .bulk, .drawbar, .side, .rail, .panel, .emain, .dcard, .hero, .panelc, .gfxhero, .gbig, .btn:not(.ghost), .chip, .seg, .qi, .topsearch, .herobox, .eb, .combo, .tpb, .sty, .acard, .fxcard, .fmt, .icol, .tp, .anmc, .fontbtn, .drop) { position: relative; }
:is(.mbox, .pop, .toast, .mclose, .bulk, .drawbar, .side, .rail, .panel, .emain, .dcard, .hero, .panelc, .gfxhero, .gbig, .btn:not(.ghost), .chip, .seg, .qi, .topsearch, .herobox, .eb, .combo, .tpb, .sty, .acard, .fxcard, .fmt, .icol, .tp, .anmc, .fontbtn, .drop)::before {
  content: ""; position: absolute; inset: 0; border-radius: inherit; padding: 1.5px; background: var(--rim); pointer-events: none; z-index: 2;
  -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor;
  mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); mask-composite: exclude;
}
.mbox::before { padding: 2px; } .side::before, .rail::before, .panel::before, .emain::before, .hero::before { padding: 2px; }

/* ---------- pulsanti e controlli di vetro (il velo del hover e' piatto) ---------- */
.btn { background: var(--glass2); border: 1px solid var(--glass-edge); }
.btn:hover { background: var(--glass2-h); }
.btn.primary { background: linear-gradient(180deg, rgba(255, 232, 150, .96), rgba(255, 201, 72, .94)); border-color: rgba(190, 135, 0, .35); color: var(--acc-ink); box-shadow: 0 6px 20px rgba(255, 190, 40, .28); }
.btn.primary:hover { background: linear-gradient(180deg, rgba(255, 238, 168, 1), rgba(255, 210, 90, .98)); filter: none; }
.btn.danger { background: linear-gradient(180deg, rgba(255, 125, 147, .96), rgba(229, 72, 77, .95)); border-color: transparent; box-shadow: 0 6px 18px rgba(229, 72, 77, .26); }
.btn.danger:hover { filter: brightness(1.07); }
.btn.dark { box-shadow: 0 6px 18px rgba(0, 0, 0, .22); }
.btn.ghost { background: transparent; border-color: transparent; }
.btn.ghost:hover { background: var(--surface2); }
.btn.dkbtn { background: var(--glass2); border-color: var(--glass-edge); } .btn.dkbtn:hover { background: var(--glass2-h); }
.seg { background: var(--glass2); border: 1px solid var(--glass-edge); }
.seg button.on { background: var(--glass2-h); box-shadow: 0 2px 8px rgba(0, 0, 0, .14); color: var(--ink); }
.chip { background: var(--glass2); border-color: var(--glass-edge); } .chip:hover { background: var(--glass2-h); }
.chip.on { background: linear-gradient(180deg, rgba(255, 232, 150, .96), rgba(255, 201, 72, .94)); color: #2A2310; border-color: rgba(190, 135, 0, .35); box-shadow: 0 6px 18px rgba(255, 190, 40, .26); }
.qi { box-shadow: 0 10px 24px rgba(0, 0, 0, .2); }
.eb, .combo, .tpb, .sty, .acard, .fxcard, .fmt, .icol, .tp, .anmc, .fontbtn, .drop, .gbig { background: var(--glass2); border: 1px solid var(--glass-edge); }
.eb, .combo, .tpb { border: 1px solid var(--glass-edge); }
.sty:hover, .acard:hover, .fxcard:hover, .fmt:hover, .icol:hover, .gbig:hover { background: var(--glass2-h); }
.inp, .cmdin { background: var(--glass2); border: 1px solid var(--glass-edge); box-shadow: inset 1px 1px 0 var(--in-hi), inset -1px -1px 0 var(--in-lo); }
.inp:focus { background: var(--glass2-h); }
kbd { background: var(--glass2); border: 1px solid var(--glass-edge); }
.topsearch { background: var(--glass2); border: 1px solid var(--glass-edge); }

/* ---------- schede a comparsa: menu, popover, avvisi ---------- */
.pop { background: var(--glass-pop); border: 1px solid var(--glass-edge); border-radius: 24px; box-shadow: var(--glass-shadow); backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur); }
.menu-pop { padding: 8px; }
.pop .mi { border-radius: 14px; height: 40px; }
.msep { background: var(--glass-line); }
.toast { background: rgba(28, 26, 18, .8); color: #FFF6D6; border: 1px solid rgba(255, 255, 255, .1); border-radius: 999px; padding: 12px 22px; box-shadow: 0 16px 40px rgba(0, 0, 0, .35); backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur); }
.toast.err { background: rgba(217, 45, 74, .85); }

/* ---------- finestre: scheda di vetro con la chiusura rotonda accanto ---------- */
.modal { background: var(--scrim); backdrop-filter: blur(22px) saturate(1.25); -webkit-backdrop-filter: blur(22px) saturate(1.25); }
.mbox { overflow: visible; background: var(--glass-modal); border: 1px solid var(--glass-edge); border-radius: 36px; box-shadow: 0 34px 90px rgba(0, 0, 0, .42); backdrop-filter: blur(40px) saturate(1.8); -webkit-backdrop-filter: blur(40px) saturate(1.8); transform: translateY(14px) scale(.97); transition: transform .32s cubic-bezier(.2, .9, .3, 1.12); }
.modal.in .mbox { transform: none; }
.mhd { padding: 32px 36px 6px; justify-content: flex-start; }
.mhd h2 { font-size: 28px; font-weight: 700; letter-spacing: -.02em; line-height: 1.15; }
.mbd { padding: 12px 36px 28px; }
.mft { padding: 18px 36px 30px; border-top: 0; }
.mtext { font-size: 16px; line-height: 1.55; color: var(--ink2); }
.mclose { position: absolute; left: calc(100% + 14px); top: 0; width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center; color: var(--ink); background: var(--glass-pop); border: 1px solid var(--glass-edge); box-shadow: 0 12px 30px rgba(0, 0, 0, .3); backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur); transition: transform .15s, background .15s; }
.mclose:hover { background: var(--glass2-h); transform: scale(1.06); } .mclose:active { transform: scale(.94); }
.modal.mc-in .mclose { left: auto; right: 16px; top: 16px; width: 42px; height: 42px; }
.modal.mc-in .mhd { padding-right: 70px; }
@media (max-width: 560px) { .mhd { padding: 26px 22px 4px; } .mhd h2 { font-size: 24px; } .mbd { padding: 10px 22px 22px; } .mft { padding: 14px 22px 24px; } .mbox { border-radius: 30px; } }

/* ---------- Home ---------- */
.side { margin: 12px 0 12px 12px; top: 12px; height: calc(100vh - 24px); height: calc(100dvh - 24px); background: var(--glass); border: 1px solid var(--glass-edge); border-radius: 32px; box-shadow: var(--glass-shadow); backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur); }
.top { background: var(--glass-bar); border-bottom: 1px solid var(--glass-line); backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur); }
.hero { border-radius: 40px; background: radial-gradient(520px 260px at 12% -20%, rgba(255, 255, 255, .7), transparent 62%), linear-gradient(135deg, #FFE68A 0%, #FFD25A 48%, #FFC21F 100%); border: 1px solid rgba(190, 135, 0, .25); box-shadow: 0 24px 60px rgba(255, 180, 20, .3); }
.herobox { background: rgba(255, 255, 255, .72); border: 1px solid rgba(190, 135, 0, .2); box-shadow: 0 10px 30px rgba(120, 80, 0, .16); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }
.dcard { padding: 10px; border-radius: 30px; background: var(--glass); border: 1px solid var(--glass-edge); box-shadow: 0 10px 30px rgba(0, 0, 0, .12); transition: transform .2s cubic-bezier(.2, .8, .2, 1), background .2s, box-shadow .2s; }
.dcard:hover { background: var(--glass2-h); transform: translateY(-3px); box-shadow: var(--glass-shadow); }
.dcard:hover .thwrap { transform: none; box-shadow: none; }
.dcard.picked { box-shadow: 0 0 0 3px var(--acc), var(--glass-shadow); }
.thwrap { border-radius: 22px; border: 1px solid var(--glass-line); }
.dmeta { padding: 0 6px 4px; }
.empty { border-radius: 32px; border: 1.5px dashed var(--glass-edge); background: var(--glass2); }
.panelc, .gfxhero { border-radius: 32px; background: var(--glass); border: 1px solid var(--glass-edge); box-shadow: 0 10px 30px rgba(0, 0, 0, .1); }
.gbig { border-radius: 24px; }
.bulk { background: var(--glass-pop); color: var(--ink); border: 1px solid var(--glass-edge); border-radius: 999px; padding: 10px 18px; box-shadow: var(--glass-shadow); backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur); }
.bulk .btn { background: var(--glass2); color: var(--ink); border-color: var(--glass-edge); } .bulk .btn:hover { background: var(--glass2-h); }
.pbar, .vprog { border-radius: 999px; }
@media (max-width: 860px) {
  .side { margin: 8px 8px 0; top: auto; height: auto; border-radius: 26px; }
  .hero { border-radius: 30px; } .dcard { border-radius: 26px; }
}

/* ---------- Editor ---------- */
.etop { background: var(--glass-bar); border-bottom: 1px solid var(--glass-line); backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur); }
.ebody { gap: 12px; padding: 0 12px 12px; }
.ebody.nopanel { column-gap: 0; } .ebody.nopanel .rail { margin-right: 12px; }
.rail, .panel, .emain { border: 1px solid var(--glass-edge); border-radius: 32px; background: var(--glass); box-shadow: var(--glass-shadow); backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur); }
.nopanel .panel { border: 0; box-shadow: none; } .nopanel .panel::before { display: none; }
.rail { padding: 10px 6px; gap: 4px; }
.phd { padding: 14px 12px 4px 20px; } .phd h2 { font-size: 17px; }
.pbd { padding: 8px 16px 22px; }
.emain { overflow: hidden; background: var(--canvas-glass); }
.ctx { background: var(--glass); border-bottom: 1px solid var(--glass-line); padding: 6px 12px; min-height: 48px; backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur); }
.tbsep { background: var(--glass-line); }
.tbg, .fontb { background: var(--glass2); border-color: var(--glass-edge); }
.notes, .strip, .estat { background: var(--glass); border-top: 1px solid var(--glass-line); backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur); }
.sbar { background: var(--glass); border-top: 1px solid var(--glass-line); color: var(--ink); backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur); }
.cwrap { background: transparent; }
.drawbar { border-radius: 999px; background: var(--glass-pop); border-color: var(--glass-edge); box-shadow: var(--glass-shadow); backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur); }
.gridview { background: var(--canvas); }
.stage { box-shadow: 0 18px 60px rgba(0, 0, 0, .32), 0 2px 10px rgba(0, 0, 0, .15); }
.aimsg { border-radius: 16px; }

/* chi preferisce meno movimento */
@media (prefers-reduced-motion: reduce) { .mbox { transition: none; transform: none; } }

</style>
<div id="app"></div>
<script>
'use strict';
(function () { let m = 'dark'; try { m = localStorage.getItem('palco.theme') || 'dark'; } catch (e) { } document.documentElement.setAttribute('data-theme', m === 'light' ? 'light' : 'dark'); })();
/* ============ Palco: utilità di base ============ */
const $ = (s, r = document) => r.querySelector(s);
const $$ = (s, r = document) => Array.from(r.querySelectorAll(s));
const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
const uid = (p = '') => p + Math.random().toString(36).slice(2, 8) + Date.now().toString(36).slice(-3);
const clone = o => JSON.parse(JSON.stringify(o));
const esc = s => String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const round = (v, n = 2) => { const k = Math.pow(10, n); return Math.round(v * k) / k; };
const sleep = ms => new Promise(r => setTimeout(r, ms));
const debounce = (fn, ms) => {
  let t, last;
  const d = (...a) => { last = a; clearTimeout(t); t = setTimeout(() => { t = null; fn(...last); }, ms); };
  d.flush = () => { if (t) { clearTimeout(t); t = null; fn(...last); } };
  d.cancel = () => { clearTimeout(t); t = null; };
  return d;
};
const SVGNS = 'http://www.w3.org/2000/svg';
const SVG_TAGS = new Set(['svg', 'path', 'circle', 'rect', 'g', 'line', 'defs', 'linearGradient', 'radialGradient', 'stop', 'polygon', 'polyline', 'text', 'ellipse']);

/* Crea elementi DOM: h('div.card#id', {class, style, onclick, ...}, figli...) */
function h(sel, attrs, ...kids) {
  if (attrs != null && (typeof attrs !== 'object' || attrs.nodeType || Array.isArray(attrs))) { kids.unshift(attrs); attrs = null; }
  const parts = [];
  let tag = (sel.match(/^[a-zA-Z0-9]+/) || ['div'])[0], id = null, mm;
  const rx = /([.#])([\w-]+)/g;
  while ((mm = rx.exec(sel))) { if (mm[1] === '#') id = mm[2]; else parts.push(mm[2]); }
  const el = SVG_TAGS.has(tag) ? document.createElementNS(SVGNS, tag) : document.createElement(tag);
  if (id) el.id = id;
  if (parts.length) el.setAttribute('class', parts.join(' '));
  if (attrs) {
    for (const k in attrs) {
      const v = attrs[k];
      if (v == null || v === false) continue;
      if (k === 'class') el.setAttribute('class', ((el.getAttribute('class') || '') + ' ' + v).trim());
      else if (k === 'style') {
        if (typeof v === 'string') el.style.cssText = v;
        else for (const s in v) { if (s.startsWith('--')) el.style.setProperty(s, v[s]); else el.style[s] = v[s]; }
      }
      else if (k === 'html') el.innerHTML = v;
      else if (k === 'text') el.textContent = v;
      else if (k === 'data') for (const d in v) el.dataset[d] = v[d];
      else if (k.startsWith('on') && typeof v === 'function') el.addEventListener(k.slice(2), v);
      else if (k === 'value' || k === 'checked' || k === 'disabled' || k === 'selected') el[k] = v;
      else el.setAttribute(k, v === true ? '' : v);
    }
  }
  const add = k => {
    if (k == null || k === false) return;
    if (Array.isArray(k)) k.forEach(add);
    else if (k.nodeType) el.appendChild(k);
    else el.appendChild(document.createTextNode(String(k)));
  };
  kids.forEach(add);
  return el;
}

