    h('div.row', { style: { alignItems: 'center' } }, h('label.chk', h('input', { type: 'checkbox', checked: F.tilt, onchange: e => { F.tilt = e.target.checked; draw(); } }), 'Pagine inclinate'), h('span.grow'), seg([['l', 'Lento'], ['', 'Normale'], ['f', 'Veloce']], () => F.speed, v => { F.speed = v; }))), {
    cls: 'logomaker', foot: [h('span.grow'), h('button.btn', { onclick: () => m.close() }, 'Annulla'), h('button.btn.primary', { onclick: () => { D.fly = { ...F }; ED.commit(); m.close(); toast(F.on ? 'Volo attivo: premi F5 per vederlo' : 'Volo disattivato', { icon: 'sparkles', ms: 2600 }); } }, icn('check', 16), 'Applica')]
