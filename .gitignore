  { k: 'poster', n: 'Locandina A4', w: 1240, h: 1754, ic: 'file', col: '#12B886', d: 'Foglio da stampare' },
  { k: 'card', n: 'Biglietto da visita', w: 1050, h: 600, ic: 'tag', col: '#0EA5E9', d: 'Fronte e retro' },
  { k: 'cover', n: 'Copertina video', w: 1280, h: 720, ic: 'play', col: '#FF3B3B', d: 'Miniatura 16:9' },
  { k: 'banner', n: 'Banner', w: 1640, h: 624, ic: 'layout', col: '#1E6BFF', d: 'Intestazione per i social' },
  { k: 'invite', n: 'Invito', w: 1080, h: 1350, ic: 'smile', col: '#EC4899', d: 'Verticale 4:5' }
];
GR.byK = k => GR.FORMATS.find(f => f.k === k) || GR.FORMATS[1];
GR.PALS = [
  { bg: '#FFF3C6', fg: '#2A2310', ac: '#FFC21A', ac2: '#1E6BFF', soft: '#FFE48E' },
  { bg: '#0F1B3D', fg: '#FFFFFF', ac: '#FFD25A', ac2: '#5B8CFF', soft: '#1C2C5E' },
  { bg: '#FFFFFF', fg: '#14182B', ac: '#E040A0', ac2: '#14182B', soft: '#F3E8F0' },
  { bg: '#E8F5EC', fg: '#143D2B', ac: '#12B886', ac2: '#F2A541', soft: '#CBEBD6' },
  { bg: '#14111F', fg: '#F5F0FF', ac: '#C6FF3D', ac2: '#8B5CF6', soft: '#251F3A' },
  { bg: '#F6EDE4', fg: '#3B2A20', ac: '#BC6C25', ac2: '#606C38', soft: '#EAD9C7' },
  { bg: '#FFE5EC', fg: '#3A0F25', ac: '#FF3D8B', ac2: '#7B2CBF', soft: '#FFC8D8' },
  { bg: '#E3F2FD', fg: '#0B2A5B', ac: '#1E6BFF', ac2: '#FF8A3D', soft: '#BBDEFB' }
];
GR.FONTS = [['Poppins', 'Plus Jakarta Sans'], ['Playfair Display', 'Work Sans'], ['Bebas Neue', 'Rubik'], ['DM Serif Display', 'Manrope'], ['Space Grotesk', 'Inter'], ['Fraunces', 'Nunito'], ['Anton', 'Work Sans'], ['Sora', 'Outfit']];
GR.COPY = {
  post: { title: 'Una grande novità sta arrivando', sub: 'Scrivi qui il tuo messaggio in poche parole.', tag: 'NOVITÀ', cta: 'Scopri di più', big: '-30%' },
  story: { title: 'Solo per oggi', sub: 'Scorri verso l’alto per scoprire tutto.', tag: 'OFFERTA', cta: 'Scorri su', big: '-30%' },
  poster: { title: 'Il tuo evento', sub: 'Sabato 12 ottobre · ore 18:00\nPiazza Centrale', tag: 'INGRESSO LIBERO', cta: 'www.tuosito.it', big: 'LIVE' },
  cover: { title: 'Il titolo del tuo video', sub: 'Episodio 1', tag: 'NUOVO', cta: '', big: 'TOP' },
  banner: { title: 'Benvenuti', sub: 'La frase che ti presenta in una riga', tag: '', cta: 'Contattaci', big: '' },
  invite: { title: 'Sei invitato!', sub: 'Sabato 20 dicembre · ore 19:00\nVia Roma 12', tag: 'FESTA', cta: 'Conferma entro il 10/12', big: '' },
  logo: { title: 'Nome', sub: '', tag: '', cta: '' }
};
GR.VARS = [
  { a: 'big', pal: 0, font: 0 }, { a: 'band', pal: 1, font: 6 }, { a: 'split', pal: 3, font: 4 }, { a: 'frame', pal: 5, font: 1 },
  { a: 'card', pal: 6, font: 7 }, { a: 'promo', pal: 2, font: 2 }, { a: 'minimal', pal: 7, font: 3 }, { a: 'rings', pal: 4, font: 5 }
];
const MAXI = Math.max;

/* ---- mattoncini ---- */
GR.T = (text, x, y, w, s, o = {}) => {
  const e = M.text({ text, x: Math.round(x), y: Math.round(y), w: Math.round(w), s: Math.round(s), f: o.f, c: o.c, a: o.a || 'left', wt: o.wt || 700, lh: o.lh || 1.12, ls: o.ls || 0, up: !!o.up });
  R.fitHeight(e); return e;
};
GR.S = (k, x, y, w, h, fill, o = {}) => M.shape(k, { x: Math.round(x), y: Math.round(y), w: Math.round(w), h: Math.round(h), f: fill, ...o });
GR.pill = (text, x, y, s, bg, fg, font) => {
  const t = GR.T(text, 0, 0, 2000, s, { f: font, c: fg, wt: 700, ls: .08, up: true }); const tw = Math.ceil(text.length * s * .66) + s * 1.6;
  t.w = Math.round(tw); t.x = Math.round(x); R.fitHeight(t);
  const h = Math.round(t.h + s * .7), r = GR.S('pill', x, y, tw, h, bg); t.y = Math.round(y + (h - t.h) / 2); t.a = 'center';
  return [r, t, tw, h];
};
GR.stack = (items, y, gap) => { items.forEach(e => { e.y = Math.round(y); y += e.h + gap; }); return y; };
GR.slide = (bg, els) => ({ id: uid('s_'), bg, els, notes: '', tr: 'none' });
GR.imgFrame = (x, y, w, h, mk) => M.image(null, { fr: 1, mk: mk || 'round', x: Math.round(x), y: Math.round(y), w: Math.round(w), h: Math.round(h) });

/* ---- composizioni ---- */
GR.layout = (a, F, pal, fonts, cp) => {
  const W = F.w, H = F.h, m = Math.round(Math.min(W, H) * .08), port = H > W * 1.15, wide = W > H * 1.5;
  const ts = Math.round(port ? W * .13 : wide ? H * .17 : Math.min(W, H) * .12), ss = Math.round(ts * .3), tag = cp.tag, cta = cp.cta;
  const hf = fonts[0], bf = fonts[1], fg = pal.fg, ac = pal.ac, on = Col.readable(ac);
  const els = []; let bg = pal.bg;
  const title = (x, y, w, c, al) => GR.T(cp.title, x, y, w, ts, { f: hf, c: c || fg, a: al || 'left', wt: hf === 'Bebas Neue' || hf === 'Anton' ? 400 : 800, lh: 1.02, up: hf === 'Bebas Neue' || hf === 'Anton' });
  const sub = (x, y, w, c, al) => GR.T(cp.sub, x, y, w, ss, { f: bf, c: c || fg, a: al || 'left', wt: 400, lh: 1.35 });
  if (a === 'big') {
    const d = Math.min(W, H) * (port ? .95 : .85);
    els.push(GR.S('ellipse', W - d * .62, -d * .3, d, d, ac), GR.S('ellipse', -d * .25, H - d * .32, d * .5, d * .5, pal.ac2));
    let y = port ? H * .26 : wide ? m * 1.3 : H * .24;
    if (tag) { const [r, t, , ph] = GR.pill(tag, m, y, Math.round(ss * .62), pal.fg, pal.bg, bf); els.push(r, t); y += ph + m * .6; }
    const T = title(m, y, W - 2 * m, fg), S = sub(m, 0, W * (wide ? .55 : .75), fg); T.w = Math.round(W - 2 * m - (wide ? W * .25 : 0)); R.fitHeight(T);
    const yy = GR.stack([T, S], y, m * .4); els.push(T, S);
    if (cta) { const [r, t, , ph] = GR.pill(cta, m, H - m - ss * 1.9, Math.round(ss * .7), ac, on, bf); els.push(r, t); }
  } else if (a === 'band') {
    els.push(GR.S('rect', -W * .1, H * (port ? .56 : .52), W * 1.2, H * (port ? .22 : .3), ac, { r: -6 }), GR.S('rect', -W * .1, H * (port ? .66 : .66), W * 1.2, H * .04, pal.ac2, { r: -6 }));
    const T = title(m, m * 1.2, W - 2 * m, fg), S = sub(m, 0, W - 2 * m, fg); GR.stack([T, S], m * 1.2, m * .3); els.push(T, S);
    if (tag) { const sd = Math.round(Math.min(W, H) * .26); els.push(GR.S('seal', W - sd - m * .6, H - sd - m * .6, sd, sd, pal.ac2)); const tt = GR.T(tag, W - sd - m * .6 + sd * .1, H - sd - m * .6 + sd * .5 - ss * .5, sd * .8, Math.round(ss * .62), { f: bf, c: Col.readable(pal.ac2), a: 'center', wt: 700, up: true, lh: 1.1 }); tt.y = Math.round(H - sd - m * .6 + (sd - tt.h) / 2); els.push(tt); }
  } else if (a === 'split') {
    if (port || !wide && W <= H * 1.2) {
      els.push(GR.S('rect', 0, 0, W, H * .5, pal.soft), GR.imgFrame(m, m, W - 2 * m, H * .5 - m * 1.5, 'round'));
      const T = title(m, 0, W - 2 * m, fg), S = sub(m, 0, W - 2 * m, fg); GR.stack([T, S], H * .5 + m * .2, m * .3); els.push(T, S);
      if (cta) { const [r, t] = GR.pill(cta, m, H - m - ss * 1.6, Math.round(ss * .7), ac, on, bf); els.push(r, t); }
    } else {
      els.push(GR.S('rect', 0, 0, W * .46, H, pal.soft), GR.imgFrame(m * .7, m * .7, W * .46 - m * 1.4, H - m * 1.4, 'round'));
      const x0 = W * .46 + m, T = title(x0, 0, W - x0 - m, fg), S = sub(x0, 0, W - x0 - m, fg); const hh = T.h + S.h + m * .3; GR.stack([T, S], (H - hh) / 2, m * .3); els.push(T, S);
      if (cta) { const [r, t] = GR.pill(cta, x0, H - m * 1.8, Math.round(ss * .7), ac, on, bf); els.push(r, t); }
    }
  } else if (a === 'frame') {
    const mm = Math.round(m * .55), t = GR.S('frame', mm, mm, W - 2 * mm, H - 2 * mm, ac, { rad: 1.6 }); els.push(t, GR.S('frame', mm * 1.9, mm * 1.9, W - 3.8 * mm, H - 3.8 * mm, ac, { rad: .5 }));
    const T = title(m * 1.5, 0, W - 3 * m, fg, 'center'); T.wt = 700; const S = sub(m * 1.5, 0, W - 3 * m, fg, 'center');
    const hh = T.h + S.h + m * .8 + 12 + (tag ? ss : 0), y0 = (H - hh) / 2; let y = y0;
    if (tag) { const tg = GR.T(tag, m * 1.5, y, W - 3 * m, Math.round(ss * .6), { f: bf, c: ac, a: 'center', wt: 700, up: true, ls: .3 }); els.push(tg); y += tg.h + m * .3; }
    GR.stack([T], y, 0); els.push(T); y += T.h + m * .3;
    els.push(GR.S('rect', W / 2 - m * .8, y, m * 1.6, 5, ac)); y += m * .4; S.y = Math.round(y); els.push(S);
    if (cta) els.push(GR.T(cta, m * 1.5, H - m * 1.9 - ss * .4, W - 3 * m, Math.round(ss * .62), { f: bf, c: fg, a: 'center', wt: 600, up: true, ls: .2 }));
  } else if (a === 'card') {
    bg = { img: `g:memphis:${(pal.ac.charCodeAt(2) + pal.bg.charCodeAt(2)) % ART_PALS.length}`, dim: 0 };
    const cw = Math.round(W * (wide ? .62 : .82)), ch = Math.round(H * (wide ? .72 : port ? .56 : .66)), cx = (W - cw) / 2, cy = (H - ch) / 2;
    els.push(GR.S('round', cx, cy, cw, ch, pal.bg, { rad: Math.round(Math.min(W, H) * .05) }));
    const T = title(cx + m * .6, 0, cw - m * 1.2, fg, 'center'); T.s = Math.round(ts * .78); R.fitHeight(T); const S = sub(cx + m * .6, 0, cw - m * 1.2, fg, 'center'); S.s = Math.round(ss * .9); R.fitHeight(S);
    const pb = cta ? GR.pill(cta, 0, 0, Math.round(ss * .6), ac, on, bf) : null; const hh = T.h + S.h + m * .4 + (pb ? pb[3] + m * .4 : 0);
    let y = cy + (ch - hh) / 2; T.y = Math.round(y); y += T.h + m * .2; S.y = Math.round(y); y += S.h + m * .4; els.push(T, S);
    if (pb) { pb[0].x = Math.round((W - pb[2]) / 2); pb[0].y = Math.round(y); pb[1].x = pb[0].x; pb[1].y = Math.round(y + (pb[3] - pb[1].h) / 2); els.push(pb[0], pb[1]); }
  } else if (a === 'promo') {
    bg = ac;
    const d = Math.round(Math.min(W, H) * (wide ? .82 : .66)), big = cp.big || '-30%';
    const sx = wide ? W * .08 : (W - d) / 2, sy = wide ? (H - d) / 2 : H * .1;
    els.push(GR.S('seal', sx, sy, d, d, pal.bg));
    const bt = GR.T(big, sx, 0, d, Math.round(d * (big.length > 4 ? .24 : .34)), { f: hf, c: ac === '#FFFFFF' ? fg : fg, a: 'center', wt: 800, lh: 1, up: false }); bt.y = Math.round(sy + (d - bt.h) / 2); els.push(bt);
    const tx = wide ? sx + d + m : m, tw = wide ? W - tx - m : W - 2 * m, T = title(tx, 0, tw, on, wide ? 'left' : 'center'); T.s = Math.round(ts * .75); R.fitHeight(T);
    const S = sub(tx, 0, tw, on, wide ? 'left' : 'center'); const y0 = wide ? (H - T.h - S.h) / 2 : sy + d + m * .6; GR.stack([T, S], y0, m * .3); els.push(T, S);
    if (tag) { const tg = GR.T(tag, m, m * .6, W - 2 * m, Math.round(ss * .7), { f: bf, c: on, a: wide ? 'left' : 'center', wt: 700, up: true, ls: .25 }); els.push(tg); }
  } else if (a === 'minimal') {
    els.push(GR.S('rect', m, m, m * .8, m * .8, ac));
    if (tag) els.push(GR.T(tag, m * 2.2, m + m * .1, W * .6, Math.round(ss * .6), { f: bf, c: fg, wt: 700, up: true, ls: .25 }));
    const T = title(m, 0, W - 2 * m - (wide ? W * .2 : 0), fg); const S = sub(m, 0, W * (wide ? .5 : .7), fg);
    const hh = T.h + S.h + m * .5 + 6, y0 = H - m * 1.2 - hh; els.push(GR.S('rect', m, y0 - m * .4, W - 2 * m, 4, fg, { o: .25 })); GR.stack([T, S], y0, m * .3); els.push(T, S);
    if (cta) els.push(GR.T(cta, m, H - m - ss * .6, W - 2 * m, Math.round(ss * .6), { f: bf, c: ac, wt: 700, ls: .05, a: 'right' }));
  } else { // rings
    bg = { img: `g:rings:${GR.PALS.indexOf(pal) % ART_PALS.length}`, dim: .12 };
    const tc = '#FFFFFF', T = title(m, 0, W - 2 * m, tc, 'center'), S = sub(m, 0, W - 2 * m, tc, 'center'); const hh = T.h + S.h + m * .5, y0 = (H - hh) / 2;
    if (tag) { const tg = GR.T(tag, m, y0 - ss * 1.5, W - 2 * m, Math.round(ss * .6), { f: bf, c: pal.ac, a: 'center', wt: 700, up: true, ls: .3 }); els.push(tg); }
    GR.stack([T, S], y0, m * .35); els.push(T, S);
    if (cta) { const [r, t, tw] = GR.pill(cta, 0, 0, Math.round(ss * .65), ac, on, bf); r.x = Math.round((W - tw) / 2); r.y = Math.round(H - m * 1.6 - r.h); t.x = r.x; t.y = Math.round(r.y + (r.h - t.h) / 2); els.push(r, t); }
  }
  els.forEach(e => { if (e.t === 'text' && e.o == null) delete e.o; });
  return GR.slide(bg, els);
};

/* biglietto da visita: fronte e retro */
GR.cardSlides = (v, F, pal, fonts) => {
  const W = F.w, H = F.h, m = 70, hf = fonts[0], bf = fonts[1], on = Col.readable(pal.ac), el = [], bk = [];
  const info = [['icon:mail', 'nome@email.it'], ['icon:phone', '+39 333 123 4567'], ['icon:globe', 'www.tuosito.it'], ['icon:pin', 'Via Roma 1, Milano']];
  const lines = (x, y, c) => info.forEach(([ic, tx], i) => { bk.push(GR.S(ic, x, y + i * 70 + 4, 36, 36, c)); bk.push(GR.T(tx, x + 58, y + i * 70, 520, 32, { f: bf, c, wt: 500 })); });
  let fbg = pal.bg, bbg = pal.bg;
  if (v % 4 === 0) {
    fbg = pal.ac; bbg = pal.bg;
    el.push(GR.S('ellipse', m, H / 2 - 110, 220, 220, pal.bg), GR.T('N', m, H / 2 - 110 + 30, 220, 150, { f: hf, c: pal.ac, a: 'center', wt: 800, lh: 1 }));
    const n = GR.T('Nome Cognome', 360, H / 2 - 90, W - 420, 76, { f: hf, c: on, wt: 800 }), r = GR.T('Professione o ruolo', 360, 0, W - 420, 36, { f: bf, c: on, wt: 500 }); GR.stack([n, r], H / 2 - 70, 14); el.push(n, r);
    lines(100, 120, pal.fg); bk.push(GR.T('Nome Cognome', 100, H - 160, 700, 44, { f: hf, c: pal.ac, wt: 800 }));
  } else if (v % 4 === 1) {
    el.push(GR.S('rect', 0, 0, W * .2, H, pal.ac));
    const n = GR.T('Nome Cognome', W * .2 + m, 0, W * .8 - 2 * m, 84, { f: hf, c: pal.fg, wt: 800 }), r = GR.T('PROFESSIONE O RUOLO', W * .2 + m, 0, W * .8 - 2 * m, 30, { f: bf, c: pal.ac, wt: 700, ls: .22 });
    GR.stack([n, r], H / 2 - 80, 18); el.push(n, r, GR.S('rect', W * .2 + m, H / 2 + 60, 90, 6, pal.fg));
    bbg = pal.ac; bk.push(GR.T('Nome Cognome', 0, H / 2 - 110, W, 96, { f: hf, c: on, a: 'center', wt: 800 }), GR.T('www.tuosito.it', 0, H / 2 + 20, W, 36, { f: bf, c: on, a: 'center', wt: 500 }));
  } else if (v % 4 === 2) {
    fbg = pal.fg === '#FFFFFF' ? pal.bg : pal.fg; bbg = pal.bg;
    const fgc = Col.readable(fbg);
    el.push(GR.S('frame', 34, 34, W - 68, H - 68, pal.ac, { rad: .8 }));
    const n = GR.T('Nome Cognome', m, 0, W - 2 * m, 90, { f: hf, c: fgc, a: 'center', wt: 700 }), r = GR.T('PROFESSIONE O RUOLO', m, 0, W - 2 * m, 28, { f: bf, c: pal.ac, a: 'center', wt: 600, ls: .3 }); GR.stack([n, r], H / 2 - 70, 20); el.push(n, r);
    lines(100, 120, pal.fg === '#FFFFFF' ? pal.fg : pal.fg);
  } else {
    fbg = pal.soft; bbg = pal.ac;
    el.push(GR.S('para', W * .52, -10, W * .5, H + 20, pal.ac, { r: 0 }));
    el.push(GR.T('Nome Cognome', m, H / 2 - 100, W * .5 - m, 72, { f: hf, c: pal.fg, wt: 800, lh: 1.05 }), GR.T('Professione o ruolo', m, H / 2 + 50, W * .5 - m, 32, { f: bf, c: pal.fg, wt: 500 }));
    bk.push(GR.T('Nome Cognome', 100, 90, W - 200, 60, { f: hf, c: on, wt: 800 }));
    info.forEach(([ic, tx], i) => { bk.push(GR.S(ic, 100, 230 + i * 70 + 4, 36, 36, on), GR.T(tx, 158, 230 + i * 70, 560, 32, { f: bf, c: on, wt: 500 })); });
  }
  return [GR.slide(fbg, el), GR.slide(bbg, bk)];
};

/* ---- creazione ---- */
GR.fontsFor = (v) => { const f = GR.FONTS[v.font]; return [[f[0], 800], [f[0], 700], [f[0], 400], [f[1], 400], [f[1], 500], [f[1], 700], [f[1], 600]]; };
GR.build = async (fmtK, vi, o = {}) => {
  const F0 = GR.byK(fmtK), F = { ...F0, w: o.w || F0.w, h: o.h || F0.h }, v = GR.VARS[((vi % GR.VARS.length) + GR.VARS.length) % GR.VARS.length], pal = GR.PALS[o.pal != null ? o.pal : v.pal], fonts = GR.FONTS[v.font];
  await loadFonts(GR.fontsFor(v));
  const cp = GR.COPY[fmtK] || GR.COPY.post;
  const slides = fmtK === 'card' ? GR.cardSlides(vi, F, pal, fonts) : [GR.layout(v.a, F, pal, fonts, cp)];
  const d = M.newDeck({ name: F.n, w: F.w, h: F.h, theme: 'minimale', slides });
  d.kind = 'design'; d.fmt = fmtK; d.pn = { on: false, pos: 'br', fmt: 'n', s: 28, skip: 0 };
  return d;
};
GR.create = async (fmtK, vi) => { const d = await GR.build(fmtK, vi); d.name = GR.byK(fmtK).n + ' · ' + new Date().toLocaleDateString('it-IT', { day: 'numeric', month: 'short' }); return App.create(d); };
GR.blank = (fmtK, w, h) => { const F = GR.byK(fmtK), d = M.newDeck({ name: F.n, w: w || F.w, h: h || F.h, theme: 'minimale', slides: [M.newSlide(fmtK === 'logo' ? '#FFFFFF' : '#FFFFFF')] }); d.kind = 'design'; d.fmt = fmtK; return App.create(d); };
GR.isDesign = (d) => !!(d && d.kind === 'design');

/* ---- Home: sezione Grafica ---- */
App.gfx = { fmt: 'post' };
App.fmtTile = (f) => h('button.qa', { onclick: () => f.k === 'logo' ? LOGO.dialog() : GR.blank(f.k) }, h('span.qi', { style: { background: f.col, color: f.col === '#FFD25A' ? '#2A2310' : '' } }, icn(f.ic, 26)), h('span', f.n));
App.gfxCard = (fmtK, vi) => {
  const F = GR.byK(fmtK), slot = h('div.thwrap.loading', { style: { aspectRatio: `${F.w}/${F.h}` } });
  GR.build(fmtK, vi).then(d => { slot.classList.remove('loading'); slot.appendChild(R.thumb(d.slides[0], d)); }).catch(() => { });
  return h('div.dcard.tcard.gcard', { tabindex: 0, role: 'button', 'aria-label': 'Modello ' + F.n, onclick: () => GR.create(fmtK, vi), onkeydown: e => { if (e.key === 'Enter') GR.create(fmtK, vi); } },
    slot, h('div.dmeta', h('div.dt', h('b', F.n), h('span.ds', GR.VARS[vi % GR.VARS.length].a === 'big' ? 'Titolone' : ({ band: 'Banda', split: 'Foto e testo', frame: 'Elegante', card: 'Scheda', promo: 'Offerta', minimal: 'Minimale', rings: 'Cerchi' })[GR.VARS[vi % GR.VARS.length].a]))));
};
App.vGraphics = () => {
  const designs = ST.list().filter(GR.isDesign), fmts = GR.FORMATS.filter(f => f.k !== 'logo');
  const cur = App.gfx.fmt;
  const hero = h('section.gfxhero',
    h('div.gcol', h('span.gtag', icn('sparkles', 16), 'Grafica'), h('h1', 'Crea loghi, post e locandine'), h('p', 'Parti da un modello, da un logo creato per te o dalla tua foto. Tutto si modifica con gli stessi strumenti delle presentazioni.')),
    h('div.gcards',
      h('button.gbig.logo', { onclick: () => LOGO.dialog() }, icn('star', 28), h('b', 'Creatore di loghi'), h('small', AI.textOk() ? 'Scrivi il nome: l’IA propone stile, colori e simbolo' : 'Nome, settore e stile: ottieni decine di proposte')),
      h('button.gbig.photo', { onclick: () => UI.pickFile('image/*', true, fs => GR.openImages(fs)) }, icn('image', 28), h('b', 'Modifica una foto'), h('small', 'Filtri, ritaglio, sfondo, testi e adesivi')),
      h('button.gbig.up', { onclick: () => App.pickImport() }, icn('upload', 28), h('b', 'Carica un file'), h('small', 'Immagine, PDF o PowerPoint: lo apro nel posto giusto'))));
  return h('div.page', hero,
    h('section', h('div.sechd', h('h2', 'Crea un nuovo progetto')), h('div.qas.gq', GR.FORMATS.map(App.fmtTile))),
    designs.length ? h('section', h('div.sechd', h('h2', 'I tuoi progetti grafici')), h('div.grid', designs.slice(0, 8).map(d => App.deckCard(d)))) : null,
    h('section', h('div.sechd', h('h2', 'Modelli')), h('div.chips', fmts.map(f => h('button.chip' + (cur === f.k ? '.on' : ''), { onclick: () => { App.gfx.fmt = f.k; App.render(); } }, f.n))),
      h('div.grid.ggrid', GR.VARS.map((_, i) => App.gfxCard(cur === 'logo' ? 'post' : cur, i)))));
};
App.nav.splice(3, 0, ['graphics', 'Grafica', 'shapes']);
const deckCard0 = App.deckCard;
App.deckCard = (d, o) => {
  const c = deckCard0(d, o);
  if (GR.isDesign(d)) { const F = GR.byK(d.fmt), ds = c.querySelector('.ds'); if (ds) ds.textContent = `${d.fmt === 'photo' ? 'Foto' : F.n} · ${fmtDate(d.updated)}`; const w = c.querySelector('.thwrap'); if (w) w.appendChild(h('span.kbadge', 'Grafica')); }
  return c;
};

/* ============ Grafica nell'editor: pannelli, esportazioni, ritocco foto ============ */
ED.RAIL_PRES = ED.RAIL;
GR.RAIL = [['gdesign', 'Modelli', 'layout'], ['photo', 'Ritocco', 'sliders'], ['elements', 'Elementi', 'shapes'], ['gmat', 'Materiali', 'star'], ['text', 'Testo', 'type'], ['images', 'Immagini', 'image'], ['bg', 'Sfondo', 'palette'], ['ai', 'IA', 'sparkles'], ['layers', 'Livelli', 'layers'], ['check', 'Controllo', 'check']];
const edOpen0 = ED.open;
ED.open = (deck) => {
  const d = GR.isDesign(deck);
  ED.RAIL = d ? (deck.fmt === 'photo' ? GR.RAIL.filter(r => r[0] !== 'gdesign') : GR.RAIL) : ED.RAIL_PRES;
  ED.panel = d ? (deck.fmt === 'photo' ? 'photo' : deck.fmt === 'logo' ? 'gmat' : 'gdesign') : 'design';
  return edOpen0(deck);
};
const edPresent0 = ED.present;
ED.present = (mode, o) => { if (GR.isDesign(ED.deck)) { toast('Questo è un progetto grafico: scaricalo dal pulsante “Scarica”.', { ms: 3000 }); return; } return edPresent0(mode, o); };
const exMenu0 = EX.menu;
EX.menu = (anchor) => GR.isDesign(ED.deck) ? GR.exportMenu(anchor) : exMenu0(anchor);
const magic0 = ED.magicMenu;
ED.magicMenu = (anchor) => {
  if (!GR.isDesign(ED.deck)) return magic0(anchor);
  UI.menu(anchor, [
    { head: 'Magia' },
    { label: 'Controllo qualità', icon: 'check', onclick: () => ED.setPanel('check') },
    { label: 'Applica il marchio', icon: 'palette', onclick: () => ED.brandDialog() },
    { label: 'Cambia formato', icon: 'expand', onclick: () => ED.resizeDialog() },
    { sep: 1 },
    { label: 'Cronologia versioni', icon: 'clock', onclick: () => VER.dialog() },
    { label: 'Salva come modello', icon: 'layout', onclick: () => App.saveAsTemplate(ED.deck) },
    { sep: 1 },
    { label: 'Creatore di loghi', icon: 'star', onclick: () => LOGO.dialog() }
  ], { align: 'right' });
};

/* ---------- esportazioni ---------- */
GR.png = async (deck, i, o = {}) => {
  const pr = EX.progress('Preparo l’immagine…');
  try {
    const c = await EX.canvas(deck, deck.slides[i], o.scale || 1, i, { transparent: o.transparent });
    let blob;
    if (o.jpg) { const f = document.createElement('canvas'); f.width = c.width; f.height = c.height; const x = f.getContext('2d'); x.fillStyle = '#FFFFFF'; x.fillRect(0, 0, f.width, f.height); x.drawImage(c, 0, 0); blob = await EX.toBlob(f, 'image/jpeg', .93); }
    else blob = await EX.toBlob(c);
    pr.done();
    if (await ST.saveFile(`${EX.safeName(deck)}${deck.slides.length > 1 ? '-' + (i + 1) : ''}${o.transparent ? '-trasparente' : ''}.${o.jpg ? 'jpg' : 'png'}`, blob)) toast('Immagine salvata');
  } catch (e) { pr.done(); console.warn(e); toast('Non sono riuscito a creare l’immagine', { type: 'err' }); }
};
GR.dataUrl = async (u) => {
  if (/^data:/.test(u)) return u;
  try { const r = await fetch(u), b = await r.blob(); return await readFileAs(b); } catch (e) { return u; }
};
GR.xml = s => String(s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
GR.svg = async (deck, i) => {
  const s = deck.slides[i], W = deck.w, H = deck.h, defs = []; let n = 0, body = '';
  await EX.prepare(deck, [s]); await EX.resolveAll();
  const ctx = document.createElement('canvas').getContext('2d');
  const paint = (f, w, h) => { if (!f) return 'none'; if (typeof f === 'string') return f; const id = 'g' + (n++), g = R.gradLine(f, w, h); defs.push(`<linearGradient id="${id}" gradientUnits="userSpaceOnUse" x1="${g.x1}" y1="${g.y1}" x2="${g.x2}" y2="${g.y2}">${f.g.map((c, k) => `<stop offset="${(k / (f.g.length - 1) * 100).toFixed(0)}%" stop-color="${c}"/>`).join('')}</linearGradient>`); return `url(#${id})`; };
  if (typeof s.bg === 'string' || (s.bg && s.bg.g)) body += `<rect width="${W}" height="${H}" fill="${paint(s.bg, W, H)}"/>`;
  else if (s.bg && s.bg.img) { const u = await GR.dataUrl(await Img.urlAsync(s.bg.img)); body += `<image href="${GR.xml(u)}" width="${W}" height="${H}" preserveAspectRatio="xMidYMid slice"/>` + (s.bg.dim ? `<rect width="${W}" height="${H}" fill="#000" opacity="${s.bg.dim}"/>` : ''); }
  for (const e of s.els) {
    if (e.hd) continue;
    const tf = `translate(${e.x + e.w / 2} ${e.y + e.h / 2})${e.r ? ` rotate(${e.r})` : ''} translate(${-e.w / 2} ${-e.h / 2})`, op = e.o != null && e.o < 1 ? ` opacity="${e.o}"` : '';
    if (e.t === 'shape' && e.k === 'line') { const st = e.st, a = M.arrowHeads(e); body += `<g transform="${tf}"${op}><path d="${M.linePath(e)}" fill="none" stroke="${st.c}" stroke-width="${st.w}"${R.dash(st)}/>${a.end ? `<path d="${a.end}" fill="${st.c}"/>` : ''}${a.start ? `<path d="${a.start}" fill="${st.c}"/>` : ''}</g>`; }
    else if (e.t === 'shape') body += `<g transform="${tf}"${op}><path d="${M.pathOf(e)}" fill="${paint(e.f, e.w, e.h)}" fill-rule="evenodd"${e.st ? ` stroke="${e.st.c}" stroke-width="${e.st.w}" stroke-linejoin="round"${R.dash(e.st)}` : ''}/></g>`;
    else if (e.t === 'text' && !e.cv && !e.te && !e.sh) {
      const { lines, innerW, pad } = EX.layoutText(ctx, e), L = e.s * e.lh; let y = pad, out = '';
      if (e.bg) out += `<path d="${P.round(e.w, e.h, { rad: e.rad || 0 })}" fill="${paint(e.bg, e.w, e.h)}"/>`;
      ctx.font = EX.font(e, e.s, R.weight(e), !!e.i); const m = ctx.measureText('Hxg'), A = m.fontBoundingBoxAscent || e.s * .8, D = m.fontBoundingBoxDescent || e.s * .2;
      lines.forEach((ln, li) => {
        const al = ln.p.a || e.a, free = innerW - ln.indent - ln.width; let x = pad + ln.indent + (al === 'center' ? free / 2 : al === 'right' ? free : 0); const base = y + (L - (A + D)) / 2 + A;
        if (ln.first && ln.p.l) out += `<text x="${pad}" y="${base.toFixed(1)}" font-family="${GR.xml(fontStack(e.f))}" font-size="${e.s}" font-weight="700" fill="${e.bc || e.c}">${ln.p.l === 'b' ? '•' : ln.num + '.'}</text>`;
        ln.toks.forEach(t => { const fm = t.font.match(/^(italic )?(\d+) /); out += `<text x="${x.toFixed(1)}" y="${base.toFixed(1)}" font-family="${GR.xml(fontStack(e.f))}" font-size="${e.s}" font-weight="${fm ? fm[2] : 400}"${fm && fm[1] ? ' font-style="italic"' : ''} fill="${t.col}"${e.ls ? ` letter-spacing="${(e.ls * e.s).toFixed(2)}"` : ''}${t.ul ? ' text-decoration="underline"' : ''} xml:space="preserve">${GR.xml(t.w)}</text>`; x += t.width; });
        y += L; const nx = lines[li + 1]; if (nx && nx.pi !== ln.pi && e.ps) y += e.ps * e.s;
      });
      body += `<g transform="${tf}"${op}>${out}</g>`;
    } else if (e.t === 'image' && e.src && !e.mk && !e.rad && !e.ix && !e.iy && !(e.iz > 1) && R.imgFilter(e) === 'none') {
      const u = await GR.dataUrl(await Img.urlAsync(e.src, e.rc)); body += `<g transform="${tf}"${op}><image href="${GR.xml(u)}" width="${e.w}" height="${e.h}" preserveAspectRatio="xMidYMid slice"${e.fl ? ` transform="translate(${e.w} 0) scale(-1 1)"` : ''}/></g>`;
    } else { // il resto diventa un'immagine ad alta definizione
      const r = EX.elCanvas(e, 2); body += `<image href="${r.c.toDataURL('image/png')}" x="${r.x}" y="${r.y}" width="${r.w}" height="${r.h}"/>`;
    }
  }
  const fonts = [...new Set(EX.flat(s.els).filter(e => e.t === 'text').map(e => e.f))].map(f => `family=${encodeURIComponent(f).replace(/%20/g, '+')}:wght@400;500;600;700;800`).join('&amp;');
  return `<?xml version="1.0" encoding="UTF-8"?>\n<svg xmlns="http://www.w3.org/2000/svg" width="${W}" height="${H}" viewBox="0 0 ${W} ${H}"><defs>${fonts ? `<style>@import url('https://fonts.googleapis.com/css2?${fonts}&amp;display=swap');</style>` : ''}${defs.join('')}</defs>${body}</svg>`;
};
GR.saveSvg = async (deck, i) => {
  const pr = EX.progress('Preparo il file SVG…');
  try { const svg = await GR.svg(deck, i); pr.done(); if (await ST.saveFile(`${EX.safeName(deck)}${deck.slides.length > 1 ? '-' + (i + 1) : ''}.svg`, new Blob([svg], { type: 'image/svg+xml' }))) toast('SVG salvato. I testi usano i font di Google: online si vedono giusti.', { ms: 4200 }); }
  catch (e) { pr.done(); console.warn(e); toast('Non sono riuscito a creare l’SVG', { type: 'err' }); }
};
GR.useAsLogo = async (deck, i) => {
  try {
    const c = await EX.canvas(deck, deck.slides[i], 1, i, { transparent: true }), b = await EX.toBlob(c), ref = await Img.store(b);
    ST.brand.logo = ref; ST.saveBrand(); toast('Ora è il logo del tuo marchio: lo trovi nel pannello Immagini.', { icon: 'check', ms: 3500 });
  } catch (e) { console.warn(e); toast('Non sono riuscito a salvare il logo', { type: 'err' }); }
};
GR.exportMenu = (anchor) => {
  const D = ED.deck, i = ED.si, items = [
    { head: 'Scarica' },
    { label: 'PNG', icon: 'image', onclick: () => GR.png(D, i) },
    { label: 'PNG grande (2×)', icon: 'image', onclick: () => GR.png(D, i, { scale: 2 }) },
    { label: 'PNG con sfondo trasparente', icon: 'image', onclick: () => GR.png(D, i, { transparent: true, scale: D.w <= 1200 ? 2 : 1 }) },
    { label: 'JPG', icon: 'image', onclick: () => GR.png(D, i, { jpg: true }) },
    { label: 'SVG (vettoriale)', icon: 'shapes', onclick: () => GR.saveSvg(D, i) },
    { label: 'PDF (tutte le pagine)', icon: 'file', onclick: () => EX.pdf(D) },
    { label: 'Progetto Palco (.json)', icon: 'download', onclick: () => EX.json(D) }];
  if (D.fmt === 'logo') items.push({ sep: 1 }, { label: 'Usa come logo del marchio', icon: 'star', onclick: () => GR.useAsLogo(D, i) });
  UI.menu(anchor, items, { align: 'right' });
};

/* ---------- Modelli ---------- */
ED.gd = { mode: 'replace' };
ED.panels.gdesign = () => {
  const D = ED.deck, fk = D.fmt === 'photo' ? 'post' : D.fmt, F = GR.byK(fk), grid = h('div.laygrid.gdgrid');
  if (fk === 'logo') return [h('p.hint2', 'Per scegliere un nuovo stile apri il creatore di loghi: puoi partire dal nome della tua attività.'), h('button.btn.primary.full', { onclick: () => LOGO.dialog() }, icn('star', 18), 'Crea nuovi loghi')];
  GR.VARS.forEach((v, i) => {
    const slot = h('button.lay.gdl', { title: 'Usa questo modello', onclick: async () => {
      const d = await GR.build(fk, i, { w: D.w, h: D.h }); if (!d) return;
      if (ED.gd.mode === 'add') { d.slides.forEach((s, k) => D.slides.splice(ED.si + 1 + k, 0, s)); ED.si++; } else { const s = d.slides[Math.min(ED.si, d.slides.length - 1)], cur = ED.slide(); cur.els = s.els; cur.bg = s.bg; }
      ED.sel = []; ED.renderAll(); ED.commit();
    } }, h('div.thwrap.loading', { style: { aspectRatio: `${D.w}/${D.h}` } }));
    GR.build(fk, i, { w: D.w, h: D.h }).then(d => { const w = $('.thwrap', slot); if (w) { w.classList.remove('loading'); w.appendChild(R.thumb(d.slides[0], d)); } });
    grid.appendChild(slot);
  });
  return [psec('Modello', UI.seg([['replace', 'Sostituisci'], ['add', 'Aggiungi pagina']], ED.gd.mode, v => { ED.gd.mode = v; ED.renderPanel(); })), h('p.hint2', `Composizioni pronte per “${F.n}”. I testi si cambiano con un doppio clic; le foto si trascinano sulle cornici vuote.`), grid];
};

/* ---------- Materiali ---------- */
GR.label = async (k) => {
  await loadFonts([['Poppins', 800], ['Poppins', 600]]);
  const ac = ED.accent(), D = ED.deck, u = Math.min(D.w, D.h) / 1080, kids = [];
  const T = (t, x, y, w, s, c, o = {}) => { const e = GR.T(t, x, y, w, s, { f: 'Poppins', c, a: 'center', wt: 800, lh: 1, ...o }); return e; };
  let w, h2;
  if (k === 'sale') { w = h2 = 420; kids.push(GR.S('seal', 0, 0, 420, 420, ac)); const a = T('-30%', 20, 0, 380, 120, Col.readable(ac)); a.y = 140; const b = T('SCONTO', 20, 280, 380, 40, Col.readable(ac), { wt: 700, ls: .2 }); kids.push(a, b); }
  else if (k === 'new') { w = 560; h2 = 170; kids.push(GR.S('ribbon', 0, 0, 560, 170, ac)); const a = T('NOVITÀ', 40, 0, 480, 72, Col.readable(ac), { ls: .1 }); a.y = Math.round((170 - a.h) / 2); kids.push(a); }
  else if (k === 'ticket') { w = 640; h2 = 280; kids.push(GR.S('ticket', 0, 0, 640, 280, ac)); const a = T('INGRESSO', 40, 40, 560, 40, Col.readable(ac), { wt: 600, ls: .3 }), b = T('GRATUITO', 40, 110, 560, 92, Col.readable(ac)); kids.push(a, b); }
  else if (k === 'price') { w = 520; h2 = 260; kids.push(GR.S('tag', 0, 0, 520, 260, ac)); const a = T('€ 19', 120, 0, 380, 110, Col.readable(ac), { a: 'center' }); a.y = Math.round((260 - a.h) / 2); kids.push(a); }
  else if (k === 'stamp') { w = h2 = 400; kids.push(GR.S('ring', 0, 0, 400, 400, ac, { rad: 7 })); const a = T('ORIGINALE', 40, 0, 320, 56, ac, { ls: .15 }); a.y = Math.round(200 - a.h / 2 - 22); const b = T('100%', 40, 0, 320, 100, ac); b.y = Math.round(200 - b.h / 2 + 40); kids.push(a, b); }
  else { w = 640; h2 = 150; kids.push(GR.S('pill', 0, 0, 640, 150, ac)); const a = T('Scopri di più', 40, 0, 460, 54, Col.readable(ac), { wt: 700 }); a.y = Math.round((150 - a.h) / 2); kids.push(a, GR.S('icon:arrowR', 510, 45, 60, 60, Col.readable(ac))); }
  const g = { id: uid('e'), t: 'group', x: 0, y: 0, w: Math.round(w * u * 1.4), h: Math.round(h2 * u * 1.4), ow: w, oh: h2, r: 0, els: kids.map(e => { e.x = Math.round(e.x); e.y = Math.round(e.y); return e; }) };
  return g;
};
ED.gm = { q: '' };
ED.panels.gmat = () => {
  const q = h('input.inp.sm', { type: 'search', placeholder: 'Cerca simboli: caffè, natura, sport…', value: ED.gm.q, 'aria-label': 'Cerca simboli', oninput: e => { ED.gm.q = e.target.value; draw(); } });
  const body = h('div');
  const symBtn = k => h('button.eb', { title: SYM[k].n, 'aria-label': SYM[k].n, onclick: () => ED.addShape('sym:' + k, { w: 300, h: 300 }) }, h('svg', { viewBox: '0 0 100 100', width: 40, height: 40, html: `<path d="${M.pathOf({ k: 'sym:' + k, w: 100, h: 100 })}" fill="currentColor" fill-rule="evenodd"/>` }));
  const sizes = { ticket: [560, 260], ribbon: [640, 200], tag: [480, 240], pennant: [360, 300], seal: [420, 420], sunburst: [420, 420], halfring: [520, 260], zigzag: [640, 120], scallop: [640, 120], frame: [700, 700], frameR: [700, 700], corners: [700, 700] };
  const badge = ([k, n]) => h('button.eb', { title: n, 'aria-label': n, onclick: () => ED.addShape(k, { w: sizes[k][0], h: sizes[k][1] }) }, h('svg', { viewBox: '0 0 100 100', width: 44, height: 44, html: `<path d="${M.pathOf({ k, w: 100, h: 100, rad: null })}" fill="currentColor" fill-rule="evenodd" opacity=".92"/>` }));
  const draw = () => {
    const f = ED.gm.q.trim().toLowerCase(); body.innerHTML = '';
    const syms = SYM_LIST.filter(k => !f || (SYM[k].n + ' ' + SYM[k].tags).toLowerCase().includes(f));
    body.appendChild(psec('Simboli per loghi', syms.length ? h('div.egrid', syms.map(symBtn)) : h('p.pempty', 'Nessun simbolo trovato'), h('p.hint2', 'Forme vettoriali: si ricolorano e si ingrandiscono senza perdere qualità.')));
    if (f) return;
    body.appendChild(psec('Distintivi e bordi', h('div.egrid', M.BADGE_LIST.map(badge))));
    body.appendChild(psec('Etichette pronte', h('div.egrid.l2', [['sale', 'Sconto'], ['new', 'Novità'], ['ticket', 'Biglietto'], ['price', 'Prezzo'], ['stamp', 'Timbro'], ['cta', 'Pulsante']].map(([k, n]) => h('button.eb.card', { onclick: async () => { const g = await GR.label(k); ED.addEl(g); } }, h('span', n))))));
    let asImg = ED.gm.asImg, all = !!ED.gm.all;
    body.appendChild(psec('Pattern per lo sfondo', h('label.chk', h('input', { type: 'checkbox', checked: all, onchange: e => { ED.gm.all = e.target.checked; } }), 'Applica a tutte le pagine'),
      h('div.imggrid', PAT_LIST.map(r => h('button.imgb', { title: PAT_TITLES[r.split(':')[1]], onclick: () => ED.setBg({ img: r, dim: 0 }, !!ED.gm.all) }, h('img', { src: Img.url(r), alt: PAT_TITLES[r.split(':')[1]], loading: 'lazy' }))))));
  };
  draw();
  return [h('div.psearch', q), body];
};

/* ---------- Ritocco foto ---------- */
GR.FILTERS = [
  ['Originale', {}], ['Vivido', { sa: 1.45, ct: 1.1 }], ['Morbido', { ct: .9, br: 1.08, sa: .9 }], ['Dissolvenza', { ct: .8, br: 1.12, sa: .78 }],
  ['Seppia', { sp: .85 }], ['Vintage', { sp: .45, ct: .9, sa: .85, br: 1.05 }], ['Bianco e nero', { gs: 1 }], ['B/N intenso', { gs: 1, ct: 1.4 }],
  ['Freddo', { hu: -14, sa: 1.1 }], ['Caldo', { hu: 10, sa: 1.15, br: 1.03 }], ['Drammatico', { ct: 1.4, br: .92, sa: 1.2 }], ['Notte', { br: .72, hu: -20, ct: 1.2 }],
  ['Neon', { hu: 60, sa: 1.8, ct: 1.2 }], ['Pop', { sa: 2, ct: 1.25 }]
];
GR.photoTarget = () => {
  const sel = ED.selEls();
  if (sel.length === 1 && sel[0].t === 'image' && sel[0].src) return sel[0];
  return ED.slide().els.filter(e => e.t === 'image' && e.src && !e.hd).sort((a, b) => b.w * b.h - a.w * a.h)[0] || null;
};
GR.fitCanvas = (w, h2, mode) => {
  const D = ED.deck, kx = w / D.w, ky = h2 / D.h;
  D.slides.forEach(s => s.els.forEach(e => {
    if (e.t === 'image' && e.w >= D.w * .9 && e.h >= D.h * .9) { // la foto principale riempie la nuova tela
      const ar = (ED._nat && ED._nat[e.src]) || { w: e.w, h: e.h }, k = Math.max(w / ar.w, h2 / ar.h);
      e.x = 0; e.y = 0; e.w = w; e.h = h2; e.ix = 0; e.iy = 0; e.iz = 1; return;
    }
    M.scaleEl(e, Math.min(kx, ky), Math.min(kx, ky), Math.min(kx, ky)); e.x = Math.round(e.x + (w - D.w * Math.min(kx, ky)) / 2); e.y = Math.round(e.y + (h2 - D.h * Math.min(kx, ky)) / 2);
  }));
  D.w = w; D.h = h2; ED.fit = true; ED.renderAll(); ED.commit(); ED.applyZoom && ED.applyZoom();
};
ED.panels.photo = () => {
  const t = GR.photoTarget(), D = ED.deck;
  if (!t) return [h('p.hint2', 'Aggiungi una foto alla pagina per ritoccarla: filtri, regolazioni, ritaglio e sfondo.'), h('button.btn.primary.full', { onclick: () => UI.pickFile('image/*', true, fs => ED.uploadImages(fs)) }, icn('upload', 18), 'Carica una foto')];
  const fx = t.fx || {}, same = (a, b) => ['br', 'ct', 'sa', 'gs', 'sp', 'hu', 'bl'].every(k => (+(a[k] ?? (k === 'gs' || k === 'sp' || k === 'hu' || k === 'bl' ? 0 : 1)) === +(b[k] ?? (k === 'gs' || k === 'sp' || k === 'hu' || k === 'bl' ? 0 : 1))));
  const src = Img.url(t.src, t.rc);
  const filters = h('div.fgrid', GR.FILTERS.map(([n, f]) => h('button.fl' + (same(fx, f) ? '.on' : ''), { title: n, onclick: () => { ED.mut(x => { x.fx = Object.keys(f).length ? { ...f } : null; }, { els: [t] }); ED.renderPanel(); } }, h('span.fimg', h('img', { src, alt: '', style: { filter: R.imgFilter({ fx: f }) } })), h('small', n))));
  const slider = (label, key, min, max, def, scale, unit) => {
    const cur = fx[key] != null ? fx[key] : def, val = h('b', Math.round(cur * scale) + unit);
    return h('label.prow', h('span', label, val), h('input', { type: 'range', min, max, value: Math.round(cur * scale), 'aria-label': label, oninput: e => { const v = +e.target.value / scale; val.textContent = e.target.value + unit; ED.mut(x => { x.fx = x.fx || {}; x.fx[key] = v; }, { els: [t], tb: false, now: false }); } }));
  };
  const ratios = [['Originale', null], ['1:1', [1080, 1080]], ['4:5', [1080, 1350]], ['9:16', [1080, 1920]], ['16:9', [1920, 1080]], ['3:2', [1620, 1080]]];
  return [
    psec('Filtri', filters),
    psec('Regolazioni', slider('Luminosità', 'br', 50, 150, 1, 100, '%'), slider('Contrasto', 'ct', 50, 160, 1, 100, '%'), slider('Colore', 'sa', 0, 220, 1, 100, '%'), slider('Tonalità', 'hu', -180, 180, 0, 1, '°'), slider('Seppia', 'sp', 0, 100, 0, 100, '%'), slider('Sfocatura', 'bl', 0, 24, 0, 1, ' px'),
      h('div.btnrow', h('button.btn.sm', { onclick: () => { ED.mut(x => { x.fx = null; }, { els: [t] }); ED.renderPanel(); } }, icn('restore', 16), 'Azzera'))),
    psec('Strumenti', h('div.btnrow.g3',
      h('button.btn.sm', { onclick: () => ED.startCrop(t) }, icn('crop', 16), 'Ritaglia'),
      h('button.btn.sm', { onclick: e => TB.bgPop(e.currentTarget, t) }, icn('sparkles', 16), 'Sfondo'),
      h('button.btn.sm', { onclick: () => { ED.mut(x => { x.fl = x.fl ? 0 : 1; }, { els: [t] }); } }, icn('flipH', 16), 'Specchia')),
      h('div.btnrow.g3', h('button.btn.sm', { onclick: () => ED.mut(x => { x.r = ((x.r || 0) + 90) % 360; }, { els: [t] }) }, icn('rotate', 16), 'Ruota'),
        h('button.btn.sm', { onclick: () => ED.setPanel('text') }, icn('type', 16), 'Testo'), h('button.btn.sm', { onclick: () => ED.setPanel('gmat') }, icn('star', 16), 'Adesivi')),
      h('p.hint2', 'Per cambiare i colori di un’immagine, selezionala e usa “Colori” nella barra in alto.')),
    psec('Formato della tela', h('div.chips', ratios.map(([l, sz]) => h('button.chip', { onclick: async () => { if (!sz) { const n = await Img.size(t.src), k = Math.min(1, 2000 / Math.max(n.w, n.h)); ED._nat = ED._nat || {}; ED._nat[t.src] = n; return GR.fitCanvas(Math.round(n.w * k), Math.round(n.h * k)); } const n = await Img.size(t.src); ED._nat = ED._nat || {}; ED._nat[t.src] = n; GR.fitCanvas(sz[0], sz[1]); } }, l))),
      h('p.hint2', 'Ritaglia la foto per il post, la storia o la copertina. Poi puoi trascinarla nella cornice con “Ritaglia”.'))
  ];
};
/* il pannello Ritocco segue la selezione */
const ctxPhoto0 = ED.renderCtx;
ED.renderCtx = () => { ctxPhoto0(); if (ED.panel === 'photo' && !ED.crop) { clearTimeout(ED._phT); ED._phT = setTimeout(() => ED.panel === 'photo' && !ED._phDrag && ED.renderPanel(), 60); } };
/* i modelli non servono a decorare le foto: il pannello IA del progetto grafico non propone pagine né note */
const ai0 = ED.panels.ai;
ED.panels.ai = () => { const r = ai0(); return GR.isDesign(ED.deck) ? r.filter(n => !(n && n.querySelector && /^(Pagine|Note del relatore)$/.test((n.querySelector('h3') || {}).textContent || ''))) : r; };

/* ---------- foto aperta come progetto ---------- */
GR.openImages = async (files) => {
  files = [...files].filter(f => f); if (!files.length) return;
  try {
    toast('Apro “' + files[0].name + '”…', { ms: 1500 });
    const refs = []; for (const f of files) refs.push(await Img.addFile(f));
    const n = await Img.size(refs[0]), k = Math.min(1, 2000 / Math.max(n.w, n.h)), w = Math.max(200, Math.round(n.w * k)), hh = Math.max(200, Math.round(n.h * k));
    const s = M.newSlide('#1B1E2A'); s.els.push(M.image(refs[0], { x: 0, y: 0, w, h: hh }));
    const d = M.newDeck({ name: files[0].name.replace(/\.[a-z0-9]+$/i, '') || 'Foto', w, h: hh, theme: 'minimale', slides: [s] });
    d.kind = 'design'; d.fmt = 'photo'; d.imgs = refs.slice(); ED._nat = ED._nat || {}; ED._nat[refs[0]] = n;
    App.create(d);
    if (refs.length > 1) toast(`Le altre ${refs.length - 1} immagini sono nel pannello “Immagini”.`, { ms: 3500 });
  } catch (e) { console.warn(e); toast('Non riesco ad aprire questa immagine (formati: PNG, JPG, WebP, GIF, SVG)', { type: 'err' }); }
};

/* ============ Caricatore intelligente: riconosce il tipo di file e lo apre nel posto giusto ============ */
GR.MIME = { png: 'image/png', jpg: 'image/jpeg', jpeg: 'image/jpeg', webp: 'image/webp', gif: 'image/gif', svg: 'image/svg+xml', bmp: 'image/bmp', avif: 'image/avif' };
GR.kind = (f) => {
  const n = f.name || '', ext = (n.match(/\.([a-z0-9]+)$/i) || [])[1];
  if (/\.pdf$/i.test(n) || f.type === 'application/pdf') return 'pdf';
  if (/\.pptx$/i.test(n) || /presentationml\.presentation$/.test(f.type)) return 'pptx';
  if (/\.(ppt|pps|key|odp)$/i.test(n)) return 'oldslides';
  if (/\.json$/i.test(n) || f.type === 'application/json') return 'json';
  if (/\.(heic|heif)$/i.test(n)) return 'heic';
  if ((f.type || '').startsWith('image/') || (ext && GR.MIME[ext.toLowerCase()])) return 'image';
  return '';
};
GR.asImage = (f) => { if ((f.type || '').startsWith('image/')) return f; const ext = ((f.name.match(/\.([a-z0-9]+)$/i) || [])[1] || '').toLowerCase(); return new File([f], f.name, { type: GR.MIME[ext] || 'image/png' }); };
App.importFiles = async (files) => {
  const fs = [...files]; if (!fs.length) return;
  const imgs = fs.filter(f => GR.kind(f) === 'image');
  if (imgs.length) return GR.openImages(imgs.map(GR.asImage));
  return App.importFile(fs[0]);
};
App.importFile = async (f) => {
  if (!f) return;
  const k = GR.kind(f);
  if (k === 'pdf') return PDFI.dialog(f);
  if (k === 'pptx') return PPTI.dialog(f);
  if (k === 'image') return GR.openImages([GR.asImage(f)]);
  if (k === 'json') { try { return App.create(await EX.importJson(f)); } catch (e) { return toast('Questo file non è un progetto Palco valido', { type: 'err' }); } }
  if (k === 'oldslides') return toast('In PowerPoint scegli File → Salva con nome → “Presentazione di PowerPoint (.pptx)” e caricalo di nuovo.', { type: 'err', ms: 6000 });
  if (k === 'heic') return toast('Le foto HEIC dell’iPhone non si aprono nel browser: esportale in JPG e riprova.', { type: 'err', ms: 5000 });
  toast('Formato non riconosciuto: carica un’immagine, un PDF, un file PowerPoint (.pptx) o un progetto Palco.', { type: 'err', ms: 5000 });
};
App.pickImport = () => UI.pickFile('image/*,.pdf,.pptx,.json,application/pdf,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/json', true, fs => App.importFiles(fs));

