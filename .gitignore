  return s;
};

/* ---- testo ---- */
R.textCss = e => `font-family:${fontStack(e.f)};font-size:${e.s}px;color:${e.c};font-weight:${R.weight(e)};font-style:${e.i ? 'italic' : 'normal'};text-decoration:${e.u ? 'underline' : 'none'};text-transform:${e.up ? 'uppercase' : 'none'};text-align:${e.a};line-height:${e.lh};letter-spacing:${e.ls}em;--ps:${e.ps || 0}em;--bc:${e.bc || e.c};${e.pad ? `padding:${e.pad}px;` : ''}${R.textFx(e)}`;
/* effetti del testo: contorno, eco, neon, sfumatura... */
R.TEXT_FX = [['', 'Nessuno'], ['lift', 'Rialzato'], ['echo', 'Eco'], ['neon', 'Neon'], ['glitch', 'Glitch'], ['hollow', 'Vuoto'], ['outline', 'Contorno'], ['gradient', 'Sfumato']];
R.fxColor = e => e.tc2 || (Col.lum(Col.parse(e.c) || '#000000') > .5 ? '#111111' : '#FFFFFF');
R.textFx = e => {
  const c = Col.parse(e.c) || '#000000', c2 = R.fxColor(e);
  switch (e.te) {
    case 'lift': return 'text-shadow:0 .05em .14em rgba(0,0,0,.38);';
    case 'echo': return `text-shadow:.07em .07em 0 ${Col.alpha(c2, .55)},.14em .14em 0 ${Col.alpha(c2, .25)};`;
    case 'neon': { const g = e.tc2 || c; return `color:${Col.mix(c, '#FFFFFF', .8)};text-shadow:0 0 .06em ${Col.mix(g, '#FFFFFF', .5)},0 0 .18em ${g},0 0 .4em ${g},0 0 .8em ${g};`; }
    case 'glitch': return 'text-shadow:-.045em 0 #FF2D55,.045em 0 #00E5FF;';
    case 'hollow': return `color:transparent;-webkit-text-stroke:${(.035 * e.s).toFixed(2)}px ${c};`;
    case 'outline': return `-webkit-text-stroke:${(.07 * e.s).toFixed(2)}px ${c2};paint-order:stroke fill;`;
    case 'gradient': return `background:${R.fillCss(e.tg || { g: ['#FF6B4A', '#FFB84D'], a: 90 })};-webkit-background-clip:text;background-clip:text;color:transparent;`;
  }
  return '';
};
/* testo curvo: geometria dell'arco */
R.curveGeom = e => {
  const c = clamp(e.cv, -100, 100), th = Math.max(.06, Math.abs(c) / 100 * Math.PI * 1.5), w = e.w, s = e.s;
  const r = (w / 2) / Math.sin(th / 2);
  const sag = r * (1 - Math.cos(th / 2)), large = th > Math.PI ? 1 : 0, up = c > 0;
  const chordY = up ? s * 1.05 + sag : s * .8;
  const apexY = up ? s * 1.05 : s * .8 + sag;
  const h = Math.ceil(up ? chordY + s * .35 : apexY + s * .5);
  return { r, sag, large, up, th, chordY, apexY, h, d: `M0 ${chordY.toFixed(1)}A${r.toFixed(1)} ${r.toFixed(1)} 0 ${large} ${up ? 1 : 0} ${w} ${chordY.toFixed(1)}` };
};
R.curveInner = e => {
  const g = R.curveGeom(e), id = 'cv' + e.id, txt = esc(M.plain(e).replace(/\n/g, ' '));
  return `<svg width="${e.w}" height="${g.h}" viewBox="0 0 ${e.w} ${g.h}" style="display:block;overflow:visible"><defs><path id="${id}" d="${g.d}"/></defs><text fill="currentColor"><textPath href="#${id}" startOffset="50%" text-anchor="middle">${txt}</textPath></text></svg>`;
};
R.run = (r, e) => {
  let st = '';
  if (r.b != null && r.b !== (R.weight(e) >= 600)) st += `font-weight:${r.b ? 700 : 400};`;
  if (r.i != null && r.i !== !!e.i) st += `font-style:${r.i ? 'italic' : 'normal'};`;
  if (r.u != null && r.u !== !!e.u) st += `text-decoration:${r.u ? 'underline' : 'none'};`;
  if (r.c) st += `color:${r.c};`;
  return st ? `<span style="${st}">${esc(r.t)}</span>` : esc(r.t);
};
R.textInner = e => e.paras.map(p => `<div class="p"${p.l ? ` data-l="${p.l}"` : ''}${p.a ? ` style="text-align:${p.a}"` : ''}>${p.r.length ? p.r.map(r => R.run(r, e)).join('') : '<br>'}</div>`).join('');

/* ---- grafici ---- */
R.niceMax = v => { if (v <= 0) return 10; const p = Math.pow(10, Math.floor(Math.log10(v))), n = v / p; return (n <= 1 ? 1 : n <= 2 ? 2 : n <= 2.5 ? 2.5 : n <= 5 ? 5 : 10) * p; };
R.fmtNum = v => Math.abs(v) >= 1000 ? (Math.round(v / 100) / 10).toString().replace('.', ',') + 'k' : (Math.round(v * 10) / 10).toString().replace('.', ',');
R.chartPrims = e => {
  const W = e.w, H = e.h, fs = e.fs || 26, tc = e.tc || '#14182B', out = [], cols = e.colors, ser = e.series || [], labels = e.labels || [], n = labels.length || 1;
  const col = i => cols[i % cols.length];
  const text = (x, y, t, sz, c, anchor = 'middle', w = 500) => out.push({ k: 'text', x, y, t: String(t), sz, c, anchor, w, f: e.f });
  const pie = e.k === 'pie' || e.k === 'donut';
  /* legenda */
  let legendH = 0;
  if (e.legend && !pie && ser.length > 1) {
    legendH = fs * 2;
    let lx = 0;
    ser.forEach((s, i) => { out.push({ k: 'rect', x: lx, y: fs * .5, w: fs * .8, h: fs * .8, f: col(i), r: 4 }); text(lx + fs * 1.1, fs * .9, s.n, fs * .85, tc, 'start', 500); lx += fs * 1.1 + String(s.n).length * fs * .52 + fs * 1.2; });
  }
  if (pie) {
    const s = ser[0] || { v: [] }, vals = s.v.map(v => Math.max(0, +v || 0)), tot = vals.reduce((a, b) => a + b, 0) || 1;
    const lw = e.legend ? Math.min(W * .4, fs * 11) : 0, aw = W - lw, r = Math.min(aw, H) / 2 - 8, cx = aw / 2, cy = H / 2, ri = e.k === 'donut' ? r * .58 : 0;
    let a0 = -Math.PI / 2;
    vals.forEach((v, i) => {
      const a1 = a0 + v / tot * Math.PI * 2, big = a1 - a0 > Math.PI ? 1 : 0, P = (a, rr) => [cx + Math.cos(a) * rr, cy + Math.sin(a) * rr];
      if (v / tot > .9999) out.push({ k: 'path', d: P2(cx, cy, r, ri), f: col(i), eo: 1 });
      else if (v > 0) {
        const [x0, y0] = P(a0, r), [x1, y1] = P(a1, r), [x2, y2] = P(a1, ri), [x3, y3] = P(a0, ri);
        const d = ri ? `M${x0.toFixed(1)} ${y0.toFixed(1)}A${r} ${r} 0 ${big} 1 ${x1.toFixed(1)} ${y1.toFixed(1)}L${x2.toFixed(1)} ${y2.toFixed(1)}A${ri} ${ri} 0 ${big} 0 ${x3.toFixed(1)} ${y3.toFixed(1)}Z` : `M${cx} ${cy}L${x0.toFixed(1)} ${y0.toFixed(1)}A${r} ${r} 0 ${big} 1 ${x1.toFixed(1)} ${y1.toFixed(1)}Z`;
        out.push({ k: 'path', d, f: col(i), s: e.bgc || '#FFFFFF', sw: 4 });
        if (e.vals && v / tot > .05) { const m = (a0 + a1) / 2, [tx, ty] = P(m, ri ? (r + ri) / 2 : r * .64); text(tx, ty, Math.round(v / tot * 100) + '%', fs * .9, Col.readable(col(i)), 'middle', 700); }
      }
      a0 = a1;
    });
    if (e.legend) labels.forEach((l, i) => { const ly = H / 2 - labels.length * fs * 1.5 / 2 + i * fs * 1.5 + fs * .75; out.push({ k: 'rect', x: aw + 8, y: ly - fs * .4, w: fs * .8, h: fs * .8, f: col(i), r: 4 }); text(aw + 8 + fs * 1.1, ly, l, fs * .9, tc, 'start', 500); });
    return out;
  }
  const L = fs * 2.8, Rm = fs * .8, T = fs * .8 + legendH, B = fs * 2, pw = W - L - Rm, ph = H - T - B;
  const allv = ser.flatMap(s => s.v.map(v => +v || 0)), max = R.niceMax(Math.max(1, ...allv)), steps = 4;
  for (let i = 0; i <= steps; i++) {
    const y = T + ph - ph * i / steps, v = max * i / steps;
    if (e.grid || i === 0) out.push({ k: 'line', x1: L, y1: y, x2: L + pw, y2: y, s: i === 0 ? tc : Col.alpha(Col.parse(tc) || '#000000', .16), sw: i === 0 ? 2 : 1.5 });
    text(L - fs * .5, y, R.fmtNum(v), fs * .78, tc, 'end', 500);
  }
  const gw = pw / n;
  labels.forEach((l, i) => text(L + gw * (i + .5), H - B / 2 + 2, l, fs * .85, tc, 'middle', 500));
  if (e.k === 'line') {
    ser.forEach((s, j) => {
      const pts = s.v.map((v, i) => [L + gw * (i + .5), T + ph - (+v || 0) / max * ph]);
      out.push({ k: 'path', d: 'M' + pts.map(p => p[0].toFixed(1) + ' ' + p[1].toFixed(1)).join('L'), f: null, s: col(j), sw: 7, round: 1 });
      pts.forEach((p, i) => { out.push({ k: 'circle', cx: p[0], cy: p[1], r: 10, f: col(j), s: '#FFFFFF', sw: 3 }); if (e.vals) text(p[0], p[1] - fs * 1.1, R.fmtNum(+s.v[i] || 0), fs * .8, tc, 'middle', 600); });
    });
  } else {
    const bw = gw * .7 / ser.length;
    ser.forEach((s, j) => s.v.forEach((v, i) => {
      const hh = (+v || 0) / max * ph, x = L + gw * i + gw * .15 + bw * j, y = T + ph - hh;
      out.push({ k: 'rect', x, y, w: bw - 4, h: hh, f: col(j), r: Math.min(10, bw / 3) });
      if (e.vals) text(x + (bw - 4) / 2, y - fs * .7, R.fmtNum(+v || 0), fs * .78, tc, 'middle', 600);
    }));
  }
  return out;
};
function P2(cx, cy, r, ri) {
  const o = `M${cx - r} ${cy}A${r} ${r} 0 1 0 ${cx + r} ${cy}A${r} ${r} 0 1 0 ${cx - r} ${cy}Z`;
  return ri ? o + `M${cx - ri} ${cy}A${ri} ${ri} 0 1 1 ${cx + ri} ${cy}A${ri} ${ri} 0 1 1 ${cx - ri} ${cy}Z` : o;
}
R.primsSVG = P => P.map(p => {
  switch (p.k) {
    case 'rect': return `<rect x="${p.x.toFixed(1)}" y="${p.y.toFixed(1)}" width="${Math.max(0, p.w).toFixed(1)}" height="${Math.max(0, p.h).toFixed(1)}" rx="${p.r || 0}" fill="${p.f}"/>`;
    case 'path': return `<path d="${p.d}" fill="${p.f || 'none'}"${p.eo ? ' fill-rule="evenodd"' : ''}${p.s ? ` stroke="${p.s}" stroke-width="${p.sw}" stroke-linejoin="round"${p.round ? ' stroke-linecap="round"' : ''}` : ''}/>`;
    case 'line': return `<line x1="${p.x1.toFixed(1)}" y1="${p.y1.toFixed(1)}" x2="${p.x2.toFixed(1)}" y2="${p.y2.toFixed(1)}" stroke="${p.s}" stroke-width="${p.sw}"/>`;
    case 'circle': return `<circle cx="${p.cx.toFixed(1)}" cy="${p.cy.toFixed(1)}" r="${p.r}" fill="${p.f}"${p.s ? ` stroke="${p.s}" stroke-width="${p.sw}"` : ''}/>`;
    case 'text': return `<text x="${p.x.toFixed(1)}" y="${p.y.toFixed(1)}" font-size="${p.sz.toFixed(1)}" font-weight="${p.w}" fill="${p.c}" text-anchor="${p.anchor}" dominant-baseline="central" font-family="${fontStack(p.f)}">${esc(p.t)}</text>`;
  }
  return '';
}).join('');

/* ---- tabelle ---- */
R.tableCells = e => {
  const rows = e.rows, nc = Math.max(...rows.map(r => r.length)), out = [];
  rows.forEach((row, ri) => {
    for (let ci = 0; ci < nc; ci++) {
      const head = e.hdr && ri === 0;
      out.push({ r: ri, c: ci, t: row[ci] || '', bg: head ? e.hf : (ri % 2 ? e.cf2 : e.cf), fg: head ? e.hc : e.tc, b: head });
    }
  });
  return { cells: out, nc };
};
R.tableHTML = e => {
  const { cells, nc } = R.tableCells(e);
  return `<div class="tbl" style="display:grid;grid-template-columns:repeat(${nc},1fr);grid-auto-rows:${e.rh}px;width:100%;height:100%;font-family:${fontStack(e.f)};font-size:${e.fs}px;border:2px solid ${e.bc};box-sizing:border-box">` +
    cells.map(c => `<div class="tc" data-r="${c.r}" data-c="${c.c}" style="background:${c.bg};color:${c.fg};font-weight:${c.b ? 700 : 400};border:1px solid ${e.bc}">${esc(c.t)}</div>`).join('') + '</div>';
};

/* ---- immagini ---- */
R.imgFilter = e => {
  const f = e.fx; if (!f) return 'none';
  const parts = [];
  if (f.br != null && f.br !== 1) parts.push(`brightness(${f.br})`);
  if (f.ct != null && f.ct !== 1) parts.push(`contrast(${f.ct})`);
  if (f.sa != null && f.sa !== 1) parts.push(`saturate(${f.sa})`);
  if (f.gs) parts.push(`grayscale(${f.gs})`);
  if (f.sp) parts.push(`sepia(${f.sp})`);
  if (f.hu) parts.push(`hue-rotate(${f.hu}deg)`);
  if (f.bl) parts.push(`blur(${f.bl}px)`);
  return parts.length ? parts.join(' ') : 'none';
};

/* ---- elemento ---- */
R.elHTML = (e, deck, o = {}) => {
  const cls = `el el-${e.t}${e.k === 'line' ? ' el-line' : ''}${e.lk ? ' lk' : ''}${e.t === 'image' ? ' el-image' : ''}`;
  const base = `class="${cls}" data-id="${e.id}"`;
  const an = (o.anim || o.editAnim) && R.hasAnim(e) ? R.animAttrs(e) : '';
  switch (e.t) {
    case 'text': {
      const bg = e.bg ? `background:${R.fillCss(e.bg)};` : '', rad = e.rad ? `border-radius:${e.rad}px;` : '';
      return `<div ${base}${an} style="${R.boxStyle(e)}${bg}${rad}"><div class="tx" style="${R.textCss(e)}">${e.cv ? R.curveInner(e) : R.textInner(e)}</div></div>`;
    }
    case 'shape': {
      if (e.k === 'line') {
        const st = e.st || { c: '#000', w: 6, d: 0 }, a = M.arrowHeads(e);
        return `<div ${base}${an} style="${R.boxStyle(e)}"><svg class="shp" width="${e.w}" height="2" viewBox="0 0 ${e.w} 2" style="overflow:visible"><g transform="translate(0,1)"><path d="${M.linePath(e)}" fill="none" stroke="${st.c}" stroke-width="${st.w}" ${R.dash(st)}/>${a.end ? `<path d="${a.end}" fill="${st.c}"/>` : ''}${a.start ? `<path d="${a.start}" fill="${st.c}"/>` : ''}</g></svg></div>`;
      }
      const fl = R.svgFill(e.f, 'g' + e.id, e.w, e.h), st = e.st;
      return `<div ${base}${an} style="${R.boxStyle(e)}"><svg class="shp" width="${e.w}" height="${e.h}" viewBox="0 0 ${e.w} ${e.h}" style="overflow:visible"><defs>${fl.defs}</defs><path d="${M.pathOf(e)}" fill="${fl.fill}" fill-rule="evenodd"${st ? ` stroke="${st.c}" stroke-width="${st.w}" stroke-linejoin="round"${e.lc ? ' stroke-linecap="round"' : ''} ${R.dash(st)}` : ''}/></svg></div>`;
    }
    case 'image': {
      const rad = e.mk ? `clip-path:path('${M.pathOf({ k: e.mk, w: e.w, h: e.h, rad: null })}');` : e.rad ? `border-radius:${e.rad}px;overflow:hidden;` : '', fl = R.imgFilter(e);
      return `<div ${base}${an} style="${R.boxStyle(e)}${rad}"><img src="${esc(Img.url(e.src, e.rc))}" alt="${esc(e.alt || '')}" draggable="false" style="${fl !== 'none' ? `filter:${fl};` : ''}${R.imgTf(e)}"></div>`;
    }
    case 'chart': {
      return `<div ${base}${an} style="${R.boxStyle(e)}"><svg class="shp" width="${e.w}" height="${e.h}" viewBox="0 0 ${e.w} ${e.h}">${R.primsSVG(R.chartPrims(e))}</svg></div>`;
    }
    case 'table': return `<div ${base}${an} style="${R.boxStyle(e)}">${R.tableHTML(e)}</div>`;
    case 'group': {
      const k = e.w / (e.ow || e.w);
      return `<div ${base}${an} style="${R.boxStyle(e)}"><div class="gin" style="width:${e.ow}px;height:${e.oh}px;transform:scale(${k.toFixed(5)});transform-origin:0 0">${e.els.filter(c => !c.hd).map(c => R.elHTML(c, deck, {})).join('')}</div></div>`;
