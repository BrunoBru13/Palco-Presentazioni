    c.addEventListener('pointerdown', e => { drawing = true; last = [e.clientX, e.clientY]; c.setPointerCapture(e.pointerId); PR.dot(c, e.clientX, e.clientY); });
    c.addEventListener('pointermove', e => { PR.wake(); if (!drawing) return; const x = c.getContext('2d'), [col, w, al] = PR.PENS[PR.pen]; x.globalAlpha = al; x.strokeStyle = col; x.lineWidth = w; x.lineCap = x.lineJoin = 'round'; x.beginPath(); x.moveTo(last[0], last[1]); x.lineTo(e.clientX, e.clientY); x.stroke(); x.globalAlpha = 1; last = [e.clientX, e.clientY]; });
    c.addEventListener('pointerup', () => { drawing = false; });
