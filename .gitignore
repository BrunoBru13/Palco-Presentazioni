VOICE.fix = (txt, atStart) => {
  let t = ' ' + txt.trim() + ' '; VOICE.cmds.forEach(([re, to]) => { t = t.replace(re, to); });
  t = t.replace(/\s+([.,;:!?)])/g, '$1').replace(/\(\s+/g, '(').replace(/\s*\n\s*/g, '\n').trim();
