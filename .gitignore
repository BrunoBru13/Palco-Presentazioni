/* ============ Voce dal vivo: sottotitoli per il pubblico (anche tradotti), comandi vocali e teleprompter che segue la tua voce ============ */
const LIVE = { on: false, rec: null, pos: 0, words: [], o: { cc: true, cmd: true, follow: true, auto: false, lang: 'it-IT', tr: '' } };
try { Object.assign(LIVE.o, JSON.parse(localStorage.getItem('palco.live') || '{}')); } catch (e) { }
LIVE.save = () => { try { localStorage.setItem('palco.live', JSON.stringify(LIVE.o)); } catch (e) { } };
LIVE.LANGS = [['it-IT', 'Italiano'], ['en-US', 'English'], ['es-ES', 'Español'], ['fr-FR', 'Français'], ['de-DE', 'Deutsch'], ['pt-PT', 'Português']];
LIVE.TARGETS = [['', 'Nessuna traduzione'], ['inglese', 'Inglese'], ['italiano', 'Italiano'], ['spagnolo', 'Spagnolo'], ['francese', 'Francese'], ['tedesco', 'Tedesco'], ['portoghese', 'Portoghese'], ['arabo', 'Arabo'], ['cinese semplificato', 'Cinese'], ['russo', 'Russo'], ['ucraino', 'Ucraino']];
LIVE.norm = (t) => String(t || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9\s']/g, ' ').replace(/\s+/g, ' ').trim();
LIVE.ctl = () => (typeof PRC !== 'undefined' && PRC.on) ? { dual: true, next: () => PRC.next(), prev: () => PRC.go(PRC.i - 1), go: i => PRC.go(i), last: () => PRC.deck.slides.length - 1, fx: n => PRC.fx(n), toggle: k => PRC.toggle(k), timer: m => PRC.msg('timer', { min: m }), map: () => PRC.msg('key', { k: 'm' }) } : { dual: false, next: () => PR.next(), prev: () => PR.go(PR.i - 1), go: i => PR.go(i), last: () => PR.deck.slides.length - 1, fx: n => { PR[n] && PR[n](); }, toggle: k => (k === 'blur' ? PR.toggleBlur() : PR.toggleBlack()), timer: m => PR.timer(m), map: () => PR.flyOverview && PR.flyOverview() };
LIVE.active = () => (typeof PRC !== 'undefined' && PRC.on) || (PR.on && !PR.audience);

/* ---------- comandi vocali: “Palco, avanti” ---------- */
LIVE.NUM = { uno: 1, un: 1, due: 2, tre: 3, quattro: 4, cinque: 5, sei: 6, sette: 7, otto: 8, nove: 9, dieci: 10, quindici: 15, venti: 20 };
LIVE.command = (txt) => {
  const t = LIVE.norm(txt), m = t.match(/\bpalco\b\s*(.*)$/); if (!m) return false; const c = m[1], k = LIVE.ctl(), say = s => toast('Comando: ' + s, { icon: 'mic', ms: 1600 });
  if (/\b(avanti|prossima|successiva|avanza|vai avanti|continua)\b/.test(c)) { k.next(); say('avanti'); return true; }
  if (/\b(indietro|precedente|torna indietro|vai indietro)\b/.test(c)) { k.prev(); say('indietro'); return true; }
  if (/\b(inizio|prima pagina|ricomincia)\b/.test(c)) { k.go(0); say('inizio'); return true; }
  if (/\b(fine|ultima pagina|ultima)\b/.test(c)) { k.go(k.last()); say('ultima pagina'); return true; }
  if (/\bcoriandoli\b/.test(c)) { k.fx('confetti'); say('coriandoli'); return true; }
  if (/\b(fuochi|fuochi d artificio)\b/.test(c)) { k.fx('fireworks'); say('fuochi d’artificio'); return true; }
  if (/\bbolle\b/.test(c)) { k.fx('bubbles'); say('bolle'); return true; }
  if (/\b(tamburi|rullo)\b/.test(c)) { k.fx('drumroll'); say('rullo di tamburi'); return true; }
  if (/\b(schermo nero|nero)\b/.test(c)) { k.toggle('black'); say('schermo nero'); return true; }
  if (/\b(sfoca|sfocatura)\b/.test(c)) { k.toggle('blur'); say('sfoca'); return true; }
  if (/\bmappa\b/.test(c)) { k.map(); say('mappa'); return true; }
  const tm = c.match(/\btimer\b\D*(\d+|[a-z]+)\s*minut/); if (tm) { const n = +tm[1] || LIVE.NUM[tm[1]]; if (n) { k.timer(n); say(`timer ${n} min`); return true; } }
  if (/\b(ferma|stop|basta)\b/.test(c)) { LIVE.stop(); say('ascolto fermato'); return true; }
  return false;
};

/* ---------- teleprompter che segue la voce ---------- */
LIVE.setNotes = (text) => {
  const raw = String(text || '').trim(); LIVE.raw = raw ? raw.split(/\s+/) : []; LIVE.words = LIVE.raw.map(w => LIVE.norm(w)); LIVE.pos = 0; LIVE._adv = false; LIVE.paint(true);
};
LIVE.paint = (rebuild) => {
  const nt = $('#prc-notes'); if (!nt || !LIVE.o.follow) return;
  if (rebuild || nt.dataset.live !== '1') { nt.innerHTML = ''; nt.dataset.live = '1'; if (!LIVE.raw.length) { nt.textContent = 'Nessuna nota per questa pagina.'; nt.classList.add('empty'); return; } nt.classList.remove('empty'); LIVE.raw.forEach((w, i) => nt.appendChild(h('span.lw', w + ' '))); }
  const sp = nt.children; for (let i = 0; i < sp.length; i++) { sp[i].classList.toggle('done', i < LIVE.pos); sp[i].classList.toggle('now', i === LIVE.pos); }
  const cur = sp[Math.min(LIVE.pos, sp.length - 1)]; if (cur) nt.scrollTo({ top: Math.max(0, cur.offsetTop - nt.clientHeight / 2 + cur.offsetHeight), behavior: 'smooth' });
};
LIVE.advance = (text) => {
  if (!LIVE.o.follow || !LIVE.words.length) return; const toks = LIVE.norm(text).split(' ').filter(Boolean).slice(-12); if (!toks.length) return;
  let best = -1, bs = 0;
  for (let st = Math.max(0, LIVE.pos - 4); st < Math.min(LIVE.words.length, LIVE.pos + 28); st++) {
    let score = 0, k = 0; for (let j = 0; j < toks.length && st + k < LIVE.words.length; j++) { if (LIVE.words[st + k] === toks[j]) { score++; k++; } else if (LIVE.words[st + k + 1] === toks[j]) { score += .6; k += 2; } else if (LIVE.words[st + k] && toks[j] && LIVE.words[st + k][0] === toks[j][0] && Math.abs(LIVE.words[st + k].length - toks[j].length) < 2) { score += .5; k++; } }
    if (score > bs) { bs = score; best = st + k; }
  }
  if (best >= 0 && bs >= Math.min(2, toks.length)) { LIVE.pos = Math.max(LIVE.pos, Math.min(best, LIVE.words.length)); LIVE.paint(); }
  if (LIVE.o.auto && !LIVE._adv && LIVE.pos >= LIVE.words.length * .92 && LIVE.words.length >= 6) { LIVE._adv = true; const i = typeof PRC !== 'undefined' && PRC.on ? PRC.i : PR.i; setTimeout(() => { const cur = typeof PRC !== 'undefined' && PRC.on ? PRC.i : PR.i; if (cur === i && LIVE.on) LIVE.ctl().next(); }, 1500); }
};

/* ---------- sottotitoli ---------- */
LIVE.trCache = new Map();
LIVE.translate = async (text) => {
  if (!LIVE.o.tr || !AI.textOk()) return ''; const key = LIVE.o.tr + '|' + text; if (LIVE.trCache.has(key)) return LIVE.trCache.get(key);
  try { const out = (await AI.ask(`Traduci in ${LIVE.o.tr} questa frase detta a voce durante una presentazione. Rispondi SOLO con la traduzione, senza virgolette.\n\n${text}`, { modelTier: 'quick' })).trim(); LIVE.trCache.set(key, out); return out; } catch (e) { return ''; }
};
PR.cc = (text, tr, final) => {
  if (!PR.root) return; let box = $('.pr-cc', PR.root); if (!box) { box = h('div.pr-cc', h('div.cc1'), h('div.cc2')); PR.root.appendChild(box); }
  const clip = s => { s = String(s || ''); return s.length > 150 ? '…' + s.slice(-150).replace(/^\S*\s/, '') : s; };
  $('.cc1', box).textContent = clip(text); const c2 = $('.cc2', box); c2.textContent = tr ? clip(tr) : ''; c2.hidden = !tr; box.classList.toggle('only', !!tr); box.classList.add('show'); box.classList.toggle('fin', !!final);
  clearTimeout(box._t); box._t = setTimeout(() => box.classList.remove('show'), 4800);
};
LIVE.caption = (text, final, tr) => {
  if (!LIVE.o.cc) return;
  if (typeof PRC !== 'undefined' && PRC.on) { PRC.msg('cc', { text, final, tr }); const c = $('#prc-cc'); if (c) { c.textContent = (tr ? tr + '  ·  ' : '') + text; c.classList.toggle('fin', !!final); } }
  else if (PR.on) PR.cc(text, tr, final);
};
LIVE.feed = async (text, final) => {
  if (!text || !LIVE.active()) return;
  LIVE.caption(text, final, '');
  LIVE.advance(text);
  if (final) { if (LIVE.o.cmd && LIVE.command(text)) return; if (LIVE.o.tr) { const tr = await LIVE.translate(text); if (tr) LIVE.caption(text, true, tr); } }
};

/* ---------- riconoscimento ---------- */
LIVE.ok = () => !!(window.SpeechRecognition || window.webkitSpeechRecognition);
LIVE.btns = () => $$('#prc-mic, #pr-v').forEach(b => b.classList.toggle('rec', LIVE.on));
LIVE.start = () => {
  if (LIVE.on) return; if (!LIVE.ok()) return toast('Il riconoscimento vocale serve Chrome o Edge: in questo browser non è disponibile.', { type: 'err', ms: 4500 });
  if (typeof VOICE !== 'undefined') VOICE.stop();
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition, rec = new SR(); rec.lang = LIVE.o.lang; rec.continuous = true; rec.interimResults = true; LIVE.rec = rec;
  rec.onresult = e => { for (let i = e.resultIndex; i < e.results.length; i++) { const r = e.results[i]; LIVE.feed(r[0].transcript, r.isFinal); } };
  rec.onerror = e => { if (e.error === 'no-speech' || e.error === 'aborted') return; LIVE.stop(); toast(e.error === 'not-allowed' || e.error === 'service-not-allowed' ? 'Il microfono è bloccato: consentilo per questo sito (dentro Claude può non essere disponibile).' : 'L’ascolto si è fermato (' + e.error + ').', { type: 'err', ms: 5500 }); };
  rec.onend = () => { if (LIVE.on && LIVE.rec === rec) { try { rec.start(); } catch (er) { LIVE.stop(); } } };
  try { rec.start(); LIVE.on = true; LIVE.btns(); toast('Ascolto attivo. Per i comandi di’ “Palco, avanti”.', { icon: 'mic', ms: 3200 }); } catch (e) { toast('Non riesco ad avviare il microfono', { type: 'err' }); }
};
LIVE.stop = () => { LIVE.on = false; try { LIVE.rec && LIVE.rec.stop(); } catch (e) { } LIVE.rec = null; LIVE.btns(); };
LIVE.dialog = () => {
  const o = LIVE.o, chk = (k, l, d) => h('label.chk', { style: { alignItems: 'flex-start' } }, h('input', { type: 'checkbox', checked: !!o[k], onchange: e => { o[k] = e.target.checked; LIVE.save(); if (k === 'follow') { const nt = $('#prc-notes'); if (nt && !o.follow) { nt.dataset.live = ''; PRC.render && PRC.render(); } else LIVE.setNotes(LIVE.curNotes()); } } }), h('span', l, d ? h('small.hint2', { style: { display: 'block' } }, d) : null));
  const sel = (key, items, label) => h('label.flab', label, h('select.inp', { onchange: e => { o[key] = e.target.value; LIVE.save(); if (key === 'lang' && LIVE.on) { LIVE.stop(); LIVE.start(); } } }, items.map(([v, l]) => h('option', { value: v, selected: o[key] === v }, l))));
  const status = h('p.hint2'), go = h('button.btn.primary', { onclick: () => { LIVE.on ? LIVE.stop() : LIVE.start(); go.lastChild.textContent = LIVE.on ? 'Ferma l’ascolto' : 'Avvia l’ascolto'; } }, icn('mic', 16), LIVE.on ? 'Ferma l’ascolto' : 'Avvia l’ascolto');
  UI.modal('Voce dal vivo', h('div.form', h('p.mtext', 'Il microfono del computer ascolta mentre parli: i sottotitoli compaiono sullo schermo del pubblico, le note scorrono insieme alla tua voce e puoi comandare la presentazione parlando.'),
    sel('lang', LIVE.LANGS, 'Lingua che parli'), chk('cc', 'Sottotitoli sullo schermo del pubblico'), sel('tr', LIVE.TARGETS, 'Traduci i sottotitoli in'), !AI.textOk() ? h('p.hint2', 'Per tradurre serve un servizio IA (Impostazioni IA).') : null,
    chk('cmd', 'Comandi vocali', 'Di’ “Palco, avanti”, “indietro”, “coriandoli”, “schermo nero”, “mappa”, “timer cinque minuti”, “stop”.'), chk('follow', 'Le note seguono la tua voce', 'Le parole già dette si spengono e il testo scorre da solo.'), chk('auto', 'Passa alla pagina dopo l’ultima parola delle note'), status, go), { cls: 'small' });
};
LIVE.curNotes = () => { const k = typeof PRC !== 'undefined' && PRC.on ? PRC : PR; const d = k.deck, i = k.i; return (d && d.slides[i] && d.slides[i].notes) || ''; };

/* ---------- aggancio alla console e alla presentazione ---------- */
if (typeof PRC !== 'undefined') {
  const b0 = PRC.build;
  PRC.build = () => { b0(); const end = $('.prc-end'); end && end.before(h('button.prc-ib#prc-mic', { title: 'Voce dal vivo: sottotitoli, comandi e note che seguono la voce', 'aria-label': 'Voce dal vivo', onclick: () => LIVE.dialog() }, icn('mic', 18))); const lc = $('.prc-ctl'); lc && lc.before(h('div#prc-cc.prc-cc')); LIVE.btns(); };
  const r0 = PRC.render;
  PRC.render = () => { r0(); if (LIVE.o.follow && PRC.on) { const key = PRC.deck.id + ':' + PRC.i; if (LIVE._key !== key) { LIVE._key = key; LIVE.setNotes(LIVE.curNotes()); } else LIVE.paint(LIVE.words.length && !$('#prc-notes .lw')); } };
  const s0 = PRC.stop;
  PRC.stop = (cw) => { LIVE.stop(); LIVE._key = null; s0(cw); };
}
const liveStart0 = PR.start;
PR.start = (deck, i = 0) => {
  liveStart0(deck, i);
  if (PR.root && !PR.audience && LIVE.ok()) { const bar = $('.pr-bar', PR.root), exit = bar.lastChild; bar.insertBefore(h('button.pbtn#pr-v', { title: 'Voce dal vivo: sottotitoli e comandi', 'aria-label': 'Voce dal vivo', onclick: e => { e.stopPropagation(); LIVE.dialog(); } }, icn('mic', 20)), exit); LIVE.btns(); }
};
const liveStop0 = PR.stop;
PR.stop = () => { const was = PR.on; if (was && !(typeof PRC !== 'undefined' && PRC.on)) LIVE.stop(); liveStop0(); };
if (typeof AUD !== 'undefined') {
  const audMsg2 = AUD.onMsg;
  AUD.onMsg = (e) => { const m = e.data; if (m && m.palco && m.t === 'cc' && e.source === AUD.peer()) { if (PR.on) PR.cc(m.text, m.tr, m.final); return; } return audMsg2(e); };
}

/* ============ Condivisione: link di sola lettura e pagina web autonoma ============ */
const SH = {};
SH.b64 = {
  enc: (u8) => { let s = ''; for (let i = 0; i < u8.length; i += 8192) s += String.fromCharCode.apply(null, u8.subarray(i, i + 8192)); return btoa(s).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, ''); },
  dec: (str) => { const s = atob(str.replace(/-/g, '+').replace(/_/g, '/') + '==='.slice((str.length + 3) % 4)); const u = new Uint8Array(s.length); for (let i = 0; i < s.length; i++) u[i] = s.charCodeAt(i); return u; }
};
SH.pipe = async (bytes, stream) => { const w = stream.writable.getWriter(); w.write(bytes); w.close(); return new Uint8Array(await new Response(stream.readable).arrayBuffer()); };

/* copia della presentazione con le immagini incorporate (entro un budget di caratteri) */
SH.portable = async (deck, budget) => {
  const d = clone(deck); delete d.imgs; d.trashed = 0;
  let used = 0, omitted = 0;
  const toData = async (ref) => {
    if (!ref || /^(g:|data:|https?:)/.test(ref)) return ref;
    let data = null;
    try {
      if (ref.startsWith('a:')) { const r = await fetch(Img._url(ref)); data = await readFileAs(await r.blob()); }
      else data = Img.cache.get(ref) || await ST.loadImage(ref);
    } catch (e) { data = null; }
    if (!data || used + data.length > budget) { omitted++; return null; }
    used += data.length; return data;
  };
  for (const s of d.slides) {
    if (s.bg && s.bg.img) { const r = await toData(s.bg.img); if (r) s.bg.img = r; else s.bg = '#FFFFFF'; }
    for (const e of s.els) if (e.t === 'image' && e.src) { const r = await toData(e.src); e.src = r || 'g:blobs:0'; if (!r) e.rc = null, delete e.rc; }
  }
  return { deck: d, omitted };
};
SH.link = async (deck) => {
  const { deck: d, omitted } = await SH.portable(deck, 140000);
  let bytes = new TextEncoder().encode(JSON.stringify({ palco: 1, deck: d })), tag = 'r';
  try { if (window.CompressionStream) { bytes = await SH.pipe(bytes, new CompressionStream('deflate-raw')); tag = 'z'; } } catch (e) { }
  const base = location.href.split('#')[0];
  return { url: base + '#v=' + tag + SH.b64.enc(bytes), omitted };
};
SH.unpack = async (str) => {
  const tag = str[0]; let bytes = SH.b64.dec(str.slice(1));
  if (tag === 'z') bytes = await SH.pipe(bytes, new DecompressionStream('deflate-raw'));
  const o = JSON.parse(new TextDecoder().decode(bytes));
  return o.deck || o;
};
/* pagina web autonoma: la stessa app con la presentazione incorporata */
SH.html = async (deck) => {
  const { deck: d } = await SH.portable(deck, Infinity);
  const doc = document.documentElement.cloneNode(true);
  const app = doc.querySelector('#app'); app.replaceChildren(); app.className = '';
  doc.querySelectorAll('#toasts,#measure,.pop,.modal,.present,script[src],link[rel="manifest"]').forEach(n => n.remove());
  const main = [...doc.querySelectorAll('script')].find(s => !s.src && s.textContent.includes('const SH ='));
  const inj = document.createElement('script');
  inj.textContent = 'window.__PALCO_SHARED__=' + JSON.stringify({ palco: 1, deck: d }).replace(/</g, '\\u003c') + ';';
  main.before(inj);
  const t = doc.querySelector('title'); if (t) t.textContent = (deck.name || 'Presentazione') + ' · Palco';
  return new Blob(['<!doctype html>\n' + doc.outerHTML], { type: 'text/html' });
};

/* ---- finestra di condivisione ---- */
SH.hosted = () => /^https?:$/.test(location.protocol) && !window.claude;
SH.open = (deck) => {
  if (typeof ED !== 'undefined' && ED.active && ED.deck === deck && ED.editing) ED.endEdit();
  const linkBox = h('div.shlink', h('span.hint2', SH.hosted() ? 'Preparo il link…' : ''));
  const body = h('div.form');
  const m = UI.modal('Condividi “' + deck.name + '”', body, { cls: 'small wide2' });
  const copy = async (txt, btn) => {
    try { await navigator.clipboard.writeText(txt); toast('Link copiato', { icon: 'check', ms: 1500 }); }
    catch (e) { const inp = $('input', linkBox); if (inp) { inp.select(); toast('Premi Ctrl+C per copiare', { ms: 2200 }); } }
  };
  body.append(h('div.shsec', h('h3', 'Link di sola lettura'),
    SH.hosted() ? linkBox : h('p.hint2', 'Il link funziona quando Palco è pubblicato su un sito (per esempio Netlify). Qui puoi usare la pagina web qui sotto.')));
  if (SH.hosted()) SH.link(deck).then(({ url, omitted }) => {
    linkBox.innerHTML = '';
    const inp = h('input.inp', { value: url, readonly: true, 'aria-label': 'Link di condivisione', onfocus: e => e.target.select() });
    linkBox.append(...[h('div.row', { style: { flexWrap: 'nowrap' } }, inp, h('button.btn.primary', { onclick: () => copy(url) }, icn('link', 16), 'Copia')),
      navigator.share ? h('button.btn.sm', { onclick: () => navigator.share({ title: deck.name, url }).catch(() => { }) }, icn('share', 16), 'Condividi con…') : null,
      h('p.hint2', `Chi apre il link vede la presentazione e può salvarsene una copia. Tutto il contenuto sta nel link (${Math.round(url.length / 1000)} mila caratteri).` + (omitted ? ` ${omitted} ${omitted === 1 ? 'immagine è troppo grande e non è inclusa' : 'immagini sono troppo grandi e non sono incluse'}: per averle usa la pagina web.` : '') + (url.length > 12000 ? ' Il link è lungo: alcune app di messaggistica potrebbero tagliarlo.' : ''))].filter(Boolean));
  }).catch(e => { console.warn(e); linkBox.textContent = 'Non sono riuscito a creare il link.'; });
  body.append(h('div.shsec', h('h3', 'Pagina web autonoma'), h('p.hint2', 'Un unico file .html con tutta la presentazione e le immagini. Si apre con un doppio clic e si può mandare per email, mettere su un sito o in un drive.'),
    h('button.btn', { onclick: async (e) => { const b = e.currentTarget; b.disabled = true; try { const blob = await SH.html(deck); if (await ST.saveFile(EX.safeName(deck) + '.html', blob)) toast('Pagina web salvata'); } catch (er) { console.warn(er); toast('Non sono riuscito a creare la pagina', { type: 'err' }); } b.disabled = false; } }, icn('download', 16), 'Scarica la pagina web')),
    h('div.shsec', h('h3', 'Altri modi'), h('div.row', h('button.btn.sm', { onclick: () => { m.close(); PR.start(deck, 0); } }, icn('play', 16), 'Presenta ora'), h('button.btn.sm', { onclick: () => { m.close(); EX.pdf(deck); } }, icn('file', 16), 'PDF'), h('button.btn.sm', { onclick: () => { m.close(); EX.pptx(deck); } }, icn('presentation', 16), 'PowerPoint'))));
};

/* ---- modalità lettura (link o pagina autonoma) ---- */
SH.boot = async () => {
  let deck = null;
  try {
    if (window.__PALCO_SHARED__) deck = window.__PALCO_SHARED__.deck;
    else if (/^#v=/.test(location.hash)) deck = await SH.unpack(location.hash.slice(3));
  } catch (e) { console.warn('link non valido', e); }
  if (!deck || !Array.isArray(deck.slides)) return false;
  SH.viewer(deck); return true;
};
SH.viewer = async (deck) => {
  const root = $('#app'); root.className = 'viewer';
  const fonts = new Set(); deck.slides.forEach(s => s.els.forEach(e => e.f && fonts.add(e.f)));
  loadFonts([...fonts].map(f => [f, 400])).then(() => viewerCard());
  const viewerCard = () => {
    root.replaceChildren(h('div.vwrap',
      h('div.vlogo', h('span.lmark', { html: '<svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true"><rect width="32" height="32" rx="9" fill="#FFD25A"/><path d="M8 24V8h9a5 5 0 0 1 0 10h-4" fill="none" stroke="#2A2310" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/></svg>' }), h('b', 'Palco')),
      h('div.vcard', h('div.thwrap', { onclick: () => PR.start(deck, 0), style: { cursor: 'pointer' } }, R.thumb(deck.slides[0], deck)),
        h('h1', deck.name), h('p.hint2', `${deck.slides.length} ${deck.slides.length === 1 ? 'pagina' : 'pagine'}`),
        h('div.row', { style: { justifyContent: 'center' } }, h('button.btn.primary', { onclick: () => PR.start(deck, 0) }, icn('play', 18), 'Guarda la presentazione'),
          h('button.btn', { onclick: () => SH.keep(deck) }, icn('copy', 18), 'Salva una copia in Palco'))),
      h('p.hint2', 'Frecce o spazio per cambiare pagina, Esc per uscire.')));
  };
  viewerCard();
};
SH.keep = (deck) => {
  const copy = clone(deck); copy.id = uid('d_'); copy.created = Date.now(); copy.name = deck.name + ' (copia)'; copy.trashed = 0; copy.imgs = [];
  // le immagini incorporate diventano immagini della copia
  window.__PALCO_SHARED__ = null;
  if (location.hash) { try { history.replaceState(null, '', location.href.split('#')[0]); } catch (e) { } }
  startApp();
  ST.saveDeck(copy, true); TP.ensure(copy); App.render(); ED.open(copy);
};

/* ============ Importa un PDF e lo trasforma in una presentazione modificabile ============ */
const PDFI = { URL: 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/' };
PDFI.load = async () => {
  if (!(window.pdfjsLib && window.pdfjsWorker)) { await EX.loadScript(PDFI.URL + 'pdf.min.js'); await EX.loadScript(PDFI.URL + 'pdf.worker.min.js'); }
  window.pdfjsLib.GlobalWorkerOptions.workerSrc = PDFI.URL + 'pdf.worker.min.js';
};
const mmul = (m1, m2) => [m1[0] * m2[0] + m1[2] * m2[1], m1[1] * m2[0] + m1[3] * m2[1], m1[0] * m2[2] + m1[2] * m2[3], m1[1] * m2[2] + m1[3] * m2[3], m1[0] * m2[4] + m1[2] * m2[5] + m1[4], m1[1] * m2[4] + m1[3] * m2[5] + m1[5]];
const mpt = (m, x, y) => [m[0] * x + m[2] * y + m[4], m[1] * x + m[3] * y + m[5]];
const hex3 = (c) => Col.rgb2hex(c[0], c[1], c[2]);

/* ---- font: dal nome nel PDF a un font di Palco ---- */
PDFI.mapFont = (name, generic) => {
  const clean = String(name || '').replace(/^[A-Z]{6}\+/, ''), low = clean.toLowerCase().replace(/[\s_-]/g, '');
  let fam = null;
  for (const [f] of FONTS) if (low.includes(f.toLowerCase().replace(/\s/g, ''))) { fam = f; break; }
  if (!fam) {
    if (/arial|helvet|segoe|verdana|tahoma|liberation ?sans|dejavusans|roboto/.test(low)) fam = 'Inter';
    else if (/calibri|candara|corbel/.test(low)) fam = 'Nunito';
    else if (/cambria|times|georgia|garamond|palatino|bookman|serif|minion|liberationserif/.test(low)) fam = 'Lora';
    else if (/courier|consolas|mono|menlo/.test(low)) fam = 'JetBrains Mono';
    else if (/impact/.test(low)) fam = 'Bebas Neue';
    else if (/trebuchet/.test(low)) fam = 'Rubik';
    else if (/gothic|futura/.test(low)) fam = 'Montserrat';
    else fam = generic === 'serif' ? 'Lora' : generic === 'monospace' ? 'JetBrains Mono' : 'Inter';
  }
  return { f: fam, b: /bold|black|heavy|semibold|demi/.test(low), i: /italic|oblique/.test(low) };
};

/* ---- colore del testo: campiona la pagina disegnata ---- */
PDFI.sampleColor = (ctx, x, y, w, h) => {
  x = Math.max(0, Math.floor(x)); y = Math.max(0, Math.floor(y)); w = Math.max(1, Math.min(ctx.canvas.width - x, Math.ceil(w))); h = Math.max(1, Math.min(ctx.canvas.height - y, Math.ceil(h)));
  if (w < 1 || h < 1) return { c: '#111111', bg: '#FFFFFF' };
  let d; try { d = ctx.getImageData(x, y, w, h).data; } catch (e) { return { c: '#111111', bg: '#FFFFFF' }; }
  const step = Math.max(1, Math.floor(d.length / 4 / 4000)) * 4, hist = new Map();
  for (let i = 0; i < d.length; i += step) { const k = ((d[i] >> 3) << 10) | ((d[i + 1] >> 3) << 5) | (d[i + 2] >> 3); const o = hist.get(k); if (o) { o.n++; o.r += d[i]; o.g += d[i + 1]; o.b += d[i + 2]; } else hist.set(k, { n: 1, r: d[i], g: d[i + 1], b: d[i + 2] }); }
  const ent = [...hist.values()].sort((a, b) => b.n - a.n), avg = o => [o.r / o.n, o.g / o.n, o.b / o.n];
  const bg = avg(ent[0]);
  let best = null, bn = 0;
  ent.slice(1).forEach(o => { if (Col.dist(avg(o), bg) > 90) { // preferisce i colori più lontani dallo sfondo e frequenti
    const sc = o.n * (1 + Col.dist(avg(o), bg) / 255); if (sc > bn) { bn = sc; best = o; } } });
  const tc = best ? avg(best) : (Col.lum(hex3(bg)) > .5 ? [20, 24, 43] : [255, 255, 255]);
  return { c: hex3(tc), bg: hex3(bg) };
};

/* ---- immagini del PDF ---- */
PDFI.imgBlob = async (obj) => {
  const W = obj.width, H = obj.height, c = document.createElement('canvas'); c.width = W; c.height = H;
  const x = c.getContext('2d');
  if (obj.bitmap) x.drawImage(obj.bitmap, 0, 0);
  else if (obj.data) {
    const id = x.createImageData(W, H), o = id.data, s = obj.data, kind = obj.kind;
    if (kind === 3 || s.length === W * H * 4) o.set(s.subarray ? s.subarray(0, o.length) : s);
    else if (kind === 2 || s.length === W * H * 3) for (let i = 0, j = 0; i < W * H; i++, j += 3) { o[i * 4] = s[j]; o[i * 4 + 1] = s[j + 1]; o[i * 4 + 2] = s[j + 2]; o[i * 4 + 3] = 255; }
    else { const rb = (W + 7) >> 3; for (let r = 0; r < H; r++) for (let q = 0; q < W; q++) { const bit = (s[r * rb + (q >> 3)] >> (7 - (q & 7))) & 1, v = bit ? 255 : 0, i = (r * W + q) * 4; o[i] = o[i + 1] = o[i + 2] = v; o[i + 3] = 255; } }
    x.putImageData(id, 0, 0);
  } else return null;
  const k = Math.min(1, 2000 / Math.max(W, H));
  let src = c;
  if (k < 1) { src = document.createElement('canvas'); src.width = Math.round(W * k); src.height = Math.round(H * k); src.getContext('2d').drawImage(c, 0, 0, src.width, src.height); }
  // trasparenza?
  let alpha = false; try { const d = src.getContext('2d').getImageData(0, 0, src.width, src.height).data; for (let i = 3; i < d.length; i += 4 * 17) if (d[i] < 250) { alpha = true; break; } } catch (e) { }
  return new Promise(res => src.toBlob(res, alpha ? 'image/png' : 'image/jpeg', .9));
};

/* ---- una pagina ---- */
PDFI.page = async (doc, n, W, H, opt, stats) => {
  const OPS = pdfjsLib.OPS, page = await doc.getPage(n), vp = page.getViewport({ scale: 1 }), pw = vp.width, ph = vp.height;
  const k = Math.min(W / pw, H / ph), ox = (W - pw * k) / 2, oy = (H - ph * k) / 2;
  const els = [], notes = { gradient: false };
  const X = v => v * k + ox, Y = v => v * k + oy;
  /* pagina disegnata, per i colori */
  const rs = Math.min(1.6, 1600 / pw), vp2 = page.getViewport({ scale: rs });
  let cv = null, cx = null;
  const render = async () => {   // pagina disegnata: serve solo per ritagliare le maschere
    if (cv) return;
    cv = document.createElement('canvas'); cv.width = Math.ceil(vp2.width); cv.height = Math.ceil(vp2.height);
    cx = cv.getContext('2d', { willReadFrequently: true }); cx.fillStyle = '#FFFFFF'; cx.fillRect(0, 0, cv.width, cv.height);
    try { const rt = page.render({ canvasContext: cx, viewport: vp2 }); await Promise.race([rt.promise, sleep(7000)]); try { rt.cancel(); } catch (e) { } } catch (e) { console.warn('render', e); }
  };
  const ol = await page.getOperatorList(), fn = ol.fnArray, ar = ol.argsArray;
  const truns = []; let tm = [1, 0, 0, 1, 0, 0], tlm = [1, 0, 0, 1, 0, 0], lead = 0, fsz = 1;
  let st = { ctm: vp.transform.slice(), fill: [0, 0, 0], stroke: [0, 0, 0], lw: 1, fa: 1, sa: 1 }; const stack = []; let pend = null, bg = null;
  const snap = () => ({ ...st, ctm: st.ctm.slice() });
  const imgCache = PDFI._imgs = PDFI._imgs || new Map();
  const jobs = [];
  for (let i = 0; i < fn.length; i++) {
    const a = ar[i];
    switch (fn[i]) {
      case OPS.save: stack.push(snap()); break;
      case OPS.restore: if (stack.length) st = stack.pop(); break;
      case OPS.transform: st.ctm = mmul(st.ctm, a); break;
      case OPS.paintFormXObjectBegin: stack.push(snap()); if (a && a[0]) st.ctm = mmul(st.ctm, a[0]); break;
      case OPS.paintFormXObjectEnd: if (stack.length) st = stack.pop(); break;
      case OPS.setFillRGBColor: st.fill = a; break;
      case OPS.setStrokeRGBColor: st.stroke = a; break;
      case OPS.setLineWidth: st.lw = a[0]; break;
      case OPS.setGState: (a[0] || []).forEach(([key, v]) => { if (key === 'ca') st.fa = v; else if (key === 'CA') st.sa = v; else if (key === 'LW') st.lw = v; }); break;
      case OPS.beginText: tm = [1, 0, 0, 1, 0, 0]; tlm = [1, 0, 0, 1, 0, 0]; break;
      case OPS.setTextMatrix: tm = a.slice(); tlm = a.slice(); break;
      case OPS.moveText: tlm = mmul(tlm, [1, 0, 0, 1, a[0], a[1]]); tm = tlm.slice(); break;
      case OPS.setLeadingMoveText: lead = -a[1]; tlm = mmul(tlm, [1, 0, 0, 1, a[0], a[1]]); tm = tlm.slice(); break;
      case OPS.setLeading: lead = a[0]; break;
      case OPS.nextLine: tlm = mmul(tlm, [1, 0, 0, 1, 0, -lead]); tm = tlm.slice(); break;
      case OPS.setFont: fsz = a[1]; break;
      case OPS.showText: case OPS.showSpacedText: case OPS.nextLineShowText: case OPS.nextLineSetSpacingShowText: {
        let g = a[0];
        if (fn[i] === OPS.nextLineShowText) { tlm = mmul(tlm, [1, 0, 0, 1, 0, -lead]); tm = tlm.slice(); }
        if (fn[i] === OPS.nextLineSetSpacingShowText) { tlm = mmul(tlm, [1, 0, 0, 1, 0, -lead]); tm = tlm.slice(); g = a[2]; }
        const p = mpt(mmul(st.ctm, tm), 0, 0); truns.push({ x: p[0], y: p[1], c: hex3(st.fill) });
        (g || []).forEach(q => { const tx = typeof q === 'number' ? -q * fsz / 1000 : (q && q.width != null ? q.width * fsz / 1000 : 0); tm = mmul(tm, [1, 0, 0, 1, tx, 0]); });
