    c.txt(d.n || '01', .52, .1, .46, 460, { f: th.fd, wt: th.wd, c: th.ac, a: 'center', lh: 1, up: false, o: .85 });
    const t = c.title(d.title, .06, .3, .4, 86, { c: fg }); R.fitInto(t, c.Y(.34), 50); if (d.sub) c.txt(d.sub, .06, (t.y + t.h) / c.H + .03, .38, 30, { c: fg, o: .85 });
