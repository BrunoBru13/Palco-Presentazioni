    let x0 = 1e9, y0 = 1e9, x1 = -1e9, y1 = -1e9; pos.forEach(p => { x0 = Math.min(x0, p.x - D.w * .1); y0 = Math.min(y0, p.y - D.h * .1); x1 = Math.max(x1, p.x + D.w * 1.1); y1 = Math.max(y1, p.y + D.h * 1.1); });
