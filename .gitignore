        h('div.cph', 'Formato'), UI.seg([['n', '3'], ['nN', '3 / 12']], pn.fmt, v => { pn.fmt = v; draw(); upd(); }),
        h('label.chk', h('input', { type: 'checkbox', checked: pn.skip, onchange: e => { pn.skip = e.target.checked; upd(); } }), 'Non nella prima pagina'),
        UI.slider('Dimensione', 16, 60, pn.s || 28, 1, v => { pn.s = v; ED.renderStage(); }, () => { ED.renderStrip(); ED.commit(); }, v => v + ' px'));
    }
