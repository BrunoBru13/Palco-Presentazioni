};
PR.clearInk = () => { const c = $('.pr-ink', PR.root); if (c) c.getContext('2d').clearRect(0, 0, c.width, c.height); };
PR.renderPens = () => {
  let box = $('.pr-pens', PR.root);
  if (!PR.penOn) { box && box.remove(); return; }
  if (!box) { box = h('div.pr-pens'); PR.root.appendChild(box); }
  box.innerHTML = '';
  PR.PENS.forEach((p, i) => box.appendChild(h('button.pr-pen' + (i === PR.pen ? '.on' : ''), { title: p[3], 'aria-label': p[3], style: { background: p[0], opacity: p[2] < 1 ? .6 : 1 }, onclick: e => { e.stopPropagation(); PR.pen = i; PR.renderPens(); } })));
  box.appendChild(h('button.pr-pen.clr', { title: 'Cancella il disegno (X)', 'aria-label': 'Cancella il disegno', onclick: e => { e.stopPropagation(); PR.clearInk(); } }, icn('trash', 16)));
};

/* ---- vista relatore e riproduzione automatica ---- */
PR.toggleSpeaker = () => {
  PR.speaker = !PR.speaker; PR.root.classList.toggle('speaker', PR.speaker); $('#pr-s') && $('#pr-s').classList.toggle('on', PR.speaker);
  PR.fit(); PR.fxCanvas(); PR.renderSide();
  if (PR.speaker && !PR._clock) PR._clock = setInterval(() => { if (!PR.on) return clearInterval(PR._clock); PR.renderSide(true); }, 1000);
};
PR.t0 = Date.now();
PR.renderSide = (tickOnly) => {
  let side = $('.pr-side', PR.root);
  if (!PR.speaker) { side && side.remove(); return; }
  if (!side) { side = h('div.pr-side'); PR.root.appendChild(side); tickOnly = false; }
  const el = Math.floor((Date.now() - PR.t0) / 1000), fmt = s => String(Math.floor(s / 60)).padStart(2, '0') + ':' + String(s % 60).padStart(2, '0');
  const clockTxt = new Date().toLocaleTimeString('it-IT', { hour: '2-digit', minute: '2-digit' });
  if (tickOnly && $('.sd-el', side)) { $('.sd-el', side).textContent = fmt(el); $('.sd-clock', side).textContent = clockTxt; return; }
  const D = PR.deck, nxt = D.slides[PR.i + 1], cur = D.slides[PR.i];
  side.innerHTML = '';
  side.append(h('div.sd-top', h('div', h('small', 'Tempo trascorso'), h('b.sd-el', fmt(el))), h('div', h('small', 'Ora'), h('b.sd-clock', clockTxt)), h('div', h('small', 'Pagina'), h('b', `${PR.i + 1}/${D.slides.length}`))),
    h('div.sd-lab', 'Prossima pagina'), nxt ? h('div.sd-next', R.thumb(nxt, D)) : h('div.sd-next.end', 'Ultima pagina'),
    h('div.sd-lab', 'Note'), h('div.sd-notes', cur.notes || 'Nessuna nota per questa pagina.'));
};
PR.auto = 0;
PR.autoNext = () => {
  clearTimeout(PR._at); if (!PR.auto || !PR.on) return;
  PR._at = setTimeout(() => { if (!PR.on) return; if (PR.i >= PR.deck.slides.length - 1) { PR.go(0); } else PR.go(PR.i + 1); }, PR.auto * 1000);
};
PR.cycleAuto = () => { PR.auto = ({ 0: 5, 5: 10, 10: 20, 20: 0 })[PR.auto]; $('#pr-a') && $('#pr-a').classList.toggle('on', !!PR.auto); PR.toastMsg(PR.auto ? `Cambio pagina ogni ${PR.auto} secondi` : 'Riproduzione automatica disattivata'); PR.autoNext(); };
PR.help = () => {
  let h2 = $('.pr-help', PR.root); if (h2) { h2.remove(); return; }
  const rows = [['C', 'Coriandoli'], ['F', 'Fuochi d’artificio'], ['O', 'Bolle'], ['D', 'Rullo di tamburi'], ['B', 'Sfoca lo schermo'], ['Q', 'Schermo nero'], ['P', 'Penna e evidenziatore'], ['X', 'Cancella il disegno'], ['L', 'Puntatore laser'], ['N', 'Note'], ['S', 'Vista relatore'], ['A', 'Cambio automatico'], ['1–9', 'Timer in minuti (0 lo ferma)'], ['Esc', 'Esci']];
  PR.root.appendChild(h('div.pr-help', { onclick: e => { e.stopPropagation(); e.currentTarget.remove(); } }, h('h3', 'Magie della presentazione'), h('div.hgrid', rows.map(([k, l]) => h('div.hr', h('kbd', k), h('span', l))))));
};

/* ---- integrazione ---- */
const _prStart = PR.start;
PR.start = (deck, i = 0) => {
  if (PR.on) return;
  PR.speaker = false; PR.penOn = false; PR.auto = 0; PR.parts = []; PR.t0 = Date.now(); PR._ac = PR._ac || null;
  _prStart(deck, i);
  const bar = $('.pr-bar', PR.root), exit = bar.lastChild;
  const btn = (id, ic, title, fn) => h('button.pbtn', { id, title, 'aria-label': title, onclick: e => { e.stopPropagation(); fn(e); } }, icn(ic, 20));
  bar.insertBefore(btn('pr-m', 'sparkles', 'Magia', e => { const a = e.currentTarget; UI.menu(a, [{ label: 'Coriandoli', icon: 'sparkles', key: 'C', onclick: () => PR.confetti() }, { label: 'Fuochi d’artificio', icon: 'zap', key: 'F', onclick: PR.fireworks }, { label: 'Bolle', icon: 'drop', key: 'O', onclick: PR.bubbles }, { label: 'Rullo di tamburi', icon: 'vol', key: 'D', onclick: PR.drumroll }, { sep: 1 }, { label: 'Sfoca lo schermo', icon: 'eye', key: 'B', onclick: () => PR.toggleBlur() }, { label: 'Schermo nero', icon: 'eyeOff', key: 'Q', onclick: () => PR.toggleBlack() }, { sep: 1 }, ...[1, 3, 5, 10].map(m => ({ label: `Timer ${m} min`, icon: 'clock', onclick: () => PR.timer(m) })), { label: 'Ferma il timer', icon: 'x', onclick: () => PR.timer(0) }]); }), exit);
  bar.insertBefore(btn('pr-p', 'pen', 'Penna (P)', () => PR.togglePen()), exit);
  bar.insertBefore(btn('pr-s', 'presentation', 'Vista relatore (S)', PR.toggleSpeaker), exit);
  bar.insertBefore(btn('pr-a', 'restore', 'Cambio automatico (A)', PR.cycleAuto), exit);
  bar.insertBefore(btn('pr-h', 'info', 'Scorciatoie (?)', PR.help), exit);
  PR.fxCanvas();
};
PR.toggleBlur = () => { PR.root.classList.toggle('blurred'); };
PR.toggleBlack = () => { PR.root.classList.toggle('blacked'); };
const _prShow = PR.show;
PR.show = (i, dir, first) => { _prShow(i, dir, first); PR.clearInk(); PR.renderSide(); PR.autoNext(); };
const _prKey = PR.onKey;
PR.onKey = (e) => {
  if (!PR.on || e.ctrlKey || e.metaKey || e.altKey) return _prKey(e);
  const k = e.key.toLowerCase(), stop = () => { e.preventDefault(); e.stopPropagation(); };
  const map = { c: () => PR.confetti(), f: PR.fireworks, o: PR.bubbles, d: PR.drumroll, b: PR.toggleBlur, q: PR.toggleBlack, p: () => PR.togglePen(), x: PR.clearInk, s: PR.toggleSpeaker, a: PR.cycleAuto, '?': PR.help, '/': PR.help };
  if (map[k]) { stop(); map[k](); PR.wake(); return; }
  if (/^[0-9]$/.test(k)) { stop(); PR.timer(+k); return; }
  _prKey(e);
};
const _prStop = PR.stop;
PR.stop = () => { clearInterval(PR._tm); clearTimeout(PR._at); clearInterval(PR._clock); PR._clock = null; PR.parts = []; _prStop(); };

/* ============ Moduli: risposte in presentazione, risultato finale ed esportazione ============ */
PR.qs = {};
PR.quizzes = () => { const out = []; PR.deck.slides.forEach(s => EX.flat(s.els).forEach(e => { if (e.t === 'quiz') out.push({ key: s.id + ':' + e.id, e }); })); return out; };
PR.quizStats = () => { const all = PR.quizzes(), done = all.filter(q => PR.qs[q.key] && PR.qs[q.key].done); return { total: all.length, answered: done.length, correct: done.filter(q => PR.qs[q.key].ok).length }; };
PR.quizBadge = () => {
  const s = PR.quizStats(); let b = $('.pr-qb', PR.root);
  if (!s.answered) { b && b.remove(); return; }
  if (!b) { b = h('span.pr-qb'); $('.pr-count', PR.root).after(b); }
  b.textContent = `Quiz ${s.correct}/${s.answered} ✓`;
};
PR.wireQuiz = (node, slide) => {
  const e = EX.flat(slide.els).find(x => x.id === node.dataset.id); if (!e) return;
  const key = slide.id + ':' + e.id, st = PR.qs[key] = PR.qs[key] || { sel: [], done: false, ok: false };
  const qb = $$('.qb', node), msg = $('.qmsg', node), chk = $('.qchk', node), re = $('.qre', node), multi = e.mode === 'multi';
  const paint = () => {
    qb.forEach((b, i) => {
      b.classList.remove('sel', 'right', 'wrong', 'dim');
      const isOk = e.ok.includes(i), picked = st.sel.includes(i);
      if (st.done) b.classList.add(isOk ? 'right' : picked ? 'wrong' : 'dim'); else if (picked) b.classList.add('sel');
    });
    chk.hidden = !(multi && !st.done && st.sel.length); re.hidden = !st.done;
    msg.textContent = st.done ? (st.ok ? e.okm : e.kom) : (multi ? 'Scegli tutte le risposte giuste' : '');
    msg.style.color = st.done ? (st.ok ? e.cl.ok : e.cl.ko) : '';
  };
  const evaluate = () => {
    st.ok = [...st.sel].sort().join() === [...e.ok].sort().join(); st.done = true; paint(); PR.quizBadge();
    if (st.ok) { PR.chime(); PR.confetti(false); } else PR.pop();
  };
  qb.forEach((b, i) => b.addEventListener('click', ev => {
    ev.stopPropagation(); if (st.done) return;
    if (multi) { st.sel = st.sel.includes(i) ? st.sel.filter(x => x !== i) : [...st.sel, i]; paint(); } else { st.sel = [i]; evaluate(); }
  }));
  chk.addEventListener('click', ev => { ev.stopPropagation(); evaluate(); });
  re.addEventListener('click', ev => { ev.stopPropagation(); st.sel = []; st.done = false; st.ok = false; paint(); PR.quizBadge(); });
  node.addEventListener('click', ev => ev.stopPropagation());
  paint();
};
PR._show1 = PR.show;
PR.show = (i, dir, first) => {
  PR._show1(i, dir, first);
  const s = PR.deck.slides[i];
  $$('.el-quiz', PR.cur).forEach(n => { if (!n._qw) { n._qw = 1; PR.wireQuiz(n, s); } });
  PR.quizBadge();
};
PR._start1 = PR.start;
PR.start = (deck, i = 0) => { if (!PR.on) PR.qs = {}; PR._start1(deck, i); };
PR.showResult = () => {
  const s = PR.quizStats(), all = s.correct === s.total && s.total > 0;
  const box = h('div.pr-result', { onclick: ev => ev.stopPropagation() }, h('h2', all ? 'Perfetto!' : 'Risultato del quiz'), h('div.big', `${s.correct} su ${s.total}`),
    h('p', s.answered < s.total ? `Hai risposto a ${s.answered} domande su ${s.total}.` : all ? 'Tutte le risposte sono giuste.' : 'Puoi tornare indietro e riprovare le domande sbagliate.'),
    h('div.row', { style: { justifyContent: 'center' } }, h('button.btn', { onclick: () => box.remove() }, 'Rivedi le pagine'), h('button.btn.primary', { onclick: () => PR.stop() }, 'Esci')));
  PR.root.appendChild(box); if (all) { PR.confetti(); PR.fireworks(); }
};
PR._next1 = PR.next;
PR.next = () => {
  if (PR.busy) return;
  if (PR.i >= PR.deck.slides.length - 1 && PR.quizStats().answered > 0) { if (!$('.pr-result', PR.root)) PR.showResult(); return; }
  PR._next1();
};

/* ---- esportazione: il modulo diventa una pagina statica ---- */
EX.drawQuiz = (ctx, e) => {
  const g = QZ.geom(e), c = e.cl, fs = e.fs, rad = e.rad, orad = Math.round(rad * .6);
  ctx.save();
  ctx.translate(e.x + e.w / 2, e.y + e.h / 2); if (e.r) ctx.rotate(e.r * Math.PI / 180); ctx.translate(-e.w / 2, -g.h / 2);
  if (e.o != null && e.o < 1) ctx.globalAlpha = e.o;
  const rr = (x, y, w, h, r) => { ctx.beginPath(); if (ctx.roundRect) ctx.roundRect(x, y, w, h, r); else ctx.rect(x, y, w, h); };
  rr(0, 0, e.w, g.h, rad); ctx.fillStyle = c.bg; ctx.fill();
  if (c.bd) { rr(2, 2, e.w - 4, g.h - 4, rad); ctx.strokeStyle = c.bd; ctx.lineWidth = 4; ctx.stroke(); }
  ctx.textBaseline = 'middle'; ctx.textAlign = 'left';
  ctx.font = `700 ${g.qfs}px ${fontStack(e.f)}`; ctx.fillStyle = c.qc;
  g.lines.forEach((ln, i) => ctx.fillText(ln, g.pad, g.pad + (i + .5) * g.qfs * 1.25));
  const y0 = g.pad + g.qh + g.gap, lbox = fs * .85 * 1.6;
  e.opts.forEach((t, i) => {
    const y = y0 + i * (g.oh + g.og);
    rr(g.pad, y, g.iw, g.oh, orad); ctx.fillStyle = c.ob; ctx.fill();
    if (c.bd) { rr(g.pad + 1.5, y + 1.5, g.iw - 3, g.oh - 3, orad); ctx.strokeStyle = c.bd; ctx.lineWidth = 3; ctx.stroke(); }
    const lx = g.pad + fs * .8 + 3, ly = y + (g.oh - lbox) / 2;
    rr(lx, ly, lbox, lbox, lbox * .28); ctx.fillStyle = c.ac; ctx.fill();
    ctx.fillStyle = Col.readable(c.ac); ctx.font = `800 ${fs * .85}px ${fontStack(e.f)}`; ctx.textAlign = 'center'; ctx.fillText(QZ.LET[i], lx + lbox / 2, ly + lbox / 2 + 1); ctx.textAlign = 'left';
    ctx.fillStyle = c.ot; ctx.font = `600 ${fs}px ${fontStack(e.f)}`; ctx.fillText(t, lx + lbox + fs * .6, y + g.oh / 2 + 1, g.iw - lbox - fs * 2.6);
  });
  ctx.restore();
};
EX._de1 = EX.drawEl;
EX.drawEl = (ctx, e) => e.t === 'quiz' ? EX.drawQuiz(ctx, e) : EX._de1(ctx, e);

/* ============ Due schermi: console del relatore sul computer, presentazione sul secondo schermo (TV, LIM, proiettore) ============ */
const PRC = { on: false, win: null };
PRC.canPopup = () => !window.claude && /^(https?|file):$/.test(location.protocol);
PRC.msg = (t, o = {}) => { try { if (PRC.win && !PRC.win.closed) PRC.win.postMessage({ palco: 1, t, ...o }, '*'); } catch (e) { } };
const fmtT = s => { s = Math.max(0, Math.floor(s)); const m = Math.floor(s / 60); return (m >= 60 ? String(Math.floor(m / 60)) + ':' + String(m % 60).padStart(2, '0') : String(m).padStart(2, '0')) + ':' + String(s % 60).padStart(2, '0'); };

/* ---- apertura della finestra del pubblico (dentro il clic dell'utente) ---- */
PRC.open = () => {
  const url = location.href.split('#')[0] + '#audience';
  const w = window.open(url, 'palco-pubblico', 'popup=yes,width=1280,height=720');
  if (!w) return false;
  PRC.win = w; PRC.placed = false;
  // se c'è un secondo schermo, porta la finestra lì
  if (window.getScreenDetails) {
    window.getScreenDetails().then(sd => {
      const ext = sd.screens.find(s => s !== sd.currentScreen && !s.isInternal) || sd.screens.find(s => s !== sd.currentScreen);
      if (ext && PRC.win && !PRC.win.closed) { PRC.win.moveTo(ext.availLeft, ext.availTop); PRC.win.resizeTo(ext.availWidth, ext.availHeight); PRC.placed = true; PRC.render(); }
    }).catch(() => { });
  }
  return true;
};
PRC.start = (deck, i = 0) => {
  if (PRC.on || PR.on) return;
  if (typeof ED !== 'undefined' && ED.active && ED.editing) ED.endEdit();
  PRC.deck = deck; PRC.i = clamp(i, 0, deck.slides.length - 1); PRC.t0 = Date.now(); PRC.acc = 0; PRC.paused = false; PRC.target = 0; PRC.laser = false; PRC.blur = false; PRC.black = false;
  if (!PRC.open()) { toast('Il browser ha bloccato la seconda finestra: consenti i popup per questo sito. Uso la vista unica.', { ms: 5000 }); PR.start(deck, i); PR.toggleSpeaker(); return; }
  PRC.on = true; PRC.build();
  document.addEventListener('keydown', PRC.onKey, true); window.addEventListener('message', PRC.onMsg);
  PRC._tick = setInterval(PRC.tick, 500);
  PRC.render();
};
PRC.stop = (closeWin = true) => {
  if (!PRC.on) return; PRC.on = false;
  clearInterval(PRC._tick); document.removeEventListener('keydown', PRC.onKey, true); window.removeEventListener('message', PRC.onMsg);
  if (closeWin) { PRC.msg('quit'); try { PRC.win && PRC.win.close(); } catch (e) { } }
  PRC.win = null; $('#prc') && $('#prc').remove();
  if (typeof ED !== 'undefined' && ED.active) ED.goto(PRC.i);
};

/* ---- messaggi dalla finestra del pubblico ---- */
PRC.onMsg = async (e) => {
  const m = e.data; if (!m || !m.palco || e.source !== PRC.win) return;
  if (m.t === 'ready') {
    const imgs = {}, refs = new Set();
    const scan = els => els.forEach(x => { if (x.t === 'image' && x.src) refs.add(x.src); if (x.t === 'group') scan(x.els); });
    PRC.deck.slides.forEach(s => { scan(s.els); if (s.bg && s.bg.img) refs.add(s.bg.img); });
    for (const r of refs) if (/^(d|m):/.test(r)) { const d = Img.cache.get(r) || await ST.loadImage(r); if (d) imgs[r] = d; }
    PRC.msg('init', { deck: PRC.deck, i: PRC.i, imgs });
    PRC.render();
  } else if (m.t === 'at' && typeof m.i === 'number' && m.i !== PRC.i) PRC.go(m.i, false);
};

/* ---- navigazione e comandi ---- */
PRC.go = (i, send = true) => {
  if (i < 0 || i >= PRC.deck.slides.length || i === PRC.i) return;
  PRC.i = i; if (send) PRC.msg('go', { i }); if (typeof VOICE !== 'undefined') { VOICE.silence(); $('.micb.spk') && $('.micb.spk').classList.remove('rec'); } PRC.render();
};
PRC.next = () => { if (PRC.i >= PRC.deck.slides.length - 1) { toast('È l’ultima pagina: premi Termina per uscire.', { ms: 2200 }); return; } PRC.go(PRC.i + 1); };
PRC.fx = (name) => PRC.msg('fx', { name });
PRC.toggle = (k) => { PRC[k] = !PRC[k]; PRC.msg('toggle', { k }); PRC.render(); };
PRC.setLaser = (on) => { PRC.laser = on; PRC.msg('laser', { on }); PRC.render(); };
PRC.onKey = (e) => {
  if (!PRC.on || e.ctrlKey || e.metaKey || e.altKey || $('.modal') || /^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName)) return;
  const k = e.key, kl = k.toLowerCase(), stop = () => { e.preventDefault(); e.stopPropagation(); };
  if (k === 'Escape') { if ($('.pop')) return; stop(); PRC.stop(); }
  else if (['ArrowRight', 'ArrowDown', 'PageDown', ' ', 'Enter'].includes(k)) { stop(); PRC.next(); }
  else if (['ArrowLeft', 'ArrowUp', 'PageUp', 'Backspace'].includes(k)) { stop(); PRC.go(PRC.i - 1); }
  else if (k === 'Home') { stop(); PRC.go(0); } else if (k === 'End') { stop(); PRC.go(PRC.deck.slides.length - 1); }
  else if (kl === 'l') { stop(); PRC.setLaser(!PRC.laser); }
  else if (kl === 'b') { stop(); PRC.toggle('blur'); } else if (kl === 'q') { stop(); PRC.toggle('black'); }
  else if (kl === 'c') { stop(); PRC.fx('confetti'); } else if (kl === 'f') { stop(); PRC.fx('fireworks'); } else if (kl === 'o') { stop(); PRC.fx('bubbles'); } else if (kl === 'd') { stop(); PRC.fx('drumroll'); }
  else if (/^[0-9]$/.test(k)) { stop(); PRC.msg('timer', { min: +k }); toast(+k ? `Timer sullo schermo del pubblico: ${k} min` : 'Timer fermato', { ms: 1500 }); }
};

/* ---- interfaccia della console ---- */
PRC.build = () => {
  const root = h('div#prc.prc', { tabindex: '-1' });
  root.style.setProperty('--ar', PRC.deck.w / PRC.deck.h);
  root.append(
    h('header.prc-top',
      h('div.prc-title', h('b', PRC.deck.name), h('span#prc-status.prc-st')),
      h('div.prc-prog', h('div.prc-pn', h('b#prc-pg'), h('small', 'pagine')), h('div.prc-bar', h('i#prc-bar'))),
      h('div.prc-tim', h('div', h('small', 'Tempo'), h('b#prc-el', '00:00')), h('div#prc-left', { hidden: true }, h('small', 'Resta'), h('b#prc-rem', '')),
        h('button.prc-ib', { title: 'Pausa o riprendi il cronometro', 'aria-label': 'Pausa cronometro', onclick: () => { PRC.togglePause(); } }, icn('clock', 18)),
        h('button.prc-ib', { title: 'Azzera il cronometro', 'aria-label': 'Azzera cronometro', onclick: () => { PRC.t0 = Date.now(); PRC.acc = 0; PRC.paused = false; PRC.tick(); } }, icn('restore', 18)),
        h('button.prc-ib', { title: 'Durata prevista', 'aria-label': 'Durata prevista', onclick: e => UI.menu(e.currentTarget, [{ label: 'Nessun limite', onclick: () => { PRC.target = 0; PRC.tick(); } }, ...[5, 10, 15, 20, 30, 45, 60].map(m => ({ label: m + ' minuti', on: PRC.target === m, onclick: () => { PRC.target = m; PRC.tick(); } }))], { align: 'right' }) }, icn('sliders', 18))),
      h('div.prc-clk', h('small', 'Ora'), h('b#prc-clock', '')),
      h('button.btn.prc-end', { onclick: () => PRC.stop() }, icn('x', 18), 'Termina')),
    h('div.prc-main',
      h('section.prc-lcol', h('div.prc-lab', 'Ora sullo schermo del pubblico'), h('div#prc-cur.prc-cur'), h('div.prc-ctl',
        h('button.prc-b', { onclick: () => PRC.go(PRC.i - 1), 'aria-label': 'Pagina precedente' }, icn('chevL', 22), 'Indietro'),
        h('button.prc-b.main', { onclick: () => PRC.next(), 'aria-label': 'Pagina successiva' }, 'Avanti', icn('chevR', 22)),
        h('span.grow'),
        h('button.prc-b#prc-laser', { onclick: () => PRC.setLaser(!PRC.laser), title: 'Laser sul pubblico: muovi il mouse sulla pagina (L)' }, icn('pointer', 18), 'Laser'),
        h('button.prc-b#prc-blur', { onclick: () => PRC.toggle('blur'), title: 'Sfoca lo schermo (B)' }, icn('eye', 18), 'Sfoca'),
        h('button.prc-b#prc-black', { onclick: () => PRC.toggle('black'), title: 'Schermo nero (Q)' }, icn('eyeOff', 18), 'Nero'),
        h('button.prc-b', { onclick: e => UI.menu(e.currentTarget, [{ label: 'Coriandoli', icon: 'sparkles', key: 'C', onclick: () => PRC.fx('confetti') }, { label: 'Fuochi d’artificio', icon: 'zap', key: 'F', onclick: () => PRC.fx('fireworks') }, { label: 'Bolle', icon: 'drop', key: 'O', onclick: () => PRC.fx('bubbles') }, { label: 'Rullo di tamburi', icon: 'vol', key: 'D', onclick: () => PRC.fx('drumroll') }, { sep: 1 }, ...[1, 3, 5, 10].map(m => ({ label: `Timer ${m} min sul pubblico`, icon: 'clock', onclick: () => PRC.msg('timer', { min: m }) })), { label: 'Ferma il timer', icon: 'x', onclick: () => PRC.msg('timer', { min: 0 }) }], { align: 'right' }) }, icn('sparkles', 18), 'Magia'))),
      h('aside.prc-rcol', h('div.prc-lab', 'Prossima pagina'), h('div#prc-next.prc-next'), h('div.prc-lab.prc-labrow', 'Note', window.speechSynthesis ? VOICE.listenBtn(() => PRC.deck.slides[PRC.i].notes) : null), h('div#prc-notes.prc-notes'))),
    h('footer.prc-strip#prc-strip'));
  root.addEventListener('mousemove', e => { if (!PRC.laser) return; const c = $('#prc-cur'); if (!c) return; const r = c.getBoundingClientRect(); if (e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom) { const x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height; PRC.msg('laser', { on: true, x, y }); const d = $('.prc-dot', c); if (d) { d.style.left = x * 100 + '%'; d.style.top = y * 100 + '%'; } } });
  document.body.appendChild(root); root.focus();
};
PRC.togglePause = () => { if (PRC.paused) { PRC.t0 = Date.now(); PRC.paused = false; } else { PRC.acc += (Date.now() - PRC.t0) / 1000; PRC.paused = true; } PRC.tick(); };
PRC.elapsed = () => PRC.acc + (PRC.paused ? 0 : (Date.now() - PRC.t0) / 1000);
PRC.tick = () => {
  if (!PRC.on) return;
  const el = PRC.elapsed(); const n = $('#prc-el'); if (!n) return;
  n.textContent = fmtT(el) + (PRC.paused ? ' ⏸' : '');
  const c = $('#prc-clock'); if (c) c.textContent = new Date().toLocaleTimeString('it-IT', { hour: '2-digit', minute: '2-digit' });
  const left = $('#prc-left'), rem = $('#prc-rem');
  if (PRC.target) { left.hidden = false; const r = PRC.target * 60 - el; rem.textContent = (r < 0 ? '+' : '') + fmtT(Math.abs(r)); rem.className = r < 0 ? 'over' : r < 120 ? 'warn' : ''; } else left.hidden = true;
  if (PRC.win && PRC.win.closed && !PRC._closedShown) { PRC._closedShown = true; PRC.render(); } else if (PRC.win && !PRC.win.closed && PRC._closedShown) { PRC._closedShown = false; PRC.render(); }
};
PRC.render = () => {
  if (!PRC.on || !$('#prc')) return;
  const D = PRC.deck, N = D.slides.length, s = D.slides[PRC.i], nx = D.slides[PRC.i + 1];
  $('#prc-pg').textContent = `${PRC.i + 1} di ${N}`; $('#prc-bar').style.width = Math.round((PRC.i + 1) / N * 100) + '%';
  const cur = $('#prc-cur'); cur.innerHTML = ''; cur.classList.toggle('lz', PRC.laser); cur.append(R.thumb(s, D, { idx: PRC.i }), h('i.prc-dot', { hidden: !PRC.laser }));
  const nxt = $('#prc-next'); nxt.innerHTML = ''; nxt.className = 'prc-next' + (nx ? '' : ' end'); nx ? nxt.append(R.thumb(nx, D, { idx: PRC.i + 1 })) : (nxt.textContent = 'Ultima pagina');
  const nt = $('#prc-notes'); nt.textContent = s.notes || 'Nessuna nota per questa pagina.'; nt.classList.toggle('empty', !s.notes);
  const st = $('#prc-strip');
  if (!st.firstChild) D.slides.forEach((sl, i) => st.appendChild(h('button.prc-t', { 'aria-label': 'Vai alla pagina ' + (i + 1), onclick: () => PRC.go(i) }, R.thumb(sl, D, { idx: i }), h('span', String(i + 1)))));
  $$('.prc-t', st).forEach((b, i) => b.classList.toggle('on', i === PRC.i));
  const on = $('.prc-t.on', st); if (on) st.scrollTo({ left: on.offsetLeft - st.clientWidth / 2 + on.offsetWidth / 2, behavior: 'smooth' });
  $('#prc-laser').classList.toggle('on', PRC.laser); $('#prc-blur').classList.toggle('on', PRC.blur); $('#prc-black').classList.toggle('on', PRC.black);
  const stt = $('#prc-status'), closed = PRC.win && PRC.win.closed;
  stt.innerHTML = '';
  if (closed) stt.append(h('span.warn', 'Finestra del pubblico chiusa'), h('button.link', { onclick: () => { if (PRC.open()) { PRC._closedShown = false; } } }, 'Riapri'));
  else stt.append(...[h('span', PRC.placed ? 'Pubblico: secondo schermo' : 'Pubblico: finestra aperta'), PRC.placed ? null : h('small', 'Trascina la finestra sul secondo schermo e premi “Schermo intero”'), h('button.link', { onclick: () => { try { PRC.win.focus(); } catch (e) { } } }, 'Porta davanti')].filter(Boolean));
};

/* ================= finestra del pubblico ================= */
const AUD = {};
AUD.boot = () => {
  document.body.classList.add('aud');
  const root = $('#app'); root.className = 'audience'; root.replaceChildren(h('div.aud-wait', h('b', 'Palco'), h('span', 'In attesa della presentazione…')));
  window.addEventListener('message', AUD.onMsg);
  const ask = () => AUD.post({ t: 'ready' });
  ask(); AUD._ask = setInterval(() => { if (AUD.ready) return clearInterval(AUD._ask); ask(); }, 1200);
  setInterval(() => { const p = AUD.peer(); if (!p || p.closed) window.close(); }, 2000);
  window.addEventListener('beforeunload', () => AUD.post({ t: 'closed' }));
};
/* chi comanda la finestra: quella che l'ha aperta (o la pagina che la incorpora) */
AUD.peer = () => window.opener || (window.parent !== window ? window.parent : null);
AUD.post = (m) => { try { const p = AUD.peer(); p && p.postMessage({ palco: 1, ...m }, '*'); } catch (e) { } };
AUD.fsPill = () => {
  const pill = h('button.aud-fs', { hidden: !!document.fullscreenElement, onclick: e => { e.stopPropagation(); try { PR.root.requestFullscreen(); } catch (er) { } } }, icn('maximize', 18), 'Schermo intero');
  PR.root.appendChild(pill);
  PR.root.addEventListener('dblclick', () => { try { document.fullscreenElement ? document.exitFullscreen() : PR.root.requestFullscreen(); } catch (er) { } });
};
AUD.onMsg = async (e) => {
  const m = e.data; if (!m || !m.palco || e.source !== AUD.peer()) return;
  if (m.t === 'init') {
    AUD.ready = true; Object.entries(m.imgs || {}).forEach(([k, v]) => Img.cache.set(k, v));
    const fonts = new Set(); m.deck.slides.forEach(s => s.els.forEach(x => x.f && fonts.add(x.f))); await loadFonts([...fonts].map(f => [f, 400]));
    if (PR.on) { PR.deck = m.deck; AUD.goTo(m.i); return; }
    AUD.known = m.i; PR.audience = true; PR.start(m.deck, m.i); PR.root.classList.add('aud'); AUD.fsPill();
  } else if (m.t === 'go') AUD.goTo(m.i);
  else if (m.t === 'fx') { if (PR.on && typeof PR[m.name] === 'function') PR[m.name](); }
  else if (m.t === 'toggle') { if (PR.on) { m.k === 'blur' ? PR.toggleBlur() : PR.toggleBlack(); } }
  else if (m.t === 'timer') { if (PR.on) PR.timer(m.min); }
  else if (m.t === 'laser') { if (!PR.on) return; if (m.on) { PR.root.classList.add('laser'); if (m.x != null) { const l = $('.pr-laser', PR.root), k = PR.scale(), D = PR.deck, w = D.w * k, hh = D.h * k; l.style.transform = `translate(${(innerWidth - w) / 2 + m.x * w}px,${(innerHeight - hh) / 2 + m.y * hh}px)`; } } else PR.root.classList.remove('laser'); }
  else if (m.t === 'quit') window.close();
};
/* il relatore comanda: l'ultima richiesta vince, anche se una transizione è ancora in corso */
AUD.goTo = (i) => {
  AUD.want = i; AUD.known = i; clearTimeout(AUD._gt);
  const f = () => { if (!PR.on) return; if (PR.busy) { AUD._gt = setTimeout(f, 100); return; } PR.go(AUD.want); };
  f();
};
/* se si cambia pagina dalla finestra del pubblico (frecce, scorrimento), avvisa il computer */
const prShowA = PR.show;
PR.show = (i, dir, first) => { prShowA(i, dir, first); if (PR.audience && i !== AUD.known) { AUD.known = i; AUD.post({ t: 'at', i }); } };
/* il pannello del relatore non deve mai comparire sullo schermo del pubblico */
const prSpkA = PR.toggleSpeaker;
PR.toggleSpeaker = () => { if (!PR.audience) prSpkA(); };
/* nella finestra del pubblico il clic non avanza (lo fa il relatore), le frecce sì; uscire dallo schermo intero non chiude la finestra */
PR.onFs = () => {
  if (PR.audience) { const pill = $('.aud-fs', PR.root); if (pill) pill.hidden = !!document.fullscreenElement; return; }
  if (PR.on && !document.fullscreenElement && PR._wasFs) PR.stop();
  if (document.fullscreenElement) PR._wasFs = true;
};
AUD.onKey = (e) => {
  if (!PR.audience || !PR.on || e.ctrlKey || e.metaKey || e.altKey) return;
  if (['ArrowRight', 'ArrowDown', 'PageDown', ' ', 'Enter'].includes(e.key)) { e.preventDefault(); if (!PR.busy) PR.go(PR.i + 1); }
};
document.addEventListener('keydown', AUD.onKey, true);
const prNextA = PR.next;
PR.next = () => { if (PR.audience) return; prNextA(); };
const prStopA = PR.stop;
PR.stop = () => { if (PR.audience) { window.close(); return; } prStopA(); };

/* ---- punto d'ingresso unico per presentare ---- */
ED.present = (mode, o = {}) => {
  if (o.train) REH.arm = true;
  const D = ED.deck, i = ED.si, ext = !!(window.screen && window.screen.isExtended);
  if (!mode) mode = ext && PRC.canPopup() ? 'dual' : 'single';
  if (mode === 'dual' && !PRC.canPopup()) { toast('Per usare due schermi apri Palco come file o su un sito: qui il browser non permette la seconda finestra.', { ms: 5200 }); mode = 'single'; }
  if (mode === 'dual') { if (ext) toast('Secondo schermo rilevato: la presentazione va lì, le note restano qui.', { ms: 3000 }); PRC.start(D, i); } else PR.start(D, i);
};
ED.presentMenu = (anchor) => UI.menu(anchor, [
  { head: 'Presenta' },
  { label: 'A schermo intero su questo schermo', icon: 'play', key: 'F5', onclick: () => ED.present('single') },
  { label: 'Su due schermi: relatore qui, pubblico sull’altro', icon: 'presentation', key: 'Maiusc+F5', onclick: () => ED.present('dual') },
  { label: 'Allenati: presenta e ricevi il rapporto dei tempi', icon: 'clock', onclick: () => ED.present(undefined, { train: true }) },
  { sep: 1 }, { head: !PRC.canPopup() ? 'Per due schermi apri Palco dal sito o dal file .html' : window.screen && window.screen.isExtended ? 'Secondo schermo rilevato' : 'Collega la TV o la LIM per usare due schermi' }
], { align: 'right' });

/* ============ Allenamento: quanto tempo dedichi a ogni pagina, con rapporto finale e confronto con la prova precedente ============ */
const REH = { on: false, arm: false };
REH.begin = (deck) => { REH.on = true; REH.arm = false; REH.deck = deck; REH.per = deck.slides.map(() => 0); REH.cur = -1; REH.last = Date.now(); };
REH.mark = (i) => {
  if (!REH.on) return;
  const now = Date.now(); if (REH.cur >= 0 && REH.cur < REH.per.length) REH.per[REH.cur] += (now - REH.last) / 1000;
  REH.cur = i; REH.last = now;
};
REH.end = () => {
  if (!REH.on) return; REH.mark(-1); REH.on = false;
  const D = REH.deck, per = REH.per, total = per.reduce((a, b) => a + b, 0);
  if (total < 8 || !(typeof ED !== 'undefined' && ED.active && ED.deck === D)) return;
  D.runs = (D.runs || []).slice(-5); const prev = D.runs[D.runs.length - 1] || null;
  const run = { d: Date.now(), total: Math.round(total), per: per.map(x => Math.round(x * 10) / 10) };
  D.runs.push(run); ED.dirty();
  setTimeout(() => REH.report(D, run, prev), 250);
};
REH.report = (D, run, prev) => {
  const per = run.per, n = per.length, total = run.total, max = Math.max(...per, 1), longest = per.indexOf(Math.max(...per));
  const avg = total / n, tips = [];
  if (n > 3 && per[longest] / total >= .3) tips.push(['info', `La pagina ${longest + 1} ha preso il ${Math.round(per[longest] / total * 100)}% del tempo: forse conviene dividerla o accorciarla.`]);
  const never = per.map((s, i) => s === 0 ? i + 1 : 0).filter(Boolean);
  if (never.length) tips.push(['info', `${never.length === 1 ? 'La pagina' : 'Le pagine'} ${never.join(', ')} non ${never.length === 1 ? 'è stata mostrata' : 'sono state mostrate'} in questa prova.`]);
  const fast = per.map((s, i) => s > 0 && s < 3 ? i + 1 : 0).filter(Boolean);
  if (fast.length) tips.push(['info', `${fast.length === 1 ? 'La pagina' : 'Le pagine'} ${fast.join(', ')} ${fast.length === 1 ? 'è passata' : 'sono passate'} in meno di 3 secondi: da togliere o da raccontare meglio?`]);
  tips.push(['check', avg < 15 ? `Ritmo veloce: ${Math.round(avg)} secondi a pagina in media. Il pubblico potrebbe faticare a seguire.` : avg > 90 ? `Ritmo lento: ${Math.round(avg)} secondi a pagina in media. Le pagine potrebbero avere troppo da dire.` : `Ritmo equilibrato: ${Math.round(avg)} secondi a pagina in media.`]);
  if (typeof PRC !== 'undefined' && PRC.target) { const d = total - PRC.target * 60; tips.push([d > 0 ? 'info' : 'check', d > 0 ? `Hai superato di ${fmtT(d)} il tempo previsto (${PRC.target} minuti).` : `Sei dentro il tempo previsto (${PRC.target} minuti), con ${fmtT(-d)} di margine.`]); }
  if (prev) { const d = total - prev.total; tips.push(['info', d === 0 ? 'Stessa durata della prova precedente.' : `${d > 0 ? 'Più lunga' : 'Più breve'} di ${fmtT(Math.abs(d))} rispetto alla prova precedente (${fmtT(prev.total)}).`]); }
  const rows = D.slides.map((s, i) => h('div.rrow' + (i === longest ? '.best' : ''), h('div.rth', R.thumb(s, D)), h('div.rbar', h('i', { style: { width: Math.max(2, per[i] / max * 100) + '%' } })), h('b', fmtT(per[i]))));
  const hist = (D.runs || []).slice(0, -1).reverse();
  const m = UI.modal('Com’è andata', h('div.form',
    h('div.rtot', h('div', h('small', 'Durata totale'), h('b', fmtT(total))), h('div', h('small', 'Pagine'), h('b', String(n))), h('div', h('small', 'Media a pagina'), h('b', fmtT(avg)))),
    h('div.rtips', tips.map(([ic, t]) => h('div.rtip', icn(ic, 18), h('span', t)))),
    h('div.rlist', rows),
    hist.length ? h('p.hint2', 'Prove precedenti: ' + hist.map(r => `${new Date(r.d).toLocaleDateString('it-IT', { day: 'numeric', month: 'short' })} ${fmtT(r.total)}`).join(' · ')) : null),
  { cls: 'wide2', foot: [h('span.grow'), h('button.btn', { onclick: () => m.close() }, 'Chiudi'), h('button.btn.primary', { onclick: () => { m.close(); ED.present(undefined, { train: true }); } }, icn('restore', 16), 'Riprova')] });
};

/* aggancio alla presentazione a finestra unica e alla console a due schermi */
const rehPrStart = PR.start;
PR.start = (deck, i = 0) => { if (REH.arm && !REH.on) REH.begin(deck); rehPrStart(deck, i); };
const rehPrShow = PR.show;
PR.show = (i, dir, first) => { rehPrShow(i, dir, first); if (!PR.audience) REH.mark(i); };
const rehPrStop = PR.stop;
PR.stop = () => { const was = PR.on; rehPrStop(); if (was && !PR.audience) REH.end(); };
const rehPrcStart = PRC.start;
PRC.start = (deck, i = 0) => { if (REH.arm && !REH.on) REH.begin(deck); rehPrcStart(deck, i); if (PRC.on) REH.mark(PRC.i); };
const rehPrcGo = PRC.go;
PRC.go = (i, send) => { rehPrcGo(i, send); REH.mark(PRC.i); };
const rehPrcStop = PRC.stop;
PRC.stop = (cw) => { const was = PRC.on; rehPrcStop(cw); if (was) REH.end(); };

/* ============ Funzioni con l'IA: testo (Claude, DeepSeek o OpenAI) e immagini (Pollinations) ============ */
const AI = {};
AI.BASES = [['tramonto', 'blu notte con un sole al tramonto, per pitch e startup'], ['minimale', 'bianco pulito, un solo colore, titoli grandi'], ['neon', 'nero tecnologico con puntini e colori fluo'], ['aula', 'celeste giocoso con forme morbide, per scuola e bambini'],
  ['editoriale', 'stile rivista, titoli serif, bianco e nero con un colore acceso'], ['mediterraneo', 'archi e sole, colori caldi di mare e viaggi'], ['pop', 'giallo vivace con contorni neri spessi, marketing giovane'],
  ['business', 'istituzionale, pannello laterale scuro, bianco e blu'], ['natura', 'verde scuro con forme organiche, ambiente e benessere'], ['brutale', 'nero e giallo, titoli enormi in maiuscolo, audace'], ['pastello', 'cerchi morbidi pastello, titolo centrato, workshop e creativi']];
AI.SLIDE_SCHEMA = `{"kind":"tipo di pagina","layout":"composizione","title":"...","bullets":["max 5 punti brevi"],"icons":["nome icona opzionale per ogni punto"],"notes":"cosa dire a voce, 1-2 frasi",
"left":{"title":"","bullets":[]},"right":{"title":"","bullets":[]},"stats":[{"value":"42%","label":"..."}],"quote":"...","author":"...","role":"",
"steps":[{"title":"...","text":"..."}],"chart":"bar|line|pie|donut","labels":["A","B"],"series":[{"name":"...","values":[1,2]}],"big":"+30%","note":"...","text":"paragrafo breve o frase chiave","label":"etichetta breve sopra una frase",
"term":"concetto da definire","example":"esempio","rows":[["Intestazione A","Intestazione B"],["dato","dato"]],"button":"testo del pulsante","contacts":["email o telefono o sito"]}`;
AI.LAYOUT_GUIDE = `TIPI DI PAGINA ("kind") E COMPOSIZIONI ("layout") DISPONIBILI:
- bullets (elenco): side-art | cards | big-left | center | numbered | iconlist | split   (icone: check bulb target star bolt trend bars person clock globe lock mail phone pin heart flag)
- section (apertura di sezione): bignum | center | left | split
- twocol (confronto, usa "left" e "right"): cards | vs | split-bg
- imgtext (testo con immagine, usa "text"): alt | overlay | top | circle
- stats (2-4 numeri): cards | big | line | stack
- chart (grafico): left | full | right
- timeline (3-5 passi): h | v | chevron | steps
- quote (citazione): left | center | split
- statement (una frase forte in "text", "label" facoltativa): center | left | boxed
- checklist (cose da fare o verificare, in "bullets")
- gallery (immagini con didascalie in "bullets"): row | mosaic
- table (dati in tabella: "rows", prima riga = intestazioni)
- definition (un concetto: "term", "text", "example")
- cta (invito all'azione: "text", "button", "contacts")
COME SCEGLIERE: la composizione deve seguire lo SCOPO della presentazione e il contenuto di ogni pagina, non una formula fissa. Esempi: pitch per investitori = statement per il problema, stats big, chart full, timeline chevron, cta finale. Lezione = definition, numbered, timeline v, quote, checklist. Report = table, chart, stats line, twocol vs. Prodotto o marketing = imgtext overlay, gallery, statement, iconlist. Workshop = checklist, numbered, cta. Racconto o viaggio = imgtext circle o top, gallery mosaic, quote center.
VARIA SEMPRE: due pagine consecutive non devono avere lo stesso tipo né la stessa composizione; con 8 o più pagine usa almeno 5 tipi diversi; "bullets" al massimo per un terzo delle pagine; usa dati e numeri veri nel contenuto quando servono a un grafico o a stats.`;
/* ---- impostazioni (solo in questo browser) ---- */
AI.PROV = { claude: { name: 'Claude' }, deepseek: { name: 'DeepSeek', url: 'https://api.deepseek.com/chat/completions', model: 'deepseek-chat', keys: 'platform.deepseek.com' }, openai: { name: 'OpenAI', url: 'https://api.openai.com/v1/chat/completions', model: 'gpt-4o-mini', keys: 'platform.openai.com/api-keys' } };
AI.cfg = (() => { try { return { provider: '', keys: {}, models: {}, ...JSON.parse(ST.lget('palco.ai') || '{}') }; } catch (e) { return { provider: '', keys: {}, models: {} }; } })();
AI.save = () => ST.lset('palco.ai', JSON.stringify(AI.cfg));
AI.provider = () => {
  const p = AI.cfg.provider;
  if (p === 'claude' && ST.sample) return 'claude';
  if ((p === 'deepseek' || p === 'openai') && AI.cfg.keys[p]) return p;
  if (!p) { if (AI.cfg.keys.deepseek) return 'deepseek'; if (AI.cfg.keys.openai) return 'openai'; if (ST.sample) return 'claude'; }
  return '';
};
AI.textOk = () => !!AI.provider();
AI.BLOCKED = 'Il browser blocca i servizi esterni in questa finestra (succede quando Palco è aperto dentro Claude). Salva il file di Palco sul computer e aprilo da lì, oppure usalo su un tuo sito.';
AI.errMsg = (e, fallback) => {
  const c = e && e.code;
  return c === 'blocked' ? AI.BLOCKED : c === 'auth' ? 'La chiave API non è valida o è scaduta. Controllala nelle impostazioni IA.' : c === 'balance' ? 'Il credito del servizio è esaurito.' : c === 'rate_limited' || c === 'rate' ? 'Troppe richieste, riprova tra poco.'
    : c === 'not_granted' ? 'Non hai concesso a questa pagina l’accesso a Claude.' : c === 'none' ? 'Scegli un servizio e inserisci la chiave nelle impostazioni IA.' : c === 'pollkey' ? 'Per le immagini serve una chiave di Pollinations (gratuita su enter.pollinations.ai): inseriscila nelle impostazioni IA.' : fallback;
};

AI.chat = async (prov, prompt, opts = {}) => {
  const P = AI.PROV[prov], key = AI.cfg.keys[prov];
  const body = { model: AI.cfg.models[prov] || P.model, messages: [{ role: 'user', content: prompt }], temperature: opts.json ? .6 : .7 };
  if (opts.json) body.response_format = { type: 'json_object' };
  let r;
  try { r = await fetch(P.url, { method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + key }, body: JSON.stringify(body) }); }
  catch (e) { throw { code: 'blocked' }; }
  if (!r.ok) throw { code: r.status === 401 || r.status === 403 ? 'auth' : r.status === 402 ? 'balance' : r.status === 429 ? 'rate' : 'http', status: r.status };
  const j = await r.json();
  return (j.choices && j.choices[0] && j.choices[0].message && j.choices[0].message.content) || '';
};
AI.ask = async (prompt, opts = {}) => {
  const prov = AI.provider();
  if (!prov) throw { code: 'none' };
  if (prov === 'claude') { const r = await ST.sample(prompt, { modelTier: opts.modelTier || 'default' }); return (r && r.text) || ''; }
  return AI.chat(prov, prompt, opts);
};
AI.json = (txt) => {
  const a = txt.indexOf('{'), b = txt.lastIndexOf('}');
  if (a < 0 || b < 0) throw new Error('risposta non valida');
  return JSON.parse(txt.slice(a, b + 1));
};

AI.settings = (note) => {
  const draft = { provider: AI.provider() || AI.cfg.provider || (ST.sample ? 'claude' : 'deepseek'), keys: { ...AI.cfg.keys }, models: { ...AI.cfg.models }, poll: AI.cfg.poll || '', pollModel: AI.cfg.pollModel || '' };
  const body = h('div.form'), status = h('div.aistatus');
  const draw = () => {
    body.innerHTML = '';
    const opts = [['deepseek', 'DeepSeek'], ['openai', 'OpenAI']]; if (ST.sample) opts.unshift(['claude', 'Claude']);
    if (note) body.append(h('p.mtext', note));
    body.append(h('p.mtext', 'Scegli il servizio che scrive testi, scalette e pagine (DeepSeek oppure OpenAI, con la tua chiave).'), UI.seg(opts, draft.provider, v => { draft.provider = v; draw(); }));
    const p = draft.provider;
    if (p === 'claude') body.append(h('p.mtext', 'Claude è collegato a questa pagina: non serve nessuna chiave.'));
    else {
      const P = AI.PROV[p];
      const key = h('input.inp', { type: 'password', value: draft.keys[p] || '', placeholder: p === 'openai' ? 'sk-…' : 'sk-…', autocomplete: 'off', 'aria-label': 'Chiave API ' + P.name, oninput: e => { draft.keys[p] = e.target.value.trim(); } });
      const model = h('input.inp', { type: 'text', value: draft.models[p] || '', placeholder: P.model, 'aria-label': 'Modello', oninput: e => { draft.models[p] = e.target.value.trim(); } });
      body.append(h('label.flab', 'Chiave API di ' + P.name), key, h('label.flab', 'Modello (facoltativo)'), model,
        h('p.hint2', `Puoi creare la chiave su ${P.keys}. La chiave resta solo in questo browser e viene inviata soltanto a ${P.name}. Non salvarla su computer condivisi.`));
    }
    const pk = h('input.inp', { type: 'password', value: draft.poll, placeholder: 'sk_…', autocomplete: 'off', 'aria-label': 'Chiave Pollinations', oninput: e => { draft.poll = e.target.value.trim(); } });
    body.append(h('label.flab', 'Immagini: chiave di Pollinations (facoltativa)'), pk,
      h('p.hint2', 'Senza chiave le immagini funzionano ma restano collegate al servizio e non vengono incluse in PDF, PowerPoint e PNG. Con una chiave gratuita (enter.pollinations.ai) vengono salvate nella presentazione. La chiave resta solo in questo browser.'), status);
  };
  draw();
  const m = UI.modal('Impostazioni IA', body, { cls: 'small', foot: [
    h('button.btn', { onclick: async () => {
      status.textContent = 'Provo la connessione…';
      try { const prev = AI.cfg; AI.cfg = { ...draft }; const t = await AI.ask('Rispondi solo con la parola: ok', { modelTier: 'quick' }); AI.cfg = prev; status.textContent = t ? 'Connessione riuscita.' : 'Nessuna risposta.'; }
      catch (e) { status.textContent = AI.errMsg(e, 'La connessione non è riuscita.'); }
      finally { }
    } }, 'Prova'),
    h('span.grow'), h('button.btn', { onclick: () => m.close() }, 'Annulla'),
    h('button.btn.primary', { onclick: () => { AI.cfg = { ...draft }; AI.save(); m.close(); toast('Impostazioni IA salvate'); if (typeof ED !== 'undefined' && ED.active) ED.renderPanel(); else App.render(); } }, 'Salva')] });
};
App.aiUnavailable = () => AI.settings('Per usare questa funzione scegli un servizio e inserisci la tua chiave.');

/* ---- scaletta con tema ideato dall'IA ---- */
AI.askOutline = async (desc, n, mood) => {
  const wants = AI.wantsImages(desc + ' ' + (mood || ''));
  const fonts = FONTS.map(f => f[0]).join(', ');
  const bases = AI.BASES.map(([k, d]) => `${k}: ${d}`).join('; ');
  const inst = `Sei un assistente che prepara presentazioni in italiano, scalette e grafica.
Argomento richiesto dall'utente: """${desc}"""
${mood ? `Stile desiderato: """${mood}"""\n` : ''}Crea circa ${n} pagine di contenuto (copertina e chiusura le aggiungo io) e DISEGNA tu il tema grafico adatto all'argomento.
Rispondi SOLO con JSON valido, senza testo prima o dopo e senza blocchi di codice, con questa forma:
{"title":"titolo breve","subtitle":"sottotitolo","purpose":"scopo della presentazione in 3-5 parole","cover":"theme|center|split|bigtype|frame (copertina: theme=tipica dello stile, center=titolo centrato, split=immagine a lato, bigtype=titolo enorme, frame=cornice elegante)","tag":"etichetta breve in maiuscolo","closing":"frase di chiusura breve","contact":"",
"theme":{"name":"nome del tema, 2 parole","base":"uno tra: ${AI.BASES.map(b => b[0]).join(', ')}","bg":"#RRGGBB sfondo","fg":"#RRGGBB testo (deve contrastare con bg)","mute":"#RRGGBB testo secondario","ac":"#RRGGBB colore principale","ac2":"#RRGGBB secondo colore","ac3":"#RRGGBB terzo colore","card":"#RRGGBB sfondo delle schede","fontTitle":"uno tra: ${fonts}","fontBody":"uno tra: ${fonts}"},
"slides":[${AI.SLIDE_SCHEMA}]}
Scegli "base" in base al carattere dell'argomento (${bases}). Colori armoniosi e leggibili, coerenti con l'argomento e con lo stile desiderato.\n${AI.LAYOUT_GUIDE}\n${wants ? AI.IMG_RULES + '\n' : ''}Punti brevi (massimo 9 parole). Per "stats" usa 3 numeri, per "timeline" 4 passi, per "chart" dati plausibili e coerenti.`;
  const ol = AI.json(await AI.ask(inst, { json: true }));
  if (!ol.slides || !ol.slides.length) throw new Error('scaletta vuota');
  ol.wantImages = wants;
  return ol;
};
App.askOutline = AI.askOutline;
App.aiDialog = (prompt = '') => {
  if (!AI.textOk()) return App.aiUnavailable();
  const ta = h('textarea.inp.area', { rows: 5, placeholder: 'Es. Una presentazione di 8 pagine per spiegare ai genitori come funziona il nuovo orario scolastico', 'aria-label': 'Descrizione' }, prompt);
  const mood = h('input.inp', { placeholder: 'Stile (facoltativo): elegante, colori caldi, divertente…', 'aria-label': 'Stile desiderato', maxlength: 100 });
  const nsel = h('select.inp.sm', { 'aria-label': 'Numero di pagine', style: { width: 'auto' } }, [5, 8, 10, 12].map(n => h('option', { value: n, selected: n === 8 }, n + ' pagine')));
  const status = h('div.aistatus');
  const go = h('button.btn.primary', {
    onclick: async () => {
      const desc = ta.value.trim(); if (!desc) return toast('Descrivi di cosa vuoi parlare');
      go.disabled = true; status.textContent = `${AI.PROV[AI.provider()].name} sta scrivendo la scaletta e disegnando il tema…`;
      try {
        const ol = await AI.askOutline(desc, +nsel.value, mood.value.trim());
        let cv = TP.COVERS.includes(ol.cover) ? ol.cover : TP.COVERS[Math.floor(Math.random() * TP.COVERS.length)];
        if (ol.wantImages && !['split', 'center'].includes(cv)) cv = Math.random() < .5 ? 'split' : 'center';
        const th = TP.custom({ ...(ol.theme || {}), coverVariant: cv }); TP.themes.push(th);
        await loadFonts([[th.fd, th.wd], [th.fb, 400], [th.fb, 700]]);
        status.textContent = 'Preparo le pagine…';
        const deck = TP.fromOutline(th.id, ol);
        let imgNote = '';
        if (ol.wantImages) {
          status.textContent = 'Disegno le immagini…';
          const r = await AI.fillImages(deck, ol, (n, tot) => { status.textContent = 'Disegno le immagini ' + n + ' di ' + tot + '…'; });
          if (r.failed) imgNote = r.failed + (r.failed === 1 ? ' immagine non è riuscita' : ' immagini non sono riuscite') + ': al loro posto c’è un’immagine astratta.';
        }
        m.close(); App.create(deck); if (imgNote) toast(imgNote, { ms: 5000 });
      } catch (e) { console.warn(e); go.disabled = false; status.textContent = AI.errMsg(e, 'Non sono riuscito a creare la presentazione. Riprova o usa “Da una scaletta”.'); }
    }
  }, icn('sparkles', 18), 'Crea');
  const m = UI.modal('Crea con l’IA', h('div.form', h('p.mtext', 'Scrivi l’argomento: l’IA prepara le pagine e sceglie da sola colori, font e stile grafico.'), ta, mood, h('div.row', h('label.flab', 'Lunghezza'), nsel, h('span.grow'), h('button.btn.sm.ghost', { onclick: () => AI.settings() }, icn('settings', 16), AI.PROV[AI.provider()].name)), status), { cls: 'wide', foot: [h('span.grow'), h('button.btn', { onclick: () => m.close() }, 'Annulla'), go] });
  setTimeout(() => ta.focus(), 80);
};

/* ---- immagini vettoriali scritte in SVG dal modello di testo ---- */
AI.cleanSvg = (txt) => {
  const m = txt.match(/<svg[\s\S]*<\/svg>/i); if (!m) throw new Error('svg');
  const src = m[0].replace(/<svg(?![^>]*xmlns=)/i, '<svg xmlns="http://www.w3.org/2000/svg"');
  const doc = new DOMParser().parseFromString(src, 'image/svg+xml');
  if (doc.querySelector('parsererror')) throw new Error('svg');
  const svg = doc.documentElement;
  doc.querySelectorAll('script,foreignObject,style,iframe,image,animate,set,animateTransform,animateMotion').forEach(n => n.remove());
  doc.querySelectorAll('*').forEach(n => [...n.attributes].forEach(a => {
    const nm = a.name.toLowerCase();
    if (nm.startsWith('on') || ((nm === 'href' || nm === 'xlink:href') && !a.value.startsWith('#')) || /url\(\s*['"]?(?!#)/i.test(a.value)) n.removeAttribute(a.name);
  }));
  if (!svg.getAttribute('viewBox')) svg.setAttribute('viewBox', '0 0 800 600');
  const vb = svg.getAttribute('viewBox').split(/[\s,]+/).map(Number);
  svg.setAttribute('width', vb[2] || 800); svg.setAttribute('height', vb[3] || 600);
  return new XMLSerializer().serializeToString(svg);
};
AI.STYLES = [['flat', 'Illustrazione'], ['icon', 'Icona'], ['bg', 'Sfondo'], ['diagram', 'Schema']];
AI.genSvg = async (prompt, style) => {
  const th = TP.get(ED.deck.theme), cols = [th.ac, th.ac2, th.ac3, th.fg, th.bg].join(', ');
  const how = { flat: 'illustrazione vettoriale piatta, colori pieni, forme semplici e pulite, un soggetto chiaro al centro', icon: 'icona semplice e leggibile, forme geometriche, un solo soggetto', bg: 'sfondo astratto a tutta pagina, senza soggetti, forme geometriche, onde o sfumature morbide', diagram: 'schema pulito con blocchi arrotondati e frecce, senza testo' }[style];
  const vb = style === 'icon' ? '0 0 600 600' : style === 'bg' ? '0 0 1600 900' : '0 0 800 600';
  const inst = `Sei un illustratore vettoriale. Disegna: """${prompt}""".
Stile: ${how}.
Rispondi SOLO con un file SVG valido (da <svg> a </svg>, nessun altro testo), con viewBox="${vb}".
Regole: niente <script>, niente <style>, niente immagini esterne, niente <foreignObject>; colori solo con gli attributi fill e stroke (sono ammessi linearGradient e radialGradient dentro <defs>). Niente testo, a meno che serva davvero. Al massimo 70 elementi. Sfondo trasparente${style === 'bg' ? ' tranne il rettangolo di fondo' : ''}. Palette consigliata: ${cols}.`;
  const svg = AI.cleanSvg(await AI.ask(inst));
  const ref = await Img.store(new Blob([svg], { type: 'image/svg+xml' }));
  (ED.deck.imgs = ED.deck.imgs || []).unshift(ref);
  return ref;
};

/* ---- immagini generate da Pollinations ---- */
AI.PSTYLES = [['photo', 'Foto', 'realistic photo, natural light, high detail', 768, 512], ['art', 'Illustrazione', 'flat vector illustration, clean shapes, vivid colors', 768, 576], ['bg', 'Sfondo 16:9', 'abstract background, soft gradients, no text, wide composition', 1024, 576]];
AI.genPoll = async (prompt, style) => {
  const [, , words, w, hgt] = AI.PSTYLES.find(s => s[0] === style) || AI.PSTYLES[0];
  let p = prompt;
  if (AI.textOk()) { try { const t = (await AI.ask(`Translate and expand this into one English prompt for an image generator, max 40 words, no quotes, only the prompt:\n${prompt}`, { modelTier: 'quick' })).trim(); if (t && t.length < 500) p = t; } catch (e) { /* si usa il testo originale */ } }
  const key = AI.cfg.poll, seed = Math.floor(Math.random() * 1e6);
  if (!key) {
    // senza chiave Pollinations risponde solo al caricamento come immagine: l'immagine resta collegata dall'indirizzo
    const url = `https://image.pollinations.ai/prompt/${encodeURIComponent(p + ', ' + words)}?width=${w}&height=${hgt}&seed=${seed}&nologo=true`;
    await new Promise((res, rej) => { const im = new Image(); const t = setTimeout(() => rej({ code: 'http' }), 90000); im.onload = () => { clearTimeout(t); res(); }; im.onerror = () => { clearTimeout(t); rej({ code: 'blocked' }); }; im.src = url; });
    (ED.deck.imgs = ED.deck.imgs || []).unshift(url);
    return url;
  }
  const base = `https://gen.pollinations.ai/image/${encodeURIComponent(p + ', ' + words)}?width=${w}&height=${hgt}&seed=${Math.floor(Math.random() * 1e6)}&nologo=true&key=${encodeURIComponent(key)}`;
  let blob;
  try {
    let r = await fetch(base + '&model=' + encodeURIComponent(AI.cfg.pollModel || 'flux'));
    if (r.status === 400 || r.status === 404) r = await fetch(base);
    if (r.status === 401 || r.status === 403) throw { code: 'pollkey' };
    if (r.status === 429 || r.status === 402) throw { code: 'rate' };
    if (!r.ok) throw { code: 'http' };
    blob = await r.blob();
  } catch (e) { if (e && e.code) throw e; throw { code: 'blocked' }; }
  if (!/^image\//.test(blob.type)) throw { code: 'http' };
  const ref = await Img.addFile(new File([blob], 'ia.jpg', { type: blob.type }));
  (ED.deck.imgs = ED.deck.imgs || []).unshift(ref);
  return ref;
};

/* ---- pagine nuove ---- */
AI.genSlides = async (desc, n, onProgress) => {
  const D = ED.deck, th = TP.get(D.theme), wants = AI.wantsImages(desc);
  const titles = D.slides.map(s => { const t = s.els.filter(e => e.t === 'text').sort((a, b) => b.s - a.s)[0]; return t ? M.plain(t).split('\n')[0] : ''; }).filter(Boolean).slice(0, 14).join(' | ');
  const inst = `Sei un assistente che prepara pagine di presentazioni in italiano.
Titolo della presentazione: """${D.name}""". Pagine già presenti: ${titles || 'nessuna'}.
L'utente chiede ${n === 1 ? 'una pagina' : n + ' pagine'} su: """${desc}"""
Rispondi SOLO con JSON valido: {"slides":[${AI.SLIDE_SCHEMA}]}
${AI.LAYOUT_GUIDE}
${wants ? AI.IMG_RULES : ''}
Scegli per ogni pagina il tipo e la composizione più adatti al contenuto e allo scopo della presentazione, senza ripetere sempre lo stesso schema. Punti brevi (massimo 9 parole). ${n === 1 ? 'Esattamente una pagina.' : 'Esattamente ' + n + ' pagine.'}`;
  const ol = AI.json(await AI.ask(inst, { json: true }));
  await loadFonts([[th.fd, th.wd], [th.fb, 400], [th.fb, 700]]);
  const body = (ol.slides || []).filter(s => s && s.title).slice(0, n);
  if (!body.length) throw new Error('vuoto');
  TP.wantImages = wants;
  let slides; try { slides = TP.outlineSlides(th, body, D.w, D.h, ED.si + 1); } finally { TP.wantImages = false; }
  if (wants) { const r = await AI.fillImages({ name: D.name, w: D.w, h: D.h, theme: D.theme, slides, imgs: D.imgs }, ol, onProgress); if (r.failed) toast(r.failed + (r.failed === 1 ? ' immagine non è riuscita' : ' immagini non sono riuscite'), { ms: 4000 }); }
  return slides;
};

/* ---- testo e note ---- */
AI.REWRITE = [['clear', 'Più chiaro', 'Riscrivi il testo in modo più chiaro e scorrevole.'], ['short', 'Più breve', 'Accorcia il testo mantenendo le idee principali.'], ['pro', 'Più professionale', 'Riscrivi il testo con un tono più professionale.'], ['friendly', 'Più amichevole', 'Riscrivi il testo con un tono più amichevole e diretto.'], ['en', 'Traduci in inglese', 'Traduci il testo in inglese.'], ['fix', 'Correggi errori', 'Correggi ortografia e grammatica senza cambiare il senso.']];
AI.rewrite = async (instr) => {
  const e = ED.selEls()[0], src = M.plain(e);
  const out = (await AI.ask(`${instr}\nMantieni lo stesso numero di righe (ogni riga separata da a capo). Rispondi SOLO con il testo risultante, senza commenti né virgolette.\n\nTesto:\n${src}`, { modelTier: 'quick' })).trim().replace(/^["“]|["”]$/g, '');
  if (!out) throw new Error('vuoto');
  ED.mut(x => { const keep = x.paras.map(p => p.l); M.setText(x, out); x.paras.forEach((p, i) => { const l = keep[i] || keep[0]; if (l) p.l = l; }); });
};
AI.genNotes = async () => {
  const s = ED.slide();
  const txt = s.els.map(e => e.t === 'text' ? M.plain(e) : e.t === 'table' ? e.rows.map(r => r.join(' ')).join('; ') : e.t === 'chart' ? 'Grafico: ' + e.labels.join(', ') + ' = ' + e.series.map(x => x.n + ' ' + x.v.join('/')).join('; ') : '').filter(Boolean).join('\n');
  if (!txt.trim()) throw new Error('vuoto');
  const out = await AI.ask(`Scrivi le note del relatore in italiano per questa pagina di presentazione: 3 o 4 frasi in forma parlata, da leggere ad alta voce. Rispondi SOLO con le note.\n\nContenuto della pagina:\n${txt}`, { modelTier: 'quick' });
  s.notes = out.trim(); ED.notesOpen = true; ED.renderNotes(); ED.commit();
};

/* ---- pannello laterale ---- */
ED.ai = { img: '', src: 'poll', pstyle: 'photo', style: 'flat', gen: '', n: 1, busy: '', msg: '', recent: [] };
ED.panels.ai = () => {
  const S = ED.ai, prov = AI.provider(), text = !!prov;
  const run = async (key, fn, okMsg) => {
    S.busy = key; S.msg = ''; ED.renderPanel();
    try { await fn(); S.msg = okMsg || ''; } catch (e) { console.warn(e); S.msg = AI.errMsg(e, 'Non è andata a buon fine. Riprova con parole diverse.'); }
    S.busy = ''; if (ED.panel === 'ai') ED.renderPanel();
  };
  const busy = k => S.busy === k, dis = !!S.busy;
  const secs = [];
  secs.push(h('button.btn.sm.full', { onclick: () => AI.settings() }, icn('settings', 16), text ? 'Impostazioni · testi con ' + AI.PROV[prov].name : 'Impostazioni IA'));
  if (S.msg) secs.push(h('div.aimsg', S.msg));
  // immagini
  const ti = h('textarea.inp.area', { rows: 3, placeholder: 'Es. Un razzo che decolla tra le nuvole', 'aria-label': 'Descrivi l’immagine', oninput: e => { S.img = e.target.value; } }, S.img);
  const svgOk = text;
  const srcOpts = [['poll', 'Pollinations']]; if (svgOk) srcOpts.push(['svg', 'Vettoriale']);
  if (S.src === 'svg' && !svgOk) S.src = 'poll';
  secs.push(psec('Immagine', h('div.aibox', ti, srcOpts.length > 1 ? UI.seg(srcOpts, S.src, v => { S.src = v; ED.renderPanel(); }) : null,
    S.src === 'poll' ? UI.seg(AI.PSTYLES.map(s => [s[0], s[1]]), S.pstyle, v => { S.pstyle = v; ED.renderPanel(); }) : UI.seg(AI.STYLES, S.style, v => { S.style = v; ED.renderPanel(); }),
    h('button.btn.primary.full', { disabled: dis, onclick: () => {
      if (!S.img.trim()) return toast('Descrivi l’immagine');
      const bg = S.src === 'poll' ? S.pstyle === 'bg' : S.style === 'bg';
      run('img', async () => { const ref = S.src === 'poll' ? await AI.genPoll(S.img.trim(), S.pstyle) : await AI.genSvg(S.img.trim(), S.style); S.recent.unshift(ref); S.recent = S.recent.slice(0, 12); if (bg) ED.setBg({ img: ref, dim: 0 }); else await ED.addImage(ref); }, bg ? 'Sfondo applicato alla pagina.' : 'Immagine aggiunta alla pagina.');
    } }, icn('sparkles', 18), busy('img') ? 'Sto generando…' : 'Genera immagine'),
    h('p.hint2', S.src === 'poll' ? (AI.cfg.poll ? 'Pollinations può impiegare qualche secondo. Poi puoi ricolorare l’immagine dal pulsante “Colori”.' : 'Pollinations non richiede chiavi: l’immagine resta collegata al servizio e non entra nei file esportati. Con una chiave gratuita (Impostazioni) viene salvata nella presentazione.') : 'Il modello disegna illustrazioni vettoriali: si possono ridimensionare e ricolorare senza perdere qualità.'),
    S.recent.length ? h('div.imggrid', S.recent.map(r => h('button.imgb', { title: 'Inserisci di nuovo (o trascina)', data: { ref: r }, onclick: () => ED.addImage(r) }, h('img', { src: Img.url(r), alt: '' })))) : null)));
  // pagine, testo, note: richiedono un servizio di testo
  if (!text) { secs.push(h('p.hint2', 'Per generare pagine, riscrivere i testi e scrivere le note serve un servizio di testo (DeepSeek, OpenAI o Claude): sceglilo con il pulsante qui sopra.')); return secs; }
  const tg = h('textarea.inp.area', { rows: 3, placeholder: 'Es. Un confronto tra i tre piani di prezzo', 'aria-label': 'Descrivi le pagine', oninput: e => { S.gen = e.target.value; } }, S.gen);
  const ns = h('select.inp.sm', { 'aria-label': 'Quante pagine', style: { width: 'auto' }, onchange: e => { S.n = +e.target.value; } }, [1, 2, 3, 4].map(n => h('option', { value: n, selected: n === S.n }, n === 1 ? '1 pagina' : n + ' pagine')));
  secs.push(psec('Pagine', h('div.aibox', tg, h('div.row', h('label.flab', 'Quante'), ns),
    h('button.btn.full', { disabled: dis, onclick: () => { if (!S.gen.trim()) return toast('Descrivi le pagine'); run('pg', async () => { const sl = await AI.genSlides(S.gen.trim(), S.n); ED.deck.slides.splice(ED.si + 1, 0, ...sl); ED.ssel = []; ED.si = ED.si + 1; ED.sel = []; ED.renderAll(); ED.commit(); }, 'Pagine aggiunte dopo quella corrente.'); } }, icn('layout', 18), busy('pg') ? 'Sto scrivendo…' : 'Genera pagine nello stile attuale'))));
  const sel = ED.selEls(), t = sel.length === 1 && sel[0].t === 'text' ? sel[0] : null;
  secs.push(psec('Testo', t ? h('div.aibox', h('div.aichips', AI.REWRITE.map(([k, l, ins]) => h('button.chip', { disabled: dis, onclick: () => run('tx', () => AI.rewrite(ins), 'Testo aggiornato. Puoi annullare con Ctrl+Z.') }, l))), busy('tx') ? h('p.hint2', 'Sto riscrivendo…') : null)
    : h('p.hint2', 'Seleziona una casella di testo per riscriverla, accorciarla o tradurla.')));
  secs.push(psec('Note del relatore', h('div.aibox', h('button.btn.full', { disabled: dis, onclick: () => run('nt', AI.genNotes, 'Note scritte per questa pagina.') }, icn('note', 18), busy('nt') ? 'Sto scrivendo…' : 'Scrivi le note di questa pagina'))));
  return secs;
};
ED._selectBase = ED.select;
ED.select = (ids, o) => { ED._selectBase(ids, o); if (ED.panel === 'ai' && !ED.ai.busy) ED.renderPanel(); };

/* ============ Immagini vettoriali pertinenti alla pagina e alla posizione ============ */
AI.wantsImages = (txt) => /\bimmagin|\bfoto|illustraz|disegn[io]|\bicone\b|\bgrafiche\b|visual|\bfigur|\bimage|\bpicture|\bpittur/i.test(txt || '');
AI.IMG_RULES = `IMMAGINI: l'utente vuole delle immagini. Per ogni pagina in cui un'illustrazione ha senso (imgtext, bullets con layout side-art o art-left, gallery, quote con layout photo, section con layout photo, statement con layout art) aggiungi "image": la descrizione concreta e pertinente di COSA disegnare, legata al contenuto di quella pagina (soggetto, azione, oggetti specifici: mai qualcosa di generico). Per "gallery" usa "images" con 2-4 descrizioni, una per riquadro. Aggiungi "coverImage" per la copertina e "imageStyle": lo stile comune a tutte le illustrazioni (per esempio "illustrazione piatta geometrica, forme arrotondate, palette limitata"). Non mettere immagini nelle pagine di dati (stats, chart, table, timeline). Se l'utente indica dove va un'immagine (per esempio "in copertina" o "nella pagina sul mercato"), rispettalo. Le pagine con immagine devono usare un layout che ha lo spazio per l'immagine.`;

/* dove si trova il riquadro e che forma ha: guida cosa e come disegnare */
AI.slotRole = (e, W, H) => {
  const area = e.w * e.h / (W * H), cx = (e.x + e.w / 2) / W, cy = (e.y + e.h / 2) / H, r = e.w / e.h;
  let where;
  if (area > .8) where = 'sfondo a tutta pagina: scena morbida e poco dettagliata al centro, perché sopra ci sarà una scheda con il testo';
  else if (e.mk === 'ellipse') where = 'immagine tonda al lato del testo: composizione compatta con il soggetto ben centrato';
  else if (r > 2.2) where = 'banner largo e basso nella parte alta della pagina: scena panoramica orizzontale';
  else if (e.h / H > .9) where = cx < .5 ? 'pannello a tutta altezza a sinistra del testo' : 'pannello a tutta altezza a destra del testo';
  else where = cx < .4 ? 'immagine a sinistra del testo' : cx > .6 ? 'immagine a destra del testo' : cy < .5 ? 'immagine nella parte alta' : 'immagine al centro della pagina';
  return `${where}; riquadro ${r >= 1 ? 'orizzontale' : 'verticale'} (rapporto ${r.toFixed(2)})`;
};
AI.imgPrompt = (ctx) => {
  const r = ctx.e.w / ctx.e.h, vw = r >= 1 ? 1000 : Math.round(1000 * r), vh = r >= 1 ? Math.round(1000 / r) : 1000, pal = ctx.palette.join(', ');
  return `Sei un illustratore vettoriale. Disegna l'illustrazione per UNA pagina di una presentazione.
Presentazione: """${ctx.title}"""${ctx.purpose ? ` (scopo: ${ctx.purpose})` : ''}.
Pagina: """${ctx.slideTitle}""". Testo della pagina: """${ctx.slideText}"""
Cosa disegnare: ${ctx.desc}
Posizione e formato: ${ctx.role}. La composizione deve funzionare in questa posizione.
Stile (uguale per tutte le illustrazioni della presentazione): ${ctx.style}.
Rispondi SOLO con un file SVG valido (da <svg> a </svg>, nessun altro testo), con viewBox="0 0 ${vw} ${vh}".
Regole: riempi tutto il riquadro con uno sfondo coerente con la palette; soggetto riconoscibile e pertinente alla pagina; niente <script>, niente <style>, niente immagini esterne, niente <foreignObject>; colori solo con gli attributi fill e stroke (sono ammessi linearGradient e radialGradient dentro <defs>); niente testo scritto; al massimo 80 elementi. Palette da usare: ${pal}.`;
};

AI.fillImages = async (deck, ol, onProgress) => {
  const th = TP.get(deck.theme), W = deck.w, H = deck.h, tasks = [];
  const palette = [th.ac, th.ac2, th.ac3, th.fg, th.bg, th.card].filter(v => typeof v === 'string');
  const style = (ol && ol.imageStyle) || 'illustrazione vettoriale piatta, forme geometriche semplici e pulite, palette limitata';
  const textOf = s => s.els.filter(e => e.t === 'text').map(e => M.plain(e)).join(' ').replace(/\s+/g, ' ').slice(0, 280);
  deck.slides.forEach((s, si) => {
    const ds = s.imgd; if (!ds) return;
    const slots = s.els.filter(e => e.t === 'image' && e.slot != null).sort((a, b) => a.slot - b.slot);
    slots.forEach((e, j) => tasks.push({ s, e, desc: ds[j] || ds[0], si }));
  });
  if (ol && ol.coverImage && deck.slides[0]) { const e = deck.slides[0].els.find(x => x.t === 'image' && x.slot != null); if (e && !tasks.some(t => t.e === e)) tasks.unshift({ s: deck.slides[0], e, desc: ol.coverImage, si: 0 }); }
  const todo = tasks.slice(0, 12); let done = 0, failed = 0;
  const run = async (t) => {
    try {
      const title = deck.name || (ol && ol.title) || '';
      const prompt = AI.imgPrompt({ e: t.e, title, purpose: ol && ol.purpose, slideTitle: textOf(t.s).split('. ')[0].slice(0, 80), slideText: textOf(t.s), desc: t.desc, role: AI.slotRole(t.e, W, H), style, palette });
      const svg = AI.cleanSvg(await AI.ask(prompt));
      const ref = await Img.store(new Blob([svg], { type: 'image/svg+xml' }));
      t.e.src = ref; delete t.e.slot; (deck.imgs = deck.imgs || []).push(ref);
    } catch (er) { failed++; console.warn('immagine', er); }
    done++; onProgress && onProgress(done, todo.length);
  };
  let idx = 0;
  await Promise.all(Array.from({ length: Math.min(3, todo.length) }, async () => { while (idx < todo.length) { const t = todo[idx++]; await run(t); } }));
  deck.slides.forEach(s => { delete s.imgd; s.els.forEach(e => { delete e.slot; }); });
  return { total: todo.length, failed };
};

/* ============ Volo: la presentazione diventa una tela dove la camera vola da una pagina all'altra, con inquadrature e riflettore ============ */
PR.FLYS = [['griglia', 'Griglia'], ['serpente', 'Serpente'], ['spirale', 'Spirale'], ['cerchio', 'Cerchio'], ['mappa', 'Mappa'], ['cascata', 'Cascata'], ['fila', 'Fila']];
PR.flyLayout = (D, fly) => {
  const n = D.slides.length, W = D.w, H = D.h, g = W * .24, tilt = !!fly.tilt, T = i => tilt ? (((i * 37) % 11) - 5) * 1.5 : 0, out = [];
  if (fly.layout === 'serpente') { const cols = Math.max(2, Math.ceil(Math.sqrt(n * 1.5))); for (let i = 0; i < n; i++) { const row = Math.floor(i / cols), c = i % cols, col = row % 2 ? cols - 1 - c : c; out.push({ x: col * (W + g), y: row * (H + g), r: T(i) }); } }
  else if (fly.layout === 'spirale') { for (let i = 0; i < n; i++) { const a = i * 2.39996, rad = W * 1.12 * Math.sqrt(i + .5); out.push({ x: Math.cos(a) * rad - W / 2, y: Math.sin(a) * rad * .78 - H / 2, r: tilt ? T(i) * 2 : 0 }); } }
  else if (fly.layout === 'cerchio') { const R = Math.max(W * 1.25, n * (W + g) / (2 * Math.PI)); for (let i = 0; i < n; i++) { const a = -Math.PI / 2 + i * 2 * Math.PI / n; out.push({ x: Math.cos(a) * R - W / 2, y: Math.sin(a) * R - H / 2, r: tilt ? Math.round(a * 180 / Math.PI + 90) : 0 }); } }
  else if (fly.layout === 'mappa') { out.push({ x: -W / 2, y: -H / 2, r: 0 }); let k = 1, left = n - 1, idx = 1; while (left > 0) { const cap = Math.min(left, 6 * k), rad = k * W * 1.45; for (let j = 0; j < cap; j++) { const a = -Math.PI / 2 + (j + (k % 2 ? 0 : .5)) * 2 * Math.PI / cap; out.push({ x: Math.cos(a) * rad - W / 2, y: Math.sin(a) * rad * .8 - H / 2, r: T(idx++) }); } left -= cap; k++; } }
  else if (fly.layout === 'cascata') { for (let i = 0; i < n; i++) out.push({ x: tilt ? (i % 2) * W * .3 : 0, y: i * (H + g), r: T(i) }); }
  else if (fly.layout === 'fila') { for (let i = 0; i < n; i++) out.push({ x: i * (W + g), y: tilt ? (i % 2) * H * .25 : 0, r: T(i) }); }
  else { const cols = Math.max(2, Math.ceil(Math.sqrt(n * 1.6))); for (let i = 0; i < n; i++) out.push({ x: (i % cols) * (W + g), y: Math.floor(i / cols) * (H + g), r: T(i) }); }
  return out;
};
PR.buildWorld = () => {
  const D = PR.deck, pos = PR.flyLayout(D, D.fly), world = h('div.pr-world');
  PR.worldPos = pos; PR.world = world; PR._ov = false;
  D.slides.forEach((s, j) => {
    const sl = R.slide(s, D, { anim: true, idx: j }); sl.style.position = 'absolute'; sl.style.left = sl.style.top = '0';
    const card = h('div.fl-s', { style: `left:${pos[j].x}px;top:${pos[j].y}px;width:${D.w}px;height:${D.h}px;transform:rotate(${pos[j].r}deg)` }); card.dataset.i = j; card.appendChild(sl);
    $$('.el[data-an]', sl).forEach(n => { if (n.firstElementChild) n.firstElementChild.style.opacity = 0; });
    card.addEventListener('click', e => { if (!PR._ov) return; e.stopPropagation(); PR._ov = false; PR.go(j); if (PR.i === j) PR.flyMove(PR.flyTarget(j, null), 1100, true); });
    world.appendChild(card);
  });
  PR.layer.appendChild(world);
};
PR.flyTarget = (i, rect) => {
  const D = PR.deck, p = PR.worldPos[i], a = PR.area(), r = (p.r || 0) * Math.PI / 180, c0 = { x: p.x + D.w / 2, y: p.y + D.h / 2 };
  let lx = 0, ly = 0, w = D.w, hh = D.h; if (rect) { lx = rect.x + rect.w / 2 - D.w / 2; ly = rect.y + rect.h / 2 - D.h / 2; w = rect.w; hh = rect.h; }
  return { cx: c0.x + lx * Math.cos(r) - ly * Math.sin(r), cy: c0.y + lx * Math.sin(r) + ly * Math.cos(r), s: Math.min(a.w / w, a.h / hh) * (rect ? .94 : .97), rot: p.r || 0 };
};
PR.flyOverviewT = () => {
  const D = PR.deck, a = PR.area(); let x0 = 1e9, y0 = 1e9, x1 = -1e9, y1 = -1e9;
  PR.worldPos.forEach(p => { const r = (p.r || 0) * Math.PI / 180, c = { x: p.x + D.w / 2, y: p.y + D.h / 2 }; [[-D.w / 2, -D.h / 2], [D.w / 2, -D.h / 2], [D.w / 2, D.h / 2], [-D.w / 2, D.h / 2]].forEach(([lx, ly]) => { const X = c.x + lx * Math.cos(r) - ly * Math.sin(r), Y = c.y + lx * Math.sin(r) + ly * Math.cos(r); x0 = Math.min(x0, X); y0 = Math.min(y0, Y); x1 = Math.max(x1, X); y1 = Math.max(y1, Y); }); });
  return { cx: (x0 + x1) / 2, cy: (y0 + y1) / 2, s: Math.min(a.w / (x1 - x0), a.h / (y1 - y0)) * .92, rot: 0 };
};
PR.flyCss = (t) => { const a = PR.area(); return `translate(${(a.x + a.w / 2).toFixed(1)}px,${(a.y + a.h / 2).toFixed(1)}px) rotate(${(-t.rot).toFixed(2)}deg) scale(${t.s.toFixed(5)}) translate(${(-t.cx).toFixed(1)}px,${(-t.cy).toFixed(1)}px)`; };
PR.flyInstant = (t) => { if (PR._fa) { try { PR._fa.cancel(); } catch (e) { } PR._fa = null; } PR.cam = t; PR.world.style.transform = PR.flyCss(t); };
PR.flyMove = (t, dur, zoomOut) => {
  const from = PR.cam || t, w = PR.world; if (PR._fa) { try { PR._fa.commitStyles && PR._fa.commitStyles(); PR._fa.cancel(); } catch (e) { } }
  const a = PR.area(), D = PR.deck, frames = [{ transform: w.style.transform || PR.flyCss(from) }];
  if (zoomOut) {
    const dx = Math.abs(t.cx - from.cx), dy = Math.abs(t.cy - from.cy), fit = Math.min(a.w / (dx + D.w * 1.25), a.h / (dy + D.h * 1.25)), dr = ((t.rot - from.rot + 540) % 360) - 180;
    frames.push({ transform: PR.flyCss({ cx: (from.cx + t.cx) / 2, cy: (from.cy + t.cy) / 2, s: Math.min(from.s, t.s, fit) * .82, rot: from.rot + dr / 2 }), offset: .5 });
  }
  frames.push({ transform: PR.flyCss(t) });
  PR.cam = t;
  const an = w.animate(frames, { duration: dur, easing: zoomOut ? 'cubic-bezier(.55,0,.25,1)' : 'cubic-bezier(.6,0,.2,1)', fill: 'forwards' }); PR._fa = an;
  an.onfinish = () => { if (PR._fa === an) { w.style.transform = PR.flyCss(t); try { an.cancel(); } catch (e) { } PR._fa = null; } };
};
PR.flySpeed = () => ({ l: 2300, f: 950 })[(PR.deck.fly || {}).speed] || 1600;
PR.flyShow = (i, dir, first) => {
  const D = PR.deck, s = D.slides[i], old = PR.cur; if (old) PR.spot(null, old);
  PR.i = i; PR.camStep = 0; PR.camRef = { i, rect: null }; PR.cur = PR.world.children[i];
  $('.pr-count', PR.root).textContent = `${i + 1} / ${D.slides.length}`; $('.pr-notes', PR.root).textContent = s.notes || 'Nessuna nota per questa pagina.';
  const t = PR.flyTarget(i, null), sp = PR.flySpeed();
  if (first) { PR.flyInstant(PR.flyOverviewT()); requestAnimationFrame(() => requestAnimationFrame(() => PR.flyMove(t, sp * 1.25, true))); setTimeout(() => PR.flyArrive(i), sp * .75); }
  else { PR.flyMove(t, sp, true); setTimeout(() => PR.flyArrive(i), sp * .6); }
};
PR.flyArrive = (i) => { const card = PR.world && PR.world.children[i]; if (!card || card._seen) return; card._seen = 1; let d = .05; $$('.el[data-an]', card.firstChild).forEach(el => { d = R.playIn(el, d); }); };
PR.flyOverview = () => {
  if (!PR.fly) return; PR._ov = !PR._ov; PR.spot(null);
  PR.flyMove(PR._ov ? PR.flyOverviewT() : PR.flyTarget(PR.i, (PR.camRef || {}).rect || null), 1100, !PR._ov);
  PR.world.classList.toggle('ov', PR._ov); $('#pr-map') && $('#pr-map').classList.toggle('on', PR._ov);
};
const flyFit0 = PR.fit;
PR.fit = () => { flyFit0(); if (PR.fly && PR.world) { const r = PR._ov ? PR.flyOverviewT() : PR.flyTarget(PR.i, (PR.camRef || {}).rect || null); PR.flyInstant(r); } };

/* ---- inquadrature dentro una pagina ---- */
PR.camSteps = () => { const s = PR.deck.slides[PR.i]; return (s && s.cam) || []; };
PR.zoomRect = (rect, instant) => {
  const sl = PR.cur && $('.sl', PR.cur); if (!sl) return; const D = PR.deck; sl.style.transformOrigin = '0 0'; sl.style.transition = instant ? 'none' : 'transform .95s cubic-bezier(.6,0,.2,1)';
  if (!rect) sl.style.transform = ''; else { const z = Math.min(D.w / rect.w, D.h / rect.h) * .96; sl.style.transform = `translate(${D.w / 2 - (rect.x + rect.w / 2) * z}px,${D.h / 2 - (rect.y + rect.h / 2) * z}px) scale(${z})`; }
};
PR.spot = (rect, card) => {
  const sl = $('.sl', card || PR.cur); if (!sl) return; let sp = $('.cam-spot', sl);
  if (!rect || !(PR.deck.slides[(card && card.dataset && card.dataset.i != null) ? +card.dataset.i : PR.i] || {}).camSpot) { sp && (sp.style.opacity = 0); return; }
  if (!sp) { sp = h('div.cam-spot'); sl.appendChild(sp); }
