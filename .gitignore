  { k: 'health', n: 'Salute e benessere', sy: ['heartpulse', 'leaf', 'drop', 'sprout', 'sun', 'flower'], pals: [8, 2, 0, 3] },
  { k: 'sport', n: 'Sport e fitness', sy: ['dumbbell', 'flame', 'mountain', 'sun', 'play', 'bolt'], pals: [1, 6, 7, 0] },
  { k: 'art', n: 'Arte e creatività', sy: ['pencil', 'camera', 'flower', 'play', 'gem', 'moon'], pals: [3, 6, 9, 1] },
