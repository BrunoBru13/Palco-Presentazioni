};
const VID_FULL = { a: 1, dx: 0, dy: 0, sx: 1, sy: 1, rot: 0, blur: 0, clip: 1 };
/* at = secondi trascorsi da quando la pagina è entrata (negativo = animazioni non ancora partite) */
