ED.hoverLayer = (id, on) => { const n = ED.slEl && ED.nodeOf(id); if (n) n.classList.toggle('lhover', on); };
/* anteprima di un livello: la forma, l'immagine o l'aspetto del testo */
ED.layerThumb = (e) => {
  const box = h('span.lthumb');
  if (e.t === 'image' && e.src) box.appendChild(h('img', { src: Img.url(e.src, e.rc), alt: '', draggable: 'false' }));
  else if (e.t === 'image') box.appendChild(icn('image', 16));
  else if (e.t === 'text') { const col = e.c || '#888', dark = Col.parse(col) && Col.lum(Col.parse(col)) < .35; box.style.background = typeof e.bg === 'string' ? e.bg : dark ? '#E8EBF2' : '#2B3047'; box.appendChild(h('b', { style: { fontFamily: fontStack(e.f), color: col, fontWeight: R.weight ? R.weight(e) : 700 } }, 'Aa')); }
  else if (e.t === 'shape') {
    const f = typeof e.f === 'string' ? e.f : e.f && e.f.g ? e.f.g[0] : 'none', st = e.st ? e.st.c : 'none';
    if (e.k === 'line') box.appendChild(h('svg', { viewBox: '0 0 40 40', html: `<path d="M5 20H35" stroke="${e.st ? e.st.c : '#888'}" stroke-width="4" stroke-linecap="round"/>` }));
    else box.appendChild(h('svg', { viewBox: '0 0 100 100', preserveAspectRatio: 'xMidYMid meet', html: `<path d="${M.pathOf({ ...e, w: 100, h: 100, rad: e.rad })}" fill="${f}" stroke="${st}" stroke-width="${e.st ? 6 : 0}" fill-rule="evenodd"/>` }));
