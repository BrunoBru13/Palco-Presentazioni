/* ---------- codifica ---------- */
VID.size = (deck, res) => {
  let k = res / Math.min(deck.w, deck.h); const mx = Math.max(deck.w, deck.h) * k; if (mx > 1920) k *= 1920 / mx;
  return { k, W: Math.round(deck.w * k / 2) * 2, H: Math.round(deck.h * k / 2) * 2 };
};
VID.encode = async (deck, o, ui) => {
  await EX.loadScript('https://cdn.jsdelivr.net/npm/mp4-muxer@5.1.3/build/mp4-muxer.js');
  const { k, W, H } = VID.size(deck, o.res), fps = 30, n = deck.slides.length, total = n * o.sec, frames = Math.round(total * fps);
  const level = W * H > 1280 * 720 ? 'avc1.640028' : 'avc1.64001f';
  const vcfg = { codec: level, width: W, height: H, bitrate: o.res >= 1080 ? 7e6 : 3.5e6, framerate: fps, avc: { format: 'avc' } };
  if (!(await VideoEncoder.isConfigSupported(vcfg)).supported) throw new Error('codec');
  let aud = null;
  if (o.music && typeof AudioEncoder === 'function' && typeof AudioData === 'function') {
    for (const codec of ['mp4a.40.2', 'opus']) {
      const acfg = { codec, sampleRate: 44100, numberOfChannels: 2, bitrate: 128000 };
      try { if ((await AudioEncoder.isConfigSupported(acfg)).supported) { aud = { cfg: acfg, name: codec === 'opus' ? 'opus' : 'aac' }; break; } } catch (e) { }
    }
  }
  const muxer = new Mp4Muxer.Muxer({ target: new Mp4Muxer.ArrayBufferTarget(), video: { codec: 'avc', width: W, height: H }, ...(aud ? { audio: { codec: aud.name, numberOfChannels: 2, sampleRate: 44100 } } : {}), fastStart: 'in-memory' });
  let fail = null;
  const venc = new VideoEncoder({ output: (c, m) => muxer.addVideoChunk(c, m), error: e => { fail = e; } });
  venc.configure(vcfg);
  const out = VID.canvas(W, H), ctx = out.getContext('2d');
  const cache = new Map(), get = async i => { if (!cache.has(i)) { ui.set(.02 + .04 * Math.min(1, i / n), `Preparo la pagina ${i + 1} di ${n}…`); cache.set(i, await VID.layers(deck, deck.slides[i], i, k, W, H, o.anim)); } return cache.get(i); };
  const trOf = i => o.tr === 'auto' ? (deck.slides[i].tr || 'none') : o.tr;
  let lastKey = '';
  for (let f = 0; f < frames; f++) {
    if (ui.cancelled) { venc.close(); return null; }
    if (fail) throw fail;
    const t = f / fps, i = Math.min(n - 1, Math.floor(t / o.sec)), lt = t - i * o.sec, kind = i > 0 ? trOf(i) : 'none', td = kind === 'none' ? 0 : VID.TD;
    const Li = await get(i); cache.forEach((_, j) => { if (j < i - 1) cache.delete(j); });
    let key;
    if (i > 0 && lt < td) { key = 't' + f; const Lp = await get(i - 1); VID.transition(ctx, kind, Lp, Li, lt / td, W, H); }
    else { const at = lt - td; key = !Li.anim || at >= Li.end ? 'f' + i : 'a' + f; if (key !== lastKey || key[0] !== 'f') { VID.paint(ctx, Li, at); } }
    lastKey = key;
