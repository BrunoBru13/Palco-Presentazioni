    h('span.lgrip', { title: 'Trascina per cambiare l’ordine' }, icn('grip', 16)), ED.layerThumb(e), h('span.ln', ED.layerName(e)),
    h('button.ibtn.sm', { title: e.hd ? 'Mostra' : 'Nascondi', 'aria-label': 'Mostra o nascondi', onclick: ev => { ev.stopPropagation(); e.hd = e.hd ? 0 : 1; ED.refresh({ tb: false }); } }, icn(e.hd ? 'eyeOff' : 'eye', 16)),
    h('button.ibtn.sm', { title: e.lk ? 'Sblocca' : 'Blocca', 'aria-label': 'Blocca o sblocca', onclick: ev => { ev.stopPropagation(); e.lk = e.lk ? 0 : 1; ED.refresh({ tb: false }); } }, icn(e.lk ? 'lock' : 'unlock', 16)))));
  return list;
};

/* ---- barra delle pagine ---- */
ED.renderStrip = () => {
  const st = $('#strip'); if (!st) return;
  st.innerHTML = '';
  ED.deck.slides.forEach((s, i) => {
    const b = h('div.pg' + (i === ED.si ? '.on' : ''), { draggable: true, tabindex: 0, role: 'button', 'aria-label': 'Pagina ' + (i + 1), data: { i },
      onclick: () => ED.goto(i), onkeydown: e => { if (e.key === 'Enter') ED.goto(i); },
      oncontextmenu: e => { e.preventDefault(); ED.pageMenu(e.clientX, e.clientY, i); },
      ondragstart: e => { e.dataTransfer.setData('text/plain', String(i)); e.dataTransfer.effectAllowed = 'move'; },
      ondragover: e => { e.preventDefault(); b.classList.add('over'); }, ondragleave: () => b.classList.remove('over'),
      ondrop: e => { e.preventDefault(); b.classList.remove('over'); const from = +e.dataTransfer.getData('text/plain'); if (!isNaN(from)) ED.moveSlide(from, i); } },
      h('div.pgt', R.thumb(s, ED.deck)), h('span.pgn', String(i + 1)),
      h('button.pgm', { 'aria-label': 'Azioni pagina', onclick: e => { e.stopPropagation(); const r = e.currentTarget.getBoundingClientRect(); ED.pageMenu(r.left, r.top - 6, i, true); } }, icn('more', 16)));
    st.appendChild(b);
  });
  st.appendChild(h('button.pgadd', { title: 'Aggiungi una pagina', 'aria-label': 'Aggiungi una pagina', onclick: () => ED.addSlide() }, icn('plus', 24)));
  const on = $('.pg.on', st); on && on.scrollIntoView({ block: 'nearest', inline: 'nearest' });
  const pn = $('#pgno'); if (pn) pn.textContent = `Pagina ${ED.si + 1} di ${ED.deck.slides.length}`;
};
ED.updateThumb = (i) => {
  const b = $(`#strip .pg[data-i="${i}"] .pgt`); if (!b) return;
  const s = ED.deck.slides[i]; if (!s) return;
  b.replaceChildren(R.thumb(s, ED.deck, { idx: i }));
};
ED.pageMenu = (x, y, i) => {
  const a = h('span', { style: { position: 'fixed', left: x + 'px', top: y + 'px', width: '1px', height: '1px' } }); document.body.appendChild(a);
  const D = ED.deck, trs = [['none', 'Nessuna'], ['fade', 'Dissolvenza'], ['slide', 'Scorrimento'], ['zoom', 'Zoom']];
  const p = UI.menu(a, [
    { label: 'Aggiungi pagina dopo', icon: 'plus', onclick: () => ED.addSlide(null, i + 1) },
    { label: 'Duplica', icon: 'dup', onclick: () => ED.dupSlide(i) },
    { label: 'Sposta indietro', icon: 'arrowUp', disabled: i === 0, onclick: () => ED.moveSlide(i, i - 1) },
    { label: 'Sposta avanti', icon: 'arrowDown', disabled: i === D.slides.length - 1, onclick: () => ED.moveSlide(i, i + 1) },
    { sep: 1 }, { head: 'Transizione' },
    ...trs.map(([k, l]) => ({ label: l, on: (D.slides[i].tr || 'none') === k, onclick: () => { D.slides[i].tr = k; ED.commit(); } })),
    { sep: 1 }, { label: 'Elimina pagina', icon: 'trash', danger: true, onclick: () => ED.delSlide(i) }]);
  const old = p.onclose; p.onclose = () => { a.remove(); old && old(); };
};

/* ============ Barra delle pagine con selezione multipla ============ */
ED.ssel = []; ED.selMode = false;
ED._goto = ED.goto;
ED.goto = (i) => { ED._goto(i); if (!ED.ssel.includes(ED.si)) ED.ssel = []; if (!ED.ssel.length) ED.selMode = false; ED.renderSbar(); };
/* seleziona o deseleziona una pagina: pressione prolungata, oppure tocco quando la selezione è già attiva */
ED.selToggle = (i, press) => {
  const set = new Set(ED.ssel.length ? ED.ssel : press ? [] : [ED.si]); set.has(i) ? set.delete(i) : set.add(i);
  ED.ssel = [...set].sort((a, b) => a - b); ED.selMode = ED.ssel.length > 0; ED._lpIdx = i;
  if (ED.ssel.includes(i)) ED._goto(i);
  ED.renderStrip(); ED.renderSbar();
};
ED.targets = (i) => (ED.ssel.length > 1 && ED.ssel.includes(i)) ? ED.ssel.slice().sort((a, b) => a - b) : [i];

ED.dupSlides = (idxs) => {
  const D = ED.deck; let off = 0;
  idxs.forEach(i => { const s = clone(D.slides[i + off]); s.id = uid('s_'); s.els.forEach(e => e.id = uid('e')); D.slides.splice(i + off + 1, 0, s); off++; });
  ED.ssel = []; ED.si = clamp(idxs[0] + 1, 0, D.slides.length - 1); ED.sel = [];
  ED.renderAll(); ED.commit(); toast(idxs.length > 1 ? idxs.length + ' pagine duplicate' : 'Pagina duplicata', { ms: 1200 });
};
ED.delSlides = (idxs) => {
  const D = ED.deck, set = new Set(idxs);
  D.slides = D.slides.filter((s, i) => !set.has(i));
  if (!D.slides.length) D.slides = [M.newSlide()];
  ED.ssel = []; ED.si = clamp(Math.min(...idxs), 0, D.slides.length - 1); ED.sel = [];
  ED.renderAll(); ED.commit();
};
/* sposta un blocco di pagine prima della posizione "to" (indice nella lista originale) */
ED.moveSlides = (idxs, to) => {
  const D = ED.deck, set = new Set(idxs), moving = D.slides.filter((s, i) => set.has(i)), rest = [];
  let at = 0;
  D.slides.forEach((s, i) => { if (i === to) at = rest.length; if (!set.has(i)) rest.push(s); });
  if (to >= D.slides.length) at = rest.length;
  rest.splice(at, 0, ...moving);
  D.slides = rest; ED.si = at; ED.ssel = moving.length > 1 ? moving.map((_, k) => at + k) : [];
  ED.sel = []; ED.renderAll(); ED.commit();
};
ED.shiftSlides = (idxs, d) => {
  const first = idxs[0], last = idxs[idxs.length - 1];
  if (d < 0 && first === 0) return; if (d > 0 && last === ED.deck.slides.length - 1) return;
  ED.moveSlides(idxs, d < 0 ? first - 1 : last + 2);
};
ED.setTransition = (idxs, tr) => { idxs.forEach(i => { ED.deck.slides[i].tr = tr; }); ED.commit(); ED.renderCtx(); ED.renderSbar(); };

ED.renderSbar = () => {
  const b = $('#sbar'); if (!b) return;
  b.innerHTML = '';
  const n = ED.ssel.length; b.hidden = !(n >= 2 || (ED.selMode && n >= 1));
  if (b.hidden) return;
  const idx = ED.targets(ED.ssel[0]);
  const trs = [['none', 'Nessuna'], ['fade', 'Dissolvenza'], ['slide', 'Scorrimento'], ['zoom', 'Zoom']];
  b.append(h('b', n === 1 ? '1 pagina selezionata' : `${n} pagine selezionate`),
    h('button.btn.sm', { onclick: () => ED.dupSlides(idx) }, icn('dup', 16), 'Duplica'),
    h('button.btn.sm', { onclick: e => UI.menu(e.currentTarget, trs.map(([k, l]) => ({ label: l, onclick: () => ED.setTransition(idx, k) }))) }, icn('film', 16), 'Transizione'),
    h('button.btn.sm', { onclick: () => ED.shiftSlides(idx, -1) }, icn('chevL', 16), 'Indietro'),
    h('button.btn.sm', { onclick: () => ED.shiftSlides(idx, 1) }, icn('chevR', 16), 'Avanti'),
    h('button.btn.sm', { onclick: () => UI.confirm(n === 1 ? 'Eliminare la pagina?' : 'Eliminare le pagine?', n === 1 ? 'La pagina verrà eliminata. Puoi annullare con Ctrl+Z.' : `Verranno eliminate ${n} pagine. Puoi annullare con Ctrl+Z.`, 'Elimina', () => ED.delSlides(idx)) }, icn('trash', 16), 'Elimina'),
    h('span.grow'), h('button.btn.sm.ghost', { onclick: () => { ED.ssel = []; ED.selMode = false; ED.renderStrip(); ED.renderSbar(); } }, 'Deseleziona'));
};

ED.renderStrip = (target) => {
  const st = target || $('#strip'); if (!st) return;
  st.innerHTML = ''; if (!ED.ssel.length) ED.selMode = false;
  ED.deck.slides.forEach((s, i) => {
    const multi = ED.ssel.includes(i) && (ED.ssel.length > 1 || ED.selMode);
    const b = h('div.pg', { class: (i === ED.si ? 'on ' : '') + (multi ? 'sel ' : '') + (ED._lpIdx === i ? 'lpop' : ''), draggable: true, tabindex: 0, role: 'button', 'aria-label': 'Pagina ' + (i + 1), 'aria-pressed': multi ? 'true' : 'false', data: { i },
      onclick: e => {
        if (UI.lpHold) return;
        if (ED.selMode && !e.shiftKey) { ED.selToggle(i); return; }
        if (e.ctrlKey || e.metaKey) {
          const set = new Set(ED.ssel.length ? ED.ssel : [ED.si]); set.has(i) ? set.delete(i) : set.add(i);
          ED.ssel = [...set].sort((a, b2) => a - b2); if (!ED.ssel.length) ED.ssel = [i];
          if (ED.ssel.includes(i)) ED._goto(i); ED.renderStrip(); ED.renderSbar(); return;
        }
        if (e.shiftKey) { const a = Math.min(ED.si, i), z = Math.max(ED.si, i); ED.ssel = Array.from({ length: z - a + 1 }, (_, k) => a + k); ED.renderStrip(); ED.renderSbar(); return; }
        ED.ssel = []; ED.goto(i);
      },
      onkeydown: e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); ED.ssel = []; ED.goto(i); } },
      oncontextmenu: e => { e.preventDefault(); if (UI.lpHold || Date.now() - UI.lpAt < 900) return; ED.pageMenu(e.clientX, e.clientY, i); },
      ondragstart: e => { if (UI.lpHold) { e.preventDefault(); return; } e.dataTransfer.setData('text/plain', JSON.stringify(ED.targets(i))); e.dataTransfer.effectAllowed = 'move'; },
      ondragover: e => { e.preventDefault(); b.classList.add('over'); }, ondragleave: () => b.classList.remove('over'),
      ondrop: e => { e.preventDefault(); b.classList.remove('over'); try { const from = JSON.parse(e.dataTransfer.getData('text/plain')); if (Array.isArray(from) && !from.includes(i)) ED.moveSlides(from, i > from[0] ? i + 1 : i); } catch (er) { } } },
      h('div.pgt', R.thumb(s, ED.deck, { idx: i })), h('span.pgn', String(i + 1)), multi ? h('span.pgck', icn('check', 14)) : null,
      h('button.pgm', { 'aria-label': 'Azioni pagina', onclick: e => { e.stopPropagation(); const r = e.currentTarget.getBoundingClientRect(); ED.pageMenu(r.left, r.top - 6, i); } }, icn('more', 16)));
    UI.longPress(b, () => ED.selToggle(i, true));
    st.appendChild(b);
  });
  ED._lpIdx = -1;
  st.appendChild(h('button.pgadd', { title: 'Aggiungi una pagina', 'aria-label': 'Aggiungi una pagina', onclick: () => ED.addSlide() }, icn('plus', 24)));
  const on = $('.pg.on', st); on && on.scrollIntoView({ block: 'nearest', inline: 'nearest' });
  const pn = $('#pgno'); if (pn) pn.textContent = `Pagina ${ED.si + 1} di ${ED.deck.slides.length}`;
  if (!target) { ED.renderSbar(); if (ED.gridOn) ED.renderGrid(); }
};
ED.pageMenu = (x, y, i) => {
  const a = h('span', { style: { position: 'fixed', left: x + 'px', top: y + 'px', width: '1px', height: '1px' } }); document.body.appendChild(a);
  const D = ED.deck, idx = ED.targets(i), n = idx.length, many = n > 1;
  const trs = [['none', 'Nessuna'], ['fade', 'Dissolvenza'], ['slide', 'Scorrimento'], ['zoom', 'Zoom']];
  const first = idx[0], last = idx[n - 1];
  const p = UI.menu(a, [
    { label: 'Aggiungi pagina dopo', icon: 'plus', onclick: () => ED.addSlide(null, last + 1) },
    { label: many ? `Duplica ${n} pagine` : 'Duplica', icon: 'dup', onclick: () => ED.dupSlides(idx) },
    { label: many ? 'Sposta indietro' : 'Sposta indietro', icon: 'arrowUp', disabled: first === 0, onclick: () => ED.shiftSlides(idx, -1) },
    { label: 'Sposta avanti', icon: 'arrowDown', disabled: last === D.slides.length - 1, onclick: () => ED.shiftSlides(idx, 1) },
    { label: 'Seleziona tutte le pagine', icon: 'check', onclick: () => { ED.ssel = D.slides.map((_, k) => k); ED.selMode = true; ED.renderStrip(); ED.renderSbar(); } },
    { sep: 1 }, { head: many ? `Transizione (${n} pagine)` : 'Transizione' },
    ...trs.map(([k, l]) => ({ label: l, on: idx.every(j => (D.slides[j].tr || 'none') === k), onclick: () => ED.setTransition(idx, k) })),
    { sep: 1 }, { label: many ? `Elimina ${n} pagine` : 'Elimina pagina', icon: 'trash', danger: true, onclick: () => ED.delSlides(idx) }]);
  const old = p.onclose; p.onclose = () => { a.remove(); old && old(); };
};

/* ============ Pannello Elementi con categorie (Forme, Simboli, Adesivi, Cornici, Moduli...) ============ */
ED.elView = null; ED.qzStyle = 'pastel';
ED.SYMBOL_NAMES = { check: 'Spunta', close: 'Croce', star: 'Stella', heart: 'Cuore', home: 'Casa', person: 'Persona', mail: 'Posta', phone: 'Telefono', bulb: 'Idea', arrowR: 'Freccia', pin: 'Posizione', bars: 'Grafico', clock: 'Orologio', like: 'Mi piace', bolt: 'Fulmine', search: 'Cerca', cloud: 'Nuvola', flag: 'Bandiera', lock: 'Lucchetto', trend: 'Crescita', globe: 'Mondo', target: 'Obiettivo' };
ED.ELCATS = [
  ['forme', 'Forme', 'shapes', () => M.SHAPE_LIST.length + ' forme'], ['simboli', 'Simboli', 'star', () => M.ICON_LIST.length + ' icone'], ['adesivi', 'Adesivi', 'smile', () => M.EMOJI.length + ' adesivi'],
  ['cornici', 'Cornici', 'image', () => 'Trascina una foto'], ['moduli', 'Moduli', 'quiz', () => 'Quiz interattivi'], ['grafici', 'Grafici', 'chart', () => '4 tipi'],
  ['tabelle', 'Tabelle', 'table', () => '3 misure'], ['linee', 'Linee e frecce', 'minus', () => '3 stili'], ['disegna', 'Disegna', 'pen', () => 'A mano libera'], ['qr', 'Codice QR', 'grid', () => 'Da un link']
];
ED.shapeBtn = (k, name) => h('button.eb', { title: name, 'aria-label': name, onclick: () => ED.addShape(k) }, h('svg', { viewBox: '0 0 100 100', width: 44, height: 44, html: `<path d="${M.pathOf({ k, w: 100, h: 100, rad: null })}" fill="currentColor" fill-rule="evenodd"/>` }));
ED.symbolBtn = (n) => h('button.eb', { title: ED.SYMBOL_NAMES[n] || n, 'aria-label': ED.SYMBOL_NAMES[n] || n, onclick: () => ED.addIcon(n) }, h('svg', { viewBox: '0 0 24 24', width: 34, height: 34, html: `<path d="${ICON_PATHS[n]}" fill="currentColor"/>` }));

ED.panels.elements = () => {
  const q = h('input.inp.sm', { type: 'search', placeholder: 'Cerca forme e simboli', 'aria-label': 'Cerca elementi' });
  const body = h('div');
  const draw = () => {
    body.innerHTML = '';
    const f = q.value.trim().toLowerCase();
    if (f) {
      const shapes = M.SHAPE_LIST.filter(s => s[1].toLowerCase().includes(f)), icons = M.ICON_LIST.filter(n => (ED.SYMBOL_NAMES[n] || n).toLowerCase().includes(f) || n.includes(f));
      if (shapes.length) body.appendChild(psec('Forme', h('div.egrid', shapes.map(s => ED.shapeBtn(s[0], s[1])))));
      if (icons.length) body.appendChild(psec('Simboli', h('div.egrid', icons.map(ED.symbolBtn))));
      if (!shapes.length && !icons.length) body.appendChild(h('p.pempty', 'Nessun elemento trovato'));
      return;
    }
    if (!ED.elView) {
      body.appendChild(h('div.catgrid', ED.ELCATS.map(([k, n, ic, sub]) => h('button.cat', { onclick: () => { ED.elView = k; ED.renderPanel(); } }, h('span.cati', icn(ic, 24)), h('b', n), h('small', sub())))));
      return;
    }
    const cat = ED.ELCATS.find(c => c[0] === ED.elView);
    body.appendChild(h('button.subback', { onclick: () => { ED.elView = null; ED.renderPanel(); } }, icn('back', 18), h('b', cat[1])));
    const v = ED.elView;
    if (v === 'forme') body.appendChild(h('div.egrid', M.SHAPE_LIST.map(s => ED.shapeBtn(s[0], s[1]))));
    else if (v === 'simboli') body.appendChild(h('div.egrid', M.ICON_LIST.map(ED.symbolBtn)));
    else if (v === 'adesivi') body.appendChild(h('div.egrid.emo', M.EMOJI.map(ch => h('button.eb', { onclick: () => ED.addEmoji(ch) }, ch))));
    else if (v === 'linee') body.appendChild(h('div.egrid.l3', [['Linea', 0, 0], ['Freccia', 1, 0], ['Tratteggiata', 0, 1]].map(([n, ar, d]) => h('button.eb.wide', { title: n, onclick: () => ED.addLine(ar, d) }, h('svg', { viewBox: '0 0 90 20', width: 80, height: 20, html: `<path d="M4 10H${ar ? 74 : 86}" stroke="currentColor" stroke-width="4" fill="none" ${d ? 'stroke-dasharray="8 6"' : ''}/>${ar ? '<path d="M72 3 87 10 72 17z" fill="currentColor"/>' : ''}` })))));
    else if (v === 'grafici') body.appendChild(h('div.egrid.l2', [['bar', 'Barre'], ['line', 'Linee'], ['pie', 'Torta'], ['donut', 'Ciambella']].map(([k, n]) => h('button.eb.card', { onclick: () => ED.addChart(k) }, h('svg', { viewBox: '0 0 24 24', width: 30, height: 30, html: k === 'bar' || k === 'line' ? `<path d="${ICON_PATHS[k === 'bar' ? 'bars' : 'trend']}" fill="currentColor"/>` : `<path d="M12 2a10 10 0 1 0 10 10H12z" fill="currentColor"/><path d="M14 2.2V10h7.8A10 10 0 0 0 14 2.2z" fill="currentColor" opacity=".5"/>` }), h('span', n)))));
    else if (v === 'tabelle') body.appendChild(h('div.egrid.l3', [[3, 2], [4, 3], [5, 4]].map(([r, c]) => h('button.eb.card', { onclick: () => ED.addTable(r, c) }, h('span.tmini', { style: { gridTemplateColumns: `repeat(${c},1fr)` } }, Array.from({ length: r * c }, (_, i) => h('i' + (i < c ? '.hd' : '')))), h('span', `${c}×${r}`)))));
    else if (v === 'disegna') body.append(h('button.btn.full' + (ED.draw.on ? '.primary' : ''), { onclick: () => { ED.toggleDraw(); ED.renderPanel(); } }, icn('pen', 18), ED.draw.on ? 'Disegno attivo: clicca “Fine” sulla barra' : 'Disegna a mano libera'), h('p.hint2', 'Pennarello, evidenziatore e matita. Ogni tratto diventa un elemento che puoi spostare e ricolorare.'));
    else if (v === 'qr') body.append(h('button.btn.full', { onclick: () => ED.qrDialog() }, icn('grid', 18), 'Crea un codice QR'), h('p.hint2', 'Scrivi un indirizzo o un testo: il codice si può ricolorare.'));
    else if (v === 'cornici') {
      body.append(h('p.hint2', 'Aggiungi una cornice, poi trascina una foto sopra: la foto si ritaglia nella forma. Fai doppio clic sulla foto per spostarla o ingrandirla dentro la cornice.'),
        h('div.egrid', ED.FRAMES.map(k => h('button.eb', { title: (M.SHAPE_LIST.find(s => s[0] === k) || [k, k])[1], onclick: () => ED.addFrame(k) }, h('svg', { viewBox: '0 0 100 100', width: 40, height: 40, html: `<path d="${M.pathOf({ k, w: 100, h: 100, rad: null })}" fill="currentColor" opacity=".55"/>` })))));
    } else if (v === 'moduli') {
      const styleRow = h('div.qzstyles', Object.entries(QZ.STYLES).map(([k, s]) => h('button.qzs' + (ED.qzStyle === k ? '.on' : ''), { title: s.n, 'aria-label': s.n, onclick: () => { ED.qzStyle = k; ED.renderPanel(); } }, h('span', { style: { background: s.bg } }, h('i', { style: { background: s.ob } }), h('i', { style: { background: s.ok } }), h('i', { style: { background: s.ac } })))));
      const card = (mode, title, desc) => { const s = QZ.STYLES[ED.qzStyle]; return h('button.qzcard', { onclick: () => ED.addQuiz(mode) }, h('span.qzprev', { style: { background: s.bg, borderColor: s.bd || 'transparent' } }, h('i.qq', { style: { background: s.qc } }), h('i.qa', { style: { background: s.ob } }), h('i.qa.on', { style: { background: s.ok } }), h('i.qa', { style: { background: s.ob } })), h('b', title), h('small', desc)); };
      body.append(h('p.hint2', 'Crea domande da completare a tutto schermo: chi guarda risponde e vede subito se ha sbagliato, con la risposta corretta.'), h('div.cph', 'Stile'), styleRow,
        card('single', 'Scelta singola', 'Una sola risposta giusta'), card('tf', 'Vero o falso', 'Due risposte'), card('multi', 'Più risposte', 'Possono essere giuste più risposte'));
    }
  };
  q.addEventListener('input', draw); draw();
  return [h('div.psearch', q), body];
};

/* ============ Animazioni degli elementi (come in Canva: entrata, uscita, ripetuta) ============ */
const ANIM = {
  in: [['', 'Nessuna'], ['fade', 'Dissolvenza'], ['rise', 'Sale'], ['drop', 'Scende'], ['left', 'Da sinistra'], ['right', 'Da destra'], ['zoom', 'Ingrandisci'], ['pop', 'Rimbalzo'], ['blur', 'Sfocatura'], ['write', 'Scrittura'], ['flip', 'Ribalta'], ['tada', 'Tada'], ['count', 'Conta i numeri'], ['type', 'Macchina da scrivere']],
  out: [['', 'Nessuna'], ['fade', 'Dissolvenza'], ['sink', 'Scende'], ['up', 'Sale'], ['left', 'A sinistra'], ['right', 'A destra'], ['shrink', 'Rimpicciolisci']],
  loop: [['', 'Nessuna'], ['pulse', 'Pulsazione'], ['float', 'Fluttua'], ['wiggle', 'Oscilla'], ['spin', 'Gira'], ['blink', 'Lampeggia']],
  page: [['', 'Nessuna'], ['fade', 'Dissolvenza'], ['rise', 'Sale'], ['left', 'Da sinistra'], ['zoom', 'Ingrandisci'], ['pop', 'Rimbalzo'], ['blur', 'Sfocatura']],
  speed: v => v === 's' ? 1.7 : v === 'f' ? .6 : 1
};
R.hasAnim = e => !!(e.an || e.ao || e.al);
R.animAttrs = e => ` data-an="${e.an || ''}" data-ao="${e.ao || ''}" data-al="${e.al || ''}" data-sp="${e.asp || ''}"`;
/* applica entrata + ripetizione al primo figlio dell'elemento DOM; ritorna il ritardo successivo */
R.playIn = (node, delay) => {
  const c = node.firstElementChild; if (!c) return delay;
  const d = node.dataset, k = ANIM.speed(d.sp), dur = .75 * k, parts = []; let extra = 0;
  if (d.an === 'count' || d.an === 'type') { const t = node.classList.contains('el-text') ? R.playText(node, d.an, delay, k) : 0; parts.push(`an-fade ${(t ? .4 : dur).toFixed(2)}s ease-out ${delay.toFixed(2)}s both`); extra = d.an === 'type' ? t * .9 : 0; }
  else if (d.an) parts.push(`an-${d.an} ${dur.toFixed(2)}s cubic-bezier(.2,.8,.25,1) ${delay.toFixed(2)}s both`);
  if (d.al) parts.push(`al-${d.al} ${d.al === 'spin' ? 6 : 1.8}s ${d.al === 'spin' ? 'linear' : 'ease-in-out'} ${(d.an ? delay + dur : 0).toFixed(2)}s infinite`);
  c.style.animation = parts.join(',');
  return d.an ? delay + .16 * k + extra : delay;
};
/* animazioni di testo fatte con il codice: i numeri contano fino al valore, il testo si scrive a macchina */
R.playText = (node, kind, delay, k) => {
  const tx = node.querySelector('.tx'); if (!tx) return 0;
  const walker = document.createTreeWalker(tx, NodeFilter.SHOW_TEXT), nodes = []; let nd; while ((nd = walker.nextNode())) nodes.push({ n: nd, t: nd.nodeValue });
  if (kind === 'type') {
    const total = nodes.reduce((a, o) => a + o.t.length, 0); if (!total) return 0; const dur = Math.min(5, Math.max(.7, total * .036)) * k;
    nodes.forEach(o => { o.n.nodeValue = ''; });
    setTimeout(() => { const t0 = performance.now(), step = () => { if (!tx.isConnected) return; const p = Math.min(1, (performance.now() - t0) / (dur * 1000)); let shown = Math.floor(p * total); nodes.forEach(o => { o.n.nodeValue = o.t.slice(0, Math.max(0, Math.min(o.t.length, shown))); shown -= o.t.length; }); if (p < 1) requestAnimationFrame(step); }; step(); }, delay * 1000);
    return dur;
  }
  const RX = /\d{1,3}(?:\.\d{3})+(?:,\d+)?|\d+(?:[.,]\d+)?/g, items = [];
  nodes.forEach(o => {
    const parts = []; let last = 0, m; RX.lastIndex = 0;
    while ((m = RX.exec(o.t))) {
      const s = m[0], prev = o.t[m.index - 1], next = o.t[m.index + s.length];
      if (/[\/:\-]/.test(prev || '') && /\d/.test(o.t[m.index - 2] || '') || /[\/:]/.test(next || '') || (/^\d{4}$/.test(s) && +s >= 1900 && +s <= 2100)) continue;
      const th = /^\d{1,3}(\.\d{3})+(,\d+)?$/.test(s), ds = th ? ',' : /^\d+,\d+$/.test(s) ? ',' : /^\d+\.\d+$/.test(s) ? '.' : '', dec = ds ? (s.split(ds)[1] || '').length : 0, v = parseFloat(s.replace(th ? /\./g : /$^/, '').replace(',', '.'));
      parts.push({ pre: o.t.slice(last, m.index), v, th, ds, dec }); last = m.index + s.length;
    }
    if (parts.length) items.push({ n: o.n, parts, tail: o.t.slice(last) });
  });
  if (!items.length) return 0;
  const fmt = (p, x) => { let s = x.toFixed(p.dec); if (p.ds) s = s.replace('.', p.ds); if (p.th) { const [a, b] = s.split(p.ds || '.'); s = a.replace(/\B(?=(\d{3})+(?!\d))/g, '.') + (b != null ? p.ds + b : ''); } return s; };
  const paint = e => items.forEach(it => { it.n.nodeValue = it.parts.map(p => p.pre + fmt(p, p.v * e)).join('') + it.tail; });
  paint(0); const dur = 1.5 * k;
  setTimeout(() => { const t0 = performance.now(), step = () => { if (!tx.isConnected) return; const p = Math.min(1, (performance.now() - t0) / (dur * 1000)); paint(1 - Math.pow(1 - p, 3)); if (p < 1) requestAnimationFrame(step); }; step(); }, delay * 1000);
  return dur;
};
R.playOut = (node) => { const c = node.firstElementChild; if (!c || !node.dataset.ao) return false; c.style.animation = `ao-${node.dataset.ao} ${(.45 * ANIM.speed(node.dataset.sp)).toFixed(2)}s ease-in both`; return true; };

/* anteprima nell'editor sugli elementi selezionati */
ED.previewAnim = () => {
  const els = ED.selEls(); let delay = .1;
  const nodes = els.map(e => ED.nodeOf(e.id)).filter(Boolean);
  nodes.forEach((n, i) => { const e = els[i]; Object.assign(n.dataset, { an: e.an || '', ao: e.ao || '', al: e.al || '', sp: e.asp || '' }); });
  nodes.forEach(n => { delay = R.playIn(n, delay); });
  const longest = Math.max(...els.map(e => ANIM.speed(e.asp) * .75)) + delay + 1.2;
  clearTimeout(ED._pv);
  ED._pv = setTimeout(() => {
    nodes.forEach(n => {
      if (n.dataset.ao) { R.playOut(n); }
      else if (n.firstElementChild) n.firstElementChild.style.animation = '';
    });
    setTimeout(() => nodes.forEach(n => n.firstElementChild && (n.firstElementChild.style.animation = '')), 900);
  }, longest * 1000 * (els.some(e => e.al) ? 1.4 : 1));
};
ED.stopPreview = () => { clearTimeout(ED._pv); $$('.el > *', ED.slEl).forEach(c => { c.style.animation = ''; }); };

/* applica una entrata a tutti gli elementi della pagina, in cascata */
ED.animatePage = (type) => {
  ED.slide().els.forEach(e => { if (type) e.an = type; else delete e.an; });
  ED.commit(); ED.renderCtx();
  if (type) { ED.select(ED.slide().els.map(e => e.id)); ED.previewAnim(); ED.select([]); }
};

/* ============ Editor: tela, selezione e interazioni ============ */
ED.pt = e => { const r = ED.swrap.getBoundingClientRect(); return { x: (e.clientX - r.left) / ED.zoom, y: (e.clientY - r.top) / ED.zoom }; };
ED.nodeOf = id => ED.slEl.querySelector(`[data-id="${id}"]`);
ED.refreshNode = e => {
  const n = ED.nodeOf(e.id); if (!n) return;
  const t = document.createElement('div'); t.innerHTML = R.elHTML(e, ED.deck, {});
  const nn = t.firstChild; n.replaceWith(nn);
  if (e.t === 'text') { const hh = nn.firstChild.offsetHeight; e.h = hh; nn.style.height = hh + 'px'; }
};

ED.initCanvas = () => {
  const cw = ED.cwrap;
  cw.addEventListener('pointerdown', ED.onDown);
  cw.addEventListener('dblclick', ED.onDbl);
  cw.addEventListener('contextmenu', ED.onCtxMenu);
  cw.addEventListener('wheel', e => {
    if (!(e.ctrlKey || e.metaKey)) return;
    e.preventDefault(); ED.setZoom(ED.zoom * Math.exp(-e.deltaY * .0016), false);
  }, { passive: false });
  cw.addEventListener('dragover', e => e.preventDefault());
  cw.addEventListener('drop', e => { e.preventDefault(); const fs = [...(e.dataTransfer.files || [])].filter(f => /^image\//.test(f.type)); if (fs.length && !ED._onDropFiles(e, fs)) ED.uploadImages(fs); });
};

/* ---- selezione e sovrapposizione ---- */
const HANDLE_SETS = { all: ['nw', 'n', 'ne', 'e', 'se', 's', 'sw', 'w'], text: ['nw', 'ne', 'se', 'sw', 'e', 'w'], line: ['e', 'w'], multi: ['nw', 'ne', 'se', 'sw'] };
ED.renderOverlay = () => {
  const ov = ED.ov; if (!ov) return;
  ov.innerHTML = '';
  const els = ED.selEls().filter(e => !e.hd);
  const frame = (b, r, cls) => h('div.sf', { class: cls || '', style: { left: b.x + 'px', top: b.y + 'px', width: b.w + 'px', height: b.h + 'px', transform: r ? `rotate(${r}deg)` : '' } });
  els.forEach(e => { const f = frame(e, e.r, (els.length > 1 ? 'thin ' : '') + (e.k === 'line' ? 'ln' : '') + (e.lk ? ' locked' : '')); ov.appendChild(f); });
  if (els.length === 1 && !els[0].lk && !ED.editing && !ED.cellEdit) {
    const e = els[0], f = ov.lastChild;
    const set = e.t === 'text' ? HANDLE_SETS.text : e.k === 'line' ? HANDLE_SETS.line : e.t === 'group' ? HANDLE_SETS.multi : HANDLE_SETS.all;
    set.forEach(k => f.appendChild(h('div.hd', { data: { h: k } })));
    if (e.k !== 'line') f.appendChild(h('div.hd.rot', { data: { h: 'rot' } }, icn('rotate', 12)));
  } else if (els.length > 1) {
    const b = M.unionBox(els), f = frame(b, 0, 'grp');
    if (!els.some(e => e.lk)) HANDLE_SETS.multi.forEach(k => f.appendChild(h('div.hd', { data: { h: k } })));
    ov.appendChild(f);
  }
  (ED.guides || []).forEach(g => ov.appendChild(h('div.guide' + (g.x != null ? '.v' : '.h'), { style: g.x != null ? { left: g.x + 'px' } : { top: g.y + 'px' } })));
  if (ED.mq) ov.appendChild(h('div.mq', { style: { left: ED.mq.x + 'px', top: ED.mq.y + 'px', width: ED.mq.w + 'px', height: ED.mq.h + 'px' } }));
};

/* ---- puntatore ---- */
ED.onDown = e => {
  if (e.button !== 0) return;
  const t = e.target;
  if (ED.draw && ED.draw.on) { if (t.closest('.swrap') || t.closest('.cwrap')) { e.preventDefault(); ED.startDraw(e); } return; }
  if (ED.editing) { if (t.closest(`.el[data-id="${ED.editing}"]`)) return; ED.endEdit(); }
  if (ED.cellEdit) { if (t.closest('.tc[contenteditable]')) return; ED.endCellEdit(); }
  if (t.closest('.hd')) return ED.startHandle(e, t.closest('.hd').dataset.h);
  const n = t.closest('.sl > .el');
  if (n) {
    const id = n.dataset.id;
    if (ED.painter) { e.preventDefault(); ED.applyPainter(id); return; }
    if (e.shiftKey) { ED.select(ED.sel.includes(id) ? ED.sel.filter(i => i !== id) : [...ED.sel, id]); return; }
    if (!ED.sel.includes(id)) ED.select([id]);
    ED.startMove(e);
  } else if (t.closest('.swrap') || t.closest('.cwrap')) {
    if (!e.shiftKey && ED.sel.length) ED.select([]);
    ED.startMarquee(e);
  }
};
const trackDrag = (move, up) => {
  const mv = ev => move(ev);
  const end = ev => { window.removeEventListener('pointermove', mv); window.removeEventListener('pointerup', end); window.removeEventListener('pointercancel', end); up(ev); };
  window.addEventListener('pointermove', mv); window.addEventListener('pointerup', end); window.addEventListener('pointercancel', end);
};
ED.snapMove = (box, dx, dy, others) => {
  const D = ED.deck, thr = 7 / ED.zoom, xs = [0, D.w / 2, D.w], ys = [0, D.h / 2, D.h], guides = [];
  others.forEach(o => { const b = M.aabb(o); xs.push(b.x, b.x + b.w / 2, b.x + b.w); ys.push(b.y, b.y + b.h / 2, b.y + b.h); });
  const best = (mine, cands) => { let r = null; mine.forEach(m => cands.forEach(c => { const d = c - m; if (Math.abs(d) < thr && (!r || Math.abs(d) < Math.abs(r.d))) r = { d, at: c }; })); return r; };
  const bx = best([box.x + dx, box.x + box.w / 2 + dx, box.x + box.w + dx], xs), by = best([box.y + dy, box.y + box.h / 2 + dy, box.y + box.h + dy], ys);
  if (bx) { dx += bx.d; guides.push({ x: bx.at }); }
  if (by) { dy += by.d; guides.push({ y: by.at }); }
  return { dx, dy, guides };
};
ED.startMove = (e) => {
  const els = ED.selEls().filter(x => !x.lk); if (!els.length) return;
  const p0 = ED.pt(e), orig = els.map(x => ({ x: x.x, y: x.y })), box = M.unionBox(els);
  const others = ED.slide().els.filter(x => !ED.sel.includes(x.id) && !x.hd);
  let moved = false;
  trackDrag(ev => {
    const p = ED.pt(ev); let dx = p.x - p0.x, dy = p.y - p0.y;
    if (!moved && Math.hypot(dx, dy) * ED.zoom < 4) return;
    moved = true;
    if (ev.shiftKey) { if (Math.abs(dx) > Math.abs(dy)) dy = 0; else dx = 0; }
    const s = ev.altKey ? { dx, dy, guides: [] } : ED.snapMove(box, dx, dy, others);
    els.forEach((x, i) => { x.x = Math.round(orig[i].x + s.dx); x.y = Math.round(orig[i].y + s.dy); const n = ED.nodeOf(x.id); if (n) { n.style.left = x.x + 'px'; n.style.top = x.y + 'px'; } });
    ED.guides = s.guides; ED.renderOverlay();
  }, () => { ED.guides = null; ED.renderOverlay(); if (moved) { ED.afterMove && ED.afterMove(els); ED.renderStage(); ED.renderOverlay(); ED.updateThumb(ED.si); ED.renderCtx(); ED.commit(); } });
};
ED.startMarquee = (e) => {
  const p0 = ED.pt(e), base = e.shiftKey ? ED.sel.slice() : [];
  let moved = false;
  trackDrag(ev => {
    const p = ED.pt(ev);
    if (!moved && Math.hypot(p.x - p0.x, p.y - p0.y) * ED.zoom < 4) return;
    moved = true;
    const r = { x: Math.min(p.x, p0.x), y: Math.min(p.y, p0.y), w: Math.abs(p.x - p0.x), h: Math.abs(p.y - p0.y) };
    ED.mq = r;
    const hit = ED.slide().els.filter(x => { if (x.hd || x.lk) return false; const b = M.aabb(x); return b.x < r.x + r.w && b.x + b.w > r.x && b.y < r.y + r.h && b.y + b.h > r.y; }).map(x => x.id);
    ED.sel = [...new Set([...base, ...hit])]; ED.renderOverlay();
  }, () => { ED.mq = null; ED.renderOverlay(); ED.renderCtx(); if (ED.panel === 'layers') ED.renderPanel(); });
};
ED.startRotate = (ev, e) => {
  ev.preventDefault();
  const cx = e.x + e.w / 2, cy = e.y + e.h / 2;
  trackDrag(m => {
    const p = ED.pt(m); let a = Math.atan2(p.y - cy, p.x - cx) * 180 / Math.PI + 90;
    if (m.shiftKey) a = Math.round(a / 15) * 15; else { const q = Math.round(a / 45) * 45; if (Math.abs(a - q) < 3) a = q; }
    a = ((Math.round(a) + 180) % 360 + 360) % 360 - 180; e.r = a;
    const n = ED.nodeOf(e.id); if (n) n.style.transform = `rotate(${a}deg)`;
    ED.renderOverlay();
  }, () => { ED.updateThumb(ED.si); ED.renderCtx(); ED.commit(); });
};
ED.startHandle = (ev, hn) => {
  ev.preventDefault();
  const els = ED.selEls(); if (!els.length) return;
  if (hn === 'rot') return ED.startRotate(ev, els[0]);
  const SX = { nw: -1, n: 0, ne: 1, e: 1, se: 1, s: 0, sw: -1, w: -1 }[hn], SY = { nw: -1, n: -1, ne: -1, e: 0, se: 1, s: 1, sw: 1, w: 0 }[hn];
  const corner = SX !== 0 && SY !== 0;
  if (els.length > 1) {
    const b = M.unionBox(els), ax = SX < 0 ? b.x + b.w : b.x, ay = SY < 0 ? b.y + b.h : b.y;
    const orig = els.map(x => ({ x: x.x, y: x.y, w: x.w, h: x.h, s: x.s, fs: x.fs, rh: x.rh }));
    trackDrag(m => {
      const p = ED.pt(m), k = Math.max(.05, ((p.x - ax) * SX * b.w + (p.y - ay) * SY * b.h) / (b.w * b.w + b.h * b.h));
      els.forEach((x, i) => {
        const o = orig[i]; x.x = Math.round(ax + (o.x - ax) * k); x.y = Math.round(ay + (o.y - ay) * k); x.w = Math.round(o.w * k); x.h = Math.round(o.h * k);
        if (x.t === 'text') x.s = Math.max(6, Math.round(o.s * k)); if (x.t === 'table') { x.rh = o.rh * k; x.fs = o.fs * k; x.h = x.rows.length * x.rh; } if (x.t === 'chart') x.fs = (o.fs || 26) * k;
        ED.refreshNode(x);
      });
      ED.renderOverlay();
    }, () => { ED.updateThumb(ED.si); ED.renderCtx(); ED.commit(); });
    return;
  }
  const e = els[0], o = { x: e.x, y: e.y, w: e.w, h: e.h, s: e.s, fs: e.fs, rh: e.rh };
  const c0 = { x: o.x + o.w / 2, y: o.y + o.h / 2 }, th = (e.r || 0) * Math.PI / 180, cs = Math.cos(th), sn = Math.sin(th);
  const ax = -SX * o.w / 2, ay = -SY * o.h / 2;
  trackDrag(m => {
    const p = ED.pt(m), dx = p.x - c0.x, dy = p.y - c0.y;
    const lx = dx * cs + dy * sn, ly = -dx * sn + dy * cs;
    let nw = o.w, nh = o.h, k = 1;
    if (corner && e.t === 'text' && !m.shiftKey) { nw = Math.max(60, e.s * 1.2, (lx - ax) * SX); nh = o.h; k = 1; }
    else if (corner) {
      const vx = lx - ax, vy = ly - ay;
      if (m.shiftKey && e.t !== 'text') { nw = Math.max(10, vx * SX); nh = Math.max(10, vy * SY); }
      else { k = Math.max(.04, (vx * SX * o.w + vy * SY * o.h) / (o.w * o.w + o.h * o.h)); nw = o.w * k; nh = o.h * k; }
    } else if (SX) nw = Math.max(e.t === 'text' ? Math.max(60, e.s * 1.2) : 10, (lx - ax) * SX);
    else nh = Math.max(10, (ly - ay) * SY);
    if (e.k === 'line') nh = 0;
    if (e.t === 'text') { if (corner) e.s = Math.max(6, Math.round(o.s * k)); }
    if (e.t === 'table') { const rows = e.rows.length; if (corner) { e.rh = o.rh * k; e.fs = o.fs * k; nh = rows * e.rh; } else if (SY) { e.rh = nh / rows; } else nh = o.h; }
    if (e.t === 'chart' && corner) e.fs = (o.fs || 26) * k;
    const ccx = SX ? ax + SX * nw / 2 : 0, ccy = SY ? ay + SY * nh / 2 : 0;
    const wx = c0.x + ccx * cs - ccy * sn, wy = c0.y + ccx * sn + ccy * cs;
    e.w = Math.round(nw); e.h = Math.round(nh); e.x = Math.round(wx - e.w / 2); e.y = Math.round(wy - e.h / 2);
    ED.refreshNode(e); ED.renderOverlay();
  }, () => { ED.updateThumb(ED.si); ED.renderCtx(); ED.commit(); });
};

/* ---- menu contestuale ---- */
ED.onCtxMenu = e => {
  e.preventDefault();
  const n = e.target.closest('.sl > .el');
  if (n && !ED.sel.includes(n.dataset.id)) ED.select([n.dataset.id]);
  const a = h('span', { style: { position: 'fixed', left: e.clientX + 'px', top: e.clientY + 'px', width: '1px', height: '1px' } }); document.body.appendChild(a);
  const has = ED.sel.length > 0, one = ED.selEls()[0];
  const p = UI.menu(a, has ? [
    { label: 'Copia', icon: 'copy', key: 'Ctrl+C', onclick: ED.copySel }, { label: 'Taglia', icon: 'copy', key: 'Ctrl+X', onclick: ED.cutSel }, { label: 'Incolla', icon: 'copy', key: 'Ctrl+V', disabled: !ED.clip, onclick: ED.pasteClip },
    { label: 'Duplica', icon: 'dup', key: 'Ctrl+D', onclick: ED.duplicateSel },
    ED.selEls().length > 1 ? { label: 'Raggruppa', icon: 'layers', key: 'Ctrl+G', onclick: ED.group } : null,
    one && one.t === 'group' ? { label: 'Separa il gruppo', icon: 'layers', key: 'Ctrl+Maiusc+G', onclick: ED.ungroup } : null, { sep: 1 },
    { label: 'Porta in primo piano', icon: 'arrowUp', onclick: () => ED.order('front') }, { label: 'Porta avanti', icon: 'arrowUp', key: 'Ctrl+]', onclick: () => ED.order('up') },
    { label: 'Porta indietro', icon: 'arrowDown', key: 'Ctrl+[', onclick: () => ED.order('down') }, { label: 'Manda sullo sfondo', icon: 'arrowDown', onclick: () => ED.order('back') }, { sep: 1 },
    { label: one && one.lk ? 'Sblocca' : 'Blocca', icon: one && one.lk ? 'unlock' : 'lock', onclick: () => ED.mut(x => x.lk = x.lk ? 0 : 1) },
    { label: 'Elimina', icon: 'trash', key: 'Canc', danger: true, onclick: ED.deleteSel }
  ] : [{ label: 'Incolla', icon: 'copy', key: 'Ctrl+V', disabled: !ED.clip, onclick: ED.pasteClip }, { label: 'Aggiungi pagina', icon: 'plus', onclick: () => ED.addSlide() }, { label: 'Seleziona tutto', key: 'Ctrl+A', onclick: () => ED.select(ED.slide().els.filter(x => !x.hd).map(x => x.id)) }]);
  const old = p.onclose; p.onclose = () => { a.remove(); old && old(); };
};

/* ---- testo: doppio clic, modifica, lettura dal DOM ---- */
ED.onDbl = e => {
  const n = e.target.closest('.sl > .el'); if (!n) return;
  const el = M.findEl(ED.slide(), n.dataset.id); if (!el || el.lk) return;
  if (el.t === 'text') ED.startEdit(el.id, { x: e.clientX, y: e.clientY });
  else if (el.t === 'table') { const c = e.target.closest('.tc'); if (c) ED.startCellEdit(el, c); }
  else if (el.t === 'chart') ED.chartEditor(el);
  else if (el.t === 'group') { ED.select([el.id]); ED.ungroup(); toast('Gruppo separato. Ctrl+G per raggrupparli di nuovo.', { ms: 2200 }); }
};
ED.startEdit = (id, pt, selAll) => {
  const e = M.findEl(ED.slide(), id); if (!e || e.t !== 'text') return;
  if (ED.editing && ED.editing !== id) ED.endEdit();
  ED.sel = [id];
  if (e.cv) { e._cv = e.cv; e.cv = 0; ED.refreshNode(e); }
  ED.editing = id;
  const n = ED.nodeOf(id); if (!n) { ED.editing = null; return; }
  const tx = n.firstChild;
  tx.contentEditable = 'true'; tx.spellcheck = false; n.classList.add('editing'); tx.focus();
  try { document.execCommand('styleWithCSS', false, true); } catch (er) { }
  const sel = getSelection(), r = document.createRange();
  if (selAll || !pt) { r.selectNodeContents(tx); sel.removeAllRanges(); sel.addRange(r); }
  else { const cr = document.caretRangeFromPoint ? document.caretRangeFromPoint(pt.x, pt.y) : null; if (cr && tx.contains(cr.startContainer)) { sel.removeAllRanges(); sel.addRange(cr); } else { r.selectNodeContents(tx); r.collapse(false); sel.removeAllRanges(); sel.addRange(r); } }
  tx.addEventListener('input', ED.onTextInput);
  tx.addEventListener('keydown', ED.onTextKey);
  tx.addEventListener('paste', ev => { ev.preventDefault(); const t = (ev.clipboardData || window.clipboardData).getData('text/plain'); document.execCommand('insertText', false, t); });
  ED.renderOverlay(); ED.renderCtx();
};
ED.onTextKey = e => { if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); ED.endEdit(); } };
ED.onTextInput = () => { ED.syncText(); ED.commit(false); };
ED.parseText = (tx, e) => {
  const paras = [], baseB = R.weight(e) >= 600, baseI = !!e.i, baseU = !!e.u, baseC = (Col.parse(e.c) || '').toLowerCase();
  let cur = null;
  const newPara = (l, a) => { cur = { r: [] }; if (l) cur.l = l; if (a) cur.a = a; paras.push(cur); return cur; };
  const addText = (txt, node) => {
    if (!txt) return; if (!cur) newPara();
    const cs = getComputedStyle(node), run = { t: txt.replace(/ /g, ' ') };
    const b = parseInt(cs.fontWeight) >= 600; if (b !== baseB) run.b = b;
    const i = cs.fontStyle === 'italic'; if (i !== baseI) run.i = i;
    const u = (cs.textDecorationLine || '').includes('underline'); if (u !== baseU) run.u = u;
    const c = Col.parse(cs.color); if (c && c.toLowerCase() !== baseC) run.c = c;
    const prev = cur.r[cur.r.length - 1];
    if (prev && prev.b === run.b && prev.i === run.i && prev.u === run.u && prev.c === run.c) prev.t += run.t; else cur.r.push(run);
  };
  const walk = node => {
    node.childNodes.forEach(ch => {
      if (ch.nodeType === 3) addText(ch.nodeValue, node);
      else if (ch.nodeName === 'BR') { if (cur && cur.r.length) newPara(cur.l, cur.a); }
      else if (/^(DIV|P|LI)$/.test(ch.nodeName)) { newPara(ch.dataset.l, ch.style.textAlign); walk(ch); }
      else if (ch.nodeType === 1) walk(ch);
    });
  };
  walk(tx);
  return paras.length ? paras : [{ r: [] }];
};
ED.syncText = () => {
  const id = ED.editing; if (!id) return;
  const e = M.findEl(ED.slide(), id), n = ED.nodeOf(id); if (!e || !n) return;
  e.paras = ED.parseText(n.firstChild, e);
  const hh = n.firstChild.offsetHeight; e.h = hh; n.style.height = hh + 'px';
  ED.renderOverlay(); ED.thumbSoon();
};
ED.thumbSoon = debounce(() => ED.active && ED.updateThumb(ED.si), 250);
ED.endEdit = () => {
  const id = ED.editing; if (!id) return;
  ED.syncText();
  const e = M.findEl(ED.slide(), id); ED.editing = null;
  if (e && e._cv) { e.cv = e._cv; delete e._cv; }
  getSelection().removeAllRanges();
  if (e && !M.plain(e).trim()) { ED.slide().els = ED.slide().els.filter(x => x.id !== id); ED.sel = []; }
  ED.renderStage(); ED.renderOverlay(); ED.renderCtx(); ED.updateThumb(ED.si); ED.commit();
  if (ED.panel === 'layers') ED.renderPanel();
};
ED.restyleEditing = () => {
  const e = M.findEl(ED.slide(), ED.editing), n = ED.nodeOf(ED.editing); if (!e || !n) return;
  n.style.cssText = R.boxStyle(e) + (e.bg ? `background:${R.fillCss(e.bg)};` : '') + (e.rad ? `border-radius:${e.rad}px;` : '');
  n.firstChild.style.cssText = R.textCss(e);
  const hh = n.firstChild.offsetHeight; e.h = hh; n.style.height = hh + 'px';
  ED.renderOverlay();
};
/* applica grassetto/corsivo/sottolineato/colore: alla selezione se si sta scrivendo, altrimenti a tutta la casella */
ED.fmt = (kind, val) => {
  if (ED.editing) {
    const cmd = { b: 'bold', i: 'italic', u: 'underline' }[kind];
    if (kind === 'c') document.execCommand('foreColor', false, val); else document.execCommand(cmd);
    ED.syncText(); ED.commit(false); ED.renderCtx(); return;
  }
  ED.mut(e => {
    if (e.t !== 'text') return;
    if (kind === 'b') { const on = R.weight(e) >= 600; e.wt = 0; e.b = !on; }
    if (kind === 'i') e.i = !e.i;
    if (kind === 'u') e.u = !e.u;
    if (kind === 'c') e.c = val;
    e.paras.forEach(p => p.r.forEach(r => { if (kind === 'b') delete r.b; if (kind === 'i') delete r.i; if (kind === 'u') delete r.u; if (kind === 'c') delete r.c; }));
  });
};

/* ---- celle di tabella ---- */
ED.startCellEdit = (el, cell) => {
  ED.cellEdit = { id: el.id, r: +cell.dataset.r, c: +cell.dataset.c };
  cell.contentEditable = 'plaintext-only'; cell.focus();
  const r = document.createRange(); r.selectNodeContents(cell); const s = getSelection(); s.removeAllRanges(); s.addRange(r);
  cell.addEventListener('keydown', ev => { if (ev.key === 'Enter' || ev.key === 'Escape') { ev.preventDefault(); ED.endCellEdit(); } });
  ED.renderOverlay();
};
ED.endCellEdit = () => {
  const ce = ED.cellEdit; if (!ce) return; ED.cellEdit = null;
  const el = M.findEl(ED.slide(), ce.id), cell = ED.slEl.querySelector(`[data-id="${ce.id}"] .tc[data-r="${ce.r}"][data-c="${ce.c}"]`);
  if (el && cell) { while (el.rows[ce.r].length <= ce.c) el.rows[ce.r].push(''); el.rows[ce.r][ce.c] = cell.textContent; }
  ED.renderStage(); ED.renderOverlay(); ED.updateThumb(ED.si); ED.commit();
};

/* ---- tastiera e appunti ---- */
ED.onKey = e => {
  if (!ED.active) return;
  if ($('.modal') || (typeof PR !== 'undefined' && PR.on) || (typeof PRC !== 'undefined' && PRC.on)) return;
  const t = e.target, typing = t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.tagName === 'SELECT';
  const inText = !!ED.editing || t.isContentEditable;
  const mod = e.ctrlKey || e.metaKey, k = e.key.toLowerCase();
  if (typing) return;
  if (inText) { if (k === 'escape') { if (ED.cellEdit) ED.endCellEdit(); else ED.endEdit(); e.preventDefault(); } return; }
  if (mod && k === 'z') { e.preventDefault(); e.shiftKey ? ED.redo() : ED.undo(); return; }
  if (mod && k === 'y') { e.preventDefault(); ED.redo(); return; }
  if (mod && k === 'c') { if (ED.sel.length) { e.preventDefault(); ED.copySel(); try { navigator.clipboard.writeText('palco-clip'); } catch (er) { } } return; }
  if (mod && k === 'x') { if (ED.sel.length) { e.preventDefault(); ED.cutSel(); try { navigator.clipboard.writeText('palco-clip'); } catch (er) { } } return; }
  if (mod && k === 'd') { e.preventDefault(); ED.duplicateSel(); return; }
  if (mod && k === 'g') { e.preventDefault(); e.shiftKey ? ED.ungroup() : ED.group(); return; }
  if (mod && k === 'k') { e.preventDefault(); ED.commandPalette && ED.commandPalette(); return; }
  if (mod && k === 'f') { e.preventDefault(); ED.findDialog && ED.findDialog(); return; }
  if (mod && k === 'a') { e.preventDefault(); ED.select(ED.slide().els.filter(x => !x.hd && !x.lk).map(x => x.id)); return; }
  if (mod && (k === 'b' || k === 'i' || k === 'u')) { if (ED.selEls().some(x => x.t === 'text')) { e.preventDefault(); ED.fmt(k); } return; }
  if (mod && k === ']') { e.preventDefault(); ED.order('up'); return; }
  if (mod && k === '[') { e.preventDefault(); ED.order('down'); return; }
  if (mod) return;
  if (k === 'delete' || k === 'backspace') { if (ED.sel.length) { e.preventDefault(); ED.deleteSel(); } else if (ED.ssel.length > 1) { e.preventDefault(); ED.delSlides(ED.ssel); } return; }
  if (k === 'escape') { if (ED.painter) ED.cancelPainter(); else if (ED.draw.on) ED.toggleDraw(false); else if (ED.sel.length) ED.select([]); return; }
  if (k === 'enter') { const el = ED.selEls()[0]; if (el && el.t === 'text' && ED.sel.length === 1) { e.preventDefault(); ED.startEdit(el.id, null, true); } return; }
  if (k === 't' && !e.altKey) { e.preventDefault(); ED.addText(); return; }
  if (k === 'f5') { e.preventDefault(); ED.present(e.shiftKey ? 'dual' : undefined); return; }
  if (k === 'pagedown') { e.preventDefault(); ED.goto(ED.si + 1); return; }
  if (k === 'pageup') { e.preventDefault(); ED.goto(ED.si - 1); return; }
  if (k.startsWith('arrow') && ED.sel.length) {
    e.preventDefault(); const st = e.shiftKey ? 10 : 1, dx = k === 'arrowleft' ? -st : k === 'arrowright' ? st : 0, dy = k === 'arrowup' ? -st : k === 'arrowdown' ? st : 0;
    ED.mut(x => { if (!x.lk) { x.x += dx; x.y += dy; } }, { now: false, tb: false });
  }
};
ED.onPaste = async e => {
  if (!ED.active || ED.editing || $('.modal')) return;
  const t = e.target; if (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA') return;
  const cd = e.clipboardData; if (!cd) return;
  const files = [...(cd.files || [])].filter(f => /^image\//.test(f.type));
  const text = cd.getData('text/plain');
  e.preventDefault();
  if (files.length) return ED.uploadImages(files);
  if (ED.clip && (!text || text === 'palco-clip')) return ED.pasteClip();
  if (text.trim()) { const el = ED.addText({ text: text.slice(0, 4000), edit: false, w: 1000, s: 56 }); }
};

/* ============ Disegno a mano libera, cornici per immagini, sostituzione immagini ============ */
ED.draw = { on: false, brush: 'pen', color: '#E5484D', size: 8 };
ED.BRUSHES = [['pen', 'Pennarello', 1, 1], ['hl', 'Evidenziatore', .4, 3.2], ['thin', 'Matita', 1, .35]];

ED.toggleDraw = (on) => {
  ED.draw.on = on == null ? !ED.draw.on : on;
  if (ED.draw.on) { if (ED.editing) ED.endEdit(); ED.select([]); }
  ED.cwrap.classList.toggle('drawing', ED.draw.on);
  ED.renderDrawBar();
};
ED.renderDrawBar = () => {
  let bar = $('#drawbar');
  if (!ED.draw.on) { bar && bar.remove(); return; }
  if (!bar) { bar = h('div#drawbar.drawbar'); $('.emain').appendChild(bar); }
  const D = ED.draw;
  bar.innerHTML = '';
  bar.append(UI.seg(ED.BRUSHES.map(b => [b[0], b[1]]), D.brush, v => { D.brush = v; ED.renderDrawBar(); }),
    h('button.tbb.sw2', { title: 'Colore', 'aria-label': 'Colore del tratto', onclick: e => UI.colorPop(e.currentTarget, D.color, c => { if (typeof c === 'string') { D.color = c; $('.sw2c', bar).style.background = c; } }, { docColors: ED.docColors() }) }, h('span.sw2c', { style: { background: D.color } })),
    h('label.tinl', 'Spessore', h('input', { type: 'range', min: 2, max: 60, value: D.size, 'aria-label': 'Spessore', oninput: e => { D.size = +e.target.value; } })),
    h('button.btn.sm.primary', { onclick: () => ED.toggleDraw(false) }, 'Fine'));
};
ED.startDraw = (e) => {
  const D = ED.draw, br = ED.BRUSHES.find(b => b[0] === D.brush), size = D.size * br[3], pts = [ED.pt(e)];
  const NS = 'http://www.w3.org/2000/svg';
  const svg = document.createElementNS(NS, 'svg'); svg.setAttribute('class', 'drawpv'); svg.setAttribute('width', ED.deck.w); svg.setAttribute('height', ED.deck.h);
  const path = document.createElementNS(NS, 'path'); path.setAttribute('fill', 'none'); path.setAttribute('stroke', D.color); path.setAttribute('stroke-width', size); path.setAttribute('stroke-linecap', 'round'); path.setAttribute('stroke-linejoin', 'round'); path.setAttribute('opacity', br[2]);
  svg.appendChild(path); ED.stage.appendChild(svg);
  const line = () => 'M' + pts.map(p => p.x.toFixed(1) + ' ' + p.y.toFixed(1)).join('L');
  path.setAttribute('d', 'M' + pts[0].x + ' ' + pts[0].y + 'l.01 0');
  trackDrag(m => { const p = ED.pt(m), l = pts[pts.length - 1]; if (Math.hypot(p.x - l.x, p.y - l.y) * ED.zoom < 2.5) return; pts.push(p); path.setAttribute('d', line()); },
    () => {
      svg.remove();
      const xs = pts.map(p => p.x), ys = pts.map(p => p.y), pad = size / 2 + 2;
      const x0 = Math.min(...xs) - pad, y0 = Math.min(...ys) - pad, w = Math.max(...xs) - Math.min(...xs) + pad * 2, hh = Math.max(...ys) - Math.min(...ys) + pad * 2;
      const q = pts.map(p => [p.x - x0, p.y - y0]);
      let d = `M${q[0][0].toFixed(1)} ${q[0][1].toFixed(1)}`;
      if (q.length === 1) d += 'l.01 0';
      else if (q.length === 2) d += `L${q[1][0].toFixed(1)} ${q[1][1].toFixed(1)}`;
      else { for (let i = 1; i < q.length - 1; i++) { const mx = (q[i][0] + q[i + 1][0]) / 2, my = (q[i][1] + q[i + 1][1]) / 2; d += `Q${q[i][0].toFixed(1)} ${q[i][1].toFixed(1)} ${mx.toFixed(1)} ${my.toFixed(1)}`; } d += `L${q[q.length - 1][0].toFixed(1)} ${q[q.length - 1][1].toFixed(1)}`; }
      const el = M.shape('path', { x: Math.round(x0), y: Math.round(y0), w: Math.round(w), h: Math.round(hh), d, vb: [Math.round(w), Math.round(hh)], f: null, st: { c: D.color, w: size, d: 0 }, lc: 1, o: br[2] });
      ED.slide().els.push(el); ED.renderStage(); ED.updateThumb(ED.si); ED.commit();
    });
};

/* ---- cornici ---- */
ED.FRAMES = ['ellipse', 'round', 'heart', 'star', 'hexagon', 'diamond', 'arch', 'burst', 'blob1', 'blob2', 'speech', 'cloud', 'octagon', 'pill'];
ED.setFrame = (k) => ED.mut(x => { if (x.t !== 'image') return; if (k) { x.mk = k; delete x.rad; } else delete x.mk; });
ED.addFrame = async (k) => {
  const sel = ED.selEls();
  if (sel.length === 1 && sel[0].t === 'image') return ED.setFrame(k);
  const e = M.image('g:mesh:' + (ED.slide().els.length % 8) + ':7', { w: k === 'pill' ? 760 : 560, h: k === 'pill' ? 280 : 560, mk: k });
  ED.addEl(e); toast('Trascina una foto sulla cornice o usa “Sostituisci”', { ms: 2600 });
};
/* sostituisce l'immagine di un elemento mantenendo forma e posizione */
ED.replaceImage = (e, ref) => { ED.mut(x => { x.src = ref; delete x.rc; delete x.orig; x.ix = 0; x.iy = 0; x.iz = 1; }, { els: [e] }); (ED.deck.imgs = ED.deck.imgs || []).unshift(ref); };
ED.replaceMenu = (anchor, e) => UI.menu(anchor, [
  { label: 'Carica una nuova immagine', icon: 'upload', onclick: () => UI.pickFile('image/*', false, async fs => { try { ED.replaceImage(e, await Img.addFile(fs[0])); } catch (er) { toast('Non riesco a usare questo file', { type: 'err' }); } }) },
  { sep: 1 }, { head: 'Dalla presentazione' },
  ...(ED.deck.imgs || []).slice(0, 6).map((r, i) => ({ label: 'Immagine caricata ' + (i + 1), icon: 'image', onclick: () => ED.replaceImage(e, r) })),
  { label: 'Sfondo astratto casuale', icon: 'sparkles', onclick: () => ED.replaceImage(e, ART_LIST[Math.floor(Math.random() * ART_LIST.length)]) }
]);
ED._onDropFiles = (ev, files) => {
  const t = document.elementFromPoint(ev.clientX, ev.clientY), n = t && t.closest('.sl .el-image');
  const el = n && M.findEl(ED.slide(), n.dataset.id);
  if (el && !el.lk && files.length) { Img.addFile(files[0]).then(r => ED.replaceImage(el, r)).catch(() => toast('Non riesco a usare questo file', { type: 'err' })); return true; }
  return false;
};

/* ============ Gruppi, ridimensionamento proporzionale e cambio formato ============ */
/* Scala un elemento: kx, ky per posizione e dimensioni, ks per i corpi (testo, spessori) */
M.scaleEl = (e, kx, ky, ks) => {
  e.x = Math.round(e.x * kx); e.y = Math.round(e.y * ky); e.w = Math.round(e.w * kx); e.h = Math.round(e.h * ky);
  if (e.t === 'text') { e.s = Math.max(6, Math.round(e.s * ks)); if (e.pad) e.pad = Math.round(e.pad * ks); if (e.rad) e.rad = Math.round(e.rad * ks); }
  if (e.t === 'shape') { if (e.st) e.st = { ...e.st, w: Math.max(1, Math.round(e.st.w * ks)) }; if (e.rad) e.rad = Math.round(e.rad * ks); }
  if (e.t === 'image') { if (e.rad) e.rad = Math.round(e.rad * ks); if (e.fx && e.fx.bl) e.fx = { ...e.fx, bl: e.fx.bl * ks }; }
  if (e.t === 'chart') e.fs = (e.fs || 26) * ks;
  if (e.t === 'table') { e.rh = e.rh * ky; e.fs = e.fs * ks; e.h = Math.round(e.rows.length * e.rh); }
  if (e.t === 'group') { e.h = Math.round(e.oh * (e.w / e.ow)); }
  return e;
};

ED.canGroup = () => ED.selEls().filter(e => !e.lk).length >= 2;
ED.group = () => {
  const els = ED.selEls().filter(e => !e.lk); if (els.length < 2) return toast('Seleziona almeno due elementi');
  const b = M.unionBox(els), s = ED.slide(), ids = new Set(els.map(e => e.id));
  const kids = els.map(e => { const c = clone(e); c.x = Math.round(e.x - b.x); c.y = Math.round(e.y - b.y); return c; });
  const top = Math.max(...s.els.map((e, i) => ids.has(e.id) ? i : -1));
  const g = { id: uid('e'), t: 'group', x: Math.round(b.x), y: Math.round(b.y), w: Math.round(b.w), h: Math.round(b.h), ow: Math.round(b.w), oh: Math.round(b.h), r: 0, els: kids };
  s.els.splice(top + 1, 0, g); s.els = s.els.filter(e => !ids.has(e.id));
  ED.sel = [g.id]; ED.refresh(); toast('Elementi raggruppati', { ms: 1200 });
};
ED.ungroup = () => {
  const s = ED.slide(), gs = ED.selEls().filter(e => e.t === 'group'); if (!gs.length) return;
  const out = [];
  gs.forEach(g => {
    const k = g.w / g.ow, th = (g.r || 0) * Math.PI / 180, cs = Math.cos(th), sn = Math.sin(th), gcx = g.x + g.w / 2, gcy = g.y + g.h / 2;
    const kids = g.els.map(c => {
      const e = clone(c); M.scaleEl(e, k, k, k);
      const lx = e.x + e.w / 2 - g.w / 2, ly = e.y + e.h / 2 - g.h / 2;
      const wx = gcx + lx * cs - ly * sn, wy = gcy + lx * sn + ly * cs;
      e.x = Math.round(wx - e.w / 2); e.y = Math.round(wy - e.h / 2); e.r = ((e.r || 0) + (g.r || 0));
      e.id = uid('e'); return e;
    });
    const i = s.els.indexOf(g); s.els.splice(i, 1, ...kids); out.push(...kids.map(c => c.id));
  });
  ED.sel = out; ED.refresh();
};

/* ---- cambio formato: crea una copia ---- */
M.FORMATS = [['16:9', 'Presentazione 16:9', 1920, 1080], ['4:3', 'Classico 4:3', 1440, 1080], ['1:1', 'Quadrato (post social)', 1080, 1080], ['9:16', 'Storia verticale 9:16', 1080, 1920], ['A4', 'Foglio A4 verticale', 1080, 1528]];
App.resizeCopy = (deck, fmt, mode) => {
  const [, , nw, nh] = M.FORMATS.find(f => f[0] === fmt), c = clone(deck);
  const kx = nw / deck.w, ky = nh / deck.h, kf = Math.min(kx, ky);
  c.id = uid('d_'); c.name = deck.name + ' (' + fmt + ')'; c.created = Date.now(); c.w = nw; c.h = nh; c.trashed = 0;
  const ox = mode === 'fit' ? (nw - deck.w * kf) / 2 : 0, oy = mode === 'fit' ? (nh - deck.h * kf) / 2 : 0;
  c.slides.forEach(s => s.els.forEach(e => {
    if (mode === 'fit') { M.scaleEl(e, kf, kf, kf); e.x += Math.round(ox); e.y += Math.round(oy); }
    else M.scaleEl(e, kx, ky, kf);
  }));
  return c;
};
ED.resizeDialog = () => {
  const st = { fmt: '4:3', mode: 'fit' }, D = ED.deck, grid = h('div.fmtgrid');
  const draw = () => { grid.innerHTML = ''; M.FORMATS.filter(f => !(f[2] === D.w && f[3] === D.h)).forEach(f => { const r = f[2] / f[3], w = r >= 1 ? 54 : 54 * r, hh = r >= 1 ? 54 / r : 54; grid.appendChild(h('button.fmt' + (st.fmt === f[0] ? '.on' : ''), { onclick: () => { st.fmt = f[0]; draw(); } }, h('span.fmtb', h('i', { style: { width: w + 'px', height: hh + 'px' } })), h('b', f[0]), h('small', f[1]))); }); };
  draw();
  const modes = h('div'); const dm = () => { modes.innerHTML = ''; modes.appendChild(UI.seg([['fit', 'Mantieni le proporzioni'], ['fill', 'Riempi lo spazio']], st.mode, v => { st.mode = v; dm(); })); }; dm();
  const m = UI.modal('Cambia formato', h('div.form', h('p.mtext', 'Crea una copia della presentazione nel nuovo formato. L’originale resta com’è.'), grid, modes), { cls: 'small',
    foot: [h('span.grow'), h('button.btn', { onclick: () => m.close() }, 'Annulla'), h('button.btn.primary', { onclick: () => { m.close(); ED.close(); const c = App.resizeCopy(D, st.fmt, st.mode); ST.saveDeck(c, true); TP.ensure(c); ED.open(c); toast('Copia creata nel formato ' + st.fmt); } }, 'Crea la copia')] });
};

