    ov.addEventListener('pointermove', e => { if (!st) return; const p = pt(e), x = Math.min(st.x, p.x), y = Math.min(st.y, p.y), w = Math.abs(p.x - st.x), hh = Math.abs(p.y - st.y); Object.assign(box.style, { left: x / D.w * 100 + '%', top: y / D.h * 100 + '%', width: w / D.w * 100 + '%', height: hh / D.h * 100 + '%' }); box._r = { x, y, w, h: hh }; });
    ov.addEventListener('pointerup', () => { if (!st) return; st = null; const r = box && box._r; if (r && r.w > D.w * .05 && r.h > D.h * .05) { s.cam.push({ x: Math.round(r.x), y: Math.round(r.y), w: Math.round(r.w), h: Math.round(r.h) }); ED.commit(); } draw(); drawList(); });
  };
