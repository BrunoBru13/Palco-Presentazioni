  const layoutRel = Object.values(rels).find(r => /slideLayout$/.test(r.type));
  cx.layoutDoc = layoutRel ? await PPTI.xml(cx.zip, layoutRel.t) : null; const lrels = layoutRel ? await PPTI.rels(cx.zip, layoutRel.t) : {};
  const mrel = Object.values(lrels).find(r => /slideMaster$/.test(r.type)); cx.masterDoc = mrel ? await PPTI.xml(cx.zip, mrel.t) : cx.masterDoc0; const mrels = mrel ? await PPTI.rels(cx.zip, mrel.t) : {};
  const cm = cx.masterDoc && cx.masterDoc.getElementsByTagName('p:clrMap')[0]; cx.clrMap = { bg1: 'lt1', tx1: 'dk1', bg2: 'lt2', tx2: 'dk2' }; if (cm) [...cm.attributes].forEach(a => { cx.clrMap[a.name] = a.value; });
  const ts = cx.masterDoc && cx.masterDoc.getElementsByTagName('p:txStyles')[0]; cx.titleStyle = ts && PPTI.kid(ts, 'p:titleStyle'); cx.bodyStyle = ts && PPTI.kid(ts, 'p:bodyStyle'); cx.otherStyle = ts && PPTI.kid(ts, 'p:otherStyle');
  cx.defColor = cx.theme[cx.clrMap.tx1] || '#000000';
  let bg = PPTI.background(doc, cx); if (bg === undefined) bg = PPTI.background(cx.layoutDoc, cx); if (bg === undefined) bg = PPTI.background(cx.masterDoc, cx);
  if (bg === undefined) bg = cx.theme[cx.clrMap.bg1] || '#FFFFFF';
  const slide = M.newSlide(typeof bg === 'string' || (bg && bg.g) ? bg : '#FFFFFF'); const out = [];
  cx.tf = { sx: 1, sy: 1, ox: 0, oy: 0 };
  const showM = doc.documentElement.getAttribute('showMasterSp') !== '0', showL = cx.layoutDoc && cx.layoutDoc.documentElement.getAttribute('showMasterSp') !== '0';
  const tree = d => d && PPTI.at(d.documentElement, 'p:cSld', 'p:spTree');
  if (showM && showL !== false && tree(cx.masterDoc)) await PPTI.shapes(tree(cx.masterDoc), cx, { rels: mrels, skipPh: true }, out);
  if (showM && tree(cx.layoutDoc)) await PPTI.shapes(tree(cx.layoutDoc), cx, { rels: lrels, skipPh: true }, out);
  await PPTI.shapes(tree(doc), cx, { rels }, out);
  slide.els = out;
  const nrel = Object.values(rels).find(r => /notesSlide$/.test(r.type));
  if (nrel) { const nd = await PPTI.xml(cx.zip, nrel.t); if (nd) { const sp = [...nd.getElementsByTagName('p:sp')].find(s => { const p = PPTI.phOf(s); return p && p.getAttribute('type') === 'body'; }); if (sp) slide.notes = PPTI.kids(PPTI.kid(sp, 'p:txBody'), 'a:p').map(p => [...p.getElementsByTagName('a:t')].map(t => t.textContent).join('')).join('\n').trim(); } }
  return slide;
};
PPTI.convert = async (file, opt, progress) => {
  await EX.loadScript(PPTI.JSZ);
  const zip = await JSZip.loadAsync(file);
  const pres = await PPTI.xml(zip, 'ppt/presentation.xml'); if (!pres) throw new Error('pptx');
  const sz = pres.getElementsByTagName('p:sldSz')[0], cxE = PPTI.num(sz, 'cx', 12192000), cyE = PPTI.num(sz, 'cy', 6858000);
  const land = cxE >= cyE, W = land ? 1920 : Math.round(1920 * cxE / cyE), H = land ? Math.round(1920 * cyE / cxE) : 1920;
  const prels = await PPTI.rels(zip, 'ppt/presentation.xml');
  const ids = [...pres.getElementsByTagName('p:sldId')].map(s => prels[s.getAttribute('r:id')]).filter(Boolean).map(r => r.t);
  const thDoc = await PPTI.xml(zip, 'ppt/theme/theme1.xml'), theme = {};
  const cs = thDoc && thDoc.getElementsByTagName('a:clrScheme')[0];
  if (cs) [...cs.children].forEach(c => { const v = c.firstElementChild; if (v) theme[c.nodeName.replace('a:', '')] = v.nodeName === 'a:sysClr' ? '#' + (v.getAttribute('lastClr') || '000000') : '#' + v.getAttribute('val'); });
  const mj = thDoc && thDoc.getElementsByTagName('a:majorFont')[0], mn = thDoc && thDoc.getElementsByTagName('a:minorFont')[0];
  theme.majorFont = mj && PPTI.at(mj, 'a:latin') && PPTI.at(mj, 'a:latin').getAttribute('typeface'); theme.minorFont = mn && PPTI.at(mn, 'a:latin') && PPTI.at(mn, 'a:latin').getAttribute('typeface');
  const deck = M.newDeck({ name: file.name.replace(/\.pptx$/i, '') || 'PowerPoint importato', w: W, h: H, theme: 'minimale', slides: [] }); deck.imgs = [];
  const stats = { pages: 0, total: ids.length, texts: 0, images: 0, shapes: 0, tables: 0, charts: 0, skipped: 0 };
  const cx = { zip, theme, opt, deck, k: W / cxE, imgs: new Map(), stats, tf: { sx: 1, sy: 1, ox: 0, oy: 0 }, clrMap: { bg1: 'lt1', tx1: 'dk1', bg2: 'lt2', tx2: 'dk2' }, bulletBody: true };
  const fams = new Set(), max = Math.min(ids.length, 80);
  for (let i = 0; i < max; i++) {
    progress && progress(i + 1, max);
    try { const s = await PPTI.slide(cx, ids[i], i); deck.slides.push(s); stats.pages++; } catch (e) { console.warn('diapositiva ' + (i + 1), e); deck.slides.push(M.newSlide('#FFFFFF')); }
    await sleep(0);
  }
  deck.slides.forEach(s => s.els.forEach(e => { if (e.t === 'text') { fams.add(e.f); } }));
  await loadFonts([...fams].flatMap(f => [[f, 400], [f, 700]]));
  // altezze reali e ancoraggio verticale
  deck.slides.forEach(s => {
    const groups = new Map();
    s.els.forEach(e => { if (e._stack) { R.fitHeight(e); const key = e._stack.by + ':' + e._stack.bh; (groups.get(key) || groups.set(key, []).get(key)).push(e); } });
    groups.forEach(list => {
      const st = list[0]._stack, total = list.reduce((a, e) => a + e.h, 0) + (list.length - 1) * 8;
      let y = st.anchor === 'ctr' ? st.by + (st.bh - total) / 2 : st.anchor === 'b' ? st.by + st.bh - total : st.by;
      if (total > st.bh) y = Math.min(y, st.by);
      list.forEach(e => { e.y = Math.round(y); y += e.h + 8; delete e._stack; });
    });
  });
  return { deck, stats };
};
PPTI.dialog = (file) => {
  const opt = { text: true, images: true, shapes: true };
  const bar = h('div.pbar', h('i')), status = h('div.aistatus', 'Pronto a importare.');
  const chk = (k, l) => h('label.chk', h('input', { type: 'checkbox', checked: true, onchange: e => { opt[k] = e.target.checked; } }), l);
  const go = h('button.btn.primary', { onclick: async () => {
    go.disabled = true; $$('input', m).forEach(i => i.disabled = true);
    try {
      status.textContent = 'Carico il lettore…';
      const { deck, stats } = await PPTI.convert(file, opt, (n, t) => { status.textContent = `Leggo la diapositiva ${n} di ${t}…`; bar.firstChild.style.width = Math.round(n / t * 100) + '%'; });
      m.close(); App.create(deck);
      toast(`Importate ${stats.pages} pagine: ${stats.texts} testi, ${stats.images} immagini, ${stats.shapes} forme${stats.tables ? ', ' + stats.tables + ' tabelle' : ''}` + (stats.charts ? `. ${stats.charts} grafici non importati` : '') + (stats.skipped ? `. ${stats.skipped} immagini in formati non supportati` : '') + (stats.total > stats.pages ? ` (solo le prime ${stats.pages})` : ''), { ms: 7000 });
    } catch (e) { console.warn(e); go.disabled = false; $$('input', m).forEach(i => i.disabled = false); status.textContent = 'Non sono riuscito a leggere questo file (serve internet per caricare il lettore ed è supportato solo il formato .pptx).'; }
  } }, icn('upload', 18), 'Importa');
  const m = UI.modal('Importa PowerPoint', h('div.form', h('p.mtext', `“${file.name}” diventa una presentazione che puoi modificare: Palco riconosce testi, immagini, forme, tabelle, colori e note.`), chk('text', 'Testi (font, dimensione, colore, allineamento)'), chk('images', 'Immagini'), chk('shapes', 'Forme e colori'), bar, status,
    h('p.hint2', 'I font non presenti vengono sostituiti con quelli più simili. Grafici, SmartArt, video e animazioni di PowerPoint non vengono importati.')), { cls: 'small', foot: [h('span.grow'), h('button.btn', { onclick: () => m.close() }, 'Annulla'), go] });
};

/* ============ Anima la presentazione: stili pronti di animazioni e transizioni (come “Magic Animate”) ============ */
const ANM = {};
ANM.STYLES = [
  { k: 'elegante', n: 'Elegante', d: 'Dissolvenze lente, i testi salgono piano', tr: ['fade'], title: ['fade', 's'], text: ['rise', ''], image: ['fade', 's'], chart: ['fade', ''], deco: ['fade', ''] },
  { k: 'dinamico', n: 'Dinamico', d: 'Testi dai lati, immagini che si ingrandiscono', tr: ['slide'], title: ['left', 'f'], text: ['side', 'f'], image: ['zoom', 'f'], chart: ['rise', 'f'], deco: ['pop', 'f'] },
  { k: 'giocoso', n: 'Giocoso', d: 'Rimbalzi e giravolte, per scuola e feste', tr: ['zoom', 'fade'], title: ['pop', ''], text: ['pop', 'f'], image: ['tada', ''], chart: ['flip', ''], deco: ['flip', 'f'] },
  { k: 'cinema', n: 'Cinematografico', d: 'Sfocature e zoom lenti, atmosfera da film', tr: ['fade'], title: ['blur', 's'], text: ['blur', 's'], image: ['zoom', 's'], chart: ['blur', 's'], deco: ['blur', 's'] },
  { k: 'minimo', n: 'Minimale', d: 'Solo una leggera dissolvenza veloce', tr: ['none'], title: ['fade', 'f'], text: ['fade', 'f'], image: ['fade', 'f'], chart: ['fade', 'f'], deco: ['fade', 'f'] },
  { k: 'dati', n: 'Numeri in movimento', d: 'I titoli si scrivono a macchina, i numeri contano fino al valore', tr: ['fade'], title: ['type', ''], text: ['auto', ''], image: ['zoom', ''], chart: ['rise', ''], deco: ['pop', 'f'] }
];
ANM.role = (e, W, H) => {
  const area = e.w * e.h / (W * H);
  if (e.t === 'text') return e.s >= 64 ? 'title' : 'text';
  if (e.t === 'image') return area > .6 ? 'bg' : 'image';
  if (e.t === 'shape') return area > .35 || e.k === 'line' ? 'bg' : 'deco';
  return 'chart';
};
/* assegna le animazioni a una pagina (modifica la pagina che riceve) */
ANM.plan = (slide, deck, st, idx, withTr) => {
  slide.els.forEach(e => {
    if (e.hd) return;
    const role = ANM.role(e, deck.w, deck.h);
    delete e.an; delete e.ao; delete e.asp;
    if (!st || role === 'bg') return;
    let [an, sp] = st[role];
    if (an === 'side') an = e.x + e.w / 2 < deck.w / 2 ? 'left' : 'right';
    if (an === 'auto') an = e.t === 'text' && /\d/.test(M.plain(e)) ? 'count' : 'rise';
    e.an = an; if (sp) e.asp = sp;
  });
  if (withTr) slide.tr = !st || idx === 0 ? 'none' : st.tr[(idx - 1) % st.tr.length];
};
ANM.apply = (st, o) => {
  const D = ED.deck, list = o.all ? D.slides.map((s, i) => [s, i]) : [[ED.slide(), ED.si]];
  list.forEach(([s, i]) => ANM.plan(s, D, st, i, o.tr));
  ED.renderAll(); ED.commit();
  const n = list.length;
  toast(st ? `Stile “${st.n}” applicato a ${n} ${n === 1 ? 'pagina' : 'pagine'}. Premi F5 per vederlo.` : `Animazioni tolte da ${n} ${n === 1 ? 'pagina' : 'pagine'}`, { icon: 'sparkles', ms: 3500 });
};

ED.animateDialog = () => {
  const D = ED.deck, cur = ED.slide(), o = { all: D.slides.length > 1, tr: true }; let pick = ANM.STYLES[0], timer = 0;
  const cards = [];
  const grid = h('div.anmgrid');
  const mk = (st) => {
    const demo = clone(cur); ANM.plan(demo, D, st, 1, false);
    const box = R.thumb(demo, D, { anim: true });
    const c = h('button.anmc' + (st === pick ? '.on' : ''), { onclick: () => { pick = st; cards.forEach(x => x.c.classList.toggle('on', x.st === st)); } }, h('div.anmpv', box), h('b', st.n), h('small', st.d));
    cards.push({ c, st, box }); return c;
  };
  ANM.STYLES.forEach(st => grid.appendChild(mk(st)));
  const play = () => cards.forEach(({ box }) => {
    $$('.el', box).forEach(n => { const c = n.firstElementChild; if (c) c.style.animation = ''; });
    void box.offsetWidth; let d = .25; $$('.el[data-an]', box).forEach(n => { d = R.playIn(n, d); });
  });
  const scopeBtn = (all, label) => h('button.sg' + (o.all === all ? '.on' : ''), { onclick: e => { o.all = all; $$('.sg', e.currentTarget.parentNode).forEach(b => b.classList.toggle('on', b === e.currentTarget)); } }, label);
  const body = h('div.form',
    h('p.mtext', 'Scegli uno stile: Palco anima ogni elemento in base al suo ruolo (titoli, testi, immagini, grafici) e sceglie le transizioni tra le pagine. Le anteprime sotto usano la pagina che stai guardando.'),
    grid,
    h('div.row', { style: { alignItems: 'center' } },
      h('div.segs', scopeBtn(true, 'Tutta la presentazione'), scopeBtn(false, 'Solo questa pagina')),
      h('label.chk', h('input', { type: 'checkbox', checked: true, onchange: e => { o.tr = e.target.checked; } }), 'Anche le transizioni tra le pagine')));
  const m = UI.modal('Anima la presentazione', body, {
    cls: 'wide2 anmbox', onclose: () => clearInterval(timer),
    foot: [h('button.btn.ghost', { onclick: () => { m.close(); ANM.apply(null, { all: o.all, tr: o.tr }); } }, 'Togli le animazioni'), h('span.grow'), h('button.btn', { onclick: () => m.close() }, 'Annulla'), h('button.btn.primary', { onclick: () => { m.close(); ANM.apply(pick, o); } }, icn('sparkles', 16), 'Applica')]
  });
  setTimeout(play, 350); timer = setInterval(play, 3800);
};

/* ============ Applica il marchio alla presentazione: colori, font e logo in un clic ============ */
ED.brandIsDefault = () => { const b = ST.brand, d = ST.DEF_BRAND; return !b.logo && b.head === d.head && b.body === d.body && b.colors.every((c, i) => c === d.colors[i]); };
ED.brandTheme = (o) => {
  const b = ST.brand, cur = TP.get(ED.deck.theme), cols = b.colors.map(Col.parse).filter(Boolean);
  const dark = cols.slice().sort((a, c) => Col.lum(a) - Col.lum(c))[0] || '#14182B';
  let bg = cur.bg;
  if (o.bg === 'light') bg = Col.mix('#FFFFFF', cols[0] || '#FFFFFF', .05);
  else if (o.bg === 'dark') bg = Col.lum(dark) < .25 ? dark : Col.mix(cols[0] || '#14182B', '#000000', .7);
  else if (o.bg === 'color') bg = cols[0] || bg;
  const cand = cols.filter(c => QC.ratio(c, bg) >= 1.8);
  const ac = cand[0] || Col.readable(bg), ac2 = cand[1] || ac, ac3 = cand[2] || ac2;
  return { base: cur.custom ? cur.base : cur.id, name: 'Marchio', bg, fg: Col.readable(bg), ac, ac2, ac3, fontTitle: b.head, fontBody: b.body };
};
ED.applyBrand = async (o) => {
  const D = ED.deck, b = ST.brand;
  if (o.theme) {
    const th = TP.custom(ED.brandTheme(o)); TP.themes.push(th); D.themeDef = th.def;
    await loadFonts([[th.fd, th.wd], [th.fb, 400], [th.fb, 700]]);
    ED.applyTheme(th.id);
  }
  D.slides.forEach(s => { s.els = s.els.filter(e => !e.brandLogo); });
  if (o.logo && b.logo) {
    const n = await Img.size(b.logo), mg = Math.round(D.w * .03);
    const hh = Math.round(D.h * .085), w = Math.min(Math.round(n.w / n.h * hh), Math.round(D.w * .2)), h2 = Math.round(w * n.h / n.w);
    const x = o.pos[1] === 'l' ? mg : D.w - mg - w, y = o.pos[0] === 't' ? mg : D.h - mg - h2;
    D.slides.forEach((s, i) => { if (i === 0 && o.skipCover) return; s.els.push(M.image(b.logo, { x, y, w, h: h2, brandLogo: 1, alt: 'Logo' })); });
    if (!D.imgs.includes(b.logo)) D.imgs.unshift(b.logo);
  }
  ED.renderAll(); ED.commit();
  toast('Marchio applicato alla presentazione', { icon: 'palette', ms: 2500 });
};
ED.magicMenu = (anchor) => UI.menu(anchor, [
  { head: 'Magia' },
  { label: 'Controllo qualità', icon: 'check', onclick: () => ED.setPanel('check') },
  { label: 'Anima la presentazione', icon: 'sparkles', onclick: () => ED.animateDialog() },
  { label: 'Presentazione a volo (tela)', icon: 'move', onclick: () => ED.flyDialog() },
  { label: 'Inquadrature di questa pagina', icon: 'crop', onclick: () => ED.camDialog() },
  { label: 'Applica il marchio', icon: 'palette', onclick: () => ED.brandDialog() },
  { label: 'Cambia formato', icon: 'expand', onclick: () => ED.resizeDialog() },
  { sep: 1 },
  { label: 'Cronologia versioni', icon: 'clock', onclick: () => VER.dialog() },
  { label: 'Salva come modello', icon: 'layout', onclick: () => App.saveAsTemplate(ED.deck) },
  { sep: 1 },
  { label: 'Crea un video MP4', icon: 'film', onclick: () => VID.dialog(ED.deck) },
  { label: 'Allenati a presentare', icon: 'clock', onclick: () => ED.present(undefined, { train: true }) }
], { align: 'right' });
ED.brandDialog = () => {
  const b = ST.brand, o = { theme: true, bg: 'keep', logo: !!b.logo, pos: 'tr', skipCover: true };
  const sw = h('div.bsw', b.colors.map(c => h('i', { style: { background: c }, title: c })));
  const fonts = h('div.bfonts', h('b', { style: { fontFamily: fontStack(b.head) } }, 'Aa ', h('small', b.head)), h('span', { style: { fontFamily: fontStack(b.body) } }, 'Aa ', h('small', b.body)));
  loadFonts([[b.head, 700], [b.body, 400]]).then(() => { $$('.bfonts', document).forEach(n => { n.style.opacity = 1; }); });
  const logo = b.logo ? h('img.blogo', { src: Img.url(b.logo), alt: 'Logo del marchio' }) : h('div.blogo.none', 'Nessun logo');
  const seg = (key, items) => h('div.segs', items.map(([v, l]) => h('button.sg' + (o[key] === v ? '.on' : ''), { onclick: e => { o[key] = v; $$('.sg', e.currentTarget.parentNode).forEach(x => x.classList.toggle('on', x === e.currentTarget)); } }, l)));
  const body = h('div.form',
    ED.brandIsDefault() ? h('div.bnote', icn('info', 18), h('span', 'Stai usando il marchio di esempio. Mettici i tuoi colori, font e logo dalla Home, sezione Marchio, poi torna qui.'), h('button.btn.sm', { onclick: () => { m.close(); ED.close(); App.view = 'brand'; App.render(); } }, 'Apri Marchio')) : null,
    h('div.bkit', h('div', h('small', 'Colori'), sw), h('div', h('small', 'Font'), fonts), h('div', h('small', 'Logo'), logo)),
    h('label.chk', h('input', { type: 'checkbox', checked: true, onchange: e => { o.theme = e.target.checked; } }), 'Cambia colori e font della presentazione'),
    h('div.bopt', h('span', 'Sfondo delle pagine'), seg('bg', [['keep', 'Come ora'], ['light', 'Chiaro'], ['dark', 'Scuro'], ['color', 'Colore del marchio']])),
    h('label.chk', h('input', { type: 'checkbox', checked: !!b.logo, disabled: !b.logo, onchange: e => { o.logo = e.target.checked; } }), 'Metti il logo su ogni pagina'),
    h('div.bopt', h('span', 'Posizione del logo'), seg('pos', [['tr', 'In alto a destra'], ['tl', 'In alto a sinistra'], ['br', 'In basso a destra'], ['bl', 'In basso a sinistra']])),
    h('label.chk', h('input', { type: 'checkbox', checked: true, onchange: e => { o.skipCover = e.target.checked; } }), 'Non mettere il logo nella copertina'));
  const m = UI.modal('Applica il marchio', body, { cls: 'wide2', foot: [h('span.grow'), h('button.btn', { onclick: () => m.close() }, 'Annulla'), h('button.btn.primary', { onclick: async () => { m.close(); try { await ED.applyBrand(o); } catch (e) { console.warn(e); toast('Non sono riuscito ad applicare il marchio', { type: 'err' }); } } }, icn('palette', 16), 'Applica')] });
};

/* ============ Controllo qualità: contrasto, testo piccolo, elementi fuori pagina… con correzioni in un clic ============ */
const QC = {};
QC.ratio = (a, b) => { const l1 = Col.lum(a), l2 = Col.lum(b); return (Math.max(l1, l2) + .05) / (Math.min(l1, l2) + .05); };
QC.colors = (f) => typeof f === 'string' ? [Col.parse(f)].filter(Boolean) : (f && f.g ? f.g.map(Col.parse).filter(Boolean) : []);
QC.inBox = (e, x, y) => { const b = M.aabb(e); return x >= b.x && x <= b.x + b.w && y >= b.y && y <= b.y + b.h; };
/* i colori che stanno dietro a un elemento (vuoto = sfondo non valutabile, per esempio una foto) */
QC.under = (slide, idx) => {
  const e = slide.els[idx];
  if (e.t === 'text' && e.bg) { const c = QC.colors(e.bg); if (c.length) return c; }
  const cx = e.x + e.w / 2, cy = e.y + e.h / 2;
  for (let i = idx - 1; i >= 0; i--) {
    const s = slide.els[i]; if (s.hd || (s.o != null && s.o < .6) || !QC.inBox(s, cx, cy)) continue;
    if (s.t === 'image') return [];
    if (s.t === 'shape' && s.k !== 'line' && s.f) { const c = QC.colors(s.f); if (c.length) return c; }
  }
  const b = slide.bg;
  if (typeof b === 'string' || (b && b.g)) return QC.colors(b);
  if (b && b.img) return b.dim >= .35 ? ['#000000'] : [];
  return ['#FFFFFF'];
};
QC.snip = (e) => { const t = M.plain(e).replace(/\s+/g, ' ').trim(); return t.length > 28 ? t.slice(0, 27) + '…' : t; };
QC.words = (e) => M.plain(e).split(/\s+/).filter(Boolean).length;

QC.scan = (deck) => {
  const out = [], W = deck.w, H = deck.h, th = TP.get(deck.theme), minS = Math.round(20 * W / 1920), mg = Math.round(W * .03);
  const fams = new Map(), add = o => out.push(o);
  let noNotes = 0;
  deck.slides.forEach((s, si) => {
    let words = 0, big = false, quiz = false;
    const live = s.els.filter(e => !e.hd);
    s.els.forEach((e, idx) => {
      if (e.hd) return;
      const base = { si, eid: e.id };
      if (e.t === 'quiz') quiz = true;
      if (e.t === 'text') {
        if (!M.plain(e).trim()) { add({ ...base, sev: 'tip', msg: 'Casella di testo vuota', fix: { label: 'Elimina', fn: () => { s.els = s.els.filter(x => x !== e); } } }); return; }
        words += QC.words(e); if (e.s >= 56) big = true;
        fams.set(e.f, (fams.get(e.f) || 0) + 1);
        // contrasto
        const bgs = QC.under(s, idx);
        if (bgs.length && !e.te) {
          const large = e.s >= 64 || (e.s >= 48 && R.weight(e) >= 700), thr = large ? 3 : 4.5;
          const score = c => Math.min(...bgs.map(b => QC.ratio(c, b)));
          let worst = 99;
          [e.c, ...e.paras.flatMap(p => p.r.map(r => r.c))].forEach(c => { const cc = Col.parse(c); if (cc) worst = Math.min(worst, score(cc)); });
          if (worst < thr) add({
            ...base, sev: worst < 2 ? 'err' : 'warn', msg: `“${QC.snip(e)}” si legge male: contrasto ${worst.toFixed(1)} su ${thr}`,
            fix: {
              label: 'Correggi colore', fn: () => {
                const cands = [th.fg, '#FFFFFF', '#14182B'].map(Col.parse).filter(Boolean);
                const best = cands.find(c => score(c) >= thr) || cands.sort((a, b) => score(b) - score(a))[0];
                e.c = best; e.paras.forEach(p => p.r.forEach(r => { const rc = Col.parse(r.c); if (r.c && rc && score(rc) < thr) r.c = best; }));
              }
            }
          });
        }
        // testo piccolo
        if (e.s < minS) add({ ...base, sev: 'warn', msg: `“${QC.snip(e)}” è piccolo (${Math.round(e.s)} px): da lontano non si legge`, fix: { label: 'Ingrandisci', fn: () => { e.s = minS; R.fitHeight(e); } } });
      }
      // fuori dalla pagina
      if (['text', 'chart', 'table', 'quiz'].includes(e.t)) {
        const b = M.aabb(e);
        if (b.x < -4 || b.y < -4 || b.x + b.w > W + 4 || b.y + b.h > H + 4) add({
          ...base, sev: 'warn', msg: e.t === 'text' ? `“${QC.snip(e)}” esce dalla pagina` : 'Un elemento esce dalla pagina',
          fix: {
            label: 'Riporta dentro', fn: () => {
              const b0 = M.aabb(e), k = Math.min(1, (W - 2 * mg) / b0.w, (H - 2 * mg) / b0.h);
              if (k < 1) { e.w = Math.round(e.w * k); if (e.t === 'text') R.fitHeight(e); else e.h = Math.round(e.h * k); }
              const b1 = M.aabb(e); let dx = 0, dy = 0;
              if (b1.x < mg) dx = mg - b1.x; else if (b1.x + b1.w > W - mg) dx = W - mg - b1.x - b1.w;
              if (b1.y < mg) dy = mg - b1.y; else if (b1.y + b1.h > H - mg) dy = H - mg - b1.y - b1.h;
              e.x = Math.round(e.x + dx); e.y = Math.round(e.y + dy);
            }
          }
        });
      }
      // descrizione delle immagini
      if (e.t === 'image' && /^(d|m|a):|^https?:|^data:/.test(e.src || '') && !e.alt && e.w * e.h > .04 * W * H) add({ ...base, sev: 'tip', msg: 'Immagine senza descrizione per chi non la vede', img: e });
    });
    // testi sovrapposti
    const tx = s.els.filter(e => e.t === 'text' && !e.hd && M.plain(e).trim());
    for (let a = 0; a < tx.length; a++) for (let b = a + 1; b < tx.length; b++) {
      const A = M.aabb(tx[a]), B = M.aabb(tx[b]), iw = Math.min(A.x + A.w, B.x + B.w) - Math.max(A.x, B.x), ih = Math.min(A.y + A.h, B.y + B.h) - Math.max(A.y, B.y);
      if (iw > 0 && ih > 0 && iw * ih > .3 * Math.min(A.w * A.h, B.w * B.h)) { add({ si, eid: tx[b].id, sev: 'warn', msg: `“${QC.snip(tx[b])}” si sovrappone a un altro testo` }); break; }
    }
    EX.flat(s.els).forEach(e => { if (e.t === 'text' && !e.hd && !s.els.includes(e)) words += QC.words(e); });
    if (words > 90) add({ si, sev: 'warn', msg: `Troppo testo (${words} parole): chi guarda smette di ascoltare. Meglio dividere in due pagine.` });
    if (live.length && !big && !quiz && live.some(e => e.t === 'text')) add({ si, sev: 'tip', msg: 'Manca un titolo ben visibile' });
    if (!s.notes || !s.notes.trim()) noNotes++;
  });
  if (fams.size > 3) add({
    si: -1, sev: 'tip', msg: `Usi ${fams.size} font diversi: ne bastano due`,
    fix: { label: 'Uniforma i font', fn: () => deck.slides.forEach(s => EX.flat(s.els).forEach(e => { if (e.t === 'text' && e.f !== th.fd && e.f !== th.fb) e.f = e.s >= 64 ? th.fd : th.fb; })) }
  });
  if (deck.slides.length >= 3 && noNotes >= Math.ceil(deck.slides.length / 2)) add({ si: -1, sev: 'tip', msg: `${noNotes} pagine su ${deck.slides.length} non hanno note per chi presenta` });
  return out;
};
QC.score = (issues, deck) => {
  const w = { err: 6, warn: 3, tip: 1 }, sum = issues.reduce((a, i) => a + w[i.sev], 0);
  return Math.max(0, Math.round(100 - sum / Math.max(1, deck.slides.length / 5)));
};
QC.fixOne = (it) => { it.fix.fn(); };
QC.after = () => { ED.renderAll(); ED.commit(); ED.renderPanel(); };
QC.fixAll = (issues) => {
  const fx = issues.filter(i => i.fix); if (!fx.length) return;
  fx.forEach(i => { try { i.fix.fn(); } catch (e) { console.warn(e); } });
  QC.after(); toast(`${fx.length} ${fx.length === 1 ? 'correzione fatta' : 'correzioni fatte'}`, { icon: 'check', ms: 2200 });
};
QC.go = (it) => { if (it.si >= 0) { ED.goto(it.si); if (it.eid) ED.select([it.eid]); } };

ED.panels.check = () => {
  const D = ED.deck, issues = QC.scan(D), score = QC.score(issues, D);
  const ne = issues.filter(i => i.sev === 'err').length, nw = issues.filter(i => i.sev === 'warn').length, nt = issues.filter(i => i.sev === 'tip').length;
  const col = score >= 90 ? 'var(--ok)' : score >= 70 ? '#FFB020' : 'var(--err)', C = 2 * Math.PI * 38;
  const verdict = score >= 95 ? 'Pronta per il palco' : score >= 85 ? 'Ottimo lavoro' : score >= 70 ? 'Quasi ci siamo' : 'Da rifinire';
  const gauge = h('div.qgauge',
    h('svg', { viewBox: '0 0 96 96', width: 96, height: 96, html: `<circle cx="48" cy="48" r="38" fill="none" stroke="var(--line)" stroke-width="9"/><circle cx="48" cy="48" r="38" fill="none" stroke="${col}" stroke-width="9" stroke-linecap="round" stroke-dasharray="${(C * score / 100).toFixed(1)} ${C.toFixed(1)}" transform="rotate(-90 48 48)"/>` }),
    h('b', { style: { color: col } }, String(score)),
    h('div.qsum', h('strong', verdict), h('small', issues.length ? [ne ? `${ne} da sistemare` : null, nw ? `${nw} ${nw === 1 ? 'avviso' : 'avvisi'}` : null, nt ? `${nt} ${nt === 1 ? 'consiglio' : 'consigli'}` : null].filter(Boolean).join(' · ') : 'Nessun problema trovato')));
  const fixable = issues.filter(i => i.fix);
  const head = [psec('', gauge), h('div.btnrow', fixable.length ? h('button.btn.sm.primary', { onclick: () => QC.fixAll(issues) }, icn('sparkles', 16), `Correggi tutto (${fixable.length})`) : null, h('button.btn.sm', { onclick: () => ED.renderPanel() }, icn('restore', 16), 'Ricontrolla'))];
  if (!issues.length) return [...head, h('p.hint2', { style: { padding: '12px 4px' } }, 'Contrasto, dimensioni dei testi, margini e leggibilità sono a posto in tutte le pagine.')];
  const groups = new Map(); issues.forEach(i => { (groups.get(i.si) || groups.set(i.si, []).get(i.si)).push(i); });
  const order = [...groups.keys()].sort((a, b) => (a < 0) - (b < 0) || a - b);
  const sevIcon = { err: ['x', 'var(--err)'], warn: ['info', '#FFB020'], tip: ['sparkles', 'var(--ink3)'] };
  const rows = order.map(si => h('section.qgrp', h('h4', si < 0 ? 'Tutta la presentazione' : `Pagina ${si + 1}`),
    groups.get(si).map(it => h('div.qrow.' + it.sev, { onclick: e => { if (!e.target.closest('button,input')) QC.go(it); } },
      h('span.qic', { style: { color: sevIcon[it.sev][1] } }, icn(sevIcon[it.sev][0], 16)),
      h('div.qtx', h('span', it.msg),
        it.img ? h('div.qalt', h('input.inp.sm', { placeholder: 'Descrivi l’immagine in poche parole', 'aria-label': 'Descrizione dell’immagine', onkeydown: e => { if (e.key === 'Enter') e.target.nextSibling.click(); } }), h('button.btn.sm', { onclick: e => { const v = e.currentTarget.previousSibling.value.trim(); if (!v) return; it.img.alt = v; QC.after(); } }, 'Salva')) : null,
        h('div.qbt', it.si >= 0 ? h('button.link', { onclick: () => QC.go(it) }, 'Vai') : null,
          it.fix ? h('button.link', { onclick: () => { it.fix.fn(); QC.after(); } }, it.fix.label) : null))))));
  return [...head, ...rows];
};

/* ============ Grafica: formati, modelli, creazione e sezione nella Home ============ */
const GR = {};
GR.FORMATS = [
  { k: 'logo', n: 'Logo', w: 1000, h: 1000, ic: 'star', col: '#E040A0', d: 'Simbolo e nome, anche su sfondo trasparente' },
