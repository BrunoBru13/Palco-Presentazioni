  };
  const m = UI.modal('Inquadrature della pagina', h('div.camdlg', h('div.camL', h('p.hint2', 'In presentazione ogni clic porta la camera sulla prossima inquadratura; dopo l’ultima si passa alla pagina successiva.'), stage), h('div.camR',
