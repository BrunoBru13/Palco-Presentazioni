  { k: 'nature', n: 'Natura e bio', sy: ['leaf', 'sprout', 'pine', 'mountain', 'sun', 'drop', 'flower'], pals: [2, 8, 4, 0] },
  { k: 'finance', n: 'Finanza e consulenza', sy: ['coin', 'shield', 'compass', 'gem', 'crown', 'house'], pals: [0, 7, 10, 11] },
  { k: 'edu', n: 'Scuola e formazione', sy: ['book', 'cap', 'pencil', 'sun', 'sprout', 'compass'], pals: [0, 6, 8, 1] },
  { k: 'travel', n: 'Viaggi', sy: ['plane', 'compass', 'mountain', 'sun', 'wave', 'umbrella'], pals: [0, 1, 11, 8] },
  { k: 'pets', n: 'Animali', sy: ['paw', 'heartpulse', 'fish', 'leaf', 'house'], pals: [4, 1, 8, 3] },
  { k: 'event', n: 'Eventi e musica', sy: ['play', 'sun', 'crown', 'gem', 'moon', 'flame'], pals: [3, 9, 5, 11] }
];
LOGO.PALS = [
  { n: 'Oceano', m: '#1E6BFF', s: '#0EA5A5', d: '#0B1B3D', l: '#F2F7FF' }, { n: 'Tramonto', m: '#F2542D', s: '#FFB020', d: '#2A1B3D', l: '#FFF4E8' },
  { n: 'Bosco', m: '#1F7A4D', s: '#8CC63F', d: '#123524', l: '#F1F8E9' }, { n: 'Prugna', m: '#7B2CBF', s: '#E040A0', d: '#240046', l: '#FBF0FF' },
  { n: 'Terra', m: '#BC6C25', s: '#606C38', d: '#3B2A20', l: '#FEFAE0' }, { n: 'Notte', m: '#FFD25A', s: '#5B8CFF', d: '#0F1B3D', l: '#FFFFFF' },
  { n: 'Corallo', m: '#FF595E', s: '#FFCA3A', d: '#1D3557', l: '#FFF8F0' }, { n: 'Grafite', m: '#14182B', s: '#FF6B4A', d: '#14182B', l: '#F4F5F7' },
  { n: 'Menta', m: '#12B886', s: '#1E6BFF', d: '#0B3B34', l: '#ECFFF8' }, { n: 'Rosa', m: '#FF3D8B', s: '#7B2CBF', d: '#3A0F25', l: '#FFF0F6' },
  { n: 'Oro', m: '#C9A227', s: '#1D1D1B', d: '#1D1D1B', l: '#FFFBEA' }, { n: 'Ghiaccio', m: '#3A86FF', s: '#8338EC', d: '#0D1B2A', l: '#E0E1DD' }
];
LOGO.STYLES = [
  { k: 'moderno', n: 'Moderno', t: ['Poppins', 'Sora', 'Montserrat', 'Space Grotesk'], b: 'Plus Jakarta Sans', wt: 700, up: false, ls: 0 },
  { k: 'elegante', n: 'Elegante', t: ['Playfair Display', 'DM Serif Display', 'Fraunces', 'Raleway'], b: 'Work Sans', wt: 600, up: false, ls: .02 },
  { k: 'giocoso', n: 'Giocoso', t: ['Pacifico', 'Lobster', 'Nunito', 'Rubik'], b: 'Nunito', wt: 800, up: false, ls: 0 },
  { k: 'audace', n: 'Audace', t: ['Bebas Neue', 'Anton', 'Archivo Black', 'Rubik'], b: 'Rubik', wt: 400, up: true, ls: .04 },
  { k: 'minimal', n: 'Minimale', t: ['Inter', 'Manrope', 'Work Sans', 'Outfit'], b: 'Inter', wt: 500, up: true, ls: .18 }
];
LOGO.LAYOUTS = ['stacked', 'horizontal', 'monogram', 'badge', 'wordmark', 'emblem', 'duo', 'underline'];
LOGO.sector = k => LOGO.SECTORS.find(s => s.k === k) || LOGO.SECTORS[0];
LOGO.style = k => LOGO.STYLES.find(s => s.k === k) || LOGO.STYLES[0];

/* misura il testo per far stare il nome nello spazio */
LOGO._ctx = document.createElement('canvas').getContext('2d');
LOGO.fit = (txt, font, wt, maxW, maxS, ls, up) => {
  const c = LOGO._ctx, t = up ? txt.toUpperCase() : txt; c.font = `${wt} 100px ${fontStack(font)}`;
  const w100 = c.measureText(t).width + ls * 100 * t.length;
  return Math.max(36, Math.min(maxS, Math.floor(maxW * .94 / Math.max(1, w100) * 100)));
};
LOGO.symEl = (key, x, y, w, fill) => {
  const cu = LOGO.custom[key];
  if (cu) return M.shape('path', { x: Math.round(x), y: Math.round(y), w: Math.round(w), h: Math.round(w), f: fill, d: cu.d, vb: [100, 100] });
  return M.shape('sym:' + key, { x: Math.round(x), y: Math.round(y), w: Math.round(w), h: Math.round(w), f: fill });
};
/* elementi del logo, centrati su una tela 1000 × 1000 */
LOGO.compose = (sp, mode = 'color') => {
  const P = sp.pal, ST_ = LOGO.style(sp.style), tf = sp.font, bf = ST_.b, name = (sp.name || 'Il tuo nome').trim(), tag = (sp.slogan || '').trim();
  const dark = mode === 'dark', mono = mode === 'mono', iconOnly = mode === 'icon';
  const ink = mono ? '#111111' : dark ? P.l : P.d, main = mono ? '#111111' : P.m, sec = mono ? '#111111' : P.s;
  const onMain = mono ? '#FFFFFF' : Col.readable(main), symOn = dark && Col.lum(main) > .45 ? P.d : onMain;
  const wt = ST_.wt, up = ST_.up, ls = ST_.ls, k = iconOnly ? 1.7 : 1, els = [];
  const txt = (t, x, y, w, s, c, o = {}) => { const e = GR.T(t, x, y, w, s, { f: o.f || tf, c, a: o.a || 'left', wt: o.wt || wt, ls: o.ls != null ? o.ls : ls, up: o.up != null ? o.up : up, lh: 1.05 }); return e; };
  const nameEl = (maxW, maxS, x, y, a) => { const s = LOGO.fit(name, tf, wt, maxW, maxS, ls, up); return txt(name, x, y, maxW, s, ink, { a }); };
  const tagEl = (maxW, x, y, a, size) => tag && !iconOnly ? txt(tag, x, y, maxW, size || 34, mono ? '#444444' : dark ? P.s : P.s, { f: bf, wt: 600, ls: .22, up: true, a }) : null;
  const sym = sp.sym, L = sp.layout, R_ = (L === 'horizontal' || L === 'duo' || L === 'underline');
  const out = [];
  if (L === 'stacked' || L === 'emblem' || L === 'badge' || L === 'monogram') {
    const D = (L === 'badge' ? 380 : L === 'monogram' ? 340 : L === 'emblem' ? 380 : 320) * k;
    if (L === 'badge') { out.push(GR.S('ring', 0, 0, D, D, main, { rad: 6 })); out.push(LOGO.symEl(sym, D * .26, D * .26, D * .48, mono ? '#111111' : dark ? P.l : main)); }
    else if (L === 'emblem') { out.push(GR.S('seal', 0, 0, D, D, main)); out.push(LOGO.symEl(sym, D * .27, D * .27, D * .46, symOn)); }
    else if (L === 'monogram') { out.push(GR.S('ellipse', 0, 0, D, D, main)); const ch = GR.T((name[0] || 'A').toUpperCase(), 0, 0, D, Math.round(D * .62), { f: tf, c: onMain, a: 'center', wt: Math.max(wt, 700), lh: 1 }); ch.y = Math.round((D - ch.h) / 2); out.push(ch); }
    else { out.push(GR.S('ellipse', 0, 0, D, D, main)); out.push(LOGO.symEl(sym, D * .25, D * .25, D * .5, symOn)); }
    if (!iconOnly) {
      const nm = nameEl(860, 150, 0, D + 40, 'center'); out.push(nm); const t2 = tagEl(860, 0, D + 40 + nm.h + 16, 'center'); t2 && out.push(t2);
      out.forEach(e => { if (e.t === 'text') { e.x = Math.round((D - 860) / 2); } });
    }
  } else if (L === 'horizontal' || L === 'duo') {
    const D = 250 * k; let cx = 0;
    if (L === 'duo') { if (!mono) out.push(LOGO.symEl(sym, 16, 16, D, sec)); out.push(LOGO.symEl(sym, 0, 0, D, main)); }
    else { out.push(GR.S('round', 0, 0, D, D, main, { rad: Math.round(D * .26) })); out.push(LOGO.symEl(sym, D * .22, D * .22, D * .56, symOn)); }
    if (!iconOnly) { const x0 = D + 46 + (L === 'duo' ? 16 : 0), nm = nameEl(720 - (L === 'duo' ? 16 : 0), 120, x0, 0, 'left'), t2 = tagEl(720, x0, 0, 'left', 30); const hh = nm.h + (t2 ? t2.h + 12 : 0); nm.y = Math.round((D - hh) / 2); out.push(nm); if (t2) { t2.y = Math.round(nm.y + nm.h + 12); out.push(t2); } }
  } else if (L === 'wordmark') {
    const s0 = LOGO.fit(name, tf, wt, 860, 190, ls, up); const nm = txt(name, 0, 130 * k, 860, s0, ink, { a: 'left' });
    out.push(LOGO.symEl(sym, 0, 0, 110 * k, main)); if (iconOnly) { out.length = 0; out.push(LOGO.symEl(sym, 0, 0, 380, main)); } else { out.push(nm); out.push(GR.S('rect', 0, nm.y + nm.h + 18, 150, 14, sec)); const t2 = tagEl(860, 0, nm.y + nm.h + 56, 'left'); t2 && out.push(t2); }
  } else { // underline
    const nm = nameEl(700, 160, 0, 0, 'left'), sy = Math.round(nm.h * .95);
    if (iconOnly) out.push(LOGO.symEl(sym, 0, 0, 380, main)); else { out.push(nm); out.push(LOGO.symEl(sym, nm.w + 40, Math.round((nm.h - sy) / 2), sy, main)); out.push(GR.S('rect', 0, nm.h + 26, nm.w + 40 + sy, 14, sec)); const t2 = tagEl(nm.w + 40 + sy, 0, nm.h + 62, 'right'); t2 && out.push(t2); }
  }
  // il testo a sinistra occupa la larghezza della scatola: si misura la parte occupata
  const box = out.map(e => { if (e.t === 'text') { const c = LOGO._ctx; c.font = `${e.wt || 400} ${e.s}px ${fontStack(e.f)}`; const t = e.up ? M.plain(e).toUpperCase() : M.plain(e), w = Math.min(e.w, c.measureText(t).width + (e.ls || 0) * e.s * t.length); const x = e.a === 'center' ? e.x + (e.w - w) / 2 : e.a === 'right' ? e.x + e.w - w : e.x; return { x, y: e.y, w, h: e.h }; } return { x: e.x, y: e.y, w: e.w, h: e.h }; });
  const x0 = Math.min(...box.map(b => b.x)), y0 = Math.min(...box.map(b => b.y)), x1 = Math.max(...box.map(b => b.x + b.w)), y1 = Math.max(...box.map(b => b.y + b.h));
  const k2 = Math.min(1, 840 / (x1 - x0), 760 / (y1 - y0));
  out.forEach(e => { e.x -= x0; e.y -= y0; if (k2 < 1) M.scaleEl(e, k2, k2, k2); });
  const dx = 500 - (x1 - x0) * k2 / 2, dy = 500 - (y1 - y0) * k2 / 2;
  out.forEach(e => { e.x = Math.round(e.x + dx); e.y = Math.round(e.y + dy); });
  return { els: out, bg: mono ? '#FFFFFF' : dark ? P.d : '#FFFFFF' };
};
LOGO.variants = (S) => {
  const sec = LOGO.sector(S.sector), sty = LOGO.style(S.style), list = [], syms = (S.aiSyms || []).concat(sec.sy);
  const pals = S.pal === -2 ? [-1] : S.pal >= 0 ? [S.pal] : sec.pals.concat(S.brandPal ? [-1] : []);
  for (let i = 0; i < 12; i++) {
    const pi = pals[(i + S.seed) % pals.length], pal = pi === -1 ? S.brandPal : LOGO.PALS[pi];
    list.push({ name: S.name, slogan: S.slogan, style: S.style, layout: LOGO.LAYOUTS[(i + S.seed) % LOGO.LAYOUTS.length], sym: syms[(i * 2 + S.seed) % syms.length], pal, font: sty.t[(i + S.seed) % sty.t.length] });
  }
  return list;
};
LOGO.fontsOf = (S) => { const sty = LOGO.style(S.style); return sty.t.map(f => [f, sty.wt]).concat([[sty.b, 600], [sty.b, 400], ...sty.t.map(f => [f, 700])]); };
/* progetto completo: pagina principale, su sfondo scuro, solo simbolo, monocromatica */
LOGO.deck = (sp) => {
  const slides = ['color', 'dark', 'icon', 'mono'].map(m => { const c = LOGO.compose(sp, m); return GR.slide(c.bg, c.els); });
  const d = M.newDeck({ name: 'Logo · ' + (sp.name || 'senza nome'), w: 1000, h: 1000, theme: 'minimale', slides });
  d.kind = 'design'; d.fmt = 'logo'; return d;
};

/* ---- finestra ---- */
LOGO.dialog = (o = {}) => {
  const brand = !ED_brandIsDefault() ? { n: 'Il mio marchio', m: ST.brand.colors[0], s: ST.brand.colors[1] || ST.brand.colors[0], d: ST.brand.colors[4] && Col.lum(ST.brand.colors[4]) < .3 ? ST.brand.colors[4] : '#14182B', l: '#FFFFFF' } : null;
  const S = { name: o.name || '', slogan: '', sector: 'tech', style: 'moderno', pal: -1, seed: 0, aiSyms: [], brandPal: brand, desc: '' };
  const grid = h('div.lgrid'), status = h('div.aistatus'), ctl = h('div.lctl');
  let token = 0;
  const render = async () => {
    const my = ++token; await loadFonts(LOGO.fontsOf(S)); if (my !== token) return;
    grid.innerHTML = '';
    LOGO.variants(S).forEach(sp => {
      const c = LOGO.compose(sp, 'color'), d = { w: 1000, h: 1000 }, sl = GR.slide(c.bg, c.els);
      const card = h('button.lcard' + (S.name ? '' : '.ghost'), { title: 'Usa questo logo', onclick: () => pick(sp) }, R.thumb(sl, d));
      grid.appendChild(card);
    });
  };
  const rerender = debounce(render, 220);
  const pick = async (sp) => {
    if (!S.name.trim()) { toast('Scrivi prima il nome della tua attività'); return; }
    await loadFonts(LOGO.fontsOf(S));
    m.close();
    if (typeof ED !== 'undefined' && ED.active && o.insert) { const c = LOGO.compose(sp, 'color'), bb = M.unionBox(c.els), g = { id: uid('e'), t: 'group', x: 0, y: 0, w: Math.round(bb.w * .6), h: Math.round(bb.h * .6), ow: Math.round(bb.w), oh: Math.round(bb.h), r: 0, els: c.els.map(e => { e.x = Math.round(e.x - bb.x); e.y = Math.round(e.y - bb.y); return e; }) }; ED.addEl(g); return; }
    App.create(LOGO.deck(sp));
  };
  const name = h('input.inp', { placeholder: 'Nome dell’attività', 'aria-label': 'Nome', value: S.name, oninput: e => { S.name = e.target.value; rerender(); } });
  const slogan = h('input.inp', { placeholder: 'Slogan (facoltativo)', 'aria-label': 'Slogan', oninput: e => { S.slogan = e.target.value; rerender(); } });
  const sect = h('select.inp', { 'aria-label': 'Settore', onchange: e => { S.sector = e.target.value; S.aiSyms = []; S.seed = 0; render(); } }, LOGO.SECTORS.map(s => h('option', { value: s.k }, s.n)));
  const chipRow = (items, cur, cb) => h('div.chips', items.map(([v, l]) => h('button.chip' + (cur() === v ? '.on' : ''), { onclick: e => { cb(v); $$('.chip', e.currentTarget.parentNode).forEach((b, i) => b.classList.toggle('on', items[i][0] === v)); } }, l)));
  const palRow = h('div.lpals');
  const drawPals = () => { palRow.innerHTML = ''; const all = [['-1', null], ...(brand ? [['b', brand]] : []), ...LOGO.PALS.map((p, i) => [String(i), p])]; all.forEach(([v, p]) => palRow.appendChild(h('button.lpal' + (S.pal === (v === 'b' ? -2 : +v) ? '.on' : ''), { title: p ? p.n : 'Automatica', 'aria-label': p ? p.n : 'Automatica', onclick: () => { S.pal = v === 'b' ? -2 : +v; drawPals(); render(); } }, p ? [h('i', { style: { background: p.m } }), h('i', { style: { background: p.s } }), h('i', { style: { background: p.d } })] : h('span', 'Auto')))); };
  drawPals();
  const more = h('button.btn.sm', { onclick: () => { S.seed += 3; render(); } }, icn('restore', 16), 'Altre proposte');
  const aiBox = AI.textOk() ? h('div.laibox', h('textarea.inp.area', { rows: 2, placeholder: 'Descrivi l’attività per farti aiutare dall’IA: “forno artigianale a Torino, pane a lievitazione naturale”', 'aria-label': 'Descrizione dell’attività', oninput: e => { S.desc = e.target.value; } }),
    h('button.btn.sm.primary', { onclick: async e => { if (!S.desc.trim()) return toast('Descrivi la tua attività'); const b = e.currentTarget; b.disabled = true; status.textContent = 'L’IA sta pensando al tuo marchio…'; try { await LOGO.askAI(S); name.value = S.name; slogan.value = S.slogan; sect.value = S.sector; styleRow.replaceWith(styleRow = mkStyle()); drawPals(); status.textContent = S.ideas && S.ideas.length ? 'Altre idee per il nome: ' + S.ideas.join(' · ') : 'Fatto: ecco le proposte.'; render(); } catch (er) { console.warn(er); status.textContent = AI.errMsg(er, 'Non sono riuscito a ricevere i suggerimenti: puoi compilare i campi a mano.'); } b.disabled = false; } }, icn('sparkles', 16), 'Suggerisci con l’IA')) : h('p.hint2', 'Con un servizio IA (Impostazioni) puoi anche descrivere l’attività e ricevere nome, slogan, stile e colori suggeriti.');
  const mkStyle = () => chipRow(LOGO.STYLES.map(s => [s.k, s.n]), () => S.style, v => { S.style = v; S.seed = 0; render(); });
  let styleRow = mkStyle();
  ctl.append(aiBox, status, h('label.flab', 'Nome'), name, h('label.flab', 'Slogan'), slogan, h('label.flab', 'Settore'), sect, h('label.flab', 'Stile'), styleRow, h('label.flab', 'Colori'), palRow, more);
  const body = h('div.logodlg', ctl, h('div.lright', h('p.hint2', 'Scegli un logo: si apre in un progetto con quattro versioni (colori, sfondo scuro, solo simbolo e monocromatica), tutto modificabile.'), grid));
  const m = UI.modal('Creatore di loghi', body, { cls: 'logomaker' });
  setTimeout(() => name.focus(), 120); render();
};
function ED_brandIsDefault() { return typeof ED !== 'undefined' && ED.brandIsDefault ? ED.brandIsDefault() : true; }

/* ---- suggerimenti dall'IA ---- */
LOGO.askAI = async (S) => {
  const inst = `Sei un designer di marchi italiano. Attività descritta dall'utente: """${S.desc}"""
Rispondi SOLO con JSON valido, senza testo prima o dopo, in questa forma:
{"name":"nome breve e memorabile","ideas":["altro nome 1","altro nome 2","altro nome 3"],"slogan":"slogan di massimo 6 parole","sector":"una tra ${LOGO.SECTORS.map(s => s.k).join('|')}","style":"uno tra ${LOGO.STYLES.map(s => s.k).join('|')}","palette":${LOGO.PALS.length ? '"un numero da 0 a ' + (LOGO.PALS.length - 1) + '"' : '0'},"symbols":["fino a 3 chiavi scelte tra: ${SYM_LIST.join(', ')}"],"paths":["fino a 2 simboli originali: ciascuno è l'attributo d di un <path> SVG su riquadro 100x100, una forma sola piena, semplice, con massimo 25 comandi, usando solo M L C Q Z in lettere maiuscole"]}`;
  const j = AI.json(await AI.ask(inst, { json: true, modelTier: 'default' }));
  if (j.name) S.name = String(j.name).slice(0, 40);
  if (j.slogan) S.slogan = String(j.slogan).slice(0, 60);
  S.ideas = Array.isArray(j.ideas) ? j.ideas.map(String).slice(0, 3) : [];
  if (LOGO.SECTORS.some(s => s.k === j.sector)) S.sector = j.sector;
  if (LOGO.STYLES.some(s => s.k === j.style)) S.style = j.style;
  S.pal = Number.isInteger(+j.palette) && +j.palette >= 0 && +j.palette < LOGO.PALS.length ? +j.palette : -1;
  const ok = (Array.isArray(j.symbols) ? j.symbols : []).filter(k => SYM[k]);
  const paths = (Array.isArray(j.paths) ? j.paths : []).map(String).filter(d => /^[MLCQZmlcqz0-9 .,\-]+$/.test(d) && d.length < 900).slice(0, 2);
  S.aiSyms = [];
  paths.forEach((d, i) => { const key = 'ai' + Date.now().toString(36) + i; LOGO.custom[key] = { d }; S.aiSyms.push(key); });
  S.aiSyms.push(...ok); S.seed = 0;
};

/* ============ Diagrammi e infografiche: scrivi una lista, ottieni processi, cicli, piramidi, organigrammi… ============ */
ICONS.diagram = '<circle cx="12" cy="5" r="2.6"/><circle cx="5" cy="19" r="2.6"/><circle cx="19" cy="19" r="2.6"/><path d="M12 7.6v4M12 11.6 6.4 16.9M12 11.6l5.6 5.3"/>';
const DG = { cache: new Map(), _c: document.createElement('canvas').getContext('2d') };

/* ---------- testo → elementi ---------- */
DG.parse = (txt) => txt.split('\n').filter(l => l.trim()).map(l => {
  const ind = (l.match(/^[ \t]*/)[0] || '').replace(/\t/g, '    ').length, body = l.trim().replace(/^[-•*·]\s*/, '');
  const i = body.indexOf(':'), t = (i > 0 ? body.slice(0, i) : body).trim(), d = i > 0 ? body.slice(i + 1).trim() : '';
  const v = parseFloat((d || t).replace(',', '.'));
  return { t, d, lvl: ind >= 4 ? 2 : ind >= 2 ? 1 : 0, v: isNaN(v) ? null : v };
});
DG.fit = (txt, w, h, maxS, minS, f, wt) => {
  const c = DG._c, words = String(txt).split(/\s+/);
  for (let s = maxS; s > minS; s -= 2) {
    c.font = `${wt || 700} ${s}px ${fontStack(f)}`; const sp = c.measureText(' ').width; let lines = 1, cur = 0, ok = true;
    for (const wd of words) { const ww = c.measureText(wd).width; if (ww > w) { ok = false; break; } if (cur && cur + sp + ww > w) { lines++; cur = ww; } else cur = cur ? cur + sp + ww : ww; }
    if (ok && lines * s * 1.2 <= h) return s;
  }
  return minS;
};
/* testo dentro un riquadro, adattato e centrato in verticale */
DG.tx = (Q, t, x, y, w, h, o = {}) => {
  if (!t) return null; const f = o.f || Q.fb, wt = o.wt || 600, s = o.s || DG.fit(t, w, h, o.max || 44, o.min || 14, f, wt);
  const e = GR.T(t, x, y, w, s, { f, c: o.c || Q.fg, a: o.a || 'center', wt, lh: o.lh || 1.15, ls: o.ls || 0, up: !!o.up });
  e.y = Math.round(o.top ? y : y + (h - e.h) / 2); return e;
};
DG.sh = (k, x, y, w, h, f, o) => GR.S(k, x, y, w, h, f, o);
DG.poly = (pts, fill, o = {}) => {
  const xs = pts.map(p => p[0]), ys = pts.map(p => p[1]), x0 = Math.min(...xs), y0 = Math.min(...ys), w = Math.max(...xs) - x0, h = Math.max(...ys) - y0;
  return M.shape('path', { x: Math.round(x0), y: Math.round(y0), w: Math.max(1, Math.round(w)), h: Math.max(1, Math.round(h)), f: fill, d: 'M' + pts.map(p => `${(p[0] - x0).toFixed(1)} ${(p[1] - y0).toFixed(1)}`).join('L') + 'Z', vb: [Math.max(1, w), Math.max(1, h)], ...o });
};
DG.line = (x1, y1, x2, y2, c, wd) => { const len = Math.hypot(x2 - x1, y2 - y1); return M.line({ x: Math.round((x1 + x2) / 2 - len / 2), y: Math.round((y1 + y2) / 2), w: Math.round(len), r: Math.round(Math.atan2(y2 - y1, x2 - x1) * 1800 / Math.PI) / 10, st: { c, w: wd || 4, d: 0 } }); };
DG.rgba = (hex, a) => { const [r, g, b] = Col.hex2rgb(hex); return `rgba(${r},${g},${b},${a})`; };
DG.col = (Q, i) => Q.c[i % Q.c.length];

/* ---------- tipi ---------- */
DG.TYPES = {};
const dt = (k, n, ic, w, h, sample, hint, fn) => { DG.TYPES[k] = { k, n, ic, w, h, sample, hint, fn }; };

dt('steps', 'Processo a frecce', 'arrowR', 1600, 400, 'Idea: Raccogliere le richieste\nProgetto: Disegnare la soluzione\nSviluppo: Realizzare\nLancio: Pubblicare', 'Una riga per passo: “Titolo: descrizione”', (it, W, H, Q) => {
  const n = it.length, ov = n > 1 ? .1 : 0, cw = W / (n - (n - 1) * ov), ch = Math.min(H * .34, cw * .5), els = [];
  it.forEach((p, i) => {
    const x = i * cw * (1 - ov), c = DG.col(Q, i);
    els.push(DG.sh('chevron', x, H * .06, cw, ch, c));
    els.push(DG.tx(Q, p.t, x + cw * .2, H * .06, cw * .58, ch, { c: Col.readable(c), f: Q.fd, wt: 700, max: 46 }));
    els.push(DG.tx(Q, p.d, x + cw * .1, H * .06 + ch + 26, cw * .76, H * .5, { top: 1, wt: 400, max: 34, min: 16, c: Q.fg }));
  });
  return els;
});
dt('cards', 'Passi numerati', 'list', 1600, 760, 'Scegli: Trova lo stile giusto\nScrivi: Racconta la tua idea\nRifinisci: Cura colori e immagini\nPresenta: Vai sul palco', 'Una riga per scheda: “Titolo: descrizione”', (it, W, H, Q) => {
  const n = it.length, g = W * .03, cw = (W - (n - 1) * g) / n, els = [];
  it.forEach((p, i) => {
    const x = i * (cw + g), c = DG.col(Q, i), d = Math.min(cw * .34, 120);
    els.push(DG.sh('round', x, 0, cw, H, Q.card, { rad: 36 }));
    els.push(DG.sh('ellipse', x + cw / 2 - d / 2, H * .08, d, d, c));
    els.push(DG.tx(Q, String(i + 1), x + cw / 2 - d / 2, H * .08, d, d, { c: Col.readable(c), f: Q.fd, wt: 800, max: Math.round(d * .6) }));
    els.push(DG.tx(Q, p.t, x + cw * .08, H * .08 + d + 26, cw * .84, H * .2, { f: Q.fd, wt: 700, max: 44, c: Q.fg }));
    els.push(DG.tx(Q, p.d, x + cw * .08, H * .08 + d + 26 + H * .21, cw * .84, H * .4, { top: 1, wt: 400, max: 30, min: 15, c: Q.fg }));
  });
  return els;
});
dt('cycle', 'Ciclo', 'restore', 1500, 1000, 'Pianifica: Definisci gli obiettivi\nRealizza: Metti in pratica\nVerifica: Misura i risultati\nMigliora: Correggi e ricomincia', 'Una riga per tappa: “Titolo: descrizione”', (it, W, H, Q) => {
  const n = it.length, D = Math.min(W, H), cx = W / 2, cy = H / 2, R = D * .25, r = D * .08, els = [];
  els.push(DG.sh('ring', cx - R - 6, cy - R - 6, 2 * R + 12, 2 * R + 12, Q.line, { rad: 1.4 }));
  it.forEach((p, i) => {
    const a = (-90 + i * 360 / n) * Math.PI / 180, x = cx + Math.cos(a) * R, y = cy + Math.sin(a) * R, c = DG.col(Q, i);
    const am = (-90 + (i + .5) * 360 / n), arr = DG.sh('triangle', cx + Math.cos(am * Math.PI / 180) * R - D * .022, cy + Math.sin(am * Math.PI / 180) * R - D * .022, D * .044, D * .044, Q.fg, { r: Math.round(am + 180) }); els.push(arr);
    els.push(DG.sh('ellipse', x - r, y - r, 2 * r, 2 * r, c), DG.tx(Q, String(i + 1), x - r, y - r, 2 * r, 2 * r, { c: Col.readable(c), f: Q.fd, wt: 800, max: Math.round(r * 1.1) }));
    const lw = D * .34, c0 = Math.cos(a), side = c0 > .3 ? 'l' : c0 < -.3 ? 'r' : 'c', lx = side === 'l' ? x + r + 18 : side === 'r' ? x - r - 18 - lw : x - lw / 2, ly = side === 'c' ? (Math.sin(a) < 0 ? y - r - 18 - D * .16 : y + r + 18) : y - D * .08;
    els.push(DG.tx(Q, p.t, lx, ly, lw, D * .07, { a: side === 'l' ? 'left' : side === 'r' ? 'right' : 'center', f: Q.fd, wt: 700, max: 40, c: Q.fg, top: 1 }));
    els.push(DG.tx(Q, p.d, lx, ly + D * .075, lw, D * .09, { a: side === 'l' ? 'left' : side === 'r' ? 'right' : 'center', wt: 400, max: 26, min: 14, c: Q.fg, top: 1 }));
  });
  return els;
});
dt('pyramid', 'Piramide', 'diagram', 1500, 900, 'Visione: Dove vogliamo arrivare\nStrategia: Come ci arriviamo\nPiano: Le azioni principali\nOperatività: Il lavoro di ogni giorno', 'Dall’alto verso il basso: “Titolo: descrizione”', (it, W, H, Q) => {
  const n = it.length, Wp = W * .5, lh = H / n, els = [];
  it.forEach((p, i) => {
    const y0 = i * lh + (i ? 5 : 0), y1 = (i + 1) * lh - 5, cx = Wp / 2, wt = Wp * (i / n) , wb = Wp * ((i + 1) / n), c = DG.col(Q, i);
    els.push(DG.poly([[cx - wt / 2, y0], [cx + wt / 2, y0], [cx + wb / 2, y1], [cx - wb / 2, y1]], c));
    els.push(DG.tx(Q, String(i + 1), cx - 40, y0 + (y1 - y0) / 2 - 24 + (i === 0 ? 14 : 0), 80, 48, { c: Col.readable(c), f: Q.fd, wt: 800, max: 40 }));
    const my = (y0 + y1) / 2, xr = cx + (wt + wb) / 4 + 24;
    els.push(DG.line(xr, my, Wp + 40, my, Q.line, 3));
    els.push(DG.tx(Q, p.t, Wp + 70, y0, W - Wp - 70, lh * .4, { a: 'left', f: Q.fd, wt: 700, max: 42, c: Q.fg, top: 1 }));
    els.push(DG.tx(Q, p.d, Wp + 70, y0 + lh * .38, W - Wp - 70, lh * .5, { a: 'left', wt: 400, max: 28, min: 14, c: Q.fg, top: 1 }));
  });
  return els;
});
dt('funnel', 'Imbuto', 'diagram', 1400, 900, 'Visitatori: 10.000 persone\nInteressati: 3.200\nProve gratuite: 900\nClienti: 240', 'Dall’alto: “Fase: valore”', (it, W, H, Q) => {
  const n = it.length, Wf = W * .62, lh = H / n, els = [];
  it.forEach((p, i) => {
    const y0 = i * lh + (i ? 4 : 0), y1 = (i + 1) * lh - 4, cx = Wf / 2, wt = Wf * (1 - i / n * .72), wb = Wf * (1 - (i + 1) / n * .72), c = DG.col(Q, i);
    els.push(DG.poly([[cx - wt / 2, y0], [cx + wt / 2, y0], [cx + wb / 2, y1], [cx - wb / 2, y1]], c));
    els.push(DG.tx(Q, p.t, cx - wb / 2 + 20, y0, wb - 40, y1 - y0, { c: Col.readable(c), f: Q.fd, wt: 700, max: 40 }));
    if (p.d) els.push(DG.tx(Q, p.d, Wf + 50, y0, W - Wf - 50, y1 - y0, { a: 'left', f: Q.fd, wt: 800, max: 52, c: Q.fg }));
  });
  return els;
});
dt('venn', 'Diagramma di Venn', 'target', 1300, 880, 'Passione: Quello che ami\nCompetenza: Quello che sai fare\nMercato: Quello che serve agli altri\nIl tuo posto', 'Fino a 3 cerchi; una riga in più diventa l’area comune', (it, W, H, Q) => {
  const k = Math.min(3, it.filter(p => p.t).length), d = k === 2 ? Math.min(H * .78, W * .5) : Math.min(H * .6, W * .38), els = [], cx = W / 2, cy = H / 2;
  const pos = k === 2 ? [[cx - d * .32, cy], [cx + d * .32, cy]] : [[cx, cy - d * .28], [cx - d * .32, cy + d * .2], [cx + d * .32, cy + d * .2]];
  for (let i = 0; i < k; i++) { const c = DG.col(Q, i); els.push(DG.sh('ellipse', pos[i][0] - d / 2, pos[i][1] - d / 2, d, d, DG.rgba(c, .55), { st: { c, w: 5, d: 0 } })); }
  for (let i = 0; i < k; i++) {
    const p = it[i], dx = (pos[i][0] - cx) * 1.0, dy = (pos[i][1] - cy) * 1.0, tx = pos[i][0] + dx * .55 - d * .26, ty = pos[i][1] + dy * .6 - d * .15;
    els.push(DG.tx(Q, p.t, tx, ty - d * .06, d * .52, d * .14, { f: Q.fd, wt: 800, max: 38, c: Q.fg }), DG.tx(Q, p.d, tx, ty + d * .08, d * .52, d * .14, { wt: 400, max: 24, min: 13, c: Q.fg, top: 1 }));
  }
  if (it[k]) els.push(DG.tx(Q, it[k].t, cx - d * .16, cy + (k === 3 ? d * .02 : -d * .06) - d * .06, d * .32, d * .12, { f: Q.fd, wt: 800, max: 30, c: Q.fg }));
  return els;
});
dt('org', 'Organigramma', 'diagram', 1700, 900, 'Direzione\n  Marketing\n    Social\n    Eventi\n  Prodotto\n    Design\n    Sviluppo\n  Vendite', 'Rientra le righe per creare i livelli sotto', (it, W, H, Q) => {
  const root = { t: '', kids: [], lvl: -1 }, stack = [root];
  it.forEach(p => { const node = { ...p, kids: [] }, l = Math.min(p.lvl, 2); while (stack.length > l + 1) stack.pop(); stack[stack.length - 1].kids.push(node); stack.push(node); });
  const top = root.kids.length === 1 ? root.kids[0] : { t: root.kids[0] ? '' : '', kids: root.kids, lvl: 0, ghost: 1 };
  let leaves = 0; const cnt = n => { n._l = n.kids.length ? n.kids.reduce((a, k) => a + cnt(k), 0) : 1; return n._l; }; leaves = cnt(top);
  const depth = n => 1 + (n.kids.length ? Math.max(...n.kids.map(depth)) : 0), dp = depth(top);
  const bw = Math.min(300, W / leaves * .82), bh = Math.min(110, H / dp * .5), vg = (H - dp * bh) / Math.max(1, dp - 1), els = [], boxes = [];
  const place = (n, x0, lv) => { const wU = W / leaves; n._x = x0 + n._l * wU / 2; let cx = x0; n.kids.forEach(k => { place(k, cx, lv + 1); cx += k._l * wU; }); n._y = lv * (bh + vg); };
  place(top, 0, 0);
  const draw = (n, lv) => {
    if (n.kids.length) {
      const yb = n._y + bh, ym = yb + vg / 2, xs = n.kids.map(k => k._x);
      els.push(DG.sh('rect', n._x - 2, yb, 4, vg / 2, Q.line)); els.push(DG.sh('rect', Math.min(...xs) - 2, ym - 2, Math.max(...xs) - Math.min(...xs) + 4, 4, Q.line));
      n.kids.forEach(k => els.push(DG.sh('rect', k._x - 2, ym, 4, k._y - ym, Q.line)));
    }
    n.kids.forEach(k => draw(k, lv + 1));
    if (!n.ghost) { const c = DG.col(Q, lv); els.push(DG.sh('round', n._x - bw / 2, n._y, bw, bh, lv === 0 ? c : Q.card, { rad: 22, st: lv === 0 ? null : { c, w: 5, d: 0 } })); els.push(DG.tx(Q, n.t, n._x - bw / 2 + 10, n._y, bw - 20, bh, { c: lv === 0 ? Col.readable(c) : Q.fg, f: Q.fd, wt: 700, max: 34 })); }
  };
  draw(top, 0); return els;
});
dt('mind', 'Mappa mentale', 'diagram', 1600, 1000, 'Il mio progetto\nObiettivi\n  Crescere\n  Sperimentare\nPersone\nBudget\n  Costi\n  Ricavi\nTempi', 'La prima riga è al centro; rientra per i dettagli', (it, W, H, Q) => {
  const c0 = it[0] || { t: '' }, br = []; it.slice(1).forEach(p => { if (p.lvl === 0 || !br.length) br.push({ ...p, kids: [] }); else br[br.length - 1].kids.push(p); });
  const cx = W / 2, cy = H / 2, els = [], n = Math.max(1, br.length), rx = W * .3, ry = H * .33, cwid = Math.min(W * .22, 380), chh = cwid * .5;
  const nodes = [];
  br.forEach((b, i) => {
    const a = (-90 + i * 360 / n) * Math.PI / 180, x = cx + Math.cos(a) * rx, y = cy + Math.sin(a) * ry, c = DG.col(Q, i), bw = Math.min(W * .2, 340), bh = 100;
    els.push(DG.line(cx, cy, x, y, c, 6)); nodes.push({ b, x, y, c, bw, bh, a });
    b.kids.forEach((k, j) => {
      const m = b.kids.length, off = (j - (m - 1) / 2) * .34, a2 = a + off, x2 = cx + Math.cos(a2) * rx * 1.62, y2 = cy + Math.sin(a2) * ry * 1.52, kw = Math.min(W * .17, 280);
      const xx = Math.max(kw / 2 + 4, Math.min(W - kw / 2 - 4, x2)), yy = Math.max(30, Math.min(H - 30, y2));
      els.push(DG.line(x, y, xx, yy, c, 3));
      nodes.push({ sub: k, x: xx, y: yy, c, bw: kw, bh: 70 });
    });
  });
  nodes.forEach(nd => {
    if (nd.sub) { els.push(DG.sh('pill', nd.x - nd.bw / 2, nd.y - nd.bh / 2, nd.bw, nd.bh, Q.card, { st: { c: nd.c, w: 4, d: 0 } }), DG.tx(Q, nd.sub.t, nd.x - nd.bw / 2 + 12, nd.y - nd.bh / 2, nd.bw - 24, nd.bh, { max: 30, min: 14, c: Q.fg })); }
    else { els.push(DG.sh('pill', nd.x - nd.bw / 2, nd.y - nd.bh / 2, nd.bw, nd.bh, nd.c), DG.tx(Q, nd.b.t, nd.x - nd.bw / 2 + 14, nd.y - nd.bh / 2, nd.bw - 28, nd.bh, { c: Col.readable(nd.c), f: Q.fd, wt: 700, max: 38, min: 16 })); }
  });
  els.push(DG.sh('ellipse', cx - cwid / 2, cy - chh / 2 - 20, cwid, chh + 40, Q.fg), DG.tx(Q, c0.t, cx - cwid / 2 + 20, cy - chh / 2 - 20, cwid - 40, chh + 40, { c: Col.readable(Q.fg), f: Q.fd, wt: 800, max: 40 }));
  return els;
});
dt('timeline', 'Linea del tempo', 'clock', 1700, 700, '2021: Nasce l’idea\n2022: Primo prototipo\n2023: Lancio ufficiale\n2024: Mille clienti\n2025: Nuovi mercati', 'Una riga per tappa: “Data: evento”', (it, W, H, Q) => {
  const n = it.length, els = [], y = H / 2, gw = W / n;
  els.push(DG.sh('round', 0, y - 4, W, 8, Q.line, { rad: 4 }));
  it.forEach((p, i) => {
    const x = gw * i + gw / 2, c = DG.col(Q, i), up = i % 2 === 0, bh = H * .34;
    els.push(DG.sh('ellipse', x - 20, y - 20, 40, 40, c, { st: { c: Q.bg, w: 8, d: 0 } }));
    els.push(DG.sh('rect', x - 2, up ? y - H * .12 : y + 20, 4, H * .12 - 20 + (up ? 0 : 0), Q.line));
    const ty = up ? y - H * .12 - bh : y + H * .12;
    els.push(DG.tx(Q, p.t, x - gw * .46, ty, gw * .92, bh * .36, { f: Q.fd, wt: 800, max: 46, c: c === Q.bg ? Q.fg : c, top: up ? 0 : 1 }));
    if (p.d) els.push(DG.tx(Q, p.d, x - gw * .46, ty + bh * .38, gw * .92, bh * .6, { wt: 400, max: 28, min: 14, c: Q.fg, top: 1 }));
  });
  return els;
});
dt('matrix', 'Matrice 2×2 (SWOT)', 'grid', 1500, 900, 'Punti di forza: team esperto, marchio noto\nDebolezze: budget limitato, pochi canali\nOpportunità: nuovi mercati, tecnologia\nMinacce: concorrenza, normative', 'Fino a 4 righe: “Titolo: voce, voce, voce”', (it, W, H, Q) => {
  const g = 22, qw = (W - g) / 2, qh = (H - g) / 2, els = [];
  it.slice(0, 4).forEach((p, i) => {
    const x = (i % 2) * (qw + g), y = Math.floor(i / 2) * (qh + g), c = DG.col(Q, i), on = Col.readable(c), items = (p.d || '').split(/[,;]\s*/).filter(Boolean);
    els.push(DG.sh('round', x, y, qw, qh, c, { rad: 34 }));
    els.push(DG.tx(Q, p.t, x + 36, y + 24, qw - 72, qh * .2, { a: 'left', f: Q.fd, wt: 800, max: 46, c: on }));
    if (items.length) { const t = GR.T(items.map(s => '• ' + s).join('\n'), x + 36, y + 24 + qh * .24, qw - 72, DG.fit(items.map(s => '• ' + s).join(' '), qw - 72, qh * .62, 34, 14, Q.fb, 500) , { f: Q.fb, c: on, a: 'left', wt: 500, lh: 1.35 }); els.push(t); }
  });
  return els;
});
dt('versus', 'Confronto', 'flipH', 1500, 860, 'Prima: lento, manuale, costoso\nDopo: veloce, automatico, economico', 'Due righe: “Titolo: voce, voce, voce”', (it, W, H, Q) => {
  const g = 90, cw = (W - g) / 2, els = [];
  it.slice(0, 2).forEach((p, i) => {
    const x = i * (cw + g), c = DG.col(Q, i), items = (p.d || '').split(/[,;]\s*/).filter(Boolean);
    els.push(DG.sh('round', x, 0, cw, H, Q.card, { rad: 34 }), DG.sh('round', x, 0, cw, H * .2, c, { rad: 34 }), DG.sh('rect', x, H * .1, cw, H * .1, c));
    els.push(DG.tx(Q, p.t, x + 30, 0, cw - 60, H * .2, { c: Col.readable(c), f: Q.fd, wt: 800, max: 50 }));
    items.forEach((s, j) => { const yy = H * .26 + j * (H * .7 / Math.max(3, items.length)); els.push(DG.sh('ellipse', x + 40, yy + 12, 22, 22, c)); els.push(DG.tx(Q, s, x + 84, yy, cw - 120, 48, { a: 'left', wt: 500, max: 32, min: 14, c: Q.fg })); });
  });
  els.push(DG.sh('ellipse', W / 2 - 50, H / 2 - 50, 100, 100, Q.fg, { st: { c: Q.bg, w: 8, d: 0 } }), DG.tx(Q, 'VS', W / 2 - 50, H / 2 - 50, 100, 100, { c: Col.readable(Q.fg), f: Q.fd, wt: 800, max: 40 }));
  return els;
});
dt('kpi', 'Numeri chiave', 'chart', 1600, 560, '98%: Clienti soddisfatti\n2,4 M: Utenti attivi\n+35%: Crescita annua\n24/7: Assistenza', 'Una riga per indicatore: “Numero: descrizione”', (it, W, H, Q) => {
  const n = it.length, g = W * .025, cw = (W - (n - 1) * g) / n, els = [];
  it.forEach((p, i) => {
    const x = i * (cw + g), c = DG.col(Q, i);
    els.push(DG.sh('round', x, 0, cw, H, Q.card, { rad: 32 }), DG.sh('rect', x + cw * .1, H * .12, cw * .22, 8, c));
    els.push(DG.tx(Q, p.t, x + 20, H * .2, cw - 40, H * .36, { f: Q.fd, wt: 800, max: 110, c }));
    els.push(DG.tx(Q, p.d, x + 30, H * .6, cw - 60, H * .3, { wt: 500, max: 32, min: 14, c: Q.fg, top: 1 }));
  });
  return els;
});
dt('rings', 'Anelli di avanzamento', 'target', 1600, 640, 'Design: 90\nSviluppo: 65\nTest: 40\nLancio: 15', 'Una riga per anello: “Titolo: percentuale”', (it, W, H, Q) => {
  const n = it.length, d = Math.min(H * .7, W / n * .78), sw = d * .13, els = [], gw = W / n;
  it.forEach((p, i) => {
    const cx = gw * i + gw / 2, x = cx - d / 2, y = H * .02, c = DG.col(Q, i), v = Math.max(0, Math.min(100, p.v == null ? 50 : p.v)), r = (d - sw) / 2, o = d / 2;
    els.push(M.shape('ellipse', { x: Math.round(x + sw / 2), y: Math.round(y + sw / 2), w: Math.round(d - sw), h: Math.round(d - sw), f: null, st: { c: Q.line, w: Math.round(sw), d: 0 } }));
    const a1 = (-90 + v * 3.6) * Math.PI / 180, big = v > 50 ? 1 : 0, ex = o + r * Math.cos(a1), ey = o + r * Math.sin(a1);
    if (v >= 99.5) els.push(M.shape('ellipse', { x: Math.round(x + sw / 2), y: Math.round(y + sw / 2), w: Math.round(d - sw), h: Math.round(d - sw), f: null, st: { c, w: Math.round(sw), d: 0 } }));
    else if (v > 0) els.push(M.shape('path', { x: Math.round(x), y: Math.round(y), w: Math.round(d), h: Math.round(d), f: null, d: `M${o} ${o - r}A${r} ${r} 0 ${big} 1 ${ex.toFixed(1)} ${ey.toFixed(1)}`, vb: [d, d], st: { c, w: Math.round(sw), d: 0 }, lc: 1 }));
    els.push(DG.tx(Q, Math.round(v) + '%', x, y, d, d, { f: Q.fd, wt: 800, max: Math.round(d * .26), c: Q.fg }));
    els.push(DG.tx(Q, p.t, cx - gw * .45, y + d + 24, gw * .9, H * .16, { f: Q.fd, wt: 700, max: 38, c: Q.fg, top: 1 }));
  });
  return els;
});
dt('bars', 'Barre di avanzamento', 'bars', 1400, 760, 'Creatività: 90\nOrganizzazione: 75\nVelocità: 60\nPrecisione: 85', 'Una riga per barra: “Titolo: percentuale”', (it, W, H, Q) => {
  const n = it.length, rh = H / n, bh = Math.min(34, rh * .3), els = [];
