/* ---------- formule ---------- */
const MATH = { URL: 'https://cdn.jsdelivr.net/npm/mathjax@3.2.2/es5/tex-svg.js' };
MATH.EX = [['Formula risolutiva', 'x = \\frac{-b \\pm \\sqrt{b^2 - 4ac}}{2a}'], ['Integrale', '\\int_{0}^{\\infty} e^{-x^2}\\,dx = \\frac{\\sqrt{\\pi}}{2}'], ['Sommatoria', '\\sum_{n=1}^{\\infty} \\frac{1}{n^2} = \\frac{\\pi^2}{6}'], ['Eulero', 'e^{i\\pi} + 1 = 0'], ['Pitagora', 'a^2 + b^2 = c^2'], ['Matrice', '\\begin{pmatrix} a & b \\\\ c & d \\end{pmatrix}'], ['Limite', '\\lim_{x \\to 0} \\frac{\\sin x}{x} = 1'], ['Energia', 'E = mc^2']];
MATH.load = async () => {
  if (window.MathJax && MathJax.tex2svg) return;
  window.MathJax = { startup: { typeset: false }, svg: { fontCache: 'none' }, tex: { inlineMath: [] } };
  await EX.loadScript(MATH.URL); await MathJax.startup.promise;
};
MATH.render = async (tex, color, size) => {
  await MATH.load(); const node = MathJax.tex2svg(tex, { display: true }), svg = node.querySelector('svg'); if (!svg) throw new Error('svg');
  if (node.querySelector('[data-mjx-error]') || node.querySelector('merror')) throw new Error('tex');
  const ex = v => parseFloat(v) * (/ex$/.test(v) ? 8.2 : 1) * (size / 40), w = ex(svg.getAttribute('width')), h2 = ex(svg.getAttribute('height'));
  svg.setAttribute('width', w.toFixed(1)); svg.setAttribute('height', h2.toFixed(1)); svg.removeAttribute('style'); svg.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
  let out = new XMLSerializer().serializeToString(svg).replace(/currentColor/g, color);
  return { svg: out, w: Math.round(w), h: Math.round(h2) };
};
ED.mathDialog = (edit) => {
  const S = edit ? { ...edit.math } : { tex: MATH.EX[0][1], color: ED.themeTxt().fg, size: 70 }, prev = h('div.mathprev'), err = h('p.hint2');
  let tok = 0;
  const draw = async () => {
    const my = ++tok; err.textContent = '';
    try { const r = await MATH.render(S.tex, S.color, 40); if (my !== tok) return; prev.innerHTML = ''; const im = h('img', { src: 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(r.svg), alt: S.tex }); im.style.maxWidth = '100%'; im.style.maxHeight = '180px'; prev.appendChild(im); }
    catch (e) { if (my === tok) err.textContent = e.message === 'tex' ? 'La formula contiene un errore.' : 'Non riesco a caricare il motore delle formule (serve internet).'; }
  };
  const redraw = debounce(draw, 300);
  const ta = h('textarea.inp.area', { rows: 4, spellcheck: false, 'aria-label': 'Formula LaTeX', style: { fontFamily: "'JetBrains Mono', monospace" }, oninput: e => { S.tex = e.target.value; redraw(); } }, S.tex);
  const sw = h('input', { type: 'color', value: /^#[0-9a-f]{6}$/i.test(S.color) ? S.color : '#000000', 'aria-label': 'Colore', oninput: e => { S.color = e.target.value; redraw(); } });
  const exs = h('div.chips', MATH.EX.map(([n, t]) => h('button.chip', { onclick: () => { S.tex = t; ta.value = t; draw(); } }, n)));
  const m = UI.modal(edit ? 'Modifica la formula' : 'Formula matematica', h('div.form', h('p.mtext', 'Scrivi la formula in LaTeX (come nei documenti scientifici) oppure scegli un esempio.'), ta, exs, h('div.row', { style: { alignItems: 'center' } }, h('label.flab', 'Colore'), sw), prev, err), {
    cls: 'wide2', foot: [h('span.grow'), h('button.btn', { onclick: () => m.close() }, 'Annulla'), h('button.btn.primary', { onclick: async () => {
      try {
        const r = await MATH.render(S.tex, S.color, S.size), ref = await Img.store(new Blob([r.svg], { type: 'image/svg+xml' })); (ED.deck.imgs = ED.deck.imgs || []).unshift(ref); m.close();
        const k = Math.min(1, ED.deck.w * .8 / r.w, ED.deck.h * .6 / r.h);
        if (edit) ED.mut(x => { x.src = ref; x.math = { ...S }; x.h = Math.round(x.w * r.h / r.w); }, { els: [edit] }); else ED.addEl(M.image(ref, { w: Math.round(r.w * k), h: Math.round(r.h * k), math: { ...S }, alt: S.tex }));
      } catch (e) { err.textContent = e.message === 'tex' ? 'La formula contiene un errore.' : 'Non riesco a creare la formula (serve internet).'; }
    } }, icn('check', 16), edit ? 'Aggiorna' : 'Inserisci')]
  });
  draw(); setTimeout(() => ta.focus(), 100);
};

/* ---------- accesso dall'editor ---------- */
const elems0 = ED.panels.elements;
ED.panels.elements = () => {
  const r = elems0(); const sec = psec('Codice e formule', h('div.btnrow', h('button.btn.sm', { onclick: () => ED.codeDialog() }, icn('code', 16), 'Codice'), h('button.btn.sm', { onclick: () => ED.mathDialog() }, icn('sliders', 16), 'Formula')), h('p.hint2', 'Codice con i colori come in un editor e formule in LaTeX: si modificano quando vuoi.'));
  return Array.isArray(r) ? [r[0], sec, ...r.slice(1)] : [sec, r];
};
ICONS.code = '<path d="m8 6-6 6 6 6M16 6l6 6-6 6M14 4l-4 16"/>';
const codeCtx0 = ED.renderCtx;
ED.renderCtx = () => {
  codeCtx0(); const els = ED.selEls(), c = $('#ctx'); if (!c || ED.crop || ED.editing || els.length !== 1) return; const e = els[0];
  if (e.t === 'text' && e.code) c.prepend(TB.btn('code', 'Modifica il codice: linguaggio, stile e numeri di riga', () => ED.codeDialog(e), false, 'Modifica il codice'));
  else if (e.t === 'image' && e.math) c.prepend(TB.btn('code', 'Modifica la formula', () => ED.mathDialog(e), false, 'Modifica la formula'));
};
ED.commandList0 = ED.commandList;
ED.commandList = () => { const L = ED.commandList0(); L.push({ label: 'Aggiungi: Blocco di codice', hint: 'codice programmazione', fn: () => ED.codeDialog(), ic: 'code' }, { label: 'Aggiungi: Formula matematica', hint: 'formula latex equazione', fn: () => ED.mathDialog(), ic: 'sliders' }); return L; };

/* ============ Novità moderne: elenchi che diventano diagrammi (e viceversa), radar, indicatori e cascata ============ */
dt('radar', 'Radar', 'target', 1100, 1000, 'Creatività: 85\nTecnica: 70\nVelocità: 60\nQualità: 90\nSquadra: 75', 'Da 3 a 8 voci: “Titolo: valore da 0 a 100”', (it, W, H, Q) => {
  const n = Math.max(3, it.length), items = it.concat(Array.from({ length: Math.max(0, 3 - it.length) }, () => ({ t: '', v: 0 }))), cx = W / 2, cy = H / 2 + 6, R = Math.min(W, H) * .31, els = [];
  const at = (i, r) => { const a = -Math.PI / 2 + i * 2 * Math.PI / n; return [cx + Math.cos(a) * r, cy + Math.sin(a) * r]; };
  for (let lv = 1; lv <= 4; lv++) els.push(DG.poly(items.map((_, i) => at(i, R * lv / 4)), null, { f: null, st: { c: Q.line, w: lv === 4 ? 4 : 2.5, d: 0 } }));
  items.forEach((p, i) => { const [x, y] = at(i, R); els.push(DG.line(cx, cy, x, y, Q.line, 2.5)); });
  const c0 = DG.col(Q, 0), pts = items.map((p, i) => at(i, R * Math.max(.04, Math.min(100, p.v == null ? 50 : p.v) / 100)));
  els.push(DG.poly(pts, DG.rgba(c0, .38), { st: { c: c0, w: 7, d: 0 } }));
  pts.forEach(([x, y]) => els.push(DG.sh('ellipse', x - 14, y - 14, 28, 28, c0, { st: { c: Q.bg, w: 5, d: 0 } })));
  items.forEach((p, i) => { const [x, y] = at(i, R * 1.2), c = Math.cos(-Math.PI / 2 + i * 2 * Math.PI / n), bw = 260, ax = c > .3 ? 'left' : c < -.3 ? 'right' : 'center', bx = ax === 'left' ? x - 20 : ax === 'right' ? x - bw + 20 : x - bw / 2; if (p.t) els.push(DG.tx(Q, p.t, bx, y - 44, bw, 88, { a: ax, f: Q.fd, wt: 700, max: 34, c: Q.fg })); });
  return els;
});
dt('gauge', 'Indicatori a lancetta', 'trend', 1500, 620, 'Soddisfazione: 78\nPuntualità: 92\nQualità: 64', 'Una riga per indicatore: “Titolo: valore da 0 a 100”', (it, W, H, Q) => {
  const n = it.length, gw = W / n, r = Math.min(gw * .42, H * .52), sw = r * .26, els = [];
  it.forEach((p, i) => {
    const cx = gw * i + gw / 2, cy = H * .62, v = Math.max(0, Math.min(100, p.v == null ? 50 : p.v)), c = DG.col(Q, i), R2 = r - sw / 2;
    els.push(M.shape('path', { x: Math.round(cx - r), y: Math.round(cy - r), w: Math.round(2 * r), h: Math.round(r + sw), f: null, d: `M${sw / 2} ${r}A${R2} ${R2} 0 0 1 ${2 * r - sw / 2} ${r}`, vb: [2 * r, r + sw], st: { c: Q.line, w: Math.round(sw), d: 0 }, lc: 1 }));
    const th = Math.PI + Math.PI * v / 100, ex = r + R2 * Math.cos(th), ey = r + R2 * Math.sin(th);
    if (v > 0.5) els.push(M.shape('path', { x: Math.round(cx - r), y: Math.round(cy - r), w: Math.round(2 * r), h: Math.round(r + sw), f: null, d: `M${sw / 2} ${r}A${R2} ${R2} 0 0 1 ${ex.toFixed(1)} ${ey.toFixed(1)}`, vb: [2 * r, r + sw], st: { c, w: Math.round(sw), d: 0 }, lc: 1 }));
    const nx = cx + Math.cos(th) * (R2 - sw * .1), ny = cy + Math.sin(th) * (R2 - sw * .1); els.push(DG.line(cx, cy, nx, ny, Q.fg, 9), DG.sh('ellipse', cx - 20, cy - 20, 40, 40, Q.fg));
    els.push(DG.tx(Q, Math.round(v) + '%', cx - r, cy + 30, 2 * r, H * .17, { f: Q.fd, wt: 800, max: 76, c: Q.fg }), DG.tx(Q, p.t, cx - gw * .45, cy + 30 + H * .17, gw * .9, H * .12, { f: Q.fd, wt: 600, max: 34, c: Q.fg, top: 1 }));
  });
  return els;
});
dt('waterfall', 'Cascata (entrate e uscite)', 'bars', 1500, 760, 'Ricavi: 120\nCosti: -45\nTasse: -15\nExtra: +20', 'Primo valore = punto di partenza; poi aggiunte (+) o sottrazioni (−). Il totale è automatico', (it, W, H, Q) => {
  const rows = it.map(p => ({ t: p.t, v: p.v == null ? 0 : p.v })), els = []; let run = 0; const steps = [];
  rows.forEach((r, i) => { if (i === 0) { steps.push({ t: r.t, a: 0, b: r.v, tot: true, v: r.v }); run = r.v; } else { steps.push({ t: r.t, a: run, b: run + r.v, v: r.v }); run += r.v; } });
  steps.push({ t: 'Totale', a: 0, b: run, tot: true, v: run });
  const all = steps.flatMap(s => [s.a, s.b]), mx = Math.max(...all, 1), mn = Math.min(...all, 0), span = mx - mn || 1, top = H * .12, base = H * .78, sc = (base - top) / span, y0 = base + mn * sc * 0 + (mn < 0 ? mn * sc : 0) * 0;
  const yv = v => base - (v - mn) * sc + (mn < 0 ? 0 : 0) * 0, n = steps.length, sw = W / n, bw = sw * .6, green = '#12B886', red = '#E5484D';
  els.push(DG.sh('rect', 0, yv(0) - 2, W, 4, Q.line));
  steps.forEach((s, i) => {
    const x = sw * i + (sw - bw) / 2, hi = Math.max(s.a, s.b), lo = Math.min(s.a, s.b), c = s.tot ? DG.col(Q, 0) : s.v >= 0 ? green : red;
    els.push(DG.sh('round', x, yv(hi), bw, Math.max(6, (hi - lo) * sc), c, { rad: 10 }));
    if (i < n - 1) els.push(DG.sh('rect', x + bw, yv(s.b) - 1.5, sw - bw, 3, Q.line));
    els.push(DG.tx(Q, (s.tot || s.v < 0 ? '' : '+') + (Math.abs(s.v) >= 1000 ? Math.round(s.v).toLocaleString('it-IT') : String(Math.round(s.v * 100) / 100).replace('.', ',')), x - 20, yv(hi) - H * .1, bw + 40, H * .09, { f: Q.fd, wt: 800, max: 38, c: s.tot ? Q.fg : c }));
    els.push(DG.tx(Q, s.t, x - sw * .15, base + H * .06, bw + sw * .3, H * .13, { f: Q.fd, wt: 600, max: 30, c: Q.fg, top: 1 }));
  });
  return els;
});
['radar', 'gauge', 'waterfall'].forEach(k => { if (!DG.ORDER.includes(k)) DG.ORDER.push(k); });

/* ---------- elenco → diagramma ---------- */
DG.lines = (e) => e.paras.map(p => p.r.map(r => r.t).join('').trim()).filter(Boolean).map(l => l.replace(/^[-•*·▪●]\s*|^\d+[.)]\s+/, '')).map(l => { if (/:/.test(l)) return l; const m = l.match(/^(.{2,40}?)\s+[–—-]\s+(.+)$/) || l.match(/^(.{2,40}?)\s*(?:→|->)\s*(.+)$/); return m ? m[1] + ': ' + m[2] : l; });
DG.guess = (lines) => {
  const n = lines.length, yr = lines.filter(l => /\b(19|20)\d{2}\b/.test(l.split(':')[0])).length, nm = lines.filter(l => /^\s*[+\-]?\d[\d.,]*\s*(%|[kKmM]|€|\$)?\s*:/.test(l) || /:\s*\d+\s*%?\s*$/.test(l)).length;
  if (n >= 3 && yr >= n * .6) return 'timeline'; if (nm >= n * .6) return /:\s*\d{1,3}\s*%?\s*$/.test(lines[0]) ? 'bars' : 'kpi';
  if (lines.some(l => /→|->/.test(l)) || n <= 4 && n >= 3) return 'steps'; if (n <= 5) return 'cards'; if (n <= 6) return 'iconlist'; return 'bars';
};
const modCtx0 = ED.renderCtx;
ED.renderCtx = () => {
  modCtx0(); const els = ED.selEls(), c = $('#ctx'); if (!c || ED.crop || ED.editing || els.length !== 1) return; const e = els[0];
  if (e.t === 'text' && !e.code && e.paras.filter(p => p.r.length && p.r.map(r => r.t).join('').trim()).length >= 2) {
    c.prepend(TB.btn('diagram', 'Trasforma questo elenco in un diagramma', () => { const lines = DG.lines(e); DG.dialog(DG.guess(lines), null, { text: lines.join('\n'), replace: e }); }, false, 'Trasforma in diagramma'));
  } else if (e.t === 'group' && e.dg) {
    c.prepend(TB.btn('list', 'Torna a un elenco di testo', () => {
      const lines = DG.parse(e.dg.text).map(p => p.t + (p.d ? ': ' + p.d : '')); const t = M.text({ text: lines.join('\n'), x: e.x, y: e.y, w: Math.min(e.w, 1100), s: 44, f: TP.get(ED.deck.theme).fb, c: ED.themeTxt().fg, lh: 1.35, ps: .3 }); t.paras.forEach(p => { p.l = 'b'; }); R.fitHeight(t);
      const s = ED.slide(), i = s.els.indexOf(e); s.els.splice(i, 1, t); ED.sel = [t.id]; ED.renderStage(); ED.renderOverlay(); ED.renderCtx(); ED.updateThumb(ED.si); ED.commit();
    }, false, 'Elenco'));
  }
};
const dgPanel0 = ED.panels.diagram;
ED.panels.diagram = () => { const r = dgPanel0(); r[0] = h('p.hint2', 'Scrivi una lista e Palco la trasforma in un diagramma. Hai già un elenco sulla pagina? Selezionalo e premi “Trasforma in diagramma”.'); return r; };

/* ============ Coach: durata del discorso, analisi della storia, domande del pubblico, riassunti e traduzione (con l'IA) ============ */
const COACH = {};
COACH.words = (s) => { let n = 0; EX.flat(s.els).forEach(e => { if (e.hd) return; if (e.t === 'text') n += M.plain(e).split(/\s+/).filter(Boolean).length; else if (e.t === 'table') n += e.rows.flat().join(' ').split(/\s+/).filter(Boolean).length * .5; }); return n; };
COACH.slideSec = (s) => {
  const nw = (s.notes || '').trim().split(/\s+/).filter(Boolean).length;
  if (nw >= 8) return { sec: Math.max(8, nw / 130 * 60), src: 'note' };
  const w = COACH.words(s), q = EX.flat(s.els).some(e => e.t === 'quiz') ? 45 : 0;
  return { sec: Math.max(8, 10 + w / 110 * 60) + q, src: 'stima' };
};
COACH.time = (deck) => { const per = deck.slides.map(COACH.slideSec); return { per, total: per.reduce((a, p) => a + p.sec, 0), fromNotes: per.filter(p => p.src === 'note').length }; };
COACH.fmt = (sec) => { const m = Math.floor(sec / 60), s = Math.round(sec % 60); return m ? `${m} min${s ? ' ' + s + ' s' : ''}` : `${s} s`; };
COACH.cuts = (deck, over) => {
  const t = COACH.time(deck), idx = deck.slides.map((s, i) => ({ i, sec: t.per[i].sec, w: COACH.words(s) })).filter(x => x.i > 0 && x.i < deck.slides.length - 1).sort((a, b) => a.w - b.w);
  let left = over, out = []; for (const x of idx) { if (left <= 0) break; out.push(x.i + 1); left -= x.sec; } return out.sort((a, b) => a - b);
};
COACH.timeSection = () => {
  const D = ED.deck, t = COACH.time(D), target = D.target || 0, over = target ? t.total - target * 60 : 0, mx = Math.max(...t.per.map(p => p.sec), 1);
  const inp = h('input.inp.sm', { type: 'number', min: 1, max: 240, placeholder: 'min', value: target || '', 'aria-label': 'Minuti a disposizione', style: { width: '80px' }, onchange: e => { const v = +e.target.value; D.target = v > 0 ? v : 0; ED.commit(); ED.renderPanel(); } });
  return psec('Tempo del discorso',
    h('div.ctime', h('b', '≈ ' + COACH.fmt(t.total)), h('small', `${t.fromNotes} ${t.fromNotes === 1 ? 'pagina' : 'pagine'} dalle note, ${D.slides.length - t.fromNotes} stimate dal testo`)),
    h('div.cbars', t.per.map((p, i) => h('i', { title: `Pagina ${i + 1}: ${COACH.fmt(p.sec)}`, style: { height: Math.max(8, p.sec / mx * 100) + '%', opacity: p.src === 'note' ? 1 : .55 }, onclick: () => ED.goto(i) }))),
    h('div.row', { style: { alignItems: 'center', gap: '8px' } }, h('label.flab', 'Hai'), inp, h('span.hint2', 'minuti')),
    target ? h('p.hint2', over > 30 ? `Sei ${COACH.fmt(over)} oltre il tempo. Pagine da accorciare o togliere: ${COACH.cuts(D, over).join(', ') || '—'}.` : over < -90 ? `Hai ${COACH.fmt(-over)} di margine: puoi approfondire o lasciare spazio alle domande.` : 'Sei dentro il tempo previsto.') : h('p.hint2', 'Scrivi le note delle pagine per una stima precisa; senza note la stima viene dal testo.'));
};

/* ---------- IA ---------- */
COACH.digest = (deck, max = 14000) => {
  let out = '';
  deck.slides.forEach((s, i) => {
    const texts = EX.flat(s.els).filter(e => e.t === 'text' && !e.hd).sort((a, b) => b.s - a.s), title = texts[0] ? M.plain(texts[0]).split('\n')[0] : '';
    const body = texts.slice(1).map(e => M.plain(e).replace(/\n+/g, ' / ')).join(' | ').slice(0, 420), nt = (s.notes || '').slice(0, 300);
    const extra = EX.flat(s.els).some(e => e.t === 'chart') ? ' [grafico]' : EX.flat(s.els).some(e => e.t === 'quiz') ? ' [quiz]' : '';
    out += `P${i + 1}: ${title}${extra}${body ? ' — ' + body : ''}${nt ? ' — NOTE: ' + nt : ''}\n`;
  });
  return out.slice(0, max);
};
COACH.ask = async (inst) => AI.json(await AI.ask(inst, { json: true, modelTier: 'default' }));
COACH.show = (title, node, foot) => { const m = UI.modal(title, node, { cls: 'wide2 coachbox', foot: foot ? foot(() => m.close()) : null }); return m; };
COACH.busy = async (label, fn) => { toast(label, { icon: 'sparkles', ms: 12000 }); try { return await fn(); } catch (e) { console.warn(e); toast(AI.errMsg(e, 'Non sono riuscito a completare l’analisi: riprova tra poco.'), { type: 'err', ms: 5000 }); return null; } };
COACH.analyze = async () => {
  const D = ED.deck, j = await COACH.busy('Il coach sta leggendo la presentazione…', () => COACH.ask(`Sei un coach di public speaking. Analizza questa presentazione (una riga per pagina) e rispondi SOLO con JSON in italiano:
{"voto":numero 0-100,"sintesi":"2 frasi","punti_di_forza":["max 3"],"da_migliorare":["max 4 consigli concreti con numero di pagina"],"pagine_ripetitive":[numeri],"gergo":["parole difficili da spiegare"],"apertura":"come iniziare meglio","chiusura":"come chiudere meglio"}

${COACH.digest(D)}`));
  if (!j) return; const list = (t, a, c) => a && a.length ? h('div.cch', h('h4', t), h('ul', a.map(x => h('li', String(x))))) : null;
  COACH.show('Il parere del coach', h('div.form', h('div.cscore', h('b', String(Math.round(+j.voto || 0))), h('span', j.sintesi || '')), list('Punti di forza', j.punti_di_forza), list('Da migliorare', j.da_migliorare),
    j.pagine_ripetitive && j.pagine_ripetitive.length ? h('p.hint2', 'Pagine che si ripetono: ' + j.pagine_ripetitive.join(', ')) : null, list('Parole da spiegare al pubblico', j.gergo), j.apertura ? h('div.cch', h('h4', 'Come aprire'), h('p', j.apertura)) : null, j.chiusura ? h('div.cch', h('h4', 'Come chiudere'), h('p', j.chiusura)) : null));
};
COACH.questions = async () => {
  const j = await COACH.busy('Preparo le domande che potrebbero farti…', () => COACH.ask(`Sei un pubblico esigente. Dopo questa presentazione, quali domande difficili ma realistiche faresti? Rispondi SOLO con JSON in italiano: {"domande":[{"d":"domanda","r":"risposta suggerita in 2 frasi"}]} con 6 domande diverse (dati, dubbi, costi, rischi, alternative).

${COACH.digest(ED.deck)}`));
  if (!j || !j.domande) return;
  COACH.show('Domande del pubblico', h('div.form', h('p.hint2', 'Prova a rispondere ad alta voce, poi guarda il suggerimento.'), j.domande.map((q, i) => h('details.cq', h('summary', `${i + 1}. ${q.d}`), h('p', q.r)))));
};
COACH.summary = async () => {
  const j = await COACH.busy('Riassumo la presentazione…', () => COACH.ask(`Riassumi questa presentazione. Rispondi SOLO con JSON in italiano: {"pitch":"discorso di 30 secondi, in prima persona, circa 75 parole","post":"un post social di massimo 280 caratteri","punti":["3 cose da ricordare"]}

${COACH.digest(ED.deck)}`));
  if (!j) return; const row = (t, txt, extra) => h('div.cch', h('h4', t), h('p', txt), h('div.row', h('button.btn.sm', { onclick: () => { navigator.clipboard && navigator.clipboard.writeText(txt).then(() => toast('Copiato', { ms: 1200 })); } }, icn('copy', 14), 'Copia'), extra || null));
  COACH.show('Riassunti pronti', h('div.form', row('Discorso di 30 secondi', j.pitch || '', h('button.btn.sm', { onclick: () => { const s = ED.slide(); s.notes = ((s.notes ? s.notes + '\n\n' : '') + j.pitch).trim(); ED.commit(); ED.renderNotes(); toast('Aggiunto alle note di questa pagina'); } }, icn('note', 14), 'Metti nelle note')), row('Post per i social', j.post || ''), row('Da ricordare', (j.punti || []).map(x => '• ' + x).join('\n'))));
};
COACH.notesAll = async () => {
  const D = ED.deck, miss = D.slides.map((s, i) => ({ s, i })).filter(x => !(x.s.notes || '').trim());
  if (!miss.length) return toast('Tutte le pagine hanno già le note', { ms: 2500 });
  const body = miss.map(x => `P${x.i + 1}: ` + COACH.digest({ slides: [x.s] }).replace(/^P1: /, '')).join('\n').slice(0, 14000);
  const j = await COACH.busy(`Scrivo le note per ${miss.length} pagine…`, () => COACH.ask(`Scrivi le note del relatore in italiano per queste pagine di presentazione: 2 o 3 frasi parlate per pagina, da leggere ad alta voce. Rispondi SOLO con JSON: {"note":{"<numero pagina>":"testo"}}

${body}`));
  if (!j || !j.note) return; let n = 0; Object.entries(j.note).forEach(([k, v]) => { const s = D.slides[+k - 1]; if (s && v && !(s.notes || '').trim()) { s.notes = String(v).trim(); n++; } });
  ED.commit(); ED.renderNotes(); ED.renderPanel(); toast(`Note scritte per ${n} pagine`, { icon: 'check', ms: 3000 });
};
COACH.translate = async () => {
  const langs = [['inglese', 'Inglese'], ['spagnolo', 'Spagnolo'], ['francese', 'Francese'], ['tedesco', 'Tedesco'], ['portoghese', 'Portoghese'], ['italiano', 'Italiano'], ['arabo', 'Arabo'], ['cinese semplificato', 'Cinese'], ['russo', 'Russo']];
  const sel = h('select.inp', { 'aria-label': 'Lingua' }, langs.map(([v, l]) => h('option', { value: v }, l)));
  const m = UI.modal('Traduci la presentazione', h('div.form', h('p.mtext', 'L’IA traduce tutti i testi, le tabelle e le etichette dei grafici e crea una copia nella lingua scelta: l’originale non cambia.'), sel), { cls: 'small', foot: [h('span.grow'), h('button.btn', { onclick: () => m.close() }, 'Annulla'), h('button.btn.primary', { onclick: async () => { const lang = sel.value; m.close(); await COACH.doTranslate(lang); } }, icn('sparkles', 16), 'Traduci')] });
};
COACH.doTranslate = async (lang) => {
  ED.histFlush && ED.histFlush(); ST.saveDeck(ED.deck, true);
  const copy = clone(ED.deck), refs = [];
  copy.slides.forEach(s => EX.flat(s.els).forEach(e => {
    if (e.t === 'text') e.paras.forEach(p => { const t = p.r.map(r => r.t).join(''); if (t.trim()) refs.push({ t, set: v => { p.r = [{ ...(p.r[0] || {}), t: v }]; } }); });
    else if (e.t === 'table') e.rows.forEach((row, ri) => row.forEach((c, ci) => { if (String(c).trim()) refs.push({ t: String(c), set: v => { e.rows[ri][ci] = v; } }); }));
    else if (e.t === 'chart') e.labels.forEach((c, ci) => { if (String(c).trim()) refs.push({ t: String(c), set: v => { e.labels[ci] = v; } }); });
  }));
  if (!refs.length) return toast('Non ci sono testi da tradurre', { ms: 2500 });
  toast(`Traduco ${refs.length} testi in ${lang}…`, { icon: 'sparkles', ms: 20000 });
  try {
    for (let i = 0; i < refs.length; i += 70) {
      const chunk = refs.slice(i, i + 70), j = await COACH.ask(`Traduci in ${lang} queste frasi di una presentazione, mantenendo il tono e senza aggiungere nulla. Rispondi SOLO con JSON: {"t":[...]} con ${chunk.length} elementi nello stesso ordine.\n\n` + JSON.stringify(chunk.map(c => c.t)));
      if (!j.t || j.t.length !== chunk.length) throw new Error('lunghezza');
      chunk.forEach((c, k) => c.set(String(j.t[k])));
    }
  } catch (e) { console.warn(e); return toast(AI.errMsg(e, 'La traduzione non è riuscita: riprova tra poco.'), { type: 'err', ms: 5000 }); }
  copy.id = uid('d_'); copy.name = ED.deck.name + ' (' + lang + ')'; copy.created = Date.now(); copy.trashed = 0; delete copy.tpl;
  copy.slides.forEach(s => EX.flat(s.els).forEach(e => { if (e.t === 'text') R.fitHeight(e); }));
  ST.saveDeck(copy, true); toast('Traduzione pronta: la trovi nei progetti (si apre ora)', { icon: 'check', ms: 3500 }); ED.open(copy);
};
COACH.aiSection = () => {
  const ok = AI.textOk(), b = (ic, l, fn) => h('button.btn.sm.full', { disabled: !ok, onclick: fn }, icn(ic, 16), l);
  return psec('Coach con l’IA', ok ? h('div.coachbtns', b('sparkles', 'Parere sulla presentazione', COACH.analyze), b('info', 'Domande difficili del pubblico', COACH.questions), b('note', 'Riassunto e discorso di 30 secondi', COACH.summary), b('mic', 'Scrivi le note mancanti', COACH.notesAll), b('globe' in ICONS ? 'globe' : 'link', 'Traduci in un’altra lingua', COACH.translate)) : h('p.hint2', 'Con un servizio IA (Impostazioni IA) il coach analizza la storia, prepara le domande del pubblico, scrive note e riassunti e traduce la presentazione.'));
};
ICONS.globe = '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>';
const check0 = ED.panels.check;
ED.panels.check = () => { const r = check0(); return GR.isDesign(ED.deck) ? r : [COACH.timeSection(), ...r, COACH.aiSection()]; };
if (typeof PRC !== 'undefined') { const s2 = PRC.start; PRC.start = (deck, i = 0) => { s2(deck, i); if (PRC.on && deck.target && !PRC.target) { PRC.target = deck.target; PRC.tick && PRC.tick(); } }; }

/* ============ Visivo: sfondi animati, effetto vetro e simulatore di daltonismo ============ */
const LV = {};
LV.STYLES = [['aurora', 'Aurora'], ['onde', 'Onde'], ['stelle', 'Stelle'], ['griglia', 'Griglia retrò'], ['gradiente', 'Gradiente rotante']];
LV.make = (style) => { const th = TP.get(ED.deck.theme); return { live: style, base: th.bg, c: [th.ac, th.ac2, th.ac3, Col.mix(th.ac, th.bg, .45)].map(c => Col.parse(c) || '#5B8CFF') }; };
LV.html = (bg, deck) => {
  if (!bg || !bg.live) return ''; const c = bg.c || [], v = `--c1:${c[0] || '#5B8CFF'};--c2:${c[1] || c[0] || '#FF5DA2'};--c3:${c[2] || c[0] || '#3DDC97'};--c4:${c[3] || c[0] || '#FFB020'}`;
  if (bg.live === 'stelle') { const r = rngOf(7), W = (deck && deck.w) || 1920, H = (deck && deck.h) || 1080, sh = (n, o) => Array.from({ length: n }, () => `${Math.round(r() * W)}px ${Math.round(r() * H)}px 0 ${o}px ${Math.random() < .2 ? 'var(--c1)' : '#fff'}`).join(','); return `<div class="livebg lb-stelle" style="${v}"><i style="box-shadow:${sh(70, 0)}"></i><i class="b" style="box-shadow:${sh(46, 1)}"></i><i class="c" style="box-shadow:${sh(22, 2)}"></i></div>`; }
  const n = { aurora: 4, onde: 3, griglia: 2, gradiente: 1 }[bg.live] || 3;
  return `<div class="livebg lb-${bg.live}" style="${v}">${'<i></i>'.repeat(n)}</div>`;
};
const lvBg0 = R.bgCss; R.bgCss = bg => bg && bg.live ? (bg.base || '#0B1020') : lvBg0(bg);
const lvSi0 = R.slideInner; R.slideInner = (slide, deck, o) => LV.html(slide.bg, deck) + lvSi0(slide, deck, o);
ED.themeTxt = () => { const th = TP.get(ED.deck.theme), b = ED.slide().bg, bg = typeof b === 'string' ? b : b && b.live ? b.base : '#FFFFFF'; return { fg: Col.readable(bg), th }; };
const lvUnder0 = QC.under; QC.under = (slide, idx) => slide.bg && slide.bg.live ? lvUnder0({ ...slide, bg: slide.bg.base }, idx) : lvUnder0(slide, idx);
/* nelle esportazioni lo sfondo è una fotografia dell'animazione */
EX.drawLive = (ctx, deck, bg) => {
  const W = deck.w, H = deck.h, c = bg.c || [], rgba = (hex, a) => { const [r, g, b] = Col.hex2rgb(hex || '#5B8CFF'); return `rgba(${r},${g},${b},${a})`; };
  ctx.fillStyle = bg.base || '#0B1020'; ctx.fillRect(0, 0, W, H);
  const blob = (x, y, r, col, a) => { const g = ctx.createRadialGradient(x, y, 0, x, y, r); g.addColorStop(0, rgba(col, a)); g.addColorStop(1, rgba(col, 0)); ctx.fillStyle = g; ctx.fillRect(x - r, y - r, 2 * r, 2 * r); };
  if (bg.live === 'aurora') { blob(W * .2, H * .2, H * .7, c[0], .85); blob(W * .8, H * .3, H * .8, c[1], .8); blob(W * .5, H * .95, H * .8, c[2], .75); blob(W * .1, H * .85, H * .55, c[3], .7); }
  else if (bg.live === 'onde') { [0, 1, 2].forEach(k => { ctx.fillStyle = rgba(c[k], .38); ctx.beginPath(); ctx.moveTo(0, H); for (let x = 0; x <= W; x += 40) ctx.lineTo(x, H * (.58 + k * .1) + Math.sin(x / W * Math.PI * (2 + k) + k) * H * .06); ctx.lineTo(W, H); ctx.fill(); }); }
  else if (bg.live === 'stelle') { const r = rngOf(7); for (let i = 0; i < 140; i++) { ctx.fillStyle = i % 5 ? '#fff' : (c[0] || '#fff'); ctx.globalAlpha = .4 + r() * .6; ctx.beginPath(); ctx.arc(r() * W, r() * H, 1 + r() * 2.2, 0, 7); ctx.fill(); } ctx.globalAlpha = 1; }
  else if (bg.live === 'griglia') { const g = ctx.createRadialGradient(W / 2, H * .55, 0, W / 2, H * .55, H * .5); g.addColorStop(0, rgba(c[1], .75)); g.addColorStop(1, rgba(c[1], 0)); ctx.fillStyle = g; ctx.fillRect(0, 0, W, H); ctx.strokeStyle = rgba(c[0], .8); ctx.lineWidth = 3; for (let i = 0; i <= 14; i++) { const y = H * .55 + Math.pow(i / 14, 2) * H * .45; ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke(); } for (let i = -12; i <= 12; i++) { ctx.beginPath(); ctx.moveTo(W / 2 + i * 22, H * .55); ctx.lineTo(W / 2 + i * 190, H); ctx.stroke(); } }
  else if (bg.live === 'gradiente' && ctx.createConicGradient) { const g = ctx.createConicGradient(.6, W / 2, H / 2); [c[0], c[1], c[2], c[3], c[0]].forEach((col, i) => g.addColorStop(i / 4, rgba(col, .6))); ctx.fillStyle = g; ctx.fillRect(0, 0, W, H); }
};
const lvDb0 = EX.drawBg; EX.drawBg = (ctx, deck, bg) => bg && bg.live ? EX.drawLive(ctx, deck, bg) : lvDb0(ctx, deck, bg);
const lvBgPanel0 = ED.panels.bg;
ED.panels.bg = () => {
  const r = lvBgPanel0(), cards = LV.STYLES.map(([k, n]) => { const bg = LV.make(k); return h('button.lvc.lv-run', { title: n, onclick: () => ED.setBg(bg, !!ED.lvAll) }, h('div.lvth', R.thumb(GR.slide(bg, []), { w: ED.deck.w, h: ED.deck.h })), h('small', n)); });
  return [...r, psec('Sfondi animati', h('div.lvgrid', cards), h('label.chk', h('input', { type: 'checkbox', onchange: e => { ED.lvAll = e.target.checked; } }), 'Applica a tutte le pagine'), h('p.hint2', 'Si muovono quando presenti; nell’editor e nelle esportazioni restano fermi.'))];
};
ED.panels.bg.__lv = 1;

/* ---------- vetro ---------- */
const lvEl0 = R.elHTML;
R.elHTML = (e, deck, o = {}) => {
  const html = lvEl0(e, deck, o); if (e.t !== 'shape' || !e.gl || e.k === 'line') return html;
  const bf = 'blur(22px) saturate(1.6)', op = e.glo != null ? e.glo : .22;
  return html.replace('style="', `style="backdrop-filter:${bf};-webkit-backdrop-filter:${bf};clip-path:path('${M.pathOf(e)}');`).replace(' fill-rule="evenodd"', ` fill-rule="evenodd" fill-opacity="${op}"` + (e.st ? '' : ' stroke="rgba(255,255,255,.55)" stroke-width="2.5"'));
};
const lvDraw0 = EX.drawEl;
EX.drawEl = (ctx, e) => {
  if (!(e.t === 'shape' && e.gl && e.k !== 'line')) return lvDraw0(ctx, e);
  ctx.save(); ctx.translate(e.x + e.w / 2, e.y + e.h / 2); if (e.r) ctx.rotate(e.r * Math.PI / 180); ctx.translate(-e.w / 2, -e.h / 2);
  const p = new Path2D(M.pathOf(e));
  ctx.save(); ctx.clip(p); const t = ctx.getTransform(); ctx.save(); ctx.setTransform(1, 0, 0, 1, 0, 0); ctx.filter = `blur(${(22 * Math.hypot(t.a, t.b)).toFixed(1)}px) saturate(1.5)`; ctx.drawImage(ctx.canvas, 0, 0); ctx.restore(); ctx.restore();
  ctx.globalAlpha = e.glo != null ? e.glo : .22; ctx.fillStyle = EX.fillStyle(ctx, e.f, e.w, e.h); ctx.fill(p, 'evenodd'); ctx.globalAlpha = 1;
  ctx.strokeStyle = e.st ? e.st.c : 'rgba(255,255,255,.55)'; ctx.lineWidth = e.st ? e.st.w : 2.5; ctx.stroke(p); ctx.restore();
};
const lvCtx0 = ED.renderCtx;
ED.renderCtx = () => {
  lvCtx0(); const els = ED.selEls(), c = $('#ctx'); if (!c || ED.crop || ED.editing || els.length !== 1 || els[0].t !== 'shape' || els[0].k === 'line') return;
  const e = els[0]; c.append(TB.btn('drop', 'Effetto vetro: sfoca e fa trasparire ciò che sta dietro (funziona bene su foto e sfondi colorati)', () => { ED.mut(x => { if (x.gl) delete x.gl; else { x.gl = 1; x.glo = .22; } }, { els: [e] }); }, !!e.gl, 'Vetro'));
};

/* ---------- daltonismo ---------- */
LV.VIS = [['', 'Vista normale'], ['prot', 'Protanopia (rosso debole)'], ['deut', 'Deuteranopia (verde debole)'], ['trit', 'Tritanopia (blu debole)'], ['achr', 'Acromatopsia (solo grigi)'], ['low', 'Vista offuscata']];
LV.mat = { prot: '0.152 1.053 -0.205 0 0  0.115 0.786 0.099 0 0  -0.004 -0.048 1.052 0 0  0 0 0 1 0', deut: '0.367 0.861 -0.228 0 0  0.280 0.673 0.047 0 0  -0.012 0.043 0.969 0 0  0 0 0 1 0', trit: '1.256 -0.077 -0.179 0 0  -0.078 0.931 0.148 0 0  0.005 0.691 0.304 0 0  0 0 0 1 0', achr: '0.213 0.715 0.072 0 0  0.213 0.715 0.072 0 0  0.213 0.715 0.072 0 0  0 0 0 1 0' };
(() => { const s = document.createElementNS('http://www.w3.org/2000/svg', 'svg'); s.setAttribute('width', 0); s.setAttribute('height', 0); s.style.position = 'absolute'; s.innerHTML = Object.entries(LV.mat).map(([k, m]) => `<filter id="vf-${k}" color-interpolation-filters="linearRGB"><feColorMatrix type="matrix" values="${m}"/></filter>`).join(''); document.body.appendChild(s); })();
ED.visionMenu = (anchor) => { const cur = document.documentElement.dataset.vision || ''; UI.menu(anchor, [{ head: 'Simula come vedono gli altri' }, ...LV.VIS.map(([k, l]) => ({ label: l, on: cur === k, onclick: () => { if (k) document.documentElement.dataset.vision = k; else delete document.documentElement.dataset.vision; ED.updVision(); if (k) toast('Solo un’anteprima: i colori delle pagine non cambiano. Controlla che testi e grafici restino distinguibili.', { ms: 4200 }); } }))], { align: 'right' }); };
ED.updVision = () => { const b = $('#b-vision'); if (b) b.classList.toggle('on', !!document.documentElement.dataset.vision); };

/* ============ Collaborazione in tempo reale: il tuo Palco fa da host, gli ospiti si collegano da browser con il ruolo del link ============ */
const CLB = { on: false, host: false, guest: false, role: null, peer: null, conn: null, peers: new Map(), deck: null, sent: new Map(), known: new Set(), ordKey: '', metaKey: '', uiFns: [], nextColor: 1, queue: [], me: null };
CLB.COLORS = ['#F2542D', '#1E6BFF', '#12B886', '#8B5CF6', '#E040A0', '#FFB020', '#0EA5A5', '#C0392B', '#6D4AFF', '#2E7D32'];
CLB.ROLES = [['editor', 'Editor', 'Modifica la presentazione e può commentare'], ['commenter', 'Commentatore', 'Guarda e lascia commenti'], ['viewer', 'Visualizzatore', 'Guarda e presenta, senza modificare']];
CLB.roleName = r => ({ owner: 'Proprietario', editor: 'Editor', commenter: 'Commentatore', viewer: 'Visualizzatore' })[r] || r;
CLB.ICE = [{ urls: 'stun:stun.l.google.com:19302' }, { urls: 'stun:global.stun.twilio.com:3478' }, { urls: 'turn:openrelay.metered.ca:80', username: 'openrelayproject', credential: 'openrelayproject' }, { urls: 'turn:openrelay.metered.ca:443', username: 'openrelayproject', credential: 'openrelayproject' }, { urls: 'turn:openrelay.metered.ca:443?transport=tcp', username: 'openrelayproject', credential: 'openrelayproject' }];
CLB.available = () => SH.hosted();
CLB.rid = (n) => { const a = 'abcdefghjkmnpqrstuvwxyz23456789', u = crypto.getRandomValues(new Uint8Array(n)); return [...u].map(x => a[x % a.length]).join(''); };
CLB.load = async () => { if (window.Peer) return; await EX.loadScript('https://cdn.jsdelivr.net/npm/peerjs@1.5.4/dist/peerjs.min.js'); if (!window.Peer) throw new Error('peerjs'); };
CLB.name = () => { try { return localStorage.getItem('palco.name') || ''; } catch (e) { return ''; } };
CLB.setName = n => { try { localStorage.setItem('palco.name', n); } catch (e) { } };
CLB.onUi = f => { CLB.uiFns.push(f); return () => { CLB.uiFns = CLB.uiFns.filter(x => x !== f); }; };
CLB.notify = () => CLB.uiFns.slice().forEach(f => { try { f(); } catch (e) { console.warn(e); } });
CLB.link = (role) => { const c = CLB.deck && CLB.deck.collab; return c ? location.origin + location.pathname + '#j=' + c.pid + '.' + c.tokens[role] : ''; };
CLB.roleOf = (tk) => { const t = CLB.deck && CLB.deck.collab && CLB.deck.collab.tokens; return t ? Object.keys(t).find(r => t[r] === tk) || null : null; };
CLB.canEdit = () => CLB.on && (CLB.host || CLB.role === 'editor');
CLB.canComment = () => CLB.host || CLB.role === 'editor' || CLB.role === 'commenter';
CLB.metaOf = d => ({ name: d.name, w: d.w, h: d.h, theme: d.theme, themeDef: d.themeDef || null, pn: d.pn || null, fly: d.fly || null, target: d.target || 0 });
CLB.refsOf = (x) => { const s = typeof x === 'string' ? x : JSON.stringify(x), out = new Set(), re = /"((?:d|m):[A-Za-z0-9]+)"/g; let m; while ((m = re.exec(s))) out.add(m[1]); return [...out]; };
CLB.seed = (deck) => { CLB.sent = new Map(deck.slides.map(s => [s.id, JSON.stringify(s)])); CLB.ordKey = deck.slides.map(s => s.id).join(','); CLB.metaKey = JSON.stringify(CLB.metaOf(deck)); CLB.known = new Set(CLB.refsOf(deck.slides)); };
CLB.snapshot = () => { const d = clone(CLB.deck); delete d.collab; delete d.runs; delete d.trashed; delete d.tpl; delete d.fav; delete d.folder; d.collabGuest = true; return d; };
CLB.peerList = () => [{ id: 'host', name: CLB.host ? CLB.me.name : (CLB.hostInfo ? CLB.hostInfo.name : 'Proprietario'), role: 'owner', color: CLB.host ? CLB.me.color : (CLB.hostInfo ? CLB.hostInfo.color : CLB.COLORS[0]), slide: CLB.host ? CLB.mySlide() : (CLB.peers.get('host') || {}).slide, sel: CLB.host ? CLB.mySel() : (CLB.peers.get('host') || {}).sel }, ...(CLB.host ? [...CLB.peers.values()].map(p => ({ id: p.id, name: p.name, role: p.role, color: p.color, slide: p.slide, sel: p.sel })) : [])];
CLB.mySlide = () => (typeof ED !== 'undefined' && ED.active && ED.deck === CLB.deck && ED.slide()) ? ED.slide().id : null;
CLB.mySel = () => (typeof ED !== 'undefined' && ED.active && ED.deck === CLB.deck) ? ED.sel.slice(0, 8) : [];
CLB.everyone = () => CLB.host ? CLB.peerList() : [...CLB.peers.values()];

/* ---------- invio ---------- */
CLB.broadcast = (m, except) => { CLB.peers.forEach((p, id) => { if (id !== except && p.conn && p.conn.open) { try { p.conn.send(m); } catch (e) { } } }); };
CLB.out = (m) => { if (CLB.host) CLB.broadcast(m); else if (CLB.conn && CLB.conn.open) { try { CLB.conn.send(m); } catch (e) { } } };
CLB.sendImages = async (conn, refs) => { for (const ref of refs) { try { const data = Img.cache.get(ref) || await ST.loadImage(ref); if (data && data.length < 3.2e6) { conn.send({ t: 'img', ref, data }); await sleep(25); } } catch (e) { } } };
CLB.takeImage = async (ref, data) => { if (!/^(d|m):/.test(ref) || typeof data !== 'string' || !/^data:image\//.test(data)) return; Img.cache.set(ref, data); CLB.known.add(ref); try { await ST.saveImage(ref, data); } catch (e) { } window.dispatchEvent(new Event('palco-img')); };

/* ---------- host ---------- */
CLB.startHost = async (deck) => {
  if (CLB.on) return true; await CLB.load();
  if (!deck.collab) deck.collab = { pid: 'palco-' + CLB.rid(12), tokens: { editor: CLB.rid(16), commenter: CLB.rid(16), viewer: CLB.rid(16) } };
  return new Promise((res, rej) => {
    const peer = new Peer(deck.collab.pid, { debug: 0, config: { iceServers: CLB.ICE } }); let opened = false;
    peer.on('open', () => { opened = true; CLB.on = true; CLB.host = true; CLB.guest = false; CLB.role = 'owner'; CLB.peer = peer; CLB.deck = deck; CLB.me = { id: 'host', name: CLB.name() || 'Proprietario', color: CLB.COLORS[0] }; CLB.peers = new Map(); CLB.nextColor = 1; CLB.seed(deck); ST.saveDeck(deck, true); CLB.notify(); res(true); });
    peer.on('connection', c => CLB.hostConn(c));
    peer.on('disconnected', () => { try { peer.reconnect(); } catch (e) { } });
    peer.on('error', e => { if (!opened) { if (e.type === 'unavailable-id') { deck.collab.pid = 'palco-' + CLB.rid(12); try { peer.destroy(); } catch (x) { } CLB.startHost(deck).then(res, rej); } else { try { peer.destroy(); } catch (x) { } rej(e); } } else console.warn('peer', e.type); });
  });
};
CLB.hostConn = (c) => {
  let info = null;
  c.on('data', async m => {
    if (!info) {
      if (!m || m.t !== 'hello') return c.close();
      const role = CLB.roleOf(m.tk); if (!role) { c.send({ t: 'deny', why: 'Questo link non è più valido: chiedi al proprietario di mandartene uno nuovo.' }); setTimeout(() => c.close(), 400); return; }
      info = { id: c.peer, conn: c, name: String(m.name || 'Ospite').slice(0, 30), role, color: CLB.COLORS[CLB.nextColor++ % CLB.COLORS.length], slide: null, sel: [] };
      CLB.peers.set(c.peer, info); await CLB.welcome(info); CLB.broadcastPeers(); CLB.notify(); return;
    }
    CLB.hostRecv(info, m);
  });
  c.on('close', () => { if (info && CLB.peers.get(info.id) === info) { CLB.peers.delete(info.id); CLB.broadcastPeers(); CLB.notify(); } });
  c.on('error', () => { });
};
CLB.welcome = async (info) => {
  info.conn.send({ t: 'welcome', role: info.role, you: { id: info.id, name: info.name, color: info.color }, deck: CLB.snapshot(), peers: CLB.peerList() });
  await CLB.sendImages(info.conn, CLB.refsOf(CLB.deck.slides));
};
CLB.broadcastPeers = () => CLB.broadcast({ t: 'peers', list: CLB.peerList() });
CLB.setRole = (id, role) => { const p = CLB.peers.get(id); if (!p) return; p.role = role; try { p.conn.send({ t: 'role', role }); } catch (e) { } CLB.broadcastPeers(); CLB.notify(); };
CLB.kick = (id) => { const p = CLB.peers.get(id); if (!p) return; try { p.conn.send({ t: 'kicked' }); } catch (e) { } setTimeout(() => { try { p.conn.close(); } catch (e) { } }, 300); CLB.peers.delete(id); CLB.broadcastPeers(); CLB.notify(); };
CLB.rotate = () => { const c = CLB.deck.collab; c.tokens = { editor: CLB.rid(16), commenter: CLB.rid(16), viewer: CLB.rid(16) }; [...CLB.peers.keys()].forEach(CLB.kick); ST.saveDeck(CLB.deck, true); CLB.notify(); };
CLB.stop = () => {
  if (!CLB.on) return; const wasHost = CLB.host;
  if (wasHost) CLB.broadcast({ t: 'bye' }); try { CLB.peer && CLB.peer.destroy(); } catch (e) { }
  CLB.on = false; CLB.host = false; CLB.guest = false; CLB.peer = null; CLB.conn = null; CLB.peers = new Map(); CLB.queue = []; CLB.role = null; CLB.lost = false; clearTimeout(CLB._rt); CLB.notify();
};
CLB.hostRecv = (info, m) => {
  if (!m || !m.t) return; const canEdit = info.role === 'editor', canComment = info.role !== 'viewer';
  if (['slide', 'order', 'meta', 'img'].includes(m.t)) { if (!canEdit) return; if (m.t === 'img') CLB.takeImage(m.ref, m.data); else CLB.apply(m); CLB.broadcast(m, info.id); return; }
  if (m.t === 'at') { info.slide = m.slide || null; info.sel = Array.isArray(m.sel) ? m.sel.slice(0, 8) : []; CLB.broadcast({ t: 'pres', id: info.id, slide: info.slide, sel: info.sel }, info.id); CLB.notify(); CLB.presChanged(); return; }
  if (m.t && m.t.startsWith('cmt')) { if (!canComment) return; const msg = CLB.cmtSanitize(m, info); if (!msg) return; CLB.cmtApply(msg); CLB.broadcast(msg, info.id); }
};

/* ---------- ospite ---------- */
CLB.join = (hostId, tk, name) => new Promise(async (res, rej) => {
  try { await CLB.load(); } catch (e) { return rej({ why: 'Non riesco a caricare il modulo di collegamento: serve internet.' }); }
  const old = CLB.peer; if (old) { try { old.destroy(); } catch (e) { } }
  const peer = new Peer(undefined, { debug: 0, config: { iceServers: CLB.ICE } }); CLB.peer = peer; let done = false;
  const fail = (why) => { if (!done) { done = true; clearTimeout(timer); try { peer.destroy(); } catch (e) { } rej({ why }); } };
  const timer = setTimeout(() => fail('Il proprietario non risponde: deve avere Palco aperto e la collaborazione avviata.'), 22000);
  peer.on('error', e => { if (!done) fail(e.type === 'peer-unavailable' ? 'La sessione non è attiva: chiedi al proprietario di aprire Palco e avviare la collaborazione.' : 'Collegamento non riuscito (' + e.type + ').'); });
  peer.on('open', () => {
    const c = peer.connect(hostId, { reliable: true }); CLB.conn = c;
    c.on('open', () => c.send({ t: 'hello', tk, name }));
    c.on('data', m => { if (!done && m && m.t === 'welcome') { done = true; clearTimeout(timer); CLB.afterWelcome(m, hostId, tk, name); res(m); } else if (!done && m && m.t === 'deny') fail(m.why); else CLB.guestRecv(m); });
    c.on('close', () => { if (!done) fail('Collegamento chiuso.'); else CLB.hostLost(); });
    c.on('error', () => { if (!done) fail('Collegamento interrotto.'); });
  });
});
CLB.afterWelcome = (m, hostId, tk, name) => {
  const again = !!CLB.deck && CLB.guest;
  CLB.on = true; CLB.guest = true; CLB.host = false; CLB.role = m.role; CLB.me = m.you; CLB.lost = false; CLB.joinArgs = [hostId, tk, name];
  CLB.peers = new Map(m.peers.map(p => [p.id, p])); CLB.hostInfo = m.peers.find(p => p.id === 'host') || null;
  if (again && CLB.deck) { Object.assign(CLB.deck, m.deck); CLB.deck.collabGuest = true; } else CLB.deck = m.deck;
  CLB.seed(CLB.deck); CLB.notify(); if (again) CLB.changed({ meta: true });
};
CLB.guestRecv = (m) => {
  if (!m || !m.t) return;
  if (m.t === 'img') CLB.takeImage(m.ref, m.data);
  else if (['slide', 'order', 'meta'].includes(m.t)) CLB.apply(m);
  else if (m.t === 'peers') { CLB.peers = new Map(m.list.map(p => [p.id, p])); CLB.hostInfo = m.list.find(p => p.id === 'host') || CLB.hostInfo; CLB.notify(); CLB.presChanged(); }
  else if (m.t === 'pres') { const p = CLB.peers.get(m.id); if (p) { p.slide = m.slide; p.sel = m.sel; CLB.notify(); CLB.presChanged(); } }
  else if (m.t === 'role') { const prev = CLB.role; CLB.role = m.role; toast('Il proprietario ti ha reso ' + CLB.roleName(m.role), { icon: 'user' in ICONS ? 'user' : 'info', ms: 4000 }); CLB.notify(); if (CLB.onRole) CLB.onRole(prev, m.role); }
  else if (m.t === 'kicked') { toast('Il proprietario ti ha rimosso dalla sessione.', { type: 'err', ms: 5000 }); CLB.leaveToHome(); }
  else if (m.t === 'bye') { CLB.hostLost(true); }
  else if (m.t.startsWith('cmt')) CLB.cmtApply(m);
};
CLB.hostLost = (clean) => {
  if (!CLB.guest || !CLB.on) return; CLB.lost = true; CLB.notify();
  const [hid, tk, name] = CLB.joinArgs || []; clearTimeout(CLB._rt);
  const retry = async () => { if (!CLB.guest || !CLB.lost) return; try { await CLB.join(hid, tk, name); } catch (e) { CLB._rt = setTimeout(retry, 6000); } };
  CLB._rt = setTimeout(retry, 4000);
};
CLB.leave = (silent) => { if (!CLB.guest) return; clearTimeout(CLB._rt); try { CLB.peer && CLB.peer.destroy(); } catch (e) { } CLB.on = false; CLB.guest = false; CLB.conn = null; CLB.peer = null; CLB.deck = null; CLB.peers = new Map(); CLB.lost = false; CLB.role = null; if (!silent) CLB.notify(); };
CLB.leaveToHome = () => { const wasEd = typeof ED !== 'undefined' && ED.active; CLB.viewerRoot = false; CLB.leave(); if (wasEd) { ED.active = false; } history.replaceState(null, '', location.pathname); App.render(); };

/* ---------- modifiche che arrivano ---------- */
CLB.si = () => (typeof ED !== 'undefined' && ED.active && ED.deck === CLB.deck) ? ED.si : 0;
CLB.apply = (m) => {
  const D = CLB.deck; if (!D) return;
  if (m.t === 'slide') {
    let s; try { s = JSON.parse(m.json); } catch (e) { return; } if (!s || !s.id) return;
    const i = D.slides.findIndex(x => x.id === s.id);
    if (i >= 0 && JSON.stringify(D.slides[i]) !== CLB.sent.get(s.id)) return; // ci sono modifiche locali non ancora inviate: vincono
    if (typeof ED !== 'undefined' && ED.editing && ED.active && ED.deck === D && (ED.slide() || {}).id === s.id) { CLB.queue.push(m); clearTimeout(CLB._qt); CLB._qt = setTimeout(CLB.flush, 700); return; }
    if (i >= 0) D.slides[i] = s; else D.slides.push(s);
    CLB.sent.set(s.id, m.json); CLB.changed({ slide: s.id, added: i < 0 });
  } else if (m.t === 'order') {
    const map = new Map(D.slides.map(s => [s.id, s])), list = m.ids.map(id => map.get(id)).filter(Boolean); if (!list.length) return;
    const curId = (D.slides[CLB.si()] || {}).id; D.slides = list; CLB.ordKey = list.map(s => s.id).join(',');
    if (typeof ED !== 'undefined' && ED.active && ED.deck === D) ED.si = Math.max(0, list.findIndex(s => s.id === curId));
    CLB.changed({ order: true });
  } else if (m.t === 'meta') { Object.assign(D, m.m); CLB.metaKey = JSON.stringify(CLB.metaOf(D)); CLB.changed({ meta: true }); }
};
CLB.flush = () => { if (typeof ED !== 'undefined' && ED.editing) { CLB._qt = setTimeout(CLB.flush, 600); return; } const q = CLB.queue; CLB.queue = []; q.forEach(CLB.apply); };
CLB.changed = (o) => {
  if (CLB.host) { clearTimeout(CLB._st); CLB._st = setTimeout(() => ST.saveDeck(CLB.deck), 800); }
  if (typeof ED !== 'undefined' && ED.active && ED.deck === CLB.deck) CLB.refreshEditor(o);
  if (CLB.viewerRoot && CLB.viewerRedraw) CLB.viewerRedraw();
  CLB.notify();
};
CLB.refreshEditor = (o) => {
  const D = ED.deck; ED.sel = ED.sel.filter(id => D.slides[ED.si] && D.slides[ED.si].els.some(e => e.id === id));
  if (o.meta || o.order) { ED.si = clamp(ED.si, 0, D.slides.length - 1); ED.renderAll(); ED.applyZoom && ED.applyZoom(); return; }
  const i = D.slides.findIndex(s => s.id === o.slide); if (i < 0) return;
  if ($$('#strip .pg').length !== D.slides.length) ED.renderStrip(); else ED.updateThumb(i);
  if (i === ED.si) { ED.renderStage(); ED.renderOverlay(); ED.renderCtx(); ED.renderNotes && ED.renderNotes(); }
  if (ED.panel === 'layers') ED.renderPanel();
};

/* ---------- le mie modifiche partono ---------- */
CLB.schedule = debounce(() => CLB.push(), 280);
CLB.push = async () => {
  if (!CLB.on || !CLB.canEdit() || typeof ED === 'undefined' || ED.deck !== CLB.deck) return;
  const D = CLB.deck, ops = [];
  D.slides.forEach(s => { const json = JSON.stringify(s); if (CLB.sent.get(s.id) !== json) { ops.push({ t: 'slide', id: s.id, json }); CLB.sent.set(s.id, json); } });
  const ids = D.slides.map(s => s.id).join(','); if (ids !== CLB.ordKey) { ops.push({ t: 'order', ids: D.slides.map(s => s.id) }); CLB.ordKey = ids; }
  const meta = CLB.metaOf(D), mk = JSON.stringify(meta); if (mk !== CLB.metaKey) { ops.push({ t: 'meta', m: meta }); CLB.metaKey = mk; }
  if (!ops.length) return;
  const need = new Set(); ops.forEach(o => { if (o.t === 'slide') CLB.refsOf(o.json).forEach(r => { if (!CLB.known.has(r)) need.add(r); }); if (o.t === 'meta' && o.m.themeDef) { /* nessuna immagine */ } });
  for (const ref of need) { try { const data = Img.cache.get(ref) || await ST.loadImage(ref); if (data && data.length < 3.2e6) CLB.out({ t: 'img', ref, data }); } catch (e) { } CLB.known.add(ref); }
  ops.forEach(o => CLB.out(o));
};
CLB.pres = debounce(() => { if (!CLB.on) return; const slide = CLB.mySlide(), sel = CLB.mySel(); if (CLB.host) CLB.broadcast({ t: 'pres', id: 'host', slide, sel }); else CLB.out({ t: 'at', slide, sel }); }, 160);
CLB.presChanged = () => { if (typeof ED !== 'undefined' && ED.active && ED.deck === CLB.deck) { ED.renderOverlay && ED.renderOverlay(); const st = $('#strip'); st && CLB.markStrip && CLB.markStrip(); } };

/* ---------- commenti: validazione e applicazione ---------- */
CLB.cmtSanitize = (m, info) => {
  const t = (s, n = 800) => String(s || '').slice(0, n);
  if (m.t === 'cmt' && m.c && m.c.id) return { t: 'cmt', c: { id: t(m.c.id, 40), slide: t(m.c.slide, 40), x: typeof m.c.x === 'number' ? m.c.x : null, y: typeof m.c.y === 'number' ? m.c.y : null, el: m.c.el ? t(m.c.el, 40) : null, text: t(m.c.text), by: info.name, col: info.color, uid: info.id, ts: Date.now(), res: 0, rep: [] } };
  if (m.t === 'cmt-rep' && m.id) return { t: 'cmt-rep', id: t(m.id, 40), r: { id: t(m.r && m.r.id, 40) || uid('r_'), by: info.name, col: info.color, uid: info.id, text: t(m.r && m.r.text), ts: Date.now() } };
  if (m.t === 'cmt-res' && m.id) { const c = CLB.cmtFind(m.id); if (c && (info.role === 'editor' || c.uid === info.id)) return { t: 'cmt-res', id: m.id, v: m.v ? 1 : 0 }; return null; }
  if (m.t === 'cmt-del' && m.id) { const c = CLB.cmtFind(m.id); if (c && (info.role === 'editor' || c.uid === info.id)) return { t: 'cmt-del', id: m.id }; return null; }
  return null;
};
CLB.cmtList = (deck) => (deck || CLB.deck || {}).comments || [];
CLB.cmtFind = (id) => CLB.cmtList().find(c => c.id === id);
CLB.cmtApply = (m, deck) => {
  const D = deck || CLB.deck; if (!D) return; const L = D.comments = D.comments || [];
  if (m.t === 'cmt') { if (!L.some(c => c.id === m.c.id)) L.push(m.c); }
  else if (m.t === 'cmt-rep') { const c = L.find(x => x.id === m.id); if (c && !(c.rep || []).some(r => r.id === m.r.id)) (c.rep = c.rep || []).push(m.r); }
