  if (App.sort === 'name') list = list.slice().sort((a, b) => a.name.localeCompare(b.name));
  const sortBtn = h('button.btn.ghost', { onclick: e => UI.menu(e.currentTarget, [{ label: 'Più recenti', on: App.sort === 'recent', onclick: () => { App.sort = 'recent'; App.render(); } }, { label: 'Nome (A–Z)', on: App.sort === 'name', onclick: () => { App.sort = 'name'; App.render(); } }], { align: 'right' }) }, icn('sliders', 18), 'Ordina');
  const kinds = h('div.chips', [['all', 'Tutti'], ['pres', 'Presentazioni'], ['design', 'Grafica']].map(([k, l]) => h('button.chip' + ((App.kind || 'all') === k ? '.on' : ''), { onclick: () => { App.kind = k; App.render(); } }, l)));
  return h('div.page', h('div.sechd.big', h('h1', 'Progetti'), h('div.row', sortBtn, h('button.btn.primary', { onclick: () => App.newBlank() }, icn('plus', 18), 'Nuova'))), kinds,
    list.length ? h('div.grid', list.map(d => App.deckCard(d))) : App.empty('folder', App.q ? 'Nessun risultato' : 'Nessun progetto', App.q ? 'Prova con un altro nome.' : 'Le tue presentazioni compariranno qui.'));
};
App.vTemplates = () => {
  const ths = App.filterThemes();
  return h('div.page', h('div.sechd.big', h('h1', 'Modelli')), App.chips(), ths.length ? h('div.grid', ths.map(App.tplCard)) : App.empty('search', 'Nessun modello trovato', 'Prova con un’altra parola o categoria.'));
};
App.vTrash = () => {
  const list = ST.list(true);
  return h('div.page', h('div.sechd.big', h('h1', 'Cestino'), list.length ? h('button.btn.ghost', { onclick: () => UI.confirm('Svuotare il cestino?', 'Tutte le presentazioni nel cestino verranno eliminate per sempre.', 'Svuota', () => { list.forEach(d => ST.deleteDeck(d.id)); App.render(); }) }, 'Svuota il cestino') : null),
    list.length ? h('div.grid', list.map(d => App.deckCard(d))) : App.empty('trash', 'Il cestino è vuoto', 'Le presentazioni eliminate restano qui finché non le cancelli per sempre.'));
};
App.vBrand = () => {
  const b = ST.brand, save = () => { ST.saveBrand(); };
  const colors = h('div.bcolors', b.colors.map((c, i) => {
    const btn = h('button.bsw', { style: { background: c }, 'aria-label': 'Colore ' + (i + 1), title: c, onclick: () => UI.colorPop(btn, c, v => { if (typeof v === 'string') { b.colors[i] = v; btn.style.background = v; save(); } }) }, h('span', c));
    return btn;
  }));
  const fontBtn = (label, key) => { const btn = h('button.fontbtn', { style: { fontFamily: fontStack(b[key]) }, onclick: () => UI.fontPop(btn, b[key], f => { b[key] = f; btn.style.fontFamily = fontStack(f); btn.firstChild.textContent = f; save(); loadFont(f, 700); UI.closePops(); }) }, h('b', b[key]), h('small', label)); return btn; };
  const logo = h('div.logobox');
  const drawLogo = () => { logo.innerHTML = ''; if (b.logo) logo.appendChild(h('img', { src: Img.url(b.logo), alt: 'Logo' })); else logo.appendChild(h('span', 'Nessun logo')); };
  drawLogo(); window.addEventListener('palco-img', drawLogo, { once: true });
  return h('div.page', h('div.sechd.big', h('h1', 'Kit del marchio')), h('p.lead', 'Colori, font e logo sono sempre a portata di mano quando modifichi una presentazione.'),
    h('div.bgrid',
      h('section.panelc', h('h3', 'Colori'), colors),
      h('section.panelc', h('h3', 'Font'), fontBtn('Titoli', 'head'), fontBtn('Testo', 'body')),
      h('section.panelc', h('h3', 'Logo'), logo, h('div.row', h('button.btn', { onclick: () => UI.pickFile('image/*', false, async fs => { try { b.logo = await Img.addFile(fs[0]); save(); drawLogo(); } catch (e) { toast('Immagine non valida', { type: 'err' }); } }) }, icn('upload', 18), 'Carica logo'), b.logo ? h('button.btn.ghost', { onclick: () => { b.logo = null; save(); drawLogo(); } }, 'Rimuovi') : null))));
};

App.render = () => {
  const root = $('#app'); if (!root) return;
  const main = h('main.main', { id: 'main' });
  const views = { home: App.vHome, projects: App.vProjects, templates: App.vTemplates, graphics: App.vGraphics, brand: App.vBrand, trash: App.vTrash };
  main.appendChild((views[App.view] || App.vHome)());
  const search = h('input', { type: 'search', placeholder: 'Cerca progetti e modelli', value: App.q, 'aria-label': 'Cerca', oninput: e => { App.q = e.target.value; clearTimeout(App._st); App._st = setTimeout(() => { const f = App.view; if (f === 'brand' || f === 'trash') App.view = 'home'; const pos = e.target.selectionStart; App.render(); const n = $('.topsearch input'); n && (n.focus(), n.setSelectionRange(pos, pos)); }, 250); } });
  const top = h('header.top', h('div.topsearch', icn('search', 18), search), h('div.grow'),
    h('button.ibtn', { title: 'Tema chiaro o scuro', 'aria-label': 'Cambia tema', onclick: () => App.toggleTheme() }, icn(App.theme() === 'dark' ? 'sun' : 'moon', 22)),
    h('button.ibtn', { title: 'Scorciatoie da tastiera', 'aria-label': 'Scorciatoie da tastiera', onclick: UI.shortcuts }, icn('keyboard', 22)),
    h('span.sync', { title: ST.cloud ? 'Salvato nel tuo spazio Claude' : 'Salvato in questo browser' }, icn(ST.cloud ? 'cloud' : 'info', 16), ST.cloud ? 'Sincronizzato' : 'Solo su questo browser'));
  const side = h('nav.side', { 'aria-label': 'Navigazione' },
    h('div.logo', h('span.lmark', { html: '<svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true"><rect width="32" height="32" rx="9" fill="#FFD25A"/><path d="M8 24V8h9a5 5 0 0 1 0 10h-4" fill="none" stroke="#2A2310" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/></svg>' }), h('span.lname', 'Palco')),
    h('button.btn.primary.crea', { onclick: e => UI.menu(e.currentTarget, [{ label: 'Presentazione 16:9', icon: 'presentation', onclick: () => App.newBlank('16:9') }, { label: 'Presentazione 4:3', icon: 'layout', onclick: () => App.newBlank('4:3') }, { label: 'Da una scaletta', icon: 'list', onclick: () => App.outlineDialog() }, { label: 'Crea con l’IA', icon: 'sparkles', onclick: () => App.aiDialog() }, { sep: 1 }, { head: 'Grafica' }, { label: 'Logo', icon: 'star', onclick: () => LOGO.dialog() }, { label: 'Post, locandina, biglietto…', icon: 'shapes', onclick: () => App.go('graphics') }, { label: 'Modifica una foto', icon: 'image', onclick: () => UI.pickFile('image/*', true, fs => GR.openImages(fs)) }, { sep: 1 }, { label: 'Carica un file (immagine, PDF, PowerPoint)', icon: 'upload', onclick: () => App.pickImport() }]) }, icn('plus', 20), h('span', 'Crea')),
    h('ul', App.nav.map(([v, l, i]) => h('li', h('button.nv' + (App.view === v ? '.on' : ''), { onclick: () => App.go(v), 'aria-current': App.view === v ? 'page' : null }, icn(i, 22), h('span', l), v === 'trash' && ST.list(true).length ? h('i.cnt', ST.list(true).length) : null)))));
  root.className = 'home';
  root.ondragover = e => { if (e.dataTransfer && [...e.dataTransfer.types].includes('Files')) e.preventDefault(); };
  root.ondrop = e => { const fs = e.dataTransfer && e.dataTransfer.files; if (fs && fs.length) { e.preventDefault(); App.importFiles(fs); } };
  root.replaceChildren(side, h('div.col', top, main));
};

/* ---- scaletta ---- */
App.themePicker = (state) => {
  const wrap = h('div.tpick');
  const draw = () => { wrap.innerHTML = ''; TP.themes.filter(t => !t.hidden).forEach(t => wrap.appendChild(h('button.tp' + (state.theme === t.id ? '.on' : ''), { onclick: () => { state.theme = t.id; draw(); }, title: t.name }, h('span.tpc', { style: { background: t.bg, borderColor: t.ac } }, h('i', { style: { background: t.ac } }), h('i', { style: { background: t.ac2 } })), h('span', t.name)))); };
  draw(); return wrap;
};
App.parseOutline = (txt) => {
  const lines = txt.split('\n').map(l => l.replace(/\s+$/, '')).filter(l => l.trim());
  if (!lines.length) return null;
  const ol = { title: lines.shift().replace(/^#+\s*/, ''), slides: [] };
  let cur = null;
  lines.forEach(l => {
    const t = l.trim();
    if (/^#{1,3}\s/.test(t) || !/^([-*•]|\d+[.)])\s/.test(t) && !/^\s/.test(l)) { cur = { title: t.replace(/^#+\s*/, ''), bullets: [] }; ol.slides.push(cur); }
    else if (cur) cur.bullets.push(t.replace(/^([-*•]|\d+[.)])\s*/, ''));
  });
  ol.slides.forEach(s => { if (!s.bullets.length) s.kind = 'section'; });
  return ol;
};
App.outlineDialog = (text = '') => {
  const st = { theme: 'tramonto', ratio: '16:9' };
  const ta = h('textarea.inp.area', { rows: 11, placeholder: 'Titolo della presentazione\n\n# Il problema\n- Perché è importante\n- Chi ne è colpito\n\n# La soluzione\n- Come funziona\n- Cosa ci distingue', 'aria-label': 'Scaletta' }, text);
  const rs = h('div'); const dr = () => { rs.innerHTML = ''; rs.appendChild(UI.seg([['16:9', '16:9'], ['4:3', '4:3']], st.ratio, v => { st.ratio = v; dr(); })); }; dr();
  const m = UI.modal('Crea da una scaletta', h('div.form', h('p.mtext', 'Scrivi il titolo sulla prima riga. Ogni riga che inizia con # diventa una pagina e i trattini diventano i punti elenco.'), ta, h('label.flab', 'Stile'), App.themePicker(st)),
    { cls: 'wide', foot: [rs, h('span.grow'), h('button.btn', { onclick: () => m.close() }, 'Annulla'), h('button.btn.primary', {
      onclick: async () => {
        const ol = App.parseOutline(ta.value); if (!ol) return toast('Scrivi almeno il titolo');
        const th = TP.get(st.theme), [w, hh] = M.SIZES[st.ratio];
        await loadFonts([[th.fd, th.wd], [th.fb, 400], [th.fb, 700]]);
        m.close(); App.create(TP.fromOutline(st.theme, ol, { w, h: hh }));
      }
    }, 'Crea presentazione')] });
  setTimeout(() => ta.focus(), 80);
};

/* ---- IA ---- */
App.aiDialog = (prompt = '') => {
  const st = { theme: 'pastello', n: 8 };
  const ta = h('textarea.inp.area', { rows: 5, placeholder: 'Es. Una presentazione di 8 pagine per spiegare ai genitori come funziona il nuovo orario scolastico', 'aria-label': 'Descrizione' }, prompt);
  const nsel = h('select.inp.sm', { 'aria-label': 'Numero di pagine' }, [5, 8, 10, 12].map(n => h('option', { value: n, selected: n === 8 }, n + ' pagine')));
  const status = h('div.aistatus');
  const go = h('button.btn.primary', {
    onclick: async () => {
      const desc = ta.value.trim(); if (!desc) return toast('Descrivi di cosa vuoi parlare');
      go.disabled = true; status.textContent = 'Claude sta scrivendo la scaletta…';
      try {
        const ol = await App.askOutline(desc, +nsel.value);
        const th = TP.get(st.theme); await loadFonts([[th.fd, th.wd], [th.fb, 400], [th.fb, 700]]);
        m.close(); App.create(TP.fromOutline(st.theme, ol));
      } catch (e) {
        console.warn(e); go.disabled = false;
        status.textContent = e && e.code === 'not_granted' ? 'Non hai concesso l’accesso a Claude per questa pagina.' : e && e.code === 'rate_limited' ? 'Troppe richieste, riprova tra poco.' : 'Non sono riuscito a creare la scaletta. Riprova o usa “Da una scaletta”.';
      }
    }
  }, icn('sparkles', 18), 'Crea');
  const m = UI.modal('Crea con l’IA', h('div.form', ta, h('div.row', h('label.flab', 'Lunghezza'), nsel), h('label.flab', 'Stile'), App.themePicker(st), status), { cls: 'wide', foot: [h('span.grow'), h('button.btn', { onclick: () => m.close() }, 'Annulla'), go] });
  setTimeout(() => ta.focus(), 80);
};
App.askOutline = async (desc, n) => {
  const inst = `Sei un assistente che prepara scalette di presentazioni in italiano.
Argomento richiesto dall'utente: """${desc}"""
Crea una presentazione di circa ${n} pagine di contenuto (copertina e chiusura le aggiungo io).
Rispondi SOLO con JSON valido, senza testo prima o dopo e senza blocchi di codice, con questa forma:
{"title":"titolo breve","subtitle":"sottotitolo","tag":"etichetta breve in maiuscolo","closing":"frase di chiusura breve","contact":"",
"slides":[{"kind":"bullets|section|twocol|stats|quote|timeline|chart|imgtext","title":"...","bullets":["max 5 punti brevi"],"notes":"cosa dire a voce, 1-2 frasi",
"left":{"title":"","bullets":[]},"right":{"title":"","bullets":[]},
"stats":[{"value":"42%","label":"..."}],"quote":"...","author":"...","role":"",
"steps":[{"title":"...","text":"..."}],
"chart":"bar|line|pie|donut","labels":["A","B"],"series":[{"name":"...","values":[1,2]}],"big":"+30%","note":"...","text":"paragrafo breve"}]}
Usa i campi solo per il tipo scelto. Alterna i tipi di pagina. Punti brevi (massimo 9 parole). Per "stats" usa 3 numeri, per "timeline" 4 passi, per "chart" dati plausibili e coerenti.`;
  const raw = await ST.sample(inst, { modelTier: 'default' });
  const txt = (raw && raw.text) || '';
  const a = txt.indexOf('{'), b = txt.lastIndexOf('}');
  if (a < 0 || b < 0) throw new Error('risposta non valida');
  const ol = JSON.parse(txt.slice(a, b + 1));
  if (!ol.slides || !ol.slides.length) throw new Error('scaletta vuota');
  return ol;
};

/* Presentazione di benvenuto al primo avvio */
App.seed = async () => {
  if (ST.meta.seeded || ST.decks.size) return;
  ST.meta.seeded = 1; ST.saveMeta();
  const th = TP.get('pastello');
  await loadFonts([[th.fd, th.wd], [th.fb, 400], [th.fb, 700]]);
  const d = TP.fromOutline('pastello', {
    title: 'Benvenuto in Palco', subtitle: 'Un esempio per iniziare', tag: 'ESEMPIO',
    slides: [
      { kind: 'bullets', title: 'Come si modifica', bullets: ['Fai doppio clic su un testo per scriverci', 'Trascina, ridimensiona e ruota gli elementi', 'Aggiungi forme, icone e grafici dal pannello a sinistra', 'Le pagine sono in basso: trascinale per riordinarle'] },
      { kind: 'stats', title: 'Palco in breve', stats: [{ value: '11', label: 'Stili pronti da usare' }, { value: '12', label: 'Tipi di pagina' }, { value: '3', label: 'Formati di esportazione' }] },
      { kind: 'timeline', title: 'Dalla bozza alla presentazione', steps: [{ title: 'Scrivi', text: 'Parti da una scaletta' }, { title: 'Disegna', text: 'Scegli uno stile' }, { title: 'Rifinisci', text: 'Colori, font, immagini' }, { title: 'Presenta', text: 'Premi F5' }] }
    ], closing: 'Ora tocca a te.', contact: 'Crea una nuova presentazione dalla Home.'
  });
  d.name = 'Benvenuto in Palco (esempio)';
  ST.saveDeck(d, true);
  App.render();
};

/* ============ Editor: nucleo ============ */
var ED = { active: false, sel: [], zoom: 1, fit: true, panel: 'design', editing: null, clip: null, notesOpen: false, layCache: {} };

ED.slide = () => ED.deck.slides[ED.si];
ED.selEls = () => ED.sel.map(id => M.findEl(ED.slide(), id)).filter(Boolean);
ED.docColors = () => {
  const m = new Map();
  ED.deck.slides.forEach(s => { if (typeof s.bg === 'string') m.set(s.bg.toUpperCase(), 1); s.els.forEach(e => { [e.c, typeof e.f === 'string' ? e.f : null, typeof e.bg === 'string' ? e.bg : null].forEach(c => c && /^#/.test(c) && m.set(c.toUpperCase(), (m.get(c.toUpperCase()) || 0) + 1)); }); });
  return [...m.entries()].sort((a, b) => b[1] - a[1]).map(x => x[0]).slice(0, 16);
};

/* ---- apertura / chiusura ---- */
ED.open = async (deck) => {
  TP.ensure(deck);
  ED.deck = deck; ED.si = 0; ED.sel = []; ED.ssel = []; ED.editing = null; ED.fit = true; ED.active = true; ED.layCache = {};
  if (!deck.imgs) deck.imgs = [];
  ED.hist = { stack: [JSON.stringify(deck.slides)], i: 0, t: null };
  ED.build();
  const fonts = new Set(); deck.slides.forEach(s => s.els.forEach(e => e.f && fonts.add(e.f)));
  loadFonts([...fonts].map(f => [f, 400])).then(() => ED.active && ED.renderStage());
  ED.renderAll();
};
ED.close = () => {
  if (ED.editing) ED.endEdit();
  ED.histFlush(); ED.dirty.cancel(); ST.saveDeck(ED.deck, true);
  UI.closePops();
  ED.active = false;
  document.removeEventListener('keydown', ED.onKey, true); document.removeEventListener('paste', ED.onPaste);
  if (ED._ro) ED._ro.disconnect();
  App.render();
};

/* ---- storico ---- */
ED.histPush = () => {
  const H = ED.hist, s = JSON.stringify(ED.deck.slides);
  if (s === H.stack[H.i]) return;
  H.stack.length = H.i + 1; H.stack.push(s);
  if (H.stack.length > 120) H.stack.shift();
  H.i = H.stack.length - 1; ED.updUndo();
};
ED.histFlush = () => { clearTimeout(ED.hist.t); ED.histPush(); };
ED.commit = (now = true) => { ED.dirty(); clearTimeout(ED.hist.t); if (now) ED.histPush(); else ED.hist.t = setTimeout(ED.histPush, 500); };
ED.restore = () => {
  ED.deck.slides = JSON.parse(ED.hist.stack[ED.hist.i]);
  ED.si = clamp(ED.si, 0, ED.deck.slides.length - 1);
  const ids = new Set(ED.slide().els.map(e => e.id)); ED.sel = ED.sel.filter(i => ids.has(i));
  ED.renderAll(); ED.dirty(); ED.updUndo();
};
ED.undo = () => { if (ED.editing) ED.endEdit(); ED.histFlush(); if (ED.hist.i > 0) { ED.hist.i--; ED.restore(); } };
ED.redo = () => { ED.histFlush(); if (ED.hist.i < ED.hist.stack.length - 1) { ED.hist.i++; ED.restore(); } };
ED.updUndo = () => { const u = $('#b-undo'), r = $('#b-redo'); if (u) u.disabled = ED.hist.i <= 0; if (r) r.disabled = ED.hist.i >= ED.hist.stack.length - 1; };

ED.dirty = debounce(() => { ST.saveDeck(ED.deck); ED.updStatus(); }, 700);
ED.updStatus = () => {
  const n = $('#savest'); if (!n) return;
  const s = ST.status;
  n.textContent = s === 'big' ? 'Troppo grande per il cloud' : s === 'err' ? 'Salvato solo qui' : 'Salvato';
  n.classList.toggle('warn', s !== 'ok');
};
window.addEventListener('palco-status', () => ED.active && ED.updStatus());

/* ---- modifica degli elementi ---- */
ED.mut = (fn, o = {}) => {
  const els = o.els || ED.selEls();
  els.forEach(fn);
  ED.refresh(o);
};
ED.refresh = (o = {}) => {
  if (o.stage !== false) ED.renderStage();
  ED.renderOverlay();
  if (o.tb !== false) ED.renderCtx();
  ED.updateThumb(ED.si);
  if (ED.panel === 'layers') ED.renderPanel();
  ED.commit(o.now !== false);
};
ED.select = (ids, o = {}) => {
  if (ED.editing) ED.endEdit();
  ED.sel = ids.slice();
  ED.renderOverlay(); ED.renderCtx(); if (ED.panel === 'layers') ED.renderPanel();
};
ED.goto = (i) => {
  if (ED.editing) ED.endEdit();
  ED.si = clamp(i, 0, ED.deck.slides.length - 1); ED.sel = [];
  ED.renderStage(); ED.renderOverlay(); ED.renderCtx(); ED.renderStrip(); ED.renderNotes();
  if (ED.panel === 'layers') ED.renderPanel();
};
ED.addEl = (e, o = {}) => {
  if (ED.editing) ED.endEdit();
  if (o.center !== false) { e.x = Math.round((ED.deck.w - e.w) / 2); e.y = Math.round((ED.deck.h - e.h) / 2); }
  if (o.at) { e.x = o.at.x; e.y = o.at.y; }
  ED.slide().els.push(e);
  ED.sel = [e.id];
  ED.renderStage(); ED.renderOverlay(); ED.renderCtx(); ED.updateThumb(ED.si); ED.commit();
  if (ED.panel === 'layers') ED.renderPanel();
  return e;
};
ED.accent = () => ST.brand.colors[0] || '#FFD25A';
ED.themeTxt = () => { const th = TP.get(ED.deck.theme), bg = typeof ED.slide().bg === 'string' ? ED.slide().bg : '#FFFFFF'; return { fg: Col.readable(bg), th }; };

ED.addText = (o = {}) => {
  const { fg, th } = ED.themeTxt();
  const e = M.text({ text: 'Fai clic per modificare', w: 900, s: 72, f: ST.brand.body, c: fg, ...o });
  R.fitHeight(e);
  ED.addEl(e);
  if (o.edit !== false) setTimeout(() => ED.startEdit(e.id, null, true), 30);
  return e;
};
ED.addShape = (k, o = {}) => {
  const dims = { pill: [560, 180], arch: [360, 520], rect: [520, 360], round: [520, 360], halfcircle: [520, 260], wave: [900, 240], arrow: [520, 240], chevron: [420, 240], speech: [520, 400], cloud: [520, 360], heart: [380, 360] };
  const [w, hh] = dims[k] || [400, 400];
  const e = M.shape(k, { w, h: hh, f: ED.accent(), ...o });
  return ED.addEl(e);
};
ED.addLine = (ar = 0, dash = 0) => ED.addEl(M.line({ w: 600, ar, st: { c: ED.themeTxt().fg, w: 8, d: dash } }));
ED.addIcon = n => ED.addEl(M.shape('icon:' + n, { w: 260, h: 260, f: ED.themeTxt().fg }));
ED.addEmoji = ch => { const e = M.text({ text: ch, s: 220, w: 300, a: 'center', lh: 1.1, f: ST.brand.body }); R.fitHeight(e); ED.addEl(e); };
ED.addImage = async (ref, o = {}) => {
  const n = await Img.size(ref), D = ED.deck;
  const k = Math.min(D.w * .6 / n.w, D.h * .7 / n.h, 1.6);
  const w = Math.round(n.w * k), hh = Math.round(n.h * k);
  return ED.addEl(M.image(ref, { w, h: hh, ...o }));
};
ED.addChart = (k) => ED.addEl(M.chart({ k, colors: [ED.accent(), ...ST.brand.colors.slice(1, 5)], tc: ED.themeTxt().fg, f: ST.brand.body, w: 1000, h: 620, bgc: typeof ED.slide().bg === 'string' ? ED.slide().bg : '#FFFFFF', ...(k === 'pie' || k === 'donut' ? { labels: ['Prodotti', 'Servizi', 'Licenze', 'Altro'], series: [{ n: 'Quota', v: [45, 30, 15, 10] }], legend: true } : {}) }));
ED.addTable = (rows, cols) => {
  const data = Array.from({ length: rows }, (_, r) => Array.from({ length: cols }, (_, c) => r === 0 ? 'Colonna ' + (c + 1) : ''));
  const fg = ED.themeTxt().fg, dark = fg === '#FFFFFF';
  ED.addEl(M.table({ rows: data, w: Math.min(1500, cols * 320), f: ST.brand.body, hf: ED.accent(), hc: Col.readable(ED.accent()), cf: dark ? '#222842' : '#FFFFFF', cf2: dark ? '#1B2036' : '#F1F3F8', tc: dark ? '#FFFFFF' : '#14182B', bc: dark ? '#3A4268' : '#D8DCE8' }));
};

ED.deleteSel = () => {
  const ids = new Set(ED.sel); if (!ids.size) return;
  const s = ED.slide(); s.els = s.els.filter(e => !ids.has(e.id) || e.lk && false);
  ED.sel = []; ED.refresh();
};
ED.duplicateSel = () => {
  const els = ED.selEls(); if (!els.length) return;
  const cp = els.map(e => M.cloneEl(e, 28, 28)); ED.slide().els.push(...cp);
  ED.sel = cp.map(e => e.id); ED.refresh();
};
ED.copySel = () => { const els = ED.selEls(); if (els.length) { ED.clip = clone(els); toast('Copiato', { ms: 900 }); } };
ED.cutSel = () => { ED.copySel(); ED.deleteSel(); };
ED.pasteClip = () => {
  if (!ED.clip) return;
  const cp = ED.clip.map(e => M.cloneEl(e, 28, 28)); ED.clip = clone(cp);
  ED.slide().els.push(...cp); ED.sel = cp.map(e => e.id); ED.refresh();
};
/* ordine di sovrapposizione */
ED.order = (how) => {
  const s = ED.slide(), ids = new Set(ED.sel), sel = s.els.filter(e => ids.has(e.id)), rest = s.els.filter(e => !ids.has(e.id));
  if (how === 'front') s.els = [...rest, ...sel];
  else if (how === 'back') s.els = [...sel, ...rest];
  else {
    const arr = s.els.slice();
    if (how === 'up') for (let i = arr.length - 2; i >= 0; i--) { if (ids.has(arr[i].id) && !ids.has(arr[i + 1].id)) [arr[i], arr[i + 1]] = [arr[i + 1], arr[i]]; }
    else for (let i = 1; i < arr.length; i++) { if (ids.has(arr[i].id) && !ids.has(arr[i - 1].id)) [arr[i], arr[i - 1]] = [arr[i - 1], arr[i]]; }
    s.els = arr;
  }
  ED.refresh();
};
ED.alignTo = (how) => {
  const D = ED.deck, els = ED.selEls(); if (!els.length) return;
  const box = els.length > 1 ? M.unionBox(els) : null;
  const ref = box || { x: 0, y: 0, w: D.w, h: D.h };
  ED.mut(e => {
    const b = M.aabb(e); let dx = 0, dy = 0;
    if (how === 'l') dx = ref.x - b.x; if (how === 'c') dx = ref.x + ref.w / 2 - (b.x + b.w / 2); if (how === 'r') dx = ref.x + ref.w - (b.x + b.w);
    if (how === 't') dy = ref.y - b.y; if (how === 'm') dy = ref.y + ref.h / 2 - (b.y + b.h / 2); if (how === 'b') dy = ref.y + ref.h - (b.y + b.h);
    e.x = Math.round(e.x + dx); e.y = Math.round(e.y + dy);
  });
};

/* ---- pagine ---- */
ED.addSlide = (slide, at) => {
  const D = ED.deck, i = at == null ? ED.si + 1 : at;
  const s = slide || M.newSlide(typeof ED.slide().bg === 'string' || ED.slide().bg.g ? clone(ED.slide().bg) : '#FFFFFF');
  D.slides.splice(i, 0, s); ED.si = i; ED.sel = [];
  ED.renderAll(); ED.commit();
};
ED.dupSlide = (i) => { const s = clone(ED.deck.slides[i]); s.id = uid('s_'); s.els.forEach(e => e.id = uid('e')); ED.deck.slides.splice(i + 1, 0, s); ED.si = i + 1; ED.sel = []; ED.renderAll(); ED.commit(); };
ED.delSlide = (i) => {
  const D = ED.deck;
  if (D.slides.length === 1) { D.slides[0] = M.newSlide(); } else D.slides.splice(i, 1);
  ED.si = clamp(ED.si, 0, D.slides.length - 1); ED.sel = []; ED.renderAll(); ED.commit();
};
ED.moveSlide = (i, j) => {
  const D = ED.deck; if (i === j || j < 0 || j >= D.slides.length) return;
  const [s] = D.slides.splice(i, 1); D.slides.splice(j, 0, s); ED.si = j; ED.renderStrip(); ED.commit();
};

/* ---- cambio di tema: ricolora e cambia font mantenendo il layout ---- */
ED.applyTheme = (id) => {
  const o = TP.get(ED.deck.theme), n = TP.get(id), map = new Map();
  ['bg', 'fg', 'mute', 'ac', 'ac2', 'ac3', 'card'].forEach(k => { if (typeof o[k] === 'string' && typeof n[k] === 'string') map.set(o[k].toUpperCase(), n[k]); });
  const col = c => (typeof c === 'string' && map.get(c.toUpperCase())) || c;
  const fill = f => (f && f.g) ? { ...f, g: f.g.map(col) } : col(f);
  const fonts = { [o.fd]: n.fd, [o.fb]: n.fb };
  ED.deck.slides.forEach(s => {
    s.bg = typeof s.bg === 'string' ? col(s.bg) : fill(s.bg);
    EX.flat(s.els).forEach(e => {
      if (e.c) e.c = col(e.c); if (e.bc) e.bc = col(e.bc);
      if (e.f !== undefined && e.t !== 'chart' && e.t !== 'table') { if (e.t === 'text' && fonts[e.f]) e.f = fonts[e.f]; else if (e.t !== 'text') e.f = fill(e.f); }
      if (e.t === 'text' && e.bg) e.bg = fill(e.bg);
      if (e.st && e.st.c) e.st.c = col(e.st.c);
      if (e.t === 'text') (e.paras || []).forEach(p => p.r.forEach(r => { if (r.c) r.c = col(r.c); }));
      if (e.t === 'chart') { e.colors = e.colors.map(col); e.tc = col(e.tc); if (fonts[e.f]) e.f = fonts[e.f]; }
      if (e.t === 'table') { ['hf', 'hc', 'cf', 'cf2', 'bc', 'tc'].forEach(k => e[k] = col(e[k])); if (fonts[e.f]) e.f = fonts[e.f]; }
    });
  });
  ED.deck.theme = id; ED.layCache = {};
  loadFonts([[n.fd, n.wd], [n.fb, 400], [n.fb, 700]]).then(() => ED.active && (ED.renderStage(), ED.renderStrip()));
  ED.renderAll(); ED.commit();
};

/* ---- struttura della schermata ---- */
ED.RAIL = [['design', 'Design', 'layout'], ['ai', 'IA', 'sparkles'], ['elements', 'Elementi', 'shapes'], ['text', 'Testo', 'type'], ['images', 'Immagini', 'image'], ['bg', 'Sfondo', 'palette'], ['layers', 'Livelli', 'layers'], ['check', 'Controllo', 'check']];
ED.build = () => {
  const root = $('#app'); root.className = 'editor'; root.innerHTML = '';
  const name = h('input.ename', { value: ED.deck.name, 'aria-label': 'Nome della presentazione', maxlength: 80, onchange: e => { ED.deck.name = e.target.value.trim() || 'Presentazione senza titolo'; ED.commit(); } });
  name.addEventListener('keydown', e => { if (e.key === 'Enter') name.blur(); });
  const top = h('header.etop',
    h('button.ibtn.dk', { title: 'Torna alla home', 'aria-label': 'Torna alla home', onclick: ED.close }, icn('home', 22)),
    h('span.lmark', { html: '<svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true"><rect width="32" height="32" rx="9" fill="#FFD25A"/><path d="M8 24V8h9a5 5 0 0 1 0 10h-4" fill="none" stroke="#2A2310" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/></svg>' }),
    name, h('span#savest.savest', 'Salvato'), h('div.grow'),
    h('button.ibtn.dk#b-undo', { title: 'Annulla (Ctrl+Z)', 'aria-label': 'Annulla', onclick: ED.undo }, icn('undo', 20)),
    h('button.ibtn.dk#b-redo', { title: 'Ripeti (Ctrl+Y)', 'aria-label': 'Ripeti', onclick: ED.redo }, icn('redo', 20)),
    h('button.ibtn.dk#b-theme', { title: 'Tema chiaro o scuro', 'aria-label': 'Cambia tema', onclick: () => App.toggleTheme() }, icn(App.theme() === 'dark' ? 'sun' : 'moon', 20)),
    h('button.ibtn.dk', { title: 'Comandi rapidi (Ctrl+K)', 'aria-label': 'Comandi rapidi', onclick: () => ED.commandPalette() }, icn('search', 20)),
    h('button.btn.dkbtn', { onclick: e => ED.magicMenu(e.currentTarget) }, icn('sparkles', 18), h('span.hide-s', 'Magia')),
    h('button.btn.dkbtn', { onclick: () => SH.open(ED.deck) }, icn('share', 18), h('span.hide-s', 'Condividi')),
    h('button.btn' + (ED.deck.kind === 'design' ? '.primary' : '.dkbtn'), { onclick: e => EX.menu(e.currentTarget) }, icn('download', 18), h('span.hide-s', 'Scarica')),
    ED.deck.kind === 'design' ? null : h('div.splitbtn',
      h('button.btn.primary', { onclick: () => ED.present(), title: 'Presenta (F5)' }, icn('play', 18), h('span.hide-s', 'Presenta')),
      h('button.btn.primary.sp-dd', { onclick: e => ED.presentMenu(e.currentTarget), title: 'Presenta su uno o due schermi', 'aria-label': 'Opzioni di presentazione' }, icn('chevD', 16))));
  const rail = h('nav.rail', { 'aria-label': 'Strumenti' }, ED.RAIL.map(([k, l, i]) => h('button.rb' + (k === 'ai' ? '.ai' : '') + (ED.panel === k ? '.on' : ''), { data: { k }, onclick: () => ED.setPanel(ED.panel === k ? null : k) }, icn(i, 22), h('span', l))));
  const panel = h('aside#panel.panel');
  const cwrap = h('div#cwrap.cwrap');
  const strip = h('div#strip.strip');
  const notes = h('div#notes.notes');
  const stat = h('div.estat',
    h('button.sbtn#b-notes', { onclick: () => { ED.notesOpen = !ED.notesOpen; ED.renderNotes(); } }, icn('note', 16), 'Note'),
    h('span#pgno.pgno'), h('button.sbtn#b-vision', { title: 'Simula il daltonismo e la vista offuscata', onclick: e => ED.visionMenu(e.currentTarget) }, icn('eye', 16), 'Vista'), h('div.grow'),
    h('input#zoom', { type: 'range', min: 10, max: 300, value: 100, 'aria-label': 'Zoom', oninput: e => ED.setZoom(+e.target.value / 100, false) }),
    h('span#zlab.zlab', '100%'), h('button.sbtn', { onclick: () => { ED.fit = true; ED.applyZoom(); } }, 'Adatta'),
    h('button.ibtn', { title: 'Scorciatoie', 'aria-label': 'Scorciatoie', onclick: UI.shortcuts }, icn('keyboard', 18)));
  const main = h('section.emain', h('div#ctx.ctx'), cwrap, notes, h('div#sbar.sbar', { hidden: true }), strip, stat);
  const small = h('div.small-msg', h('h3', 'Per modificare serve uno schermo più largo'), h('p', 'Puoi comunque presentare questa presentazione o tornare alla home.'), h('div.row', h('button.btn.primary', { onclick: () => ED.present('single') }, 'Presenta'), h('button.btn', { onclick: ED.close }, 'Home')));
  root.append(top, h('div.ebody', rail, panel, main), small);
  // area di lavoro
  const swrap = h('div.swrap', h('div.stage', h('div.sl'), h('div.ov')));
  cwrap.appendChild(swrap);
  ED.cwrap = cwrap; ED.swrap = swrap; ED.stage = swrap.firstChild; ED.slEl = ED.stage.firstChild; ED.ov = ED.stage.lastChild;
  ED.initCanvas();
  ED._ro = new ResizeObserver(() => { if (ED.fit) ED.applyZoom(); });
  ED._ro.observe(cwrap);
  document.addEventListener('keydown', ED.onKey, true); document.addEventListener('paste', ED.onPaste);
};
ED.setPanel = (k) => {
  ED.panel = k; $$('.rb').forEach(b => b.classList.toggle('on', b.dataset.k === k));
  $('.ebody').classList.toggle('nopanel', !k);
  ED.renderPanel(); setTimeout(() => ED.fit && ED.applyZoom(), 30);
};
ED.setZoom = (z, fit) => { ED.zoom = clamp(z, .1, 3); ED.fit = !!fit; ED.applyZoom(); };
ED.applyZoom = () => {
  const D = ED.deck, r = ED.cwrap.getBoundingClientRect();
  if (ED.fit && r.width) ED.zoom = Math.max(.08, Math.min((r.width - 28) / D.w, (r.height - 24) / D.h));
  const z = ED.zoom;
  ED.swrap.style.width = Math.round(D.w * z) + 'px'; ED.swrap.style.height = Math.round(D.h * z) + 'px';
  ED.stage.style.cssText = `width:${D.w}px;height:${D.h}px;transform:scale(${z});--iz:${1 / z}`;
  const zi = $('#zoom'), zl = $('#zlab'); if (zi) zi.value = Math.round(z * 100); if (zl) zl.textContent = Math.round(z * 100) + '%';
};
ED.renderAll = () => {
  ED.renderPanel(); ED.renderStage(); ED.renderOverlay(); ED.renderCtx(); ED.renderStrip(); ED.renderNotes(); ED.applyZoom(); ED.updUndo(); ED.updStatus();
  $('.ebody').classList.toggle('nopanel', !ED.panel);
};
ED.renderNotes = () => {
  const n = $('#notes'); if (!n) return;
  n.hidden = !ED.notesOpen; $('#b-notes').classList.toggle('on', ED.notesOpen);
  n.innerHTML = '';
  if (ED.notesOpen) {
    const ta = h('textarea', { placeholder: 'Scrivi qui le note per chi presenta. Non compaiono sulla pagina.', 'aria-label': 'Note della pagina', value: ED.slide().notes || '' });
    ta.addEventListener('input', () => { ED.slide().notes = ta.value; ED.commit(false); });
    n.appendChild(ta);
  }
  setTimeout(() => ED.fit && ED.applyZoom(), 20);
  const pn = $('#pgno'); if (pn) pn.textContent = `Pagina ${ED.si + 1} di ${ED.deck.slides.length}`;
};
ED.renderStage = () => {
  if (ED.editing) { ED.restyleEditing(); return; }
  const s = ED.slide(), sl = ED.slEl;
  sl.style.cssText = `width:${ED.deck.w}px;height:${ED.deck.h}px;background:${R.bgCss(s.bg)}`;
  sl.innerHTML = R.slideInner(s, ED.deck, { idx: ED.si });
  ED.fixHeights();
};
ED.fixHeights = () => {
  ED.slide().els.forEach(e => {
    if (e.t !== 'text' || e.hd) return;
    const n = ED.slEl.querySelector(`[data-id="${e.id}"]`); if (!n) return;
    const hh = n.firstChild.offsetHeight;
    if (hh && Math.abs(hh - e.h) > .5) { e.h = hh; n.style.height = hh + 'px'; }
  });
};
if (document.fonts) document.fonts.addEventListener && document.fonts.addEventListener('loadingdone', debounce(() => { if (ED.active && !ED.editing) { ED.renderStage(); ED.renderOverlay(); ED.updateThumb(ED.si); } }, 150));

/* ============ Editor: pannelli laterali e barra delle pagine ============ */
ED.renderPanel = () => {
  const p = $('#panel'); if (!p) return;
  p.innerHTML = '';
  if (!ED.panel) return;
  const fn = ED.panels[ED.panel];
  const title = (ED.RAIL.find(r => r[0] === ED.panel) || [])[1];
  p.append(h('div.phd', h('h2', title), h('button.ibtn', { 'aria-label': 'Chiudi pannello', onclick: () => ED.setPanel(null) }, icn('chevL', 20))), h('div.pbd', fn()));
};
ED.panels = {};
const psec = (t, ...kids) => h('section.ps', t ? h('h3', t) : null, ...kids);

/* ---- Design ---- */
ED.panels.design = () => {
  const th = TP.get(ED.deck.theme);
  const lay = h('div.laygrid', h('div.shimmer', 'Preparo i layout…'));
  const build = async () => {
    let list = ED.layCache[th.id];
    if (!list) {
      await loadFonts([[th.fd, th.wd], [th.fb, 400], [th.fb, 700]]);
      list = ED.layCache[th.id] = TP.ORDER.map((k, i) => [k, TP.sample(th.id, k, ED.deck.w, ED.deck.h, i)]);
    }
    if (ED.panel !== 'design' || ED.deck.theme !== th.id) return;
    lay.innerHTML = '';
    list.forEach(([k, s]) => lay.appendChild(h('button.lay', { title: TP.KIND_NAMES[k], onclick: () => ED.addSlide(clone(Object.assign({}, s, { id: uid('s_'), els: s.els.map(e => ({ ...clone(e), id: uid('e') })) }))) }, R.thumb(s, ED.deck), h('span', TP.KIND_NAMES[k]))));
  };
  build();
  const styles = h('div.stylegrid', TP.themes.filter(t => !t.hidden || t.id === ED.deck.theme).map(t => h('button.sty' + (t.id === ED.deck.theme ? '.on' : ''), { onclick: () => { if (t.id !== ED.deck.theme) { ED.applyTheme(t.id); toast('Stile “' + t.name + '” applicato'); } } },
    h('span.stc', { style: { background: t.bg } }, h('i', { style: { background: t.ac } }), h('i', { style: { background: t.ac2 } }), h('i', { style: { background: t.fg } })), h('b', { style: { fontFamily: fontStack(t.fd) } }, 'Aa'), h('small', t.name))));
  const photoBtn = h('button.btn.sm.full', { onclick: () => UI.pickFile('image/*', false, async fs => { try { await ED.themeFromPhoto(fs[0]); } catch (e) { console.warn(e); toast('Non riesco a ricavare i colori da questa immagine', { type: 'err' }); } }) }, icn('palette', 16), 'Colori da una foto');
  return [psec('Aggiungi una pagina', lay), psec('Stili', photoBtn, styles)];
};

/* ---- Elementi ---- */
ED.panels.elements = () => {
  const q = h('input.inp.sm', { type: 'search', placeholder: 'Cerca forme e icone', 'aria-label': 'Cerca elementi' });
  const body = h('div');
  const shapeBtn = (k, name) => h('button.eb', { title: name, 'aria-label': name, onclick: () => ED.addShape(k) }, h('svg', { viewBox: '0 0 100 100', width: 44, height: 44, html: `<path d="${M.pathOf({ k, w: 100, h: 100, rad: null })}" fill="currentColor" fill-rule="evenodd"/>` }));
  const names = { check: 'Spunta', close: 'Croce', star: 'Stella', heart: 'Cuore', home: 'Casa', person: 'Persona', mail: 'Posta', phone: 'Telefono', bulb: 'Idea', arrowR: 'Freccia', pin: 'Posizione', bars: 'Grafico', clock: 'Orologio', like: 'Mi piace', bolt: 'Fulmine', search: 'Cerca', cloud: 'Nuvola', flag: 'Bandiera', lock: 'Lucchetto', trend: 'Crescita', globe: 'Mondo', target: 'Obiettivo' };
  const draw = () => {
    body.innerHTML = '';
    const f = q.value.trim().toLowerCase();
    if (!f) {
      body.appendChild(psec('Disegna', h('button.btn.full' + (ED.draw.on ? '.primary' : ''), { onclick: () => { ED.toggleDraw(); ED.renderPanel(); } }, icn('pen', 18), ED.draw.on ? 'Disegno attivo: clicca “Fine” sulla barra' : 'Disegna a mano libera'),
        h('p.hint2', 'Pennarello, evidenziatore e matita. Ogni tratto diventa un elemento che puoi spostare e ricolorare.')));
      body.appendChild(psec('Codice QR', h('button.btn.full', { onclick: () => ED.qrDialog() }, icn('grid', 18), 'Crea un codice QR')));
      body.appendChild(psec('Cornici per le foto', h('div.egrid', ED.FRAMES.map(k => h('button.eb', { title: (M.SHAPE_LIST.find(s => s[0] === k) || [k, k])[1], onclick: () => ED.addFrame(k) }, h('svg', { viewBox: '0 0 100 100', width: 40, height: 40, html: `<path d="${M.pathOf({ k, w: 100, h: 100, rad: null })}" fill="currentColor" opacity=".55"/>` }))))));
    }
    const shapes =M.SHAPE_LIST.filter(s => !f || s[1].toLowerCase().includes(f));
    const icons = M.ICON_LIST.filter(n => !f || (names[n] || n).toLowerCase().includes(f) || n.includes(f));
    if (!f || 'linea freccia'.includes(f)) body.appendChild(psec('Linee', h('div.egrid.l3',
      [['Linea', 0, 0], ['Freccia', 1, 0], ['Tratteggiata', 0, 1]].map(([n, ar, d]) => h('button.eb.wide', { title: n, onclick: () => ED.addLine(ar, d) }, h('svg', { viewBox: '0 0 90 20', width: 80, height: 20, html: `<path d="M4 10H${ar ? 74 : 86}" stroke="currentColor" stroke-width="4" fill="none" ${d ? 'stroke-dasharray="8 6"' : ''}/>${ar ? '<path d="M72 3 87 10 72 17z" fill="currentColor"/>' : ''}` }))))));
    if (shapes.length) body.appendChild(psec('Forme', h('div.egrid', shapes.map(s => shapeBtn(s[0], s[1])))));
    if (icons.length) body.appendChild(psec('Icone', h('div.egrid', icons.map(n => h('button.eb', { title: names[n] || n, 'aria-label': names[n] || n, onclick: () => ED.addIcon(n) }, h('svg', { viewBox: '0 0 24 24', width: 34, height: 34, html: `<path d="${ICON_PATHS[n]}" fill="currentColor"/>` }))))));
    if (!f) {
      body.appendChild(psec('Adesivi', h('div.egrid.emo', M.EMOJI.map(ch => h('button.eb', { onclick: () => ED.addEmoji(ch) }, ch)))));
      body.appendChild(psec('Grafici', h('div.egrid.l2', [['bar', 'Barre', 'chart'], ['line', 'Linee', 'trend'], ['pie', 'Torta', 'target'], ['donut', 'Ciambella', 'target']].map(([k, n, i]) => h('button.eb.card', { onclick: () => ED.addChart(k) }, h('svg', { viewBox: '0 0 24 24', width: 30, height: 30, html: k === 'bar' || k === 'line' ? `<path d="${ICON_PATHS[k === 'bar' ? 'bars' : 'trend']}" fill="currentColor"/>` : `<path d="M12 2a10 10 0 1 0 10 10H12z" fill="currentColor"/><path d="M14 2.2V10h7.8A10 10 0 0 0 14 2.2z" fill="currentColor" opacity=".5"/>` }), h('span', n))))));
      body.appendChild(psec('Tabelle', h('div.egrid.l3', [[3, 2], [4, 3], [5, 4]].map(([r, c]) => h('button.eb.card', { onclick: () => ED.addTable(r, c) }, h('span.tmini', { style: { gridTemplateColumns: `repeat(${c},1fr)` } }, Array.from({ length: r * c }, (_, i) => h('i' + (i < c ? '.hd' : '')))), h('span', `${c}×${r}`))))));
    }
