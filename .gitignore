    s.cam.forEach((r, i) => list.appendChild(h('div.camrow', h('b', `Inquadratura ${i + 1}`),
      h('button.ibtn.sm', { 'aria-label': 'Sposta su', disabled: !i, onclick: () => { [s.cam[i - 1], s.cam[i]] = [s.cam[i], s.cam[i - 1]]; ED.commit(); draw(); drawList(); } }, icn('arrowUp', 16)),
      h('button.ibtn.sm', { 'aria-label': 'Sposta giù', disabled: i === s.cam.length - 1, onclick: () => { [s.cam[i + 1], s.cam[i]] = [s.cam[i], s.cam[i + 1]]; ED.commit(); draw(); drawList(); } }, icn('arrowDown', 16)),
