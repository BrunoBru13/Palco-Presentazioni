  const g = R.gradLine(f, w, h);
  return {
    fill: `url(#${id})`,
    defs: `<linearGradient id="${id}" gradientUnits="userSpaceOnUse" x1="${g.x1.toFixed(1)}" y1="${g.y1.toFixed(1)}" x2="${g.x2.toFixed(1)}" y2="${g.y2.toFixed(1)}">${f.g.map((c, i) => `<stop offset="${i / (f.g.length - 1)}" stop-color="${c}"/>`).join('')}</linearGradient>`
  };
};
R.bgCss = bg => {
