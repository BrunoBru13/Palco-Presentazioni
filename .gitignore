      const w = Math.max(it.w, it.fs * it.str.length * .5), e = M.text({ text: it.str, x: Math.round(X(it.x)), y: Math.round(Y(it.y - it.fs)), w: Math.round((w * 1.1 + 8) * k), s: Math.max(8, Math.round(it.fs * k)), f: it.font.f, c: it.c, b: it.font.b, i: it.font.i, r: Math.round(it.ang * 180 / Math.PI) });
