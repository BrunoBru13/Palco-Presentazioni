    c.txt(d.n || '01', .07, .14, .3, 150, { f: th.fd, wt: th.wd, c: fg, o: .35, lh: 1, up: false }); c.box('rect', .07, .5, .18, .008, fg);
    const t = c.title(d.title, .07, .54, .8, 92, { c: fg }); R.fitInto(t, c.Y(.32), 56); if (d.sub) c.txt(d.sub, .07, (t.y + t.h) / c.H + .03, .6, 32, { c: fg, o: .85 });
  },
