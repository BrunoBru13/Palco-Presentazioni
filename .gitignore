  let e;
  if (nrect === 1 && nops === 1 && axis) e = M.shape('rect', { x: Math.round(x0), y: Math.round(y0), w: Math.max(1, Math.round(w)), h: Math.max(1, Math.round(h)), f: fill });
  else {
    const n = v => (+v.toFixed(1)).toString();
    const d = segs.map(s => s[0] === 'Z' ? 'Z' : s[0] === 'C' ? `C${s.slice(1).map(p => n(p[0] - x0) + ' ' + n(p[1] - y0)).join(' ')}` : `${s[0]}${n(s[1][0] - x0)} ${n(s[1][1] - y0)}`).join('');
    e = M.shape('path', { x: Math.round(x0), y: Math.round(y0), w: Math.max(1, Math.round(w)), h: Math.max(1, Math.round(h)), d, vb: [Math.max(1, +w.toFixed(1)), Math.max(1, +h.toFixed(1))], f: fill });
  }
  if (stroke) { e.st = { c: stroke, w: Math.max(1, Math.round(lw * scale)), d: 0 }; e.lc = 1; }
  if (alpha < 1) e.o = +alpha.toFixed(2);
  return e;
};

/* ---- documento intero ---- */
PDFI.convert = async (file, opt, progress) => {
  await PDFI.load();
  const buf = new Uint8Array(await file.arrayBuffer());
  const doc = await pdfjsLib.getDocument({ data: buf, disableFontFace: true, isEvalSupported: false, useSystemFonts: false }).promise;
  const total = doc.numPages, maxPages = Math.min(total, 80);
  const p1 = await doc.getPage(1), v1 = p1.getViewport({ scale: 1 });
  const land = v1.width >= v1.height, W = land ? 1920 : Math.round(1920 * v1.width / v1.height), H = land ? Math.round(1920 * v1.height / v1.width) : 1920;
  const stats = { pages: maxPages, total, texts: 0, images: 0, shapes: 0, gradient: 0, fonts: [] }, slides = [];
  PDFI._imgs = new Map();
  for (let n = 1; n <= maxPages; n++) {
    progress && progress(n, maxPages);
    try { slides.push(await PDFI.page(doc, n, W, H, opt, stats)); }
    catch (e) { console.warn('pagina ' + n, e); slides.push(M.newSlide('#FFFFFF')); }
    await sleep(0);
  }
  const fams = [...new Set(stats.fonts)];
  await loadFonts(fams.flatMap(f => [[f, 400], [f, 700]]));
  slides.forEach(s => s.els.forEach(e => { if (e.t === 'text') R.fitHeight(e); }));
  const deck = M.newDeck({ name: file.name.replace(/\.pdf$/i, '') || 'PDF importato', w: W, h: H, theme: 'minimale', slides });
  deck.imgs = (PDFI._allImgs || []).slice(0, 40); PDFI._allImgs = [];
  doc.destroy && doc.destroy();
  return { deck, stats };
};

/* ---- finestra di importazione ---- */
PDFI.dialog = (file) => {
  const opt = { text: true, images: true, shapes: true };
  const bar = h('div.pbar', h('i')), status = h('div.aistatus', 'Pronto a importare.');
  const chk = (k, l) => h('label.chk', h('input', { type: 'checkbox', checked: true, onchange: e => { opt[k] = e.target.checked; } }), l);
  const go = h('button.btn.primary', { onclick: async () => {
    go.disabled = true; $$('input', m).forEach(i => i.disabled = true);
    try {
      status.textContent = 'Carico il lettore PDF…';
      const { deck, stats } = await PDFI.convert(file, opt, (n, t) => { status.textContent = `Leggo la pagina ${n} di ${t}…`; bar.firstChild.style.width = Math.round(n / t * 100) + '%'; });
      m.close(); App.create(deck);
      toast(`Importate ${stats.pages} pagine: ${stats.texts} testi, ${stats.images} immagini, ${stats.shapes} forme` + (stats.gradient ? '. Alcuni sfondi sfumati sono stati semplificati.' : '') + (stats.total > stats.pages ? ` (solo le prime ${stats.pages})` : ''), { ms: 6500 });
    } catch (e) { console.warn(e); go.disabled = false; $$('input', m).forEach(i => i.disabled = false); status.textContent = e && /password/i.test(String(e.name + e.message)) ? 'Il PDF è protetto da password.' : 'Non sono riuscito a leggere questo PDF (serve internet per caricare il lettore).'; }
  } }, icn('upload', 18), 'Importa');
  const m = UI.modal('Importa PDF', h('div.form', h('p.mtext', `“${file.name}” diventa una presentazione che puoi modificare: Palco riconosce testi, immagini, forme e colori.`), chk('text', 'Testi (font, dimensione, colore, allineamento)'), chk('images', 'Immagini'), chk('shapes', 'Forme e colori'), bar, status,
    h('p.hint2', 'I font non presenti vengono sostituiti con quelli più simili. I PDF fatti di sola immagine (scansioni) diventano una pagina con l’immagine.')), { cls: 'small', foot: [h('span.grow'), h('button.btn', { onclick: () => m.close() }, 'Annulla'), go] });
};
App.pickImport = () => UI.pickFile('.pdf,.json,application/pdf,application/json', false, async fs => App.importFile(fs[0]));
App.importFile = async (f) => {
  if (!f) return;
  if (/\.pdf$/i.test(f.name) || f.type === 'application/pdf') return PDFI.dialog(f);
  try { App.create(await EX.importJson(f)); } catch (e) { toast('File non valido: carica un PDF o un progetto Palco', { type: 'err' }); }
};

/* ============ Importa una presentazione PowerPoint (.pptx) e la trasforma in pagine modificabili ============ */
const PPTI = { JSZ: 'https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js' };
PPTI.kids = (n, name) => n ? [...n.children].filter(c => c.nodeName === name) : [];
PPTI.kid = (n, name) => n ? [...n.children].find(c => c.nodeName === name) || null : null;
PPTI.at = (n, ...names) => names.reduce((a, nm) => a && PPTI.kid(a, nm), n);
PPTI.num = (n, a, d = 0) => { const v = n && n.getAttribute(a); return v != null && v !== '' && !isNaN(+v) ? +v : d; };
PPTI.xml = async (zip, path) => { const f = zip.file(path); if (!f) return null; const d = new DOMParser().parseFromString(await f.async('string'), 'application/xml'); return d.querySelector('parsererror') ? null : d; };
PPTI.resolve = (dir, t) => { if (t.startsWith('/')) return t.slice(1); const out = []; (dir + t).split('/').forEach(p => { if (p === '..') out.pop(); else if (p && p !== '.') out.push(p); }); return out.join('/'); };
PPTI.rels = async (zip, part) => {
  const dir = part.replace(/[^/]*$/, ''), name = part.slice(dir.length), d = await PPTI.xml(zip, `${dir}_rels/${name}.rels`), m = {};
  if (d) [...d.getElementsByTagName('Relationship')].forEach(r => { let t = r.getAttribute('Target'); if (r.getAttribute('TargetMode') !== 'External') t = PPTI.resolve(dir, t); m[r.getAttribute('Id')] = { t, type: r.getAttribute('Type') || '' }; });
  return m;
};

/* ---- colori ---- */
PPTI.hsl = (hex) => { const [r, g, b] = Col.hex2rgb(hex).map(v => v / 255), mx = Math.max(r, g, b), mn = Math.min(r, g, b), l = (mx + mn) / 2; let h = 0, s = 0; if (mx !== mn) { const d = mx - mn; s = l > .5 ? d / (2 - mx - mn) : d / (mx + mn); h = mx === r ? (g - b) / d + (g < b ? 6 : 0) : mx === g ? (b - r) / d + 2 : (r - g) / d + 4; h /= 6; } return [h, s, l]; };
PPTI.fromHsl = ([h, s, l]) => { const f = (p, q, t) => { t = (t + 1) % 1; return t < 1 / 6 ? p + (q - p) * 6 * t : t < .5 ? q : t < 2 / 3 ? p + (q - p) * (2 / 3 - t) * 6 : p; }; if (!s) return Col.rgb2hex(l * 255, l * 255, l * 255); const q = l < .5 ? l * (1 + s) : l + s - l * s, p = 2 * l - q; return Col.rgb2hex(f(p, q, h + 1 / 3) * 255, f(p, q, h) * 255, f(p, q, h - 1 / 3) * 255); };
PPTI.color = (n, cx, fallback) => {
  if (!n) return fallback || null;
  const c = [...n.children].find(k => /^a:(srgbClr|schemeClr|sysClr|prstClr|scrgbClr|hslClr)$/.test(k.nodeName)); if (!c) return fallback || null;
  let hex;
  if (c.nodeName === 'a:srgbClr') hex = '#' + c.getAttribute('val');
  else if (c.nodeName === 'a:sysClr') hex = '#' + (c.getAttribute('lastClr') || '000000');
  else if (c.nodeName === 'a:schemeClr') { let v = c.getAttribute('val'); v = cx.clrMap[v] || v; hex = v === 'phClr' ? (fallback || '#000000') : (cx.theme[v] || '#000000'); }
  else if (c.nodeName === 'a:prstClr') hex = ({ black: '#000000', white: '#FFFFFF', red: '#FF0000', green: '#00FF00', blue: '#0000FF', yellow: '#FFFF00' })[c.getAttribute('val')] || '#000000';
  else hex = '#000000';
  hex = Col.parse(hex) || '#000000'; let alpha = 1;
  [...c.children].forEach(m => {
    const v = PPTI.num(m, 'val', 0) / 100000;
    if (m.nodeName === 'a:alpha') alpha = v;
    else if (/lumMod|lumOff|satMod|tint|shade/.test(m.nodeName)) {
      const [h, s, l] = PPTI.hsl(hex);
      if (m.nodeName === 'a:lumMod') hex = PPTI.fromHsl([h, s, Math.min(1, l * v)]);
      else if (m.nodeName === 'a:lumOff') hex = PPTI.fromHsl([h, s, Math.min(1, Math.max(0, l + v))]);
      else if (m.nodeName === 'a:satMod') hex = PPTI.fromHsl([h, Math.min(1, s * v), l]);
      else if (m.nodeName === 'a:tint') hex = Col.mix(hex, '#FFFFFF', 1 - v);
      else hex = Col.mix(hex, '#000000', 1 - v);
    }
  });
