};
TB.pageAnimMenu = (anchor) => UI.menu(anchor, [{ head: 'Anima tutta la pagina' }, ...ANIM.page.map(([k, l]) => ({ label: l, icon: k ? 'zap' : null, onclick: () => ED.animatePage(k) }))]);
TB.alignMulti = (anchor) => UI.pop(anchor, h('div.pp', h('div.cph', 'Allinea tra loro'), h('div.btnrow.g3', [['l', 'Sinistra'], ['c', 'Centro'], ['r', 'Destra'], ['t', 'Alto'], ['m', 'Metà'], ['b', 'Basso']].map(([k, l]) => h('button.btn.sm', { onclick: () => ED.alignTo(k) }, l))),
  h('div.cph', 'Distribuisci'), h('div.btnrow', h('button.btn.sm', { onclick: () => TB.distribute('x') }, 'Orizzontale'), h('button.btn.sm', { onclick: () => TB.distribute('y') }, 'Verticale'))), { cls: 'ppop' });
TB.distribute = (axis) => {
  const els = ED.selEls().slice().sort((a, b) => a[axis] - b[axis]); if (els.length < 3) return toast('Servono almeno tre elementi');
  const dim = axis === 'x' ? 'w' : 'h', first = els[0][axis], last = els[els.length - 1][axis] + els[els.length - 1][dim];
  const total = els.reduce((s, e) => s + e[dim], 0), gap = (last - first - total) / (els.length - 1); let pos = first;
  els.forEach(e => { e[axis] = Math.round(pos); pos += e[dim] + gap; }); ED.refresh();
};
TB.strokePop = (anchor, e0) => {
