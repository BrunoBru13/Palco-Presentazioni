};
function ic(name, size = 20, cls = '') {
  return `<svg class="ic ${cls}" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS[name] || ''}</svg>`;
}
function icn(name, size = 20, cls = '') { return h('span.icw', { html: ic(name, size, cls) }); }

/* ============ Colori ============ */
const Col = {
  hex2rgb(hx) {
    hx = (hx || '#000').replace('#', '');
    if (hx.length === 3) hx = hx.split('').map(c => c + c).join('');
    const n = parseInt(hx.slice(0, 6), 16);
    return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
  },
  rgb2hex(r, g, b) { return '#' + [r, g, b].map(v => clamp(Math.round(v), 0, 255).toString(16).padStart(2, '0')).join('').toUpperCase(); },
  parse(css) {
    if (!css) return null;
    css = String(css).trim();
    if (css[0] === '#') return Col.rgb2hex(...Col.hex2rgb(css));
    const m = css.match(/rgba?\(\s*(\d+)[ ,]+(\d+)[ ,]+(\d+)/);
    return m ? Col.rgb2hex(+m[1], +m[2], +m[3]) : null;
  },
  lum(hx) { const [r, g, b] = Col.hex2rgb(hx).map(v => { v /= 255; return v <= .03928 ? v / 12.92 : Math.pow((v + .055) / 1.055, 2.4); }); return .2126 * r + .7152 * g + .0722 * b; },
  readable(bg) { return Col.lum(bg) > .45 ? '#14182B' : '#FFFFFF'; },
  mix(a, b, t) { const x = Col.hex2rgb(a), y = Col.hex2rgb(b); return Col.rgb2hex(x[0] + (y[0] - x[0]) * t, x[1] + (y[1] - x[1]) * t, x[2] + (y[2] - x[2]) * t); },
  alpha(hx, a) { const [r, g, b] = Col.hex2rgb(hx); return `rgba(${r},${g},${b},${a})`; }
};

/* ============ Font ============ */
const FONTS = [
  // [famiglia, categoria, fallback, pesi disponibili]
  ['Plus Jakarta Sans', 'sans', 'sans-serif'],
  ['Poppins', 'sans', 'sans-serif'],
  ['Montserrat', 'sans', 'sans-serif'],
  ['Manrope', 'sans', 'sans-serif'],
  ['Sora', 'sans', 'sans-serif'],
  ['Outfit', 'sans', 'sans-serif'],
  ['Nunito', 'sans', 'sans-serif'],
  ['Rubik', 'sans', 'sans-serif'],
  ['Raleway', 'sans', 'sans-serif'],
  ['Work Sans', 'sans', 'sans-serif'],
  ['Inter', 'sans', 'sans-serif'],
  ['Space Grotesk', 'sans', 'sans-serif'],
  ['Playfair Display', 'serif', 'serif'],
  ['DM Serif Display', 'serif', 'serif'],
  ['Fraunces', 'serif', 'serif'],
  ['Lora', 'serif', 'serif'],
  ['Merriweather', 'serif', 'serif'],
  ['Cormorant Garamond', 'serif', 'serif'],
  ['Roboto Slab', 'serif', 'serif'],
  ['Abril Fatface', 'display', 'serif'],
  ['Archivo Black', 'display', 'sans-serif'],
  ['Bebas Neue', 'display', 'sans-serif'],
  ['Anton', 'display', 'sans-serif'],
  ['Oswald', 'display', 'sans-serif'],
  ['Pacifico', 'script', 'cursive'],
  ['Caveat', 'script', 'cursive'],
  ['Lobster', 'script', 'cursive'],
  ['Permanent Marker', 'script', 'cursive'],
  ['Space Mono', 'mono', 'monospace'],
  ['JetBrains Mono', 'mono', 'monospace']
];
const FONT_MAP = Object.fromEntries(FONTS.map(f => [f[0], f]));
function fontStack(fam) { const f = FONT_MAP[fam]; return `'${fam}',${f ? f[2] : 'sans-serif'}`; }
const _fontLoads = {};
function loadFont(fam, weight = 400, italic = false) {
  const key = fam + weight + italic;
  if (_fontLoads[key]) return _fontLoads[key];
  const spec = `${italic ? 'italic ' : ''}${weight} 32px "${fam}"`;
  return (_fontLoads[key] = (document.fonts && document.fonts.load ? document.fonts.load(spec, 'AaBbÈà0').catch(() => { }) : Promise.resolve()));
}
async function loadFonts(list) { await Promise.all(list.map(([f, w, i]) => loadFont(f, w || 400, !!i))); }

/* ============ Toast e piccoli aiuti ============ */
/* a schermo intero si vede solo l'elemento in fullscreen: menu, avvisi e finestre vanno dentro di lui */
const uiHost = () => document.fullscreenElement || document.body;
function toast(msg, opts = {}) {
  let box = $('#toasts');
  if (!box) { box = h('div#toasts', { 'aria-live': 'polite' }); }
  if (box.parentNode !== uiHost()) uiHost().appendChild(box);
  const t = h('div.toast' + (opts.type ? '.' + opts.type : ''), opts.icon ? [icn(opts.icon, 18), msg] : msg);
  box.appendChild(t);
  requestAnimationFrame(() => t.classList.add('in'));
  setTimeout(() => { t.classList.remove('in'); setTimeout(() => t.remove(), 300); }, opts.ms || 2600);
}
const fmtDate = ts => {
  const d = new Date(ts), now = new Date();
  const dd = Math.floor((now - d) / 86400000);
  if (now.toDateString() === d.toDateString()) return 'Oggi, ' + d.toLocaleTimeString('it-IT', { hour: '2-digit', minute: '2-digit' });
  if (dd < 2) return 'Ieri';
  return d.toLocaleDateString('it-IT', { day: 'numeric', month: 'short', year: d.getFullYear() === now.getFullYear() ? undefined : 'numeric' });
};
const readFileAs = (file, mode = 'dataURL') => new Promise((res, rej) => {
  const fr = new FileReader(); fr.onload = () => res(fr.result); fr.onerror = rej;
  mode === 'text' ? fr.readAsText(file) : fr.readAsDataURL(file);
});
function download(blob, filename) {
  const url = URL.createObjectURL(blob);
  const a = h('a', { href: url, download: filename });
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 4000);
}

/* ============ Modello dati: presentazioni, pagine, elementi ============ */
const M = {};
M.SIZES = { '16:9': [1920, 1080], '4:3': [1440, 1080], '1:1': [1080, 1080] };

M.newDeck = (o = {}) => ({
  id: uid('d_'), name: o.name || 'Presentazione senza titolo',
  w: o.w || 1920, h: o.h || 1080, theme: o.theme || 'minimale',
  slides: o.slides || [M.newSlide()], created: Date.now(), updated: Date.now(), trashed: 0
});
M.newSlide = (bg = '#FFFFFF') => ({ id: uid('s_'), bg, els: [], notes: '', tr: 'none' });

M.paras = (str) => String(str).split('\n').map(line => ({ r: line ? [{ t: line }] : [] }));
M.plain = (e) => (e.paras || []).map(p => p.r.map(r => r.t).join('')).join('\n');
M.setText = (e, str) => { e.paras = M.paras(str); };

M.text = (o = {}) => {
  const e = {
    id: uid('e'), t: 'text', x: 0, y: 0, w: 640, h: 80, r: 0, paras: M.paras(o.text != null ? o.text : 'Testo'),
    f: 'Poppins', s: 64, c: '#14182B', b: false, i: false, u: false, up: false, a: 'left', lh: 1.2, ls: 0
  };
  Object.assign(e, o); delete e.text; return e;
};
M.shape = (k, o = {}) => Object.assign({
  id: uid('e'), t: 'shape', k, x: 0, y: 0, w: 400, h: 400, r: 0, f: '#FFD25A', st: null, rad: null
}, o);
M.line = (o = {}) => Object.assign({
  id: uid('e'), t: 'shape', k: 'line', x: 0, y: 0, w: 400, h: 0, r: 0, f: null, st: { c: '#14182B', w: 6, d: 0 }, ar: 0
}, o);
M.image = (src, o = {}) => Object.assign({
  id: uid('e'), t: 'image', src, x: 0, y: 0, w: 640, h: 400, r: 0, rad: 0, fl: 0, fx: null
}, o);
M.chart = (o = {}) => Object.assign({
  id: uid('e'), t: 'chart', k: 'bar', x: 0, y: 0, w: 900, h: 560, r: 0,
  labels: ['T1', 'T2', 'T3', 'T4'], series: [{ n: 'Ricavi', v: [42, 58, 71, 95] }, { n: 'Costi', v: [30, 36, 44, 52] }],
  colors: ['#FFD25A', '#1E6BFF', '#12B886', '#F26A2E', '#8B5CF6', '#EC4899'],
  legend: true, grid: true, vals: true, tc: '#14182B', f: 'Plus Jakarta Sans', fs: 26
}, o);
M.table = (o = {}) => {
  const rows = o.rows || [['Voce', 'Q1', 'Q2', 'Q3'], ['Ricavi', '120', '140', '165'], ['Costi', '80', '90', '95'], ['Margine', '40', '50', '70']];
  return Object.assign({
    id: uid('e'), t: 'table', x: 0, y: 0, w: 1100, h: 0, r: 0, rows, rh: 84, hdr: true,
    hf: '#14182B', hc: '#FFFFFF', cf: '#FFFFFF', cf2: '#F1F3F8', bc: '#D8DCE8', tc: '#14182B', f: 'Plus Jakarta Sans', fs: 28
  }, o, { h: (o.rows || rows).length * (o.rh || 84) });
};

M.isText = e => e.t === 'text';
M.cloneEl = (e, dx = 0, dy = 0) => { const c = clone(e); c.id = uid('e'); c.x += dx; c.y += dy; return c; };
M.findEl = (slide, id) => slide.els.find(e => e.id === id);

/* Rettangolo che contiene l'elemento ruotato */
M.aabb = (e) => {
  if (!e.r) return { x: e.x, y: e.y, w: e.w, h: e.h };
  const cx = e.x + e.w / 2, cy = e.y + e.h / 2, a = e.r * Math.PI / 180, c = Math.cos(a), s = Math.sin(a);
  const pts = [[-e.w / 2, -e.h / 2], [e.w / 2, -e.h / 2], [e.w / 2, e.h / 2], [-e.w / 2, e.h / 2]].map(([px, py]) => [cx + px * c - py * s, cy + px * s + py * c]);
  const xs = pts.map(p => p[0]), ys = pts.map(p => p[1]);
  const x = Math.min(...xs), y = Math.min(...ys);
  return { x, y, w: Math.max(...xs) - x, h: Math.max(...ys) - y };
};
M.unionBox = (els) => {
  if (!els.length) return null;
  const bs = els.map(M.aabb);
  const x = Math.min(...bs.map(b => b.x)), y = Math.min(...bs.map(b => b.y));
  return { x, y, w: Math.max(...bs.map(b => b.x + b.w)) - x, h: Math.max(...bs.map(b => b.y + b.h)) - y };
};

/* ============ Tracciati delle forme ============ */
const P = {};
const f2 = v => +v.toFixed(2);
const poly = (pts) => 'M' + pts.map(p => f2(p[0]) + ' ' + f2(p[1])).join('L') + 'Z';
const ngon = (w, h, n, rot = -90) => poly(Array.from({ length: n }, (_, i) => { const a = (rot + i * 360 / n) * Math.PI / 180; return [w / 2 + Math.cos(a) * w / 2, h / 2 + Math.sin(a) * h / 2]; }));
const starPath = (w, h, n, inner) => poly(Array.from({ length: n * 2 }, (_, i) => { const a = (-90 + i * 180 / n) * Math.PI / 180, r = i % 2 ? inner : 1; return [w / 2 + Math.cos(a) * w / 2 * r, h / 2 + Math.sin(a) * h / 2 * r]; }));
function blobPath(w, h, seed, n = 8) {
  let s = seed * 9301 + 49297; const rnd = () => { s = (s * 9301 + 49297) % 233280; return s / 233280; };
  const pts = Array.from({ length: n }, (_, i) => { const a = i / n * Math.PI * 2, r = .72 + rnd() * .28; return [w / 2 + Math.cos(a) * w / 2 * r, h / 2 + Math.sin(a) * h / 2 * r]; });
  let d = '';
  for (let i = 0; i < n; i++) {
    const p0 = pts[(i - 1 + n) % n], p1 = pts[i], p2 = pts[(i + 1) % n], p3 = pts[(i + 2) % n];
    if (i === 0) d += `M${f2(p1[0])} ${f2(p1[1])}`;
    d += `C${f2(p1[0] + (p2[0] - p0[0]) / 6)} ${f2(p1[1] + (p2[1] - p0[1]) / 6)} ${f2(p2[0] - (p3[0] - p1[0]) / 6)} ${f2(p2[1] - (p3[1] - p1[1]) / 6)} ${f2(p2[0])} ${f2(p2[1])}`;
  }
  return d + 'Z';
}
P.rect = (w, h) => `M0 0H${w}V${h}H0Z`;
P.round = (w, h, e) => {
  const m = Math.min(w, h) / 2, r = clamp(e.rad == null ? Math.min(w, h) * .18 : e.rad, 0, m);
  return `M${r} 0H${w - r}A${r} ${r} 0 0 1 ${w} ${r}V${h - r}A${r} ${r} 0 0 1 ${w - r} ${h}H${r}A${r} ${r} 0 0 1 0 ${h - r}V${r}A${r} ${r} 0 0 1 ${r} 0Z`;
};
P.pill = (w, h) => P.round(w, h, { rad: Math.min(w, h) / 2 });
P.ellipse = (w, h) => `M0 ${h / 2}A${w / 2} ${h / 2} 0 1 0 ${w} ${h / 2}A${w / 2} ${h / 2} 0 1 0 0 ${h / 2}Z`;
P.triangle = (w, h) => poly([[w / 2, 0], [w, h], [0, h]]);
P.rtri = (w, h) => poly([[0, 0], [w, h], [0, h]]);
P.diamond = (w, h) => poly([[w / 2, 0], [w, h / 2], [w / 2, h], [0, h / 2]]);
P.pentagon = (w, h) => ngon(w, h, 5);
P.hexagon = (w, h) => ngon(w, h, 6, 0);
P.octagon = (w, h) => ngon(w, h, 8, -67.5);
P.star = (w, h) => starPath(w, h, 5, .42);
P.star4 = (w, h) => starPath(w, h, 4, .3);
P.star6 = (w, h) => starPath(w, h, 6, .55);
P.burst = (w, h) => starPath(w, h, 12, .78);
P.para = (w, h) => poly([[w * .22, 0], [w, 0], [w * .78, h], [0, h]]);
P.trap = (w, h) => poly([[w * .2, 0], [w * .8, 0], [w, h], [0, h]]);
P.chevron = (w, h) => poly([[0, 0], [w * .65, 0], [w, h / 2], [w * .65, h], [0, h], [w * .35, h / 2]]);
P.arrow = (w, h) => poly([[0, h * .3], [w * .62, h * .3], [w * .62, 0], [w, h / 2], [w * .62, h], [w * .62, h * .7], [0, h * .7]]);
P.cross = (w, h) => poly([[w * .35, 0], [w * .65, 0], [w * .65, h * .35], [w, h * .35], [w, h * .65], [w * .65, h * .65], [w * .65, h], [w * .35, h], [w * .35, h * .65], [0, h * .65], [0, h * .35], [w * .35, h * .35]]);
P.arch = (w, h) => `M0 ${h}V${w / 2}A${w / 2} ${w / 2} 0 0 1 ${w} ${w / 2}V${h}Z`;
P.halfcircle = (w, h) => `M0 ${h}A${w / 2} ${h} 0 0 1 ${w} ${h}Z`;
P.quarter = (w, h) => `M0 ${h}V0A${w} ${h} 0 0 1 ${w} ${h}Z`;
P.ring = (w, h, e) => { const t = clamp(e.rad == null ? .22 : e.rad / 100, .05, .45); const iw = w * (1 - t * 2), ih = h * (1 - t * 2), ox = w * t, oy = h * t; return P.ellipse(w, h) + `M${ox} ${h / 2}A${iw / 2} ${ih / 2} 0 1 1 ${w - ox} ${h / 2}A${iw / 2} ${ih / 2} 0 1 1 ${ox} ${h / 2}Z`; };
P.speech = (w, h) => { const b = h * .8, r = Math.min(w, b) * .16; return `M${r} 0H${w - r}A${r} ${r} 0 0 1 ${w} ${r}V${b - r}A${r} ${r} 0 0 1 ${w - r} ${b}H${w * .38}L${w * .2} ${h}L${w * .24} ${b}H${r}A${r} ${r} 0 0 1 0 ${b - r}V${r}A${r} ${r} 0 0 1 ${r} 0Z`; };
P.blob1 = (w, h) => blobPath(w, h, 3);
P.blob2 = (w, h) => blobPath(w, h, 11);
P.blob3 = (w, h) => blobPath(w, h, 27);
P.wave = (w, h) => { const n = 4, step = w / n; let d = `M0 ${h * .5}`; for (let i = 0; i < n; i++) d += `Q${f2(step * (i + .5))} ${i % 2 ? h * .5 + h * .5 : 0} ${f2(step * (i + 1))} ${h * .5}`; return d + `V${h}H0Z`; };

