  target: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16zm0-14a6 6 0 1 0 0 12 6 6 0 0 0 0-12zm0 10a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm0-6a2 2 0 1 0 0 4 2 2 0 0 0 0-4z'
};
M.ICON_LIST = Object.keys(ICON_PATHS);

/* Scala un tracciato SVG (solo comandi senza archi compatti) */
function scalePath(d, sx, sy) {
  const re = /([a-zA-Z])|(-?\d*\.?\d+(?:e[-+]?\d+)?)/g;
  const toks = []; let m;
  while ((m = re.exec(d))) toks.push(m[1] ? m[1] : parseFloat(m[2]));
  let out = '', i = 0, cmd = '';
  const n = v => +v.toFixed(2);
  while (i < toks.length) {
    if (typeof toks[i] === 'string') { cmd = toks[i++]; out += cmd; if (/z/i.test(cmd)) continue; }
    const c = cmd.toLowerCase();
    if (c === 'h') { out += n(toks[i++] * sx) + ' '; }
    else if (c === 'v') { out += n(toks[i++] * sy) + ' '; }
    else if (c === 'a') { out += `${n(toks[i] * sx)} ${n(toks[i + 1] * sy)} ${toks[i + 2]} ${toks[i + 3]} ${toks[i + 4]} ${n(toks[i + 5] * sx)} ${n(toks[i + 6] * sy)} `; i += 7; }
    else { out += n(toks[i] * sx) + ' ' + n(toks[i + 1] * sy) + ' '; i += 2; if (cmd === 'm') cmd = 'l'; else if (cmd === 'M') cmd = 'L'; }
  }
  return out.trim();
}

/* Elenco delle forme mostrate nel pannello Elementi */
M.SHAPE_LIST = [
  ['rect', 'Rettangolo'], ['round', 'Rettangolo arrotondato'], ['pill', 'Pillola'], ['ellipse', 'Cerchio'], ['triangle', 'Triangolo'], ['rtri', 'Triangolo rettangolo'],
  ['diamond', 'Rombo'], ['pentagon', 'Pentagono'], ['hexagon', 'Esagono'], ['octagon', 'Ottagono'], ['star', 'Stella'], ['star4', 'Stella a 4 punte'],
  ['star6', 'Stella a 6 punte'], ['burst', 'Esplosione'], ['para', 'Parallelogramma'], ['trap', 'Trapezio'], ['chevron', 'Freccia a V'], ['arrow', 'Freccia'],
  ['cross', 'Croce'], ['arch', 'Arco'], ['halfcircle', 'Semicerchio'], ['quarter', 'Quarto di cerchio'], ['ring', 'Anello'], ['speech', 'Fumetto'],
  ['heart', 'Cuore'], ['cloud', 'Nuvola'], ['blob1', 'Macchia 1'], ['blob2', 'Macchia 2'], ['blob3', 'Macchia 3'], ['wave', 'Onda']
];

/* Tracciato finale (in pixel dell'elemento) di una forma */
M.pathOf = (e) => {
  const w = Math.max(1, e.w), h = Math.max(1, e.h), k = e.k;
  if (k === 'path') return scalePath(e.d, w / Math.max(1, e.vb ? e.vb[0] : w), h / Math.max(1, e.vb ? e.vb[1] : h));
  if (k && k.startsWith('icon:')) { const d = ICON_PATHS[k.slice(5)]; return d ? scalePath(d, w / 24, h / 24) : P.rect(w, h); }
  if (FIXED[k]) return scalePath(FIXED[k][2], w / FIXED[k][0], h / FIXED[k][1]);
  const fn = P[k] || P.rect;
  return fn(w, h, e);
};
/* La freccia di una linea: tracciato della punta */
M.arrowHeads = (e) => {
  const sw = e.st ? e.st.w : 6, hl = Math.max(22, sw * 3.6), hw = Math.max(14, sw * 2.2);
  const end = `M${e.w} 0L${e.w - hl} ${-hw}L${e.w - hl} ${hw}Z`;
  const start = `M0 0L${hl} ${-hw}L${hl} ${hw}Z`;
  return { end: e.ar >= 1 ? end : '', start: e.ar === 2 ? start : '', inset: hl * .8 };
};
M.linePath = (e) => {
  const a = M.arrowHeads(e);
  const x1 = e.ar === 2 ? a.inset : 0, x2 = e.w - (e.ar >= 1 ? a.inset : 0);
  return `M${x1} 0H${Math.max(x1, x2)}`;
};

/* Emoji per la sezione adesivi */
M.EMOJI = ['😀', '😍', '🤩', '😎', '🥳', '🤔', '👍', '👏', '🙌', '💪', '🎉', '✨', '🔥', '💡', '🚀', '🎯', '🏆', '⭐', '❤️', '💙', '✅', '❌', '⚠️', '❓', '📈', '📉', '📊', '💰', '💼', '📌', '📎', '📅', '⏰', '🔒', '🔑', '⚙️', '🛠️', '💻', '📱', '🎨', '📷', '🎬', '🎵', '📚', '🎓', '🌍', '🌱', '🌞', '🌈', '☁️', '⚡', '🍀', '🍕', '☕', '🏠', '🚗', '✈️', '🧭', '🤝', '👥', '🧠', '🔍', '🏁', '🎁', '📣', '🛒', '🏦', '🧩'];

/* ============ Materiali per la grafica: simboli per loghi, distintivi, bordi ============ */
const circP = (cx, cy, r) => `M${cx - r} ${cy}a${r} ${r} 0 1 0 ${2 * r} 0a${r} ${r} 0 1 0 ${-2 * r} 0Z`;
const polP = (pts) => 'M' + pts.map(p => p.map(v => +v.toFixed(1)).join(' ')).join('L') + 'Z';
const rrP = (x, y, w, h, r) => `M${x + r} ${y}H${x + w - r}A${r} ${r} 0 0 1 ${x + w} ${y + r}V${y + h - r}A${r} ${r} 0 0 1 ${x + w - r} ${y + h}H${x + r}A${r} ${r} 0 0 1 ${x} ${y + h - r}V${y + r}A${r} ${r} 0 0 1 ${x + r} ${y}Z`;

/* ---- simboli (riquadro 100×100) ---- */
const SYM = {};
const sym = (k, n, d, tags) => { SYM[k] = { n, d, tags: tags || '' }; };
sym('leaf', 'Foglia', 'M50 5C20 20 10 52 22 78C28 90 42 96 54 92C80 84 94 54 86 28C82 16 70 10 50 5ZM46 90V38H54V90Z', 'natura bio verde eco');
