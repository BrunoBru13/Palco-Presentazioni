    els.push(DG.tx(Q, p.d, x + 20, y + 90 + Math.max(60, hh * .22) + 6, cw - 40, Math.max(40, hh - 90 - Math.max(60, hh * .22) - 40), { a: 'left', wt: 400, max: 26, min: 13, c: Col.readable(c), top: 1 }));
  });
  return els;
});
dt('iconlist', 'Punti con icone', 'bulb', 1600, 760, 'Idee: Trova ispirazione\nObiettivi: Fissa la direzione\nCrescita: Fai salire i numeri\nGlobale: Raggiungi il mondo\nVelocità: Fai prima\nSicurezza: Proteggi i dati', 'Una riga per punto: “Titolo: descrizione”', (it, W, H, Q) => {
  const n = it.length, cols = n <= 3 ? n : n === 4 ? 2 : 3, rows = Math.ceil(n / cols), cw = W / cols, rh = H / rows, icons = ['bulb', 'target', 'trend', 'globe', 'bolt', 'lock', 'star', 'heart', 'clock', 'check'], els = [];
  it.forEach((p, i) => {
    const x = (i % cols) * cw, y = Math.floor(i / cols) * rh, c = DG.col(Q, i), d = Math.min(120, rh * .45);
    els.push(DG.sh('ellipse', x + 10, y + 10, d, d, c), DG.sh('icon:' + icons[i % icons.length], x + 10 + d * .24, y + 10 + d * .24, d * .52, d * .52, Col.readable(c)));
    els.push(DG.tx(Q, p.t, x + d + 36, y + 6, cw - d - 56, d * .5, { a: 'left', f: Q.fd, wt: 700, max: 40, c: Q.fg }));
    els.push(DG.tx(Q, p.d, x + d + 36, y + 6 + d * .5, cw - d - 56, rh - d * .5 - 40, { a: 'left', wt: 400, max: 28, min: 14, c: Q.fg, top: 1 }));
  });
  return els;
});
DG.ORDER = ['steps', 'cards', 'cycle', 'pyramid', 'funnel', 'venn', 'org', 'mind', 'timeline', 'matrix', 'versus', 'kpi', 'rings', 'bars', 'stairs', 'iconlist'];

/* ---------- colori e contesto ---------- */
DG.PALS = [['tema', 'Tema'], ['marchio', 'Marchio'], ['vivace', 'Vivace'], ['caldo', 'Caldi'], ['freddo', 'Freddi'], ['pastello', 'Pastello'], ['mono', 'Un colore']];
DG.palette = (key, th) => ({
  tema: [th.ac, th.ac2, th.ac3, Col.mix(th.ac, th.fg, .4), Col.mix(th.ac2, th.fg, .4), Col.mix(th.ac3, th.fg, .4)],
  marchio: ST.brand.colors.slice(0, 6),
  vivace: ['#F2542D', '#1E6BFF', '#12B886', '#FFB020', '#8B5CF6', '#EC4899'],
  caldo: ['#E63946', '#F4733A', '#F9A03F', '#F7C948', '#C0392B', '#8E2C48'],
  freddo: ['#1E6BFF', '#0EA5A5', '#5B8CFF', '#3A86FF', '#6C5CE7', '#0B7A75'],
  pastello: ['#FF9AA2', '#FFB86B', '#FFE08A', '#9BE3B4', '#9CC9FF', '#C9A8FF'],
  mono: [th.ac, Col.mix(th.ac, '#FFFFFF', .22), Col.mix(th.ac, '#000000', .22), Col.mix(th.ac, '#FFFFFF', .42), Col.mix(th.ac, '#000000', .42), Col.mix(th.ac, '#FFFFFF', .6)]
})[key] || [th.ac, th.ac2, th.ac3];
DG.ctx = (pal, bg) => {
  const th = TP.get(ED.deck.theme), b = bg || (typeof ED.slide().bg === 'string' ? ED.slide().bg : th.bg), fg = Col.readable(b);
  return { c: DG.palette(pal, th).map(c => Col.parse(c) || '#1E6BFF'), bg: b, fg, card: Col.mix(b, fg, .08), line: Col.mix(b, fg, .22), fd: th.fd, fb: th.fb, th };
};
DG.make = async (type, text, pal, bg) => {
  const T = DG.TYPES[type], Q = DG.ctx(pal, bg), items = DG.parse(text); if (!items.length) return null;
  await loadFonts([[Q.fd, 700], [Q.fd, 800], [Q.fb, 400], [Q.fb, 500], [Q.fb, 600], [Q.fb, 700]]);
  const els = T.fn(items, T.w, T.h, Q).filter(Boolean);
  els.forEach(e => { if (e.t === 'text' && e.o == null) delete e.o; });
  return { w: T.w, h: T.h, els, Q };
};
DG.group = (res, type, text, pal, W, H) => {
  const k = Math.min(W * .86 / res.w, H * .74 / res.h, 1.4), w = Math.round(res.w * k), h = Math.round(res.h * k);
  return { id: uid('e'), t: 'group', x: Math.round((W - w) / 2), y: Math.round((H - h) / 2), w, h, ow: res.w, oh: res.h, r: 0, els: res.els, dg: { type, text, pal } };
};
DG.insert = async (type, text, pal) => {
  const res = await DG.make(type, text, pal); if (!res) return toast('Scrivi almeno una riga');
  ED.addEl(DG.group(res, type, text, pal, ED.deck.w, ED.deck.h), { center: false }); toast('Diagramma aggiunto: selezionalo e premi “Modifica il diagramma” per cambiarlo', { ms: 3500 });
};

/* ---------- finestra di modifica ---------- */
DG.dialog = (type, edit, pre) => {
  const S = { type, text: edit ? edit.dg.text : pre ? pre.text : DG.TYPES[type].sample, pal: edit ? edit.dg.pal : 'tema' }, prev = h('div.dgprev'), status = h('div.aistatus');
  let tok = 0;
  const draw = async () => {
    const my = ++tok; const res = await DG.make(S.type, S.text, S.pal); if (my !== tok) return; prev.innerHTML = '';
    if (!res) { prev.appendChild(h('p.hint2', 'Scrivi qualcosa nella lista')); return; }
    const W = 1920, H = 1080, g = DG.group(res, S.type, S.text, S.pal, W, H), sl = GR.slide(res.Q.bg, [g]);
    prev.appendChild(R.thumb(sl, { w: W, h: H }));
  };
  const redraw = debounce(draw, 250);
  const ta = h('textarea.inp.area', { rows: 9, 'aria-label': 'Voci del diagramma', oninput: e => { S.text = e.target.value; redraw(); } }, S.text);
  const hint = h('p.hint2', DG.TYPES[S.type].hint);
  const sel = h('select.inp', { 'aria-label': 'Tipo di diagramma', onchange: e => { S.type = e.target.value; hint.textContent = DG.TYPES[S.type].hint; if (!edit && !pre) { S.text = DG.TYPES[S.type].sample; ta.value = S.text; } draw(); } }, DG.ORDER.map(k => h('option', { value: k, selected: k === S.type }, DG.TYPES[k].n)));
  const pals = h('div.chips', DG.PALS.map(([k, l]) => h('button.chip' + (S.pal === k ? '.on' : ''), { onclick: e => { S.pal = k; $$('.chip', e.currentTarget.parentNode).forEach((b, i) => b.classList.toggle('on', DG.PALS[i][0] === k)); draw(); } }, l)));
  const ai = AI.textOk() ? h('div.laibox', h('input.inp', { placeholder: 'Argomento: “le fasi di un progetto web”, “vantaggi del cloud”…', 'aria-label': 'Argomento per l’IA', onkeydown: e => { if (e.key === 'Enter') e.target.nextSibling.click(); } }),
    h('button.btn.sm.primary', { onclick: async e => { const b = e.currentTarget, topic = b.previousSibling.value.trim(); if (!topic) return toast('Scrivi l’argomento'); b.disabled = true; status.textContent = 'L’IA sta scrivendo le voci…'; try { const out = await DG.askAI(S.type, topic); S.text = out; ta.value = out; status.textContent = ''; draw(); } catch (er) { console.warn(er); status.textContent = AI.errMsg(er, 'Non sono riuscito a ricevere le voci: scrivile a mano.'); } b.disabled = false; } }, icn('sparkles', 16), 'Compila con l’IA')) : null;
  const m = UI.modal(edit ? 'Modifica il diagramma' : 'Nuovo diagramma', h('div.dgdlg', h('div.dgl', h('label.flab', 'Tipo'), sel, h('label.flab', 'Voci'), ta, hint, ai, status, h('label.flab', 'Colori'), pals), h('div.dgr', prev)), {
    cls: 'logomaker dgbox', foot: [h('span.grow'), h('button.btn', { onclick: () => m.close() }, 'Annulla'), h('button.btn.primary', { onclick: async () => {
      const res = await DG.make(S.type, S.text, S.pal); if (!res) return toast('Scrivi almeno una riga'); m.close();
      if (edit) { const k = edit.w / edit.ow, w = Math.round(res.w * k), hh = Math.round(res.h * k); ED.mut(g => { const cx = g.x + g.w / 2, cy = g.y + g.h / 2; g.els = res.els; g.ow = res.w; g.oh = res.h; g.w = w; g.h = hh; g.x = Math.round(cx - w / 2); g.y = Math.round(cy - hh / 2); g.dg = { type: S.type, text: S.text, pal: S.pal }; }, { els: [edit] }); }
      else if (pre && pre.replace) { const o = pre.replace, g = DG.group(res, S.type, S.text, S.pal, ED.deck.w, ED.deck.h), cx = o.x + o.w / 2, cy = o.y + o.h / 2; g.x = Math.round(clamp(cx - g.w / 2, 20, ED.deck.w - g.w - 20)); g.y = Math.round(clamp(cy - g.h / 2, 20, ED.deck.h - g.h - 20)); const s = ED.slide(), i = s.els.indexOf(o); if (i >= 0) s.els.splice(i, 1, g); else s.els.push(g); ED.sel = [g.id]; ED.renderStage(); ED.renderOverlay(); ED.renderCtx(); ED.updateThumb(ED.si); ED.commit(); toast('Elenco trasformato: puoi modificare il diagramma quando vuoi', { icon: 'diagram', ms: 3000 }); }
      else ED.addEl(DG.group(res, S.type, S.text, S.pal, ED.deck.w, ED.deck.h), { center: false });
    } }, icn('check', 16), edit ? 'Aggiorna' : pre && pre.replace ? 'Trasforma' : 'Inserisci')]
  });
  draw();
};
DG.askAI = async (type, topic) => {
  const T = DG.TYPES[type], inst = `Scrivi in italiano le voci di un diagramma di tipo "${T.n}" sull'argomento: """${topic}""".
Formato: una voce per riga, solo testo semplice. Regola per questo diagramma: ${T.hint}. Esempio del formato:
${T.sample}
Rispondi SOLO con le righe, senza numeri, senza commenti e senza virgolette. Voci brevi (massimo 5 parole per il titolo e 8 per la descrizione), tra 3 e 6 righe.`;
  const out = (await AI.ask(inst, { modelTier: 'default' })).replace(/```[a-z]*/g, '').trim();
  if (!out) throw new Error('vuoto'); return out;
};

/* ---------- pannello e modifica sul posto ---------- */
ED.panels.diagram = () => {
  const th = TP.get(ED.deck.theme), grid = h('div.dggrid');
  DG.ORDER.forEach(k => {
    const T = DG.TYPES[k], slot = h('button.dgc', { title: T.n, onclick: () => DG.dialog(k) }, h('div.dgth.loading'), h('small', T.n));
    const key = k + th.id + (typeof ED.slide().bg === 'string' ? ED.slide().bg : '');
    const show = (pv) => { const w = $('.dgth', slot); if (w) { w.classList.remove('loading'); w.appendChild(pv.cloneNode ? R.thumb(pv.sl, pv.d) : pv); } };
    const mk = async () => { const res = await DG.make(k, T.sample, 'tema'); if (!res) return; const W = 1600, H = 900, g = DG.group(res, k, T.sample, 'tema', W, H); return { sl: GR.slide(res.Q.bg, [g]), d: { w: W, h: H } }; };
    (DG.cache.get(key) ? Promise.resolve(DG.cache.get(key)) : mk().then(r => { DG.cache.set(key, r); return r; })).then(r => r && show({ sl: r.sl, d: r.d, cloneNode: 1 }));
    grid.appendChild(slot);
  });
  return [h('p.hint2', 'Scrivi una lista e Palco la trasforma in un diagramma: cambia tipo e colori quando vuoi.'), grid];
};
['RAIL_PRES', 'RAIL'].forEach(k => { if (ED[k] && !ED[k].some(r => r[0] === 'diagram')) { const i = ED[k].findIndex(r => r[0] === 'text'); ED[k].splice(i < 0 ? ED[k].length : i, 0, ['diagram', 'Diagrammi', 'diagram']); } });
if (GR.RAIL && !GR.RAIL.some(r => r[0] === 'diagram')) { const i = GR.RAIL.findIndex(r => r[0] === 'text'); GR.RAIL.splice(i, 0, ['diagram', 'Diagrammi', 'diagram']); }
const dgCtx0 = ED.renderCtx;
ED.renderCtx = () => {
  dgCtx0();
  const els = ED.selEls(), c = $('#ctx'); if (!c || ED.crop || els.length !== 1 || els[0].t !== 'group' || !els[0].dg) return;
  c.prepend(TB.btn('diagram', 'Modifica il diagramma: voci, tipo e colori', () => DG.dialog(els[0].dg.type, els[0]), false, 'Modifica il diagramma'));
};
document.addEventListener('dblclick', (e) => { const n = e.target.closest && e.target.closest('.sl > .el-group'); if (!n || !ED.active) return; const g = M.findEl(ED.slide(), n.dataset.id); if (g && g.dg && !ED.editing) DG.dialog(g.dg.type, g); });

/* ============ Cronologia delle versioni e modelli personali ============ */
const VER = { MAX: 18, every: 4 * 60 * 1000 };
VER.key = id => 'ver:' + id;
VER.list = async (id) => (await ST.idbGet(VER.key(id))) || [];
VER.sig = (deck) => deck.w + 'x' + deck.h + '|' + JSON.stringify(deck.slides);
VER.snap = async (deck, label, auto = true) => {
  if (!deck || !deck.slides || deck.collabGuest) return false;
  const sig = VER.sig(deck), all = await VER.list(deck.id), last = all[all.length - 1];
  if (last && last.sig === sig) { if (label && !auto) { last.label = label; last.auto = false; await ST.idbPut(VER.key(deck.id), all); return true; } return false; }
  all.push({ id: uid('v'), t: Date.now(), label: label || '', auto, n: deck.slides.length, w: deck.w, h: deck.h, name: deck.name, sig, slides: JSON.stringify(deck.slides) });
  // si tengono le ultime automatiche e tutte quelle con nome
  const autos = all.filter(v => v.auto); while (autos.length > VER.MAX) { const old = autos.shift(); all.splice(all.indexOf(old), 1); }
  return ST.idbPut(VER.key(deck.id), all);
};
VER.when = (t) => {
  const d = new Date(t), now = new Date(), day = Math.floor((now.setHours(0, 0, 0, 0) - new Date(t).setHours(0, 0, 0, 0)) / 864e5), hm = d.toLocaleTimeString('it-IT', { hour: '2-digit', minute: '2-digit' });
  return day === 0 ? 'Oggi ' + hm : day === 1 ? 'Ieri ' + hm : d.toLocaleDateString('it-IT', { day: 'numeric', month: 'short' }) + ' ' + hm;
};
/* istantanee automatiche mentre si lavora */
VER.start = () => {
  clearInterval(VER._t); VER._last = Date.now();
  VER.snap(ED.deck, '', true);
  VER._t = setInterval(() => { if (!ED.active) return clearInterval(VER._t); ED.histFlush && ED.histFlush(); VER.snap(ED.deck, '', true); }, VER.every);
};
const verOpen0 = ED.open;
ED.open = async (deck) => { const r = await verOpen0(deck); VER.start(); return r; };
const verClose0 = ED.close;
ED.close = () => { const d = ED.deck; verClose0(); VER.snap(d, '', true); clearInterval(VER._t); };

VER.restore = async (deck, v) => {
  await VER.snap(deck, 'Prima del ripristino', true);
  deck.slides = JSON.parse(v.slides); deck.w = v.w; deck.h = v.h; ED.si = 0; ED.sel = []; ED.fit = true;
  ED.renderAll(); ED.commit(); ED.applyZoom && ED.applyZoom(); toast('Versione ripristinata: puoi annullare con Ctrl+Z', { icon: 'restore', ms: 3500 });
};
VER.dialog = async () => {
  const D = ED.deck; ED.histFlush && ED.histFlush();
  const body = h('div.verlist'), note = h('p.hint2', 'Palco salva da solo una copia ogni pochi minuti mentre lavori e quando esci. Le versioni restano su questo browser.');
  const draw = async () => {
    const all = (await VER.list(D.id)).slice().reverse(); body.innerHTML = '';
    if (!all.length) { body.appendChild(h('p.hint2', 'Ancora nessuna versione: continua a lavorare oppure salvane una adesso.')); return; }
    all.forEach(v => {
      const tmp = { w: v.w, h: v.h }, sl = (JSON.parse(v.slides) || [])[0], row = h('div.verrow',
        h('div.verth', sl ? R.thumb(sl, tmp) : null),
        h('div.vermeta', h('b', v.label || VER.when(v.t)), h('small', (v.label ? VER.when(v.t) + ' · ' : '') + `${v.n} ${v.n === 1 ? 'pagina' : 'pagine'}${v.auto ? ' · automatica' : ''}`)),
        h('div.verbtn', h('button.btn.sm', { onclick: () => UI.confirm('Ripristinare questa versione?', 'La presentazione torna com’era ' + VER.when(v.t).toLowerCase() + '. Prima ne salvo una copia di quella attuale.', 'Ripristina', async () => { m.close(); await VER.restore(D, v); }, false) }, icn('restore', 16), 'Ripristina'),
          h('button.ibtn.sm', { 'aria-label': 'Elimina la versione', title: 'Elimina', onclick: async () => { const cur = await VER.list(D.id); await ST.idbPut(VER.key(D.id), cur.filter(x => x.id !== v.id)); draw(); } }, icn('trash', 16))));
      body.appendChild(row);
    });
  };
  const m = UI.modal('Cronologia versioni', h('div.form', h('button.btn.primary', { onclick: () => UI.prompt('Dai un nome a questa versione', '', 'Salva', async name => { await VER.snap(D, name.trim().slice(0, 50), false); toast('Versione salvata', { icon: 'check', ms: 1800 }); draw(); }) }, icn('plus', 16), 'Salva una versione adesso'), note, body), { cls: 'wide2' });
  draw();
};

/* ---------- modelli personali ---------- */
const stList0 = ST.list.bind(ST);
ST.list = (trashed = false, tpl = false) => trashed ? stList0(true) : stList0(false).filter(d => !!d.tpl === !!tpl);
App.saveAsTemplate = (d) => {
  UI.prompt('Nome del modello', d.name, 'Salva', name => {
    const c = clone(d); c.id = uid('d_'); c.name = name.trim() || d.name; c.tpl = 1; c.created = Date.now(); c.trashed = 0; ST.saveDeck(c, true);
    toast('Modello salvato: lo trovi in Modelli → I miei modelli', { icon: 'layout', ms: 3800 }); if (!(typeof ED !== 'undefined' && ED.active)) App.render();
  });
};
App.useTemplate = (t) => { const c = clone(t); c.id = uid('d_'); c.name = t.name; c.tpl = 0; delete c.tpl; c.created = Date.now(); c.trashed = 0; return App.create(c); };
App.tplMenu = (anchor, t) => UI.menu(anchor, [
  { label: 'Usa questo modello', icon: 'play', onclick: () => App.useTemplate(t) },
  { label: 'Modifica il modello', icon: 'edit', onclick: () => ED.open(t) },
  { label: 'Rinomina', icon: 'type', onclick: () => UI.prompt('Rinomina il modello', t.name, 'Salva', v => { t.name = v; ST.saveDeck(t, true); App.render(); }) },
  { sep: 1 }, { label: 'Elimina', icon: 'trash', danger: true, onclick: () => UI.confirm('Eliminare il modello?', `“${t.name}” verrà cancellato.`, 'Elimina', () => { t.trashed = Date.now(); ST.saveDeck(t, true); App.render(); }) }
], { align: 'right' });
App.myTemplates = () => {
  const list = ST.list(false, true); if (!list.length) return null;
  return h('section', h('div.sechd', h('h2', 'I miei modelli')), h('div.grid', list.map(t => {
    const c = h('div.dcard.tcard', { tabindex: 0, role: 'button', 'aria-label': 'Usa il modello ' + t.name, onclick: () => App.useTemplate(t), onkeydown: e => { if (e.key === 'Enter') App.useTemplate(t); } },
      h('div.thwrap', R.thumb(t.slides[0], t), t.kind === 'design' ? h('span.kbadge', 'Grafica') : null),
      h('div.dmeta', h('div.dt', h('b', t.name), h('span.ds', `${t.slides.length} ${t.slides.length === 1 ? 'pagina' : 'pagine'} · modello`)), h('button.ibtn', { 'aria-label': 'Altre azioni', onclick: e => { e.stopPropagation(); App.tplMenu(e.currentTarget, t); } }, icn('more', 20))));
    return c;
  })));
};
const vTpl0 = App.vTemplates;
App.vTemplates = () => { const v = vTpl0(), mine = App.myTemplates(); if (mine) { const first = v.querySelector('.sechd.big'); first ? first.after(mine) : v.prepend(mine); } return v; };
const vGfx0 = App.vGraphics;
App.vGraphics = () => { const v = vGfx0(), mine = App.myTemplates(); if (mine) { const sec = [...v.children].find(n => n.matches && n.matches('section') && !n.matches('.gfxhero')); sec ? sec.before(mine) : v.appendChild(mine); } return v; };

/* ============ Home: preferiti, cartelle, selezione multipla e ricerca rapida (Ctrl+K) ============ */
App.folders = () => (ST.meta.folders = ST.meta.folders || []);
App.folder = 'all'; App.sel = null;
App.saveFolders = () => ST.saveMeta();
App.toggleFav = (d) => { d.fav = d.fav ? 0 : 1; ST.saveDeck(d, true); App.render(); toast(d.fav ? 'Aggiunto ai preferiti' : 'Tolto dai preferiti', { icon: 'star', ms: 1500 }); };
App.newFolder = (then) => UI.prompt('Nome della cartella', '', 'Crea', v => { const f = { id: uid('f_'), name: v.trim().slice(0, 40) || 'Cartella' }; App.folders().push(f); App.saveFolders(); then ? then(f) : (App.folder = f.id, App.render()); });
App.moveTo = (decks, fid) => { decks.forEach(d => { if (fid) d.folder = fid; else delete d.folder; ST.saveDeck(d, true); }); App.sel = null; App.render(); toast(fid ? 'Spostato nella cartella' : 'Tolto dalla cartella', { icon: 'folder', ms: 1600 }); };
App.moveMenu = (decks) => {
  const list = h('div.fmove'), m = UI.modal('Sposta in una cartella', list, { cls: 'small' });
  const row = (label, fid, ic) => h('button.cmd', { onclick: () => { m.close(); App.moveTo(decks, fid); } }, icn(ic || 'folder', 18), h('span.ml', label));
  list.append(row('Nessuna cartella', null, 'home'), ...App.folders().map(f => row(f.name, f.id)), h('button.cmd', { onclick: () => { m.close(); App.newFolder(f => App.moveTo(decks, f.id.toString())); } }, icn('plus', 18), h('span.ml', 'Nuova cartella…')));
};
App.folderMenu = (anchor, f) => UI.menu(anchor, [
  { label: 'Rinomina', icon: 'type', onclick: () => UI.prompt('Rinomina la cartella', f.name, 'Salva', v => { f.name = v.trim() || f.name; App.saveFolders(); App.render(); }) },
  { label: 'Elimina la cartella', icon: 'trash', danger: true, onclick: () => UI.confirm('Eliminare la cartella?', 'I progetti dentro non vengono cancellati: tornano in “Tutti”.', 'Elimina', () => { ST.decks.forEach(d => { if (d.folder === f.id) { delete d.folder; ST.saveDeck(d, true); } }); ST.meta.folders = App.folders().filter(x => x.id !== f.id); App.saveFolders(); App.folder = 'all'; App.render(); }) }
], { align: 'right' });

/* ---- schede: stella, selezione e trascinamento ---- */
const deckCard1 = App.deckCard;
App.deckCard = (d, o = {}) => {
  const c = deckCard1(d, o), th = c.querySelector('.thwrap');
  if (d.trashed || d.tpl) return c;
  const star = h('button.favb' + (d.fav ? '.on' : ''), { title: d.fav ? 'Togli dai preferiti' : 'Aggiungi ai preferiti', 'aria-label': 'Preferito', onclick: e => { e.stopPropagation(); App.toggleFav(d); } }, icn('star', 16));
  th && th.appendChild(star);
  const sel = App.sel;
  if (sel) { const on = sel.has(d.id); c.classList.toggle('picked', on); th && th.appendChild(h('span.pickb' + (on ? '.on' : ''), icn('check', 16))); }
  c.addEventListener('click', e => { if (UI.lpHold) { e.stopImmediatePropagation(); e.preventDefault(); return; } if (!App.sel) return; e.stopImmediatePropagation(); e.preventDefault(); App.sel.has(d.id) ? App.sel.delete(d.id) : App.sel.add(d.id); App.render(); }, true);
  /* tenendo premuto su un progetto si entra nella selezione multipla (poi basta toccare gli altri) */
  UI.longPress(c, () => { if (App.sel) App.sel.has(d.id) ? App.sel.delete(d.id) : App.sel.add(d.id); else App.sel = new Set([d.id]); if (App.view !== 'projects') { App.folder = 'all'; App.view = 'projects'; } App.render(); });
  c.addEventListener('contextmenu', e => { if (UI.lpHold || Date.now() - UI.lpAt < 900) e.preventDefault(); });
  c.draggable = true; c.addEventListener('dragstart', e => { if (UI.lpHold) { e.preventDefault(); return; } e.dataTransfer.setData('text/x-palco-deck', d.id); e.dataTransfer.effectAllowed = 'move'; });
  return c;
};
const hero0 = App.vHome;
App.vHome = () => {
  const v = hero0(), favs = ST.list().filter(d => d.fav).slice(0, 4);
  if (favs.length) { const sec = h('section', h('div.sechd', h('h2', 'Preferiti'), h('button.link', { onclick: () => { App.folder = 'fav'; App.go('projects'); } }, 'Vedi tutti')), h('div.grid', favs.map(d => App.deckCard(d)))); const rec = [...v.children].find(n => n.matches && n.matches('section') && /Recenti/.test(n.textContent)); rec ? rec.before(sec) : v.appendChild(sec); }
  return v;
};

/* ---- Progetti ---- */
App.vProjects = () => {
  let list = App.filterDecks(ST.list()); const all = list.length, f = App.folder, kind = App.kind || 'all';
  if (f === 'fav') list = list.filter(d => d.fav); else if (f !== 'all') list = list.filter(d => d.folder === f);
  if (kind === 'design') list = list.filter(d => d.kind === 'design'); else if (kind === 'pres') list = list.filter(d => d.kind !== 'design');
  if (App.sort === 'name') list = list.slice().sort((a, b) => a.name.localeCompare(b.name));
