LAY.checklist = (c, d) => {
  const th = c.th; head(c, d.title); const items = d.items.slice(0, 8), n = items.length, cols = n > 4 ? 2 : 1, per = Math.ceil(n / cols), rh = Math.min(.13, .6 / per), dia = c.S(54);
  items.forEach((t, k) => {
    const col = Math.floor(k / per), r = k % per, x = .07 + col * .45, cy = c.Y(.3 + r * rh + rh / 2 - .01);
    c.icon('check', c.X(x), cy - dia / 2, dia, th.ac); const e = c.txt(t, x + dia / c.W + .02, 0, cols > 1 ? .33 : .7, 34, {}); R.fitInto(e, c.Y(rh) - 6, 18); c.vcenter(e, cy);
  });
};
LAYV.gallery = {
  default: null,
  row: (c, d) => {
    const th = c.th; head(c, d.title); const items = (d.items || []).slice(0, 4), n = Math.max(2, items.length), gx = .025, w = (.86 - gx * (n - 1)) / n;
    for (let k = 0; k < n; k++) { const x = .07 + k * (w + gx); c.img(c.art(k), x, .28, w, .46, { rad: c.S(th.rad * .6) }); if (items[k]) { const e = c.txt(items[k], x, .76, w, 28, { wt: 700 }); R.fitInto(e, c.Y(.15), 18); } }
  },
  mosaic: (c, d) => {
    const th = c.th; head(c, d.title); const items = d.items || [], r = c.S(th.rad * .6);
    c.img(c.art(0), .07, .27, .5, .6, { rad: r }); c.img(c.art(1), .59, .27, .34, .285, { rad: r }); c.img(c.art(2), .59, .585, .34, .285, { rad: r });
    if (items[0]) c.txt(items[0], .09, .8, .46, 28, { wt: 700, c: '#FFFFFF', up: false, bg: '#00000066', pad: 10, rad: 10, w: c.X(.3) });
  }
};
LAYV.gallery.default = LAYV.gallery.row;
