    const e = c.title(d.text || d.title, .12, .34, .76, 84, { a: 'center', lh: 1.1 }); R.fitInto(e, c.Y(.42), 36); e.y = Math.round(c.Y(.5) - e.h / 2 + c.Y(.03)); c.box('rect', .46, .86, .08, .008, th.ac);
  },
