VOICE.speaking = false;
VOICE.voice = () => { const vs = (window.speechSynthesis && speechSynthesis.getVoices()) || []; return vs.find(v => /^it/i.test(v.lang) && /google|natural|premium|elsa|isabella/i.test(v.name)) || vs.find(v => /^it/i.test(v.lang)) || null; };
