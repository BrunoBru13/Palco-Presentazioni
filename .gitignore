};

/* ---------- finestre ---------- */
VID.fmt = s => `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}`;
VID.dialog = (deck) => {
  if (!VID.supported()) { toast('Per creare il video serve un browser recente (Chrome, Edge o Safari aggiornati).', { type: 'err', ms: 4500 }); return; }
  if (typeof ED !== 'undefined' && ED.active && ED.editing) ED.endEdit();
  const o = { sec: 5, res: Math.min(deck.w, deck.h) >= 1080 ? 1080 : 720, tr: 'fade', anim: true, music: 'calma' };
  const info = h('p.hint2');
  const upd = () => { const d = deck.slides.length * o.sec; info.textContent = `Durata del video: ${VID.fmt(d)} · ${VID.size(deck, o.res).W}×${VID.size(deck, o.res).H} px · circa ${Math.max(1, Math.round(d * (o.res >= 1080 ? .35 : .22) + (o.music ? d * .016 : 0)))} MB`; };
  const seg = (key, items, label) => h('div.bopt', h('span', label), h('div.segs', items.map(([v, l]) => h('button.sg' + (o[key] === v ? '.on' : ''), { onclick: e => { o[key] = v; $$('.sg', e.currentTarget.parentNode).forEach(x => x.classList.toggle('on', x === e.currentTarget)); upd(); } }, l))));
  const body = h('div.form',
    h('p.mtext', 'Trasforma la presentazione in un video MP4 da mettere sui social, in una chat o su uno schermo. Le pagine scorrono da sole, con le animazioni e una musica creata al momento.'),
    seg('sec', [[3, '3 s'], [5, '5 s'], [8, '8 s'], [12, '12 s'], [20, '20 s']], 'Secondi per pagina'),
    seg('tr', [['fade', 'Dissolvenza'], ['slide', 'Scorrimento'], ['zoom', 'Zoom'], ['auto', 'Come impostate'], ['none', 'Nessuna']], 'Passaggio tra le pagine'),
    seg('music', VID.MOODS, 'Musica di sottofondo'),
    seg('res', [[720, 'HD 720p'], [1080, 'Full HD 1080p']], 'Qualità'),
    h('label.chk', h('input', { type: 'checkbox', checked: true, onchange: e => { o.anim = e.target.checked; } }), 'Anima gli elementi che hanno un’animazione di entrata'),
    info);
  upd();
  const m = UI.modal('Crea un video', body, { cls: 'wide2', foot: [h('span.grow'), h('button.btn', { onclick: () => m.close() }, 'Annulla'), h('button.btn.primary', { onclick: () => { m.close(); VID.run(deck, o); } }, icn('film', 16), 'Crea il video')] });
};
VID.run = async (deck, o) => {
  const bar = h('i'), msg = h('p.mtext', 'Preparo…');
  const ui = { cancelled: false, set: (p, t) => { bar.style.width = Math.round(p * 100) + '%'; if (t) msg.textContent = t; } };
  const m = UI.modal('Sto creando il video', h('div.form', msg, h('div.vprog', bar), h('p.hint2', 'Tieni aperta questa pagina finché non è pronto: tutto avviene sul tuo computer.')), { cls: 'small', onclose: () => { ui.cancelled = true; }, foot: [h('span.grow'), h('button.btn', { onclick: () => m.close() }, 'Annulla')] });
  let res = null;
  try { res = await VID.encode(deck, o, ui); }
  catch (e) { console.warn(e); ui.cancelled = true; m.close(); toast(e && e.message === 'codec' ? 'Questo browser non riesce a codificare il video: prova con Chrome o Edge.' : 'Non sono riuscito a creare il video', { type: 'err', ms: 4500 }); return; }
  ui.cancelled = true; m.close();
  if (!res) return;
  const url = URL.createObjectURL(res.blob), mb = (res.blob.size / 1048576).toFixed(1), name = EX.safeName(deck) + '.mp4';
  const vid = h('video.vplayer', { src: url, controls: true, playsinline: true, preload: 'metadata' });
  vid.addEventListener('error', () => { vid.hidden = true; });
  const done = UI.modal('Il video è pronto', h('div.form', vid, h('p.hint2', `${VID.fmt(res.secs)} · ${res.W}×${res.H} px · ${mb} MB${res.wantedAudio && !res.audio ? ' · questo browser non codifica l’audio: video senza musica' : ''}`)), {
    cls: 'wide2', onclose: () => URL.revokeObjectURL(url),
    foot: [h('span.grow'), h('button.btn', { onclick: () => done.close() }, 'Chiudi'), h('button.btn.primary', { onclick: async () => { if (await ST.saveFile(name, res.blob)) toast('Video salvato', { icon: 'check' }); } }, icn('download', 16), 'Scarica MP4')]
  });
  VID.last = res;
};

/* ============ Modalità presentazione ============ */
var PR = { on: false };
PR.start = (deck, i = 0) => {
  if (PR.on) return;
  if (typeof ED !== 'undefined' && ED.active && ED.editing) ED.endEdit();
  PR.deck = deck; PR.i = clamp(i, 0, deck.slides.length - 1); PR.on = true; PR.laser = false; PR.notes = false; PR.cur = null;
  const root = h('div#present.present', { tabindex: '-1' },
    h('div.pr-layer'), h('div.pr-laser'),
    h('div.pr-notes', { hidden: true }),
    h('div.pr-bar',
      h('button.pbtn', { 'aria-label': 'Pagina precedente', onclick: e => { e.stopPropagation(); PR.go(PR.i - 1); } }, icn('chevL', 22)),
      h('span.pr-count'),
      h('button.pbtn', { 'aria-label': 'Pagina successiva', onclick: e => { e.stopPropagation(); PR.next(); } }, icn('chevR', 22)),
      h('span.pbsep'),
      h('button.pbtn#pr-n', { title: 'Note (N)', 'aria-label': 'Note', onclick: e => { e.stopPropagation(); PR.toggleNotes(); } }, icn('note', 20)),
      h('button.pbtn#pr-l', { title: 'Puntatore laser (L)', 'aria-label': 'Puntatore laser', onclick: e => { e.stopPropagation(); PR.toggleLaser(); } }, icn('pointer', 20)),
      h('button.pbtn', { title: 'Esci (Esc)', 'aria-label': 'Esci dalla presentazione', onclick: e => { e.stopPropagation(); PR.stop(); } }, icn('x', 22))));
  document.body.appendChild(root);
  PR.root = root; PR.layer = root.firstChild;
  root.addEventListener('click', e => { if (e.target.closest('.pop,.modal,#toasts')) return; PR.next(); });
  root.addEventListener('pointermove', PR.onMove);
  root.addEventListener('touchstart', e => { PR.tx = e.touches[0].clientX; }, { passive: true });
  root.addEventListener('touchend', e => { const dx = e.changedTouches[0].clientX - PR.tx; if (Math.abs(dx) > 50) { e.preventDefault(); dx < 0 ? PR.next() : PR.go(PR.i - 1); } });
  document.addEventListener('keydown', PR.onKey, true);
  window.addEventListener('resize', PR.fit);
  try { root.requestFullscreen && root.requestFullscreen().catch(() => { }); } catch (e) { }
  document.addEventListener('fullscreenchange', PR.onFs);
  root.focus();
  PR.fly = !!(deck.fly && deck.fly.on && deck.slides.length > 1); PR.camStep = 0; PR.world = null;
  if (PR.fly) PR.buildWorld();
  PR.show(PR.i, 0, true);
  PR.wake();
};
PR.onFs = () => { if (PR.on && !document.fullscreenElement && PR._wasFs) PR.stop(); if (document.fullscreenElement) PR._wasFs = true; };
PR.stop = () => {
  if (!PR.on) return; PR.on = false; PR._wasFs = false;
  document.removeEventListener('keydown', PR.onKey, true); window.removeEventListener('resize', PR.fit); document.removeEventListener('fullscreenchange', PR.onFs);
  if (document.fullscreenElement) document.exitFullscreen().catch(() => { });
  PR.root.remove();
  if (typeof ED !== 'undefined' && ED.active) { ED.goto(PR.i); }
};
PR.scale = () => Math.min(innerWidth / PR.deck.w, innerHeight / PR.deck.h);
PR.place = (n) => {
  const k = PR.scale(), D = PR.deck;
  n.style.cssText = `width:${D.w}px;height:${D.h}px;left:${(innerWidth - D.w * k) / 2}px;top:${(innerHeight - D.h * k) / 2}px;transform:scale(${k})`;
};
PR.fit = () => { $$('.pr-slide', PR.root).forEach(PR.place); };
PR.show = (i, dir, first) => {
  if (PR.fly) return PR.flyShow(i, dir, first);
  const D = PR.deck, s = D.slides[i], tr = first ? 'none' : (s.tr || 'none');
  const wrap = h('div.pr-slide'); const sl = R.slide(s, D, { anim: true, idx: i }); sl.style.position = 'absolute'; sl.style.left = sl.style.top = '0'; wrap.appendChild(sl);
  PR.place(wrap);
  // animazioni degli elementi, in sequenza
  let delay = .25;
  $$('.el[data-an]', sl).forEach(el => { delay = R.playIn(el, delay); });
  const old = PR.cur;
  wrap.classList.add('tr-' + tr + (dir < 0 ? '-r' : '') + '-in');
  if (old) { old.classList.add('tr-' + tr + (dir < 0 ? '-r' : '') + '-out'); setTimeout(() => old.remove(), tr === 'none' ? 0 : 560); }
  PR.layer.appendChild(wrap); PR.cur = wrap; PR.i = i;
  $('.pr-count', PR.root).textContent = `${i + 1} / ${D.slides.length}`;
  const nt = $('.pr-notes', PR.root); nt.textContent = s.notes || 'Nessuna nota per questa pagina.';
};
PR.go = (i) => {
  if (PR.busy || i < 0 || i >= PR.deck.slides.length || i === PR.i) return;
  const outs = PR.cur && !PR.fly ? $$('.el[data-ao]', PR.cur).filter(n => n.dataset.ao && R.playOut(n)) : [];
  const dir = i > PR.i ? 1 : -1;
  if (!outs.length) return PR.show(i, dir);
  PR.busy = true; setTimeout(() => { PR.busy = false; PR.show(i, dir); }, 520);
};
PR.next = () => { if (PR.busy) return; if (PR.i >= PR.deck.slides.length - 1) return PR.stop(); PR.go(PR.i + 1); };
PR.toggleNotes = () => { PR.notes = !PR.notes; $('.pr-notes', PR.root).hidden = !PR.notes; $('#pr-n').classList.toggle('on', PR.notes); };
PR.toggleLaser = () => { PR.laser = !PR.laser; PR.root.classList.toggle('laser', PR.laser); $('#pr-l').classList.toggle('on', PR.laser); };
PR.wake = () => { PR.root.classList.remove('idle'); clearTimeout(PR._t); PR._t = setTimeout(() => PR.root && PR.root.classList.add('idle'), 2600); };
PR.onMove = e => { PR.wake(); if (PR.laser) { const l = $('.pr-laser', PR.root); l.style.transform = `translate(${e.clientX}px,${e.clientY}px)`; } };
PR.onKey = e => {
  if (!PR.on) return;
  const k = e.key;
  const stop = () => { e.preventDefault(); e.stopPropagation(); };
  if (k === 'Escape') { stop(); PR.stop(); }
  else if (['ArrowRight', 'ArrowDown', 'PageDown', ' ', 'Enter'].includes(k)) { stop(); PR.next(); }
  else if (['ArrowLeft', 'ArrowUp', 'PageUp', 'Backspace'].includes(k)) { stop(); PR.go(PR.i - 1); }
  else if (k === 'Home') { stop(); PR.go(0); }
  else if (k === 'End') { stop(); PR.go(PR.deck.slides.length - 1); }
  else if (k === 'l' || k === 'L') { stop(); PR.toggleLaser(); }
  else if (k === 'n' || k === 'N') { stop(); PR.toggleNotes(); }
  PR.wake();
};

/* ============ Presentazione magica: effetti, suoni, timer, penna, vista relatore, riproduzione automatica ============ */
PR.parts = []; PR.raf = null;
PR.area = () => PR.speaker ? { x: 0, y: 0, w: innerWidth * .64, h: innerHeight } : { x: 0, y: 0, w: innerWidth, h: innerHeight };
PR.scale = () => { const a = PR.area(); return Math.min(a.w / PR.deck.w, a.h / PR.deck.h); };
PR.place = (n) => {
  const a = PR.area(), D = PR.deck, k = PR.scale();
  n.style.cssText = `width:${D.w}px;height:${D.h}px;left:${a.x + (a.w - D.w * k) / 2}px;top:${a.y + (a.h - D.h * k) / 2}px;transform:scale(${k})`;
};

/* ---- suoni ---- */
PR.ac = () => { if (!PR._ac) { try { PR._ac = new (window.AudioContext || window.webkitAudioContext)(); } catch (e) { return null; } } if (PR._ac.state === 'suspended') PR._ac.resume(); return PR._ac; };
PR.noise = (a, secs) => { const b = a.createBuffer(1, a.sampleRate * secs, a.sampleRate), d = b.getChannelData(0); for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1; const s = a.createBufferSource(); s.buffer = b; return s; };
PR.chime = () => { const a = PR.ac(); if (!a) return; [523.25, 659.25, 783.99, 1046.5].forEach((f, i) => { const o = a.createOscillator(), g = a.createGain(), t = a.currentTime + i * .09; o.type = 'triangle'; o.frequency.value = f; g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(.2, t + .02); g.gain.exponentialRampToValueAtTime(.001, t + .7); o.connect(g).connect(a.destination); o.start(t); o.stop(t + .75); }); };
PR.crash = () => { const a = PR.ac(); if (!a) return; const s = PR.noise(a, 1.6), f = a.createBiquadFilter(), g = a.createGain(); f.type = 'highpass'; f.frequency.value = 4500; g.gain.setValueAtTime(.5, a.currentTime); g.gain.exponentialRampToValueAtTime(.001, a.currentTime + 1.5); s.connect(f).connect(g).connect(a.destination); s.start(); };
PR.pop = () => { const a = PR.ac(); if (!a) return; const o = a.createOscillator(), g = a.createGain(); o.frequency.setValueAtTime(600, a.currentTime); o.frequency.exponentialRampToValueAtTime(150, a.currentTime + .12); g.gain.setValueAtTime(.2, a.currentTime); g.gain.exponentialRampToValueAtTime(.001, a.currentTime + .14); o.connect(g).connect(a.destination); o.start(); o.stop(a.currentTime + .15); };
PR.boom = () => { const a = PR.ac(); if (!a) return; const o = a.createOscillator(), g = a.createGain(); o.type = 'sine'; o.frequency.setValueAtTime(140, a.currentTime); o.frequency.exponentialRampToValueAtTime(35, a.currentTime + .35); g.gain.setValueAtTime(.35, a.currentTime); g.gain.exponentialRampToValueAtTime(.001, a.currentTime + .4); o.connect(g).connect(a.destination); o.start(); o.stop(a.currentTime + .45); };
PR.beep = (n = 3) => { const a = PR.ac(); if (!a) return; for (let i = 0; i < n; i++) { const o = a.createOscillator(), g = a.createGain(), t = a.currentTime + i * .28; o.type = 'square'; o.frequency.value = 880; g.gain.setValueAtTime(.08, t); g.gain.setValueAtTime(0, t + .16); o.connect(g).connect(a.destination); o.start(t); o.stop(t + .2); } };

/* ---- particelle ---- */
PR.fxCanvas = () => {
  let c = $('.pr-fx', PR.root);
  if (!c) { c = h('canvas.pr-fx'); PR.root.insertBefore(c, $('.pr-bar', PR.root)); }
  if (c.width !== innerWidth || c.height !== innerHeight) { c.width = innerWidth; c.height = innerHeight; }
  return c;
};
PR.fxAdd = (arr) => { PR.parts.push(...arr); if (!PR.raf) PR.raf = requestAnimationFrame(PR.fxTick); };
PR.fxTick = () => {
  if (!PR.on) { PR.raf = null; PR.parts = []; return; }
  const c = PR.fxCanvas(), x = c.getContext('2d');
  x.clearRect(0, 0, c.width, c.height);
  PR.parts = PR.parts.filter(p => p.step(x, c));
  PR.raf = PR.parts.length ? requestAnimationFrame(PR.fxTick) : null;
  if (!PR.parts.length) x.clearRect(0, 0, c.width, c.height);
};
const FX_COLORS = ['#FF4D4D', '#FFB020', '#FFE14D', '#3DDC97', '#2B7FFF', '#9B5DE5', '#FF5DA2', '#FFFFFF'];
PR.confetti = (sound = true) => {
  const W = innerWidth, parts = [];
  for (let i = 0; i < 180; i++) {
    const side = i % 3, p = { x: side === 0 ? W * .1 : side === 1 ? W * .9 : Math.random() * W, y: side === 2 ? -20 : innerHeight * .85, vx: (side === 0 ? 1 : side === 1 ? -1 : 0) * (3 + Math.random() * 7) + (Math.random() - .5) * 3, vy: side === 2 ? 1 + Math.random() * 3 : -(8 + Math.random() * 10), rot: Math.random() * 6, vr: (Math.random() - .5) * .35, w: 7 + Math.random() * 8, h: 4 + Math.random() * 6, c: FX_COLORS[i % FX_COLORS.length], ph: Math.random() * 6 };
    p.step = (x, c) => { p.vy += .22; p.vx *= .992; p.x += p.vx; p.y += p.vy * .8; p.rot += p.vr; p.ph += .15; x.save(); x.translate(p.x, p.y); x.rotate(p.rot); x.scale(1, Math.cos(p.ph)); x.fillStyle = p.c; x.fillRect(-p.w / 2, -p.h / 2, p.w, p.h); x.restore(); return p.y < c.height + 30; };
    parts.push(p);
