                await render();
                const p = [mpt(ctm, 0, 0), mpt(ctm, 1, 0), mpt(ctm, 1, 1), mpt(ctm, 0, 1)], xs = p.map(q => q[0] * rs), ys = p.map(q => q[1] * rs);
                const bx = Math.max(0, Math.min(...xs)), by = Math.max(0, Math.min(...ys)), bw = Math.min(cv.width - bx, Math.max(...xs) - bx), bh = Math.min(cv.height - by, Math.max(...ys) - by);
                if (bw < 2 || bh < 2) return;
