R.pageNum = (slide, deck, o) => {
  const pn = deck.pn;
  if (!pn || !pn.on || !o || o.idx == null || (pn.skip && o.idx === 0)) return '';
  const txt = pn.fmt === 'nN' ? `${o.idx + 1} / ${deck.slides.length}` : String(o.idx + 1);
  const bg = typeof slide.bg === 'string' ? slide.bg : (slide.bg && slide.bg.g ? slide.bg.g[0] : '#222222');
  const col = pn.c || Col.readable(bg), v = pn.pos[0], hz = pn.pos[1], m = 40;
  const css = `${v === 't' ? 'top' : 'bottom'}:${m}px;${hz === 'l' ? 'left:' + m + 'px' : hz === 'r' ? 'right:' + m + 'px' : 'left:0;right:0;text-align:center'}`;
  return `<div class="pn" style="position:absolute;${css};font:600 ${pn.s || 28}px ${fontStack('Plus Jakarta Sans')};color:${col};opacity:.75;pointer-events:none;z-index:50">${txt}</div>`;
};
R.slideInner = (slide, deck, o) => slide.els.filter(e => !e.hd).map(e => R.elHTML(e, deck, o)).join('') + R.pageNum(slide, deck, o);
R.slide = (slide, deck, o = {}) => {
  const el = document.createElement('div');
  el.className = 'sl';
  el.style.cssText = `width:${deck.w}px;height:${deck.h}px;background:${R.bgCss(slide.bg)}`;
  el.innerHTML = R.slideInner(slide, deck, o);
  return el;
};

/* ---- miniature scalate ---- */
R._ro = null;
R.thumb = (slide, deck, o = {}) => {
  const box = h('div.thumb', { style: { aspectRatio: `${deck.w}/${deck.h}` } });
  const inner = R.slide(slide, deck, o);
  box.appendChild(inner);
  if (!R._ro) R._ro = new ResizeObserver(es => es.forEach(en => { const t = en.target, k = en.contentRect.width / (+t.dataset.sw || 1920); t.style.setProperty('--k', k); }));
  box.dataset.sw = deck.w;
  R._ro.observe(box);
  return box;
};

/* ---- misura dell'altezza del testo (per i generatori) ---- */
R.measure = (e) => {
  let host = $('#measure');
  if (!host) { host = h('div#measure', { 'aria-hidden': 'true' }); document.body.appendChild(host); }
  host.innerHTML = `<div class="el el-text" style="position:absolute;left:0;top:0;width:${e.w}px;"><div class="tx" style="${R.textCss(e)}">${R.textInner(e)}</div></div>`;
  return Math.ceil(host.firstChild.offsetHeight);
};
R.fitHeight = e => { e.h = R.measure(e); return e; };
/* riduce il corpo del testo finché sta nell'altezza indicata */
R.fitInto = (e, maxH, minS = 22) => {
  e.h = R.measure(e);
  let guard = 40;
  while (e.h > maxH && e.s > minS && guard--) { e.s = Math.max(minS, Math.round(e.s * .92)); e.h = R.measure(e); }
  return e;
};

/* ============ Generatore di pagine a partire dai temi ============ */
const TP = { themes: [], topics: {} };
TP.get = id => TP.themes.find(t => t.id === id) || TP.themes[0];

TP.ctx = (th, W, H) => {
  const X = v => Math.round(v * W), Y = v => Math.round(v * H), S = v => Math.round(v * H / 1080);
  const c = { W, H, X, Y, S, th, els: [], bg: th.bg };
  c.add = e => { c.els.push(e); return e; };
  c.txt = (str, x, y, w, size, o = {}) => {
    const e = M.text({ text: Array.isArray(str) ? '' : str, x: X(x), y: Y(y), w: X(w), s: S(size), f: th.fb, c: th.fg, lh: 1.28, ...o });
    if (Array.isArray(str)) e.paras = str;
    R.fitHeight(e); return c.add(e);
  };
  c.title = (str, x, y, w, size, o = {}) => c.txt(str, x, y, w, size, { f: th.fd, wt: th.wd, up: th.up, lh: th.lhd || 1.08, ls: th.lsd || 0, ...o });
  c.box = (k, x, y, w, hh, f, o = {}) => c.add(M.shape(k, { x: X(x), y: Y(y), w: X(w), h: Y(hh), f, ...o }));
  c.circ = (cx, cy, r, f, o = {}) => { const d = Math.round(r * 2 * H); return c.add(M.shape('ellipse', { x: Math.round(cx * W - d / 2), y: Math.round(cy * H - d / 2), w: d, h: d, f, ...o })); };
  c.img = (src, x, y, w, hh, o = {}) => c.add(M.image(src, { x: X(x), y: Y(y), w: X(w), h: Y(hh), ...o }));
  c.card = (x, y, w, hh, o = {}) => c.add(M.shape('round', { x: X(x), y: Y(y), w: X(w), h: Y(hh), f: th.card, rad: S(th.rad), st: th.cardStroke ? { c: th.cardStroke, w: S(6), d: 0 } : null, sh: th.cardSh || 0, ...o }));
  c.vcenter = (e, cy) => { e.y = Math.round(cy - e.h / 2); return e; };
  return c;
};

const head = (c, text, y = .085) => {
  const th = c.th;
  if (th.tdeco === 'bar') c.box('rect', .07, y - .028, .06, .009, th.ac);
  if (th.tdeco === 'dot') c.circ(.078, y + .05, .014, th.ac);
  const t = c.title(text, th.tdeco === 'dot' ? .1 : .07, y, th.tdeco === 'dot' ? .82 : .86, 64);
  if (th.tdeco === 'rule') c.box('rect', .07, y + t.h / c.H + .03, .86, .003, th.fg, { o: .22 });
  return t;
};
const bulletParas = list => list.map(t => ({ r: [{ t }], l: 'b' }));

const LAY = {};
LAY.cover = (c, d) => c.th.cover(c, d);
LAY.thanks = (c, d) => c.th.cover(c, { title: d.title || 'Grazie.', sub: d.sub || '', tag: d.tag || '' });

LAY.agenda = (c, d) => {
  const th = c.th; head(c, d.title || 'Agenda');
  const items = d.items.slice(0, 6), n = items.length, step = Math.min(.125, .62 / n), dia = c.S(82);
  items.forEach((t, k) => {
    const y = .3 + k * step;
    c.add(M.shape('ellipse', { x: c.X(.07), y: c.Y(y), w: dia, h: dia, f: th.ac }));
    const nm = c.txt(String(k + 1), 0, 0, 0.1, 34, { f: th.fd, wt: th.wd, c: Col.readable(typeof th.ac === 'string' ? th.ac : '#000'), a: 'center' });
    nm.x = c.X(.07); nm.w = dia; R.fitHeight(nm); c.vcenter(nm, c.Y(y) + dia / 2);
    const tx = c.txt(t, .155, 0, .46, 38, { wt: 600 });
    c.vcenter(tx, c.Y(y) + dia / 2);
  });
  c.img(th.artRef, .69, .27, .24, .6, { rad: c.S(th.rad) });
};

LAY.section = (c, d) => {
  const th = c.th, fg = th.secFg || Col.readable(c.bg);
  c.txt(d.n || '01', .06, .02, .6, 440, { f: th.fd, wt: th.wd, c: fg, o: .16, lh: 1 });
  const t = c.title(d.title, .07, .5, .72, 112, { c: fg });
  t.y = c.Y(.8) - t.h;
  if (d.sub) c.txt(d.sub, .07, (t.y + t.h) / c.H + .03, .6, 36, { c: fg, o: .85 });
};

LAY.bullets = (c, d) => {
  const th = c.th; head(c, d.title);
  const hasArt = d.art !== false;
  const e = c.txt(bulletParas(d.items), .07, .3, hasArt ? .54 : .84, 40, { ps: .55, bc: th.ac });
  R.fitInto(e, c.Y(.6), 24);
  if (hasArt) {
    c.img(th.artRef, .66, .27, .27, .6, { rad: c.S(th.rad) });
  }
};

LAY.twocol = (c, d) => {
  const th = c.th; head(c, d.title);
  d.cols.slice(0, 2).forEach((col, k) => {
    const x = .07 + k * .44;
    c.card(x, .28, .42, .6);
    c.txt(col.h, x + .03, .32, .36, 38, { f: th.fd, wt: th.wd, up: false, c: th.ac, lh: 1.15 });
    const e = c.txt(bulletParas(col.items), x + .03, .43, .36, 30, { ps: .5, bc: th.ac, c: th.cardFg || th.fg });
    R.fitInto(e, c.Y(.42), 20);
  });
};

LAY.imgtext = (c, d, i) => {
  const th = c.th, left = (i || 0) % 2 === 0;
  c.img(th.artRef, left ? 0 : .5, 0, .5, 1, {});
  const x = left ? .56 : .07;
  const t = c.title(d.title, x, .16, .38, 58);
  const body = c.txt(d.text, x, (t.y + t.h) / c.H + .035, .37, 32, { c: th.fg, o: .88 });
  R.fitInto(body, c.Y(.78) - body.y, 22);
  if (d.items) {
    const l = c.txt(bulletParas(d.items), x, (body.y + body.h) / c.H + .03, .37, 30, { ps: .4, bc: th.ac });
    R.fitInto(l, c.Y(.9) - l.y, 20);
  }
};

LAY.stats = (c, d) => {
  const th = c.th; head(c, d.title);
  const st = d.stats.slice(0, 4), n = st.length, gap = .03, w = (.86 - gap * (n - 1)) / n;
  st.forEach((s, k) => {
    const x = .07 + k * (w + gap);
    c.card(x, .3, w, .52);
    const v = c.txt(s.v, x + .025, .36, w - .05, n > 3 ? 100 : 130, { f: th.fd, wt: th.wd, c: th.ac, lh: 1, ls: -.02, up: false });
    c.box('rect', x + .025, (v.y + v.h) / c.H + .02, .05, .006, th.fg, { o: .35 });
    c.txt(s.l, x + .025, (v.y + v.h) / c.H + .055, w - .05, 30, { c: th.cardFg || th.fg });
  });
};

LAY.quote = (c, d) => {
  const th = c.th;
  c.txt('“', .07, .0, .2, 520, { f: th.fd, wt: th.wd, c: th.ac, lh: 1, up: false });
  const q = c.txt(d.quote, .13, .3, .74, 58, { f: th.qf || th.fd, wt: th.qw || 500, up: false, lh: 1.22, i: !!th.qi });
  R.fitInto(q, c.Y(.4), 32);
  const y = (q.y + q.h) / c.H + .05;
  c.box('rect', .13, y, .05, .006, th.ac);
  c.txt(d.author, .13, y + .03, .6, 32, { wt: 700 });
  if (d.role) c.txt(d.role, .13, y + .03 + .06, .6, 26, { c: th.mute });
};

LAY.timeline = (c, d) => {
  const th = c.th; head(c, d.title);
  const st = d.steps.slice(0, 5), n = st.length, w = .86 / n;
  c.box('rect', .07, .43, .86, .006, th.mute, { o: .5 });
  const dia = c.S(76);
  st.forEach((s, k) => {
    const x = .07 + k * w;
    c.add(M.shape('ellipse', { x: c.X(x), y: c.Y(.43) + 3 - dia / 2, w: dia, h: dia, f: th.ac }));
    const nm = c.txt(String(k + 1), 0, 0, .1, 32, { f: th.fd, wt: th.wd, c: Col.readable(typeof th.ac === 'string' ? th.ac : '#000'), a: 'center', up: false });
    nm.x = c.X(x); nm.w = dia; R.fitHeight(nm); c.vcenter(nm, c.Y(.43) + 3);
    c.txt(s.t, x, .53, w - .02, 34, { f: th.fd, wt: th.wd, up: false, lh: 1.15 });
    const e = c.txt(s.d, x, .62, w - .035, 26, { c: th.fg, o: .8 });
    R.fitInto(e, c.Y(.3), 18);
  });
};

LAY.team = (c, d) => {
  const th = c.th; head(c, d.title);
  const ps = d.people.slice(0, 4), n = ps.length, w = .86 / n, dia = c.S(250);
  ps.forEach((p, k) => {
    const cx = (.07 + k * w + w / 2) * c.W;
    c.add(M.shape('ellipse', { x: Math.round(cx - dia / 2), y: c.Y(.3), w: dia, h: dia, f: [th.ac, th.ac2, th.ac3][k % 3] }));
    const ico = Math.round(dia * .52);
    c.add(M.shape('icon:person', { x: Math.round(cx - ico / 2), y: c.Y(.3) + Math.round((dia - ico) / 2), w: ico, h: ico, f: Col.readable([th.ac, th.ac2, th.ac3][k % 3]) }));
    c.txt(p.n, 0, .3 + .27, w - .02, 38, { wt: 700, a: 'center', x: Math.round(cx - (w - .02) * c.W / 2), f: th.fd, up: false });
    c.txt(p.r, 0, .3 + .34, w - .02, 28, { a: 'center', c: th.mute, x: Math.round(cx - (w - .02) * c.W / 2) });
  });
};

LAY.chart = (c, d) => {
  const th = c.th; head(c, d.title);
  c.card(.07, .27, .56, .62);
  c.add(M.chart({
    x: c.X(.085), y: c.Y(.3), w: c.X(.53), h: c.Y(.56), k: d.kind || 'bar', labels: d.labels, series: d.series,
    colors: [th.ac, th.ac2, th.ac3, th.mute], tc: th.cardFg || th.fg, f: th.fb, fs: c.S(26), bgc: typeof th.card === 'string' ? th.card : '#FFFFFF'
  }));
  c.box('round', .66, .27, .27, .62, th.ac, { rad: c.S(th.rad) });
  const fg = Col.readable(typeof th.ac === 'string' ? th.ac : '#000');
  c.txt(d.big || '+38%', .685, .33, .22, 110, { f: th.fd, wt: th.wd, c: fg, up: false, lh: 1, ls: -.02 });
  const e = c.txt(d.note || 'Crescita rispetto all’anno precedente.', .685, .52, .22, 30, { c: fg });
  R.fitInto(e, c.Y(.3), 20);
};

/* Costruzione di una pagina */
TP.slide = (th, kind, d, W, H, idx) => {
  const c = TP.ctx(th, W, H);
  c.bg = kind === 'section' ? (th.secBg || th.ac) : th.bg;
  if (th.deco) th.deco(c, kind, idx);
  LAY[kind](c, d, idx);
  const s = M.newSlide(c.bg);
  s.els = c.els; s.tr = th.tr || 'fade'; s.notes = d.notes || '';
  return s;
};
TP.ORDER = ['cover', 'agenda', 'section', 'bullets', 'twocol', 'imgtext', 'stats', 'chart', 'quote', 'timeline', 'team', 'thanks'];
TP.KIND_NAMES = { cover: 'Copertina', agenda: 'Agenda', section: 'Sezione', bullets: 'Elenco puntato', twocol: 'Due colonne', imgtext: 'Immagine e testo', stats: 'Numeri chiave', chart: 'Grafico', quote: 'Citazione', timeline: 'Percorso', team: 'Team', thanks: 'Chiusura' };

TP.topicData = (th) => {
  const t = TP.topics[th.topic] || TP.topics.startup;
  return t;
};
TP.sampleData = (th, kind) => TP.topicData(th)[kind];

/* Presentazione completa di esempio per un tema */
TP.build = (themeId, o = {}) => {
  const th = TP.get(themeId), W = o.w || 1920, H = o.h || 1080, topic = TP.topicData(th);
  const slides = TP.ORDER.map((k, i) => TP.slide(th, k, topic[k], W, H, i));
  return M.newDeck({ name: o.name || topic.name || th.name, w: W, h: H, theme: th.id, slides });
};
/* Una sola pagina di un certo tipo con il contenuto di esempio */
TP.sample = (themeId, kind, W = 1920, H = 1080, idx = 0) => {
  const th = TP.get(themeId);
  return TP.slide(th, kind, TP.sampleData(th, kind), W, H, idx);
};

/* Da una scaletta (JSON dell'IA o testo) a una presentazione */
/* Tema personalizzato (disegnato dall'IA): parte da uno stile di base e ne cambia colori e font */
TP.custom = (def, id) => {
  const base = TP.themes.find(t => t.id === (def && def.base) && !t.hidden) || TP.themes.find(t => t.id === 'minimale');
  const th = { ...base };
  const hex = v => { const c = Col.parse(v); return c && /^#[0-9A-F]{6}$/.test(c) ? c : null; };
  ['bg', 'fg', 'mute', 'ac', 'ac2', 'ac3', 'card'].forEach(k => { const c = hex(def && def[k]); if (c) th[k] = c; });
  if (!hex(def && def.card)) th.card = Col.mix(th.bg, th.fg, Col.lum(th.bg) < .4 ? .12 : .06);
  if (!hex(def && def.mute)) th.mute = Col.mix(th.fg, th.bg, .42);
  if (Math.abs(Col.lum(th.fg) - Col.lum(th.bg)) < .4) th.fg = Col.readable(th.bg);
  th.dark = Col.lum(th.bg) < .4; th.cardFg = null;
  if (FONT_MAP[def && def.fontTitle]) th.fd = def.fontTitle;
  if (FONT_MAP[def && def.fontBody]) th.fb = def.fontBody;
  if (th.fd !== base.fd) { th.wd = 700; th.up = false; if (['Bebas Neue', 'Anton', 'Archivo Black', 'DM Serif Display', 'Abril Fatface', 'Pacifico', 'Lobster', 'Permanent Marker'].includes(th.fd)) th.wd = 400; }
  delete th.secFg; delete th.secBg;
  if (base.cardStroke) th.cardStroke = Col.mix(th.card, th.fg, .25);
  th.id = id || uid('ai_'); th.name = (def && def.name) || 'Stile dell’IA'; th.hidden = true; th.custom = true; th.base = base.id;
  const sty = ['mesh', 'waves', 'blobs', 'peaks', 'rings', 'tiles'][(th.id.length * 7 + th.ac.charCodeAt(2)) % 6];
  const pal = [th.ac, th.ac2, th.card, th.bg].map(c => c.slice(1)).join('-');
  th.artRef = `g:${sty}:${pal}:4`; th.coverArt = `g:dots:${pal}:3`;
  th.def = { base: base.id, name: th.name, bg: th.bg, fg: th.fg, mute: th.mute, ac: th.ac, ac2: th.ac2, ac3: th.ac3, card: th.card, fontTitle: th.fd, fontBody: th.fb };
  return th;
};
TP.ensure = (deck) => {
  if (!deck.themeDef || TP.themes.some(t => t.id === deck.theme)) return;
  TP.themes.push(TP.custom(deck.themeDef, deck.theme));
};

/* Pagine di contenuto a partire da una scaletta */
TP.outlineSlides = (th, body, W, H, start = 0) => {
  const slides = [];
  const push = (k, d) => slides.push(TP.slide(th, k, d, W, H, start + slides.length));
  let sec = 0;
  body.forEach(s => {
    const items = (s.bullets || s.items || []).map(String).filter(Boolean);
    const kind = s.kind;
    if (kind === 'section') push('section', { n: String(++sec).padStart(2, '0'), title: s.title, sub: s.text || '' });
    else if (kind === 'stats' && s.stats && s.stats.length) push('stats', { title: s.title, stats: s.stats.map(x => ({ v: String(x.value || x.v || ''), l: String(x.label || x.l || '') })) });
    else if (kind === 'quote') push('quote', { quote: s.quote || s.title, author: s.author || '', role: s.role || '' });
    else if (kind === 'timeline' && s.steps && s.steps.length) push('timeline', { title: s.title, steps: s.steps.map(x => ({ t: String(x.title || x.t || ''), d: String(x.text || x.d || '') })) });
    else if (kind === 'twocol' && s.left && s.right) push('twocol', { title: s.title, cols: [s.left, s.right].map(x => ({ h: String(x.title || x.h || ''), items: (x.bullets || x.items || []).map(String) })) });
    else if (kind === 'chart' && s.labels && s.series) push('chart', { title: s.title, kind: s.chart || 'bar', labels: s.labels.map(String), series: s.series.map(x => ({ n: String(x.name || x.n || ''), v: (x.values || x.v || []).map(Number) })), big: s.big, note: s.note });
    else if (kind === 'imgtext' || (s.text && items.length < 2)) push('imgtext', { title: s.title, text: s.text || items.join(' '), items: s.text ? items : null });
    else push('bullets', { title: s.title, items: items.length ? items : [s.text || '…'] });
    if (s.notes) slides[slides.length - 1].notes = String(s.notes);
  });
  return slides;
};
TP.fromOutline = (themeId, ol, o = {}) => {
  const th = TP.get(themeId), W = o.w || 1920, H = o.h || 1080, slides = [];
  const T = TP.topicData(th);
  slides.push(TP.slide(th, 'cover', { title: ol.title || 'Nuova presentazione', sub: ol.subtitle || '', tag: ol.tag || T.cover.tag }, W, H, 0));
  const body = (ol.slides || []).filter(s => s && s.title);
  if (body.length >= 5) slides.push(TP.slide(th, 'agenda', { title: 'Di cosa parliamo', items: body.filter(s => s.kind !== 'section').slice(0, 6).map(s => s.title) }, W, H, 1));
  slides.push(...TP.outlineSlides(th, body, W, H, slides.length));
  slides.push(TP.slide(th, 'thanks', { title: ol.closing || 'Grazie.', sub: ol.contact || '' }, W, H, slides.length));
  const deck = M.newDeck({ name: ol.title || 'Nuova presentazione', w: W, h: H, theme: th.id, slides });
  if (th.custom) deck.themeDef = th.def;
  return deck;
};

/* ============ Varianti di layout: la composizione cambia in base allo scopo e al contenuto ============ */
const LAYV = {};
TP.runSeed = 0;
TP.VARIANTS = {
  bullets: ['side-art', 'cards', 'big-left', 'center', 'numbered', 'iconlist', 'split'],
  twocol: ['cards', 'vs', 'split-bg'],
  imgtext: ['alt', 'overlay', 'top', 'circle'],
  stats: ['cards', 'big', 'line', 'stack'],
  quote: ['left', 'center', 'split'],
  timeline: ['h', 'v', 'chevron', 'steps'],
  section: ['bignum', 'center', 'left', 'split'],
  chart: ['left', 'full', 'right'],
  statement: ['center', 'left', 'boxed'],
  gallery: ['row', 'mosaic'],
  agenda: ['list', 'cards']
};
const ICON_RULES = [[/ricav|vendit|euro|€|prezz|costo|budget|fattur|margin|guadagn/i, 'bars'], [/cresc|aument|trend|migliora|sviluppo|espans/i, 'trend'], [/team|person|client|utent|squadr|gente|student|famigli/i, 'person'], [/idea|innov|creativ|soluzion|impar|studio/i, 'bulb'], [/obiett|target|mira|goal|strateg|scopo|priorit/i, 'target'], [/temp|scadenz|ore |giorn|calendar|mese|anno|orari/i, 'clock'], [/global|mond|internaz|web|sito|online|rete/i, 'globe'], [/sicur|protez|privacy|dati|regol/i, 'lock'], [/rapid|veloc|energia|fulmin|subito/i, 'bolt'], [/mail|posta|contatt|scriv/i, 'mail'], [/telefon|chiam/i, 'phone'], [/dove|luogo|sede|posizion|mappa|viagg/i, 'pin'], [/amo|cuore|passione|cura|salute/i, 'heart'], [/qualit|migliore|stella|eccell|premio|success|risult/i, 'star'], [/lancio|milestone|fase|traguardo/i, 'flag'], [/fatto|complet|risolt|ok\b|verific/i, 'check']];
const ICON_CYCLE = ['check', 'bulb', 'target', 'star', 'bolt', 'trend'];
const iconFor = (txt, i, hint) => (hint && ICON_PATHS[hint]) ? hint : ((ICON_RULES.find(([re]) => re.test(txt)) || [])[1] || ICON_CYCLE[i % ICON_CYCLE.length]);
const colOf = v => typeof v === 'string' ? v : '#000000';

/* contesto: seme, immagini astratte variate, distintivi, linee */
TP._ctx0 = TP.ctx;
TP.ctx = (th, W, H) => {
  const c = TP._ctx0(th, W, H); c.seed = 0;
  c.art = (k = 0) => {
    const m = /^g:(\w+):([^:]+)(?::\d+)?$/.exec(th.artRef || 'g:mesh:0'), pal = m ? m[2] : '0';
    const style = ART_NAMES[(c.seed * 3 + k * 5 + (TP.runSeed % 7)) % ART_NAMES.length];
    return `g:${style}:${pal}:${(c.seed * 17 + k * 31 + TP.runSeed) % 90 + 1}`;
  };
  c.badge = (px, py, dia, label, fill, o = {}) => {
    c.add(M.shape('ellipse', { x: Math.round(px), y: Math.round(py), w: dia, h: dia, f: fill }));
    const t = c.txt(String(label), 0, 0, .1, o.size || 34, { f: th.fd, wt: th.wd, c: Col.readable(colOf(fill)), a: 'center', up: false });
    t.x = Math.round(px); t.w = dia; R.fitHeight(t); c.vcenter(t, py + dia / 2); return t;
  };
  c.icon = (name, px, py, dia, fill, o = {}) => {
    const ring = o.ring !== false;
    if (ring) c.add(M.shape('ellipse', { x: Math.round(px), y: Math.round(py), w: dia, h: dia, f: fill }));
    const s = Math.round(dia * (ring ? .52 : 1));
    c.add(M.shape('icon:' + name, { x: Math.round(px + (dia - s) / 2), y: Math.round(py + (dia - s) / 2), w: s, h: s, f: ring ? Col.readable(colOf(fill)) : fill }));
  };
  c.rule = (x, y, w, o = .22) => c.box('rect', x, y, w, .003, th.fg, { o });
  c.ink = (bg) => Col.readable(colOf(bg));
  return c;
};
TP.slide = (th, kind, d, W, H, idx) => {
  const c = TP.ctx(th, W, H);
  c.seed = idx || 0;
  if (TP.runSeed) c.th = Object.assign({}, th, { artRef: c.art() });
  c.bg = kind === 'section' ? (th.secBg || th.ac) : th.bg;
  if (th.deco) th.deco(c, kind, idx);
  LAY[kind](c, d, idx);
  const s = M.newSlide(c.bg);
  s.els = c.els; s.tr = th.tr || 'fade'; s.notes = d.notes || '';
  return s;
};
/* dispatcher: la variante scelta in d.layout, altrimenti quella di base */
const withVariants = (kind, def, table) => { LAYV[kind] = { default: def, ...table }; const base = LAY[kind]; LAY[kind] = (c, d, i) => ((LAYV[kind][d.layout]) || LAYV[kind].default)(c, d, i); return base; };
const ph = (c, y) => y; // segnaposto per leggibilità

/* ====================== ELENCHI PUNTATI ====================== */
const bulletsDefault = LAY.bullets, agendaDefault = LAY.agenda, imgDefault = LAY.imgtext, statsDefault = LAY.stats, quoteDefault = LAY.quote, timelineDefault = LAY.timeline, sectionDefault = LAY.section, chartDefault = LAY.chart, twocolDefault = LAY.twocol;
LAYV.bullets = {
  default: bulletsDefault, 'side-art': (c, d) => { const th = c.th; head(c, d.title); const e = c.txt(bulletParas(d.items), .07, .3, .54, 40, { ps: .55, bc: th.ac }); R.fitInto(e, c.Y(.6), 24); c.img(c.art(), .66, .27, .27, .6, { rad: c.S(th.rad) }); },
  cards: (c, d) => {
    const th = c.th; head(c, d.title); const items = d.items.slice(0, 6), n = items.length, cols = n <= 3 ? n : n === 4 ? 2 : 3, rows = Math.ceil(n / cols), gx = .025, x0 = .07, w = (.86 - gx * (cols - 1)) / cols, y0 = .3, hh = (.58 - .03 * (rows - 1)) / rows;
    items.forEach((t, k) => {
      const r = Math.floor(k / cols), cc = k % cols, x = x0 + cc * (w + gx), y = y0 + r * (hh + .03), dia = c.S(rows > 1 ? 54 : 70);
      c.card(x, y, w, hh); c.badge(c.X(x) + c.S(26), c.Y(y) + c.S(24), dia, k + 1, [th.ac, th.ac2, th.ac3][k % 3], { size: 30 });
      const ty = (c.Y(y) + c.S(24) + dia + c.S(14)) / c.H, e = c.txt(t, x + .02, ty, w - .04, rows > 1 ? 28 : 32, { c: th.cardFg || th.fg }); R.fitInto(e, c.Y(y + hh) - c.Y(ty) - c.S(18), 16);
    });
  },
  'big-left': (c, d) => {
    const th = c.th; c.box('rect', 0, 0, .4, 1, th.card); c.box('rect', .06, .2, .07, .01, th.ac);
    const t = c.title(d.title, .06, .26, .3, 66); R.fitInto(t, c.Y(.5), 40);
    const items = d.items.slice(0, 6), sz = items.length > 4 ? 32 : 38; let y = .15;
    items.forEach(it => { const e = c.txt(it, .47, y, .46, sz, {}); y += e.h / c.H + .035; c.rule(.47, y - .018, .46, .18); });
  },
  center: (c, d) => {
    const th = c.th; const t = c.title(d.title, .1, .11, .8, 70, { a: 'center' }); c.box('rect', .46, (t.y + t.h) / c.H + .03, .08, .008, th.ac);
    const items = d.items.slice(0, 5), sz = items.length > 4 ? 36 : 42; let y = (t.y + t.h) / c.H + .1;
    items.forEach((it, k) => { const e = c.txt(it, .14, y, .72, sz, { a: 'center', c: k % 2 ? th.fg : th.fg }); y += e.h / c.H + .035; if (k < items.length - 1) c.circ(.5, y - .012, .006, th.ac); });
  },
  numbered: (c, d) => {
    const th = c.th; head(c, d.title); const items = d.items.slice(0, 5), n = items.length, rh = Math.min(.14, .62 / n);
    items.forEach((t, k) => {
      const y = .29 + k * rh, num = c.txt(String(k + 1).padStart(2, '0'), .07, 0, .13, 78, { f: th.fd, wt: th.wd, c: th.ac, up: false, lh: 1 }); c.vcenter(num, c.Y(y + rh / 2 - .012));
      const e = c.txt(t, .21, 0, .7, 36, {}); R.fitInto(e, c.Y(rh) - 10, 20); c.vcenter(e, c.Y(y + rh / 2 - .012)); if (k < n - 1) c.rule(.07, y + rh - .012, .86, .16);
    });
  },
  iconlist: (c, d) => {
    const th = c.th; head(c, d.title); const items = d.items.slice(0, 5), n = items.length, rh = Math.min(.15, .62 / n), dia = c.S(Math.min(94, rh * 1080 * .74));
    items.forEach((t, k) => {
      const cy = c.Y(.3 + k * rh + rh / 2 - .012); c.icon(iconFor(t, k, d.icons && d.icons[k]), c.X(.07), cy - dia / 2, dia, [th.ac, th.ac2, th.ac3][k % 3]);
      const e = c.txt(t, .07 + dia / c.W + .025, 0, .7, 36, {}); R.fitInto(e, c.Y(rh) - 8, 20); c.vcenter(e, cy);
    });
  },
  split: (c, d) => {
    const th = c.th; c.box('rect', 0, 0, .46, 1, th.ac); const ink = c.ink(th.ac);
    const t = c.title(d.title, .06, .3, .35, 64, { c: ink }); R.fitInto(t, c.Y(.45), 36); c.box('rect', .06, (t.y + t.h) / c.H + .03, .08, .008, ink, { o: .7 });
    const e = c.txt(bulletParas(d.items.slice(0, 6)), .54, .22, .39, 38, { ps: .7, bc: th.ac }); R.fitInto(e, c.Y(.58), 22);
  }
};
LAY.bullets = (c, d, i) => ((LAYV.bullets[d.layout]) || LAYV.bullets.default)(c, d, i);

/* ====================== AGENDA ====================== */
LAYV.agenda = {
  default: agendaDefault, list: agendaDefault,
  cards: (c, d) => {
    const th = c.th; head(c, d.title || 'Agenda'); const items = d.items.slice(0, 6), n = items.length, cols = n <= 4 ? 2 : 3, rows = Math.ceil(n / cols), gx = .025, w = (.86 - gx * (cols - 1)) / cols, hh = (.58 - .03 * (rows - 1)) / rows;
    items.forEach((t, k) => { const r = Math.floor(k / cols), cc = k % cols, x = .07 + cc * (w + gx), y = .3 + r * (hh + .03); c.card(x, y, w, hh); c.txt(String(k + 1).padStart(2, '0'), x + .02, y + .04, .12, 60, { f: th.fd, wt: th.wd, c: th.ac, up: false, lh: 1 }); const e = c.txt(t, x + .02, y + .04 + .13, w - .04, 32, { wt: 600, c: th.cardFg || th.fg }); R.fitInto(e, c.Y(y + hh) - e.y - 16, 18); });
  }
};
LAY.agenda = (c, d, i) => ((LAYV.agenda[d.layout]) || LAYV.agenda.default)(c, d, i);

/* ====================== DUE COLONNE ====================== */
LAYV.twocol = {
  default: twocolDefault, cards: twocolDefault,
  vs: (c, d) => {
    const th = c.th; head(c, d.title);
    d.cols.slice(0, 2).forEach((col, k) => {
      const x = .07 + k * .47, fill = k ? th.ac2 : th.ac; c.box('round', x, .28, .39, .1, fill, { rad: c.S(60) });
      const h1 = c.txt(col.h, x, 0, .39, 34, { f: th.fd, wt: th.wd, up: false, c: c.ink(fill), a: 'center' }); c.vcenter(h1, c.Y(.33));
      const e = c.txt(bulletParas(col.items), x + .02, .43, .35, 32, { ps: .55, bc: fill, c: th.fg }); R.fitInto(e, c.Y(.42), 20);
    });
    c.circ(.5, .33, .045, th.fg); const vs = c.txt('VS', .45, 0, .1, 30, { a: 'center', f: th.fd, wt: th.wd, c: th.bg, up: false }); c.vcenter(vs, c.Y(.33)); c.box('rect', .499, .4, .002, .45, th.fg, { o: .15 });
  },
  'split-bg': (c, d) => {
    const th = c.th; c.box('rect', 0, 0, .5, 1, th.ac); const ink = c.ink(th.ac); const t = c.txt(d.title, .07, .07, .86, 30, { f: th.fd, wt: th.wd, up: true, ls: .12, c: th.fg, o: .8 });
    const a = d.cols[0] || { h: '', items: [] }, b = d.cols[1] || { h: '', items: [] };
    c.title(a.h, .07, .22, .38, 56, { c: ink }); const e1 = c.txt(bulletParas(a.items), .07, .46, .38, 32, { ps: .55, bc: ink, c: ink }); R.fitInto(e1, c.Y(.42), 20);
    c.title(b.h, .56, .22, .37, 56, { c: th.ac }); const e2 = c.txt(bulletParas(b.items), .56, .46, .37, 32, { ps: .55, bc: th.ac }); R.fitInto(e2, c.Y(.42), 20);
  }
};
LAY.twocol = (c, d, i) => ((LAYV.twocol[d.layout]) || LAYV.twocol.default)(c, d, i);

/* ====================== IMMAGINE E TESTO ====================== */
LAYV.imgtext = {
  default: imgDefault, alt: imgDefault,
  overlay: (c, d) => {
    const th = c.th; c.img(c.art(), 0, 0, 1, 1, {}); c.box('rect', 0, 0, 1, 1, '#000000', { o: .32 });
    const left = c.seed % 2 === 0, x = left ? .07 : .47; c.card(x, .18, .46, .64);
    const t = c.title(d.title, x + .035, .24, .39, 56, { c: th.cardFg || th.fg }); const b = c.txt(d.text, x + .035, (t.y + t.h) / c.H + .03, .39, 30, { c: th.cardFg || th.fg, o: .9 }); R.fitInto(b, c.Y(.78) - b.y, 20);
    if (d.items) { const l = c.txt(bulletParas(d.items), x + .035, (b.y + b.h) / c.H + .025, .39, 28, { ps: .4, bc: th.ac, c: th.cardFg || th.fg }); R.fitInto(l, c.Y(.79) - l.y, 18); }
  },
  top: (c, d) => {
    const th = c.th; c.img(c.art(), 0, 0, 1, .42, {}); const t = c.title(d.title, .07, .5, .4, 56); R.fitInto(t, c.Y(.34), 34);
    const b = c.txt(d.text, .55, .5, .38, 30, { o: .9 }); R.fitInto(b, c.Y(.26), 20);
    if (d.items) { const l = c.txt(bulletParas(d.items), .55, (b.y + b.h) / c.H + .02, .38, 28, { ps: .3, bc: th.ac }); R.fitInto(l, c.Y(.95) - l.y, 18); }
    c.box('rect', .07, .46, .06, .008, th.ac);
  },
  circle: (c, d) => {
    const th = c.th, left = c.seed % 2 === 0, x = left ? .08 : .56, dia = c.S(640);
    c.circ(left ? .08 + dia / 2 / c.W : .56 + dia / 2 / c.W, .5, dia / 2 / c.H, th.ac2, { o: .3 }); c.img(c.art(1), left ? .09 : .57, .5 - dia / 2 / c.H + .015, dia / c.W * .96, dia / c.H * .96, { mk: 'ellipse' });
    const tx = left ? .52 : .07, t = c.title(d.title, tx, .22, .4, 56); const b = c.txt(d.text, tx, (t.y + t.h) / c.H + .03, .38, 30, { o: .9 }); R.fitInto(b, c.Y(.8) - b.y, 20);
    if (d.items) { const l = c.txt(bulletParas(d.items), tx, (b.y + b.h) / c.H + .03, .38, 28, { ps: .3, bc: th.ac }); R.fitInto(l, c.Y(.92) - l.y, 18); }
  }
};
LAY.imgtext = (c, d, i) => ((LAYV.imgtext[d.layout]) || LAYV.imgtext.default)(c, d, i);

/* ====================== NUMERI ====================== */
LAYV.stats = {
  default: statsDefault, cards: statsDefault,
  big: (c, d) => {
    const th = c.th; head(c, d.title); const st = d.stats.slice(0, 4), first = st[0], rest = st.slice(1);
    const v = c.txt(first.v, .1, .2, .8, 250, { f: th.fd, wt: th.wd, c: th.ac, a: 'center', lh: 1, ls: -.03, up: false }); R.fitInto(v, c.Y(.38), 120);
    c.txt(first.l, .2, (v.y + v.h) / c.H + .0, .6, 38, { a: 'center' });
    const n = rest.length, w = n ? (.86 - .03 * (n - 1)) / n : 0;
    rest.forEach((s, k) => { const x = .07 + k * (w + .03); c.card(x, .76, w, .17); c.txt(s.v, x + .02, .775, w * .5, 48, { f: th.fd, wt: th.wd, c: th.ac, up: false, lh: 1 }); c.txt(s.l, x + w * .42, .79, w * .55, 22, { c: th.cardFg || th.fg }); });
  },
  line: (c, d) => {
    const th = c.th; head(c, d.title); const st = d.stats.slice(0, 4), n = st.length, w = .86 / n;
    st.forEach((s, k) => { const x = .07 + k * w; const v = c.txt(s.v, x, .34, w - .02, n > 3 ? 110 : 140, { f: th.fd, wt: th.wd, c: [th.ac, th.ac2, th.ac3][k % 3], a: 'center', up: false, lh: 1, ls: -.02 }); R.fitInto(v, c.Y(.2), 60); c.txt(s.l, x + .015, (v.y + v.h) / c.H + .02, w - .05, 30, { a: 'center' }); if (k) c.box('rect', x - .004, .34, .002, .38, th.fg, { o: .18 }); });
  },
  stack: (c, d) => {
    const th = c.th; head(c, d.title); const st = d.stats.slice(0, 4), n = st.length, rh = Math.min(.17, .62 / n);
    st.forEach((s, k) => { const y = .29 + k * rh; const v = c.txt(s.v, .07, 0, .34, 96, { f: th.fd, wt: th.wd, c: th.ac, up: false, lh: 1, ls: -.02 }); R.fitInto(v, c.Y(rh) - 10, 50); c.vcenter(v, c.Y(y + rh / 2 - .01)); const e = c.txt(s.l, .45, 0, .46, 38, {}); c.vcenter(e, c.Y(y + rh / 2 - .01)); if (k < n - 1) c.rule(.07, y + rh - .01, .86, .18); });
  }
};
LAY.stats = (c, d, i) => ((LAYV.stats[d.layout]) || LAYV.stats.default)(c, d, i);

/* ====================== CITAZIONE ====================== */
LAYV.quote = {
  default: quoteDefault, left: quoteDefault,
  center: (c, d) => {
    const th = c.th; c.card(.1, .14, .8, .72); c.txt('“', .1, .14, .8, 360, { f: th.fd, wt: th.wd, c: th.ac, a: 'center', lh: 1, up: false });
    const q = c.txt(d.quote, .17, .42, .66, 52, { f: th.qf || th.fd, wt: th.qw || 500, up: false, lh: 1.22, a: 'center', c: th.cardFg || th.fg, i: !!th.qi }); R.fitInto(q, c.Y(.3), 30);
    const y = (q.y + q.h) / c.H + .03; c.txt('— ' + d.author, .17, y, .66, 30, { a: 'center', wt: 700, c: th.cardFg || th.fg }); if (d.role) c.txt(d.role, .17, y + .06, .66, 24, { a: 'center', c: th.mute });
  },
  split: (c, d) => {
    const th = c.th; c.box('rect', 0, 0, .36, 1, th.ac); c.txt('“', .02, .05, .32, 560, { f: th.fd, wt: th.wd, c: c.ink(th.ac), a: 'center', lh: 1, up: false, o: .9 });
    const q = c.txt(d.quote, .43, .28, .5, 54, { f: th.qf || th.fd, wt: th.qw || 500, up: false, lh: 1.22, i: !!th.qi }); R.fitInto(q, c.Y(.42), 30);
    const y = (q.y + q.h) / c.H + .04; c.box('rect', .43, y, .05, .006, th.ac); c.txt(d.author, .43, y + .03, .5, 32, { wt: 700 }); if (d.role) c.txt(d.role, .43, y + .09, .5, 26, { c: th.mute });
  }
};
LAY.quote = (c, d, i) => ((LAYV.quote[d.layout]) || LAYV.quote.default)(c, d, i);

/* ====================== PERCORSO ====================== */
LAYV.timeline = {
  default: timelineDefault, h: timelineDefault,
  v: (c, d) => {
    const th = c.th; head(c, d.title); const st = d.steps.slice(0, 5), n = st.length, rh = Math.min(.15, .62 / n), dia = c.S(62);
    c.box('rect', .105, .3, .004, rh * (n - 1) + .02, th.mute, { o: .5 });
    st.forEach((s, k) => { const y = .3 + k * rh; c.badge(c.X(.107) - dia / 2, c.Y(y) - dia / 2 + 6, dia, k + 1, [th.ac, th.ac2, th.ac3][k % 3], { size: 28 }); c.txt(s.t, .16, y - .028, .3, 36, { f: th.fd, wt: th.wd, up: false }); const e = c.txt(s.d, .48, y - .02, .44, 28, { o: .85 }); R.fitInto(e, c.Y(rh) - 6, 18); });
  },
  chevron: (c, d) => {
    const th = c.th; head(c, d.title); const st = d.steps.slice(0, 5), n = st.length, w = (.86 + .02 * (n - 1)) / n;
    st.forEach((s, k) => {
      const x = .07 + k * (w - .02), fill = [th.ac, th.ac2, th.ac3][k % 3]; c.box('chevron', x, .32, w, .17, fill);
      const t = c.txt(s.t, x + w * .24, 0, w * .52, 28, { f: th.fd, wt: th.wd, up: false, c: c.ink(fill), a: 'center' }); c.vcenter(t, c.Y(.405));
      const e = c.txt(s.d, x + .005, .54, w - .03, 26, { o: .9 }); R.fitInto(e, c.Y(.34), 18);
    });
  },
  steps: (c, d) => {
    const th = c.th; head(c, d.title); const st = d.steps.slice(0, 5), n = st.length, gx = .02, w = (.86 - gx * (n - 1)) / n;
    st.forEach((s, k) => {
      const hh = .22 + k * (.4 / Math.max(1, n - 1)), x = .07 + k * (w + gx), y = .9 - hh; c.card(x, y, w, hh, { f: k === n - 1 ? th.ac : th.card });
      const inv = k === n - 1; c.txt(String(k + 1), x + .015, y + .02, w - .03, 44, { f: th.fd, wt: th.wd, c: inv ? c.ink(th.ac) : th.ac, up: false, lh: 1 });
      const t = c.txt(s.t, x + .015, y + .13, w - .03, 28, { wt: 800, c: inv ? c.ink(th.ac) : (th.cardFg || th.fg), up: false }); const e = c.txt(s.d, x + .015, (t.y + t.h) / c.H + .01, w - .03, 22, { c: inv ? c.ink(th.ac) : (th.cardFg || th.fg), o: .85 }); R.fitInto(e, c.Y(y + hh) - e.y - 12, 14);
    });
  }
};
LAY.timeline = (c, d, i) => ((LAYV.timeline[d.layout]) || LAYV.timeline.default)(c, d, i);

/* ====================== SEZIONE ====================== */
LAYV.section = {
  default: sectionDefault, bignum: sectionDefault,
  center: (c, d) => {
    const th = c.th, fg = th.secFg || Col.readable(c.bg);
    c.txt(d.n || '01', .3, .22, .4, 60, { f: th.fd, wt: th.wd, c: fg, a: 'center', o: .6, up: false }); c.box('rect', .46, .36, .08, .006, fg, { o: .6 });
    const t = c.title(d.title, .1, .42, .8, 104, { c: fg, a: 'center' }); R.fitInto(t, c.Y(.34), 60); if (d.sub) c.txt(d.sub, .2, (t.y + t.h) / c.H + .03, .6, 34, { c: fg, o: .85, a: 'center' });
  },
