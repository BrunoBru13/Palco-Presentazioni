    TB.slider('Contrasto', 50, 150, Math.round((f.ct == null ? 1 : f.ct) * 100), 1, (x, v) => { x.fx = x.fx || {}; x.fx.ct = v / 100; }, v => v + '%'),
    TB.slider('Saturazione', 0, 200, Math.round((f.sa == null ? 1 : f.sa) * 100), 1, (x, v) => { x.fx = x.fx || {}; x.fx.sa = v / 100; }, v => v + '%'),
    TB.slider('Sfocatura', 0, 20, f.bl || 0, 1, (x, v) => { x.fx = x.fx || {}; x.fx.bl = v; }, v => v + ' px'),
    h('div.cph', 'Cornice'),
    h('div.framegrid', [['', 'Nessuna'], ...ED.FRAMES.map(k => [k, k])].map(([k]) => h('button.frm' + ((e0.mk || '') === k ? '.on' : ''), { title: k ? (M.SHAPE_LIST.find(s => s[0] === k) || [k, k])[1] : 'Nessuna cornice', onclick: () => { ED.setFrame(k); UI.closePops(); } },
      k ? h('svg', { viewBox: '0 0 100 100', width: 30, height: 30, html: `<path d="${M.pathOf({ k, w: 100, h: 100, rad: null })}" fill="currentColor"/>` }) : icn('x', 16)))),
    h('div.cph', 'Forma'),
    TB.slider('Angoli', 0, Math.round(Math.min(e0.w, e0.h) / 2), e0.rad || 0, 1, (x, v) => { x.rad = v; }, v => v + ' px'),
    h('div.btnrow', h('button.btn.sm', { onclick: () => { TB.apply(x => { x.rad = Math.round(Math.min(x.w, x.h) / 2); }); UI.closePops(); } }, 'Tondo'), h('button.btn.sm', { onclick: () => { TB.apply(x => { x.rad = 0; }); UI.closePops(); } }, 'Quadrato')));
  UI.pop(anchor, body, { cls: 'ppop' });
};

/* colori principali dell'immagine, modificabili uno a uno */
TB.imgColors = (anchor, e0) => {
  const body = h('div.pp', h('div.cph', 'Colori principali'), h('p.hint2', 'Analizzo l’immagine…'));
  const pop = UI.pop(anchor, body, { cls: 'ppop' });
  const draw = (pal) => {
    body.innerHTML = '';
    if (!pal.colors.length) { body.append(h('div.cph', 'Colori principali'), h('p.hint2', 'Non riesco a leggere i colori di questa immagine.')); return; }
    body.append(h('div.cph', 'Colori principali'), h('p.hint2', pal.kind === 'svg' ? 'Clicca un colore per cambiarlo. Le modifiche si vedono subito e puoi tornare all’originale.' : 'Clicca un colore per cambiarlo: anche le tonalità simili cambiano, mantenendo luci e ombre.'));
    const list = h('div.imgcols');
    pal.colors.forEach(orig => {
      const cur = () => (e0.rc && e0.rc[orig]) || orig;
      const btn = h('button.icol', { title: 'Cambia ' + orig, onclick: () => UI.colorPop(btn, cur(), (v) => {
        if (typeof v !== 'string') return;
        v = v.toUpperCase();
        ED.mut(x => { x.rc = x.rc || {}; if (v === orig) delete x.rc[orig]; else x.rc[orig] = v; if (!Object.keys(x.rc).length) delete x.rc; }, { tb: false, now: false });
        btn.firstChild.style.background = v; btn.lastChild.textContent = v;
      }, { docColors: ED.docColors() }) }, h('span.icolsw', { style: { background: cur() } }), h('span.icolhex', cur()));
      list.append(btn);
    });
    body.append(list, h('div.btnrow', h('button.btn.sm', { disabled: !Img.hasRc(e0.rc), onclick: () => { ED.mut(x => { delete x.rc; }); UI.closePop(pop); } }, icn('restore', 16), 'Ripristina i colori originali')));
  };
  Img.palette(e0.src).then(draw);
};

/* ---- grafici ---- */
ED.chartEditor = (e) => {
  const body = h('div.cedit');
  const upd = () => { ED.refreshNode(e); ED.renderOverlay(); ED.updateThumb(ED.si); ED.commit(false); };
  const draw = () => {
    body.innerHTML = '';
    const pie = e.k === 'pie' || e.k === 'donut', ns = pie ? 1 : e.series.length;
    const grid = h('div.cgrid', { style: { gridTemplateColumns: `minmax(90px,1.2fr) repeat(${ns},minmax(70px,1fr))` } });
    grid.append(h('span.chd', 'Etichetta'), ...e.series.slice(0, ns).map((s, j) => h('input.inp.sm.chd', { value: s.n, 'aria-label': 'Nome serie ' + (j + 1), oninput: ev => { s.n = ev.target.value; upd(); } })));
    e.labels.forEach((l, i) => {
      grid.append(h('input.inp.sm', { value: l, 'aria-label': 'Etichetta ' + (i + 1), oninput: ev => { e.labels[i] = ev.target.value; upd(); } }));
      e.series.slice(0, ns).forEach((s, j) => grid.append(h('input.inp.sm', { type: 'number', value: s.v[i] == null ? 0 : s.v[i], 'aria-label': `Valore ${i + 1}, serie ${j + 1}`, oninput: ev => { s.v[i] = +ev.target.value; upd(); } })));
    });
    body.append(grid, h('div.row', h('button.btn.sm', { onclick: () => { e.labels.push('Nuova'); e.series.forEach(s => s.v.push(0)); draw(); upd(); } }, icn('plus', 16), 'Riga'),
      e.labels.length > 1 ? h('button.btn.sm', { onclick: () => { e.labels.pop(); e.series.forEach(s => s.v.pop()); draw(); upd(); } }, icn('minus', 16), 'Riga') : null,
      !pie ? h('button.btn.sm', { onclick: () => { e.series.push({ n: 'Serie ' + (e.series.length + 1), v: e.labels.map(() => 0) }); draw(); upd(); } }, icn('plus', 16), 'Serie') : null,
      !pie && e.series.length > 1 ? h('button.btn.sm', { onclick: () => { e.series.pop(); draw(); upd(); } }, icn('minus', 16), 'Serie') : null));
  };
  draw();
  UI.modal('Dati del grafico', body, { cls: 'small wide2', foot: [h('span.grow'), h('button.btn.primary', { onclick: ev => { ev.target.closest('.modal').close(); ED.commit(); } }, 'Fatto')] });
};
TB.chartColors = (anchor, e0) => {
  const body = h('div.pp'), draw = () => {
    body.innerHTML = '';
    const n = (e0.k === 'pie' || e0.k === 'donut') ? e0.labels.length : e0.series.length;
    for (let i = 0; i < n; i++) body.append(h('div.crow2', h('button.tbb.sw2', { onclick: ev => UI.colorPop(ev.currentTarget, e0.colors[i % e0.colors.length], c => { if (typeof c === 'string') { TB.apply(x => { x.colors = x.colors.slice(); x.colors[i % x.colors.length] = c; }); draw(); } }, { docColors: ED.docColors() }) }, h('span.sw2c', { style: { background: e0.colors[i % e0.colors.length] } })), h('span', (e0.k === 'pie' || e0.k === 'donut') ? e0.labels[i] : e0.series[i].n)));
    body.append(h('div.cph', 'Testo del grafico'), h('button.btn.sm', { onclick: ev => UI.colorPop(ev.currentTarget, e0.tc, c => { if (typeof c === 'string') TB.apply(x => { x.tc = c; }); }) }, h('span.dot', { style: { background: e0.tc } }), 'Colore del testo'), TB.slider('Dimensione', 14, 48, Math.round(e0.fs || 26), 1, (x, v) => { x.fs = v; }, v => v + ' px'));
  };
  draw(); UI.pop(anchor, body, { cls: 'ppop' });
};
TB.tablePop = (anchor, e0) => {
