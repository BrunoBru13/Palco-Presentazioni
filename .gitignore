};
const shOpen0 = SH.open;
SH.open = (deck) => {
  shOpen0(deck);
  const m = $$('.modal').pop(), body = m && $('.mbd .form', m);
  if (body && !(deck.collabGuest && !CLB.guest)) body.prepend(CLB.shareSection(deck));
};

/* ---------- avatar nella barra e chip nella Home ---------- */
CLB.mountBar = () => {
  const top = $('.etop'); if (!top) return; $('.cpeers', top) && $('.cpeers', top).remove();
  if (!CLB.on || (typeof ED !== 'undefined' && ED.deck !== CLB.deck)) return;
  const list = CLB.everyone(), anchor = [...top.children].find(n => n.matches && n.matches('button.btn') && /Magia/.test(n.textContent));
  const bar = h('button.cpeers', { title: 'Persone nella sessione: apri la condivisione', 'aria-label': 'Persone nella sessione', onclick: () => SH.open(ED.deck) }, list.slice(0, 5).map(p => CLB.avatar(p, 26)), list.length > 5 ? h('b', '+' + (list.length - 5)) : null);
  anchor ? top.insertBefore(bar, anchor) : top.appendChild(bar);
};
const edBuild0 = ED.build; ED.build = () => { edBuild0(); CLB.mountBar(); CLB.syncBar(); };
const appRender0 = App.render;
App.render = () => {
  if (CLB.viewerRoot) return CLB.viewerRedraw && CLB.viewerRedraw();
  appRender0(); if (!CLB.on) return; const top = $('.top'), sync = top && $('.sync', top); if (!top) return;
  top.insertBefore(h('button.btn.sm.clbchip', { onclick: () => CLB.deck && !CLB.guest ? SH.open(CLB.deck) : null, title: 'Collaborazione attiva' }, h('i.dot'), `Collaborazione · ${CLB.everyone().length}`), sync || null);
};
CLB.onUi(() => { if (typeof ED !== 'undefined' && ED.active) CLB.mountBar(); else if (!CLB.viewerRoot && CLB.host) { const hs = $('.home'); hs && App.render(); } CLB.syncBar(); });
CLB.syncBar = () => {
  let b = $('#clbbar'); const need = CLB.guest && CLB.lost;
  if (!need) { b && b.remove(); return; }
  if (!b) { b = h('div#clbbar.clbbar', icn('info', 18), h('span', 'Connessione col proprietario persa: provo a ricollegarmi. Evita di modificare finché non torna.'), h('button.btn.sm', { onclick: () => CLB.saveCopy() }, 'Salva una copia')); document.body.appendChild(b); }
};
CLB.markStrip = () => {
  if (!CLB.on || !ED.active || ED.deck !== CLB.deck) return;
  $$('#strip .pg').forEach((pg, i) => { $('.pdots', pg) && $('.pdots', pg).remove(); const sid = ED.deck.slides[i] && ED.deck.slides[i].id, who = CLB.everyone().filter(p => p.id !== CLB.me.id && p.slide === sid); if (who.length) pg.appendChild(h('div.pdots', who.map(p => h('i', { style: { background: p.color }, title: p.name })))); });
};
const rsStrip0 = ED.renderStrip; ED.renderStrip = () => { rsStrip0(); CLB.markStrip(); };

/* ---------- ingresso dal link ---------- */
CLB.joinScreen = () => {
  const m = location.hash.match(/^#j=([A-Za-z0-9-]+)\.([A-Za-z0-9]+)$/); if (!m) return;
  const [, hid, tk] = m, name = h('input.inp', { value: CLB.name(), placeholder: 'Il tuo nome', maxlength: 30, 'aria-label': 'Il tuo nome' }), st = h('p.hint2', 'Scrivi il tuo nome: gli altri lo vedranno vicino alle tue modifiche e ai tuoi commenti.');
  const go = h('button.btn.primary', { onclick: async () => {
    const n = name.value.trim() || 'Ospite'; CLB.setName(n); go.disabled = true; name.disabled = true; st.textContent = 'Mi collego alla presentazione…';
    try { await CLB.join(hid, tk, n); scr.remove(); CLB.enter(); }
    catch (e) { st.textContent = (e && e.why) || 'Non sono riuscito a collegarmi.'; st.classList.add('err'); go.disabled = false; name.disabled = false; go.lastChild.textContent = 'Riprova'; }
  } }, icn('check', 18), 'Entra');
  const scr = h('div.joinscr', h('div.joinbox', h('span.lmark', { html: '<svg viewBox="0 0 32 32" width="40" height="40" aria-hidden="true"><rect width="32" height="32" rx="9" fill="#FFD25A"/><path d="M8 24V8h9a5 5 0 0 1 0 10h-4" fill="none" stroke="#2A2310" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/></svg>' }), h('h1', 'Sei stato invitato a collaborare'), h('p', 'Entrerai nella presentazione in tempo reale, con il ruolo scelto da chi ti ha mandato il link.'), name, st, go));
  document.body.appendChild(scr); name.addEventListener('keydown', e => { if (e.key === 'Enter') go.click(); }); setTimeout(() => name.focus(), 120);
};
CLB.enter = async () => {
  const D = CLB.deck; TP.ensure(D); const fonts = new Set(); D.slides.forEach(s => EX.flat(s.els).forEach(e => e.f && fonts.add(e.f))); loadFonts([...fonts].map(f => [f, 400])).catch(() => { });
  if (CLB.role === 'editor') { CLB.viewerRoot = false; ED.open(D); } else CLB.viewerUI();
  toast(`Sei dentro come ${CLB.roleName(CLB.role)}`, { icon: 'check', ms: 3000 });
};
CLB.exitEditor = () => { if (!ED.active) return; try { ED.histFlush && ED.histFlush(); } catch (e) { } UI.closePops(); ED.active = false; document.removeEventListener('keydown', ED.onKey, true); document.removeEventListener('paste', ED.onPaste); if (ED._ro) ED._ro.disconnect(); };
CLB.onRole = (prev, now) => { if (now === 'editor' && prev !== 'editor') { CLB.viewerRoot = false; ED.open(CLB.deck); } else if (prev === 'editor' && now !== 'editor') { CLB.exitEditor(); CLB.viewerUI(); } else if (CLB.viewerRoot) CLB.viewerRedraw(); };

/* ---------- visualizzatore e commentatore ---------- */
CLB.viewerUI = () => { CLB.viewerRoot = true; $('#app').className = 'collabview'; CLB.cvScroll = 0; CLB.viewerRedraw(); };
CLB.viewerRedraw = () => {
  const D = CLB.deck, root = $('#app'); if (!root || !CLB.viewerRoot || !D) return;
  const old = $('.cvmain', root), sc = old ? old.scrollTop : 0, canC = CLB.canComment();
  const fonts = new Set(); D.slides.forEach(s => EX.flat(s.els).forEach(e => e.f && fonts.add(e.f))); loadFonts([...fonts].map(f => [f, 400])).then(() => { if (CLB.viewerRoot) $$('.cvcard .thumb', root).forEach(t => t.classList.remove('x')); }).catch(() => { });
  const cards = D.slides.map((s, i) => {
    const cm = CLB.cmtList(D).filter(c => c.slide === s.id), open = cm.filter(c => !c.res).length;
    return h('button.cvcard', { onclick: () => CLB.slideDialog(i), 'aria-label': 'Pagina ' + (i + 1) }, h('div.thwrap', R.thumb(s, D, { idx: i }), cm.filter(c => c.x != null && !c.res).map((c, k) => h('i.cvpin', { style: { left: c.x / D.w * 100 + '%', top: c.y / D.h * 100 + '%', background: c.col } }, h('span', String(k + 1))))), h('div.cvmeta', h('b', String(i + 1)), open ? h('span.cvcm', icn('chat', 14), String(open)) : null));
  });
  const peers = CLB.everyone();
  const top = h('header.cvtop', h('span.lmark', { html: '<svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true"><rect width="32" height="32" rx="9" fill="#FFD25A"/><path d="M8 24V8h9a5 5 0 0 1 0 10h-4" fill="none" stroke="#2A2310" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/></svg>' }),
    h('div.cvtitle', h('b', D.name), h('small', `${CLB.roleName(CLB.role)} · ${D.slides.length} ${D.slides.length === 1 ? 'pagina' : 'pagine'}`)), h('div.grow'),
    h('div.cpeers.static', peers.slice(0, 6).map(p => CLB.avatar(p, 26))),
    h('button.btn.sm', { onclick: () => PR.start(D, 0) }, icn('play', 16), h('span.hide-s', 'Presenta')),
    canC ? h('button.btn.sm', { onclick: () => CLB.commentsDrawer() }, icn('chat', 16), h('span.hide-s', 'Commenti')) : null,
    h('button.btn.sm', { onclick: () => CLB.saveCopy() }, icn('copy', 16), h('span.hide-s', 'Salva una copia')),
    h('button.btn.sm', { onclick: () => CLB.leaveToHome() }, icn('x', 16), h('span.hide-s', 'Esci')));
  root.replaceChildren(top, h('main.cvmain', { onscroll: e => { CLB.cvScroll = e.target.scrollTop; } }, h('p.hint2.cvhint', CLB.role === 'viewer' ? 'Stai guardando in diretta: le modifiche degli altri compaiono da sole.' : 'Clicca una pagina per commentarla. Le modifiche degli altri compaiono da sole.'), h('div.cvgrid', cards)));
  const nm = $('.cvmain', root); nm.scrollTop = sc || CLB.cvScroll || 0; CLB.syncBar();
};
CLB.slideDialog = (i0) => {
  let i = i0; const D = CLB.deck, canC = CLB.canComment(), st = { pin: null };
  const stage = h('div.cvstage'), side = h('div.cvside');
  const draw = () => {
    const s = D.slides[i]; stage.innerHTML = ''; side.innerHTML = '';
    const th = R.thumb(s, D, { idx: i }); stage.append(th); const ov = h('div.cvov', { style: { cursor: canC ? 'crosshair' : 'default' } }); stage.append(ov);
    const pins = CLB.cmtList(D).filter(c => c.slide === s.id && c.x != null && !c.res); pins.forEach((c, k) => ov.append(h('i.cvpin.big', { style: { left: c.x / D.w * 100 + '%', top: c.y / D.h * 100 + '%', background: c.col } }, h('span', String(k + 1)))));
    if (st.pin) ov.append(h('i.cvpin.big.new', { style: { left: st.pin.x / D.w * 100 + '%', top: st.pin.y / D.h * 100 + '%', background: (CLB.me || {}).color || '#FFD25A' } }, h('span', '+')));
    if (canC) ov.addEventListener('click', e => { const r = ov.getBoundingClientRect(); st.pin = { x: Math.round((e.clientX - r.left) / r.width * D.w), y: Math.round((e.clientY - r.top) / r.height * D.h) }; draw(); });
    CLB.add(side, h('div.cvnav', h('button.ibtn', { disabled: i === 0, onclick: () => { i--; st.pin = null; draw(); } }, icn('chevL', 18)), h('b', `Pagina ${i + 1} di ${D.slides.length}`), h('button.ibtn', { disabled: i === D.slides.length - 1, onclick: () => { i++; st.pin = null; draw(); } }, icn('chevR', 18))),
      CLB.commentsView({ slide: s.id, pin: () => st.pin, clearPin: () => { st.pin = null; draw(); }, deck: D }));
  };
  const m = UI.modal('Pagina e commenti', h('div.cvdlg', stage, side), { cls: 'logomaker cvbox', onclose: () => { CLB._cvRefresh = null; } });
  CLB._cvRefresh = () => { if (m.isConnected) draw(); }; draw();
};
CLB.commentsDrawer = () => { const m = UI.modal('Tutti i commenti', CLB.commentsView({ all: true, deck: CLB.deck }), { cls: 'wide2', onclose: () => { CLB._cvRefresh = null; } }); CLB._cvRefresh = () => { if (m.isConnected) { const b = $('.mbd', m); b.replaceChildren(CLB.commentsView({ all: true, deck: CLB.deck })); } }; };

/* ---------- commenti ---------- */
CLB.myIdent = () => CLB.on && CLB.me ? { by: CLB.me.name, col: CLB.me.color, uid: CLB.me.id } : { by: CLB.name() || 'Io', col: CLB.COLORS[0], uid: 'host' };
CLB.cdeck = () => CLB.deck && (CLB.on || CLB.viewerRoot) ? CLB.deck : (typeof ED !== 'undefined' && ED.active ? ED.deck : null);
CLB.cmtDo = (m) => { const D = CLB.cdeck(); if (!D) return; CLB.cmtApply(m, D); if (CLB.on && D === CLB.deck) CLB.out(m); };
CLB.cmtCreate = (o) => { const me = CLB.myIdent(), c = { id: uid('c_'), slide: o.slide, x: o.x == null ? null : Math.round(o.x), y: o.y == null ? null : Math.round(o.y), el: o.el || null, text: String(o.text).slice(0, 800), ...me, ts: Date.now(), res: 0, rep: [] }; CLB.cmtDo({ t: 'cmt', c }); return c; };
CLB.cmtMine = (c) => CLB.host || !CLB.on || CLB.role === 'editor' || c.uid === CLB.myIdent().uid;
CLB.cmtChanged = () => {
  if (typeof ED !== 'undefined' && ED.active) { ED.renderOverlay && ED.renderOverlay(); if (ED.panel === 'comments') ED.renderPanel(); }
  if (CLB.viewerRoot) { CLB.viewerRedraw && CLB.viewerRedraw(); CLB._cvRefresh && CLB._cvRefresh(); }
  CLB.notify();
};
CLB.when = (t) => { const d = Math.floor((Date.now() - t) / 60000); return d < 1 ? 'adesso' : d < 60 ? d + ' min fa' : d < 1440 ? Math.floor(d / 60) + ' h fa' : new Date(t).toLocaleDateString('it-IT', { day: 'numeric', month: 'short' }); };
CLB.commentsView = (o = {}) => {
  const D = o.deck || CLB.cdeck(), wrap = h('div.cmts'); if (!D) return wrap;
  const all = (D.comments || []).slice().sort((a, b) => a.ts - b.ts), canC = !CLB.on || CLB.canComment();
  const sid = o.slide || (typeof ED !== 'undefined' && ED.active && ED.deck === D && ED.slide() ? ED.slide().id : null);
  const thread = (c) => {
    const me = CLB.myIdent(), box = h('div.cmt' + (c.res ? '.res' : ''), { 'data-id': c.id },
      h('div.cmh', h('i.cav', { style: { background: c.col, width: '24px', height: '24px', fontSize: '10px' } }, CLB.initials(c.by)), h('b', c.by), h('small', CLB.when(c.ts)), c.x != null ? h('span.cmpin', { title: 'Fissato su un punto della pagina' }, icn('pointer', 12)) : null),
      h('p.cmt1', c.text), (c.rep || []).map(r => h('div.cmrep', h('i.cav', { style: { background: r.col, width: '20px', height: '20px', fontSize: '9px' } }, CLB.initials(r.by)), h('div', h('b', r.by + ' '), h('small', CLB.when(r.ts)), h('p', r.text)))));
    const actions = h('div.cmact');
    if (canC) { const inp = h('input.inp.sm', { placeholder: 'Rispondi…', 'aria-label': 'Rispondi', onkeydown: e => { if (e.key === 'Enter' && inp.value.trim()) { CLB.cmtDo({ t: 'cmt-rep', id: c.id, r: { id: uid('r_'), text: inp.value.trim(), ...me, ts: Date.now() } }); } } }); CLB.add(actions, inp); }
    if (CLB.cmtMine(c)) { CLB.add(actions, h('button.link', { onclick: () => CLB.cmtDo({ t: 'cmt-res', id: c.id, v: c.res ? 0 : 1 }) }, c.res ? 'Riapri' : 'Risolvi'), h('button.link.danger', { onclick: () => CLB.cmtDo({ t: 'cmt-del', id: c.id }) }, 'Elimina')); }
    if (typeof ED !== 'undefined' && ED.active && ED.deck === D) { const si = D.slides.findIndex(s => s.id === c.slide); if (si >= 0 && si !== ED.si) CLB.add(actions, h('button.link', { onclick: () => ED.goto(si) }, 'Vai alla pagina')); }
    CLB.add(box, actions); return box;
  };
  if (canC) {
    const ta = h('textarea.inp.area', { rows: 2, placeholder: o.slide ? 'Scrivi un commento su questa pagina…' : 'Scrivi un commento sulla pagina che stai guardando…', 'aria-label': 'Nuovo commento' });
    const send = (pin) => { const text = ta.value.trim(); if (!text) return toast('Scrivi il commento'); if (!sid) return; if (pin === 'place') { CLB.placePin(text, sid); return; } const p = o.pin && o.pin(); CLB.cmtCreate({ text, slide: sid, x: p ? p.x : null, y: p ? p.y : null }); ta.value = ''; o.clearPin && o.clearPin(); };
    const pinned = o.pin && o.pin();
    CLB.add(wrap, h('div.cmnew', ta, h('div.row', h('button.btn.sm.primary', { onclick: () => send() }, icn('chat', 14), pinned ? 'Pubblica sul punto' : 'Pubblica'), typeof ED !== 'undefined' && ED.active && !o.slide ? h('button.btn.sm', { onclick: () => send('place') }, icn('pointer', 14), 'Fissa su un punto…') : null)), !pinned && o.slide && canC ? h('p.hint2', 'Clicca sulla pagina per fissare il commento su un punto.') : null);
  } else CLB.add(wrap, h('p.hint2', 'Il tuo ruolo permette solo di guardare.'));
  const bySlide = (o.all ? D.slides.map(s => s.id) : [o.slide || sid]).filter(Boolean);
  bySlide.forEach(id => {
    const list = all.filter(c => c.slide === id), idx = D.slides.findIndex(s => s.id === id); if (!list.length && !o.slide && !(o.all && false)) return;
    if (o.all || !o.slide) CLB.add(wrap, h('h4.cmslide', `Pagina ${idx + 1}`));
    list.filter(c => !c.res).forEach(c => CLB.add(wrap, thread(c)));
    const done = list.filter(c => c.res); if (done.length) CLB.add(wrap, h('details.cmdone', h('summary', `${done.length} ${done.length === 1 ? 'risolto' : 'risolti'}`), done.map(thread)));
  });
  if (!all.length) CLB.add(wrap, h('p.hint2', { style: { padding: '8px 2px' } }, 'Ancora nessun commento.'));
  return wrap;
};
ED.panels.comments = () => {
  const D = ED.deck, sid = ED.slide() && ED.slide().id, all = (D.comments || []).length;
  const cur = CLB.commentsView({ deck: D }); // composer + commenti di tutte le pagine (con la pagina attuale in testa)
  return [h('p.hint2', CLB.on ? 'I commenti sono visti da tutti i collaboratori in diretta.' : 'I commenti restano nella presentazione. Quando collabori con altri li vedono tutti.'), cur];
};
['RAIL_PRES', 'RAIL'].forEach(k => { if (ED[k] && !ED[k].some(r => r[0] === 'comments')) { const i = ED[k].findIndex(r => r[0] === 'layers'); ED[k].splice(i < 0 ? ED[k].length : i, 0, ['comments', 'Commenti', 'chat']); } });
if (GR.RAIL && !GR.RAIL.some(r => r[0] === 'comments')) { const i = GR.RAIL.findIndex(r => r[0] === 'layers'); GR.RAIL.splice(i, 0, ['comments', 'Commenti', 'chat']); }
/* segnaposto sulla pagina */
CLB.placePin = (text, slideId) => {
  ED.select([]); toast('Clicca sulla pagina dove vuoi fissare il commento (Esc per annullare)', { ms: 4000 });
  const cw = ED.cwrap; cw.classList.add('placing');
  const done = () => { cw.classList.remove('placing'); cw.removeEventListener('pointerdown', down, true); document.removeEventListener('keydown', esc, true); };
  const down = (e) => { e.preventDefault(); e.stopPropagation(); const p = ED.pt(e); done(); if (p.x < 0 || p.y < 0 || p.x > ED.deck.w || p.y > ED.deck.h) return; CLB.cmtCreate({ text, slide: slideId, x: p.x, y: p.y }); if (ED.panel !== 'comments') ED.setPanel('comments'); toast('Commento fissato sulla pagina', { icon: 'check', ms: 1800 }); };
  const esc = (e) => { if (e.key === 'Escape') { e.stopPropagation(); done(); } };
  cw.addEventListener('pointerdown', down, true); document.addEventListener('keydown', esc, true);
};
CLB.openThread = (id) => { ED.setPanel('comments'); setTimeout(() => { const n = $(`.cmt[data-id="${id}"]`); if (n) { n.scrollIntoView({ block: 'center', behavior: 'smooth' }); n.classList.add('flash'); setTimeout(() => n.classList.remove('flash'), 1600); } }, 120); };
const clbRo1 = ED.renderOverlay;
ED.renderOverlay = () => {
  clbRo1(); const ov = ED.ov; if (!ov || !ED.deck || !ED.slide()) return; const D = ED.deck, s = ED.slide();
  (D.comments || []).filter(c => c.slide === s.id && c.x != null && !c.res).forEach((c, k) => ov.appendChild(h('button.cpin', { style: { left: c.x + 'px', top: c.y + 'px', background: c.col }, title: `${c.by}: ${c.text.slice(0, 80)}`, onpointerdown: e => e.stopPropagation(), onclick: e => { e.stopPropagation(); CLB.openThread(c.id); } }, h('span', String(k + 1)))));
  if (CLB.on && ED.deck === CLB.deck) CLB.everyone().forEach(p => { if (!CLB.me || p.id === CLB.me.id || p.slide !== s.id || !p.sel) return; p.sel.forEach(id => { const e = s.els.find(x => x.id === id); if (e) ov.appendChild(h('div.rsel', { style: { left: e.x + 'px', top: e.y + 'px', width: e.w + 'px', height: e.h + 'px', borderColor: p.color, transform: e.r ? `rotate(${e.r}deg)` : '' } }, h('span', { style: { background: p.color } }, p.name))); }); });
};

/* ============ Avvio ============ */
function startApp() {
  if (startApp.done) return; startApp.done = true;
  const inEd = () => typeof ED !== 'undefined' && ED.active;
  ST.loadLocal();
  App.render();
  window.addEventListener('palco-img', debounce(() => { if (inEd()) ED.renderAll(); else App.render(); }, 120));
  window.addEventListener('palco-caps', () => { if (!inEd()) App.render(); });
  ST.connect().then(async () => { await App.seed(); if (!inEd()) App.render(); }).catch(e => console.warn(e));
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(() => { if (!inEd()) App.render(); });
}
if (location.hash === '#audience' && AUD.peer()) AUD.boot();
else if (/^#j=/.test(location.hash)) { startApp(); CLB.joinScreen(); }
else SH.boot().then(isViewer => { if (!isViewer) startApp(); }).catch(() => startApp());

</script>

</body></html>
