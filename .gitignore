    const p = { x: Math.random() * W, y: H + 20 + Math.random() * H * .8, r: 10 + Math.random() * 44, vy: 1 + Math.random() * 2.4, ph: Math.random() * 6 };
    p.step = (x) => { p.y -= p.vy; p.ph += .03; p.x += Math.sin(p.ph) * .7; const g = x.createRadialGradient(p.x - p.r * .35, p.y - p.r * .35, p.r * .1, p.x, p.y, p.r); g.addColorStop(0, 'rgba(255,255,255,.55)'); g.addColorStop(.7, 'rgba(160,210,255,.12)'); g.addColorStop(1, 'rgba(255,255,255,.4)'); x.fillStyle = g; x.beginPath(); x.arc(p.x, p.y, p.r, 0, 6.283); x.fill(); x.strokeStyle = 'rgba(255,255,255,.65)'; x.lineWidth = 1.5; x.stroke(); return p.y > -p.r * 2; };
