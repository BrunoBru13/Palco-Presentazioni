  const nc = () => Math.max(...e0.rows.map(r => r.length));
  const b = (l, ic2, fn) => h('button.btn.sm', { onclick: () => { fn(); } }, icn(ic2, 16), l);
  const body = h('div.pp',
    h('div.cph', 'Righe e colonne'),
    h('div.btnrow', b('Riga', 'plus', () => upd(x => x.rows.push(Array(nc()).fill('')))), b('Riga', 'minus', () => upd(x => { if (x.rows.length > 1) x.rows.pop(); }))),
    h('div.btnrow', b('Colonna', 'plus', () => upd(x => x.rows.forEach(r => { while (r.length < nc()) r.push(''); r.push(''); }))), b('Colonna', 'minus', () => upd(x => { if (nc() > 1) x.rows.forEach(r => r.pop()); }))),
    h('label.chk', h('input', { type: 'checkbox', checked: e0.hdr, onchange: ev => TB.apply(x => { x.hdr = ev.target.checked; }) }), 'Prima riga come intestazione'),
    h('div.cph', 'Colori'),
    h('div.btnrow', [['hf', 'Intestazione'], ['cf', 'Celle'], ['cf2', 'Righe alterne'], ['bc', 'Bordi']].map(([k, l]) => h('button.btn.sm', { onclick: ev => UI.colorPop(ev.currentTarget, e0[k], c => { if (typeof c === 'string') TB.apply(x => { x[k] = c; if (k === 'hf') x.hc = Col.readable(c); if (k === 'cf') x.tc = Col.readable(c); }); }, { docColors: ED.docColors() }) }, h('span.dot', { style: { background: e0[k] } }), l))),
    TB.slider('Testo', 14, 60, Math.round(e0.fs), 1, (x, v) => { x.fs = v; }, v => v + ' px'),
    TB.slider('Altezza righe', 40, 200, Math.round(e0.rh), 1, (x, v) => { x.rh = v; x.h = x.rows.length * v; }, v => v + ' px'));
