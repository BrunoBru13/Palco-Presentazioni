/* ============ Uso offline e installazione come app (solo sul sito pubblicato) ============ */
const PWA = { prompt: null, installed: false };
PWA.can = () => 'serviceWorker' in navigator && !window.claude && /^https?:$/.test(location.protocol) && !document.body.classList.contains('aud');
PWA.register = () => {
  if (!PWA.can()) return;
  navigator.serviceWorker.register('/sw.js').then(reg => {
    reg.addEventListener('updatefound', () => { const w = reg.installing; w && w.addEventListener('statechange', () => { if (w.state === 'installed' && navigator.serviceWorker.controller) toast('Palco si è aggiornato: ricarica la pagina per usare le novità.', { icon: 'sparkles', ms: 6000 }); }); });
    if (navigator.serviceWorker.controller) PWA.ready = true; else navigator.serviceWorker.ready.then(() => { PWA.ready = true; if (!ST.meta.offlineTold) { ST.meta.offlineTold = 1; ST.saveMeta(); toast('Ora Palco funziona anche senza internet.', { icon: 'check', ms: 4500 }); } });
  }).catch(() => { });
};
window.addEventListener('beforeinstallprompt', e => { e.preventDefault(); PWA.prompt = e; if (typeof App !== 'undefined' && !(typeof ED !== 'undefined' && ED.active)) App.render(); });
window.addEventListener('appinstalled', () => { PWA.prompt = null; PWA.installed = true; toast('Palco è installato: lo trovi tra le tue app.', { icon: 'check', ms: 4000 }); if (!(typeof ED !== 'undefined' && ED.active)) App.render(); });
PWA.install = async () => { const p = PWA.prompt; if (!p) return; p.prompt(); try { await p.userChoice; } catch (e) { } PWA.prompt = null; App.render(); };
/* pulsanti nella barra della Home */
const pwaRender0 = App.render;
App.render = () => {
  pwaRender0();
  const top = $('.top'), sync = top && $('.sync', top); if (!top) return;
  if (PWA.prompt) top.insertBefore(h('button.btn.sm.primary.pwab', { onclick: PWA.install, title: 'Installa Palco come app sul dispositivo' }, icn('download', 16), h('span.hide-s', 'Installa l’app')), sync || null);
  if (!navigator.onLine) top.insertBefore(h('span.offl', { title: 'Le funzioni che usano internet (IA, immagini online, esportazioni con librerie esterne) non sono disponibili' }, icn('info', 16), 'Senza connessione'), sync || null);
};
window.addEventListener('offline', () => { toast('Sei offline: puoi continuare a lavorare, i progetti si salvano sul dispositivo.', { icon: 'info', ms: 4500 }); if (!(typeof ED !== 'undefined' && ED.active)) App.render(); });
window.addEventListener('online', () => { toast('Di nuovo online.', { icon: 'check', ms: 2000 }); if (!(typeof ED !== 'undefined' && ED.active)) App.render(); });
if (document.readyState === 'complete') PWA.register(); else window.addEventListener('load', PWA.register);

/* ============ Codice con i colori e formule matematiche (LaTeX) ============ */
const CODE = {};
CODE.LANGS = [['auto', 'Riconosci da solo'], ['js', 'JavaScript / TypeScript'], ['py', 'Python'], ['html', 'HTML'], ['css', 'CSS'], ['sql', 'SQL'], ['json', 'JSON'], ['sh', 'Shell'], ['java', 'Java / C / C# / C++'], ['go', 'Go / Rust'], ['php', 'PHP']];
CODE.THEMES = {
  oscuro: { n: 'Oscuro', bg: '#0F1424', fg: '#E6EDF7', kw: '#C792EA', str: '#C3E88D', num: '#F78C6C', com: '#5C6B8A', fn: '#82AAFF', type: '#FFCB6B', op: '#89DDFF', ln: '#46506E' },
  chiaro: { n: 'Chiaro', bg: '#F6F8FA', fg: '#24292F', kw: '#CF222E', str: '#0A3069', num: '#0550AE', com: '#6E7781', fn: '#8250DF', type: '#953800', op: '#0550AE', ln: '#B1B8C0' },
  dracula: { n: 'Dracula', bg: '#282A36', fg: '#F8F8F2', kw: '#FF79C6', str: '#F1FA8C', num: '#BD93F9', com: '#6272A4', fn: '#50FA7B', type: '#8BE9FD', op: '#FF79C6', ln: '#51546A' },
  tramonto: { n: 'Tramonto', bg: '#2B1B17', fg: '#FFE9D6', kw: '#FF7B54', str: '#FFD166', num: '#F4A259', com: '#8C6A5D', fn: '#9BE7C4', type: '#FFB4A2', op: '#FFD6A5', ln: '#6B4A3F' },
  neon: { n: 'Neon', bg: '#05070F', fg: '#D7F9FF', kw: '#FF2E97', str: '#00F0FF', num: '#C6FF3D', com: '#4D5B7C', fn: '#B388FF', type: '#FFE14D', op: '#7DF9FF', ln: '#2A3350' }
};
CODE.KW = {
  js: 'const let var function return if else for while do switch case break continue new class extends import from export default async await try catch finally throw typeof instanceof in of this super null undefined true false interface type enum implements public private protected static readonly void yield delete as',
  py: 'def class return if elif else for while in not and or is import from as with try except finally raise pass break continue lambda None True False self async await yield global nonlocal del assert',
  sql: 'select from where group by order having insert into values update set delete create table alter drop join left right inner outer on as and or not null is in like limit offset distinct union all primary key foreign references index view case when then else end',
  sh: 'if then else elif fi for while do done case esac function in echo export cd ls cat grep sudo apt npm git',
  java: 'public private protected static final class interface enum extends implements new return if else for while do switch case break continue try catch finally throw throws void int long float double boolean char string var const using namespace import package null true false this super async await struct typedef include',
  go: 'func package import var const type struct interface map chan go defer return if else for range switch case break continue select fn let mut pub impl trait use mod match loop while as self Self nil true false',
  php: 'function return if else elseif foreach for while as echo new class extends implements public private protected static namespace use try catch finally throw null true false array isset empty',
  json: 'true false null', css: '', html: ''
};
CODE.detect = (s) => {
  const t = s.trim();
  if (/^<!?[a-z]|<\/\w+>|<div|<span|<html/i.test(t)) return 'html';
  if (/^[\[{]/.test(t)) { try { JSON.parse(t); return 'json'; } catch (e) { } }
  if (/^\s*(def |import \w+$|from \w+ import|class \w+.*:|print\()/m.test(t) || /:\s*$/m.test(t) && !/[{;]/.test(t)) return 'py';
  if (/\b(select|insert into|update|delete from|create table)\b/i.test(t)) return 'sql';
  if (/^#!\/bin|^\$ |\bsudo\b|\bnpm (i|install)\b/m.test(t)) return 'sh';
  if (/^[\s\S]*?[.#a-z][^{]*\{[^}]*:[^}]*;?\s*\}/.test(t) && !/\b(function|const|let)\b/.test(t)) return 'css';
  if (/<\?php/.test(t)) return 'php';
  if (/\bfunc\b|\bfn\b|:=|\bpub\b/.test(t)) return 'go';
  if (/\b(public|private) (static )?(void|class|int|string)\b|#include/.test(t)) return 'java';
  return 'js';
};
/* ritorna le righe, ciascuna una lista di { t, k } */
CODE.tokenize = (src, lang) => {
  const kwSet = new Set((CODE.KW[lang] || '').split(' ').filter(Boolean)), ci = lang === 'sql', toks = [];
  let re;
  const com = { js: String.raw`\/\/[^\n]*|\/\*[\s\S]*?\*\/`, java: String.raw`\/\/[^\n]*|\/\*[\s\S]*?\*\/`, go: String.raw`\/\/[^\n]*|\/\*[\s\S]*?\*\/`, css: String.raw`\/\*[\s\S]*?\*\/`, py: String.raw`#[^\n]*`, sh: String.raw`#[^\n]*`, sql: String.raw`--[^\n]*|\/\*[\s\S]*?\*\/`, html: String.raw`<!--[\s\S]*?-->`, php: String.raw`\/\/[^\n]*|#[^\n]*|\/\*[\s\S]*?\*\/`, json: String.raw`(?!)` }[lang] || String.raw`(?!)`;
  const str = lang === 'py' ? String.raw`"""[\s\S]*?"""|'''[\s\S]*?'''|"(?:\\.|[^"\\\n])*"|'(?:\\.|[^'\\\n])*'` : String.raw`"(?:\\.|[^"\\\n])*"|'(?:\\.|[^'\\\n])*'|` + '`(?:\\\\.|[^`\\\\])*`';
  if (lang === 'html') re = new RegExp(`(${com})|(<\\/?[A-Za-z][\\w:-]*)|(${str})|(\\s[\\w:@-]+(?==))|(\\/?>)|([^<>"'\\s]+|\\s+)`, 'g');
  else re = new RegExp(`(${com})|(${str})|(#[0-9a-fA-F]{3,8}\\b|\\b0x[0-9a-fA-F]+\\b|-?\\b\\d+(?:\\.\\d+)?(?:e[+-]?\\d+)?(?:px|em|rem|vh|vw|%|s|ms)?)|(@?[A-Za-z_$][\\w$-]*)|(\\s+)|([\\s\\S])`, 'g');
  let m, last = 0;
  while ((m = re.exec(src))) {
    const s = m[0]; if (!s) { re.lastIndex++; continue; }
    if (lang === 'html') { const k = m[1] ? 'com' : m[2] ? 'kw' : m[3] ? 'str' : m[4] ? 'fn' : m[5] ? 'kw' : 'pl'; toks.push({ t: s, k }); continue; }
    let k = 'pl';
    if (m[1]) k = 'com'; else if (m[2]) { k = 'str'; if (lang === 'json') { const rest = src.slice(re.lastIndex).match(/^\s*:/); if (rest) k = 'fn'; } } else if (m[3]) k = 'num';
    else if (m[4]) { const w = s, lw = ci ? w.toLowerCase() : w, nxt = src[re.lastIndex] === '('; k = w[0] === '@' ? 'kw' : kwSet.has(lw) ? 'kw' : nxt ? 'fn' : (lang === 'css' && /^[a-z-]+$/.test(w) && /^\s*:/.test(src.slice(re.lastIndex)) ? 'fn' : /^[A-Z][A-Za-z0-9]*$/.test(w) && w.length > 1 && lang !== 'json' ? 'type' : 'pl'); }
    else if (m[6] && /[+\-*\/%=<>!&|^~?:;,.(){}\[\]]/.test(s)) k = 'op';
    toks.push({ t: s, k });
  }
  const lines = [[]];
  toks.forEach(tk => { tk.t.split('\n').forEach((part, i) => { if (i) lines.push([]); if (part) lines[lines.length - 1].push({ t: part, k: tk.k }); }); });
  return lines;
};
CODE.build = (o) => {
  const th = CODE.THEMES[o.theme] || CODE.THEMES.oscuro, lang = o.lang === 'auto' ? CODE.detect(o.src) : o.lang, src = String(o.src || '').replace(/\r/g, '').replace(/\t/g, '  ').replace(/\s+$/, '');
  const lines = CODE.tokenize(src, lang), nw = String(lines.length).length;
  const paras = lines.map((ln, i) => {
    const runs = []; if (o.ln) runs.push({ t: String(i + 1).padStart(nw, ' ') + '  ', c: th.ln });
    ln.forEach(tk => { const c = tk.k === 'pl' ? null : th[tk.k]; const last = runs[runs.length - 1]; if (last && (last.c || null) === c && !(o.ln && runs.length === 1 && i >= 0 && last.c === th.ln && c !== th.ln)) last.t += tk.t; else runs.push(c ? { t: tk.t, c } : { t: tk.t }); });
    return { r: runs.length ? runs : [] };
  });
  return { paras, th, lang, lines: lines.length, cols: Math.max(...lines.map(l => l.reduce((a, t) => a + t.t.length, 0)), 10) + (o.ln ? nw + 2 : 0) };
};
CODE.element = (o, base) => {
  const b = CODE.build(o), D = ED.deck, s = o.size, pad = Math.round(s * 1.1);
  const e = base || M.text({ text: '' });
  const w = base ? base.w : Math.round(Math.min(D.w * .86, Math.max(D.w * .34, b.cols * s * .61 + pad * 2)));
  Object.assign(e, { f: 'JetBrains Mono', s, c: b.th.fg, a: 'left', lh: 1.5, wt: 400, b: false, bg: b.th.bg, rad: Math.round(s * .7), pad, w, ls: 0, paras: b.paras, code: { src: o.src, lang: o.lang, theme: o.theme, size: o.size, ln: !!o.ln } });
  return e;
};
ED.codeDialog = async (edit) => {
