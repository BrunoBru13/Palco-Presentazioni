    if (!PR.on) return;
    const cx = W * (.15 + Math.random() * .7), cy = H * (.15 + Math.random() * .4), col = FX_COLORS[Math.floor(Math.random() * 7)], parts = [];
    PR.boom();
    for (let i = 0; i < 90; i++) {
      const a = Math.random() * 6.283, sp = 1.5 + Math.random() * 6.5;
      const p = { x: cx, y: cy, px: cx, py: cy, vx: Math.cos(a) * sp, vy: Math.sin(a) * sp, life: 1, c: i % 5 === 0 ? '#FFFFFF' : col };
      p.step = (x) => { p.px = p.x; p.py = p.y; p.vx *= .97; p.vy = p.vy * .97 + .06; p.x += p.vx; p.y += p.vy; p.life -= .014; x.globalAlpha = Math.max(0, p.life); x.strokeStyle = p.c; x.lineWidth = 2.5; x.lineCap = 'round'; x.beginPath(); x.moveTo(p.px, p.py); x.lineTo(p.x, p.y); x.stroke(); x.globalAlpha = 1; return p.life > 0; };
