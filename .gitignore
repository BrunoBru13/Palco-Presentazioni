  const b = M.unionBox(els), D = ED.deck, pad = Math.round(Math.min(D.w, D.h) * .04), x = Math.max(0, b.x - pad), y = Math.max(0, b.y - pad), w = Math.min(D.w - x, b.w + 2 * pad), hh = Math.min(D.h - y, b.h + 2 * pad);
