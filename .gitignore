    });
    const up = items.filter(i => Math.abs(i.ang) < .03), rot = items.filter(i => Math.abs(i.ang) >= .03);
    up.sort((a, b) => a.y - b.y || a.x - b.x);
    const lines = [];
    up.forEach(it => {
      const ln = lines.find(l => Math.abs(l.y - it.y) < Math.max(it.fs, l.fs) * .3 && it.x >= l.xe - it.fs * .6 && it.x - l.xe < it.fs * 3.2);
      if (ln) { const gap = it.x - ln.xe; ln.runs.push({ t: (gap > it.fs * .18 && !/^\s/.test(it.str) && !/\s$/.test(ln.runs[ln.runs.length - 1].t) ? ' ' : '') + it.str, b: it.font.b, i: it.font.i, f: it.font.f, c: it.c }); ln.xe = it.x + it.w; ln.fs = Math.max(ln.fs, it.fs); }
