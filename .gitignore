};
R.dash = st => st.d === 1 ? `stroke-dasharray="${st.w * 2.4},${st.w * 1.6}"` : st.d === 2 ? `stroke-dasharray="0.1,${st.w * 2}" stroke-linecap="round"` : '';

R.boxStyle = e => {
