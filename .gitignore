            const cxp = (p1[0] + p3[0]) / 2, cyp = (p1[1] + p3[1]) / 2;
            if (w < 3 || hh < 3) return;
            const e = M.image(ref, { x: Math.round(X(cxp) - w / 2), y: Math.round(Y(cyp) - hh / 2), w: Math.round(w), h: Math.round(hh), r: Math.abs(ang) > .01 ? Math.round(ang * 180 / Math.PI) : 0 });
            if (alpha < 1) e.o = alpha;
            els[idx] = e; stats.images++;
