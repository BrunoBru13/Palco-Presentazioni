    for (let i = 0; i < 38; i++) s += `<circle cx="${(r() * 1600).toFixed(0)}" cy="${(r() * 900).toFixed(0)}" r="${(30 + r() * 120).toFixed(0)}" fill="${cols[i % 3]}" opacity="${(.18 + r() * .4).toFixed(2)}"/>`;
    return s;
  }
});
const PAT_NAMES = ['confetti', 'grid', 'checks', 'zigzag', 'hexa', 'topo', 'halftone', 'plaid', 'sunburst', 'scales', 'memphis', 'lines', 'bubbles'];
const PAT_TITLES = { confetti: 'Coriandoli', grid: 'Griglia', checks: 'Scacchi', zigzag: 'Zigzag', hexa: 'Esagoni', topo: 'Curve di livello', halftone: 'Mezzatinta', plaid: 'Tartan', sunburst: 'Raggi', scales: 'Scaglie', memphis: 'Memphis', lines: 'Righe', bubbles: 'Bolle' };
const PAT_LIST = [];
PAT_NAMES.forEach((n, i) => { [(i * 3) % ART_PALS.length, (i * 3 + 5) % ART_PALS.length, (i * 3 + 9) % ART_PALS.length].forEach(p => PAT_LIST.push(`g:${n}:${p}`)); });

/* ============ Renderer DOM delle pagine ============ */
const R = {};
R.SHADOWS = { 1: { x: 0, y: 14, b: 30, c: 'rgba(8,12,30,.30)' }, 2: { x: 14, y: 14, b: 0, c: 'rgba(0,0,0,.88)' }, 3: { x: 0, y: 0, b: 44, c: 'rgba(255,255,255,.7)' } };
R.weight = e => e.wt || (e.b ? 700 : 400);

R.fillCss = f => {
  if (!f) return 'transparent';
  if (typeof f === 'string') return f;
  if (f.g) return `linear-gradient(${f.a == null ? 135 : f.a}deg,${f.g.map((c, i) => `${c} ${Math.round(i / (f.g.length - 1) * 100)}%`).join(',')})`;
  return 'transparent';
};
R.gradLine = (f, w, h) => {
  const a = ((f.a == null ? 135 : f.a) % 360) * Math.PI / 180, s = Math.sin(a), c = -Math.cos(a);
  const L = Math.abs(w * s) + Math.abs(h * c), cx = w / 2, cy = h / 2;
  return { x1: cx - s * L / 2, y1: cy - c * L / 2, x2: cx + s * L / 2, y2: cy + c * L / 2 };
};
R.svgFill = (f, id, w, h) => {
  if (!f) return { fill: 'none', defs: '' };
