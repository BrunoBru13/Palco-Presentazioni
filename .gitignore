const SYM_LIST = Object.keys(SYM);

/* ---- distintivi e bordi: nuove forme ---- */
P.ticket = (w, h) => { const r = Math.min(h * .14, w * .1); return `M0 0H${w}V${h / 2 - r}A${r} ${r} 0 0 0 ${w} ${h / 2 + r}V${h}H0V${h / 2 + r}A${r} ${r} 0 0 0 0 ${h / 2 - r}Z`; };
P.ribbon = (w, h) => polP([[0, 0], [w, 0], [w * .94, h / 2], [w, h], [0, h], [w * .06, h / 2]]);
P.tag = (w, h) => polP([[w * .22, 0], [w, 0], [w, h], [w * .22, h], [0, h / 2]]) + circP(w * .2, h / 2, Math.min(h * .08, w * .05));
P.pennant = (w, h) => polP([[0, 0], [w, h / 2], [0, h]]);
P.seal = (w, h) => starPath(w, h, 22, .9);
P.sunburst = (w, h) => starPath(w, h, 18, .62);
P.frame = (w, h, e) => { const t = Math.min(w, h) * clamp(e.rad == null ? .06 : e.rad / 100, .01, .4); return `M0 0H${w}V${h}H0ZM${t} ${t}V${h - t}H${w - t}V${t}Z`; };
P.frameR = (w, h, e) => { const t = Math.min(w, h) * clamp(e.rad == null ? .06 : e.rad / 100, .01, .4), r = Math.min(w, h) * .16; return rrP(0, 0, w, h, r) + rrP(t, t, w - 2 * t, h - 2 * t, Math.max(2, r - t * .7)); };
P.corners = (w, h, e) => { const t = Math.min(w, h) * clamp(e.rad == null ? .035 : e.rad / 100, .01, .2), l = Math.min(w, h) * .26; return `M0 0H${l}V${t}H${t}V${l}H0ZM${w} 0V${l}H${w - t}V${t}H${w - l}V0ZM0 ${h}H${l}V${h - t}H${t}V${h - l}H0ZM${w} ${h}V${h - l}H${w - t}V${h - t}H${w - l}V${h}Z`; };
P.halfring = (w, h, e) => { const t = Math.min(w, h) * clamp(e.rad == null ? .18 : e.rad / 100, .04, .45); return `M0 ${h}A${w / 2} ${h} 0 0 1 ${w} ${h}H${w - t}A${w / 2 - t} ${h - t} 0 0 0 ${t} ${h}Z`; };
P.zigzag = (w, h) => { const n = 8, top = [], bot = []; for (let i = 0; i <= n; i++) { const x = w * i / n, y = i % 2 ? h * .5 : 0; top.push([x, y]); bot.push([x, y + h * .5]); } return polP(top.concat(bot.reverse())); };
P.scallop = (w, h) => { const n = 8, r = w / n / 2; let d = `M0 0H${w}V${Math.max(0, h - r)}`; for (let i = 0; i < n; i++) d += `a${r} ${r} 0 0 1 ${-2 * r} 0`; return d + 'Z'; };
M.BADGE_LIST = [['ticket', 'Biglietto'], ['ribbon', 'Nastro'], ['tag', 'Cartellino prezzo'], ['pennant', 'Bandierina'], ['seal', 'Sigillo'], ['sunburst', 'Raggi'], ['halfring', 'Arco'], ['zigzag', 'Zigzag'], ['scallop', 'Festone'], ['frame', 'Bordo'], ['frameR', 'Bordo arrotondato'], ['corners', 'Angoli']];
M.SYM = SYM;

/* i simboli diventano forme: k = "sym:foglia" */
const pathOfPrev = M.pathOf;
M.pathOf = (e) => {
  const k = e.k;
  if (k && k.startsWith('sym:') && SYM[k.slice(4)]) { const w = Math.max(1, e.w), h = Math.max(1, e.h); return scalePath(SYM[k.slice(4)].d, w / 100, h / 100); }
  return pathOfPrev(e);
};

/* ============ Immagini astratte generate + registro immagini ============ */
function rngOf(seed) { let a = (seed * 2654435761) >>> 0; return () => { a |= 0; a = a + 0x6D2B79F5 | 0; let t = Math.imul(a ^ a >>> 15, 1 | a); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; }; }

const ART_PALS = [
  ['#FF6B4A', '#FFB84D', '#FFE3B8', '#3B1F5C'],
  ['#0E7C86', '#47C1BF', '#D6F4F0', '#0B2A5B'],
  ['#0B0F14', '#1B2A22', '#C6FF3D', '#3DDCFF'],
  ['#FF3D8B', '#FFD60A', '#FFF3C4', '#2B50FF'],
  ['#1F3D2B', '#4C8C5A', '#DDEBD1', '#F2B544'],
  ['#2B7FFF', '#8EC5FF', '#EAF4FF', '#FFD54A'],
  ['#111111', '#4A4A4A', '#EDEDED', '#FFE600'],
  ['#5B4BDB', '#A9A0FF', '#F1EEFF', '#FF7BAC']
];
const ART = {
  mesh(p, r) {
    let s = `<defs><filter id="b" x="-60%" y="-60%" width="220%" height="220%"><feGaussianBlur stdDeviation="95"/></filter></defs><rect width="1600" height="900" fill="${p[3]}"/><g filter="url(#b)">`;
    [p[0], p[1], p[2], p[0], p[1]].forEach(c => { s += `<circle cx="${Math.round(r() * 1600)}" cy="${Math.round(r() * 900)}" r="${Math.round(240 + r() * 220)}" fill="${c}"/>`; });
    return s + '</g>';
  },
  waves(p, r) {
    let s = `<rect width="1600" height="900" fill="${p[0]}"/>`;
    const cols = [p[1], p[2], p[3], p[1]];
    for (let i = 0; i < 4; i++) {
      const y = 300 + i * 140 + r() * 40, a = 90 + r() * 80;
      s += `<path d="M0 ${y}C400 ${y - a} 800 ${y + a} 1200 ${y}S1600 ${y - a / 2} 1600 ${y}V900H0Z" fill="${cols[i]}" opacity="${.55 + i * .15}"/>`;
    }
    return s;
  },
  blobs(p, r) {
    let s = `<rect width="1600" height="900" fill="${p[2]}"/>`;
    [p[0], p[1], p[3]].forEach((c, i) => {
      const cx = 250 + i * 560 + r() * 160, cy = 200 + r() * 500, rr = 260 + r() * 140, pts = [];
      for (let k = 0; k < 8; k++) { const a = k / 8 * Math.PI * 2, q = .7 + r() * .3; pts.push([cx + Math.cos(a) * rr * q, cy + Math.sin(a) * rr * q]); }
      let d = '';
      for (let k = 0; k < 8; k++) {
        const p0 = pts[(k + 7) % 8], p1 = pts[k], p2 = pts[(k + 1) % 8], p3 = pts[(k + 2) % 8];
        if (!k) d += `M${p1[0].toFixed(0)} ${p1[1].toFixed(0)}`;
        d += `C${(p1[0] + (p2[0] - p0[0]) / 6).toFixed(0)} ${(p1[1] + (p2[1] - p0[1]) / 6).toFixed(0)} ${(p2[0] - (p3[0] - p1[0]) / 6).toFixed(0)} ${(p2[1] - (p3[1] - p1[1]) / 6).toFixed(0)} ${p2[0].toFixed(0)} ${p2[1].toFixed(0)}`;
      }
      s += `<path d="${d}Z" fill="${c}" opacity=".92"/>`;
    });
    return s;
  },
  dots(p) {
    let s = `<rect width="1600" height="900" fill="${p[0]}"/>`;
    for (let y = 0; y < 900; y += 60) for (let x = 0; x < 1600; x += 60) {
      const d = Math.hypot(x - 1100, y - 300) / 900, rr = Math.max(2, 26 * (1 - d));
      s += `<circle cx="${x + 30}" cy="${y + 30}" r="${rr.toFixed(1)}" fill="${d < .45 ? p[3] : p[2]}" opacity="${(.35 + (1 - d) * .65).toFixed(2)}"/>`;
    }
    return s;
  },
  stripes(p) {
    let s = `<rect width="1600" height="900" fill="${p[0]}"/>`;
    const cols = [p[1], p[2], p[3], p[1]];
    for (let i = -2; i < 10; i++) s += `<path d="M${i * 220} 900L${i * 220 + 560} 0H${i * 220 + 560 + 110}L${i * 220 + 110} 900Z" fill="${cols[((i % 4) + 4) % 4]}" opacity=".85"/>`;
    return s;
  },
  rings(p) {
    let s = `<rect width="1600" height="900" fill="${p[0]}"/>`;
    for (let i = 0; i < 14; i++) s += `<circle cx="1180" cy="330" r="${60 + i * 62}" fill="none" stroke="${i % 3 ? p[1] : p[3]}" stroke-width="${i % 3 ? 5 : 11}" opacity="${(1 - i / 17).toFixed(2)}"/>`;
    return s + `<circle cx="1180" cy="330" r="46" fill="${p[2]}"/>`;
  },
  peaks(p, r) {
    let s = `<rect width="1600" height="900" fill="${p[2]}"/><circle cx="${Math.round(1000 + r() * 300)}" cy="260" r="130" fill="${p[3]}"/>`;
    const cols = [p[1], p[0], p[3]];
    cols.forEach((c, i) => {
      let d = `M0 900V${520 + i * 100}`; let x = 0;
      while (x < 1600) { x += 160 + r() * 140; d += `L${Math.min(x, 1600)} ${(380 + i * 110 + r() * 160).toFixed(0)}`; x += 120 + r() * 120; d += `L${Math.min(x, 1600)} ${(560 + i * 90 + r() * 80).toFixed(0)}`; }
      s += `<path d="${d}V900Z" fill="${c}" opacity="${.65 + i * .17}"/>`;
    });
    return s;
  },
  tiles(p, r) {
    let s = `<rect width="1600" height="900" fill="${p[2]}"/>`;
    const cols = [p[0], p[1], p[3], p[0]], sz = 225;
    for (let y = 0; y < 4; y++) for (let x = 0; x < 8; x++) {
      const c = cols[Math.floor(r() * 4)], t = Math.floor(r() * 4), X = x * sz, Y = y * sz;
      const paths = [`M${X} ${Y}h${sz}A${sz} ${sz} 0 0 1 ${X} ${Y + sz}Z`, `M${X + sz} ${Y}v${sz}A${sz} ${sz} 0 0 1 ${X} ${Y}Z`, `M${X + sz} ${Y + sz}h-${sz}A${sz} ${sz} 0 0 1 ${X + sz} ${Y}Z`, `M${X} ${Y + sz}v-${sz}A${sz} ${sz} 0 0 1 ${X + sz} ${Y + sz}Z`];
      s += `<path d="${paths[t]}" fill="${c}"/>`;
    }
    return s;
  }
};
const ART_NAMES = Object.keys(ART);
/* Combinazioni mostrate nel pannello Immagini */
const ART_LIST = [];
ART_NAMES.forEach((n, i) => { [i % 8, (i + 3) % 8, (i + 5) % 8].forEach(p => ART_LIST.push(`g:${n}:${p}`)); });

const _artCache = {};
function artURL(ref) {
  if (_artCache[ref]) return _artCache[ref];
  const [, style, pal, seed] = ref.split(':');
  const fn = ART[style] || ART.mesh;
  const p = /-/.test(pal || '') ? pal.split('-').map(x => '#' + x) : (ART_PALS[+pal % ART_PALS.length] || ART_PALS[0]);
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="1600" height="900" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice">${fn(p, rngOf(+seed || (style.length * 7 + (+pal || 5) * 13)))}</svg>`;
  return (_artCache[ref] = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg));
}

/* ============ Registro immagini ============ */
const BLANK_IMG = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';
const Img = {
  cache: new Map(), pending: new Set(), nat: new Map(),
  url(ref) {
    if (!ref) return BLANK_IMG;
    if (/^(data:|https?:|blob:|\/)/.test(ref)) return ref;
    if (ref.startsWith('g:')) return artURL(ref);
    if (ref.startsWith('a:')) return '/_blob/' + ref.slice(2);
    const c = Img.cache.get(ref);
    if (c) return c;
    if (!Img.pending.has(ref)) {
      Img.pending.add(ref);
      ST.loadImage(ref).then(u => { if (u) { Img.cache.set(ref, u); window.dispatchEvent(new Event('palco-img')); } }).catch(() => { });
    }
    return BLANK_IMG;
  },
  /* Dimensioni naturali (per inserire con il giusto rapporto) */
  size(ref) {
    return new Promise(res => {
      if (Img.nat.has(ref)) return res(Img.nat.get(ref));
      const im = new Image();
      im.onload = () => { const s = { w: im.naturalWidth || 1600, h: im.naturalHeight || 900 }; Img.nat.set(ref, s); res(s); };
      im.onerror = () => res({ w: 1600, h: 900 });
      im.src = Img.url(ref);
    });
  },
  /* Ridimensiona e comprime un file immagine, poi lo salva e restituisce il riferimento */
  async addFile(file) {
    if (!file || !/^image\//.test(file.type)) throw new Error('Formato non supportato');
    let blob = file;
    if (file.type !== 'image/svg+xml') {
      const bmp = await createImageBitmap(file);
      const draw = (maxSide, type, q) => new Promise(res => {
        const k = Math.min(1, maxSide / Math.max(bmp.width, bmp.height));
        const c = document.createElement('canvas'); c.width = Math.round(bmp.width * k); c.height = Math.round(bmp.height * k);
        c.getContext('2d').drawImage(bmp, 0, 0, c.width, c.height);
        c.toBlob(b => res(b), type, q);
      });
      const keepAlpha = /png|gif|webp/.test(file.type);
      blob = await draw(2200, keepAlpha ? 'image/png' : 'image/jpeg', .88);
      if (keepAlpha && blob.size > 2.5e6) blob = await draw(1800, 'image/webp', .9);
      if (!ST.assets && !window.indexedDB) {
        // senza archivio condiviso l'immagine deve stare in un documento piccolo
        let side = 1600;
        while (blob.size > 200000 && side > 320) { side = Math.round(side * .75); blob = await draw(side, keepAlpha && side > 700 ? 'image/webp' : 'image/jpeg', .8); }
      }
      bmp.close && bmp.close();
    }
    return Img.store(blob);
  },
  async store(blob) {
    if (ST.assets) {
      try {
        const r = await ST.assets.upload(blob);
        Img.cache.set('a:' + r.id, r.url);
        return 'a:' + r.id;
      } catch (err) { console.warn('upload', err); }
    }
    const data = await readFileAs(blob);
    const id = uid('');
    const ref = 'd:' + id;
    Img.cache.set(ref, data);
    const ok = await ST.saveImage(ref, data);
    if (ok) return ref;
    const mref = 'm:' + id;
    Img.cache.set(mref, data);
    return mref;
  }
};

/* ============ Colori delle immagini: rilevamento e modifica (senza IA) ============ */
/* Un colore CSS qualunque in #RRGGBB, oppure null se non è un colore pieno */
Col._ctx = null;
Col.norm = (v) => {
  v = String(v || '').trim().toLowerCase();
  if (!v || v === 'none' || v === 'transparent' || v === 'currentcolor' || v === 'inherit' || v.startsWith('url(')) return null;
  if (!Col._ctx) Col._ctx = document.createElement('canvas').getContext('2d');
  const c = Col._ctx; c.fillStyle = '#000000'; c.fillStyle = v; const a = c.fillStyle; c.fillStyle = '#ffffff'; c.fillStyle = v; const b = c.fillStyle;
  if (a !== b) return null;
  return Col.parse(a);
};
Col.dist = (a, b) => Math.hypot(a[0] - b[0], a[1] - b[1], a[2] - b[2]);

Img._url = Img.url;
Img.rcache = new Map(); Img.rjobs = new Map(); Img.pcache = new Map();
Img.hasRc = rc => !!(rc && Object.keys(rc).length);
Img.rkey = (ref, rc) => ref + '|' + Object.keys(rc).sort().map(k => k + '>' + rc[k]).join(',');
Img.url = (ref, rc) => {
  if (!Img.hasRc(rc)) return Img._url(ref);
  const c = Img.rcache.get(Img.rkey(ref, rc)); if (c) return c;
  Img.urlAsync(ref, rc).then(() => window.dispatchEvent(new Event('palco-img')));
  return Img._url(ref);
};
Img.urlAsync = (ref, rc) => {
  if (!Img.hasRc(rc)) return Promise.resolve(Img._url(ref));
  const k = Img.rkey(ref, rc);
  if (Img.rcache.has(k)) return Promise.resolve(Img.rcache.get(k));
  if (Img.rjobs.has(k)) return Img.rjobs.get(k);
  const p = Img.recolor(ref, rc).then(u => { Img.rcache.set(k, u); Img.rjobs.delete(k); return u; })
    .catch(e => { console.warn('colori', e); const u = Img._url(ref); Img.rcache.set(k, u); Img.rjobs.delete(k); return u; });
  Img.rjobs.set(k, p); return p;
};

Img.decodeData = (u) => {
  const i = u.indexOf(','), meta = u.slice(0, i), body = u.slice(i + 1);
  return /base64/.test(meta) ? new TextDecoder().decode(Uint8Array.from(atob(body), c => c.charCodeAt(0))) : decodeURIComponent(body);
};
/* carica la sorgente: o testo SVG, o un URL di una immagine raster */
Img.source = async (ref) => {
  let u;
  if ((ref.startsWith('d:') || ref.startsWith('m:')) && !Img.cache.get(ref)) { const d = await ST.loadImage(ref); if (d) Img.cache.set(ref, d); }
  u = Img._url(ref);
  if (/^data:image\/svg\+xml/.test(u)) return { svg: Img.decodeData(u) };
  if (u.startsWith('data:')) return { url: u };
  const r = await fetch(u), b = await r.blob();
  if (/svg/.test(b.type)) return { svg: await b.text() };
  return { url: URL.createObjectURL(b) };
};

/* ---- SVG ---- */
Img.svgEach = (doc, fn) => {
  doc.querySelectorAll('*').forEach(n => {
    ['fill', 'stroke', 'stop-color', 'flood-color', 'color'].forEach(a => {
      const v = n.getAttribute(a); if (!v) return;
      const c = Col.norm(v); if (!c) return;
      const r = fn(c); if (r) n.setAttribute(a, r);
    });
    const st = n.getAttribute('style');
    if (st) n.setAttribute('style', st.replace(/(fill|stroke|stop-color)\s*:\s*([^;]+)/g, (m, p, v) => { const c = Col.norm(v); if (!c) return m; const r = fn(c); return r ? p + ':' + r : m; }));
  });
};
Img.svgDoc = (svg) => { const d = new DOMParser().parseFromString(svg, 'image/svg+xml'); if (d.querySelector('parsererror')) throw new Error('svg'); return d; };
Img.svgPalette = (svg) => {
  const count = new Map();
  Img.svgEach(Img.svgDoc(svg), c => { count.set(c, (count.get(c) || 0) + 1); });
  return [...count.entries()].sort((a, b) => b[1] - a[1]).map(x => x[0]).slice(0, 8);
};
Img.svgRecolor = (svg, rc) => {
  const doc = Img.svgDoc(svg), map = {};
  Object.keys(rc).forEach(k => { map[k.toUpperCase()] = rc[k]; });
  Img.svgEach(doc, c => map[c] || null);
  return new XMLSerializer().serializeToString(doc.documentElement);
};
Img.svgURL = svg => 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg);

/* ---- raster ---- */
Img.rasterLoad = (url, maxSide = 900) => new Promise((res, rej) => {
  const im = new Image();
  im.onload = () => {
    const k = Math.min(1, maxSide / Math.max(im.naturalWidth, im.naturalHeight)), c = document.createElement('canvas');
    c.width = Math.max(1, Math.round(im.naturalWidth * k)); c.height = Math.max(1, Math.round(im.naturalHeight * k));
    const x = c.getContext('2d', { willReadFrequently: true }); x.drawImage(im, 0, 0, c.width, c.height);
    res({ c, x, id: x.getImageData(0, 0, c.width, c.height) });
  };
  im.onerror = () => rej(new Error('img')); im.src = url;
});
Img.rasterPalette = (id) => {
  const d = id.data, buckets = new Map(), step = Math.max(1, Math.floor(d.length / 4 / 6000)) * 4;
  const samples = [];
  for (let i = 0; i < d.length; i += step) {
    if (d[i + 3] < 128) continue;
    samples.push([d[i], d[i + 1], d[i + 2]]);
    const k = (d[i] >> 4) << 8 | (d[i + 1] >> 4) << 4 | (d[i + 2] >> 4);
    buckets.set(k, (buckets.get(k) || 0) + 1);
  }
  if (!samples.length) return [];
  const cents = [];
  [...buckets.entries()].sort((a, b) => b[1] - a[1]).forEach(([k]) => {
    if (cents.length >= 6) return;
    const c = [((k >> 8) & 15) * 16 + 8, ((k >> 4) & 15) * 16 + 8, (k & 15) * 16 + 8];
    if (cents.every(o => Col.dist(o, c) > 60)) cents.push(c);
  });
  for (let it = 0; it < 4; it++) {
    const sum = cents.map(() => [0, 0, 0, 0]);
    samples.forEach(s => { let bi = 0, bd = 1e9; cents.forEach((c, i) => { const q = Col.dist(c, s); if (q < bd) { bd = q; bi = i; } }); const t = sum[bi]; t[0] += s[0]; t[1] += s[1]; t[2] += s[2]; t[3]++; });
    sum.forEach((t, i) => { if (t[3]) cents[i] = [t[0] / t[3], t[1] / t[3], t[2] / t[3]]; });
  }
  const share = cents.map(() => 0);
  samples.forEach(s => { let bi = 0, bd = 1e9; cents.forEach((c, i) => { const q = Col.dist(c, s); if (q < bd) { bd = q; bi = i; } }); share[bi]++; });
  return cents.map((c, i) => ({ hex: Col.rgb2hex(...c), n: share[i] })).filter(x => x.n / samples.length > .02).sort((a, b) => b.n - a.n).map(x => x.hex);
};
Img.rasterRecolor = (r, rc) => {
  const pairs = Object.keys(rc).map(k => ({ f: Col.hex2rgb(k), d: Col.hex2rgb(rc[k]) })).map(p => ({ ...p, s: [p.d[0] - p.f[0], p.d[1] - p.f[1], p.d[2] - p.f[2]] }));
  const d = r.id.data, T = 80;
  for (let i = 0; i < d.length; i += 4) {
    if (d[i + 3] < 8) continue;
    const px = [d[i], d[i + 1], d[i + 2]]; let best = null, bd = T;
    for (const p of pairs) { const q = Col.dist(px, p.f); if (q < bd) { bd = q; best = p; } }
    if (!best) continue;
    const w = 1 - (bd / T) * (bd / T);
    d[i] = clamp(d[i] + best.s[0] * w, 0, 255); d[i + 1] = clamp(d[i + 1] + best.s[1] * w, 0, 255); d[i + 2] = clamp(d[i + 2] + best.s[2] * w, 0, 255);
  }
  r.x.putImageData(r.id, 0, 0);
  return r.c.toDataURL('image/png');
};

Img.recolor = async (ref, rc) => {
  const s = await Img.source(ref);
  if (s.svg) return Img.svgURL(Img.svgRecolor(s.svg, rc));
  const r = await Img.rasterLoad(s.url, 1600);
  return Img.rasterRecolor(r, rc);
};
/* colori principali (cache per riferimento) */
Img.palette = (ref) => {
  if (Img.pcache.has(ref)) return Img.pcache.get(ref);
  const p = (async () => {
    const s = await Img.source(ref);
    if (s.svg) return { kind: 'svg', colors: Img.svgPalette(s.svg) };
    const r = await Img.rasterLoad(s.url, 900);
    return { kind: 'raster', colors: Img.rasterPalette(r.id) };
  })().catch(e => { console.warn(e); Img.pcache.delete(ref); return { kind: 'err', colors: [] }; });
  Img.pcache.set(ref, p); return p;
};

/* ============ Pattern e motivi per la grafica (sfondi ripetuti) ============ */
ART_PALS.push(
  ['#1B1B3A', '#693668', '#F7EFE5', '#F4A261'],
  ['#264653', '#2A9D8F', '#F1FAEE', '#E9C46A'],
  ['#FF595E', '#FFCA3A', '#FDFCDC', '#1982C4'],
  ['#2D3142', '#BFC0C0', '#FFFFFF', '#EF8354'],
  ['#8338EC', '#FF006E', '#FFF1E6', '#3A86FF'],
  ['#606C38', '#DDA15E', '#FEFAE0', '#BC6C25'],
  ['#0D1B2A', '#415A77', '#E0E1DD', '#F72585'],
  ['#FFB5A7', '#FCD5CE', '#F8EDEB', '#9D8189']
);
Object.assign(ART, {
  confetti(p, r) {
    let s = `<rect width="1600" height="900" fill="${p[2]}"/>`;
    const cols = [p[0], p[1], p[3]];
    for (let i = 0; i < 170; i++) {
      const x = r() * 1600, y = r() * 900, c = cols[Math.floor(r() * 3)], a = Math.round(r() * 360), t = Math.floor(r() * 3), z = 26 + r() * 34;
      s += t === 0 ? `<rect x="${x.toFixed(0)}" y="${y.toFixed(0)}" width="${z.toFixed(0)}" height="${(z / 2.5).toFixed(0)}" fill="${c}" transform="rotate(${a} ${x.toFixed(0)} ${y.toFixed(0)})"/>`
        : t === 1 ? `<circle cx="${x.toFixed(0)}" cy="${y.toFixed(0)}" r="${(z / 2.4).toFixed(0)}" fill="${c}"/>`
          : `<path d="M${x.toFixed(0)} ${y.toFixed(0)}l${z.toFixed(0)} 0l-${(z / 2).toFixed(0)} ${(z * .9).toFixed(0)}Z" fill="${c}" transform="rotate(${a} ${x.toFixed(0)} ${y.toFixed(0)})"/>`;
    }
    return s;
  },
  grid(p) {
    let s = `<rect width="1600" height="900" fill="${p[2]}"/>`;
    for (let x = 0; x <= 1600; x += 80) s += `<path d="M${x} 0V900" stroke="${p[1]}" stroke-width="${x % 400 ? 2 : 5}" opacity="${x % 400 ? .35 : .8}"/>`;
    for (let y = 0; y <= 900; y += 80) s += `<path d="M0 ${y}H1600" stroke="${p[1]}" stroke-width="${y % 400 ? 2 : 5}" opacity="${y % 400 ? .35 : .8}"/>`;
    return s + `<circle cx="800" cy="440" r="14" fill="${p[3]}"/>`;
  },
  checks(p) {
    let s = `<rect width="1600" height="900" fill="${p[2]}"/>`;
    for (let y = 0; y < 9; y++) for (let x = 0; x < 16; x++) if ((x + y) % 2 === 0) s += `<rect x="${x * 100}" y="${y * 100}" width="100" height="100" fill="${(x * 3 + y * 7) % 11 === 0 ? p[3] : p[0]}"/>`;
    return s;
  },
  zigzag(p) {
    let s = `<rect width="1600" height="900" fill="${p[2]}"/>`;
    for (let row = 0; row < 14; row++) { let d = `M-40 ${row * 70}`; for (let x = 0; x <= 1680; x += 60) d += `L${x - 40 + 30} ${row * 70 + ((x / 60) % 2 ? 0 : 36)}`; s += `<path d="${d}" fill="none" stroke="${[p[0], p[1], p[3]][row % 3]}" stroke-width="14" stroke-linejoin="round"/>`; }
    return s;
  },
  hexa(p, r) {
    let s = `<rect width="1600" height="900" fill="${p[0]}"/>`;
    const R = 70, hh = Math.sqrt(3) * R;
    for (let row = -1; row < 9; row++) for (let col = -1; col < 14; col++) {
      const cx = col * R * 1.5, cy = row * hh + (col % 2 ? hh / 2 : 0), pts = [];
      for (let k = 0; k < 6; k++) pts.push(`${(cx + Math.cos(k * Math.PI / 3) * (R - 5)).toFixed(0)},${(cy + Math.sin(k * Math.PI / 3) * (R - 5)).toFixed(0)}`);
      const f = r() < .14 ? p[3] : r() < .2 ? p[1] : 'none';
      s += `<polygon points="${pts.join(' ')}" fill="${f}" stroke="${p[1]}" stroke-width="3" opacity="${f === 'none' ? .7 : .95}"/>`;
    }
    return s;
  },
  topo(p, r) {
    let s = `<rect width="1600" height="900" fill="${p[0]}"/>`;
    [[400, 300], [1150, 560], [1450, 150]].forEach(([cx, cy], k) => {
      const ph = [r() * 6, r() * 6, r() * 6];
      for (let i = 1; i < 14; i++) {
        const pts = []; for (let a = 0; a <= 64; a++) { const t = a / 64 * Math.PI * 2, rr = i * 34 * (1 + .16 * Math.sin(t * 3 + ph[0]) + .1 * Math.sin(t * 5 + ph[1])); pts.push(`${(cx + Math.cos(t) * rr).toFixed(0)},${(cy + Math.sin(t) * rr * .8).toFixed(0)}`); }
        s += `<polyline points="${pts.join(' ')}" fill="none" stroke="${i % 4 ? p[1] : p[3]}" stroke-width="${i % 4 ? 3 : 5}" opacity="${(.9 - i * .05).toFixed(2)}"/>`;
      }
    });
    return s;
  },
  halftone(p) {
    let s = `<rect width="1600" height="900" fill="${p[2]}"/>`;
    for (let y = 0; y < 900; y += 36) for (let x = 0; x < 1600; x += 36) { const d = (x / 1600 * .7 + y / 900 * .5), rr = Math.max(1, 16 * (1 - d / 1.2)); s += `<circle cx="${x + 18 + (y / 36 % 2 ? 18 : 0)}" cy="${y + 18}" r="${rr.toFixed(1)}" fill="${p[0]}"/>`; }
    return s;
  },
  plaid(p) {
    let s = `<rect width="1600" height="900" fill="${p[2]}"/>`;
    [0, 3].forEach((k, i) => { for (let x = 100; x < 1600; x += 400) s += `<rect x="${x + k * 30}" y="0" width="${i ? 40 : 120}" height="900" fill="${i ? p[3] : p[0]}" opacity="${i ? .55 : .4}"/>`; for (let y = 60; y < 900; y += 300) s += `<rect x="0" y="${y + k * 30}" width="1600" height="${i ? 36 : 100}" fill="${i ? p[3] : p[1]}" opacity="${i ? .55 : .4}"/>`; });
    return s;
  },
  sunburst(p) {
    let s = `<rect width="1600" height="900" fill="${p[2]}"/>`;
    const n = 28;
    for (let i = 0; i < n; i += 2) { const a1 = i / n * Math.PI * 2, a2 = (i + 1) / n * Math.PI * 2; s += `<path d="M800 450L${(800 + Math.cos(a1) * 2000).toFixed(0)} ${(450 + Math.sin(a1) * 2000).toFixed(0)}L${(800 + Math.cos(a2) * 2000).toFixed(0)} ${(450 + Math.sin(a2) * 2000).toFixed(0)}Z" fill="${i % 4 ? p[0] : p[1]}"/>`; }
    return s + `<circle cx="800" cy="450" r="120" fill="${p[3]}"/>`;
  },
  scales(p) {
    let s = `<rect width="1600" height="900" fill="${p[0]}"/>`;
    for (let row = 0; row < 21; row++) for (let col = -1; col < 17; col++) s += `<circle cx="${col * 100 + (row % 2 ? 50 : 0)}" cy="${row * 50}" r="52" fill="${(row + col) % 3 ? p[1] : p[3]}" stroke="${p[0]}" stroke-width="5"/>`;
    return s;
  },
  memphis(p, r) {
    let s = `<rect width="1600" height="900" fill="${p[2]}"/>`;
    const cols = [p[0], p[1], p[3]];
    for (let i = 0; i < 46; i++) {
      const x = r() * 1600, y = r() * 900, c = cols[i % 3], t = i % 5, z = 56 + r() * 70, a = Math.round(r() * 360);
      s += t === 0 ? `<circle cx="${x.toFixed(0)}" cy="${y.toFixed(0)}" r="${(z / 2).toFixed(0)}" fill="none" stroke="${c}" stroke-width="10"/>`
        : t === 1 ? `<path d="M${x.toFixed(0)} ${y.toFixed(0)}l${z.toFixed(0)} 0l-${(z / 2).toFixed(0)} -${(z * .87).toFixed(0)}Z" fill="${c}" transform="rotate(${a} ${x.toFixed(0)} ${y.toFixed(0)})"/>`
          : t === 2 ? `<path d="M${x.toFixed(0)} ${y.toFixed(0)}q${(z / 4).toFixed(0)} -${(z / 2).toFixed(0)} ${(z / 2).toFixed(0)} 0t${(z / 2).toFixed(0)} 0t${(z / 2).toFixed(0)} 0" fill="none" stroke="${c}" stroke-width="9" stroke-linecap="round"/>`
            : t === 3 ? `<path d="M${x.toFixed(0)} ${(y - z / 2).toFixed(0)}v${z.toFixed(0)}M${(x - z / 2).toFixed(0)} ${y.toFixed(0)}h${z.toFixed(0)}" stroke="${c}" stroke-width="10" stroke-linecap="round"/>`
              : `<rect x="${x.toFixed(0)}" y="${y.toFixed(0)}" width="${z.toFixed(0)}" height="${(z * .6).toFixed(0)}" rx="8" fill="${c}" transform="rotate(${a} ${x.toFixed(0)} ${y.toFixed(0)})"/>`;
    }
    return s;
  },
  lines(p) {
    let s = `<rect width="1600" height="900" fill="${p[0]}"/>`;
    for (let i = -10; i < 40; i++) s += `<path d="M${i * 60} 0L${i * 60 + 900} 900" stroke="${i % 5 ? p[1] : p[3]}" stroke-width="${i % 5 ? 4 : 12}" opacity="${i % 5 ? .55 : .95}"/>`;
    return s;
  },
  bubbles(p, r) {
