  rec.onend = () => { if (VOICE.rec === rec) { try { rec.start(); } catch (er) { VOICE.stop(); } } };
  try { rec.start(); VOICE.rec = rec; VOICE.btn = btn; btn.classList.add('rec'); toast('Sto ascoltando: parla e di’ “virgola”, “punto”, “a capo”.', { icon: 'mic', ms: 3000 }); } catch (e) { toast('Non riesco ad avviare il microfono', { type: 'err' }); }
};
VOICE.micBtn = (getTarget, o = {}) => {
