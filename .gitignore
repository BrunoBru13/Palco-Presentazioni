};

/* ---- Testo ---- */
ED.COMBOS = [
  { n: 'Moderno', t: [{ text: 'Titolo audace', f: 'Poppins', wt: 800, s: 110 }, { text: 'Una frase di spiegazione chiara e breve', f: 'Poppins', wt: 400, s: 42 }] },
  { n: 'Elegante', t: [{ text: 'Titolo elegante', f: 'Playfair Display', wt: 700, s: 110 }, { text: 'SOTTOTITOLO IN MAIUSCOLO', f: 'Work Sans', wt: 600, s: 34, ls: .22 }] },
  { n: 'Editoriale', t: [{ text: 'Una storia da raccontare', f: 'DM Serif Display', wt: 400, s: 112 }, { text: 'Testo di accompagnamento in stile rivista.', f: 'Work Sans', wt: 400, s: 40 }] },
  { n: 'Tecnico', t: [{ text: 'Titolo tecnico', f: 'Space Grotesk', wt: 700, s: 108 }, { text: 'valori, dati, note a margine', f: 'Space Mono', wt: 400, s: 36 }] },
  { n: 'Manifesto', t: [{ text: 'GRANDE', f: 'Bebas Neue', wt: 400, s: 240, lh: .9 }, { text: 'Parole poche, ma messe bene', f: 'Rubik', wt: 500, s: 44 }] },
  { n: 'A mano', t: [{ text: 'Appunti veloci', f: 'Caveat', wt: 700, s: 150 }, { text: 'Idee scritte al volo', f: 'Nunito', wt: 600, s: 44 }] }
];
ED.panels.text = () => {
  const fg = ED.themeTxt().fg;
  const presets = [['Aggiungi un titolo', { text: 'Titolo', s: 120, wt: 800, f: ST.brand.head, lh: 1.05 }, 'tp1'], ['Aggiungi un sottotitolo', { text: 'Sottotitolo', s: 64, wt: 600, f: ST.brand.head }, 'tp2'], ['Aggiungi un testo normale', { text: 'Scrivi qui il tuo testo', s: 44, f: ST.brand.body }, 'tp3']];
  return [
    h('button.btn.primary.full', { onclick: () => ED.addText() }, icn('plus', 18), 'Aggiungi una casella di testo'),
    psec('Stili predefiniti', h('div.tplist', presets.map(([l, o, c]) => h('button.tpb.' + c, { style: { fontFamily: fontStack(o.f), fontWeight: o.wt || 400 }, onclick: () => ED.addText({ ...o, w: 1000 }) }, l)))),
    psec('Combinazioni di font', h('div.combos', ED.COMBOS.map(c => h('button.combo', { onclick: async () => {
      await loadFonts(c.t.map(x => [x.f, x.wt]));
      const D = ED.deck; let y = Math.round(D.h * .3); const ids = [];
      c.t.forEach((o, i) => { const e = M.text({ w: Math.round(D.w * .7), c: fg, a: 'left', ...o }); R.fitHeight(e); e.x = Math.round(D.w * .1); e.y = y; y += e.h + 24; ED.slide().els.push(e); ids.push(e.id); });
      ED.sel = ids; ED.renderStage(); ED.renderOverlay(); ED.renderCtx(); ED.updateThumb(ED.si); ED.commit();
    } }, h('span.cb1', { style: { fontFamily: fontStack(c.t[0].f), fontWeight: c.t[0].wt, letterSpacing: (c.t[0].ls || 0) + 'em' } }, c.t[0].text.length > 14 ? c.n : c.t[0].text), h('span.cb2', { style: { fontFamily: fontStack(c.t[1].f) } }, c.t[1].text))))),
    psec('Font del marchio', h('div.tplist', [[ST.brand.head, 'Titoli'], [ST.brand.body, 'Testo']].map(([f, l]) => h('button.tpb', { style: { fontFamily: fontStack(f), fontSize: '18px' }, onclick: () => ED.addText({ f, text: l === 'Titoli' ? 'Titolo' : 'Testo', s: l === 'Titoli' ? 110 : 44, wt: l === 'Titoli' ? 700 : 400 }) }, f, h('small', ' · ' + l)))))
  ];
};

/* ---- Immagini ---- */
ED.uploadImages = async (files, asBg) => {
  for (const f of files) {
    try {
      toast('Carico “' + f.name + '”…', { ms: 1200 });
      const ref = await Img.addFile(f);
      (ED.deck.imgs = ED.deck.imgs || []).unshift(ref);
      if (asBg) { ED.setBg({ img: ref, dim: 0 }); } else await ED.addImage(ref);
    } catch (e) { console.warn(e); toast('Non riesco a usare questo file', { type: 'err' }); }
  }
  if (ED.panel === 'images') ED.renderPanel();
};
ED.panels.images = () => {
  const drop = h('button.drop', { onclick: () => UI.pickFile('image/*', true, fs => ED.uploadImages(fs)) }, icn('upload', 26), h('b', 'Carica immagini'), h('small', 'oppure trascinale sulla pagina'));
  const mine = (ED.deck.imgs || []).slice(0, 18);
  const secs = [drop];
  if (ST.brand.logo) secs.push(psec('Logo del marchio', h('button.imgb.logo', { data: { ref: ST.brand.logo }, onclick: () => ED.addImage(ST.brand.logo) }, h('img', { src: Img.url(ST.brand.logo), alt: 'Logo' }))));
  if (mine.length) secs.push(psec('Caricamenti', h('div.imggrid', mine.map(r => h('button.imgb', { data: { ref: r }, onclick: () => ED.addImage(r) }, h('img', { src: Img.url(r), alt: '' }))))));
  secs.push(psec('Immagini astratte', h('div.imggrid', ART_LIST.map(r => h('button.imgb', { data: { ref: r }, onclick: () => ED.addImage(r, { w: 960, h: 540 }) }, h('img', { src: Img.url(r), alt: '', loading: 'lazy' }))))));
  return secs;
};

/* ---- Sfondo ---- */
ED.setBg = (bg, all) => {
  if (all) ED.deck.slides.forEach(s => s.bg = clone(bg)); else ED.slide().bg = clone(bg);
  ED.renderStage(); ED.renderCtx(); ED.updateThumb(ED.si); if (all) ED.renderStrip(); ED.commit();
};
ED.panels.bg = () => {
  let all = false;
  const cb = h('label.chk', h('input', { type: 'checkbox', onchange: e => { all = e.target.checked; } }), 'Applica a tutte le pagine');
  const cur = ED.slide().bg;
  const brand = ST.brand.colors;
  return [cb,
    psec('Colore dello sfondo', h('button.btn.full', { onclick: e => UI.colorPop(e.currentTarget, typeof cur === 'string' ? cur : null, (c, live) => { ED.setBg(c, all); }, { grad: true, docColors: ED.docColors() }) }, h('span.dot', { style: { background: R.bgCss(cur).startsWith('url') ? '#888' : R.bgCss(cur) } }), 'Scegli un colore o una sfumatura')),
    psec('Colori del marchio', h('div.swgrid', brand.map(c => h('button.sw', { style: { background: c }, 'aria-label': c, onclick: () => ED.setBg(c, all) })))),
    psec('Sfumature', h('div.swgrid.g6', UI.GRADS.map(([cs, a]) => h('button.sw.big', { style: { background: `linear-gradient(${a}deg,${cs[0]},${cs[1]})` }, onclick: () => ED.setBg({ g: cs.slice(), a }, all) })))),
    psec('Immagini', h('button.btn.full', { onclick: () => UI.pickFile('image/*', false, fs => ED.uploadImages(fs, true)) }, icn('upload', 18), 'Carica uno sfondo'),
      h('div.imggrid', ART_LIST.map(r => h('button.imgb', { onclick: () => ED.setBg({ img: r, dim: 0 }, all) }, h('img', { src: Img.url(r), alt: '', loading: 'lazy' })))))
  ];
};

/* ---- Livelli ---- */
ED.layerName = e => e.t === 'text' ? (M.plain(e).split('\n')[0] || 'Testo').slice(0, 28) : e.t === 'image' ? 'Immagine' : e.t === 'chart' ? 'Grafico' : e.t === 'table' ? 'Tabella' : e.t === 'group' ? 'Gruppo' : e.k === 'path' ? 'Disegno' : e.k === 'line' ? 'Linea' : ((M.SHAPE_LIST.find(s => s[0] === e.k) || [])[1] || (e.k.startsWith('icon:') ? 'Icona' : 'Forma'));
/* sposta un elemento nell'ordine dei livelli (0 = sotto a tutti) */
ED.moveLayer = (id, to) => {
  const s = ED.slide(), i = s.els.findIndex(e => e.id === id); if (i < 0) return;
  const [e] = s.els.splice(i, 1); s.els.splice(clamp(to, 0, s.els.length), 0, e); ED.refresh({ tb: false });
