/* tracciato -> elemento forma */
PDFI.shape = (pend, fill, stroke, lw, alpha, k, ox, oy, W, H, pw, ph) => {
  const { ops, co, ctm } = pend, OPS = pdfjsLib.OPS, segs = [], pts = []; let i = 0, cur = null, nrect = 0, nops = 0;
  const P = (x, y) => { const q = mpt(ctm, x, y), r = [q[0] * k + ox, q[1] * k + oy]; pts.push(r); return r; };
  ops.forEach(op => {
    nops++;
    if (op === OPS.moveTo) { cur = P(co[i++], co[i++]); segs.push(['M', cur]); }
    else if (op === OPS.lineTo) { cur = P(co[i++], co[i++]); segs.push(['L', cur]); }
    else if (op === OPS.curveTo) { const a = P(co[i++], co[i++]), b = P(co[i++], co[i++]), c = P(co[i++], co[i++]); segs.push(['C', a, b, c]); cur = c; }
    else if (op === OPS.curveTo2) { const b = P(co[i++], co[i++]), c = P(co[i++], co[i++]); segs.push(['C', cur || b, b, c]); cur = c; }
    else if (op === OPS.curveTo3) { const a = P(co[i++], co[i++]), c = P(co[i++], co[i++]); segs.push(['C', a, c, c]); cur = c; }
    else if (op === OPS.closePath) segs.push(['Z']);
    else if (op === OPS.rectangle) { const x = co[i++], y = co[i++], w = co[i++], h = co[i++]; const a = P(x, y), b = P(x + w, y), c = P(x + w, y + h), d = P(x, y + h); segs.push(['M', a], ['L', b], ['L', c], ['L', d], ['Z']); nrect++; cur = a; }
  });
  if (!pts.length) return null;
  const xs = pts.map(p => p[0]), ys = pts.map(p => p[1]), x0 = Math.min(...xs), y0 = Math.min(...ys), x1 = Math.max(...xs), y1 = Math.max(...ys), w = x1 - x0, h = y1 - y0;
  const scale = Math.hypot(ctm[0], ctm[1]) * k;
  if (fill && !stroke && w >= W * .92 && h >= H * .92 && alpha >= .99) return { bgColor: fill };
  if (!stroke && w * h < 3) return null;
