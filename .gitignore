    if (st) body.append(TB.slider('Spessore', 1, 40, st.w, 1, (x, v) => { x.st.w = v; }, v => v + ' px'), h('div.cph', 'Stile'), UI.seg([[0, 'Continuo'], [1, 'Tratteggio'], [2, 'Punti']], st.d || 0, v => { TB.apply(x => { x.st.d = v; }); draw(); }));
    if (['round', 'rect'].includes(e0.k)) body.append(TB.slider('Angoli', 0, Math.round(Math.min(e0.w, e0.h) / 2), Math.round(e0.rad == null ? Math.min(e0.w, e0.h) * .18 : e0.rad), 1, (x, v) => { x.k = 'round'; x.rad = v; }, v => v + ' px'));
  };
  draw(); UI.pop(anchor, body, { cls: 'ppop' });
};

/* ---- immagini ---- */
TB.FILTERS = [['Nessuno', null], ['Bianco e nero', { gs: 1 }], ['Seppia', { sp: .8 }], ['Vivace', { sa: 1.5, ct: 1.1 }], ['Tenue', { sa: .7, br: 1.08, ct: .92 }], ['Freddo', { hu: 190, sa: 1.2 }]];
TB.imgPop = (anchor) => {
  const e0 = ED.selEls()[0], f = e0.fx || {};
  const set = (k, v) => (x, val) => { x.fx = x.fx || {}; x.fx[k] = val == null ? v : val; };
  const body = h('div.pp', h('div.cph', 'Filtri'), h('div.btnrow.g3', TB.FILTERS.map(([n, fx]) => h('button.btn.sm', { onclick: () => { TB.apply(x => { x.fx = fx ? { ...fx } : null; }); UI.closePops(); } }, n))),
    h('div.cph', 'Regolazioni'),
