/* ---- barra ---- */
ED.renderCtx = () => {
  const c = $('#ctx'); if (!c) return;
  c.innerHTML = '';
  const els = ED.selEls(), D = ED.deck;
  const kinds = new Set(els.map(e => e.t === 'shape' ? (e.k === 'line' ? 'line' : 'shape') : e.t));
  const out = [];
  const tail = (anim = true) => {
    out.push(h('div.grow'));
    if (els.length === 1) out.push(TB.btn('drop', 'Copia lo stile e applicalo a un altro elemento', ED.copyStyle, !!ED.painter, 'Copia stile'));
    if (anim) out.push(TB.btn('zap', 'Animazione', (a) => TB.animPop(a), els.some(R.hasAnim), 'Anima'));
    out.push(TB.btn('move', 'Posizione', a => TB.posPop(a), false, 'Posizione'));
    out.push(TB.sep(), TB.btn(els.some(e => e.lk) ? 'lock' : 'unlock', els.some(e => e.lk) ? 'Sblocca' : 'Blocca', () => ED.mut(e => e.lk = e.lk ? 0 : 1), els.some(e => e.lk)),
      TB.btn('dup', 'Duplica (Ctrl+D)', ED.duplicateSel), TB.btn('trash', 'Elimina (Canc)', ED.deleteSel));
  };
  if (!els.length) {
    const s = ED.slide(), trs = [['none', 'Nessuna'], ['fade', 'Dissolvenza'], ['slide', 'Scorrimento'], ['zoom', 'Zoom']];
    out.push(TB.btn(null, 'Colore di sfondo', a => UI.colorPop(a, typeof s.bg === 'string' ? s.bg : null, v => ED.setBg(v), { grad: true, docColors: ED.docColors() }), false, 'Sfondo pagina'),
      TB.btn('film', 'Transizione', a => UI.menu(a, trs.map(([k, l]) => ({ label: l, on: (s.tr || 'none') === k, onclick: () => { s.tr = k; ED.commit(); ED.renderCtx(); } }))), false, 'Transizione: ' + (trs.find(t => t[0] === (s.tr || 'none')) || [])[1]),
      TB.btn('zap', 'Anima tutti gli elementi della pagina', a => TB.pageAnimMenu(a), s.els.some(R.hasAnim), 'Anima pagina'),
      TB.btn('tag', 'Numeri di pagina', a => TB.pageNumPop(a), !!(D.pn && D.pn.on), 'Numeri'),
      TB.btn('expand', 'Cambia formato (crea una copia)', ED.resizeDialog, false, 'Formato'),
      TB.sep(), h('span.tbinfo', `${D.w} × ${D.h} px`), h('div.grow'), h('span.tbinfo', 'Clicca su un elemento per modificarlo'));
    out[0].prepend(h('span.dot', { style: { background: typeof s.bg === 'string' ? s.bg : R.fillCss(s.bg).startsWith('url') ? '#888' : R.fillCss(s.bg) } }));
  } else if (els.length > 1) {
    out.push(TB.btn('layers', 'Raggruppa (Ctrl+G)', ED.group, false, 'Raggruppa'), TB.btn('align', 'Allinea', a => TB.alignMulti(a), false, 'Allinea'), h('span.tbinfo', els.length + ' elementi selezionati'));
    if (els.every(e => e.t === 'text')) out.push(TB.sep(), ...TB.textTools(els));
    tail();
  } else {
    const e = els[0];
    if (e.t === 'text') { out.push(...TB.textTools(els)); tail(); }
    else if (e.t === 'shape' && e.k !== 'line') {
      out.push(TB.swatch(e.f, 'Colore di riempimento', a => UI.colorPop(a, e.f, (v, live) => { ED.mut(x => { x.f = v; }, live ? { tb: false, now: false } : { tb: false }); }, { grad: true, none: 'Nessun riempimento', docColors: ED.docColors() })),
        TB.btn('corner', 'Contorno e angoli', a => TB.strokePop(a, e), !!e.st, 'Contorno'), TB.btn('sliders', 'Effetti', a => TB.fxPop(a), !!e.sh || (e.o != null && e.o < 1), 'Effetti'));
      tail();
    } else if (e.t === 'shape') {
      out.push(TB.swatch(e.st.c, 'Colore della linea', a => UI.colorPop(a, e.st.c, v => { if (typeof v === 'string') ED.mut(x => { x.st.c = v; }, { tb: false }); }, { docColors: ED.docColors() })),
        h('div.tbg', h('label.tinl', 'Spessore', h('input', { type: 'range', min: 1, max: 40, value: e.st.w, 'aria-label': 'Spessore', oninput: ev => TB.apply(x => { x.st.w = +ev.target.value; }, true), onchange: () => ED.renderCtx() }))),
        UI.seg([[0, 'Continua'], [1, 'Tratteggio'], [2, 'Punti']], e.st.d || 0, v => { ED.mut(x => { x.st.d = v; }); }),
        UI.seg([[0, 'Nessuna', 'minus'], [1, 'Fine', 'arrowUp'], [2, 'Entrambe', 'arrowDown']].map(([v, l]) => [v, l === 'Nessuna' ? 'Senza frecce' : l === 'Fine' ? 'Freccia alla fine' : 'Frecce ai lati', v === 0 ? 'minus' : v === 1 ? 'chevR' : 'chevL']), e.ar || 0, v => { ED.mut(x => { x.ar = v; }); }),
        TB.btn('sliders', 'Effetti', a => TB.fxPop(a), !!e.sh, 'Effetti'));
      tail();
    } else if (e.t === 'image') {
      out.push(TB.btn('upload', 'Sostituisci l’immagine', a => ED.replaceMenu(a, e), false, 'Sostituisci'), TB.btn('scale', 'Rimuovi lo sfondo', a => TB.bgPop(a, e), !!e.orig, 'Senza sfondo'), TB.btn('palette', 'Cambia i colori dell’immagine', a => TB.imgColors(a, e), Img.hasRc(e.rc), 'Colori'), TB.btn('sliders', 'Filtri e forma', a => TB.imgPop(a), !!e.fx || !!e.rad, 'Modifica'), TB.btn('flipH', 'Specchia', () => ED.mut(x => { x.fl = x.fl ? 0 : 1; }), !!e.fl, 'Specchia'),
        TB.btn('corner', 'Effetti', a => TB.fxPop(a), !!e.sh, 'Effetti'), TB.btn('image', 'Usa come sfondo', () => { ED.setBg({ img: e.src, dim: 0 }); toast('Immagine usata come sfondo'); }, false, 'Come sfondo'));
      tail();
    } else if (e.t === 'chart') {
      out.push(UI.seg([['bar', 'Barre', 'chart'], ['line', 'Linee', 'trend'], ['pie', 'Torta', 'target'], ['donut', 'Ciambella', 'target']].map(([k, l]) => [k, l, k === 'bar' ? 'chart' : k === 'line' ? 'zap' : 'sparkles']), e.k, v => { ED.mut(x => { x.k = v; if ((v === 'pie' || v === 'donut') && x.legend === false) x.legend = true; }); }),
        TB.btn('edit', 'Modifica i dati', () => ED.chartEditor(e), false, 'Dati'), TB.btn('palette', 'Colori', a => TB.chartColors(a, e), false, 'Colori'),
        TB.btn(null, 'Legenda', () => ED.mut(x => { x.legend = !x.legend; }), e.legend, 'Legenda'), TB.btn(null, 'Valori', () => ED.mut(x => { x.vals = !x.vals; }), e.vals, 'Valori'), TB.btn(null, 'Griglia', () => ED.mut(x => { x.grid = !x.grid; }), e.grid, 'Griglia'));
      tail();
    } else if (e.t === 'group') {
      if (e.qr) out.push(TB.btn('edit', 'Cambia il testo del codice QR', () => ED.editQR(e), false, 'Testo QR'), TB.swatch(e.els[1].f, 'Colore del codice', a => UI.colorPop(a, e.els[1].f, v => { if (typeof v === 'string') ED.mut(x => { x.els[1].f = v; }, { tb: false }); }, { docColors: ED.docColors() })), TB.swatch(e.els[0].f, 'Colore dello sfondo', a => UI.colorPop(a, e.els[0].f, v => { if (typeof v === 'string') ED.mut(x => { x.els[0].f = v; }, { tb: false }); }, { docColors: ED.docColors() })));
      out.push(TB.btn('layers', 'Separa il gruppo (Ctrl+Maiusc+G)', ED.ungroup, false, 'Separa'), h('span.tbinfo', e.qr ? 'Codice QR' : 'Gruppo di ' + e.els.length + ' elementi'), TB.btn('sliders', 'Effetti', a => TB.fxPop(a), !!e.sh, 'Effetti'));
      tail();
    } else if (e.t === 'table') {
      out.push(TB.btn('table', 'Righe, colonne e colori', a => TB.tablePop(a, e), false, 'Tabella'), h('span.tbinfo', 'Doppio clic su una cella per scrivere'));
      tail();
    }
  }
  c.append(...out);
};

/* strumenti del testo (anche per più caselle) */
TB.textTools = (els) => {
  const e = els[0], one = els.length === 1;
  const mix = (get) => els.every(x => get(x) === get(e));
  const size = Math.round(e.s);
  const sizeIn = h('input.tsize', { type: 'number', min: 6, max: 600, value: size, 'aria-label': 'Dimensione del testo', onmousedown: ev => ev.stopPropagation(),
    oninput: ev => { const v = +ev.target.value; if (v >= 6) TB.apply(x => { x.s = v; }, true); }, onchange: () => { ED.commit(); ED.renderCtx(); } });
  const step = d => () => ED.mut(x => { x.s = clamp(Math.round(x.s + d), 6, 600); });
  const firstRun = ED.editing ? null : e.c;
  return [
    h('button.tbb.fontb', { title: 'Font', onmousedown: ev => ev.preventDefault(), onclick: ev => UI.fontPop(ev.currentTarget, e.f, f => { loadFont(f, 400); loadFont(f, 700); ED.mut(x => { x.f = f; }, { tb: true }); UI.closePops(); }) }, h('span', { style: { fontFamily: fontStack(e.f) } }, e.f), icn('chevD', 14)),
    TB.group(TB.btn('minus', 'Riduci', step(-2)), sizeIn, TB.btn('plus', 'Aumenta', step(2))),
    TB.swatch(firstRun || e.c, 'Colore del testo', a => { const saved = ED.editing ? (getSelection().rangeCount ? getSelection().getRangeAt(0).cloneRange() : null) : null; UI.colorPop(a, e.c, (v, live) => { if (typeof v !== 'string') return; if (saved) { const s = getSelection(); s.removeAllRanges(); s.addRange(saved); } ED.fmt('c', v); }, { docColors: ED.docColors() }); }, { letter: 'A' }),
    TB.btn('bold', 'Grassetto (Ctrl+B)', () => ED.fmt('b'), mix(x => R.weight(x) >= 600) && R.weight(e) >= 600),
    TB.btn('italic', 'Corsivo (Ctrl+I)', () => ED.fmt('i'), mix(x => !!x.i) && !!e.i),
    TB.btn('underline', 'Sottolineato (Ctrl+U)', () => ED.fmt('u'), mix(x => !!x.u) && !!e.u),
    TB.btn(null, 'Maiuscolo', () => ED.mut(x => { x.up = !x.up; }), !!e.up, 'aA'),
    TB.sep(),
    TB.btn(e.a === 'center' ? 'alignC' : e.a === 'right' ? 'alignR' : e.a === 'justify' ? 'alignJ' : 'alignL', 'Allineamento e spaziatura', a => TB.spacePop(a), false),
    TB.btn('list', 'Elenco puntato', () => ED.mut(x => { const on = x.paras.every(p => p.l === 'b'); x.paras.forEach(p => { if (on) delete p.l; else p.l = 'b'; }); }), els.every(x => x.paras.every(p => p.l === 'b'))),
    TB.btn('listN', 'Elenco numerato', () => ED.mut(x => { const on = x.paras.every(p => p.l === 'n'); x.paras.forEach(p => { if (on) delete p.l; else p.l = 'n'; }); }), els.every(x => x.paras.every(p => p.l === 'n'))),
    TB.btn('sliders', 'Effetti', a => TB.fxPop(a), !!e.sh || !!e.bg || !!e.te || !!e.cv, 'Effetti')
  ];
};

/* ============ Vista: griglia e margini, aggancio, vista griglia delle pagine ============ */
ED.view = { grid: false, margins: false, snap: false };
ED.gridOn = false;

/* righe guida nell'overlay */
ED._ro0 = ED.renderOverlay;
ED.renderOverlay = () => {
  ED._ro0();
  const ov = ED.ov; if (!ov) return;
  const D = ED.deck;
  if (ED.view.grid) ov.prepend(h('div.gridov', { style: { width: D.w + 'px', height: D.h + 'px', backgroundSize: '80px 80px' } }));
  if (ED.view.margins) ov.prepend(h('div.margov', { style: { left: D.w * .05 + 'px', top: D.h * .05 + 'px', width: D.w * .9 + 'px', height: D.h * .9 + 'px' } }));
};
ED._snap0 = ED.snapMove;
ED.snapMove = (box, dx, dy, others) => {
  const r = ED._snap0(box, dx, dy, others);
  if (!ED.view.snap) return r;
  const thr = 8 / ED.zoom, G = 40;
  if (!r.guides.some(g => g.x != null)) { const gx = Math.round((box.x + r.dx) / G) * G; if (Math.abs(gx - (box.x + r.dx)) < thr) { r.dx += gx - (box.x + r.dx); r.guides.push({ x: gx }); } }
  if (!r.guides.some(g => g.y != null)) { const gy = Math.round((box.y + r.dy) / G) * G; if (Math.abs(gy - (box.y + r.dy)) < thr) { r.dy += gy - (box.y + r.dy); r.guides.push({ y: gy }); } }
  return r;
};

/* ---- vista griglia delle pagine ---- */
ED.toggleGrid = (on) => {
  ED.gridOn = on == null ? !ED.gridOn : on;
  let g = $('#gridview');
  if (!ED.gridOn) { g && g.remove(); $('#b-gridv') && $('#b-gridv').classList.remove('on'); return; }
  if (ED.editing) ED.endEdit();
  if (!g) { g = h('div#gridview.gridview'); $('.emain').appendChild(g); }
  $('#b-gridv') && $('#b-gridv').classList.add('on');
  ED.renderGrid();
};
ED.renderGrid = () => {
  const g = $('#gridview'); if (!g) return;
  g.innerHTML = '';
  const list = h('div.gridlist');
  g.append(h('div.gridhd', h('h3', `Tutte le pagine (${ED.deck.slides.length})`), h('span.hint2', 'Clic per aprire · Ctrl o Maiusc per selezionarne più di una · trascina per riordinare'), h('span.grow'), h('button.btn.sm', { onclick: () => ED.toggleGrid(false) }, 'Chiudi')), list);
  ED.renderStrip(list);
};
ED._goto2 = ED.goto;
ED.goto = (i) => { ED._goto2(i); if (ED.gridOn) ED.toggleGrid(false); };

/* ---- menu Vista nella barra di stato ---- */
ED._build0 = ED.build;
ED.build = () => {
  ED.gridOn = false;
  ED._build0();
  const st = $('.estat'); if (!st) return;
  const btn = h('button.sbtn#b-gridv', { title: 'Vista griglia delle pagine', onclick: () => ED.toggleGrid() }, icn('grid', 16), 'Pagine');
  const vb = h('button.sbtn', { title: 'Griglia, margini e aggancio', onclick: e => UI.menu(e.currentTarget, [
    { label: 'Mostra la griglia', on: ED.view.grid, onclick: () => { ED.view.grid = !ED.view.grid; ED.renderOverlay(); } },
    { label: 'Mostra i margini', on: ED.view.margins, onclick: () => { ED.view.margins = !ED.view.margins; ED.renderOverlay(); } },
    { label: 'Aggancia alla griglia', on: ED.view.snap, onclick: () => { ED.view.snap = !ED.view.snap; } }]) }, icn('layout', 16), 'Guide');
  st.insertBefore(btn, $('#zoom')); st.insertBefore(vb, $('#zoom'));
};

/* ============ Cornici: trascina una foto sulla cornice e si ritaglia nella forma; ritaglio con spostamento e zoom ============ */
/* trasformazione dell'immagine dentro la cornice (spostamento, zoom, specchio) */
R.imgTf = (e) => {
  const t = [];
  if (e.ix || e.iy) t.push(`translate(${((e.ix || 0) * e.w).toFixed(1)}px,${((e.iy || 0) * e.h).toFixed(1)}px)`);
  if (e.iz && e.iz > 1) t.push(`scale(${e.iz})`);
  if (e.fl) t.push('scaleX(-1)');
  return t.length ? `transform:${t.join(' ')};` : '';
};
/* cornice vuota */
R._el1 = R.elHTML;
R.elHTML = (e, deck, o = {}) => {
  if (e.t === 'image' && !e.src) {
    if (o.anim) return '';
    const d = M.pathOf({ k: e.mk || 'round', w: e.w, h: e.h, rad: null }), s = Math.min(e.w, e.h) * .28;
    return `<div class="el el-image el-frame${e.lk ? ' lk' : ''}" data-id="${e.id}" style="${R.boxStyle(e)}"><svg class="shp" width="${e.w}" height="${e.h}" viewBox="0 0 ${e.w} ${e.h}" style="overflow:visible"><path d="${d}" fill="#D5D9E6" stroke="#8E97B5" stroke-width="3" stroke-dasharray="14 10"/><g transform="translate(${(e.w - s) / 2},${(e.h - s) / 2 - 8}) scale(${s / 24})" fill="none" stroke="#6B7390" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">${ICONS.image}</g></svg></div>`;
  }
  return R._el1(e, deck, o);
};
ED.addFrame = (k) => {
  const sel = ED.selEls();
  if (sel.length === 1 && sel[0].t === 'image' && sel[0].src) return ED.setFrame(k);
  const dim = k === 'pill' ? [760, 280] : k === 'arch' ? [440, 600] : [540, 540];
  ED.addEl(M.image(null, { fr: 1, mk: k, w: dim[0], h: dim[1] }));
  toast('Trascina una foto sulla cornice (anche dal pannello “Immagini”)', { ms: 3200 });
};
ED.fillFrame = (frame, ref) => {
  ED.mut(x => { x.src = ref; delete x.rc; delete x.orig; x.ix = 0; x.iy = 0; x.iz = 1; if (!x.mk) { x.fr = 1; } }, { els: [frame] });
  (ED.deck.imgs = ED.deck.imgs || []).unshift(ref);
};
/* foto o immagini trascinate dal pannello sulla pagina */
ED.dropRef = async (ev, ref) => {
  const t = document.elementFromPoint(ev.clientX, ev.clientY), n = t && t.closest('.sl > .el-image'), el = n && M.findEl(ED.slide(), n.dataset.id);
  if (el && !el.lk) { ED.select([el.id]); return ED.fillFrame(el, ref); }
  const p = ED.pt(ev), e = await ED.addImage(ref);
  e.x = Math.round(p.x - e.w / 2); e.y = Math.round(p.y - e.h / 2); ED.refresh();
};
ED._ic0 = ED.initCanvas;
ED.initCanvas = () => {
  ED._ic0();
  const cw = ED.cwrap; let hot = null;
  const clearHot = () => { if (hot) { hot.classList.remove('dropt'); hot = null; } };
  cw.addEventListener('dragover', ev => {
    const t = document.elementFromPoint(ev.clientX, ev.clientY), n = t && t.closest('.sl > .el-image');
    if (n !== hot) { clearHot(); if (n) { n.classList.add('dropt'); hot = n; } }
  });
  cw.addEventListener('dragleave', clearHot);
  cw.addEventListener('drop', ev => { clearHot(); const ref = ev.dataTransfer && ev.dataTransfer.getData('application/x-palco-img'); if (ref) { ev.preventDefault(); ED.dropRef(ev, ref); } });
};
/* trascinare una foto già in pagina su una cornice vuota */
ED.afterMove = (els) => {
  if (els.length !== 1 || els[0].t !== 'image' || !els[0].src || els[0].fr) return;
  const im = els[0], cx = im.x + im.w / 2, cy = im.y + im.h / 2;
  const fr = ED.slide().els.find(f => f !== im && f.t === 'image' && f.fr && !f.src && cx >= f.x && cx <= f.x + f.w && cy >= f.y && cy <= f.y + f.h);
  if (!fr) return;
  const ref = im.src; ED.slide().els = ED.slide().els.filter(x => x.id !== im.id);
  ED.sel = [fr.id]; ED.fillFrame(fr, ref); toast('Foto inserita nella cornice', { ms: 1400 });
};
/* i riquadri del pannello Immagini si possono trascinare */
ED._rp0 = ED.renderPanel;
ED.renderPanel = () => {
  ED._rp0();
  $$('#panel .imgb[data-ref]').forEach(b => { b.draggable = true; b.addEventListener('dragstart', ev => { ev.dataTransfer.setData('application/x-palco-img', b.dataset.ref); ev.dataTransfer.effectAllowed = 'copy'; }); });
};

/* ---- ritaglio: sposta e ingrandisci la foto nella cornice ---- */
ED.crop = null;
ED.cropLimits = (e) => {
  const ar = (ED.crop && ED.crop.ar) ? ED.crop.ar.w / ED.crop.ar.h : e.w / e.h, z = e.iz || 1;
  const cw = Math.max(e.w, e.h * ar), ch = Math.max(e.h, e.w / ar);
  return { mx: Math.max(0, (cw * z - e.w) / 2 / e.w), my: Math.max(0, (ch * z - e.h) / 2 / e.h) };
};
ED.clampCrop = (e) => { const l = ED.cropLimits(e); e.ix = clamp(e.ix || 0, -l.mx, l.mx); e.iy = clamp(e.iy || 0, -l.my, l.my); };
ED.startCrop = async (e) => {
  if (!e.src) return;
  ED.select([e.id]);
  ED.crop = { id: e.id, ar: await Img.size(e.src) };
  ED.cwrap.classList.add('cropping');
  ED.renderCtx(); toast('Trascina la foto per spostarla, usa il cursore o la rotellina per ingrandirla. Esc per finire.', { ms: 3600 });
};
ED.endCrop = () => { if (!ED.crop) return; ED.crop = null; ED.cwrap.classList.remove('cropping'); ED.commit(); ED.renderCtx(); };
ED.cropEl = () => ED.crop && M.findEl(ED.slide(), ED.crop.id);
ED.renderCropCtx = () => {
  const c = $('#ctx'); if (!c) return; c.innerHTML = '';
  const e = ED.cropEl(); if (!e) return;
  c.append(h('span.tbinfo', 'Ritaglio'), h('label.tinl', 'Zoom', h('input', { type: 'range', min: 100, max: 400, value: Math.round((e.iz || 1) * 100), 'aria-label': 'Zoom della foto', style: { width: '160px' }, oninput: ev => { e.iz = +ev.target.value / 100; ED.clampCrop(e); ED.refreshNode(e); ED.renderOverlay(); ED.updateThumb(ED.si); } })),
    TB.btn('restore', 'Riporta al centro', () => { e.ix = 0; e.iy = 0; e.iz = 1; ED.refreshNode(e); ED.renderOverlay(); ED.renderCropCtx(); ED.updateThumb(ED.si); }, false, 'Centra'),
    h('div.grow'), h('button.btn.sm.primary', { onclick: ED.endCrop }, 'Fine'));
};
ED._ctxw = ED.renderCtx;
ED.renderCtx = () => {
  if (ED.crop) { ED.renderCropCtx(); return; }
  ED._ctxw();
  const els = ED.selEls(), c = $('#ctx');
  if (!c || els.length !== 1 || els[0].t !== 'image') return;
  const e = els[0];
  if (!e.src) {
    // cornice vuota: solo gli strumenti utili
    [...c.children].forEach(b => { const t = b.getAttribute && b.getAttribute('title'); if (t && /colori dell|Rimuovi lo sfondo|Usa come sfondo|Specchia/.test(t)) b.remove(); });
    c.prepend(TB.btn('upload', 'Carica una foto nella cornice', a => ED.replaceMenu(a, e), false, 'Aggiungi foto'));
  } else {
    c.prepend(TB.btn('crop', 'Ritaglia: sposta e ingrandisci la foto (doppio clic)', () => ED.startCrop(e), !!(e.iz > 1 || e.ix || e.iy), 'Ritaglia'));
    if (e.fr) c.prepend(TB.btn('x', 'Togli la foto e lascia la cornice vuota', () => ED.mut(x => { x.src = null; delete x.rc; delete x.orig; x.ix = x.iy = 0; x.iz = 1; }), false, 'Svuota'));
  }
};
ED._down0 = ED.onDown;
ED.onDown = (ev) => {
  if (ED.crop) {
    const n = ev.target.closest('.sl > .el'), e = ED.cropEl();
    if (n && e && n.dataset.id === e.id && ev.button === 0) {
      ev.preventDefault();
      const p0 = ED.pt(ev), i0 = { x: e.ix || 0, y: e.iy || 0 };
      trackDrag(m => { const p = ED.pt(m); e.ix = i0.x + (p.x - p0.x) / e.w; e.iy = i0.y + (p.y - p0.y) / e.h; ED.clampCrop(e); ED.refreshNode(e); ED.renderOverlay(); }, () => { ED.updateThumb(ED.si); ED.commit(); });
      return;
    }
    if (!ev.target.closest('.ctx') && !ev.target.closest('.pop')) ED.endCrop();
    return;
  }
  ED._down0(ev);
};
ED._dblw = ED.onDbl;
ED.onDbl = (ev) => {
  const n = ev.target.closest('.sl > .el'), el = n && M.findEl(ED.slide(), n.dataset.id);
  if (el && el.t === 'image' && !el.lk) { ev.preventDefault(); if (el.src) ED.startCrop(el); else ED._pickInto(el); return; }
  ED._dblw(ev);
};
ED._pickInto = (el) => UI.pickFile('image/*', false, async fs => { try { ED.fillFrame(el, await Img.addFile(fs[0])); } catch (e) { toast('Non riesco a usare questo file', { type: 'err' }); } });
ED._key0 = ED.onKey;
ED.onKey = (ev) => { if (ED.crop && ev.key === 'Escape') { ev.preventDefault(); ED.endCrop(); return; } ED._key0(ev); };
/* la rotellina ingrandisce la foto durante il ritaglio */
ED._ic1 = ED.initCanvas;
ED.initCanvas = () => {
  ED._ic1();
  ED.cwrap.addEventListener('wheel', ev => {
    if (!ED.crop || ev.ctrlKey || ev.metaKey) return;
    const e = ED.cropEl(); if (!e) return; ev.preventDefault();
    e.iz = clamp((e.iz || 1) * Math.exp(-ev.deltaY * .0015), 1, 4); ED.clampCrop(e); ED.refreshNode(e); ED.renderOverlay(); ED.renderCropCtx(); ED.thumbSoon();
  }, { passive: false });
};

/* ============ Moduli interattivi (quiz): dati, grafica, editor ============ */
const QZ = {};
QZ.STYLES = {
  pastel: { n: 'Pastello', bg: '#FFFFFF', qc: '#14182B', ob: '#F1F3F8', ot: '#14182B', ok: '#12B886', ko: '#E5484D', ac: '#6D4AFF', bd: '' },
  scuro: { n: 'Scuro', bg: '#161B2E', qc: '#FFFFFF', ob: '#252C46', ot: '#EEF1FB', ok: '#2EC27E', ko: '#FF5C7A', ac: '#FFD25A', bd: '' },
  giallo: { n: 'Giallo pop', bg: '#FFD60A', qc: '#111111', ob: '#FFFFFF', ot: '#111111', ok: '#12B886', ko: '#FF3D8B', ac: '#111111', bd: '#111111' },
  neon: { n: 'Neon', bg: '#0A0E14', qc: '#F2F5F7', ob: '#141B26', ot: '#F2F5F7', ok: '#C6FF3D', ko: '#FF3D81', ac: '#3DDCFF', bd: '#26324A' },
  mare: { n: 'Mare', bg: '#0C5F68', qc: '#FFF7E6', ob: '#11727C', ot: '#FFF7E6', ok: '#FFC24B', ko: '#FF7A59', ac: '#F4E3C1', bd: '' },
  rosa: { n: 'Rosa', bg: '#FFF4F7', qc: '#2D2A4A', ob: '#FFFFFF', ot: '#2D2A4A', ok: '#3DBFA3', ko: '#FF6B8B', ac: '#FF8FB1', bd: '#FFD3E0' }
};
QZ.LET = 'ABCDEF';
M.quiz = (o = {}) => {
  const mode = o.mode || 'single', st = o.style || 'pastel';
  const base = mode === 'tf' ? { q: 'Il Sole è una stella?', opts: ['Vero', 'Falso'], ok: [0] }
    : mode === 'multi' ? { q: 'Quali di questi sono pianeti?', opts: ['Marte', 'Luna', 'Venere', 'Sirio'], ok: [0, 2] }
    : { q: 'Qual è la capitale d’Italia?', opts: ['Milano', 'Roma', 'Napoli', 'Torino'], ok: [1] };
  return Object.assign({ id: uid('e'), t: 'quiz', x: 0, y: 0, w: 1120, h: 600, r: 0, mode, ...base, okm: 'Esatto! Ottimo lavoro.', kom: 'Non proprio: la risposta corretta è evidenziata.', st, cl: { ...QZ.STYLES[st] }, f: 'Plus Jakarta Sans', fs: 30, rad: 28 }, o, { style: undefined });
};
QZ.geom = (e) => {
  if (!R._mctx) R._mctx = document.createElement('canvas').getContext('2d');
  const fs = e.fs, pad = Math.round(fs * .9), qfs = Math.round(fs * 1.25), iw = e.w - pad * 2, ctx = R._mctx;
  ctx.font = `700 ${qfs}px ${fontStack(e.f)}`;
  const lines = []; let cur = '';
  String(e.q).split(/\s+/).filter(Boolean).forEach(w => { const t = cur ? cur + ' ' + w : w; if (cur && ctx.measureText(t).width > iw) { lines.push(cur); cur = w; } else cur = t; });
  lines.push(cur);
  const qh = Math.round(lines.length * qfs * 1.25), gap = Math.round(fs * .7), oh = Math.round(fs * 2.4), og = Math.round(fs * .45), foot = Math.round(fs * 1.9), n = e.opts.length;
  const h = Math.round(pad + qh + gap + n * oh + (n - 1) * og + gap * .5 + foot + pad * .5);
  return { pad, qfs, iw, lines, qh, gap, oh, og, foot, h };
};
/* HTML dell'elemento: statico nell'editor, interattivo in presentazione */
R._el0 = R.elHTML;
R.elHTML = (e, deck, o = {}) => e.t === 'quiz' ? R.quizEl(e, o) : R._el0(e, deck, o);
R.quizEl = (e, o) => {
  const g = QZ.geom(e), c = e.cl; e.h = g.h;
  const an = (o.anim || o.editAnim) && R.hasAnim(e) ? R.animAttrs(e) : '';
  const interactive = !!o.anim;
  const opts = e.opts.map((t, i) => `<button class="qb${!interactive && e.ok.includes(i) ? ' mark' : ''}" data-i="${i}" ${interactive ? '' : 'tabindex="-1"'} style="height:${g.oh}px;margin-top:${i ? g.og : 0}px;background:${c.ob};color:${c.ot};border:${c.bd ? '3px solid ' + c.bd : '3px solid transparent'};border-radius:${Math.round(e.rad * .6)}px"><span class="ql" style="background:${c.ac};color:${Col.readable(c.ac)}">${QZ.LET[i]}</span><span class="qt">${esc(t)}</span><i class="qm"></i></button>`).join('');
  return `<div class="el el-quiz${e.lk ? ' lk' : ''}" data-id="${e.id}"${an} style="${R.boxStyle(e)}"><div class="qz${interactive ? ' live' : ''}" style="--ok:${c.ok};--ko:${c.ko};--okt:${Col.readable(c.ok)};--kot:${Col.readable(c.ko)};--qb:${c.ob};width:100%;height:${g.h}px;background:${c.bg};color:${c.qc};border-radius:${e.rad}px;padding:${g.pad}px;font-family:${fontStack(e.f)};font-size:${e.fs}px;${c.bd ? `border:4px solid ${c.bd};` : ''}"><div class="qq" style="font-size:${g.qfs}px;height:${g.qh}px">${esc(e.q)}</div><div class="qo" style="margin-top:${g.gap}px">${opts}</div><div class="qf" style="margin-top:${Math.round(g.gap * .5)}px;height:${g.foot}px"><span class="qmsg"></span><button class="qchk" hidden style="background:${c.ac};color:${Col.readable(c.ac)}">Verifica</button><button class="qre" hidden>Riprova</button></div></div></div>`;
};
ED._lname0 = ED.layerName;
ED.layerName = e => e.t === 'quiz' ? 'Quiz: ' + String(e.q).slice(0, 22) : ED._lname0(e);

ED.addQuiz = (mode) => { const e = M.quiz({ mode, style: ED.qzStyle }); const dark = ED.themeTxt().fg === '#FFFFFF'; e.w = Math.round(Math.min(ED.deck.w * .78, 1180)); ED.addEl(e); };

/* ---- editor del modulo ---- */
QZ.edit = (e) => {
  const body = h('div.form');
  const upd = (now) => { ED.refreshNode(e); ED.renderOverlay(); ED.updateThumb(ED.si); ED.commit(!!now); };
  const draw = () => {
    body.innerHTML = '';
    const multi = e.mode === 'multi';
    body.append(UI.seg([['single', 'Scelta singola'], ['tf', 'Vero o falso'], ['multi', 'Più risposte']], e.mode, v => {
      e.mode = v; if (v === 'tf') { e.opts = ['Vero', 'Falso']; e.ok = [0]; } else if (v === 'single') e.ok = [Math.min(e.ok[0] || 0, e.opts.length - 1)];
      draw(); upd(true);
    }));
    body.append(h('label.flab', 'Domanda'), h('textarea.inp.area', { rows: 2, value: e.q, 'aria-label': 'Domanda', oninput: ev => { e.q = ev.target.value; upd(); } }));
    body.append(h('label.flab', multi ? 'Risposte (spunta quelle corrette)' : 'Risposte (scegli quella corretta)'));
    const list = h('div.qzopts');
    e.opts.forEach((t, i) => {
      const on = e.ok.includes(i);
      list.append(h('div.qzrow', h('button.qzck' + (on ? '.on' : ''), { title: 'Risposta corretta', 'aria-label': 'Segna come corretta', onclick: () => { if (multi) { e.ok = on ? e.ok.filter(x => x !== i) : [...e.ok, i]; if (!e.ok.length) e.ok = [i]; } else e.ok = [i]; draw(); upd(true); } }, on ? icn('check', 16) : null),
        h('span.qzl', QZ.LET[i]), h('input.inp.sm', { value: t, 'aria-label': 'Risposta ' + QZ.LET[i], disabled: e.mode === 'tf', oninput: ev => { e.opts[i] = ev.target.value; upd(); } }),
        e.mode !== 'tf' && e.opts.length > 2 ? h('button.ibtn.sm', { title: 'Elimina la risposta', 'aria-label': 'Elimina la risposta', onclick: () => { e.opts.splice(i, 1); e.ok = e.ok.filter(x => x !== i).map(x => x > i ? x - 1 : x); if (!e.ok.length) e.ok = [0]; draw(); upd(true); } }, icn('trash', 16)) : null));
    });
    body.append(list);
    if (e.mode !== 'tf' && e.opts.length < 6) body.append(h('button.btn.sm', { onclick: () => { e.opts.push('Nuova risposta'); draw(); upd(true); } }, icn('plus', 16), 'Aggiungi una risposta'));
    body.append(h('label.flab', 'Messaggio se la risposta è giusta'), h('input.inp', { value: e.okm, oninput: ev => { e.okm = ev.target.value; ED.commit(false); } }),
      h('label.flab', 'Messaggio se è sbagliata'), h('input.inp', { value: e.kom, oninput: ev => { e.kom = ev.target.value; ED.commit(false); } }),
      h('p.hint2', 'In presentazione chi risponde vede la risposta corretta evidenziata in verde e quella scelta in rosso se ha sbagliato.'));
  };
  draw();
  const m = UI.modal('Modifica il modulo', body, { cls: 'small', foot: [h('span.grow'), h('button.btn.primary', { onclick: () => { m.close(); ED.commit(); ED.renderCtx(); } }, 'Fatto')] });
};

/* ---- barra del modulo ---- */
QZ.ctx = (e) => {
  const out = [];
  const mut = (fn, live) => ED.mut(x => { fn(x); }, live ? { tb: false, now: false } : { tb: false });
  const sw = (key, title) => TB.swatch(e.cl[key], title, a => UI.colorPop(a, e.cl[key], (v) => { if (typeof v === 'string') { mut(x => { x.cl[key] = v; }, true); } }, { docColors: ED.docColors() }));
  out.push(TB.btn('edit', 'Modifica domanda e risposte', () => QZ.edit(e), false, 'Modifica'),
    TB.btn('palette', 'Stili', a => UI.menu(a, Object.entries(QZ.STYLES).map(([k, s]) => ({ label: s.n, onclick: () => ED.mut(x => { x.st = k; x.cl = { ...s }; }) }))), false, 'Stile'),
    sw('bg', 'Sfondo'), sw('qc', 'Colore della domanda'), sw('ob', 'Sfondo delle risposte'), sw('ot', 'Testo delle risposte'), sw('ok', 'Colore risposta corretta'), sw('ko', 'Colore risposta sbagliata'), sw('ac', 'Colore delle lettere'),
    TB.sep(),
    h('button.tbb.fontb', { title: 'Font', onmousedown: ev => ev.preventDefault(), onclick: ev => UI.fontPop(ev.currentTarget, e.f, f => { loadFont(f, 400); loadFont(f, 700); ED.mut(x => { x.f = f; }, { tb: true }); UI.closePops(); }) }, h('span', { style: { fontFamily: fontStack(e.f) } }, e.f), icn('chevD', 14)),
    TB.group(TB.btn('minus', 'Riduci il testo', () => ED.mut(x => { x.fs = Math.max(16, x.fs - 2); })), h('span.tsize', { style: { width: '38px', textAlign: 'center', lineHeight: '26px', fontWeight: 700 } }, Math.round(e.fs)), TB.btn('plus', 'Ingrandisci il testo', () => ED.mut(x => { x.fs = Math.min(60, x.fs + 2); }))),
    TB.btn('corner', 'Angoli', a => UI.pop(a, h('div.pp', UI.slider('Angoli', 0, 60, e.rad, 1, v => ED.mut(x => { x.rad = v; }, { tb: false, now: false }), () => { ED.commit(); }, v => v + ' px')), { cls: 'ppop' }), false, 'Angoli'));
  out.push(h('div.grow'), TB.btn('zap', 'Animazione', a => TB.animPop(a), R.hasAnim(e), 'Anima'), TB.btn('move', 'Posizione', a => TB.posPop(a), false, 'Posizione'), TB.sep(),
    TB.btn(e.lk ? 'lock' : 'unlock', e.lk ? 'Sblocca' : 'Blocca', () => ED.mut(x => x.lk = x.lk ? 0 : 1), !!e.lk), TB.btn('dup', 'Duplica (Ctrl+D)', ED.duplicateSel), TB.btn('trash', 'Elimina (Canc)', ED.deleteSel));
  return out;
};
ED._ctxq = ED.renderCtx;
ED.renderCtx = () => {
  const els = ED.selEls();
  if (els.length === 1 && els[0].t === 'quiz') { const c = $('#ctx'); if (!c) return; c.innerHTML = ''; c.append(...QZ.ctx(els[0])); return; }
  ED._ctxq();
};
/* doppio clic sul modulo: apre l'editor */
ED._dblq = ED.onDbl;
ED.onDbl = (ev) => {
  const n = ev.target.closest('.sl > .el'), el = n && M.findEl(ED.slide(), n.dataset.id);
  if (el && el.t === 'quiz' && !el.lk) { ED.select([el.id]); QZ.edit(el); return; }
  ED._dblq(ev);
};

/* ============ Extra: copia stile, codice QR, comandi rapidi, cerca e sostituisci, colori da una foto, rimozione sfondo ============ */

/* ---- copia stile ---- */
ED.STYLE_KEYS = {
  text: ['f', 's', 'c', 'b', 'wt', 'i', 'u', 'up', 'a', 'lh', 'ls', 'ps', 'te', 'tc2', 'tg', 'cv', 'bg', 'pad', 'rad', 'sh', 'o'],
  shape: ['f', 'st', 'rad', 'sh', 'o', 'lc', 'ar'], image: ['fx', 'rad', 'mk', 'sh', 'o', 'rc'], chart: ['colors', 'tc', 'f', 'fs', 'legend', 'grid', 'vals'], table: ['hf', 'hc', 'cf', 'cf2', 'bc', 'tc', 'f', 'fs'], group: ['sh', 'o']
};
ED.painter = null;
ED.copyStyle = () => {
  const e = ED.selEls()[0]; if (!e || ED.sel.length !== 1) return;
  const props = {}; (ED.STYLE_KEYS[e.t] || []).forEach(k => { if (e[k] !== undefined) props[k] = clone(e[k]); });
  ED.painter = { t: e.t, line: e.k === 'line', props };
  ED.cwrap.classList.add('painting'); toast('Stile copiato: clicca un altro elemento dello stesso tipo', { icon: 'drop', ms: 3200 }); ED.renderCtx();
};
ED.applyPainter = (id) => {
  const P = ED.painter, e = M.findEl(ED.slide(), id); if (!P || !e) return;
  if (e.t !== P.t) { toast('Scegli un elemento dello stesso tipo', { ms: 1800 }); return; }
  ED.painter = null; ED.cwrap.classList.remove('painting');
  ED.sel = [id];
  ED.mut(x => { (ED.STYLE_KEYS[x.t] || []).forEach(k => { if (k in P.props) x[k] = clone(P.props[k]); else if (['te', 'tc2', 'tg', 'cv', 'bg', 'sh', 'mk', 'rc', 'fx'].includes(k)) delete x[k]; }); });
  toast('Stile applicato', { ms: 1200 });
};
ED.cancelPainter = () => { if (ED.painter) { ED.painter = null; ED.cwrap.classList.remove('painting'); ED.renderCtx(); } };

/* ---- codice QR ---- */
ED.qrGroup = (text, fg, bg) => {
  const qr = window.qrcode(0, 'M'); qr.addData(text); qr.make();
  const n = qr.getModuleCount(), q = 2; let d = '';
  for (let r = 0; r < n; r++) for (let c = 0; c < n; c++) if (qr.isDark(r, c)) d += `M${c + q} ${r + q}h1v1h-1z`;
  const S = 420, tot = n + q * 2;
  const back = M.shape('round', { x: 0, y: 0, w: S, h: S, f: bg, rad: 28 });
  const code = M.shape('path', { x: Math.round(S * q / tot), y: Math.round(S * q / tot), w: Math.round(S * n / tot), h: Math.round(S * n / tot), d, vb: [n, n], f: fg, st: null });
  // il tracciato è già in coordinate con margine: usa l'intero riquadro
  code.x = 0; code.y = 0; code.w = S; code.h = S; code.vb = [tot, tot];
  back.rad = 28;
  return { id: uid('e'), t: 'group', x: 0, y: 0, w: S, h: S, ow: S, oh: S, r: 0, els: [back, code], qr: text };
};
ED.addQR = async (text) => {
  text = (text || '').trim(); if (!text) return toast('Scrivi l’indirizzo o il testo del codice');
  try { await EX.loadScript('https://cdn.jsdelivr.net/npm/qrcode-generator@1.4.4/qrcode.js'); } catch (e) { return toast('Non riesco a caricare il generatore di codici QR (serve internet)', { type: 'err' }); }
  const dark = ED.themeTxt().fg === '#FFFFFF';
  const g = ED.qrGroup(text, dark ? '#FFFFFF' : '#14182B', dark ? '#14182B' : '#FFFFFF');
  g.w = g.h = 360; ED.addEl(g);
};
ED.editQR = async (g) => {
  const m = UI.prompt('Testo del codice QR', g.qr || '', 'Aggiorna', async v => {
    try { await EX.loadScript('https://cdn.jsdelivr.net/npm/qrcode-generator@1.4.4/qrcode.js'); } catch (e) { return toast('Serve internet per il generatore QR', { type: 'err' }); }
    const old = g.els[1], back = g.els[0], ng = ED.qrGroup(v, old.f, back.f); g.els = ng.els; g.qr = v; ED.refresh();
  });
};

/* ---- rimozione sfondo (sfondi uniformi, senza IA) ---- */
ED.removeBg = async (e, tol = 42) => {
  const src = e.orig || e.src;
  const s = await Img.source(src);
  if (s.svg) throw { code: 'svg' };
  const r = await Img.rasterLoad(s.url, 1400), { c, x, id } = r, W = c.width, H = c.height, d = id.data;
  const at = (px, py) => { const i = (py * W + px) * 4; return [d[i], d[i + 1], d[i + 2]]; };
  const corners = [at(0, 0), at(W - 1, 0), at(0, H - 1), at(W - 1, H - 1)];
  const ref = corners.reduce((a, b) => [a[0] + b[0] / 4, a[1] + b[1] / 4, a[2] + b[2] / 4], [0, 0, 0]);
  if (corners.some(k => Col.dist(k, ref) > 60)) throw { code: 'busy' };
  const seen = new Uint8Array(W * H), q = []; const push = (px, py) => { const k = py * W + px; if (!seen[k]) { const i = k * 4; if (Col.dist([d[i], d[i + 1], d[i + 2]], ref) < tol) { seen[k] = 1; q.push(k); } } };
  for (let i = 0; i < W; i++) { push(i, 0); push(i, H - 1); } for (let j = 0; j < H; j++) { push(0, j); push(W - 1, j); }
  while (q.length) { const k = q.pop(), px = k % W, py = (k / W) | 0; if (px > 0) push(px - 1, py); if (px < W - 1) push(px + 1, py); if (py > 0) push(px, py - 1); if (py < H - 1) push(px, py + 1); }
  for (let k = 0; k < W * H; k++) {
    if (seen[k]) { d[k * 4 + 3] = 0; continue; }
    const px = k % W, py = (k / W) | 0; // bordo: ammorbidisce un pixel
    if ((px > 0 && seen[k - 1]) || (px < W - 1 && seen[k + 1]) || (py > 0 && seen[k - W]) || (py < H - 1 && seen[k + W])) d[k * 4 + 3] = 140;
  }
  x.putImageData(id, 0, 0);
  const blob = await new Promise(res => c.toBlob(res, 'image/png'));
  const ref2 = await Img.store(blob);
  ED.mut(t => { if (!t.orig) t.orig = t.src; t.src = ref2; delete t.rc; }, { els: [e] });
};
TB.bgPop = (anchor, e0) => {
  let tol = 42; const st = h('p.hint2', 'Funziona bene su foto e loghi con sfondo di un solo colore.');
  const body = h('div.pp', h('div.cph', 'Rimuovi lo sfondo'), st, UI.slider('Tolleranza', 10, 110, tol, 1, v => { tol = v; }, null, v => v),
    h('div.btnrow', h('button.btn.sm.primary', { onclick: async () => { st.textContent = 'Sto lavorando…'; try { await ED.removeBg(e0, tol); st.textContent = 'Fatto. Se resta un alone, aumenta la tolleranza e riprova.'; } catch (er) { st.textContent = er.code === 'svg' ? 'Le immagini vettoriali non hanno bisogno di questa funzione.' : er.code === 'busy' ? 'Lo sfondo non è uniforme: provo solo con sfondi di un colore.' : 'Non sono riuscito a rimuovere lo sfondo.'; } } }, icn('sparkles', 16), 'Rimuovi'),
      e0.orig ? h('button.btn.sm', { onclick: () => { ED.mut(t => { t.src = t.orig; delete t.orig; }, { els: [e0] }); UI.closePops(); } }, icn('restore', 16), 'Originale') : null));
  UI.pop(anchor, body, { cls: 'ppop' });
};

/* ---- colori da una foto ---- */
Col.hsl = (hex) => { const [r, g, b] = Col.hex2rgb(hex).map(v => v / 255), mx = Math.max(r, g, b), mn = Math.min(r, g, b), l = (mx + mn) / 2, s = mx === mn ? 0 : (mx - mn) / (1 - Math.abs(2 * l - 1)); return { l, s }; };
ED.themeFromPhoto = async (file) => {
  const ref = await Img.addFile(file); (ED.deck.imgs = ED.deck.imgs || []).unshift(ref);
  const pal = (await Img.palette(ref)).colors; if (pal.length < 2) throw new Error('poche');
  const cur = TP.get(ED.deck.theme), dark = !!cur.dark;
  const bySat = pal.slice().sort((a, b) => Col.hsl(b).s * (1 - Math.abs(Col.hsl(b).l - .5)) - Col.hsl(a).s * (1 - Math.abs(Col.hsl(a).l - .5)));
  const byLum = pal.slice().sort((a, b) => Col.lum(a) - Col.lum(b));
  const ac = bySat[0], ac2 = bySat[1] || bySat[0], ac3 = bySat[2] || Col.mix(ac, '#FFFFFF', .4);
  const bg = dark ? Col.mix(byLum[0], '#000000', .35) : Col.mix(byLum[byLum.length - 1], '#FFFFFF', .7);
  const def = { base: cur.custom ? cur.base : cur.id, name: 'Dalla foto', bg, fg: Col.readable(bg), ac, ac2, ac3, fontTitle: cur.fd, fontBody: cur.fb };
  const th = TP.custom(def); TP.themes.push(th); ED.deck.themeDef = th.def;
  ED.applyTheme(th.id); toast('Colori presi dalla foto', { icon: 'palette' });
};

/* ---- cerca e sostituisci ---- */
ED.findDialog = () => {
  const st = { q: '', r: '', cs: false, hits: [], pos: -1 };
  const info = h('span.hint2'), qi = h('input.inp', { placeholder: 'Cerca', 'aria-label': 'Cerca' }), ri = h('input.inp', { placeholder: 'Sostituisci con', 'aria-label': 'Sostituisci con' });
  const scan = () => {
    st.hits = []; const q = qi.value; if (!q) { info.textContent = ''; return; }
    const re = new RegExp(q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), st.cs ? 'g' : 'gi');
    ED.deck.slides.forEach((s, si) => EX.flat(s.els).forEach(e => { let txt = ''; if (e.t === 'text') txt = M.plain(e); else if (e.t === 'table') txt = e.rows.flat().join('\n'); else if (e.t === 'chart') txt = e.labels.join('\n'); if (re.test(txt)) st.hits.push({ si, id: e.id, n: (txt.match(re) || []).length }); re.lastIndex = 0; }));
    info.textContent = st.hits.length ? `${st.hits.reduce((a, b) => a + b.n, 0)} risultati in ${st.hits.length} elementi` : 'Nessun risultato';
  };
  const go = (d) => {
    scan(); if (!st.hits.length) return; st.pos = (st.pos + d + st.hits.length) % st.hits.length;
    const h0 = st.hits[st.pos]; ED.goto(h0.si); const top = ED.slide().els.find(e => e.id === h0.id) || null;
    if (top) ED.select([h0.id]); else { const g = ED.slide().els.find(e => e.t === 'group' && EX.flat([e]).some(c => c.id === h0.id)); g && ED.select([g.id]); }
    ED.fit && ED.applyZoom();
  };
  const repl = (all) => {
    const q = qi.value; if (!q) return; const re = new RegExp(q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), st.cs ? 'g' : 'gi'), rep = ri.value; let n = 0;
    const doEl = e => {
      if (e.t === 'text') e.paras.forEach(p => p.r.forEach(r => { r.t = r.t.replace(re, () => { n++; return rep; }); }));
      else if (e.t === 'table') e.rows = e.rows.map(r => r.map(c => c.replace(re, () => { n++; return rep; })));
      else if (e.t === 'chart') e.labels = e.labels.map(c => c.replace(re, () => { n++; return rep; }));
    };
    if (all) ED.deck.slides.forEach(s => EX.flat(s.els).forEach(doEl)); else { const h0 = st.hits[st.pos]; if (h0) { ED.goto(h0.si); const el = EX.flat(ED.slide().els).find(e => e.id === h0.id); el && doEl(el); } }
    ED.renderAll(); ED.commit(); scan(); toast(n ? `${n} sostituzioni` : 'Niente da sostituire', { ms: 1500 });
  };
  qi.addEventListener('input', () => { st.pos = -1; scan(); }); qi.addEventListener('keydown', e => { if (e.key === 'Enter') go(e.shiftKey ? -1 : 1); });
  const m = UI.modal('Cerca e sostituisci', h('div.form', qi, ri, h('label.chk', h('input', { type: 'checkbox', onchange: e => { st.cs = e.target.checked; scan(); } }), 'Distingui maiuscole e minuscole'), info,
    h('div.row', h('button.btn.sm', { onclick: () => go(-1) }, icn('chevL', 16), 'Precedente'), h('button.btn.sm', { onclick: () => go(1) }, 'Successivo', icn('chevR', 16)), h('span.grow'), h('button.btn.sm', { onclick: () => repl(false) }, 'Sostituisci'), h('button.btn.sm.primary', { onclick: () => repl(true) }, 'Sostituisci tutto'))), { cls: 'wide2' });
  setTimeout(() => qi.focus(), 60);
};

/* ---- comandi rapidi (Ctrl+K) ---- */
ED.commandList = () => {
  const L = [], add = (label, hint, fn, ic) => L.push({ label, hint, fn, ic });
  add('Nuova casella di testo', 'testo', () => ED.addText(), 'type'); add('Nuova pagina', 'pagina', () => ED.addSlide(), 'plus'); add('Duplica la pagina', 'pagina', () => ED.dupSlide(ED.si), 'dup'); add('Elimina la pagina', 'pagina', () => ED.delSlide(ED.si), 'trash');
  M.SHAPE_LIST.forEach(([k, n]) => add('Aggiungi: ' + n, 'forma', () => ED.addShape(k), 'shapes'));
  [['bar', 'Grafico a barre'], ['line', 'Grafico a linee'], ['pie', 'Grafico a torta'], ['donut', 'Grafico ad anello']].forEach(([k, n]) => add('Aggiungi: ' + n, 'grafico', () => ED.addChart(k), 'chart'));
  add('Aggiungi: Tabella', 'tabella', () => ED.addTable(4, 3), 'table'); add('Aggiungi: Codice QR', 'qr', () => ED.qrDialog(), 'grid'); add('Disegna a mano libera', 'penna', () => ED.toggleDraw(true), 'pen');
  add('Raggruppa', 'gruppo', ED.group, 'layers'); add('Separa il gruppo', 'gruppo', ED.ungroup, 'layers'); add('Cerca e sostituisci', 'trova', ED.findDialog, 'search');
  add('Presenta', 'presentazione', () => ED.present(), 'play'); add('Presenta su due schermi (relatore e pubblico)', 'presentazione relatore tv lim proiettore', () => ED.present('dual'), 'presentation'); add('Condividi', 'link', () => SH.open(ED.deck), 'share');
  add('Controllo qualità della presentazione', 'controllo contrasto accessibilità errori', () => ED.setPanel('check'), 'check'); add('Anima la presentazione', 'animazioni transizioni magic', ED.animateDialog, 'sparkles'); add('Presentazione a volo (tela con camera)', 'volo prezi zoom mappa', ED.flyDialog, 'move'); add('Inquadrature di questa pagina (zoom e riflettore)', 'camera zoom riflettore', ED.camDialog, 'crop'); add('Applica il marchio', 'brand logo colori font', ED.brandDialog, 'palette');
  add('Crea un video MP4', 'esporta video musica', () => VID.dialog(ED.deck), 'film'); add('Allenati a presentare', 'prova tempi rapporto', () => ED.present(undefined, { train: true }), 'clock');
  add('Scarica PDF', 'esporta', () => EX.pdf(ED.deck), 'file'); add('Scarica PowerPoint', 'esporta', () => EX.pptx(ED.deck), 'presentation'); add('Scarica immagine PNG', 'esporta', () => EX.png(ED.deck, ED.si), 'image');
  add('Mostra la griglia', 'vista', () => { ED.view.grid = !ED.view.grid; ED.renderOverlay(); }, 'grid'); add('Mostra le pagine in griglia', 'vista', () => ED.toggleGrid(true), 'grid'); add('Cambia formato', 'copia', ED.resizeDialog, 'expand');
  add('Annulla', 'modifica', ED.undo, 'undo'); add('Ripeti', 'modifica', ED.redo, 'redo'); add('Mostra le note', 'note', () => { ED.notesOpen = !ED.notesOpen; ED.renderNotes(); }, 'note');
  TP.themes.filter(t => !t.hidden || t.id === ED.deck.theme).forEach(t => add('Stile: ' + t.name, 'stile', () => ED.applyTheme(t.id), 'palette'));
  ED.deck.slides.forEach((s, i) => { const t = s.els.filter(e => e.t === 'text').sort((a, b) => b.s - a.s)[0]; add(`Vai alla pagina ${i + 1}${t ? ': ' + M.plain(t).split('\n')[0].slice(0, 40) : ''}`, 'vai', () => ED.goto(i), 'file'); });
  return L;
};
ED.commandPalette = () => {
  const list = ED.commandList(), box = h('div.cmdlist'), inp = h('input.inp.cmdin', { placeholder: 'Scrivi un comando: “cerchio”, “grafico”, “stile”, “pagina 3”…', 'aria-label': 'Comandi' });
  let sel = 0, cur = list;
  const draw = () => {
    box.innerHTML = '';
    cur.slice(0, 40).forEach((c, i) => box.appendChild(h('button.cmd' + (i === sel ? '.on' : ''), { onclick: () => run(c), onmousemove: () => { sel = i; $$('.cmd', box).forEach((b, k) => b.classList.toggle('on', k === i)); } }, icn(c.ic, 18), h('span.ml', c.label), h('small', c.hint))));
    if (!cur.length) box.appendChild(h('p.hint2', { style: { padding: '14px' } }, 'Nessun comando trovato'));
  };
  const run = (c) => { m.close(); setTimeout(() => c.fn(), 40); };
  inp.addEventListener('input', () => { const q = inp.value.toLowerCase().trim().split(/\s+/); cur = list.filter(c => q.every(w => (c.label + ' ' + c.hint).toLowerCase().includes(w))); sel = 0; draw(); });
  inp.addEventListener('keydown', e => { if (e.key === 'ArrowDown') { e.preventDefault(); sel = Math.min(cur.length - 1, sel + 1); draw(); box.children[sel] && box.children[sel].scrollIntoView({ block: 'nearest' }); } else if (e.key === 'ArrowUp') { e.preventDefault(); sel = Math.max(0, sel - 1); draw(); box.children[sel] && box.children[sel].scrollIntoView({ block: 'nearest' }); } else if (e.key === 'Enter' && cur[sel]) { e.preventDefault(); run(cur[sel]); } });
  const m = UI.modal('Comandi rapidi', h('div', inp, box), { cls: 'small cmdbox' });
  draw(); setTimeout(() => inp.focus(), 60);
};
ED.qrDialog = () => {
  const inp = h('input.inp', { placeholder: 'https://…', value: 'https://', 'aria-label': 'Indirizzo o testo' });
  const m = UI.modal('Codice QR', h('div.form', h('p.mtext', 'Scrivi un indirizzo web o un testo: il codice si aggiunge alla pagina e puoi ricolorarlo.'), inp), { cls: 'small', foot: [h('span.grow'), h('button.btn', { onclick: () => m.close() }, 'Annulla'), h('button.btn.primary', { onclick: () => { const v = inp.value; m.close(); ED.addQR(v); } }, 'Aggiungi')] });
  inp.addEventListener('keydown', e => { if (e.key === 'Enter') { const v = inp.value; m.close(); ED.addQR(v); } }); setTimeout(() => { inp.focus(); inp.setSelectionRange(8, 8); }, 60);
};

/* ============ Esportazione e importazione ============ */
const EX = {};
EX.safeName = d => (d.name || 'presentazione').replace(/[\\/:*?"<>|]+/g, '-').trim() || 'presentazione';
/* le immagini caricate stanno solo nel browser che le ha ricevute: il file del progetto le porta con sé */
EX.refsIn = (deck) => { const s = JSON.stringify(deck), out = new Set(), re = /"((?:d|m|a):[A-Za-z0-9_-]+)"/g; let m; while ((m = re.exec(s))) out.add(m[1]); return [...out]; };
EX.refData = async (ref) => {
  try {
    if (ref.startsWith('a:')) { const r = await fetch(Img._url(ref)); return await readFileAs(await r.blob()); }
    return Img.cache.get(ref) || await ST.loadImage(ref);
  } catch (e) { return null; }
};
EX.json = async (d) => {
  const pr = EX.progress('Preparo il progetto con le immagini…'), imgs = {}; let lost = 0;
  try {
    for (const ref of EX.refsIn(d)) { const data = await EX.refData(ref); if (data && /^data:image\//.test(data)) imgs[ref] = data; else lost++; }
    const copy = clone(d); delete copy.collab; delete copy.collabGuest;
    const blob = new Blob([JSON.stringify({ palco: 2, deck: copy, imgs })], { type: 'application/json' });
    pr.done();
    if (await ST.saveFile(EX.safeName(d) + '.json', blob)) toast(lost ? `Progetto scaricato (${lost} ${lost === 1 ? 'immagine non era disponibile' : 'immagini non erano disponibili'})` : 'Progetto scaricato con tutte le immagini', { ms: 3200 });
  } catch (e) { pr.done(); console.warn(e); toast('Non sono riuscito a creare il file del progetto', { type: 'err' }); }
};
EX.importJson = async (file) => {
  const o = JSON.parse(await readFileAs(file, 'text'));
  let d = o.deck || o;
  if (!d || !Array.isArray(d.slides)) throw new Error('formato');
  if (o.imgs && typeof o.imgs === 'object') {
    const map = {};
    for (const [ref, data] of Object.entries(o.imgs)) {
      if (typeof data !== 'string' || !/^data:image\//.test(data)) continue;
      try { map[ref] = await Img.store(await (await fetch(data)).blob()); } catch (e) { console.warn('immagine', ref, e); }
    }
    let s = JSON.stringify(d); Object.entries(map).forEach(([a, b]) => { s = s.split('"' + a + '"').join('"' + b + '"'); }); d = JSON.parse(s);
  }
  d.id = uid('d_'); d.trashed = 0; d.created = Date.now();
  d.slides.forEach(s => { s.id = s.id || uid('s_'); (s.els || []).forEach(e => { e.id = e.id || uid('e'); }); });
  return d;
};

EX.progress = (msg) => {
  let box = $('#toasts'); if (!box) { box = h('div#toasts'); document.body.appendChild(box); }
  const t = h('div.toast.in', icn('download', 18), msg); box.appendChild(t); EX.skipped = false;
  return { set: m => { t.lastChild.textContent = m; }, done: () => { t.remove(); if (EX.skipped) { EX.skipped = false; toast('Le immagini di Pollinations create senza chiave non sono incluse nel file.', { ms: 5000 }); } } };
};
EX._scripts = {};
EX.loadScript = (url) => EX._scripts[url] || (EX._scripts[url] = new Promise((res, rej) => {
  const s = document.createElement('script'); s.src = url; s.onload = res; s.onerror = () => { delete EX._scripts[url]; rej(new Error('script')); }; document.head.appendChild(s);
}));

/* ---- disegno su canvas ---- */
EX.imgs = new Map();
EX.loadImg = async (ref, rc) => {
  const url = await Img.urlAsync(ref, rc);
  if (EX.imgs.has(url)) return EX.imgs.get(url);
  const p = new Promise(res => { const im = new Image(); im.onload = () => res(im); im.onerror = () => res(null); im.src = url; });
  EX.imgs.set(url, p); return p;
};
EX.prepare = async (deck, slides) => {
  const fonts = new Map(), refs = new Set(), jobs = [];
  slides.forEach(s => {
    if (s.bg && s.bg.img) refs.add(s.bg.img);
    EX.flat(s.els).forEach(e => {
      if (e.hd) return;
      if (e.t === 'text') { const k = [e.f, 400, 0]; fonts.set(k.join(), k); fonts.set([e.f, 700, 0].join(), [e.f, 700, 0]); if (R.weight(e) !== 400 && R.weight(e) !== 700) fonts.set([e.f, R.weight(e), 0].join(), [e.f, R.weight(e), 0]); if (e.i) { fonts.set([e.f, R.weight(e), 1].join(), [e.f, R.weight(e), 1]); } }
      if (e.t === 'chart' || e.t === 'table' || e.t === 'quiz') { fonts.set([e.f, 400, 0].join(), [e.f, 400, 0]); fonts.set([e.f, 600, 0].join(), [e.f, 600, 0]); fonts.set([e.f, 700, 0].join(), [e.f, 700, 0]); }
      if (e.t === 'image' && e.src) jobs.push([e.src, e.rc]);
    });
  });
  await Promise.all([...fonts.values()].map(([f, w, i]) => loadFont(f, w, !!i)));
  await Promise.all([...refs].map(r => EX.loadImg(r)).concat(jobs.map(([r, rc]) => EX.loadImg(r, rc))));
};
EX.fillStyle = (ctx, f, w, hh) => {
  if (!f) return 'transparent';
  if (typeof f === 'string') return f;
  const g = R.gradLine(f, w, hh), gr = ctx.createLinearGradient(g.x1, g.y1, g.x2, g.y2);
  f.g.forEach((c, i) => gr.addColorStop(i / (f.g.length - 1), c)); return gr;
};
EX.coverDraw = (ctx, im, x, y, w, hh) => {
  const k = Math.max(w / im.naturalWidth, hh / im.naturalHeight), sw = w / k, sh = hh / k;
  ctx.drawImage(im, (im.naturalWidth - sw) / 2, (im.naturalHeight - sh) / 2, sw, sh, x, y, w, hh);
};
EX.drawBg = (ctx, deck, bg) => {
  const W = deck.w, H = deck.h;
  if (typeof bg === 'string' || (bg && bg.g)) { ctx.fillStyle = EX.fillStyle(ctx, bg, W, H); ctx.fillRect(0, 0, W, H); return; }
  ctx.fillStyle = '#FFFFFF'; ctx.fillRect(0, 0, W, H);
  if (bg && bg.img) {
    const im = EX.getImg(bg.img);
    if (im && /^https?:/.test(Img.url(bg.img))) EX.skipped = true; else if (im) EX.coverDraw(ctx, im, 0, 0, W, H);
    if (bg.dim) { ctx.fillStyle = `rgba(0,0,0,${bg.dim})`; ctx.fillRect(0, 0, W, H); }
  }
};
EX._sync = new WeakMap();
EX.getImg = (ref, rc) => EX._resolved.get(Img.url(ref, rc));
EX._resolved = new Map();
EX.resolveAll = async () => { for (const [url, p] of EX.imgs) { const im = await p; EX._resolved.set(url, im); } };

EX.font = (e, size, weight, italic) => `${italic ? 'italic ' : ''}${weight} ${size}px ${fontStack(e.f)}`;
EX.layoutText = (ctx, e) => {
  const pad = e.pad || 0, innerW = Math.max(10, e.w - pad * 2), lines = [], s = e.s;
  const baseB = R.weight(e);
  let num = 0;
  e.paras.forEach((p, pi) => {
    const indent = p.l === 'b' ? s * 1.15 : p.l === 'n' ? s * 1.5 : 0;
    if (p.l === 'n') num++; else num = 0;
    const avail = innerW - indent;
    const toks = [];
    p.r.forEach(r => {
      const wt = r.b != null ? (r.b ? 700 : 400) : baseB, it = r.i != null ? r.i : !!e.i, ul = r.u != null ? r.u : !!e.u, col = r.c || e.c;
      const txt = e.up ? r.t.toUpperCase() : r.t;
      (txt.match(/\s+|\S+/g) || []).forEach(w => toks.push({ w, font: EX.font(e, s, wt, it), col, ul }));
    });
    let cur = { toks: [], width: 0, p, indent, pi, num, first: true };
    const measure = t => { ctx.font = t.font; return ctx.measureText(t.w).width; };
    const push = () => { lines.push(cur); cur = { toks: [], width: 0, p, indent, pi, num, first: false }; };
    toks.forEach(t => {
      t.width = measure(t);
      const isSp = /^\s+$/.test(t.w);
      if (!isSp && cur.width + t.width > avail && cur.toks.length) { while (cur.toks.length && /^\s+$/.test(cur.toks[cur.toks.length - 1].w)) { cur.width -= cur.toks.pop().width; } push(); }
      if (isSp && !cur.toks.length && !cur.first) return;
      if (!isSp && t.width > avail) { // parola troppo lunga: spezza per caratteri
        let part = '';
        for (const ch of t.w) { ctx.font = t.font; if (ctx.measureText(part + ch).width > avail && part) { const w2 = { ...t, w: part, width: measure({ ...t, w: part }) }; cur.toks.push(w2); cur.width += w2.width; push(); part = ch; } else part += ch; }
        t.w = part; t.width = measure(t);
      }
      cur.toks.push(t); cur.width += t.width;
    });
    while (cur.toks.length && /^\s+$/.test(cur.toks[cur.toks.length - 1].w) && cur.toks.length > 0) { cur.width -= cur.toks.pop().width; }
    lines.push(cur);
  });
  return { lines, innerW, pad };
};
EX.drawText = (ctx, e) => {
  if (ctx.letterSpacing !== undefined) ctx.letterSpacing = (e.ls * e.s) + 'px';
  const { lines, innerW, pad } = EX.layoutText(ctx, e), L = e.s * e.lh;
  ctx.textBaseline = 'alphabetic';
  ctx.font = EX.font(e, e.s, R.weight(e), !!e.i);
  const m = ctx.measureText('Hxg'), A = m.fontBoundingBoxAscent || e.s * .8, Ds = m.fontBoundingBoxDescent || e.s * .2;
  let y = pad;
  lines.forEach((ln, i) => {
    const p = ln.p, al = p.a || e.a, free = innerW - ln.indent - ln.width;
    let x = pad + ln.indent + (al === 'center' ? free / 2 : al === 'right' ? free : 0);
    const base = y + (L - (A + Ds)) / 2 + A;
    if (ln.first && p.l) {
      ctx.font = EX.font(e, e.s, 700, false); ctx.fillStyle = e.bc || e.c;
      ctx.fillText(p.l === 'b' ? '•' : ln.num + '.', pad, base);
    }
    ln.toks.forEach(t => {
      ctx.font = t.font; ctx.fillStyle = t.col; ctx.fillText(t.w, x, base);
      if (t.ul) { ctx.fillRect(x, base + e.s * .1, t.width, Math.max(1.5, e.s / 16)); }
      x += t.width;
    });
    y += L;
    const next = lines[i + 1];
    if (next && next.pi !== ln.pi && e.ps) y += e.ps * e.s;
  });
  if (ctx.letterSpacing !== undefined) ctx.letterSpacing = '0px';
};
EX.wrapSimple = (ctx, text, maxW) => {
  const out = []; let cur = '';
  String(text).split(/(\s+)/).forEach(w => { const t = cur + w; if (ctx.measureText(t).width > maxW && cur.trim()) { out.push(cur.trim()); cur = w.trim() ? w : ''; } else cur = t; });
  if (cur.trim()) out.push(cur.trim());
  return out.length ? out : [''];
};
EX.drawEl = (ctx, e) => {
  ctx.save();
  const cx = e.x + e.w / 2, cy = e.y + e.h / 2;
  ctx.translate(cx, cy); if (e.r) ctx.rotate(e.r * Math.PI / 180); ctx.translate(-e.w / 2, -e.h / 2);
  if (e.o != null && e.o < 1) ctx.globalAlpha = e.o;
  if (e.sh && R.SHADOWS[e.sh]) { const q = R.SHADOWS[e.sh]; ctx.shadowColor = q.c; ctx.shadowOffsetX = q.x; ctx.shadowOffsetY = q.y; ctx.shadowBlur = q.b; }
  if (e.t === 'text') {
    if (e.bg) { ctx.fillStyle = EX.fillStyle(ctx, e.bg, e.w, e.h); ctx.fill(new Path2D(P.round(e.w, e.h, { rad: e.rad || 0 }))); }
    ctx.shadowColor = 'transparent'; if (e.bg) { /* l'ombra del testo segue il riquadro */ }
    EX.drawText(ctx, e);
  } else if (e.t === 'shape') {
    if (e.k === 'line') {
      const st = e.st, a = M.arrowHeads(e);
      ctx.strokeStyle = st.c; ctx.lineWidth = st.w; ctx.lineCap = st.d === 2 ? 'round' : 'butt';
      ctx.setLineDash(st.d === 1 ? [st.w * 2.4, st.w * 1.6] : st.d === 2 ? [.1, st.w * 2] : []);
      ctx.stroke(new Path2D(M.linePath(e))); ctx.setLineDash([]); ctx.fillStyle = st.c;
      if (a.end) ctx.fill(new Path2D(a.end)); if (a.start) ctx.fill(new Path2D(a.start));
    } else {
      const path = new Path2D(M.pathOf(e));
      if (e.f) { ctx.fillStyle = EX.fillStyle(ctx, e.f, e.w, e.h); ctx.fill(path, 'evenodd'); }
      if (e.st) { ctx.shadowColor = 'transparent'; ctx.strokeStyle = e.st.c; ctx.lineWidth = e.st.w; ctx.lineJoin = 'round'; ctx.lineCap = (e.st.d === 2 || e.lc) ? 'round' : 'butt'; ctx.setLineDash(e.st.d === 1 ? [e.st.w * 2.4, e.st.w * 1.6] : e.st.d === 2 ? [.1, e.st.w * 2] : []); ctx.stroke(path); ctx.setLineDash([]); }
    }
  } else if (e.t === 'image') {
    const im = e.src ? EX.getImg(e.src, e.rc) : null;
    if (im && /^https?:/.test(Img.url(e.src, e.rc))) { EX.skipped = true; }
    else if (im) {
      ctx.save();
      if (e.mk) ctx.clip(new Path2D(M.pathOf({ k: e.mk, w: e.w, h: e.h, rad: null }))); else if (e.rad) ctx.clip(new Path2D(P.round(e.w, e.h, { rad: e.rad })));
      const f = R.imgFilter(e); if (f !== 'none' && 'filter' in ctx) ctx.filter = f;
      if (e.ix || e.iy) ctx.translate((e.ix || 0) * e.w, (e.iy || 0) * e.h);
      if (e.iz > 1) { ctx.translate(e.w / 2, e.h / 2); ctx.scale(e.iz, e.iz); ctx.translate(-e.w / 2, -e.h / 2); }
      if (e.fl) { ctx.translate(e.w, 0); ctx.scale(-1, 1); }
      EX.coverDraw(ctx, im, 0, 0, e.w, e.h); ctx.restore();
    }
  } else if (e.t === 'chart') {
    R.chartPrims(e).forEach(p => {
      if (p.k === 'rect') { ctx.fillStyle = p.f; if (p.r && ctx.roundRect) { ctx.beginPath(); ctx.roundRect(p.x, p.y, Math.max(0, p.w), Math.max(0, p.h), [p.r, p.r, 0, 0]); ctx.fill(); } else ctx.fillRect(p.x, p.y, Math.max(0, p.w), Math.max(0, p.h)); }
      else if (p.k === 'path') { const pa = new Path2D(p.d); if (p.f) { ctx.fillStyle = p.f; ctx.fill(pa, p.eo ? 'evenodd' : 'nonzero'); } if (p.s) { ctx.strokeStyle = p.s; ctx.lineWidth = p.sw; ctx.lineJoin = 'round'; ctx.lineCap = p.round ? 'round' : 'butt'; ctx.stroke(pa); } }
      else if (p.k === 'line') { ctx.strokeStyle = p.s; ctx.lineWidth = p.sw; ctx.beginPath(); ctx.moveTo(p.x1, p.y1); ctx.lineTo(p.x2, p.y2); ctx.stroke(); }
      else if (p.k === 'circle') { ctx.beginPath(); ctx.arc(p.cx, p.cy, p.r, 0, 7); ctx.fillStyle = p.f; ctx.fill(); if (p.s) { ctx.strokeStyle = p.s; ctx.lineWidth = p.sw; ctx.stroke(); } }
      else if (p.k === 'text') { ctx.font = `${p.w} ${p.sz}px ${fontStack(p.f)}`; ctx.fillStyle = p.c; ctx.textAlign = p.anchor === 'middle' ? 'center' : p.anchor === 'end' ? 'right' : 'left'; ctx.textBaseline = 'middle'; ctx.fillText(p.t, p.x, p.y); ctx.textAlign = 'left'; }
    });
  } else if (e.t === 'group') {
    const k = e.w / e.ow; ctx.scale(k, k); e.els.forEach(c => { if (!c.hd) EX.drawEl(ctx, c); });
  } else if (e.t === 'table') {
    const { cells, nc } = R.tableCells(e), cw = e.w / nc;
    cells.forEach(c => {
      const x = c.c * cw, y = c.r * e.rh;
      ctx.fillStyle = c.bg; ctx.fillRect(x, y, cw, e.rh);
      ctx.strokeStyle = e.bc; ctx.lineWidth = 2; ctx.strokeRect(x, y, cw, e.rh);
      ctx.fillStyle = c.fg; ctx.font = `${c.b ? 700 : 400} ${e.fs}px ${fontStack(e.f)}`; ctx.textBaseline = 'middle';
      const ls = EX.wrapSimple(ctx, c.t, cw - 40), lh = e.fs * 1.2, n = Math.min(ls.length, Math.max(1, Math.floor(e.rh / lh)));
      for (let i = 0; i < n; i++) ctx.fillText(ls[i], x + 20, y + e.rh / 2 + (i - (n - 1) / 2) * lh);
    });
  }
  ctx.restore();
};
EX.drawPageNum = (ctx, deck, slide, idx) => {
  const pn = deck.pn; if (!pn || !pn.on || idx == null || (pn.skip && idx === 0)) return;
  const txt = pn.fmt === 'nN' ? `${idx + 1} / ${deck.slides.length}` : String(idx + 1);
  const bg = typeof slide.bg === 'string' ? slide.bg : (slide.bg && slide.bg.g ? slide.bg.g[0] : '#222222'), s = pn.s || 28, m = 40;
  ctx.save(); ctx.globalAlpha = .75; ctx.fillStyle = pn.c || Col.readable(bg); ctx.font = `600 ${s}px ${fontStack('Plus Jakarta Sans')}`;
  ctx.textAlign = pn.pos[1] === 'l' ? 'left' : pn.pos[1] === 'r' ? 'right' : 'center'; ctx.textBaseline = pn.pos[0] === 't' ? 'top' : 'bottom';
  ctx.fillText(txt, pn.pos[1] === 'l' ? m : pn.pos[1] === 'r' ? deck.w - m : deck.w / 2, pn.pos[0] === 't' ? m : deck.h - m); ctx.restore();
};
EX.canvas = async (deck, slide, scale = 1, idx = null, o = {}) => {
  await EX.prepare(deck, [slide]); await EX.resolveAll();
  if (deck.pn && deck.pn.on) await loadFont('Plus Jakarta Sans', 600);
  const c = document.createElement('canvas'); c.width = Math.round(deck.w * scale); c.height = Math.round(deck.h * scale);
  const ctx = c.getContext('2d'); ctx.scale(scale, scale);
  if (!o.transparent) EX.drawBg(ctx, deck, slide.bg);
  slide.els.forEach(e => { if (!e.hd) EX.drawEl(ctx, e); });
  EX.drawPageNum(ctx, deck, slide, idx);
  return c;
};
/* un solo elemento su fondo trasparente (per il PPTX) */
EX.elCanvas = (e, scale = 1) => {
  const b = M.aabb(e), pad = 60, c = document.createElement('canvas');
  c.width = Math.ceil((b.w + pad * 2) * scale); c.height = Math.ceil((b.h + pad * 2) * scale);
  const ctx = c.getContext('2d'); ctx.scale(scale, scale); ctx.translate(pad - b.x, pad - b.y);
  EX.drawEl(ctx, e); return { c, x: b.x - pad, y: b.y - pad, w: b.w + pad * 2, h: b.h + pad * 2 };
};
EX.toBlob = (c, type = 'image/png', q) => new Promise(res => c.toBlob(res, type, q));

/* ---- formati ---- */
EX.png = async (deck, i) => {
  const pr = EX.progress('Preparo l’immagine…');
  try { const c = await EX.canvas(deck, deck.slides[i], 1, i); const b = await EX.toBlob(c); pr.done(); if (await ST.saveFile(`${EX.safeName(deck)}-${i + 1}.png`, b)) toast('Immagine salvata'); }
  catch (e) { pr.done(); console.warn(e); toast('Non sono riuscito a creare l’immagine', { type: 'err' }); }
};
EX.pdf = async (deck) => {
  const pr = EX.progress('Preparo il PDF…');
  try {
    await EX.loadScript('https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js');
    const { jsPDF } = window.jspdf, o = deck.w >= deck.h ? 'l' : 'p';
    const pdf = new jsPDF({ orientation: o, unit: 'px', format: [deck.w, deck.h], compress: true, hotfixes: ['px_scaling'] });
    for (let i = 0; i < deck.slides.length; i++) {
      pr.set(`Preparo il PDF… pagina ${i + 1} di ${deck.slides.length}`);
      const c = await EX.canvas(deck, deck.slides[i], 1, i);
      if (i) pdf.addPage([deck.w, deck.h], o);
      pdf.addImage(c.toDataURL('image/jpeg', .92), 'JPEG', 0, 0, deck.w, deck.h);
      await sleep(0);
    }
    const blob = pdf.output('blob'); pr.done();
    if (await ST.saveFile(EX.safeName(deck) + '.pdf', blob)) toast('PDF salvato');
  } catch (e) { pr.done(); console.warn(e); toast('Non sono riuscito a creare il PDF', { type: 'err' }); }
};
EX.pptx = async (deck) => {
  const pr = EX.progress('Preparo il file PowerPoint…');
  try {
    await EX.loadScript('https://cdn.jsdelivr.net/npm/pptxgenjs@3.12.0/dist/pptxgen.bundle.js');
    const pres = new window.PptxGenJS(), K = 144;
    pres.defineLayout({ name: 'PALCO', width: deck.w / K, height: deck.h / K }); pres.layout = 'PALCO'; pres.title = deck.name;
    const hex = c => String(Col.parse(c) || '#000000').slice(1);
    await EX.prepare(deck, deck.slides); await EX.resolveAll();
    for (let i = 0; i < deck.slides.length; i++) {
      pr.set(`Preparo il file PowerPoint… pagina ${i + 1} di ${deck.slides.length}`);
      const sl = deck.slides[i], s = pres.addSlide();
      if (typeof sl.bg === 'string') s.background = { color: hex(sl.bg) };
      else { const c = document.createElement('canvas'); c.width = deck.w / 2; c.height = deck.h / 2; const x = c.getContext('2d'); x.scale(.5, .5); EX.drawBg(x, deck, sl.bg); s.background = { data: c.toDataURL('image/jpeg', .9).replace('data:', '') }; }
      for (const e of sl.els) {
        if (e.hd) continue;
        if (e.t === 'text' && !e.bg && !e.te && !e.cv) {
          const runs = [];
          e.paras.forEach((p, pi) => {
            const list = p.l === 'b' ? { bullet: true } : p.l === 'n' ? { bullet: { type: 'number' } } : {};
            const rr = p.r.length ? p.r : [{ t: ' ' }];
            rr.forEach((r, ri) => runs.push({ text: e.up ? r.t.toUpperCase() : r.t, options: { fontFace: e.f, fontSize: e.s / 2, color: hex(r.c || e.c), bold: r.b != null ? r.b : R.weight(e) >= 600, italic: r.i != null ? r.i : !!e.i, underline: (r.u != null ? r.u : !!e.u) ? { style: 'sng' } : undefined, charSpacing: e.ls * e.s / 2, breakLine: ri === rr.length - 1 && pi < e.paras.length - 1, ...(ri === 0 ? list : {}), align: p.a || e.a, paraSpaceAfter: (e.ps || 0) * e.s / 2 } }));
          });
          s.addText(runs, { x: e.x / K, y: e.y / K, w: e.w / K, h: Math.max(e.h, e.s * e.lh) / K, margin: [0, 0, 0, 0], valign: 'top', rotate: e.r || 0, lineSpacingMultiple: e.lh / 1.2, fit: 'none', wrap: true });
        } else {
          const r = EX.elCanvas(e, 1); const data = r.c.toDataURL('image/png');
          s.addImage({ data: data.replace('data:', ''), x: r.x / K, y: r.y / K, w: r.w / K, h: r.h / K, altText: e.alt || undefined });
        }
        await sleep(0);
      }
      if (sl.notes) s.addNotes(sl.notes);
    }
    const blob = await pres.write({ outputType: 'blob' }); pr.done();
    if (await ST.saveFile(EX.safeName(deck) + '.pptx', blob)) toast('File PowerPoint salvato');
  } catch (e) { pr.done(); console.warn(e); toast('Non sono riuscito a creare il file PowerPoint', { type: 'err' }); }
};
EX.menu = (anchor) => {
  const D = ED.deck;
  UI.menu(anchor, [
    { head: 'Scarica' },
    { label: 'PDF (tutte le pagine)', icon: 'file', onclick: () => EX.pdf(D) },
    { label: 'PowerPoint (.pptx)', icon: 'presentation', onclick: () => EX.pptx(D) },
    { label: 'Video MP4 con musica', icon: 'film', onclick: () => VID.dialog(D) },
    { label: 'Immagine PNG (pagina corrente)', icon: 'image', onclick: () => EX.png(D, ED.si) },
    { label: 'Progetto Palco (.json)', icon: 'download', onclick: () => EX.json(D) }
  ], { align: 'right' });
};

/* ============ Esportazione: effetti del testo e testo curvo ============ */
EX.flat = (els) => { const out = []; const rec = a => a.forEach(e => { out.push(e); if (e.t === 'group') rec(e.els); }); rec(els); return out; };
/* testo curvo con ritorno a capo: righe su archi concentrici */
R._mctx = null;
R.curveGeom = e => {
  const c = clamp(e.cv, -100, 100), th = Math.max(.06, Math.abs(c) / 100 * Math.PI * 1.5), w = e.w, s = e.s, L = s * e.lh * .95;
  const r = (w / 2) / Math.sin(th / 2), up = c > 0, large = th > Math.PI ? 1 : 0, sag = r * (1 - Math.cos(th / 2));
  const apex0 = up ? s * 1.05 : s * .8 + sag, cx = w / 2;
  if (!R._mctx) R._mctx = document.createElement('canvas').getContext('2d');
  const ctx = R._mctx; ctx.font = `${e.i ? 'italic ' : ''}${R.weight(e)} ${s}px ${fontStack(e.f)}`;
  const raw = M.plain(e).replace(/\n/g, ' ').trim(), words = (e.up ? raw.toUpperCase() : raw).split(/\s+/).filter(Boolean);
  const wrap = rad => {
    const out = []; let cur = '';
    words.forEach(wd => { const t = cur ? cur + ' ' + wd : wd; if (cur && ctx.measureText(t).width > rad(out.length) * th * .94) { out.push(cur); cur = wd; } else cur = t; });
    if (cur || !out.length) out.push(cur);
    return out;
  };
  let lines, rs;
  if (up) {
    // arco verso l'alto: la prima riga è la più esterna, l'ultima ha raggio r
    let n = 1;
    for (let it = 0; it < 8; it++) { lines = wrap(i => r + (n - 1 - i) * L); if (lines.length === n) break; n = lines.length; }
    rs = lines.map((_, i) => r + (lines.length - 1 - i) * L);
  } else { lines = wrap(i => r + i * L); rs = lines.map((_, i) => r + i * L); }
  const cy = up ? apex0 + rs[0] : apex0 - r, cs = Math.cos(th / 2), sn = Math.sin(th / 2);
  const bottom = up ? Math.max(...rs.map(ri => cy - ri * cs), cy - r) + s * .35 : apex0 + (lines.length - 1) * L + s * .5;
  const paths = rs.map(ri => { const yy = up ? cy - ri * cs : cy + ri * cs; return `M${(cx - ri * sn).toFixed(1)} ${yy.toFixed(1)}A${ri.toFixed(1)} ${ri.toFixed(1)} 0 ${large} ${up ? 1 : 0} ${(cx + ri * sn).toFixed(1)} ${yy.toFixed(1)}`; });
  return { r, up, large, th, cy, cx, apex0, lines, rs, paths, h: Math.ceil(Math.max(bottom, s * 1.4)) };
};
R.curveInner = e => {
  const g = R.curveGeom(e);
  return `<svg width="${e.w}" height="${g.h}" viewBox="0 0 ${e.w} ${g.h}" style="display:block;overflow:visible"><defs>${g.paths.map((d, i) => `<path id="cv${e.id}_${i}" d="${d}"/>`).join('')}</defs>` +
    g.lines.map((ln, i) => `<text fill="currentColor"><textPath href="#cv${e.id}_${i}" startOffset="50%" text-anchor="middle">${esc(ln)}</textPath></text>`).join('') + '</svg>';
};
EX.drawCurved = (ctx, e) => {
  const g = R.curveGeom(e), s = e.s;
  ctx.font = EX.font(e, s, R.weight(e), !!e.i); ctx.fillStyle = e.c; ctx.textAlign = 'center'; ctx.textBaseline = 'alphabetic';
  g.lines.forEach((line, li) => {
    const chars = Array.from(line), ws = chars.map(c => ctx.measureText(c).width), total = ws.reduce((a, b) => a + b, 0), r = g.rs[li];
    let cum = 0;
    chars.forEach((ch, i) => {
      const phi = (cum + ws[i] / 2 - total / 2) / r; cum += ws[i];
      const px = g.cx + r * Math.sin(phi), py = g.up ? g.cy - r * Math.cos(phi) : g.cy + r * Math.cos(phi);
      ctx.save(); ctx.translate(px, py); ctx.rotate(g.up ? phi : -phi); ctx.fillText(ch, 0, 0); ctx.restore();
    });
  });
  ctx.textAlign = 'left';
};

EX.drawText = (ctx, e) => {
  if (e.cv) return EX.drawCurved(ctx, e);
  if (ctx.letterSpacing !== undefined) ctx.letterSpacing = (e.ls * e.s) + 'px';
  const { lines, innerW, pad } = EX.layoutText(ctx, e), L = e.s * e.lh;
  ctx.textBaseline = 'alphabetic';
  ctx.font = EX.font(e, e.s, R.weight(e), !!e.i);
  const m = ctx.measureText('Hxg'), A = m.fontBoundingBoxAscent || e.s * .8, Ds = m.fontBoundingBoxDescent || e.s * .2;
  const s = e.s, c = Col.parse(e.c) || '#000000', c2 = R.fxColor(e);
  const walk = (cb) => {
    let y = pad;
    lines.forEach((ln, i) => {
      const p = ln.p, al = p.a || e.a, free = innerW - ln.indent - ln.width;
      let x = pad + ln.indent + (al === 'center' ? free / 2 : al === 'right' ? free : 0);
      const base = y + (L - (A + Ds)) / 2 + A;
      cb(ln, null, x, base);
      ln.toks.forEach(t => { cb(ln, t, x, base); x += t.width; });
      y += L;
      const next = lines[i + 1];
      if (next && next.pi !== ln.pi && e.ps) y += e.ps * s;
    });
  };
  const pass = (o = {}) => {
    walk((ln, t, x, base) => {
      if (!t) {
        if (o.main && ln.first && ln.p.l) { ctx.font = EX.font(e, s, 700, false); ctx.fillStyle = e.bc || e.c; ctx.fillText(ln.p.l === 'b' ? '•' : ln.num + '.', pad, base); }
        return;
      }
      ctx.font = t.font;
      if (!o.noFill) { ctx.fillStyle = o.fill || t.col; ctx.fillText(t.w, x + (o.dx || 0), base + (o.dy || 0)); }
      if (o.stroke) { ctx.lineWidth = o.lw; ctx.strokeStyle = o.stroke; ctx.lineJoin = 'round'; ctx.strokeText(t.w, x + (o.dx || 0), base + (o.dy || 0)); }
      if (o.main && t.ul) ctx.fillRect(x, base + s * .1, t.width, Math.max(1.5, s / 16));
    });
  };
  const shadow = (col, blur, dx = 0, dy = 0) => { ctx.shadowColor = col; ctx.shadowBlur = blur; ctx.shadowOffsetX = dx; ctx.shadowOffsetY = dy; };
  const noShadow = () => { ctx.shadowColor = 'transparent'; ctx.shadowBlur = 0; ctx.shadowOffsetX = ctx.shadowOffsetY = 0; };
  switch (e.te) {
    case 'lift': shadow('rgba(0,0,0,.38)', .14 * s, 0, .05 * s); pass({ main: true }); noShadow(); break;
    case 'echo': pass({ dx: .14 * s, dy: .14 * s, fill: Col.alpha(c2, .25) }); pass({ dx: .07 * s, dy: .07 * s, fill: Col.alpha(c2, .55) }); pass({ main: true }); break;
    case 'neon': { const g = e.tc2 || c; [.8, .4, .18, .06].forEach((b, i) => { shadow(i === 3 ? Col.mix(g, '#FFFFFF', .5) : g, b * s); pass({ fill: Col.mix(c, '#FFFFFF', .8) }); }); noShadow(); pass({ main: true, fill: Col.mix(c, '#FFFFFF', .8) }); break; }
    case 'glitch': pass({ dx: -.045 * s, fill: '#FF2D55' }); pass({ dx: .045 * s, fill: '#00E5FF' }); pass({ main: true }); break;
    case 'hollow': pass({ noFill: true, stroke: c, lw: .035 * s, main: true }); break;
    case 'outline': pass({ noFill: true, stroke: c2, lw: .07 * s }); pass({ main: true }); break;
    case 'gradient': { const gl = R.gradLine(e.tg || { g: ['#FF6B4A', '#FFB84D'], a: 90 }, e.w, e.h), gr = ctx.createLinearGradient(gl.x1, gl.y1, gl.x2, gl.y2); (e.tg || { g: ['#FF6B4A', '#FFB84D'] }).g.forEach((col, i, a) => gr.addColorStop(i / (a.length - 1), col)); pass({ main: true, fill: gr }); break; }
    default: pass({ main: true });
  }
  if (ctx.letterSpacing !== undefined) ctx.letterSpacing = '0px';
};

/* testo curvo robusto: righe su archi concentrici verso l'interno; se non ci sta, la curva si attenua finché il testo entra */
R.curveGeom = e => {
  const sgn = e.cv < 0 ? -1 : 1, up = sgn > 0, w = e.w, s = e.s, L = s * e.lh * .95, cx = w / 2;
  if (!R._mctx) R._mctx = document.createElement('canvas').getContext('2d');
  const ctx = R._mctx; ctx.font = `${e.i ? 'italic ' : ''}${R.weight(e)} ${s}px ${fontStack(e.f)}`;
  const raw = M.plain(e).replace(/\n/g, ' ').trim(), words = (e.up ? raw.toUpperCase() : raw).split(/\s+/).filter(Boolean);
  let mag = clamp(Math.abs(e.cv), 1, 100), out = null;
  for (let it = 0; it < 40; it++) {
    const th = Math.max(.06, mag / 100 * Math.PI * 1.5), r = (w / 2) / Math.sin(th / 2), sag = r * (1 - Math.cos(th / 2));
    const rad = i => up ? r - i * L : r + i * L;
    const lines = []; let cur = '', ok = true;
    words.forEach(wd => {
      const t = cur ? cur + ' ' + wd : wd;
      if (cur && ctx.measureText(t).width > rad(lines.length) * th * .94) { lines.push(cur); cur = wd; } else cur = t;
    });
    if (cur || !lines.length) lines.push(cur);
    if (up && rad(lines.length - 1) < s * 1.1) ok = false;
    // una parola più lunga dell'arco della sua riga: riduci la curva
    if (lines.some((ln, i) => ctx.measureText(ln).width > rad(i) * th * 1.02)) ok = false;
    if (ok || mag <= 3 || it === 39) {
      const apex0 = up ? s * 1.05 : s * .8 + sag, cy = up ? apex0 + r : apex0 - r, cs = Math.cos(th / 2), sn = Math.sin(th / 2);
      const rs = lines.map((_, i) => rad(i));
      const bottom = up ? Math.max(...rs.map(ri => cy - ri * cs), cy - rs[rs.length - 1]) + s * .35 : apex0 + (lines.length - 1) * L + s * .5;
      const large = th > Math.PI ? 1 : 0;
      const paths = rs.map(ri => { const yy = up ? cy - ri * cs : cy + ri * cs; return `M${(cx - ri * sn).toFixed(1)} ${yy.toFixed(1)}A${ri.toFixed(1)} ${ri.toFixed(1)} 0 ${large} ${up ? 1 : 0} ${(cx + ri * sn).toFixed(1)} ${yy.toFixed(1)}`; });
      out = { r, up, large, th, cy, cx, apex0, lines, rs, paths, h: Math.ceil(Math.max(bottom, s * 1.4)) };
      break;
    }
    mag *= .85;
  }
  return out;
};

/* ============ Esporta come video MP4: transizioni, animazioni di entrata e musica di sottofondo ============ */
const VID = {};
VID.supported = () => typeof VideoEncoder === 'function' && typeof VideoFrame === 'function';
VID.yield = () => new Promise(r => { const c = new MessageChannel(); c.port1.onmessage = () => r(); c.port2.postMessage(0); });
VID.TD = .8;
VID.MOODS = [['', 'Nessuna'], ['calma', 'Calma'], ['energica', 'Energica'], ['magica', 'Magica']];

/* ---------- musica sintetizzata (nessun file, nessun diritto d’autore) ---------- */
VID.music = async (mood, sr) => {
  const bpm = { calma: 72, energica: 124, magica: 84 }[mood] || 80, beat = 60 / bpm, loop = 8 * 4 * beat, tail = 3, total = loop * 2 + tail;
  let seed = 1234567; const rnd = () => { seed = (seed + 0x6D2B79F5) | 0; let t = Math.imul(seed ^ seed >>> 15, 1 | seed); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; };
  const mtof = n => 440 * Math.pow(2, (n - 69) / 12);
  const ctx = new OfflineAudioContext(2, Math.ceil(total * sr), sr);
  const master = ctx.createGain(); master.gain.value = .85;
  const comp = ctx.createDynamicsCompressor(); master.connect(comp); comp.connect(ctx.destination);
  const irLen = Math.floor(sr * 2.4), ir = ctx.createBuffer(2, irLen, sr);
  for (let ch = 0; ch < 2; ch++) { const d = ir.getChannelData(ch); for (let i = 0; i < irLen; i++) d[i] = (rnd() * 2 - 1) * Math.pow(1 - i / irLen, 2.6); }
  const verb = ctx.createConvolver(); verb.buffer = ir; const wet = ctx.createGain(); wet.gain.value = mood === 'energica' ? .1 : .38; verb.connect(wet); wet.connect(master);
  const dry = ctx.createGain(); dry.connect(master);
  const send = n => { n.connect(dry); n.connect(verb); }, toDry = n => n.connect(dry);
  const noise = ctx.createBuffer(1, Math.floor(sr * .6), sr); { const d = noise.getChannelData(0); for (let i = 0; i < d.length; i++) d[i] = rnd() * 2 - 1; }
  const env = (g, t, peak, atk, dec) => { g.gain.setValueAtTime(0.0001, t); g.gain.linearRampToValueAtTime(peak, t + atk); g.gain.exponentialRampToValueAtTime(.0003, t + atk + dec); };
  const tone = (type, f, t, dur, peak, atk, dec, to, filt) => {
    const o = ctx.createOscillator(), g = ctx.createGain(); o.type = type; o.frequency.value = f; env(g, t, peak, atk, dec); o.connect(g);
    if (filt) { const lp = ctx.createBiquadFilter(); lp.type = 'lowpass'; lp.frequency.value = filt; g.connect(lp); to(lp); } else to(g);
    o.start(t); o.stop(t + dur);
  };
  const pad = (notes, t, dur, peak) => notes.forEach(n => { [0, 12].forEach((oct, k) => { const o = ctx.createOscillator(), g = ctx.createGain(); o.type = 'triangle'; o.frequency.value = mtof(n + oct); o.detune.value = (k ? 6 : -5); g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(peak / (k + 1), t + Math.min(1.1, dur * .3)); g.gain.setValueAtTime(peak / (k + 1), t + dur - .25); g.gain.linearRampToValueAtTime(0, t + dur + .7); o.connect(g); send(g); o.start(t); o.stop(t + dur + .8); }); });
  const hit = (t, hp, bp, peak, dec, to) => { const s = ctx.createBufferSource(), g = ctx.createGain(), f = ctx.createBiquadFilter(); s.buffer = noise; f.type = hp ? 'highpass' : 'bandpass'; f.frequency.value = hp || bp; g.gain.setValueAtTime(peak, t); g.gain.exponentialRampToValueAtTime(.0005, t + dec); s.connect(f); f.connect(g); to(g); s.start(t); s.stop(t + dec + .02); };
  const PROG = {
    calma: [[57, 60, 64], [53, 57, 60], [48, 55, 64], [50, 55, 59]],
    energica: [[60, 64, 67], [59, 62, 67], [57, 60, 64], [57, 60, 65]],
    magica: [[60, 64, 67], [62, 66, 69], [57, 60, 64, 67], [53, 57, 60, 65]]
  }[mood] || [[57, 60, 64]];
  const bell = (n, t, peak, to) => [[1, 1, 1.6], [2.76, .35, .8], [5.4, .12, .4]].forEach(([r, a, d]) => tone('sine', mtof(n) * r, t, d + .1, peak * a, .004, d, to));
  let delayIn = null;
  if (mood === 'magica') {
    const dl = ctx.createDelay(1); dl.delayTime.value = beat * .75; const fb = ctx.createGain(); fb.gain.value = .38; const lp = ctx.createBiquadFilter(); lp.type = 'lowpass'; lp.frequency.value = 2800;
    dl.connect(lp); lp.connect(fb); fb.connect(dl); lp.connect(verb); lp.connect(master); delayIn = dl;
  }
  for (let c = 0; c < 16; c++) {
    const cc = c % 8, t0 = c * 4 * beat, ch = PROG[cc % PROG.length], second = cc >= 4; seed = 99991 * (cc + 1);
    if (mood === 'calma') {
      pad(ch, t0, 4 * beat, .05);
      for (let j = 0; j < 8; j++) tone('sine', mtof(ch[j % ch.length] + 12 + (second && j % 2 ? 12 : 0)), t0 + j * beat / 2, 1.3, .07, .006, 1.1, send);
    } else if (mood === 'energica') {
      for (let b = 0; b < 4; b++) {
        const t = t0 + b * beat, o = ctx.createOscillator(), g = ctx.createGain(); o.frequency.setValueAtTime(160, t); o.frequency.exponentialRampToValueAtTime(42, t + .13); g.gain.setValueAtTime(.62, t); g.gain.exponentialRampToValueAtTime(.001, t + .3); o.connect(g); g.connect(dry); o.start(t); o.stop(t + .32);
        if (b % 2) hit(t, 0, 1900, .2, .16, toDry);
        hit(t + beat / 2, 8500, 0, .07, .05, toDry);
      }
      for (let j = 0; j < 8; j++) { const root = ch[0] - 24 + (j % 4 === 3 ? 12 : 0); tone('sawtooth', mtof(root), t0 + j * beat / 2, .3, .17, .004, .24, toDry, 420); }
      [0, 1.5, 2.5].forEach(b => ch.forEach(n => tone('square', mtof(n), t0 + b * beat, .3, .018, .004, .22, send, 2400)));
    } else if (mood === 'magica') {
      pad(ch, t0, 4 * beat, .045);
      const scale = ch.concat(ch.map(n => n + 12), ch.map(n => n + 24));
      for (let j = 0; j < 16; j++) if (rnd() < .6) { const n = scale[Math.floor(rnd() * scale.length)] + 12, t = t0 + j * beat / 4; bell(n, t, .05, x => { send(x); delayIn && x.connect(delayIn); }); }
    }
  }
  const buf = await ctx.startRendering(), n = Math.floor(loop * sr), off = Math.floor(loop * sr);
  const L = buf.getChannelData(0).slice(off, off + n), R = buf.getChannelData(1).slice(off, off + n);
  const tn = Math.min(Math.floor(tail * sr), buf.length - off - n, n); // la coda dell'ultimo accordo rientra all'inizio: il loop è senza stacchi
  for (let i = 0; i < tn; i++) { L[i] += buf.getChannelData(0)[off + n + i]; R[i] += buf.getChannelData(1)[off + n + i]; }
  return { L, R, sr, n };
};

/* ---------- livelli di una pagina, animazioni e transizioni ---------- */
VID.ease = p => 1 - Math.pow(1 - p, 3);
VID.kf = (p, pts) => { for (let i = 1; i < pts.length; i++) if (p <= pts[i][0]) { const [p0, v0] = pts[i - 1], [p1, v1] = pts[i]; return v0 + (v1 - v0) * (p - p0) / (p1 - p0); } return pts[pts.length - 1][1]; };
VID.animState = (type, q0, k) => {
  const q = clamp(q0, 0, 1), p = VID.ease(q), s = { a: p, dx: 0, dy: 0, sx: 1, sy: 1, rot: 0, blur: 0, clip: 1 };
  switch (type) {
    case 'rise': s.dy = 70 * (1 - p) * k; break;
    case 'drop': s.dy = -80 * (1 - p) * k; break;
    case 'left': s.dx = -160 * (1 - p) * k; break;
    case 'right': s.dx = 160 * (1 - p) * k; break;
    case 'zoom': s.sx = s.sy = .6 + .4 * p; break;
    case 'blur': s.blur = 26 * (1 - p) * k; s.sx = s.sy = 1.06 - .06 * p; break;
    case 'write': s.a = 1; s.clip = p; break;
    case 'flip': s.sy = Math.max(.001, p); break;
    case 'pop': s.a = Math.min(1, q / .6); s.sx = s.sy = VID.kf(q, [[0, .3], [.6, 1.12], [1, 1]]); break;
    case 'tada': s.a = Math.min(1, q / .3); s.sx = s.sy = VID.kf(q, [[0, .8], [.3, 1.08], [.5, 1.08], [.7, 1.04], [1, 1]]); s.rot = VID.kf(q, [[0, 0], [.3, -4], [.5, 4], [.7, -2], [1, 0]]) * Math.PI / 180; break;
  }
  if (q0 <= 0) s.a = 0;
  return s;
};
VID.canvas = (w, h) => { const c = document.createElement('canvas'); c.width = w; c.height = h; return c; };
VID.layers = async (deck, slide, idx, k, W, H, anim) => {
  await EX.prepare(deck, [slide]); await EX.resolveAll();
  if (deck.pn && deck.pn.on) await loadFont('Plus Jakarta Sans', 600);
  const bg = VID.canvas(W, H), bx = bg.getContext('2d'); bx.scale(k, k); EX.drawBg(bx, deck, slide.bg);
  const els = []; let delay = .25, end = 0;
  slide.els.forEach(e => {
    if (e.hd) return;
    const r = EX.elCanvas(e, k), it = { ...r, an: anim && e.an ? e.an : '', t0: 0, dur: 0 };
    if (it.an) { const sp = ANIM.speed(e.asp); it.t0 = delay; it.dur = .75 * sp; delay += .16 * sp; end = Math.max(end, it.t0 + it.dur); }
    els.push(it);
  });
  let top = null;
  if (deck.pn && deck.pn.on) { top = VID.canvas(W, H); const tx = top.getContext('2d'); tx.scale(k, k); EX.drawPageNum(tx, deck, slide, idx); }
  const L = { bg, els, top, k, W, H, end, anim: end > 0 };
  L.flat = () => { if (!L._flat) { L._flat = VID.canvas(W, H); VID.compose(L._flat.getContext('2d'), L, Infinity); } return L._flat; };
  return L;
};
VID.drawEl = (ctx, it, st, k) => {
  if (st.a <= .003) return;
