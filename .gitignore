};
PR.dot = (c, x0, y0) => { const x = c.getContext('2d'), [col, w, al] = PR.PENS[PR.pen]; x.globalAlpha = al; x.fillStyle = col; x.beginPath(); x.arc(x0, y0, w / 2, 0, 6.283); x.fill(); x.globalAlpha = 1; };
PR.togglePen = (on) => {
  PR.penOn = on == null ? !PR.penOn : on; PR.inkCanvas();
