App.palette = () => {
  const L = [], add = (label, hint, fn, ic) => L.push({ label, hint, fn, ic });
  add('Nuova presentazione', 'crea presentazione', () => App.newBlank('16:9'), 'presentation'); add('Nuova presentazione 4:3', 'crea', () => App.newBlank('4:3'), 'layout');
  add('Crea con l’IA', 'intelligenza artificiale scaletta', () => App.aiDialog(), 'sparkles'); add('Da una scaletta', 'crea testo', () => App.outlineDialog(), 'list');
  add('Crea un logo', 'creatore loghi marchio', () => LOGO.dialog(), 'star'); add('Modifica una foto', 'immagine ritocco filtri', () => UI.pickFile('image/*', true, fs => GR.openImages(fs)), 'image');
  GR.FORMATS.filter(f => f.k !== 'logo').forEach(f => add('Nuovo: ' + f.n, 'grafica crea ' + f.k, () => GR.blank(f.k), f.ic));
  add('Carica un file (immagine, PDF, PowerPoint)', 'importa apri', () => App.pickImport(), 'upload');
  App.nav.forEach(([v, l, ic]) => add('Vai a ' + l, 'sezione', () => App.go(v), ic));
  add('Cambia tema chiaro o scuro', 'aspetto', () => App.toggleTheme(), App.theme() === 'dark' ? 'sun' : 'moon'); add('Impostazioni IA', 'chiavi servizi deepseek openai claude', () => AI.settings(), 'settings'); add('Scorciatoie da tastiera', 'aiuto', () => UI.shortcuts(), 'keyboard');
  App.folders().forEach(fo => add('Cartella: ' + fo.name, 'cartella progetti', () => { App.folder = fo.id; App.go('projects'); }, 'folder'));
  ST.list().concat(ST.list(false, true)).forEach(d => add((d.tpl ? 'Modello: ' : 'Apri: ') + d.name, d.kind === 'design' ? 'grafica progetto' : 'presentazione progetto', () => d.tpl ? App.useTemplate(d) : ED.open(d), d.kind === 'design' ? 'shapes' : 'presentation'));
  const box = h('div.cmdlist'), inp = h('input.inp.cmdin', { placeholder: 'Cerca un progetto o scrivi cosa vuoi fare: “logo”, “post”, “cartella”…', 'aria-label': 'Ricerca rapida' });
  let sel = 0, cur = L;
  const draw = () => { box.innerHTML = ''; cur.slice(0, 40).forEach((c, i) => box.appendChild(h('button.cmd' + (i === sel ? '.on' : ''), { onclick: () => run(c), onmousemove: () => { sel = i; $$('.cmd', box).forEach((b, k) => b.classList.toggle('on', k === i)); } }, icn(c.ic, 18), h('span.ml', c.label), h('small', c.hint.split(' ')[0])))); if (!cur.length) box.appendChild(h('p.hint2', { style: { padding: '14px' } }, 'Nessun risultato')); };
  const run = (c) => { m.close(); setTimeout(() => c.fn(), 40); };
  inp.addEventListener('input', () => { const q = inp.value.toLowerCase().trim().split(/\s+/); cur = L.filter(c => q.every(w => (c.label + ' ' + c.hint).toLowerCase().includes(w))); sel = 0; draw(); });
  inp.addEventListener('keydown', e => { if (e.key === 'ArrowDown') { e.preventDefault(); sel = Math.min(cur.length - 1, sel + 1); draw(); box.children[sel] && box.children[sel].scrollIntoView({ block: 'nearest' }); } else if (e.key === 'ArrowUp') { e.preventDefault(); sel = Math.max(0, sel - 1); draw(); box.children[sel] && box.children[sel].scrollIntoView({ block: 'nearest' }); } else if (e.key === 'Enter' && cur[sel]) { e.preventDefault(); run(cur[sel]); } });
  const m = UI.modal('Ricerca rapida', h('div', inp, box), { cls: 'small cmdbox' }); draw(); setTimeout(() => inp.focus(), 60);
};
