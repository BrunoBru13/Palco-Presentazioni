PR.toastMsg = (m) => { let n = $('.pr-msg', PR.root); if (!n) { n = h('div.pr-msg'); PR.root.appendChild(n); } n.textContent = m; n.classList.remove('show'); void n.offsetWidth; n.classList.add('show'); };

/* ---- timer ---- */
PR.timer = (min) => {
  clearInterval(PR._tm); let el = $('.pr-timer', PR.root);
  if (!min) { el && el.remove(); return; }
  PR.timerEnd = Date.now() + min * 60000;
  if (!el) { el = h('div.pr-timer'); PR.root.appendChild(el); }
  el.classList.remove('over');
  const tick = () => { const left = Math.max(0, PR.timerEnd - Date.now()), s = Math.ceil(left / 1000); el.textContent = String(Math.floor(s / 60)).padStart(2, '0') + ':' + String(s % 60).padStart(2, '0'); if (!left) { clearInterval(PR._tm); el.classList.add('over'); PR.beep(3); } };
  tick(); PR._tm = setInterval(tick, 250); PR.toastMsg(`Timer: ${min} ${min === 1 ? 'minuto' : 'minuti'}`);
};

/* ---- penna ---- */
PR.PENS = [['#FF3B3B', 5, 1, 'Rosso'], ['#FFE14D', 26, .38, 'Evidenziatore'], ['#2B7FFF', 5, 1, 'Blu'], ['#FFFFFF', 5, 1, 'Bianco']];
PR.pen = 0;
PR.inkCanvas = () => {
  let c = $('.pr-ink', PR.root);
