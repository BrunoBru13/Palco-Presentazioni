  const before = v.slice(0, s), atStart = !before.trim() || /[.!?]\s*$/.test(before) || /\n$/.test(before), t = VOICE.fix(txt, atStart), sp = before && !/[\s\n(]$/.test(before) && !/^[.,;:!?)]/.test(t) ? ' ' : '';
