    lines.forEach(ln => {
      const bl = blocks.find(b => { const l = b.lines[b.lines.length - 1], dy = ln.y - l.y; if (dy < ln.fs * .6 || dy > Math.max(ln.fs, l.fs) * 2.1 || Math.abs(ln.fs - l.fs) > l.fs * .18 || ln.fname !== l.fname) return false; const cL = Math.abs(ln.x - l.x) < ln.fs * .7, cC = Math.abs((ln.x + ln.xe) / 2 - (l.x + l.xe) / 2) < ln.fs * .8 && b.lines.length >= 1 && (ln.xe - ln.x) > ln.fs * 3, cR = Math.abs(ln.xe - l.xe) < ln.fs * .7; return cL || cC || cR; });
      if (bl) bl.lines.push(ln); else blocks.push({ lines: [ln] });
    });
    blocks.forEach(b => {
      const L = b.lines, fs = L[0].fs, x0 = Math.min(...L.map(l => l.x)), x1 = Math.max(...L.map(l => l.xe)), wMax = x1 - x0;
      const eq = (f) => L.length > 1 && L.every(l => Math.abs(f(l) - f(L[0])) < fs * .6);
      const al = L.length === 1 ? 'left' : eq(l => l.x) ? 'left' : eq(l => (l.x + l.xe) / 2) ? 'center' : eq(l => l.xe) ? 'right' : 'left';
      const lh = L.length > 1 ? clamp(((L[L.length - 1].y - L[0].y) / (L.length - 1)) / fs, 1, 2) : 1.2;
      const base = L[0].runs[0], col = base.c, bold = L.every(l => l.runs.every(r => r.b)), ital = L.every(l => l.runs.every(r => r.i));
      const bullets = L.filter(l => /^[•·●▪‣◦■]\s*/.test(l.runs[0].t)).length >= Math.max(1, L.length / 2);
      const paras = L.map(l => {
        const runs = l.runs.map(r => ({ ...r })); if (bullets) runs[0].t = runs[0].t.replace(/^[•·●▪‣◦■]\s*/, '');
        const rr = runs.filter(r => r.t).map(r => { const o = { t: r.t }; if (r.b !== bold) o.b = r.b; if (r.i !== ital) o.i = r.i; if (r.c !== col) o.c = r.c; return o; });
