  const body = els.filter(Boolean);
  /* testo */
  const texts = [];
  if (opt.text) {
    const tc = await page.getTextContent({ normalizeWhitespace: true });
    const fontInfo = {};
    for (const key of Object.keys(tc.styles)) {
      let nm = ''; try { nm = page.commonObjs.has(key) ? page.commonObjs.get(key).name : ''; } catch (e) { }
      fontInfo[key] = PDFI.mapFont(nm || tc.styles[key].fontFamily, tc.styles[key].fontFamily);
    }
    const items = tc.items.filter(it => it.str && it.str.trim()).map(it => {
      const t = pdfjsLib.Util.transform(vp.transform, it.transform), fs = Math.hypot(t[2], t[3]) || 12, ang = Math.atan2(t[1], t[0]);
      let cr = null, bd = 1e9;
      truns.forEach(r => { if (Math.abs(r.y - t[5]) < fs * .45) { const dx = t[4] - r.x; if (dx >= -fs * .6 && dx < bd) { bd = dx; cr = r; } } });
      if (!cr) truns.forEach(r => { const d = Math.hypot(r.x - t[4], r.y - t[5]); if (d < bd) { bd = d; cr = r; } });
