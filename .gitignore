    venc.encode(vf, { keyFrame: f % (fps * 2) === 0 }); vf.close();
    if (venc.encodeQueueSize > 10) await new Promise(r => venc.addEventListener('dequeue', r, { once: true }));
    if (f % 6 === 0) { ui.set(.06 + .84 * f / frames, `Creo il video… ${Math.round(100 * f / frames)}%`); await VID.yield(); }
  }
  await venc.flush(); venc.close(); if (fail) throw fail;
  if (aud) {
    ui.set(.92, 'Compongo la musica…');
    const mus = await VID.music(o.music, 44100);
    const aenc = new AudioEncoder({ output: (c, m) => muxer.addAudioChunk(c, m), error: e => { fail = e; } });
    aenc.configure(aud.cfg);
    const CH = 4096, nAll = Math.ceil(total * 44100);
    for (let pos = 0; pos < nAll; pos += CH) {
      const len = Math.min(CH, nAll - pos), data = new Float32Array(len * 2);
      for (let q = 0; q < len; q++) {
        const idx = (pos + q) % mus.n, tt = (pos + q) / 44100, g = Math.min(1, tt / .8) * Math.min(1, (total - tt) / 2.2);
        data[q] = mus.L[idx] * g; data[len + q] = mus.R[idx] * g;
      }
      const ad = new AudioData({ format: 'f32-planar', sampleRate: 44100, numberOfFrames: len, numberOfChannels: 2, timestamp: Math.round(pos / 44100 * 1e6), data });
      aenc.encode(ad); ad.close();
