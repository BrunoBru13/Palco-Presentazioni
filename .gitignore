TP.CATS = ['Tutti', 'Business', 'Pitch', 'Educazione', 'Marketing', 'Creativo', 'Minimal'];

/* ============ Archivio: browser + db/assets/downloads di Claude quando ci sono ============ */
const ST = {
  db: null, assets: null, downloads: null, sample: null, uid: null, root: null,
  mem: {}, decks: new Map(), brand: null, meta: {}, cloud: false,
  DEF_BRAND: { colors: ['#FFD25A', '#1E6BFF', '#12B886', '#F26A2E', '#14182B', '#FFFFFF'], head: 'Poppins', body: 'Plus Jakarta Sans', logo: null },

  lget(k) { try { const v = localStorage.getItem(k); return v == null ? (ST.mem[k] ?? null) : v; } catch (e) { return ST.mem[k] ?? null; } },
  lset(k, v) { try { localStorage.setItem(k, v); } catch (e) { ST.mem[k] = v; } },
  ldel(k) { try { localStorage.removeItem(k); } catch (e) { } delete ST.mem[k]; },

  loadLocal() {
    let ids = []; try { ids = JSON.parse(ST.lget('palco.ids') || '[]'); } catch (e) { }
    ids.forEach(id => { try { const d = JSON.parse(ST.lget('palco.d.' + id)); if (d && d.slides) ST.decks.set(d.id, d); } catch (e) { } });
    try { ST.brand = { ...ST.DEF_BRAND, ...JSON.parse(ST.lget('palco.brand') || '{}') }; } catch (e) { ST.brand = { ...ST.DEF_BRAND }; }
    if (ST.brand.colors && ST.brand.colors[0] === '#F2542D') ST.brand.colors = ST.brand.colors.map((c, i) => i === 0 ? '#FFD25A' : c === '#FFB020' ? '#F26A2E' : c); /* il vecchio arancione della piattaforma diventa giallo */
    try { ST.meta = JSON.parse(ST.lget('palco.meta') || '{}'); } catch (e) { ST.meta = {}; }
  },
  list(trashed = false) { return [...ST.decks.values()].filter(d => !!d.trashed === trashed).sort((a, b) => b.updated - a.updated); },

  _q: new Map(), _busy: new Set(),
  saveDeck(deck, now = false) {
    deck.updated = Date.now();
    ST.decks.set(deck.id, deck);
    const ids = [...ST.decks.keys()];
    ST.lset('palco.ids', JSON.stringify(ids));
    ST.lset('palco.d.' + deck.id, JSON.stringify(deck));
    ST.queueCloud(deck, now);
  },
  queueCloud(deck, now) {
    if (!ST.root) return;
    clearTimeout(ST._q.get(deck.id));
    ST._q.set(deck.id, setTimeout(() => ST.pushCloud(deck.id), now ? 0 : 2500));
  },
  async pushCloud(id) {
    if (!ST.root) return;
    if (ST._busy.has(id)) { ST._q.set(id, setTimeout(() => ST.pushCloud(id), 1500)); return; }
    const deck = ST.decks.get(id); if (!deck) return;
    ST._busy.add(id);
    try {
      const body = JSON.parse(JSON.stringify(deck));
      await ST.root.collection('decks').doc(id).set(body);
      ST.setStatus('ok');
    } catch (e) {
      console.warn('salvataggio nel cloud', e);
      ST.setStatus(e && e.code === 'invalid_argument' ? 'big' : 'err');
    } finally { ST._busy.delete(id); }
  },
  status: 'ok',
  setStatus(s) { ST.status = s; window.dispatchEvent(new Event('palco-status')); },
  async deleteDeck(id) {
    ST.decks.delete(id); ST.ldel('palco.d.' + id);
    ST.lset('palco.ids', JSON.stringify([...ST.decks.keys()]));
    if (ST.root) { try { await ST.root.collection('decks').doc(id).delete(); } catch (e) { } }
  },
  saveBrand() {
    ST.lset('palco.brand', JSON.stringify(ST.brand));
    if (ST.root) ST.root.set({ brand: ST.brand, meta: ST.meta }).catch(() => { });
  },
  saveMeta() { ST.lset('palco.meta', JSON.stringify(ST.meta)); if (ST.root) ST.root.set({ brand: ST.brand, meta: ST.meta }).catch(() => { }); },

  /* Immagini caricate */
  idbOpen() {
    return ST._idbP || (ST._idbP = new Promise(res => {
      try { const r = indexedDB.open('palco', 1); r.onupgradeneeded = () => r.result.createObjectStore('imgs'); r.onsuccess = () => res(r.result); r.onerror = () => res(null); r.onblocked = () => res(null); } catch (e) { res(null); }
    }));
  },
  async idbPut(k, v) {
    const db = await ST.idbOpen(); if (!db) return false;
    return new Promise(res => { try { const tx = db.transaction('imgs', 'readwrite'); tx.objectStore('imgs').put(v, k); tx.oncomplete = () => res(true); tx.onerror = tx.onabort = () => res(false); } catch (e) { res(false); } });
  },
  async idbGet(k) {
    const db = await ST.idbOpen(); if (!db) return null;
    return new Promise(res => { try { const r = db.transaction('imgs').objectStore('imgs').get(k); r.onsuccess = () => res(r.result || null); r.onerror = () => res(null); } catch (e) { res(null); } });
  },
  async saveImage(ref, data) {
    if (ST.root && data.length < 230000) {
      try { await ST.root.collection('imgs').doc(ref.slice(2)).set({ data }); return true; } catch (e) { }
    }
    if (await ST.idbPut(ref, data)) return true;
    try { localStorage.setItem('palco.i.' + ref, data); return true; } catch (e) { return false; }
  },
  async loadImage(ref) {
    const local = ST.lget('palco.i.' + ref);
    if (local) return local;
    const fromIdb = await ST.idbGet(ref);
    if (fromIdb) return fromIdb;
    if (ST.root) { try { const s = await ST.root.collection('imgs').doc(ref.slice(2)).get(); if (s.exists) return s.data().data; } catch (e) { } }
    return null;
  },

  /* Capacità della piattaforma: arrivano in ritardo, la pagina funziona anche senza */
  async connect() {
    if (!window.claude || !window.claude.use) return;
    const get = async n => { try { return await window.claude.use(n); } catch (e) { return null; } };
    const [user, db, assets, dl, sample] = await Promise.all([get('user'), get('db'), get('assets'), get('downloads'), get('sample')]);
    ST.assets = assets; ST.downloads = dl; ST.sample = sample; ST.db = db;
    if (db && user) {
      try {
        const id = await user.id();
        if (id) {
          ST.uid = id;
          ST.root = db.collection('data/users/' + id).doc('profile');
          await ST.pullCloud();
          ST.cloud = true;
        }
      } catch (e) { console.warn('db', e); ST.root = null; }
    }
    window.dispatchEvent(new Event('palco-caps'));
  },
  async pullCloud() {
    const prof = await ST.root.get();
    if (prof.exists) {
      const p = prof.data();
      if (p.brand) { ST.brand = { ...ST.DEF_BRAND, ...p.brand }; ST.lset('palco.brand', JSON.stringify(ST.brand)); }
      if (p.meta) { ST.meta = { ...ST.meta, ...p.meta }; ST.lset('palco.meta', JSON.stringify(ST.meta)); }
    }
    const snap = await ST.root.collection('decks').get();
    snap.docs.forEach(s => {
      const d = s.data(); if (!d || !d.slides) return;
      const cur = ST.decks.get(d.id);
      if (!cur || d.updated > cur.updated) { ST.decks.set(d.id, d); ST.lset('palco.d.' + d.id, JSON.stringify(d)); }
    });
    // le presentazioni solo locali salgono nel cloud
    for (const d of ST.decks.values()) { if (!snap.docs.some(s => s.id === d.id)) ST.queueCloud(d, false); }
    ST.lset('palco.ids', JSON.stringify([...ST.decks.keys()]));
  },

  /* Salvataggio di un file per l'utente (PNG, PDF, PPTX...) */
  async saveFile(filename, blob) {
    if (ST.downloads) {
      try { await ST.downloads.save({ filename, data: blob }); return true; }
      catch (e) { if (e && e.code === 'declined') return false; console.warn(e); toast('Non è stato possibile salvare il file qui.', { type: 'err' }); return false; }
    }
    download(blob, filename); return true;
  }
};

/* ============ Componenti dell'interfaccia ============ */
const UI = { pops: [] };

/* Popover ancorato a un elemento */
UI.pop = (anchor, content, o = {}) => {
  UI.pops.filter(p => !p.box.contains(anchor)).forEach(UI.closePop);
  const box = h('div.pop', { class: o.cls || '', role: 'dialog' }, content);
  box.addEventListener('mousedown', e => { if (!/^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName)) e.preventDefault(); });
  uiHost().appendChild(box);
  const place = () => {
    const r = anchor.getBoundingClientRect(), bw = box.offsetWidth, bh = box.offsetHeight, vw = innerWidth, vh = innerHeight;
    let x = o.align === 'right' ? r.right - bw : r.left, y = r.bottom + 6;
    if (o.side === 'right') { x = r.right + 8; y = r.top; }
    if (y + bh > vh - 8) y = Math.max(8, o.side === 'right' ? vh - bh - 8 : r.top - bh - 6);
    x = clamp(x, 8, Math.max(8, vw - bw - 8));
    box.style.left = x + 'px'; box.style.top = y + 'px';
  };
  place(); requestAnimationFrame(() => { place(); box.classList.add('in'); });
  const p = { box, anchor, onclose: o.onclose };
  const off = e => { if (!box.contains(e.target) && !anchor.contains(e.target) && !e.target.closest('.pop,.modal')) UI.closePop(p); };
  const key = e => { if (e.key === 'Escape') { UI.closePop(p); e.stopPropagation(); } };
  setTimeout(() => { document.addEventListener('pointerdown', off, true); document.addEventListener('keydown', key, true); }, 0);
  p.off = () => { document.removeEventListener('pointerdown', off, true); document.removeEventListener('keydown', key, true); };
  UI.pops.push(p);
  anchor.classList && anchor.classList.add('open');
  return p;
};
UI.closePop = p => { p.off(); p.box.remove(); p.anchor.classList && p.anchor.classList.remove('open'); UI.pops = UI.pops.filter(x => x !== p); p.onclose && p.onclose(); };
UI.closePops = () => { UI.pops.slice().forEach(UI.closePop); };

/* Menu a tendina: voci {label, icon, onclick, danger, sep, sub} */
UI.menu = (anchor, items, o = {}) => {
  const list = h('div.menu');
  items.forEach(it => {
    if (!it) return;
    if (it.sep) return list.appendChild(h('div.msep'));
    if (it.head) return list.appendChild(h('div.mhead', it.head));
    const b = h('button.mi' + (it.danger ? '.danger' : '') + (it.on ? '.on' : ''), {
      disabled: it.disabled, onclick: () => { UI.closePops(); it.onclick && it.onclick(); }
    }, it.icon ? icn(it.icon, 18) : h('span.icw'), h('span.ml', it.label), it.key ? h('kbd', it.key) : null, it.on ? icn('check', 16) : null);
    list.appendChild(b);
  });
  return UI.pop(anchor, list, { ...o, cls: 'menu-pop' });
};

/* Finestre modali */
UI.modal = (title, body, o = {}) => {
  const close = () => { m.remove(); document.removeEventListener('keydown', key, true); window.removeEventListener('resize', fit); o.onclose && o.onclose(); };
  const key = e => { if (e.key === 'Escape') { close(); e.stopPropagation(); } };
  /* il pulsante di chiusura sta fuori dalla scheda, a destra; se lì non c'è spazio passa dentro l'angolo */
  const fit = () => { if (m.isConnected) m.classList.toggle('mc-in', box.offsetLeft + box.offsetWidth + 14 + 56 > m.clientWidth - 8); };
  const box = h('div.mbox', { class: o.cls || '', role: 'dialog', 'aria-label': title },
    h('button.mclose', { onclick: close, 'aria-label': 'Chiudi' }, icn('x', 22)),
    h('div.mhd', h('h2', title)),
    h('div.mbd', body), o.foot ? h('div.mft', o.foot) : null);
  const m = h('div.modal', { onmousedown: e => { if (e.target === m) close(); } }, box);
  uiHost().appendChild(m);
  document.addEventListener('keydown', key, true);
  window.addEventListener('resize', fit);
  requestAnimationFrame(() => { m.classList.add('in'); fit(); });
  m.close = close;
  return m;
};
/* Conferma dentro la pagina (confirm() non è disponibile) */
UI.confirm = (title, text, okLabel, onok, danger = true) => {
  const m = UI.modal(title, h('p.mtext', text), {
    cls: 'small',
    foot: [h('button.btn', { onclick: () => m.close() }, 'Annulla'), h('button.btn.' + (danger ? 'danger' : 'primary'), { onclick: () => { m.close(); onok(); } }, okLabel)]
  });
};
UI.prompt = (title, value, okLabel, onok) => {
  const inp = h('input.inp', { value, type: 'text', maxlength: 80 });
  const go = () => { const v = inp.value.trim(); if (v) { m.close(); onok(v); } };
  inp.addEventListener('keydown', e => { if (e.key === 'Enter') go(); });
  const m = UI.modal(title, inp, { cls: 'small', foot: [h('button.btn', { onclick: () => m.close() }, 'Annulla'), h('button.btn.primary', { onclick: go }, okLabel)] });
  setTimeout(() => { inp.focus(); inp.select(); }, 60);
};

/* ---- selettore colore ---- */
UI.PALETTE = [
  '#000000', '#2B2B2B', '#545454', '#737373', '#A6A6A6', '#D9D9D9', '#F2F2F2', '#FFFFFF',
  '#E5484D', '#F2542D', '#FF8A00', '#FFB020', '#FFD60A', '#A3D930', '#12B886', '#0FA3B1',
  '#1E6BFF', '#3B4BE0', '#6D4AFF', '#9B51E0', '#E040A0', '#FF5D8F', '#8B5E3C', '#14182B',
  '#FFE3DC', '#FFF0C9', '#E3F6D8', '#D5F2EC', '#D8E8FF', '#E6E0FF', '#FFDDEB', '#EEE7DC'
];
UI.GRADS = [
  [['#FF6B4A', '#FFB84D'], 135], [['#FF3D8B', '#FFD60A'], 135], [['#1E6BFF', '#12B886'], 135], [['#0B2A5B', '#1E88E5'], 160],
  [['#101A3A', '#FF6B4A'], 180], [['#C6FF3D', '#3DDCFF'], 135], [['#FFE3B8', '#FF8FB1'], 135], [['#0E7C86', '#F4E3C1'], 135],
  [['#14182B', '#3B4BE0'], 135], [['#F2F2F2', '#BDBDBD'], 180], [['#FFFFFF', '#D8E8FF'], 180], [['#1F3D2B', '#7DBE6C'], 135]
];
/* cb(valore) con valore stringa o {g,a}; cur: valore attuale; o.grad abilita le sfumature, o.none un "nessuno" */
UI.colorPop = (anchor, cur, cb, o = {}) => {
  const doc = o.docColors || [];
  const wrap = h('div.cpick');
  const swatch = (c, extra) => h('button.sw' + (c === cur ? '.sel' : ''), { style: { background: c }, 'aria-label': c, title: c, onclick: () => cb(c) });
  const section = (t, cols) => [h('div.cph', t), h('div.swgrid', cols.map(c => swatch(c)))];
  let tab = 'solid';
  const render = () => {
    wrap.innerHTML = '';
    if (o.grad) wrap.appendChild(h('div.seg', h('button' + (tab === 'solid' ? '.on' : ''), { onclick: () => { tab = 'solid'; render(); } }, 'Tinta unita'), h('button' + (tab === 'grad' ? '.on' : ''), { onclick: () => { tab = 'grad'; render(); } }, 'Sfumatura')));
    if (tab === 'grad') {
      const g = (cur && cur.g) ? cur : { g: ['#FF6B4A', '#FFB84D'], a: 135 };
      wrap.appendChild(h('div.swgrid.g6', UI.GRADS.map(([cs, a]) => h('button.sw.big', { style: { background: `linear-gradient(${a}deg,${cs[0]},${cs[1]})` }, onclick: () => cb({ g: cs.slice(), a }) }))));
      wrap.appendChild(h('label.rng', 'Angolo ', h('input', { type: 'range', min: 0, max: 360, value: g.a, oninput: e => cb({ g: g.g.slice(), a: +e.target.value }, true) })));
      return;
    }
    if (o.none) wrap.appendChild(h('button.swnone', { onclick: () => cb(null) }, icn('x', 16), o.none));
    const brand = ST.brand ? ST.brand.colors : [];
    if (doc.length) wrap.append(...section('Colori della presentazione', doc.slice(0, 16)));
    wrap.append(...section('Colori del marchio', brand));
    wrap.append(...section('Colori predefiniti', UI.PALETTE));
    const hex = h('input.inp.sm', { type: 'text', value: typeof cur === 'string' ? cur : '#', maxlength: 7, 'aria-label': 'Codice esadecimale' });
    hex.addEventListener('change', () => { const c = Col.parse(hex.value.startsWith('#') ? hex.value : '#' + hex.value); if (c) cb(c); });
    const nat = h('input', { type: 'color', value: typeof cur === 'string' && /^#[0-9a-f]{6}$/i.test(cur) ? cur : '#FFD25A', 'aria-label': 'Selettore colore', oninput: e => { hex.value = e.target.value.toUpperCase(); cb(e.target.value.toUpperCase(), true); } });
    const row = h('div.crow', nat, hex);
    if (window.EyeDropper) row.appendChild(h('button.ibtn', { title: 'Contagocce', onclick: async () => { try { const r = await new EyeDropper().open(); cb(r.sRGBHex.toUpperCase()); } catch (e) { } } }, icn('drop', 18)));
    wrap.appendChild(row);
  };
  render();
  return UI.pop(anchor, wrap, { cls: 'cpop' });
};

/* ---- selettore font ---- */
UI.fontPop = (anchor, cur, cb) => {
  const q = h('input.inp.sm', { type: 'search', placeholder: 'Cerca un font', 'aria-label': 'Cerca un font' });
  const list = h('div.flist');
  const draw = () => {
    list.innerHTML = '';
    const f = q.value.trim().toLowerCase();
    const brand = ST.brand ? [ST.brand.head, ST.brand.body].filter((x, i, a) => x && a.indexOf(x) === i) : [];
    const groups = [['Font del marchio', brand.map(n => FONT_MAP[n]).filter(Boolean)], ['Sans', FONTS.filter(x => x[1] === 'sans')], ['Serif', FONTS.filter(x => x[1] === 'serif')], ['Titoli', FONTS.filter(x => x[1] === 'display')], ['Corsivi', FONTS.filter(x => x[1] === 'script')], ['Monospazio', FONTS.filter(x => x[1] === 'mono')]];
    groups.forEach(([t, fs]) => {
      fs = fs.filter(x => !f || x[0].toLowerCase().includes(f));
      if (!fs.length) return;
      list.appendChild(h('div.cph', t));
      fs.forEach(x => list.appendChild(h('button.fi' + (x[0] === cur ? '.sel' : ''), { style: { fontFamily: fontStack(x[0]) }, onclick: () => { loadFont(x[0], 400); cb(x[0]); } }, x[0])));
    });
  };
  q.addEventListener('input', draw); draw();
  const p = UI.pop(anchor, h('div.fpick', q, list), { cls: 'fpop' });
  setTimeout(() => q.focus(), 50);
  return p;
};

/* ---- controlli riutilizzabili ---- */
UI.slider = (label, min, max, val, step, oninput, onchange, fmt) => {
  const out = h('span.rv', fmt ? fmt(val) : String(val));
  const inp = h('input', { type: 'range', min, max, step, value: val, 'aria-label': label });
  inp.addEventListener('input', () => { out.textContent = fmt ? fmt(+inp.value) : inp.value; oninput(+inp.value); });
  inp.addEventListener('change', () => onchange && onchange(+inp.value));
  return h('label.rng', h('span.rl', label), inp, out);
};
UI.seg = (opts, cur, cb) => h('div.seg', opts.map(([v, l, i]) => h('button' + (v === cur ? '.on' : ''), { title: typeof l === 'string' ? l : '', 'aria-label': typeof l === 'string' ? l : '', onclick: () => cb(v) }, i ? icn(i, 18) : l)));

/* Pressione prolungata, come sul telefono: scatta se il puntatore resta fermo per ms millisecondi.
   Il clic che segue il rilascio va ignorato controllando UI.lpHold. */
UI.lpHold = false; UI.lpAt = 0;
UI.longPress = (el, cb, ms = 450) => {
  let t = 0, x0 = 0, y0 = 0; const stop = () => { clearTimeout(t); t = 0; };
  el.addEventListener('pointerdown', ev => {
    stop(); if (ev.button || ev.target.closest('button, input, textarea, select, a')) return;
    x0 = ev.clientX; y0 = ev.clientY;
    t = setTimeout(() => { t = 0; UI.lpHold = true; UI.lpAt = Date.now(); try { navigator.vibrate && (!navigator.userActivation || navigator.userActivation.hasBeenActive) && navigator.vibrate(15); } catch (e) { } cb(ev); }, ms);
  });
  el.addEventListener('pointermove', ev => { if (t && Math.hypot(ev.clientX - x0, ev.clientY - y0) > 8) stop(); });
  ['pointerup', 'pointercancel', 'pointerleave', 'dragstart'].forEach(k => el.addEventListener(k, stop));
};
window.addEventListener('pointerup', () => { if (UI.lpHold) setTimeout(() => { UI.lpHold = false; }, 120); }, true);

/* Clic su file nascosto */
UI.pickFile = (accept, multiple, cb) => {
  const inp = h('input', { type: 'file', accept, multiple, style: { display: 'none' } });
  inp.addEventListener('change', () => { cb([...inp.files]); inp.remove(); });
  document.body.appendChild(inp); inp.click();
};

/* Aiuto: scorciatoie da tastiera */
UI.shortcuts = () => {
  const rows = [['Nuova casella di testo', 'T'], ['Annulla / Ripeti', 'Ctrl+Z / Ctrl+Y'], ['Copia / Taglia / Incolla', 'Ctrl+C / X / V'], ['Duplica', 'Ctrl+D'], ['Seleziona tutto', 'Ctrl+A'], ['Elimina', 'Canc'], ['Sposta di 1 px (10 con Maiusc)', 'Frecce'],
    ['Porta avanti / indietro', 'Ctrl+] / Ctrl+['], ['Grassetto / Corsivo / Sottolineato', 'Ctrl+B / I / U'], ['Modifica il testo', 'Invio'], ['Esci dal testo / deseleziona', 'Esc'], ['Zoom', 'Ctrl + rotellina'], ['Raggruppa / Separa', 'Ctrl+G / Ctrl+Maiusc+G'], ['Comandi rapidi', 'Ctrl+K'], ['Cerca e sostituisci', 'Ctrl+F'], ['Presenta (coriandoli: C, penna: P, relatore: S)', 'F5'], ['Presenta su due schermi (note solo sul computer)', 'Maiusc+F5'], ['Mappa dall’alto nella presentazione a volo', 'M'], ['Comando vocale mentre presenti', 'Palco, avanti'], ['Pagina successiva / precedente', 'PagGiù / PagSù']];
  UI.modal('Scorciatoie da tastiera', h('table.kbtab', rows.map(([a, b]) => h('tr', h('td', a), h('td', h('kbd', b))))), { cls: 'small' });
};

/* ============ Schermata iniziale ============ */
const App = { view: 'home', q: '', cat: 'Tutti', tpl: {}, sort: 'recent' };

App.theme = () => document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
App.setTheme = (m) => { document.documentElement.setAttribute('data-theme', m); ST.lset('palco.theme', m); };
App.toggleTheme = () => { App.setTheme(App.theme() === 'dark' ? 'light' : 'dark'); if (typeof ED !== 'undefined' && ED.active) { const b = $('#b-theme'); if (b) b.replaceChildren(icn(App.theme() === 'dark' ? 'sun' : 'moon', 20)); } else App.render(); };
App.nav = [['home', 'Home', 'home'], ['projects', 'Progetti', 'folder'], ['templates', 'Modelli', 'layout'], ['brand', 'Marchio', 'palette'], ['trash', 'Cestino', 'trash']];
App.go = v => { App.view = v; App.q = ''; App.render(); };

/* ---- creazione ---- */
App.create = (deck, open = true) => { ST.saveDeck(deck, true); if (open) ED.open(deck); else App.render(); return deck; };
App.newBlank = (ratio = '16:9') => { const [w, hh] = M.SIZES[ratio]; return App.create(M.newDeck({ w, h: hh })); };
App.fromTheme = async (id, ratio = '16:9') => {
  const th = TP.get(id), [w, hh] = M.SIZES[ratio];
  await loadFonts([[th.fd, th.wd], [th.fb, 400], [th.fb, 700]]);
  const d = TP.build(id, { w, h: hh, name: TP.topicData(th).name });
  return App.create(d);
};
App.tplDeck = async id => {
  if (App.tpl[id]) return App.tpl[id];
  const th = TP.get(id);
  await loadFonts([[th.fd, th.wd], [th.fb, 400], [th.fb, 700], [th.fb, 600]]);
  return (App.tpl[id] = TP.build(id));
};

/* ---- elementi ---- */
App.deckCard = (d, o = {}) => {
  const s = d.slides[0];
  const th = h('div.thwrap', R.thumb(s, d));
  const card = h('div.dcard', { tabindex: 0, role: 'button', 'aria-label': 'Apri ' + d.name, onclick: () => !d.trashed && ED.open(d), onkeydown: e => { if (e.key === 'Enter' && !d.trashed) ED.open(d); } },
    th,
    h('div.dmeta', h('div.dt', h('b', d.name), h('span.ds', `${d.slides.length} ${d.slides.length === 1 ? 'pagina' : 'pagine'} · ${fmtDate(d.updated)}`)),
      h('button.ibtn', { 'aria-label': 'Altre azioni', onclick: e => { e.stopPropagation(); App.deckMenu(e.currentTarget, d); } }, icn('more', 20))));
  return card;
};
App.deckMenu = (anchor, d) => {
  if (d.trashed) return UI.menu(anchor, [
    { label: 'Ripristina', icon: 'restore', onclick: () => { d.trashed = 0; ST.saveDeck(d, true); App.render(); toast('Presentazione ripristinata'); } },
    { label: 'Elimina per sempre', icon: 'trash', danger: true, onclick: () => UI.confirm('Eliminare per sempre?', `“${d.name}” verrà cancellata e non potrai recuperarla.`, 'Elimina', () => { ST.deleteDeck(d.id); App.render(); }) }
  ], { align: 'right' });
  UI.menu(anchor, [
    { label: 'Apri', icon: 'edit', onclick: () => ED.open(d) },
    { label: 'Rinomina', icon: 'type', onclick: () => UI.prompt('Rinomina la presentazione', d.name, 'Salva', v => { d.name = v; ST.saveDeck(d, true); App.render(); }) },
    { label: 'Crea una copia', icon: 'copy', onclick: () => { const c = clone(d); c.id = uid('d_'); c.name = d.name + ' (copia)'; c.created = Date.now(); ST.saveDeck(c, true); App.render(); toast('Copia creata'); } },
    { label: 'Condividi', icon: 'share', onclick: () => SH.open(d) },
    { label: 'Salva come modello', icon: 'layout', onclick: () => App.saveAsTemplate(d) },
    { label: 'Scarica il progetto', icon: 'download', onclick: () => EX.json(d) },
    { sep: 1 },
    { label: 'Sposta nel cestino', icon: 'trash', danger: true, onclick: () => { d.trashed = Date.now(); ST.saveDeck(d, true); App.render(); toast('Spostata nel cestino', { icon: 'trash' }); } }
  ], { align: 'right' });
};
App.tplCard = (th) => {
  const slot = h('div.thwrap.loading');
  App.tplDeck(th.id).then(d => { slot.classList.remove('loading'); slot.appendChild(R.thumb(d.slides[0], d)); }).catch(() => { });
  return h('div.dcard.tcard', { tabindex: 0, role: 'button', 'aria-label': 'Modello ' + th.name, onclick: () => App.tplModal(th), onkeydown: e => { if (e.key === 'Enter') App.tplModal(th); } },
    slot, h('div.dmeta', h('div.dt', h('b', th.name), h('span.ds', th.cats.join(' · ')))));
};
App.tplModal = async (th) => {
  const deck = await App.tplDeck(th.id);
  let idx = 0, ratio = '16:9';
  const stage = h('div.pvstage'), strip = h('div.pvstrip');
  const show = i => {
    idx = i; stage.innerHTML = ''; stage.appendChild(R.thumb(deck.slides[i], deck));
    $$('.pvt', strip).forEach((b, k) => b.classList.toggle('on', k === i));
  };
  deck.slides.forEach((s, i) => strip.appendChild(h('button.pvt', { 'aria-label': 'Pagina ' + (i + 1), onclick: () => show(i) }, R.thumb(s, deck))));
  const rs = h('div'); const drawR = () => { rs.innerHTML = ''; rs.appendChild(UI.seg([['16:9', '16:9'], ['4:3', '4:3']], ratio, v => { ratio = v; drawR(); })); }; drawR();
  const m = UI.modal(th.name, h('div.pv', stage, strip), {
    cls: 'wide', foot: [h('span.fnote', `${deck.slides.length} pagine · ${th.cats.join(', ')}`), h('span.grow'), rs,
      h('button.btn.primary', { onclick: async () => { m.close(); await App.fromTheme(th.id, ratio); } }, 'Usa questo modello')]
  });
  show(0);
};

App.formatTiles = () => {
  const t = (icon, label, color, fn) => h('button.qa', { onclick: fn }, h('span.qi', { style: { background: color, color: color === '#FFD25A' ? '#2A2310' : '' } }, icn(icon, 26)), h('span', label));
  const tiles = [
    t('presentation', 'Presentazione', '#FFD25A', () => App.newBlank('16:9')),
    t('layout', 'Presentazione 4:3', '#1E6BFF', () => App.newBlank('4:3')),
    t('list', 'Da una scaletta', '#12B886', () => App.outlineDialog()),
    t('star', 'Crea un logo', '#E040A0', () => LOGO.dialog()),
    t('image', 'Modifica una foto', '#0E9F8E', () => UI.pickFile('image/*', true, fs => GR.openImages(fs))),
    t('shapes', 'Grafica', '#1E6BFF', () => App.go('graphics')),
    t('upload', 'Carica un file', '#8B5CF6', () => App.pickImport())
  ];
  tiles.splice(2, 0, t('sparkles', 'Crea con l’IA', '#E040A0', () => App.aiDialog()));
  return h('div.qas', tiles);
};

/* ---- viste ---- */
App.hero = () => {
  const inp = h('input.herosearch', { type: 'text', placeholder: AI.textOk() ? 'Descrivi la presentazione che ti serve…' : 'Cerca modelli e progetti…', 'aria-label': 'Cerca o descrivi la presentazione' });
  const go = () => {
    const v = inp.value.trim();
    if (AI.textOk() && v) return App.aiDialog(v);
    App.q = v; App.view = v ? 'templates' : App.view; App.render();
  };
  inp.addEventListener('keydown', e => { if (e.key === 'Enter') go(); });
  return h('section.hero',
    h('div.hero-art', { html: '<svg viewBox="0 0 520 300" aria-hidden="true"><circle cx="400" cy="150" r="130" fill="#FFC21A"/><circle cx="470" cy="70" r="46" fill="#14182B"/><path d="M270 300A130 130 0 0 1 530 300Z" fill="#FFFBE9"/><rect x="300" y="40" width="20" height="260" fill="#FFFBE9" opacity=".35"/><rect x="340" y="40" width="20" height="260" fill="#FFFBE9" opacity=".25"/><circle cx="330" cy="60" r="26" fill="#1E6BFF"/></svg>' }),
    h('div.hero-in', h('h1', 'Cosa porti sul Palco oggi?'), h('p', 'Scegli un modello, scrivi una scaletta o parti da una pagina bianca.'),
      h('div.herobox', icn('search', 22), inp, h('button.btn.dark', { onclick: go }, AI.textOk() ? [icn('sparkles', 18), 'Crea con l’IA'] : 'Cerca'))));
};
App.filterDecks = list => { const q = App.q.toLowerCase(); return q ? list.filter(d => d.name.toLowerCase().includes(q)) : list; };
App.filterThemes = () => {
  const q = App.q.toLowerCase();
  return TP.themes.filter(t => !t.hidden && (App.cat === 'Tutti' || t.cats.includes(App.cat)) && (!q || (t.name + ' ' + t.cats.join(' ') + ' ' + TP.topicData(t).name).toLowerCase().includes(q)));
};
App.chips = () => h('div.chips', TP.CATS.map(c => h('button.chip' + (App.cat === c ? '.on' : ''), { onclick: () => { App.cat = c; App.render(); } }, c)));
App.empty = (icon, title, text, action) => h('div.empty', icn(icon, 40), h('h3', title), h('p', text), action || null);

App.vHome = () => {
  const recents = App.filterDecks(ST.list()).slice(0, 6), ths = App.filterThemes();
  return h('div.page', App.hero(), App.formatTiles(),
    h('section', h('div.sechd', h('h2', 'Recenti'), recents.length > 4 ? h('button.link', { onclick: () => App.go('projects') }, 'Vedi tutti') : null),
      recents.length ? h('div.grid', recents.map(d => App.deckCard(d))) : App.empty('presentation', 'Ancora nessuna presentazione', 'Crea la prima da un modello o da una pagina bianca.', h('button.btn.primary', { onclick: () => App.newBlank() }, 'Nuova presentazione'))),
    h('section', h('div.sechd', h('h2', 'Modelli per te'), h('button.link', { onclick: () => App.go('templates') }, 'Vedi tutti')), App.chips(),
      ths.length ? h('div.grid', ths.slice(0, 8).map(App.tplCard)) : App.empty('search', 'Nessun modello trovato', 'Prova con un’altra parola o categoria.')));
};
App.vProjects = () => {
