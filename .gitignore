        const f = [OPS.fill, OPS.eoFill, OPS.fillStroke, OPS.eoFillStroke, OPS.closeFillStroke, OPS.closeEOFillStroke].includes(fn[i]);
        const s = [OPS.stroke, OPS.fillStroke, OPS.eoFillStroke, OPS.closeFillStroke, OPS.closeEOFillStroke, OPS.closeStroke].includes(fn[i]);
        const sh = PDFI.shape(pend, f ? hex3(st.fill) : null, s ? hex3(st.stroke) : null, st.lw, f ? st.fa : st.sa, k, ox, oy, W, H, pw, ph);
        if (sh) { if (sh.bgColor) bg = sh.bgColor; else if (els.length < 700) { els.push(sh); stats.shapes++; } }
